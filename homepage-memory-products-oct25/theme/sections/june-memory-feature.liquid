{% assign type_block = section.blocks | where: 'type', 'typography' | first %}
{% assign feature_font = type_block.settings.font %}
{% assign feature_weight = type_block.settings.heading_weight | append: '' %}
{% assign feature_heading_font = feature_font | font_modify: 'weight', feature_weight %}
{% if feature_heading_font.family == blank %}{% assign feature_heading_font = feature_font %}{% endif %}
{% style %}
  {{ feature_font | font_face: font_display: 'swap' }}
  {{ feature_heading_font | font_face: font_display: 'swap' }}
  #MemoryFeature-{{ section.id }}{--mf-bg:var(--june-surface,{{ section.settings.background }});--mf-ink:var(--june-ink,{{ section.settings.ink }});--mf-accent:var(--june-accent,{{ section.settings.accent }});--mf-font:{{ feature_font.family }},{{ feature_font.fallback_families }};--mf-heading:{{ type_block.settings.heading_size }}px;--mf-heading-mobile:{{ type_block.settings.heading_mobile }}px;--mf-body:{{ type_block.settings.body_size }}px;--mf-body-mobile:{{ type_block.settings.body_mobile }}px;--mf-button:{{ type_block.settings.button_size }}px;--mf-button-mobile:{{ type_block.settings.button_mobile }}px}
{% endstyle %}
<section id="MemoryFeature-{{ section.id }}" class="jmf jmf--{{ section.settings.art_style }}" aria-labelledby="MemoryFeatureTitle-{{ section.id }}">
  <div class="jmf__inner">
    <div class="jmf__copy">
      <p class="jmf__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="MemoryFeatureTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="jmf__body">{{ section.settings.body }}</div>
      <p class="jmf__price">{{ section.settings.price | escape }}</p>
      <a class="jmf__button" href="{{ section.settings.link }}"><span>{{ section.settings.button_label | escape }}</span><span class="jmf__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
      {% if section.settings.secondary_label != blank %}<a class="jmf__secondary" href="{{ section.settings.secondary_link | default: section.settings.link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
    </div>
    <div class="jmf__scene" aria-label="{{ section.settings.art_alt | escape }}">
      {% if section.settings.art_style == 'our_days' %}
        <div class="jmf__phone"><b>Our Days</b><span>What made everyone laugh today?</span><em>{{ section.settings.sample_text | escape }}</em><small>Saved to your book ✓</small></div>
        <div class="jmf__book"><span>BOOK 01</span><strong>Little days.<br>One big story.</strong></div>
        <span class="jmf__sticker">one day<br>at a time</span>
      {% else %}
        <div class="jmf__album jmf__album--back"><span>OUR STORY</span></div>
        <div class="jmf__spread"><div><small>12 AUGUST</small><strong>{{ section.settings.sample_heading | escape }}</strong><p>{{ section.settings.sample_text | escape }}</p></div><div class="jmf__photo"><span>YOUR<br>PHOTO</span></div></div>
        <span class="jmf__tape jmf__tape--one"></span><span class="jmf__tape jmf__tape--two"></span>
      {% endif %}
    </div>
  </div>
</section>
{% stylesheet %}
.jmf{max-width:1680px;margin-inline:auto;background:var(--mf-bg);color:var(--mf-ink);font-family:var(--mf-font),Arial,sans-serif;overflow:hidden;border-top:1px solid var(--june-border,#dadada);border-bottom:1px solid var(--june-border,#dadada)}.jmf *{box-sizing:border-box}.jmf__inner{display:grid;grid-template-columns:minmax(0,.88fr) minmax(430px,1.12fr);min-height:620px}.jmf__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(48px,7vw,110px)}.jmf__eyebrow{margin:0 0 18px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.jmf h2{max-width:720px;margin:0;font-size:var(--mf-heading);font-weight:900;letter-spacing:-.055em;line-height:.94}.jmf__body{max-width:600px;margin-top:24px;font-size:var(--mf-body);font-weight:400;letter-spacing:-.01em;line-height:1.5}.jmf__body p{margin:0}.jmf__price{margin:24px 0 18px;font-size:18px;font-weight:800}.jmf__button{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;align-self:flex-start;min-width:260px;min-height:58px;padding:7px 8px 7px 24px;border:2px solid var(--mf-ink);border-radius:999px;background:var(--mf-accent);color:var(--mf-ink);font-size:var(--mf-button);font-weight:700;text-decoration:none;box-shadow:0 5px 0 var(--mf-ink);transition:transform .18s,box-shadow .18s}.jmf__button:hover{transform:translateY(-2px);box-shadow:0 7px 0 var(--mf-ink)}.jmf__arrow{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--june-dark,#171717);color:var(--june-on-dark,#fff)}.jmf__arrow svg{width:21px;height:21px}.jmf__secondary{align-self:flex-start;margin-top:22px;color:inherit;font-size:14px;font-weight:600;text-underline-offset:5px}.jmf__scene{position:relative;min-height:620px;background:color-mix(in srgb,var(--mf-accent) 32%,var(--mf-bg));isolation:isolate}.jmf--our_days .jmf__scene{background:radial-gradient(circle at 18% 18%,#fff 0 3px,transparent 4px) 0 0/34px 34px,color-mix(in srgb,#bfe3ed 70%,var(--mf-bg))}.jmf__phone{position:absolute;z-index:3;left:12%;top:13%;width:49%;min-height:420px;padding:28px;border:3px solid var(--mf-ink);border-radius:42px;background:#e9f5e6;box-shadow:14px 18px 0 var(--mf-ink);transform:rotate(-5deg);display:flex;flex-direction:column;gap:25px}.jmf__phone b{font-size:25px}.jmf__phone span,.jmf__phone em{padding:18px;border-radius:18px;background:#fff;font-size:18px;font-style:normal;line-height:1.35}.jmf__phone em{margin-left:12%;background:#caf0bd}.jmf__phone small{margin-top:auto;text-align:center;font-weight:700}.jmf__book{position:absolute;right:5%;bottom:8%;width:48%;height:340px;padding:24px;border:3px solid var(--mf-ink);background:#ef7464;box-shadow:14px 14px 0 var(--mf-ink);transform:rotate(6deg);display:flex;flex-direction:column;justify-content:space-between}.jmf__book strong{font-size:38px;line-height:1}.jmf__sticker{position:absolute;z-index:5;right:8%;top:8%;display:grid;place-items:center;width:120px;height:120px;border:3px solid var(--mf-ink);border-radius:50%;background:#ffd255;text-align:center;font-weight:900;transform:rotate(8deg)}.jmf--photo_books .jmf__scene{background:linear-gradient(135deg,#f4b6c8 0 45%,#a8d8ea 45%)}.jmf__album{position:absolute;left:11%;top:10%;width:58%;height:72%;border:3px solid var(--mf-ink);background:#164d3b;box-shadow:16px 16px 0 var(--mf-ink);transform:rotate(-7deg);color:#f3d7a6;display:grid;place-items:center;font-size:48px;font-weight:900}.jmf__spread{position:absolute;z-index:3;right:5%;bottom:8%;width:72%;height:62%;display:grid;grid-template-columns:1fr 1fr;border:3px solid var(--mf-ink);background:#fffdf6;box-shadow:14px 15px 0 #17171755;transform:rotate(4deg)}.jmf__spread>div{padding:32px}.jmf__spread>div+div{border-left:2px solid #d8d0c5}.jmf__spread small{display:block;font-weight:800;letter-spacing:.15em}.jmf__spread strong{display:block;margin-top:36px;font-size:34px;line-height:1}.jmf__spread p{font-size:16px;line-height:1.4}.jmf__photo{display:grid;place-items:center;background:linear-gradient(145deg,#ffd867,#f56a28);font-size:32px;font-weight:900;text-align:center}.jmf__tape{position:absolute;z-index:4;width:120px;height:34px;background:#fff1b8aa}.jmf__tape--one{right:6%;top:12%;transform:rotate(16deg)}.jmf__tape--two{left:19%;bottom:7%;transform:rotate(-15deg)}@media(max-width:899px){.jmf__inner{grid-template-columns:1fr;min-height:0}.jmf__copy{padding:46px 22px 34px}.jmf h2{font-size:var(--mf-heading-mobile)}.jmf__body{font-size:var(--mf-body-mobile);margin-top:18px}.jmf__button{width:100%;font-size:var(--mf-button-mobile)}.jmf__scene{min-height:480px}.jmf__phone{left:7%;top:12%;width:58%;min-height:330px;padding:20px;border-radius:30px}.jmf__phone b{font-size:20px}.jmf__phone span,.jmf__phone em{padding:13px;font-size:14px}.jmf__book{right:3%;height:260px}.jmf__book strong{font-size:27px}.jmf__sticker{width:90px;height:90px;font-size:13px}.jmf__album{font-size:34px}.jmf__spread{width:82%;height:64%}.jmf__spread>div{padding:20px}.jmf__spread strong{margin-top:22px;font-size:25px}.jmf__spread p{font-size:13px}}@media(prefers-reduced-motion:reduce){.jmf__button{transition:none}}
{% endstylesheet %}
{% schema %}
{"name":"June · Memory feature","tag":"section","max_blocks":1,"settings":[{"type":"checkbox","id":"use_master_palette","label":"Use master palette","default":true},{"type":"select","id":"art_style","label":"Artwork style","options":[{"value":"our_days","label":"Our Days"},{"value":"photo_books","label":"Photo albums"}],"default":"our_days"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ONE DAY AT A TIME"},{"type":"text","id":"heading","label":"Heading","default":"The little moments make the whole story."},{"type":"richtext","id":"body","label":"Supporting copy","default":"<p>Thoughtful prompts help you collect the words and photographs that turn everyday life into a book.</p>"},{"type":"text","id":"price","label":"Price line","default":"From ₹2,999 · Printed book included"},{"type":"url","id":"link","label":"Primary link"},{"type":"text","id":"button_label","label":"Primary button","default":"Discover Our Days"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"secondary_label","label":"Secondary action","default":"See how it works"},{"type":"text","id":"sample_heading","label":"Sample page heading","default":"The bubble afternoon"},{"type":"text","id":"sample_text","label":"Sample memory","default":"She discovered bubbles—and tried to catch every single one."},{"type":"text","id":"art_alt","label":"Artwork description","default":"A memory becoming a printed book"},{"type":"color","id":"background","label":"Background","default":"#F5F5F3"},{"type":"color","id":"ink","label":"Text","default":"#171717"},{"type":"color","id":"accent","label":"Accent","default":"#F56A28"}],"blocks":[{"type":"typography","name":"Typography controls","limit":1,"settings":[{"type":"font_picker","id":"font","label":"Font family","default":"poppins_n4"},{"type":"range","id":"heading_weight","label":"Heading thickness","min":100,"max":900,"step":100,"default":900},{"type":"range","id":"heading_size","label":"Heading desktop size","min":32,"max":100,"step":1,"unit":"px","default":68},{"type":"range","id":"heading_mobile","label":"Heading mobile size","min":28,"max":70,"step":1,"unit":"px","default":44},{"type":"range","id":"body_size","label":"Body desktop size","min":12,"max":28,"step":1,"unit":"px","default":18},{"type":"range","id":"body_mobile","label":"Body mobile size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"button_size","label":"Button desktop size","min":11,"max":22,"step":1,"unit":"px","default":15},{"type":"range","id":"button_mobile","label":"Button mobile size","min":11,"max":20,"step":1,"unit":"px","default":14}]}],"presets":[{"name":"June · Memory feature","blocks":[{"type":"typography"}]}]}
{% endschema %}
