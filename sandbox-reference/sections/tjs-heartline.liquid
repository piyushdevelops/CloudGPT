{% comment %}
TJS Heartline Hero — homepage Champagne Glass campaign section.
Navigation-first: no direct cart API or custom side-cart logic.
{% endcomment %}

{% liquid
  assign variant_count = 0
  for block in section.blocks
    if block.type == 'colour'
      assign variant_count = variant_count | plus: 1
    endif
  endfor
%}

<section id="TjsHeartlineHero-{{ section.id }}" class="tjs-heartline" data-tjs-heartline
  style="--hl-bg:{{ section.settings.background }};--hl-text:{{ section.settings.text_color }};--hl-muted:{{ section.settings.muted_color }};--hl-border:{{ section.settings.border_color }};--hl-button:{{ section.settings.button_background }};--hl-button-text:{{ section.settings.button_text }};--hl-stage:{{ section.settings.stage_background }};--hl-radius:{{ section.settings.corner_radius }}px;--hl-max:{{ section.settings.max_width }}px;">
  <div class="tjs-heartline__shell">
    <div class="tjs-heartline__hero">
      <div class="tjs-heartline__copy">
        {% if section.settings.eyebrow != blank %}<div class="tjs-heartline__eyebrow"><span></span>{{ section.settings.eyebrow | escape }}</div>{% endif %}
        <h2 class="tjs-heartline__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.body != blank %}<div class="tjs-heartline__body">{{ section.settings.body }}</div>{% endif %}

        <div class="tjs-heartline__chips" aria-label="Product highlights">
          {% if section.settings.fact_one != blank %}<span>{{ section.settings.fact_one | escape }}</span>{% endif %}
          {% if section.settings.fact_two != blank %}<span>{{ section.settings.fact_two | escape }}</span>{% endif %}
          {% if section.settings.fact_three != blank %}<span>{{ section.settings.fact_three | escape }}</span>{% endif %}
        </div>

        <div class="tjs-heartline__selector-wrap">
          <div class="tjs-heartline__selector-label">{{ section.settings.selector_label | escape }}</div>
          <div class="tjs-heartline__selector" role="radiogroup" aria-label="Choose Champagne Glass colour">
            {% assign selector_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'colour' %}
                <button type="button" class="tjs-heartline__swatch{% if selector_index == 0 %} is-active{% endif %}" role="radio" aria-checked="{% if selector_index == 0 %}true{% else %}false{% endif %}" data-hl-select="{{ selector_index }}" style="--swatch:{{ block.settings.swatch_color }};" {{ block.shopify_attributes }}>
                  <span class="tjs-heartline__swatch-dot"></span>
                  <span class="tjs-heartline__swatch-copy"><strong>{{ block.settings.title | escape }}</strong><small>{{ block.settings.note | escape }}</small></span>
                </button>
                {% assign selector_index = selector_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="tjs-heartline__actions">
          <a href="#" class="tjs-heartline__primary" data-hl-primary><span>{{ section.settings.primary_label | escape }}</span><span aria-hidden="true">→</span></a>
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a href="{{ section.settings.secondary_link }}" class="tjs-heartline__secondary">{{ section.settings.secondary_label | escape }}</a>{% endif %}
        </div>

        {% if section.settings.utility_line != blank %}<p class="tjs-heartline__utility">{{ section.settings.utility_line | escape }}</p>{% endif %}
      </div>

      <div class="tjs-heartline__visual">
        <div class="tjs-heartline__campaign" data-hl-stage>
          <div class="tjs-heartline__halo" aria-hidden="true"></div>
          <div class="tjs-heartline__burst" aria-hidden="true"></div>
          <div class="tjs-heartline__spark tjs-heartline__spark--one" aria-hidden="true">✦</div>
          <div class="tjs-heartline__spark tjs-heartline__spark--two" aria-hidden="true">♡</div>
          <div class="tjs-heartline__spark tjs-heartline__spark--three" aria-hidden="true">✧</div>

          {% assign slide_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'colour' %}
              <div class="tjs-heartline__product{% if slide_index == 0 %} is-active{% endif %}" data-hl-product="{{ slide_index }}" data-title="{{ block.settings.title | escape }}" data-note="{{ block.settings.note | escape }}" data-link="{{ block.settings.link }}" data-accent="{{ block.settings.accent }}" data-soft="{{ block.settings.soft_color }}" data-feature-one="{{ block.settings.feature_one | escape }}" data-feature-two="{{ block.settings.feature_two | escape }}" data-feature-three="{{ block.settings.feature_three | escape }}">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200,1500', sizes: '(max-width: 749px) 82vw, 46vw', class: 'tjs-heartline__product-image' }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'tjs-heartline__placeholder' }}
                {% endif %}
              </div>
              {% assign slide_index = slide_index | plus: 1 %}
            {% endif %}
          {% endfor %}

          <div class="tjs-heartline__graphic-copy" aria-hidden="true"><span>{{ section.settings.graphic_line_one | escape }}</span><strong>{{ section.settings.graphic_line_two | escape }}</strong></div>

          <div class="tjs-heartline__features">
            <article><span class="tjs-heartline__feature-icon">♡</span><div><strong data-hl-feature-one>{{ section.settings.default_feature_one | escape }}</strong><small>{{ section.settings.feature_one_text | escape }}</small></div></article>
            <article><span class="tjs-heartline__feature-icon">✦</span><div><strong data-hl-feature-two>{{ section.settings.default_feature_two | escape }}</strong><small>{{ section.settings.feature_two_text | escape }}</small></div></article>
            <article><span class="tjs-heartline__feature-icon">2</span><div><strong data-hl-feature-three>{{ section.settings.default_feature_three | escape }}</strong><small>{{ section.settings.feature_three_text | escape }}</small></div></article>
          </div>
        </div>
      </div>
    </div>

    {% if variant_count > 0 %}
      <div class="tjs-heartline__strip" aria-label="Shop Champagne Glass colours">
        {% assign strip_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'colour' %}
            <button type="button" class="tjs-heartline__strip-card{% if strip_index == 0 %} is-active{% endif %}" data-hl-strip="{{ strip_index }}">
              <span class="tjs-heartline__strip-media">
                {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '160,220,320,420,500', sizes: '(max-width: 749px) 33vw, 180px', class: 'tjs-heartline__strip-image' }}{% endif %}
              </span>
              <span class="tjs-heartline__strip-copy"><small>{{ block.settings.kicker | escape }}</small><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.note | escape }}</span>{% if block.settings.price_text != blank %}<b>{{ block.settings.price_text | escape }}</b>{% endif %}</span>
              <span class="tjs-heartline__strip-action">{{ block.settings.card_cta | default: 'Shop' | escape }} →</span>
            </button>
            {% assign strip_index = strip_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
#TjsHeartlineHero-{{ section.id }}{width:100%;background:radial-gradient(circle at 84% 8%,rgba(255,255,255,.58),transparent 22%),var(--hl-bg);color:var(--hl-text);font-family:var(--font-body-family,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif)}
#TjsHeartlineHero-{{ section.id }} *,#TjsHeartlineHero-{{ section.id }} *:before,#TjsHeartlineHero-{{ section.id }} *:after{box-sizing:border-box}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__shell{width:min(calc(100% - 32px),var(--hl-max));margin-inline:auto;padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__hero{display:grid;grid-template-columns:minmax(340px,.86fr) minmax(0,1.14fr);align-items:center;gap:clamp(42px,6vw,90px);min-height:{{ section.settings.desktop_height }}px}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__copy{max-width:560px;padding-left:clamp(0px,2vw,26px)}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__eyebrow{display:inline-flex;align-items:center;gap:8px;margin-bottom:18px;color:var(--hl-muted);font-size:10px;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__eyebrow span{width:8px;height:8px;border-radius:50%;background:var(--active-accent,#e9779b);box-shadow:0 0 0 5px color-mix(in srgb,var(--active-accent,#e9779b) 12%,transparent)}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__heading{max-width:10ch;margin:0;color:var(--hl-text);font-size:{{ section.settings.heading_size }}px;font-weight:900;line-height:.94;letter-spacing:-.055em;text-wrap:balance}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__body{max-width:43ch;margin-top:20px;color:var(--hl-muted);font-size:14px;font-weight:520;line-height:1.62}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__body p{margin:0}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__chips span{min-height:32px;display:inline-flex;align-items:center;padding:0 12px;border:1px solid var(--hl-border);border-radius:999px;background:rgba(255,255,255,.64);font-size:10px;font-weight:720;box-shadow:0 5px 14px rgba(42,32,27,.04)}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__selector-wrap{margin-top:27px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__selector-label{margin-bottom:10px;color:var(--hl-muted);font-size:9px;font-weight:850;letter-spacing:.11em;text-transform:uppercase}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__selector{display:flex;flex-wrap:wrap;gap:9px}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__swatch{display:inline-flex;align-items:center;gap:9px;min-height:46px;padding:7px 13px 7px 9px;border:1px solid var(--hl-border);border-radius:16px;background:rgba(255,255,255,.72);color:var(--hl-text);cursor:pointer;font:inherit;text-align:left;transition:.2s}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__swatch:hover{transform:translateY(-1px)}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__swatch.is-active{border-color:var(--swatch);background:color-mix(in srgb,var(--swatch) 8%,#fff);box-shadow:0 8px 20px color-mix(in srgb,var(--swatch) 15%,transparent)}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__swatch-dot{width:18px;height:18px;flex:0 0 18px;border:3px solid #fff;border-radius:50%;background:var(--swatch);box-shadow:0 0 0 1px color-mix(in srgb,var(--swatch) 55%,#aaa)}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__swatch-copy{display:grid;gap:1px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__swatch-copy strong{font-size:11px;font-weight:800;line-height:1.05}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__swatch-copy small{color:var(--hl-muted);font-size:8px;line-height:1.2}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__actions{display:flex;align-items:center;flex-wrap:wrap;gap:14px;margin-top:24px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__primary{min-height:50px;display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:0 20px;border-radius:999px;background:var(--hl-button);color:var(--hl-button-text);box-shadow:0 14px 28px rgba(30,24,21,.15);font-size:11px;font-weight:860;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;transition:transform .2s ease}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__primary:hover{transform:translateY(-2px)}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__secondary{color:var(--hl-text);font-size:11px;font-weight:740;text-underline-offset:4px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__utility{margin:11px 0 0;color:var(--hl-muted);font-size:9px;font-weight:600}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__stage{position:relative;min-height:600px;overflow:hidden;border:1px solid color-mix(in srgb,var(--active-accent,#e9779b) 20%,var(--hl-border));border-radius:calc(var(--hl-radius) + 6px);background:radial-gradient(circle at 56% 48%,color-mix(in srgb,var(--active-soft,#f7dde5) 72%,#fff),transparent 34%),linear-gradient(180deg,rgba(255,255,255,.92),var(--hl-stage));box-shadow:0 28px 65px rgba(42,32,27,.09);transition:.28s}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__burst{position:absolute;top:50%;left:55%;width:420px;aspect-ratio:1;border-radius:50%;background:repeating-conic-gradient(from -6deg,color-mix(in srgb,var(--active-accent,#e9779b) 10%,transparent) 0deg 8deg,transparent 8deg 17deg);opacity:.9;transform:translate(-50%,-50%)}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__product{position:absolute;z-index:4;inset:7% 13% 14% 17%;display:grid;place-items:center;opacity:0;visibility:hidden;transform:translateY(20px) scale(.97) rotate(-1deg);transition:opacity .35s ease,transform .45s cubic-bezier(.22,.61,.36,1),visibility .35s ease}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__product.is-active{opacity:1;visibility:visible;transform:none}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__product-image,#TjsHeartlineHero-{{ section.id }} .tjs-heartline__placeholder{width:min(100%,560px);max-height:485px;object-fit:contain;filter:drop-shadow(0 30px 28px rgba(34,25,22,.16));animation:tjsHeartlineFloat-{{ section.id }} 5.8s ease-in-out infinite}@keyframes tjsHeartlineFloat-{{ section.id }}{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__graphic-copy{position:absolute;z-index:6;left:6%;bottom:21%;display:grid;gap:2px;transform:rotate(-6deg)}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__graphic-copy span,#TjsHeartlineHero-{{ section.id }} .tjs-heartline__graphic-copy strong{width:fit-content;padding:7px 13px;border:2px solid var(--hl-text);border-radius:11px;box-shadow:4px 4px 0 rgba(24,20,18,.14);font-size:18px;font-weight:900;letter-spacing:-.04em;line-height:1}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__graphic-copy span{background:#f7c55c;color:#1c1715}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__graphic-copy strong{margin-left:42px;background:var(--active-accent,#e9779b);color:#fff}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__features{position:absolute;z-index:7;top:28%;right:4%;width:185px;display:grid;gap:16px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__features article{display:grid;grid-template-columns:38px 1fr;gap:10px;align-items:start}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__feature-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:50%;background:var(--active-accent,#e9779b);color:#fff;box-shadow:0 7px 15px color-mix(in srgb,var(--active-accent,#e9779b) 22%,transparent);font-size:16px;font-weight:850}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__features article div{display:grid;gap:3px;padding-top:3px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__features strong{font-size:10px;font-weight:850;line-height:1.15;text-transform:uppercase}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__features small{color:var(--hl-muted);font-size:8px;line-height:1.35}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__spark{position:absolute;z-index:3;color:var(--active-accent,#e9779b);pointer-events:none}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__spark--one{top:12%;left:18%;font-size:28px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__spark--two{top:18%;right:23%;font-size:26px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__spark--three{left:15%;bottom:12%;font-size:22px}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px;padding:17px;border-radius:calc(var(--hl-radius) + 8px);background:linear-gradient(135deg,color-mix(in srgb,var(--active-accent,#e9779b) 82%,#2b1f28),color-mix(in srgb,var(--active-accent,#e9779b) 68%,#523341));box-shadow:0 18px 38px rgba(39,28,24,.12);transition:.28s}
#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-card{min-width:0;display:grid;grid-template-columns:82px minmax(0,1fr) auto;align-items:center;gap:11px;padding:10px;border:1px solid rgba(255,255,255,.18);border-radius:16px;background:rgba(255,255,255,.09);color:#fff;cursor:pointer;font:inherit;text-align:left;transition:.2s}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-card:hover,#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-card.is-active{transform:translateY(-2px);border-color:rgba(255,255,255,.5);background:rgba(255,255,255,.16)}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-media{aspect-ratio:1;display:grid;place-items:center;overflow:hidden;border-radius:12px;background:rgba(255,255,255,.12)}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-image{width:100%;height:100%;object-fit:contain;padding:4px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-copy{min-width:0;display:grid;gap:2px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-copy small{font-size:7px;font-weight:780;letter-spacing:.08em;text-transform:uppercase;opacity:.68}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-copy strong{font-size:15px;font-weight:850;line-height:1}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-copy span{font-size:8px;line-height:1.25;opacity:.76}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-copy b{margin-top:2px;font-size:10px;line-height:1}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-action{min-height:30px;display:inline-flex;align-items:center;justify-content:center;padding:0 10px;border-radius:999px;background:#fff;color:#1e1917;font-size:8px;font-weight:850;white-space:nowrap}
@media(max-width:749px){#TjsHeartlineHero-{{ section.id }} .tjs-heartline__shell{width:min(calc(100% - 18px),var(--hl-max));padding:{{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__hero{min-height:0;grid-template-columns:1fr;gap:22px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__copy{max-width:none;padding:0 3px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__eyebrow{margin-bottom:11px;font-size:8px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__heading{max-width:9ch;font-size:{{ section.settings.mobile_heading_size }}px;line-height:.95}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__body{max-width:34ch;margin-top:13px;font-size:11px;line-height:1.5}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__chips{gap:6px;margin-top:15px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__chips span{min-height:28px;padding:0 9px;font-size:8px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__selector-wrap{margin-top:17px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__selector{flex-wrap:nowrap;overflow-x:auto;margin-right:-9px;padding-right:9px;scrollbar-width:none}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__selector::-webkit-scrollbar{display:none}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__swatch{flex:0 0 auto;min-height:42px;border-radius:14px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__actions{margin-top:18px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__primary{min-height:47px;padding:0 17px;font-size:9px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__stage{min-height:520px;border-radius:24px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__burst{top:41%;left:50%;width:310px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__product{inset:7% 7% 30%}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__product-image,#TjsHeartlineHero-{{ section.id }} .tjs-heartline__placeholder{width:min(100%,360px);max-height:330px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__graphic-copy{left:5%;bottom:28%}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__graphic-copy span,#TjsHeartlineHero-{{ section.id }} .tjs-heartline__graphic-copy strong{padding:6px 9px;border-width:1.5px;border-radius:9px;font-size:13px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__graphic-copy strong{margin-left:30px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__features{top:auto;right:12px;bottom:12px;left:12px;width:auto;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__features article{grid-template-columns:28px 1fr;gap:6px;padding:8px;border-radius:13px;background:rgba(255,255,255,.75);backdrop-filter:blur(8px)}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__feature-icon{width:28px;height:28px;font-size:12px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__features strong{font-size:6.5px}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__features small{display:none}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:78%;gap:9px;overflow-x:auto;margin-top:12px;padding:11px;scroll-snap-type:x mandatory;scrollbar-width:none}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip::-webkit-scrollbar{display:none}#TjsHeartlineHero-{{ section.id }} .tjs-heartline__strip-card{grid-template-columns:74px 1fr auto;scroll-snap-align:center}}
@media(prefers-reduced-motion:reduce){#TjsHeartlineHero-{{ section.id }} *,#TjsHeartlineHero-{{ section.id }} *:before,#TjsHeartlineHero-{{ section.id }} *:after{transition-duration:.01ms!important;animation-duration:.01ms!important}}
{% endstyle %}

<script>
(() => {
  const root=document.getElementById('TjsHeartlineHero-{{ section.id }}');
  if(!root||root.dataset.ready==='true')return;root.dataset.ready='true';
  const products=[...root.querySelectorAll('[data-hl-product]')],selectors=[...root.querySelectorAll('[data-hl-select]')],stripCards=[...root.querySelectorAll('[data-hl-strip]')],primary=root.querySelector('[data-hl-primary]'),f1=root.querySelector('[data-hl-feature-one]'),f2=root.querySelector('[data-hl-feature-two]'),f3=root.querySelector('[data-hl-feature-three]');
  if(!products.length)return;
  const activate=index=>{const p=products[index];if(!p)return;products.forEach((x,i)=>x.classList.toggle('is-active',i===index));selectors.forEach((b,i)=>{const a=i===index;b.classList.toggle('is-active',a);b.setAttribute('aria-checked',a?'true':'false')});stripCards.forEach((c,i)=>c.classList.toggle('is-active',i===index));root.style.setProperty('--active-accent',p.dataset.accent||'#e9779b');root.style.setProperty('--active-soft',p.dataset.soft||'#f7dde5');if(primary){primary.href=p.dataset.link||'#';primary.setAttribute('aria-label',`${primary.textContent.trim()} — ${p.dataset.title||''}`)}if(f1&&p.dataset.featureOne)f1.textContent=p.dataset.featureOne;if(f2&&p.dataset.featureTwo)f2.textContent=p.dataset.featureTwo;if(f3&&p.dataset.featureThree)f3.textContent=p.dataset.featureThree};
  selectors.forEach((b,i)=>b.addEventListener('click',()=>activate(i)));stripCards.forEach((c,i)=>c.addEventListener('click',()=>activate(i)));activate(0);
})();
</script>

