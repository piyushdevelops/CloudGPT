<script>
(function() {
  const root =
    document.getElementById(
      'CategoryBannerShop-{{ section.id }}'
    );

  if (!root) return;

  const tabs =
    Array.from(
      root.querySelectorAll(
        '[data-category-tab]'
      )
    );

  const panels =
    Array.from(
      root.querySelectorAll(
        '[data-category-panel]'
      )
    );

  if (!tabs.length || !panels.length) return;


  /* =========================================================
     INDEPENDENT BANNER CAROUSEL
  ========================================================= */

  class BannerCarousel {
    constructor(element) {
      this.el = element;
      this.track =
        element.querySelector(
          '[data-banner-track]'
        );

      this.slides =
        this.track
          ? Array.from(
              this.track.querySelectorAll(
                '[data-banner-slide]'
              )
            )
          : [];

      this.prev =
        element.querySelector(
          '[data-banner-prev]'
        );

      this.next =
        element.querySelector(
          '[data-banner-next]'
        );

      this.dotWrap =
        element.querySelector(
          '[data-banner-dots]'
        );

      this.index = 0;
      this.timer = null;
      this.resumeTimer = null;
      this.dragging = false;
      this.startX = 0;
      this.startLeft = 0;

      this.autoplay =
        root.dataset.bannerAutoplay ===
        'true';

      this.delay =
        (
          parseFloat(
            root.dataset.bannerDelay
          ) || 4
        ) *
        1000;

      this.resumeDelay =
        (
          parseFloat(
            root.dataset.bannerResume
          ) || 5
        ) *
        1000;

      this.speed =
        parseFloat(
          root.dataset.bannerSpeed
        ) || 500;

      this.init();
    }


    init() {
      if (!this.track || !this.slides.length) {
        if (this.prev) this.prev.hidden = true;
        if (this.next) this.next.hidden = true;
        if (this.dotWrap) this.dotWrap.hidden = true;
        return;
      }

      if (this.slides.length < 2) {
        if (this.prev) this.prev.hidden = true;
        if (this.next) this.next.hidden = true;
      }

      this.buildDots();

      if (this.prev) {
        this.prev.addEventListener(
          'click',
          () => {
            this.interact();
            this.goTo(
              this.index - 1,
              true
            );
          }
        );
      }

      if (this.next) {
        this.next.addEventListener(
          'click',
          () => {
            this.interact();
            this.goTo(
              this.index + 1,
              true
            );
          }
        );
      }

      this.track.addEventListener(
        'scroll',
        () => {
          requestAnimationFrame(
            () => this.syncIndex()
          );
        },
        {
          passive: true
        }
      );

      this.track.addEventListener(
        'touchstart',
        () => this.interact(),
        {
          passive: true
        }
      );

      this.track.addEventListener(
        'wheel',
        () => this.interact(),
        {
          passive: true
        }
      );

      /*
        Mouse / pen drag.
        Touch stays native for smooth mobile swiping.
      */
      this.track.addEventListener(
        'pointerdown',
        event => {
          if (
            event.pointerType === 'touch' ||
            event.button !== 0
          ) {
            return;
          }

          this.interact();

          this.dragging = true;
          this.startX =
            event.clientX;
          this.startLeft =
            this.track.scrollLeft;

          this.track.classList.add(
            'is-dragging'
          );

          this.track.setPointerCapture?.(
            event.pointerId
          );
        }
      );

      this.track.addEventListener(
        'pointermove',
        event => {
          if (!this.dragging) return;

          const delta =
            event.clientX -
            this.startX;

          this.track.scrollLeft =
            this.startLeft -
            delta;
        }
      );

      const release =
        () => {
          if (!this.dragging) return;

          this.dragging = false;

          this.track.classList.remove(
            'is-dragging'
          );

          this.snapToNearest();
        };

      this.track.addEventListener(
        'pointerup',
        release
      );

      this.track.addEventListener(
        'pointercancel',
        release
      );

      this.updateDots();
    }


    buildDots() {
      if (!this.dotWrap) return;

      this.dotWrap.innerHTML = '';

      if (this.slides.length < 2) {
        this.dotWrap.hidden = true;
        return;
      }

      this.dotWrap.hidden = false;

      this.slides.forEach(
        (_, index) => {
          const dot =
            document.createElement(
              'button'
            );

          dot.type =
            'button';

          dot.className =
            'cts__banner-dot';

          dot.setAttribute(
            'aria-label',
            `Go to banner ${index + 1}`
          );

          dot.addEventListener(
            'click',
            () => {
              this.interact();
              this.goTo(
                index,
                true
              );
            }
          );

          this.dotWrap.appendChild(
            dot
          );
        }
      );

      this.dots =
        Array.from(
          this.dotWrap.children
        );
    }


    normalize(index) {
      if (!this.slides.length) return 0;

      if (index < 0) {
        return (
          this.slides.length -
          1
        );
      }

      if (
        index >=
        this.slides.length
      ) {
        return 0;
      }

      return index;
    }


    goTo(index, smooth) {
      if (!this.slides.length) return;

      this.index =
        this.normalize(index);

      const target =
        this.slides[
          this.index
        ].offsetLeft;

      this.track.scrollTo({
        left: target,
        behavior:
          smooth
            ? 'smooth'
            : 'auto'
      });

      this.updateDots();
    }


    syncIndex() {
      if (!this.slides.length) return;

      const width =
        this.track.clientWidth ||
        1;

      this.index =
        this.normalize(
          Math.round(
            this.track.scrollLeft /
            width
          )
        );

      this.updateDots();
    }


    snapToNearest() {
      this.syncIndex();

      this.goTo(
        this.index,
        true
      );
    }


    updateDots() {
      if (!this.dots) return;

      this.dots.forEach(
        (dot, index) => {
          dot.classList.toggle(
            'is-active',
            index === this.index
          );
        }
      );
    }


    isVisiblePanel() {
      const panel =
        this.el.closest(
          '[data-category-panel]'
        );

      return (
        panel &&
        !panel.hidden &&
        panel.classList.contains(
          'is-active'
        )
      );
    }


    stop() {
      if (this.timer) {
        clearTimeout(
          this.timer
        );

        this.timer = null;
      }
    }


    schedule() {
      this.stop();

      if (
        !this.autoplay ||
        this.slides.length < 2 ||
        !this.isVisiblePanel() ||
        document.hidden
      ) {
        return;
      }

      this.timer =
        setTimeout(
          () => {
            this.goTo(
              this.index + 1,
              true
            );

            this.schedule();
          },
          this.delay
        );
    }


    interact() {
      /*
        Only THIS banner carousel pauses.
        New Arrivals / Best Sellers / Gifting
        remain independent of one another.
      */
      this.stop();

      if (this.resumeTimer) {
        clearTimeout(
          this.resumeTimer
        );
      }

      this.resumeTimer =
        setTimeout(
          () => this.schedule(),
          this.resumeDelay
        );
    }


    onPanelActivated() {
      this.syncIndex();
      this.schedule();
    }


    onPanelHidden() {
      this.stop();
    }
  }


  const bannerCarousels =
    Array.from(
      root.querySelectorAll(
        '[data-banner-carousel]'
      )
    ).map(
      element =>
        new BannerCarousel(
          element
        )
    );


  /* =========================================================
     CATEGORY SWITCHING + THEME
  ========================================================= */

  function activateCategory(
    index,
    smoothTab
  ) {
    if (
      index < 0 ||
      index >= tabs.length ||
      index >= panels.length
    ) {
      return;
    }

    const tab =
      tabs[index];

    const themeColor =
      tab.dataset.themeColor ||
      '{{ section.settings.fallback_background }}';

    const themeText =
      tab.dataset.themeText ||
      '{{ section.settings.fallback_text }}';


    /*
      Change the complete section theme immediately
      to THIS category's own colors.
    */

    root.style.setProperty(
      '--theme',
      themeColor
    );

    root.style.setProperty(
      '--ink',
      themeText
    );

    root.style.backgroundColor =
      themeColor;

    root.style.color =
      themeText;


    tabs.forEach(
      (item, itemIndex) => {
        const active =
          itemIndex === index;

        item.classList.toggle(
          'is-active',
          active
        );

        item.setAttribute(
          'aria-selected',
          active ? 'true' : 'false'
        );
      }
    );


    panels.forEach(
      (panel, panelIndex) => {
        const active =
          panelIndex === index;

        panel.hidden =
          !active;

        panel.classList.toggle(
          'is-active',
          active
        );
      }
    );


    /*
      Start the 3 independent banner carousels
      in the selected category and stop hidden ones.
    */

    bannerCarousels.forEach(
      carousel => {
        if (
          carousel.isVisiblePanel()
        ) {
          carousel.onPanelActivated();
        } else {
          carousel.onPanelHidden();
        }
      }
    );


    if (
      smoothTab !== false
    ) {
      tab.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'center'
      });
    }
  }


  tabs.forEach(
    (tab, index) => {
      tab.addEventListener(
        'click',
        () => {
          activateCategory(
            index,
            true
          );
        }
      );
    }
  );


  document.addEventListener(
    'visibilitychange',
    () => {
      bannerCarousels.forEach(
        carousel => {
          if (
            document.hidden
          ) {
            carousel.stop();
          } else if (
            carousel.isVisiblePanel()
          ) {
            carousel.schedule();
          }
        }
      );
    }
  );


  /*
    Theme editor block selection:
    open that category and use that category color.
  */

  if (
    window.Shopify &&
    Shopify.designMode
  ) {
    document.addEventListener(
      'shopify:block:select',
      event => {
        if (
          String(
            event.detail &&
            event.detail.sectionId
          ) !==
          '{{ section.id }}'
        ) {
          return;
        }

        const blockId =
          String(
            event.detail &&
            event.detail.blockId ||
            ''
          );

        const index =
          tabs.findIndex(
            tab =>
              tab.dataset.blockId ===
              blockId
          );

        if (index >= 0) {
          activateCategory(
            index,
            false
          );
        }
      }
    );
  }


  activateCategory(
    0,
    false
  );

})();
</script>


