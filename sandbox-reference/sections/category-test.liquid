{% comment %}
  Category banner shop
  - Colored SVG category buttons
  - Category-specific full-section theme color
  - New Arrivals, Best Sellers, Gifting
  - 3 x 16:10 banner images inside EACH zone, for EACH category
  - Every zone has its own independent swipe + autoplay carousel
{% endcomment %}

{% style %}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}

  #CategoryBannerShop-{{ section.id }} {
    --theme: {{ section.settings.fallback_background }};
    --ink: {{ section.settings.fallback_text }};
    --muted: color-mix(in srgb, var(--ink) 62%, transparent);
    --line: color-mix(in srgb, var(--ink) 18%, transparent);

    position: relative;
    width: 100%;
    overflow: hidden;
    isolation: isolate;

    background: var(--theme);
    color: var(--ink);

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    transition:
      background-color {{ section.settings.theme_transition_speed }}ms ease,
      color {{ section.settings.theme_transition_speed }}ms ease;

    font-family:
      {{ section.settings.body_font.family }}, 
      {{ section.settings.body_font.fallback_families }};
  }

  #CategoryBannerShop-{{ section.id }} * {
    box-sizing: border-box;
  }

  #CategoryBannerShop-{{ section.id }} .cts__inner {
    width: min(
      {{ section.settings.max_width }}px,
      calc(100% - {{ section.settings.side_padding | times: 2 }}px)
    );
    margin: 0 auto;
  }

  /* CATEGORY BUTTONS */

  #CategoryBannerShop-{{ section.id }} .cts__tabs {
    display: flex;
    align-items: flex-start;
    gap: {{ section.settings.tab_gap }}px;

    width: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    padding: 4px 2px {{ section.settings.tabs_bottom_spacing }}px;

    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  #CategoryBannerShop-{{ section.id }} .cts__tabs::-webkit-scrollbar {
    display: none;
  }

  #CategoryBannerShop-{{ section.id }} .cts__tab {
    flex: 0 0 auto;
    width: {{ section.settings.tab_width }}px;

    padding: 0;
    border: 0;

    background: transparent;

    color: var(--tab-ink);

    cursor: pointer;

    font: inherit;
    text-align: center;
  }

  #CategoryBannerShop-{{ section.id }} .cts__tab-box {
    width: {{ section.settings.tab_box_size }}px;
    height: {{ section.settings.tab_box_size }}px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: {{ section.settings.tab_box_radius }}px;

    background: var(--tab-color);

    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  #CategoryBannerShop-{{ section.id }} .cts__tab:hover .cts__tab-box,
  #CategoryBannerShop-{{ section.id }} .cts__tab.is-active .cts__tab-box {
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 10px 26px rgba(0,0,0,.12);
  }

  #CategoryBannerShop-{{ section.id }} .cts__icon {
    width: {{ section.settings.tab_icon_size }}px;
    height: {{ section.settings.tab_icon_size }}px;
  }

  #CategoryBannerShop-{{ section.id }} .cts__icon svg {
    width: 100%;
    height: 100%;

    display: block;

    fill: none;
    stroke: currentColor;
    stroke-width: {{ section.settings.icon_stroke_width }};
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #CategoryBannerShop-{{ section.id }} .cts__tab-label {
    display: block;

    margin-top: 7px;

    color: var(--ink);

    font-size: {{ section.settings.tab_label_size }}px;
    line-height: 1.15;
  }

  #CategoryBannerShop-{{ section.id }} .cts__tab.is-active .cts__tab-label {
    font-weight: 600;
  }

  /* CATEGORY PANELS */

  #CategoryBannerShop-{{ section.id }} .cts__panel {
    display: none;
  }

  #CategoryBannerShop-{{ section.id }} .cts__panel.is-active {
    display: block;
    animation: cts-panel-in-{{ section.id }} .3s ease both;
  }

  @keyframes cts-panel-in-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ZONES */

  #CategoryBannerShop-{{ section.id }} .cts__zone {
    padding: {{ section.settings.zone_padding }}px 0;
  }

  #CategoryBannerShop-{{ section.id }} .cts__zone + .cts__zone {
    border-top:
      {{ section.settings.divider_width }}px
      solid
      var(--line);
  }

  #CategoryBannerShop-{{ section.id }} .cts__zone-head {
    margin-bottom: 16px;
  }

  #CategoryBannerShop-{{ section.id }} .cts__zone-title {
    margin: 0;

    color: var(--ink);

    font-family:
      {{ section.settings.heading_font.family }},
      {{ section.settings.heading_font.fallback_families }};

    font-style: {{ section.settings.heading_font.style }};
    font-weight: {{ section.settings.heading_font.weight }};

    font-size: {{ section.settings.zone_heading_size }}px;
    line-height: 1.1;
  }

  #CategoryBannerShop-{{ section.id }} .cts__zone-subtitle {
    margin: 6px 0 0;

    color: var(--muted);

    font-size: 13px;
    line-height: 1.45;
  }

  /* INDEPENDENT BANNER CAROUSEL */

  #CategoryBannerShop-{{ section.id }} .cts__banner-carousel {
    position: relative;

    width: min(
      {{ section.settings.banner_max_width }}px,
      {{ section.settings.banner_width_percent }}%
    );

    margin-left: auto;
    margin-right: auto;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-track {
    display: flex;

    width: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;

    overscroll-behavior-x: contain;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: none;
    -ms-overflow-style: none;

    touch-action: pan-x;

    cursor: grab;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-track::-webkit-scrollbar {
    display: none;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-slide {
    flex: 0 0 100%;

    width: 100%;
    min-width: 0;

    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-link {
    display: block;

    color: inherit;
    text-decoration: none;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-media {
    position: relative;

    width: 100%;

    aspect-ratio: 16 / 10;

    overflow: hidden;

    border-radius: {{ section.settings.banner_radius }}px;

    background:
      color-mix(in srgb, white 24%, var(--theme));
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
    object-position: center;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-placeholder {
    aspect-ratio: 16 / 10;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    border:
      1px dashed
      color-mix(in srgb, var(--ink) 24%, transparent);

    border-radius: {{ section.settings.banner_radius }}px;

    color: var(--muted);

    text-align: center;

    font-size: 13px;
  }

  /* Banner navigation */

  #CategoryBannerShop-{{ section.id }} .cts__banner-arrow {
    position: absolute;

    top: 50%;

    z-index: 5;

    width: {{ section.settings.banner_arrow_size }}px;
    height: {{ section.settings.banner_arrow_size }}px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 0;
    border-radius: 50%;

    background: {{ section.settings.banner_arrow_background }};
    color: {{ section.settings.banner_arrow_color }};

    transform: translateY(-50%);

    cursor: pointer;

    box-shadow: 0 5px 16px rgba(0,0,0,.12);
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-arrow--prev {
    left: 12px;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-arrow--next {
    right: 12px;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-arrow svg {
    width: 42%;
    height: 42%;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-dots {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    margin-top: 10px;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-dot {
    width: {{ section.settings.banner_dot_size }}px;
    height: {{ section.settings.banner_dot_size }}px;

    padding: 0;
    border: 0;
    border-radius: 50%;

    background: var(--ink);

    opacity: .25;

    cursor: pointer;
  }

  #CategoryBannerShop-{{ section.id }} .cts__banner-dot.is-active {
    opacity: 1;
  }

  @media screen and (max-width: 990px) {
    #CategoryBannerShop-{{ section.id }} .cts__banner-carousel {
      width: min(
        {{ section.settings.tablet_banner_max_width }}px,
        {{ section.settings.tablet_banner_width_percent }}%
      );
    }

    #CategoryBannerShop-{{ section.id }} .cts__inner {
      width:
        min(
          {{ section.settings.max_width }}px,
          calc(
            100% -
            {{ section.settings.tablet_side_padding | times: 2 }}px
          )
        );
    }
  }

  @media screen and (max-width: 749px) {
    #CategoryBannerShop-{{ section.id }} .cts__banner-carousel {
      width: min(
        {{ section.settings.mobile_banner_max_width }}px,
        {{ section.settings.mobile_banner_width_percent }}%
      );
    }

    #CategoryBannerShop-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #CategoryBannerShop-{{ section.id }} .cts__inner {
      width:
        calc(
          100% -
          {{ section.settings.mobile_side_padding | times: 2 }}px
        );
    }

    #CategoryBannerShop-{{ section.id }} .cts__tabs {
      gap: {{ section.settings.mobile_tab_gap }}px;
    }

    #CategoryBannerShop-{{ section.id }} .cts__tab {
      width: {{ section.settings.mobile_tab_width }}px;
    }

    #CategoryBannerShop-{{ section.id }} .cts__tab-box {
      width: {{ section.settings.mobile_tab_box_size }}px;
      height: {{ section.settings.mobile_tab_box_size }}px;

      border-radius:
        {{ section.settings.mobile_tab_box_radius }}px;
    }

    #CategoryBannerShop-{{ section.id }} .cts__icon {
      width: {{ section.settings.mobile_tab_icon_size }}px;
      height: {{ section.settings.mobile_tab_icon_size }}px;
    }

    #CategoryBannerShop-{{ section.id }} .cts__tab-label {
      font-size:
        {{ section.settings.mobile_tab_label_size }}px;
    }

    #CategoryBannerShop-{{ section.id }} .cts__zone {
      padding:
        {{ section.settings.mobile_zone_padding }}px 0;
    }

    #CategoryBannerShop-{{ section.id }} .cts__zone-title {
      font-size:
        {{ section.settings.mobile_zone_heading_size }}px;
    }

    #CategoryBannerShop-{{ section.id }} .cts__banner-arrow {
      width: 34px;
      height: 34px;
    }

    #CategoryBannerShop-{{ section.id }} .cts__banner-arrow--prev {
      left: 7px;
    }

    #CategoryBannerShop-{{ section.id }} .cts__banner-arrow--next {
      right: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #CategoryBannerShop-{{ section.id }} {
      transition: none;
    }

    #CategoryBannerShop-{{ section.id }} .cts__panel.is-active {
      animation: none;
    }
  }
{% endstyle %}


<section
  id="CategoryBannerShop-{{ section.id }}"
  data-banner-autoplay="{{ section.settings.banner_autoplay }}"
  data-banner-delay="{{ section.settings.banner_autoplay_delay }}"
  data-banner-resume="{{ section.settings.banner_resume_delay }}"
  data-banner-speed="{{ section.settings.banner_transition_speed }}"
>
  <div class="cts__inner">

    <!-- CATEGORY BUTTONS -->

    <div
      class="cts__tabs"
      role="tablist"
      aria-label="Product categories"
    >
      {% assign tab_index = 0 %}

      {% for block in section.blocks %}
        {% if block.settings.enabled %}

          {% assign category_label = block.settings.label %}

          {% if category_label == blank and block.settings.collection != blank %}
            {% assign category_label = block.settings.collection.title %}
          {% endif %}

          {% if category_label == blank %}
            {% assign category_label = 'Category' %}
          {% endif %}

          <button
            type="button"
            class="cts__tab{% if tab_index == 0 %} is-active{% endif %}"
            data-category-tab="{{ tab_index }}"
            data-block-id="{{ block.id }}"
            data-theme-color="{{ block.settings.theme_color }}"
            data-theme-text="{{ block.settings.theme_text_color }}"
            aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
            style="
              --tab-color: {{ block.settings.button_color }};
              --tab-ink: {{ block.settings.button_icon_color }};
            "
            {{ block.shopify_attributes }}
          >
            <span class="cts__tab-box">
              <span class="cts__icon">

{% case block.settings.icon %}
  {% when 'sunglasses' %}
    <svg viewBox="0 0 48 48"><path d="M5 20h6l3 13c.5 2.4 2.4 4 5 4h2c2.4 0 4.3-1.6 5-4l1-5h-6l1 5c.7 2.4 2.6 4 5 4h2c2.6 0 4.5-1.6 5-4l3-13h6"/><path d="M11 20c7-4 19-4 26 0"/></svg>
  {% when 'lamp' %}
    <svg viewBox="0 0 48 48"><path d="M15 20h18L29 8H19l-4 12Z"/><path d="M24 20v17m-7 4h14M20 37h8"/></svg>
  {% when 'glassware' %}
    <svg viewBox="0 0 48 48"><path d="M10 7h11l-1 13c-.3 4-2.6 6-4.5 6S11.3 24 11 20L10 7Z"/><path d="M15.5 26v11m-5 4h10"/><path d="M28 7h10l-1 10c-.4 4-2.4 6-4 6s-3.6-2-4-6L28 7Z"/><path d="M33 23v14m-5 4h10"/></svg>
  {% when 'lunchbox' %}
    <svg viewBox="0 0 48 48"><rect x="8" y="15" width="32" height="25" rx="5"/><path d="M17 15v-3c0-2 2-4 4-4h6c2 0 4 2 4 4v3M8 25h32"/></svg>
  {% when 'serveware' %}
    <svg viewBox="0 0 48 48"><path d="M8 31h32M11 31c1-10 6-16 13-16s12 6 13 16"/><path d="M21 12c0-2 1-4 3-4s3 2 3 4"/></svg>
  {% when 'dinnerware' %}
    <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="15"/><circle cx="24" cy="24" r="9"/><path d="M6 9v30M3 16h6M42 9c-3 5-3 10 0 14v16"/></svg>
  {% when 'sculpture' %}
    <svg viewBox="0 0 48 48"><path d="M18 12c2-4 10-4 12 1 1 3-1 5-3 7 4 2 6 6 5 10-1 4-4 7-8 7s-8-3-9-7c-1-4 1-8 5-10-2-2-3-5-2-8Z"/><path d="M13 41h22M17 37h14"/></svg>
  {% when 'mug' %}
    <svg viewBox="0 0 48 48"><path d="M10 12h24v24H10z"/><path d="M34 17h4c5 0 5 14 0 14h-4M15 8c0-2 2-3 2-5m7 5c0-2 2-3 2-5"/></svg>
  {% when 'stationery' %}
    <svg viewBox="0 0 48 48"><rect x="10" y="7" width="28" height="34" rx="3"/><path d="M17 7v34M21 14h11M21 20h11M21 26h9"/></svg>
  {% when 'fashion' %}
    <svg viewBox="0 0 48 48"><path d="M17 9 9 14l5 10 5-3v19h18V21l5 3 5-10-8-5-5 6H22l-5-6Z"/></svg>
  {% when 'beauty' %}
    <svg viewBox="0 0 48 48"><path d="M19 13h10v27H19zM21 8h6v5M17 40h14"/><path d="M29 19h5v21h-5"/></svg>
  {% when 'electronics' %}
    <svg viewBox="0 0 48 48"><rect x="14" y="5" width="20" height="38" rx="4"/><path d="M21 9h6M22 38h4"/></svg>
  {% else %}
    <svg viewBox="0 0 48 48"><path d="M7 23 24 8l17 15"/><path d="M11 20v20h26V20M20 40V28h8v12"/></svg>
{% endcase %}

              </span>
            </span>

            <span class="cts__tab-label">
              {{ category_label | escape }}
            </span>
          </button>

          {% assign tab_index = tab_index | plus: 1 %}

        {% endif %}
      {% endfor %}
    </div>


    <!-- CATEGORY PANELS -->

    {% assign panel_index = 0 %}

    {% for block in section.blocks %}
      {% if block.settings.enabled %}

        <div
          class="cts__panel{% if panel_index == 0 %} is-active{% endif %}"
          data-category-panel="{{ panel_index }}"
          data-block-id="{{ block.id }}"
          {% unless panel_index == 0 %}hidden{% endunless %}
        >


<section class="cts__zone">
  <div class="cts__zone-head">
    <div>
      <h2 class="cts__zone-title">{{ section.settings.new_heading }}</h2>
      {% if section.settings.new_subtitle != blank %}
        <p class="cts__zone-subtitle">{{ section.settings.new_subtitle }}</p>
      {% endif %}
    </div>
  </div>

  <div
    class="cts__banner-carousel"
    data-banner-carousel
    data-zone="new"
    aria-label="New Arrivals banners"
  >
    <div class="cts__banner-track" data-banner-track>
      {% assign banner_count = 0 %}
      {% for i in (1..3) %}
        {% assign image_key = 'new_banner_' | append: i %}
        {% assign link_key = 'new_banner_link_' | append: i %}
        {% assign banner = block.settings[image_key] %}
        {% assign banner_link = block.settings[link_key] %}

        {% if banner != blank %}
          {% assign banner_count = banner_count | plus: 1 %}
          <div class="cts__banner-slide" data-banner-slide>
            {% if banner_link != blank %}
              <a class="cts__banner-link" href="{{ banner_link }}">
            {% else %}
              <div class="cts__banner-link">
            {% endif %}

              <div class="cts__banner-media">
                {{
                  banner
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'lazy',
                    widths: '480, 720, 960, 1200, 1500, 1800',
                    sizes: '(max-width: 749px) 94vw, (max-width: 990px) 92vw, 90vw',
                    class: 'cts__banner-image',
                    alt: banner.alt
                }}
              </div>

            {% if banner_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      {% if banner_count == 0 and request.design_mode %}
        <div class="cts__banner-slide cts__banner-placeholder">
          Upload up to 3 New Arrivals banner images in this category block.
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_banner_arrows %}
      <button
        type="button"
        class="cts__banner-arrow cts__banner-arrow--prev"
        data-banner-prev
        aria-label="Previous New Arrivals banner"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="cts__banner-arrow cts__banner-arrow--next"
        data-banner-next
        aria-label="Next New Arrivals banner"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {% endif %}

    {% if section.settings.show_banner_dots %}
      <div class="cts__banner-dots" data-banner-dots aria-label="New Arrivals banner navigation"></div>
    {% endif %}
  </div>
</section>

<section class="cts__zone">
  <div class="cts__zone-head">
    <div>
      <h2 class="cts__zone-title">{{ section.settings.best_heading }}</h2>
      {% if section.settings.best_subtitle != blank %}
        <p class="cts__zone-subtitle">{{ section.settings.best_subtitle }}</p>
      {% endif %}
    </div>
  </div>

  <div
    class="cts__banner-carousel"
    data-banner-carousel
    data-zone="best"
    aria-label="Best Sellers banners"
  >
    <div class="cts__banner-track" data-banner-track>
      {% assign banner_count = 0 %}
      {% for i in (1..3) %}
        {% assign image_key = 'best_banner_' | append: i %}
        {% assign link_key = 'best_banner_link_' | append: i %}
        {% assign banner = block.settings[image_key] %}
        {% assign banner_link = block.settings[link_key] %}

        {% if banner != blank %}
          {% assign banner_count = banner_count | plus: 1 %}
          <div class="cts__banner-slide" data-banner-slide>
            {% if banner_link != blank %}
              <a class="cts__banner-link" href="{{ banner_link }}">
            {% else %}
              <div class="cts__banner-link">
            {% endif %}

              <div class="cts__banner-media">
                {{
                  banner
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'lazy',
                    widths: '480, 720, 960, 1200, 1500, 1800',
                    sizes: '(max-width: 749px) 94vw, (max-width: 990px) 92vw, 90vw',
                    class: 'cts__banner-image',
                    alt: banner.alt
                }}
              </div>

            {% if banner_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      {% if banner_count == 0 and request.design_mode %}
        <div class="cts__banner-slide cts__banner-placeholder">
          Upload up to 3 Best Sellers banner images in this category block.
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_banner_arrows %}
      <button
        type="button"
        class="cts__banner-arrow cts__banner-arrow--prev"
        data-banner-prev
        aria-label="Previous Best Sellers banner"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="cts__banner-arrow cts__banner-arrow--next"
        data-banner-next
        aria-label="Next Best Sellers banner"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {% endif %}

    {% if section.settings.show_banner_dots %}
      <div class="cts__banner-dots" data-banner-dots aria-label="Best Sellers banner navigation"></div>
    {% endif %}
  </div>
