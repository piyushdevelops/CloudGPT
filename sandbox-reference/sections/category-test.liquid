<section class="cts__zone">
  <div class="cts__zone-head">
    <div>
      <h2 class="cts__zone-title">{{ section.settings.gift_heading }}</h2>
      {% if section.settings.gift_subtitle != blank %}
        <p class="cts__zone-subtitle">{{ section.settings.gift_subtitle }}</p>
      {% endif %}
    </div>
  </div>

  <div
    class="cts__banner-carousel"
    data-banner-carousel
    data-zone="gift"
    aria-label="Gifting banners"
  >
    <div class="cts__banner-track" data-banner-track>
      {% assign banner_count = 0 %}
      {% for i in (1..3) %}
        {% assign image_key = 'gift_banner_' | append: i %}
        {% assign link_key = 'gift_banner_link_' | append: i %}
        {% assign banner = block.settings[image_key] %}
        {% assign banner_link = block.settings[link_key] %}

        {% if banner != blank %}
          {% assign banner_count = banner_count | plus: 1 %}
          <div class="cts__banner-slide" data-banner-slide>
            {% if banner_link != blank %}
              <a class="cts__banner-link" href="{{ banner_link }}">
            {% else %}
              <div class="cts__banner-link">
            {% endif %}

              <div class="cts__banner-media">
                {{
                  banner
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'lazy',
                    widths: '480, 720, 960, 1200, 1500, 1800',
                    sizes: '(max-width: 749px) 94vw, (max-width: 990px) 92vw, 90vw',
                    class: 'cts__banner-image',
                    alt: banner.alt
                }}
              </div>

            {% if banner_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      {% if banner_count == 0 and request.design_mode %}
        <div class="cts__banner-slide cts__banner-placeholder">
          Upload up to 3 Gifting banner images in this category block.
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_banner_arrows %}
      <button
        type="button"
        class="cts__banner-arrow cts__banner-arrow--prev"
        data-banner-prev
        aria-label="Previous Gifting banner"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="cts__banner-arrow cts__banner-arrow--next"
        data-banner-next
        aria-label="Next Gifting banner"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
