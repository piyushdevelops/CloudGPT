<script>
  (() => {
    const showSectionToast = (root, message) => {
      const toast = root?.querySelector?.('[data-toast]');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('is-visible');
      clearTimeout(toast._tjsTimer);
      toast._tjsTimer = setTimeout(() => toast.classList.remove('is-visible'), 2500);
    };







    if (customElements.get('tjs-final-search')) {
      return;
    }

    class TjsFinalSearch extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready === 'true') return;
        this.dataset.ready = 'true';

        this.sectionId = this.dataset.sectionId;
        this.grid = this.querySelector('[data-grid]');
        this.drawer = this.querySelector('[data-filter-drawer]');
        this.status = this.querySelector('[data-status]');
        this.toast = this.querySelector('[data-toast]');
        this.floatingType = this.querySelector('[data-floating-type]');
        this.floatingAnchor = this.querySelector('[data-floating-anchor]');
        this.lastTrigger = null;
        this.requestController = null;
        this.scrollTicking = false;
        this.searchSuggestionRoots = [];
        this.searchSuggestionRecentKey = 'tjs_search_page_recent';
        this.searchSuggestionOutsideHandler = null;
        this.exactSearchRoutes = this.parseSearchMap(
          this.querySelector('[data-tjs-search-exact-routes]')?.textContent || '""'
        );
        this.searchSynonyms = this.parseSearchMap(
          this.querySelector('[data-tjs-search-synonyms]')?.textContent || '""'
        );

        if (this.redirectExactCategorySearch()) return;

        this.boundClick = this.handleClick.bind(this);
        this.boundChange = this.handleChange.bind(this);
        this.boundSubmit = this.handleSubmit.bind(this);
        this.boundScroll = this.handleScroll.bind(this);
        this.boundResize = this.handleResize.bind(this);
        this.addEventListener('click', this.boundClick);
        this.addEventListener('change', this.boundChange);
        this.addEventListener('submit', this.boundSubmit);

        this.initializeProductCards(this);
        this.initializeFilterSwatches();
        this.setupSearchSuggestions();
        this.observeCards();
        this.setupFloatingType();
        this.ensureSearchParameters();
        this.checkSearchMatches();
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.boundClick);
        this.removeEventListener('change', this.boundChange);
        this.removeEventListener('submit', this.boundSubmit);
        window.removeEventListener('scroll', this.boundScroll);
        window.removeEventListener('resize', this.boundResize);
        this.revealObserver?.disconnect();
        this.requestController?.abort();
        this.matchController?.abort();
        if (this.searchSuggestionOutsideHandler) {
          document.removeEventListener('pointerdown', this.searchSuggestionOutsideHandler);
        }
        this.searchSuggestionRoots.forEach(root => {
          root._tjsSuggestionController?.abort?.();
          clearTimeout(root._tjsSuggestionTimer);
        });
      }

      async checkSearchMatches() {
        if(this.dataset.searchPerformed !== 'true' || !this.dataset.searchQuery.trim()) {this.dataset.matchState='ready';return;}
        this.matchController?.abort();
        const controller=this.matchController=new AbortController();
        try {
          const {hasKeywordMatches}=await import({{ 'june-search-matches.js' | asset_url | json }});
          const matched=await hasKeywordMatches(this.dataset.predictiveUrl, this.normaliseSearchQuery(this.dataset.searchQuery), controller.signal);
          if(controller.signal.aborted || !this.isConnected) return;
          document.title=matched ? 'Search: '+this.dataset.searchQuery+' — The June Shop' : 'No matching products: '+this.dataset.searchQuery+' — The June Shop';
          if(!matched && this.grid?.querySelector('.tjs-product-card')) {
            const notice=document.createElement('div');notice.className='tjs-final-collection__empty';
            const heading=document.createElement('h2');heading.textContent='No matching products found';
            const label=document.createElement('p');label.textContent='You might also like';notice.append(heading,label);
            this.grid.prepend(notice);
            // These are Shopify's broader suggestions, not matching result counts or facets.
            this.querySelectorAll('.tjs-product-card').forEach((card,index)=>{if(index>=4)card.remove();});
            this.querySelectorAll('.tjs-final-collection__controls, .tjs-final-collection__load-wrap, [data-filter-drawer], [data-floating-type]').forEach(node=>node.hidden=true);
            this.announce('No matching products found. You might also like these products.');
            this.dataset.searchRecommendations='true';
          }
        } catch(error) {
          if(error.name!=='AbortError') this.announce('Unable to verify search matches. Please try again.');
        } finally {this.dataset.matchState='ready';}
      }

      parseSearchMap(jsonText) {
        let rawText = '';

        try {
          rawText = JSON.parse(jsonText || '""') || '';
        } catch (error) {
          rawText = '';
        }

        const map = new Map();

        String(rawText)
          .split(/\r?\n/)
          .map(line => line.trim())
          .filter(Boolean)
          .forEach(line => {
            const parts = line.split('=>');
            if (parts.length < 2) return;

            const destination = parts.slice(1).join('=>').trim();
            if (!destination) return;

            parts[0]
              .split('|')
              .map(alias => this.normaliseSearchKey(alias))
              .filter(Boolean)
              .forEach(alias => map.set(alias, destination));
          });

        return map;
      }

      normaliseSearchKey(value) {
        return String(value || '')
          .toLowerCase()
          .replace(/[“”"'`]/g, '')
          .replace(/&/g, ' and ')
          .replace(/[^a-z0-9]+/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      normaliseSearchQuery(query) {
        const original = String(query || '').trim();
        const key = this.normaliseSearchKey(original);
        return this.searchSynonyms.get(key) || original;
      }

      exactSearchDestination(query) {
        const key = this.normaliseSearchKey(query);
        return this.exactSearchRoutes.get(key) || '';
      }

      redirectExactCategorySearch() {
        if (this.dataset.searchPerformed !== 'true') return false;

        const currentUrl = new URL(window.location.href);
        const query = currentUrl.searchParams.get('q') || this.dataset.searchQuery || '';
        const exactDestination = this.exactSearchDestination(query);
        const hasIntentionalFilters = [...currentUrl.searchParams.keys()]
          .some(key => key.startsWith('filter.'));

        if (!exactDestination || hasIntentionalFilters) return false;

        const destinationUrl = new URL(exactDestination, window.location.origin);

        if (
          destinationUrl.pathname === window.location.pathname &&
          destinationUrl.search === window.location.search
        ) {
          return false;
        }

        window.location.replace(destinationUrl.pathname + destinationUrl.search);
        return true;
      }

      ensureSearchParameters() {
        if (this.dataset.searchPerformed !== 'true') return;

        const currentUrl = new URL(window.location.href);
        let changed = false;

        if (currentUrl.searchParams.get('type') !== 'product') {
          currentUrl.searchParams.set('type', 'product');
          changed = true;
        }

        if (currentUrl.searchParams.get('options[prefix]') !== 'last') {
          currentUrl.searchParams.set('options[prefix]', 'last');
          changed = true;
        }

        if (currentUrl.searchParams.get('options[unavailable_products]') !== 'last') {
          currentUrl.searchParams.set('options[unavailable_products]', 'last');
          changed = true;
        }

        [...currentUrl.searchParams.keys()].forEach(key => {
          if (key.startsWith('resources[')) {
            currentUrl.searchParams.delete(key);
            changed = true;
          }
        });

        if (this.dataset.forceInStock === 'true') {
          const param = this.dataset.availabilityParam;
          const value = this.dataset.availabilityValue;

          if (
            param &&
            value &&
            !currentUrl.searchParams.getAll(param).includes(value)
          ) {
            currentUrl.searchParams.set(param, value);
            changed = true;
          }
        }

        if (!changed) return;

        currentUrl.searchParams.delete('page');
        this.fetchSection(currentUrl.toString(), {
          updateUrl: true,
          replaceUrl: true,
          preserveScroll: true
        });
      }

      setupSearchSuggestions() {
        this.searchSuggestionRoots = [
          ...this.querySelectorAll('[data-search-suggest-root]')
        ];

        if (!this.searchSuggestionRoots.length) return;

        this.searchSuggestionOutsideHandler = event => {
          this.searchSuggestionRoots.forEach(root => {
            if (!root.contains(event.target)) this.closeSearchSuggestion(root);
          });
        };

        document.addEventListener(
          'pointerdown',
          this.searchSuggestionOutsideHandler
        );

        this.searchSuggestionRoots.forEach(root => {
          const input = root.querySelector('input[name="q"]');
          const panel = root.querySelector('[data-search-suggest]');
          const form = root.matches('form') ? root : root.querySelector('form');

          if (!input || !panel || !form) return;

          root._tjsDefaultSuggestionHTML = panel.innerHTML;

          const openDefault = () => {
            this.closeOtherSearchSuggestions(root);
            this.restoreDefaultSearchSuggestion(root);
            panel.hidden = false;
          };

          input.addEventListener('focus', openDefault);
          input.addEventListener('click', openDefault);

          input.addEventListener('input', () => {
            clearTimeout(root._tjsSuggestionTimer);
            const query = input.value.trim();

            if (query.length < 2) {
              root._tjsSuggestionController?.abort?.();
              this.restoreDefaultSearchSuggestion(root);
              panel.hidden = false;
              return;
            }

            root._tjsSuggestionTimer = setTimeout(() => {
              this.fetchSearchSuggestions(root, query);
            }, 180);
          });

          input.addEventListener('keydown', event => {
            if (event.key === 'Escape') {
              this.closeSearchSuggestion(root);
              input.blur();
              return;
            }

            if (event.key === 'ArrowDown' && !panel.hidden) {
              const firstLink = panel.querySelector('a[href], button:not([disabled])');
              if (firstLink) {
                event.preventDefault();
                firstLink.focus();
              }
            }
          });

          panel.addEventListener('keydown', event => {
            const controls = [
              ...panel.querySelectorAll('a[href], button:not([disabled])')
            ];
            const index = controls.indexOf(document.activeElement);

            if (event.key === 'ArrowDown' && index > -1) {
              event.preventDefault();
              controls[(index + 1) % controls.length]?.focus();
            }

            if (event.key === 'ArrowUp' && index > -1) {
              event.preventDefault();

              if (index === 0) input.focus();
              else controls[index - 1]?.focus();
            }

            if (event.key === 'Escape') {
              event.preventDefault();
              this.closeSearchSuggestion(root);
              input.focus();
            }
          });

          panel.addEventListener('click', event => {
            const clearRecent = event.target.closest('[data-clear-recent]');

            if (clearRecent) {
              this.clearRecentSearches();
              this.restoreDefaultSearchSuggestion(root);
              return;
            }

            const link = event.target.closest('a[href]');
            if (!link) return;

            const query = this.searchQueryFromUrl(link.href);
            if (query) this.saveRecentSearch(query);
          });

          form.addEventListener('submit', event => {
            event.preventDefault();

            const query = input.value.trim();
            if (!query) return;

            this.saveRecentSearch(query);
            window.location.assign(this.buildSearchSuggestionUrl(query));
          });
        });
      }

      closeOtherSearchSuggestions(activeRoot) {
        this.searchSuggestionRoots.forEach(root => {
          if (root !== activeRoot) this.closeSearchSuggestion(root);
        });
      }

      closeSearchSuggestion(root) {
        const panel = root?.querySelector?.('[data-search-suggest]');
        if (panel) panel.hidden = true;
      }

      restoreDefaultSearchSuggestion(root) {
        const panel = root?.querySelector?.('[data-search-suggest]');
        if (!panel) return;

        panel.innerHTML = root._tjsDefaultSuggestionHTML || '';
        this.populateRecentSearches(panel);
      }

      readRecentSearches() {
        try {
          const searches = JSON.parse(
            window.localStorage.getItem(this.searchSuggestionRecentKey) || '[]'
          );

          return Array.isArray(searches)
            ? searches.map(value => String(value || '').trim()).filter(Boolean).slice(0, 5)
            : [];
        } catch (error) {
          return [];
        }
      }

      saveRecentSearch(query) {
        const cleanQuery = String(query || '').trim();
        if (!cleanQuery) return;

        const searches = [
          cleanQuery,
          ...this.readRecentSearches().filter(
            value => value.toLowerCase() !== cleanQuery.toLowerCase()
          )
        ].slice(0, 5);

        try {
          window.localStorage.setItem(
            this.searchSuggestionRecentKey,
            JSON.stringify(searches)
          );
        } catch (error) {}
      }

      clearRecentSearches() {
        try {
          window.localStorage.removeItem(this.searchSuggestionRecentKey);
        } catch (error) {}
      }

      populateRecentSearches(panel) {
        const group = panel.querySelector('[data-suggest-recent-group]');
        const list = panel.querySelector('[data-suggest-recent]');
        if (!group || !list) return;

        const recent = this.readRecentSearches();

        if (!recent.length) {
          group.hidden = true;
          list.innerHTML = '';
          return;
        }

        list.innerHTML = recent.map(term => `
          <a
            class="tjs-search-suggest__term"
            href="${this.buildSearchSuggestionUrl(term)}"
            data-suggest-search-link
          >
            <span class="tjs-search-suggest__term-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </span>
            <span>${this.escapeSuggestionHTML(term)}</span>
            <svg class="tjs-search-suggest__arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        `).join('');

        group.hidden = false;
      }

      async fetchSearchSuggestions(root, query) {
        const panel = root.querySelector('[data-search-suggest]');
        const requestQuery = this.normaliseSearchQuery(query);
        if (!panel) return;

        root._tjsSuggestionController?.abort?.();
        root._tjsSuggestionController = new AbortController();
        const suggestionController = root._tjsSuggestionController;

        panel.hidden = false;
        panel.innerHTML = `
          <div class="tjs-search-suggest__loading">
            Finding the best matches…
          </div>
        `;

        const basePredictiveUrl = this.dataset.predictiveUrl || '/search/suggest';
        const endpoint = basePredictiveUrl.endsWith('.json')
          ? basePredictiveUrl
          : `${basePredictiveUrl}.json`;
        const requestUrl = new URL(endpoint, window.location.origin);

        requestUrl.searchParams.set('q', requestQuery);
        requestUrl.searchParams.set(
          'resources[type]',
          'product,query,collection'
        );
        requestUrl.searchParams.set('resources[limit]', '6');
        requestUrl.searchParams.set('resources[limit_scope]', 'each');
        requestUrl.searchParams.set(
          'resources[options][unavailable_products]',
          'last'
        );
        requestUrl.searchParams.set(
          'resources[options][prefix]',
          'last'
        );
        requestUrl.searchParams.set(
          'resources[options][fields]',
          'title,product_type,variants.title,variants.sku'
        );

        try {
          const response = await fetch(requestUrl.toString(), {
            signal: root._tjsSuggestionController.signal,
            headers: { Accept: 'application/json' }
          });

          if (!response.ok) throw new Error('Search suggestions unavailable.');

          const payload = await response.json();
          if (suggestionController.signal.aborted || root._tjsSuggestionController !== suggestionController || !root.isConnected || root.querySelector('[data-input-search]')?.value.trim() !== query.trim()) return;
          const resources =
            payload?.resources?.results ||
            payload?.resources ||
            payload?.results ||
            {};

          const {hasKeywordMatches}=await import({{ 'june-search-matches.js' | asset_url | json }});
          resources.juneRecommendations = (resources.products || []).length && !await hasKeywordMatches(endpoint, requestQuery, suggestionController.signal, resources.products || []);
          if(suggestionController.signal.aborted || root._tjsSuggestionController!==suggestionController || !root.isConnected || root.querySelector('[data-input-search]')?.value.trim()!==query.trim()) return;
          this.renderDynamicSearchSuggestions(panel, query, resources);
        } catch (error) {
          if (error.name === 'AbortError') return;

          panel.innerHTML = `
            <div class="tjs-search-suggest__empty">
              <a
                class="tjs-search-suggest__view-all"
                href="${this.buildSearchSuggestionUrl(query)}"
              >
                <span>Search for “${this.escapeSuggestionHTML(query)}”</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          `;
        }
      }

      renderDynamicSearchSuggestions(panel, query, resources) {
        const queries = Array.isArray(resources.queries)
          ? resources.queries.slice(0, 5)
          : [];
        const collections = Array.isArray(resources.collections)
          ? resources.collections.slice(0, 4)
          : [];
        const products = Array.isArray(resources.products)
          ? resources.products.slice(0, 6)
          : [];

        const leftSections = [];

        if (queries.length) {
          leftSections.push(`
            <section class="tjs-search-suggest__dynamic-section">
              <span class="tjs-search-suggest__dynamic-title">Search suggestions</span>
              <div class="tjs-search-suggest__term-list">
                ${queries.map(item => {
                  const text = item.text || item.title || query;
                  const url = item.url || this.buildSearchSuggestionUrl(text);

                  return this.searchSuggestionTermMarkup(text, url, false);
                }).join('')}
              </div>
            </section>
          `);
        }

        if (collections.length) {
          leftSections.push(`
            <section class="tjs-search-suggest__dynamic-section">
              <span class="tjs-search-suggest__dynamic-title">Categories</span>
              <div class="tjs-search-suggest__term-list">
                ${collections.map(item =>
                  this.searchSuggestionTermMarkup(
                    item.title || 'Collection',
                    item.url || '#',
                    true
                  )
                ).join('')}
              </div>
            </section>
          `);
        }

        const productsMarkup = products.map(product => {
          const image =
            product.featured_image?.url ||
            product.image?.url ||
            product.image ||
            product.featured_image ||
            '';
          const title = product.title || 'Product';
          const url = product.url || '#';
          const type =
            product.type ||
            product.product_type ||
            product.vendor ||
            'The June Shop';
          const price = this.formatSuggestionMoney(
            product.price ??
            product.price_min ??
            product.price_max
          );
          const compare = this.formatSuggestionMoney(
            product.compare_at_price ??
            product.compare_at_price_min ??
            product.compare_at_price_max
          );

          return `
            <a
              class="tjs-search-suggest__product"
              href="${this.escapeSuggestionAttribute(url)}"
              data-suggest-product-link
            >
              <span class="tjs-search-suggest__product-image">
                ${image
                  ? `<img src="${this.escapeSuggestionAttribute(image)}" alt="" loading="lazy">`
                  : ''
                }
              </span>

              <span class="tjs-search-suggest__product-copy">
                <strong>${this.escapeSuggestionHTML(title)}</strong>
                <small>${this.escapeSuggestionHTML(type)}</small>
                ${price ? `
                  <span class="tjs-search-suggest__product-price">
                    <b>${this.escapeSuggestionHTML(price)}</b>
                    ${compare && compare !== price
                      ? `<s>${this.escapeSuggestionHTML(compare)}</s>`
                      : ''
                    }
                  </span>
                ` : ''}
              </span>

              <svg class="tjs-search-suggest__product-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          `;
        }).join('');

        if (!leftSections.length && !productsMarkup) {
          panel.innerHTML = `
            <div class="tjs-search-suggest__empty">
              No quick matches yet. Search the full catalogue instead.
            </div>
            <a
              class="tjs-search-suggest__view-all"
              href="${this.buildSearchSuggestionUrl(query)}"
            >
              <span>Search for “${this.escapeSuggestionHTML(query)}”</span>
              <span aria-hidden="true">→</span>
            </a>
          `;
          return;
        }

        panel.innerHTML = `
          <div class="tjs-search-suggest__dynamic">
            <div class="tjs-search-suggest__dynamic-left">
              ${leftSections.join('')}
            </div>

            <div class="tjs-search-suggest__dynamic-right">
              <span class="tjs-search-suggest__dynamic-title">${resources.juneRecommendations ? 'No matching products found — You might also like' : 'Products'}</span>
              <div class="tjs-search-suggest__products">
                ${productsMarkup || '<div class="tjs-search-suggest__empty">No product matches yet.</div>'}
              </div>
            </div>
          </div>

          <a
            class="tjs-search-suggest__view-all"
            href="${this.buildSearchSuggestionUrl(query)}"
          >
            <span>View all results for “${this.escapeSuggestionHTML(query)}”</span>
            <span aria-hidden="true">→</span>
          </a>
        `;
      }

      searchSuggestionTermMarkup(text, url, category = false) {
        return `
          <a
            class="tjs-search-suggest__term"
            href="${this.escapeSuggestionAttribute(url)}"
            data-suggest-search-link
          >
            <span class="tjs-search-suggest__term-icon" aria-hidden="true">
              ${category
                ? `<svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 6.5h6v5H4v-5Zm10 0h6v5h-6v-5ZM4 15h6v3H4v-3Zm10 0h6v3h-6v-3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  </svg>`
                : `<svg viewBox="0 0 24 24" fill="none">
                    <circle cx="10.5" cy="10.5" r="6.4" stroke="currentColor" stroke-width="1.5"/>
                    <path d="m15.3 15.3 4.2 4.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>`
              }
            </span>
            <span>${this.escapeSuggestionHTML(text)}</span>
            <svg class="tjs-search-suggest__arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        `;
      }

      buildSearchSuggestionUrl(query) {
        const cleanQuery = String(query || '').trim();
        const exactDestination = this.exactSearchDestination(cleanQuery);

        if (exactDestination) {
          const destinationUrl = new URL(exactDestination, window.location.origin);
          return destinationUrl.pathname + destinationUrl.search;
        }

        const normalizedQuery = this.normaliseSearchQuery(cleanQuery);
        const url = new URL(
          this.dataset.searchUrl || '/search',
          window.location.origin
        );

        url.search = '';
        url.searchParams.set('q', normalizedQuery);
        url.searchParams.set('type', 'product');
        url.searchParams.set('options[prefix]', 'last');
        url.searchParams.set('options[unavailable_products]', 'last');
        url.searchParams.set(
          'options[fields]',
          'title,product_type,variants.title,variants.sku'
        );

        return url.pathname + url.search;
      }

      searchQueryFromUrl(href) {
        try {
          return new URL(href, window.location.origin).searchParams.get('q') || '';
        } catch (error) {
          return '';
        }
      }

      formatSuggestionMoney(value) {
        if (value === null || value === undefined || value === '') return '';

        const raw =
          typeof value === 'object'
            ? value.amount ?? value.value ?? ''
            : value;
        const text = String(raw).trim();

        if (!text) return '';
        if (/[₹$£€]|Rs\.?|INR/i.test(text)) return text;

        const number = Number(text.replace(/,/g, ''));
        if (!Number.isFinite(number)) return text;

        try {
          return new Intl.NumberFormat('en-IN', {
            style: 'currency',
            currency: this.dataset.currency || 'INR',
            maximumFractionDigits: 0
          }).format(number);
        } catch (error) {
          return `₹${Math.round(number).toLocaleString('en-IN')}`;
        }
      }

      escapeSuggestionHTML(value) {
        return String(value || '').replace(/[&<>"']/g, character => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;'
        })[character]);
      }

      escapeSuggestionAttribute(value) {
        return this.escapeSuggestionHTML(String(value || ''));
      }

      initializeFilterSwatches() {
        this.querySelectorAll('[data-filter-colour]').forEach(swatch => {
          const label = swatch.dataset.filterColour || '';
          const colour = this.resolveFilterColour(label);
          swatch.style.background = colour;
        });
      }

      resolveFilterColour(label) {
        const key = String(label || '').toLowerCase().replace(/[_-]+/g, ' ').trim();

        if (/(multi|rainbow|assorted)/.test(key)) {
          return 'conic-gradient(#E15B64, #F3C969, #58A66C, #4AA7C8, #7B61A8, #E15B64)';
        }
        if (key.includes('black') && key.includes('gold')) {
          return 'linear-gradient(135deg, #151515 0 50%, #D4AF37 50% 100%)';
        }
        if (key.includes('white') && key.includes('gold')) {
          return 'linear-gradient(135deg, #FFFFFF 0 50%, #D4AF37 50% 100%)';
        }
        if (key.includes('cyan') && key.includes('purple')) {
          return 'linear-gradient(135deg, #31B7D7 0 50%, #7E57A2 50% 100%)';
        }
        if (/(clear|transparent)/.test(key)) {
          return 'linear-gradient(135deg, #FFFFFF 0 44%, #D8D8D8 45% 55%, #FFFFFF 56% 100%)';
        }

        const colours = [
          [/rose gold/, '#B76E79'],
          [/navy/, '#1F3155'],
          [/sky blue/, '#87CEEB'],
          [/royal blue/, '#3157A4'],
          [/turquoise|cyan/, '#35B6B4'],
          [/teal/, '#267A78'],
          [/blue/, '#3F6FB5'],
          [/lavender/, '#B7A1D6'],
          [/lilac/, '#C8A2C8'],
          [/violet|purple/, '#7E57A2'],
          [/magenta/, '#C13A8D'],
          [/burgundy|wine/, '#722F37'],
          [/maroon/, '#800000'],
          [/coral/, '#F07F73'],
          [/peach/, '#F6B58D'],
          [/rose|pink/, '#F2A7C2'],
          [/red/, '#C53B38'],
          [/mustard/, '#D4A017'],
          [/orange/, '#E87822'],
          [/yellow/, '#F2CF3A'],
          [/sage/, '#A8B89A'],
          [/mint/, '#A8E6CF'],
          [/olive/, '#7C833A'],
          [/green/, '#3F7D4A'],
          [/wood|natural/, '#A67C52'],
          [/camel|tan/, '#C19A6B'],
          [/khaki/, '#BDB76B'],
          [/brown/, '#7A4E2D'],
          [/beige/, '#D8C3A5'],
          [/cream/, '#FFF3D6'],
          [/ivory/, '#FFF8E7'],
          [/silver/, '#C0C0C0'],
          [/gold/, '#D4AF37'],
          [/charcoal/, '#4A4A4A'],
          [/grey|gray/, '#9A9A9A'],
          [/white/, '#FFFFFF'],
          [/black/, '#161616']
        ];

        return colours.find(([pattern]) => pattern.test(key))?.[1] || '#D9D5CF';
      }

      observeCards() {
        const cards = [...this.querySelectorAll('[data-reveal]:not(.is-visible)')];
        if (!cards.length) return;

        cards.forEach((card, index) => {
          const staggerIndex = index % 8;
          card.style.setProperty('--tjs-reveal-delay', `${staggerIndex * 45}ms`);
        });

        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          cards.forEach(card => card.classList.add('is-visible'));
          return;
        }

        this.revealObserver?.disconnect();
        this.revealObserver = new IntersectionObserver((entries, observer) => {
          entries
            .filter(entry => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
            .forEach(entry => {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
        }, { rootMargin: '90px 0px', threshold: .06 });

        cards.forEach(card => this.revealObserver.observe(card));
      }

      handleClick(event) {
        const ajaxLink = event.target.closest('[data-ajax-link]');
        if (ajaxLink && !event.metaKey && !event.ctrlKey && !event.shiftKey && event.button === 0) {
          event.preventDefault();
          this.fetchSection(ajaxLink.href, {
            updateUrl: true,
            preserveScroll: ajaxLink.hasAttribute('data-preserve-scroll')
          });
          return;
        }

        const openFilters = event.target.closest('[data-open-filters]');
        if (openFilters) { this.openDrawer(openFilters); return; }
        if (event.target.closest('[data-close-filters]')) { this.closeDrawer(); return; }

        const clearFilters = event.target.closest('[data-clear-filters]');
        if (clearFilters) {
          const url = new URL(window.location.href);

          [...url.searchParams.keys()].forEach(key => {
            if (key.startsWith('filter.') || key === 'page') {
              url.searchParams.delete(key);
            }
          });

          if (this.dataset.forceInStock === 'true') {
            const param = this.dataset.availabilityParam;
            const value = this.dataset.availabilityValue;
            if (param && value) url.searchParams.set(param, value);
          }

          this.closeDrawer(false);
          this.fetchSection(url.toString(), {
            updateUrl: true,
            preserveScroll: true
          });
          return;
        }

        const loadMore = event.target.closest('[data-load-more]');
        if (loadMore) { this.loadMore(loadMore); return; }

        const moreVariants = event.target.closest('[data-card-option-more]');
        if (moreVariants) {
          this.toggleVariantValues(moreVariants);
          return;
        }

        const cardOption = event.target.closest('[data-card-option-value]');
        if (cardOption) {
          this.selectCardVariant(cardOption);
          return;
        }


      }

      handleChange(event) {
        if (!event.target.matches('[data-sort]')) return;
        const url = new URL(window.location.href);
        url.searchParams.set('sort_by', event.target.value);
        url.searchParams.delete('page');
        this.fetchSection(url.toString(), {
          updateUrl: true,
          preserveScroll: true
        });
      }

      handleSubmit(event) {
        const form = event.target.closest('[data-filter-form]');
        if (!form) return;
        event.preventDefault();
        const currentUrl = new URL(window.location.href);
        const originalQuery = currentUrl.searchParams.get('tjs_original_q');
        const url = new URL(window.location.href);
        url.search = new URLSearchParams(new FormData(form)).toString();
        if (originalQuery) url.searchParams.set('tjs_original_q', originalQuery);
        url.searchParams.delete('page');
        this.closeDrawer(false);
        this.fetchSection(url.toString(), {
          updateUrl: true,
          preserveScroll: true
        });
      }

      async fetchSection(url, { updateUrl = false, replaceUrl = false, preserveScroll = false } = {}) {
        this.requestController?.abort();
        this.requestController = new AbortController();
        const requestSequence = this.requestSequence = (this.requestSequence || 0) + 1;
        const scrollY = window.scrollY;
        const requestUrl = new URL(url, window.location.origin);
        requestUrl.searchParams.set('section_id', this.sectionId);
        this.setBusy(true);
        this.announce('Updating products');

        try {
          const response = await fetch(requestUrl.toString(), { signal: this.requestController.signal, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
          if (!response.ok) throw new Error('Unable to update products');
          const html = await response.text();
          if (requestSequence !== this.requestSequence || !this.isConnected) return;
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const nextRoot = doc.querySelector(`#TjsFinalSearch-${CSS.escape(this.sectionId)}`);
          if (!nextRoot) throw new Error('Updated search results were not found');

          if (updateUrl) {
            const cleanUrl = new URL(url, window.location.origin);
            cleanUrl.searchParams.delete('section_id');
            history[replaceUrl ? 'replaceState' : 'pushState']({ tjsSearch: true }, '', cleanUrl.toString());
          }

          this.replaceWith(nextRoot);
          requestAnimationFrame(() => {
            const currentRoot = document.getElementById(`TjsFinalSearch-${this.sectionId}`);
            if (currentRoot && currentRoot.dataset.ready !== 'true' && typeof currentRoot.connectedCallback === 'function') {
              currentRoot.connectedCallback();
            }
            if (preserveScroll) window.scrollTo({ top: scrollY, behavior: 'auto' });
          });
        } catch (error) {
          if (error.name === 'AbortError' || requestSequence !== this.requestSequence || !this.isConnected) return;
          this.setBusy(false);
          this.announce(error.message || 'Unable to update products');
        }
      }

      async loadMore(button) {
        const nextUrl = button.dataset.nextUrl;
        if (!nextUrl) return;
        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = 'Loading…';
        try {
          const requestUrl = new URL(nextUrl, window.location.origin);
          requestUrl.searchParams.set('section_id', this.sectionId);
          const response = await fetch(requestUrl.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
          if (!response.ok) throw new Error('Unable to load more');
          const html = await response.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const nextRoot = doc.querySelector(`#TjsFinalSearch-${CSS.escape(this.sectionId)}`);
          const appendedCards = [];
          nextRoot?.querySelectorAll('.tjs-product-card').forEach(card => {
            this.grid.appendChild(card);
            appendedCards.push(card);
          });
          this.initializeProductCards(this.grid);
          const nextButton = nextRoot?.querySelector('[data-load-more]');
          if (nextButton) {
            button.dataset.nextUrl = nextButton.dataset.nextUrl;
            button.disabled = false;
            button.textContent = originalText;
          } else {
            button.closest('.tjs-final-collection__load-wrap')?.remove();
          }
          this.observeCards();
        } catch (error) {
          button.disabled = false;
          button.textContent = originalText;
          this.showToast(error.message || 'Unable to load more');
        }
      }

      setBusy(isBusy) { this.grid?.setAttribute('aria-busy', isBusy ? 'true' : 'false'); }
      announce(message) { if (this.status) this.status.textContent = message; }

      setupFloatingType() {
        if (!this.floatingType || !this.floatingAnchor) return;
        this.measureFloatingType();
        window.addEventListener('scroll', this.boundScroll, { passive: true });
        window.addEventListener('resize', this.boundResize);
        this.syncFloatingType();

        const activeChip = this.floatingType.querySelector('.tjs-floating-type__chip.is-active');
        if (activeChip) {
          requestAnimationFrame(() => activeChip.scrollIntoView({ block: 'nearest', inline: 'center' }));
        }
      }

      handleResize() {
        this.measureFloatingType();
        this.syncFloatingType();
      }

      handleScroll() {
        if (this.scrollTicking) return;
        this.scrollTicking = true;
        requestAnimationFrame(() => {
          this.scrollTicking = false;
          this.syncFloatingType();
        });
      }

      measureFloatingType() {
        if (!this.floatingType) return;
        const height = this.floatingType.offsetHeight || 72;
        this.style.setProperty('--tjs-floating-space', `${height + 18}px`);
      }

      syncFloatingType() {
        if (!this.floatingType || !this.floatingAnchor) return;
        const anchorRect = this.floatingAnchor.getBoundingClientRect();
        const sectionRect = this.getBoundingClientRect();
        const floatingHeight = this.floatingType.offsetHeight || 72;
        const hasEnteredProducts = anchorRect.top < 0;
        const hasRoomBelow = sectionRect.bottom > window.innerHeight + floatingHeight + 44;
        const shouldShow = hasEnteredProducts && hasRoomBelow;

        this.floatingType.classList.toggle('is-visible', shouldShow);
        this.classList.toggle('has-floating-type', shouldShow);
      }

      openDrawer(trigger) {
        this.lastTrigger = trigger;
        this.drawer.hidden = false;
        this.previousOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = 'hidden';
      }

      closeDrawer(restoreFocus = true) {
        if (!this.drawer) return;
        this.drawer.hidden = true;
        document.documentElement.style.overflow = this.previousOverflow || '';
        if (restoreFocus) this.lastTrigger?.focus?.();
      }

      initializeProductCards(scope = this) {
        this.setupMediaTracks(scope);
        this.setupImageFallbacks(scope);
        scope.querySelectorAll?.('[data-card-option-group]').forEach(group => this.refreshVariantGroup(group));
      }

      setupImageFallbacks(scope = this) {
        scope.querySelectorAll?.('.tjs-product-card__image').forEach(image => {
          if (image.dataset.imageFallbackReady === 'true') return;
          image.dataset.imageFallbackReady = 'true';

          image.addEventListener('error', () => {
            const slide = image.closest('[data-card-media-slide]');
            const track = image.closest('[data-card-media-track]');
            const card = image.closest('[data-card-product]');

            if (slide?.classList.contains('tjs-product-card__image-slide--secondary')) {
              slide.remove();
              card?.querySelector('[data-card-media-dots]')?.remove();
              if (track) track.scrollLeft = 0;
            }
          }, { once: true });
        });
      }

      setupMediaTracks(scope = this) {
        scope.querySelectorAll?.('[data-card-media-track]').forEach(track => {
          if (track.dataset.mediaReady === 'true') return;
          track.dataset.mediaReady = 'true';

          const card = track.closest('[data-card-product]');
          const dots = [...(card?.querySelectorAll('[data-card-media-dot]') || [])];

          const setActiveDot = index => {
            dots.forEach((dot, dotIndex) => {
              dot.classList.toggle('is-active', dotIndex === index);
            });
          };

          const syncDots = () => {
            const slides = [...track.querySelectorAll('[data-card-media-slide]')];
            if (slides.length < 2) {
              setActiveDot(0);
              return;
            }

            const slideWidth = Math.max(track.getBoundingClientRect().width, 1);
            const index = Math.max(
              0,
              Math.min(slides.length - 1, Math.round(track.scrollLeft / slideWidth))
            );
            setActiveDot(index);
          };

          track.addEventListener('scroll', () => {
            if (track._tjsScrollFrame) cancelAnimationFrame(track._tjsScrollFrame);
            track._tjsScrollFrame = requestAnimationFrame(syncDots);
          }, { passive: true });

          // Prevent browsers from restoring a product card to slide two after
          // AJAX replacement, resize, or back/forward navigation.
          track.scrollLeft = 0;
          setActiveDot(0);

          requestAnimationFrame(() => {
            track.scrollLeft = 0;
            setActiveDot(0);
          });
        });
      }

      toggleVariantValues(button) {
        const group = button.closest('[data-card-option-group]');
        if (!group) return;
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        group.dataset.expanded = expanded ? 'false' : 'true';
        this.refreshVariantGroup(group);
      }

      refreshVariantGroup(group) {
        if (!group) return;

        const expanded = group.dataset.expanded === 'true';
        const buttons = [...group.querySelectorAll('[data-card-option-value]')];
        const availableButtons = buttons.filter(button => !button.disabled);
        const activeButton = availableButtons.find(button => button.classList.contains('is-active'));
        const visibleWhenCollapsed = new Set(availableButtons.slice(0, 4));
        if (activeButton) visibleWhenCollapsed.add(activeButton);

        buttons.forEach(button => {
          if (button.disabled) {
            button.hidden = true;
            return;
          }
          button.hidden = expanded ? false : !visibleWhenCollapsed.has(button);
        });

        const hiddenCount = availableButtons.filter(button => button.hidden).length;
        const moreButton = group.querySelector('[data-card-option-more]');
        if (!moreButton) return;

        const hasExpandableValues = availableButtons.length > visibleWhenCollapsed.size;
        if (expanded) {
          moreButton.hidden = availableButtons.length <= 4;
          moreButton.textContent = 'Show less';
        } else {
          moreButton.hidden = !hasExpandableValues;
          moreButton.textContent = `+${hiddenCount} more`;
        }
      }

      getCardVariants(card) {
        if (!card) return [];
        if (card._tjsVariants) return card._tjsVariants;
        const script = card.querySelector('[data-card-variants]');
        try {
          card._tjsVariants = JSON.parse(script?.textContent || '[]');
        } catch (error) {
          card._tjsVariants = [];
        }
        return card._tjsVariants;
      }

      getCardSelectedOptions(card) {
        try {
          return JSON.parse(card.dataset.selectedOptions || '[]');
        } catch (error) {
          return [];
        }
      }

      selectCardVariant(button) {
        const card = button.closest('[data-card-product]');
        if (!card || button.disabled) return;

        const variants = this.getCardVariants(card);
        if (!variants.length) return;

        const optionIndex = Number(button.dataset.optionIndex);
        const optionValue = button.dataset.optionValue;
        const selected = this.getCardSelectedOptions(card);
        selected[optionIndex] = optionValue;

        let selectedVariant = variants.find(variant =>
          variant.available && variant.options.every((value, index) => value === selected[index])
        );

        if (!selectedVariant) {
          const candidates = variants
            .filter(variant => variant.available && variant.options[optionIndex] === optionValue)
            .map(variant => ({
              variant,
              score: variant.options.reduce((total, value, index) => {
                if (index === optionIndex) return total;
                return total + (selected[index] === value ? 1 : 0);
              }, 0)
            }))
            .sort((a, b) => b.score - a.score);
          selectedVariant = candidates[0]?.variant || variants.find(variant => variant.available);
        }

        if (!selectedVariant) return;

        card.dataset.selectedOptions = JSON.stringify(selectedVariant.options);
        this.updateCardVariant(card, selectedVariant, variants);
      }

      updateCardVariant(card, variant, variants) {
        card.querySelectorAll('[data-card-option-value]').forEach(button => {
          const index = Number(button.dataset.optionIndex);
          const value = button.dataset.optionValue;
          const active = variant.options[index] === value;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');

          const available = variants.some(candidate => {
            if (!candidate.available || candidate.options[index] !== value) return false;
            return candidate.options.every((candidateValue, candidateIndex) => {
              if (candidateIndex === index) return true;
              return candidateValue === variant.options[candidateIndex];
            });
          });
          button.disabled = !available;
          button.hidden = !available;
        });

        card.querySelectorAll('[data-card-option-group]').forEach(group => this.refreshVariantGroup(group));

        const price = card.querySelector('[data-card-price]');
        const compare = card.querySelector('[data-card-compare]');
        if (price) price.textContent = this.formatMoney(variant.price);
        if (compare) {
          const showCompare = Number(variant.compare_at_price || 0) > Number(variant.price || 0);
          compare.hidden = !showCompare;
          compare.textContent = showCompare ? this.formatMoney(variant.compare_at_price) : '';
        }

        const image = card.querySelector('.tjs-product-card__image--primary');
        const variantImage = variant.featured_image?.src || variant.featured_image || null;
        if (image && variantImage) {
          this.transitionVariantImage(card, image, variantImage);
        }

        const mediaTrack = card.querySelector('[data-card-media-track]');
        if (mediaTrack && mediaTrack.scrollLeft > 0) {
          mediaTrack.scrollTo({ left: 0, behavior: 'smooth' });
        }
      }

      transitionVariantImage(card, image, nextSrc) {
        if (!card || !image || !nextSrc) return;

        const absoluteNextSrc = new URL(nextSrc, window.location.origin).href;
        const currentSrc = image.currentSrc || image.src || '';
        if (currentSrc === absoluteNextSrc || image.src === absoluteNextSrc) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const preloader = new Image();

        preloader.onload = () => {
          if (reduceMotion) {
            image.src = absoluteNextSrc;
            image.removeAttribute('srcset');
            return;
          }

          clearTimeout(card._tjsVariantExitTimer);
          clearTimeout(card._tjsVariantEnterTimer);

          card.classList.remove('is-variant-entering');
          card.classList.add('is-variant-exiting');

          card._tjsVariantExitTimer = setTimeout(() => {
            image.src = absoluteNextSrc;
            image.removeAttribute('srcset');

            card.classList.remove('is-variant-exiting');
            card.classList.add('is-variant-entering');

            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                card.classList.remove('is-variant-entering');
              });
            });
          }, 125);
        };

        preloader.src = absoluteNextSrc;
      }

      formatMoney(cents) {
        if (window.Shopify?.formatMoney) return window.Shopify.formatMoney(cents);
        return new Intl.NumberFormat('en-IN', {
          style: 'currency',
          currency: 'INR',
          maximumFractionDigits: 0
        }).format((Number(cents) || 0) / 100);
      }


      showToast(message) {
        showSectionToast(this, message);
      }
    }

    customElements.define('tjs-final-search', TjsFinalSearch);

    if (!window.__tjsFinalSearchPopstate) {
      window.__tjsFinalSearchPopstate = true;
      window.addEventListener('popstate', () => {
        const current = document.querySelector('tjs-final-search');
        current?.fetchSection(window.location.href);
      });
    }
  })();
</script>

