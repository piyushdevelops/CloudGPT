{% liquid
  assign heading_font = section.settings.heading_font
  assign heading_weight = section.settings.heading_weight
  assign heading_variant = heading_font | font_modify: 'weight', heading_weight
  assign numbers_font = section.settings.numbers_font
  assign numbers_weight = section.settings.numbers_weight
  assign numbers_variant = numbers_font | font_modify: 'weight', numbers_weight
  assign copy_font = section.settings.copy_font
  assign copy_weight = section.settings.copy_weight
  assign copy_variant = copy_font | font_modify: 'weight', copy_weight
%}
<style>
{{ heading_font | font_face: font_display: 'swap' }}{{ heading_variant | font_face: font_display: 'swap' }}
{{ numbers_font | font_face: font_display: 'swap' }}{{ numbers_variant | font_face: font_display: 'swap' }}
{{ copy_font | font_face: font_display: 'swap' }}{{ copy_variant | font_face: font_display: 'swap' }}
#JuneCountdown-{{ section.id }} {
 --count-bg:{{ section.settings.background }};--count-ink:{{ section.settings.ink }};--count-accent:{{ section.settings.accent }};
 {% if section.settings.master_palette %}--count-bg:var(--june-bg,{{ section.settings.background }});--count-ink:var(--june-ink,{{ section.settings.ink }});--count-accent:var(--june-accent,{{ section.settings.accent }});{% endif %}
 display:grid;align-content:center;gap:clamp(26px,5vw,70px);min-height:calc(100svh - 80px);max-width:1680px;margin:0 auto;padding:70px clamp(20px,5vw,90px);background:var(--count-bg);color:var(--count-ink);text-align:center;
 font-family:{{ copy_font.family }},{{ copy_font.fallback_families }};font-weight:{{ copy_weight }};font-size:{{ section.settings.copy_size }}px;letter-spacing:{{ section.settings.copy_tracking }}px;line-height:{{ section.settings.copy_leading }};
}
#JuneCountdown-{{ section.id }} * {box-sizing:border-box;}
#JuneCountdown-{{ section.id }} [hidden] {display:none!important;}
#JuneCountdown-{{ section.id }} h1 {margin:0;color:inherit;font-family:{{ heading_font.family }},{{ heading_font.fallback_families }};font-weight:{{ heading_weight }};font-size:clamp(30px,5vw,{{ section.settings.heading_size }}px);letter-spacing:{{ section.settings.heading_tracking }}px;line-height:{{ section.settings.heading_leading }};}
#JuneCountdown-{{ section.id }} p {margin:0;font:inherit;}
#JuneCountdown-{{ section.id }} .june-count__intro {margin-top:14px;}
#JuneCountdown-{{ section.id }} .june-count__grid {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;}
#JuneCountdown-{{ section.id }} .june-count__unit {display:grid;gap:16px;min-width:0;padding:12px 0 22px;border-bottom:2px solid var(--count-accent);}
#JuneCountdown-{{ section.id }} .june-count__number {font-family:{{ numbers_font.family }},{{ numbers_font.fallback_families }};font-weight:{{ numbers_weight }};font-size:clamp(42px,11.5vw,{{ section.settings.numbers_size }}px);font-variant-numeric:tabular-nums;letter-spacing:{{ section.settings.numbers_tracking }}px;line-height:{{ section.settings.numbers_leading }};}
#JuneCountdown-{{ section.id }} .june-count__label {font:inherit;text-transform:uppercase;}
#JuneCountdown-{{ section.id }} .june-count__date {display:inline-block;max-width:100%;padding:12px 24px;border-radius:999px;background:color-mix(in srgb,var(--count-accent) 20%,var(--count-bg));}
#JuneCountdown-{{ section.id }} .june-count__complete {font-size:clamp(28px,5vw,64px);font-weight:800;}
#JuneCountdown-{{ section.id }} .june-count__cta {display:inline-flex;align-items:center;gap:18px;padding:10px 12px 10px 24px;min-height:52px;background:var(--count-accent);color:var(--count-ink);border-radius:999px;text-decoration:none;font:inherit;}
#JuneCountdown-{{ section.id }} .june-count__cta span {display:grid;place-items:center;width:34px;height:34px;background:var(--june-dark,#171717);color:var(--june-on-dark,#fff);border-radius:50%;}
#JuneCountdown-{{ section.id }} .june-count__cta svg {width:18px;height:18px;}
#JuneCountdown-{{ section.id }} .june-count__status {position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);}
@media(max-width:749px){
 #JuneCountdown-{{ section.id }} {padding:56px 20px;gap:36px;font-size:{{ section.settings.copy_size_mobile }}px;}
 #JuneCountdown-{{ section.id }} h1 {font-size:{{ section.settings.heading_size_mobile }}px;}
 #JuneCountdown-{{ section.id }} .june-count__grid {grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 16px;}
 #JuneCountdown-{{ section.id }} .june-count__number {font-size:min(22vw,{{ section.settings.numbers_size_mobile }}px);}
 #JuneCountdown-{{ section.id }} .june-count__unit {gap:6px;padding-bottom:14px;}
}

/* Playful launch board — scoped to this section. */
#JuneCountdown-{{ section.id }} {position:relative;isolation:isolate;overflow:hidden;gap:32px;padding-top:52px;padding-bottom:52px;background-image:radial-gradient(color-mix(in srgb,var(--count-accent) 35%,transparent) 1px,transparent 1px);background-size:22px 22px;}
#JuneCountdown-{{ section.id }} .june-count__sticker {display:inline-block;margin-bottom:20px;padding:9px 19px;background:var(--count-accent);color:var(--count-ink);border:2px solid currentColor;box-shadow:4px 4px 0 var(--count-ink);transform:rotate(-4deg);font:inherit;}
#JuneCountdown-{{ section.id }} .june-count__grid {gap:22px;padding:14px 4px;}
#JuneCountdown-{{ section.id }} .june-count__unit {position:relative;background:var(--count-bg);border:2px solid var(--count-ink);border-radius:18px;box-shadow:6px 7px 0 color-mix(in srgb,var(--count-ink) 85%,transparent);padding:34px 8px 20px;gap:2px;transform:rotate(-2deg);}
#JuneCountdown-{{ section.id }} .june-count__unit:nth-child(even) {transform:rotate(2deg);background:color-mix(in srgb,var(--count-accent) 32%,var(--count-bg));}
#JuneCountdown-{{ section.id }} .june-count__unit:before,#JuneCountdown-{{ section.id }} .june-count__unit:after {content:"";position:absolute;top:-13px;width:12px;height:29px;background:var(--count-ink);border:3px solid var(--count-bg);border-radius:9px;left:22%;}
#JuneCountdown-{{ section.id }} .june-count__unit:after {left:auto;right:22%;}
#JuneCountdown-{{ section.id }} .june-count__number {display:block;}
#JuneCountdown-{{ section.id }} .june-count__label {border-top:1px dashed color-mix(in srgb,var(--count-ink) 30%,transparent);padding-top:12px;}
#JuneCountdown-{{ section.id }} .june-count__date {border:1px solid var(--count-ink);border-radius:6px;background:var(--count-bg);box-shadow:3px 3px 0 var(--count-accent);}
#JuneCountdown-{{ section.id }} .june-count__play {display:inline-flex;align-items:center;gap:10px;margin-top:22px;padding:12px 22px;min-height:48px;border:2px solid var(--count-ink);border-radius:999px;background:var(--count-ink);color:var(--count-bg);font:inherit;cursor:pointer;}
#JuneCountdown-{{ section.id }} .june-count__play:hover {background:var(--count-accent);color:var(--count-ink);}
#JuneCountdown-{{ section.id }} .june-count__play:focus-visible {outline:3px solid var(--count-accent);outline-offset:5px;}
#JuneCountdown-{{ section.id }} .june-count__spark {position:absolute;pointer-events:none;z-index:4;width:10px;height:18px;left:50%;top:64%;background:var(--count-accent);border:1px solid var(--count-ink);}
@media(max-width:749px){
 #JuneCountdown-{{ section.id }} {padding:40px 22px 48px;gap:25px;}
 #JuneCountdown-{{ section.id }} .june-count__grid {gap:25px 17px;}
 #JuneCountdown-{{ section.id }} .june-count__unit {padding:22px 4px 12px;border-radius:12px;box-shadow:4px 5px 0 var(--count-ink);}
 #JuneCountdown-{{ section.id }} .june-count__number {font-size:min(20vw,{{ section.settings.numbers_size_mobile }}px);}
}


#JuneCountdown-{{ section.id }} .june-count__unit.has-peek {isolation:isolate;cursor:pointer;perspective:1000px;}
#JuneCountdown-{{ section.id }} .june-count__peek {position:absolute;inset:8px;z-index:-1;transform:rotate(5deg) translate(4px,-12px);transition:transform .5s;overflow:hidden;border-radius:10px;background:var(--count-bg);border:1px solid var(--count-ink);}
#JuneCountdown-{{ section.id }} .june-count__peek img {width:100%;height:100%;object-fit:contain;display:block;}
#JuneCountdown-{{ section.id }} .june-count__face {position:absolute;inset:0;z-index:0;background:var(--count-bg);border-radius:15px;transition:transform .55s,opacity .35s;transform-origin:50% 0;pointer-events:none;}
#JuneCountdown-{{ section.id }} .has-peek:nth-child(even) .june-count__face {background:color-mix(in srgb,var(--count-accent) 32%,var(--count-bg));}
#JuneCountdown-{{ section.id }} .has-peek .june-count__number,#JuneCountdown-{{ section.id }} .has-peek .june-count__label {position:relative;z-index:1;pointer-events:none;transition:opacity .25s;}
#JuneCountdown-{{ section.id }} .june-count__reveal {position:absolute;inset:0;z-index:3;border:0;border-radius:16px;background:transparent;cursor:pointer;color:inherit;}
#JuneCountdown-{{ section.id }} .june-count__reveal:focus-visible {outline:4px solid var(--count-accent);outline-offset:7px;}
#JuneCountdown-{{ section.id }} .june-count__hint {position:absolute;bottom:5px;right:12px;font:inherit;font-size:.65em;}
#JuneCountdown-{{ section.id }} .has-peek.is-revealed .june-count__face {transform:rotateX(85deg);opacity:0;}
#JuneCountdown-{{ section.id }} .has-peek.is-revealed .june-count__number,#JuneCountdown-{{ section.id }} .has-peek.is-revealed .june-count__label {opacity:0;}
#JuneCountdown-{{ section.id }} .has-peek.is-revealed .june-count__peek {transform:none;z-index:2;}
@media(hover:hover){#JuneCountdown-{{ section.id }} .has-peek:not(.is-revealed):hover .june-count__peek {transform:rotate(8deg) translate(9px,-22px);}}
@media(prefers-reduced-motion:reduce){#JuneCountdown-{{ section.id }} .june-count__peek,#JuneCountdown-{{ section.id }} .june-count__face,#JuneCountdown-{{ section.id }} .june-count__number,#JuneCountdown-{{ section.id }} .june-count__label {transition:none;}}

</style>
<june-launch-countdown id="JuneCountdown-{{ section.id }}" data-launch="{{ section.settings.launch_at | escape }}" data-motion="{{ section.settings.fun_motion }}" data-peek-duration="{{ section.settings.peek_duration }}">
 <header><div class="june-count__sticker">{{ section.settings.sticker | escape }}</div><h1>{{ section.settings.title | escape }}</h1><p class="june-count__intro" data-intro>{{ section.settings.intro | escape }}</p></header>
 <div class="june-count__grid" data-grid role="timer" aria-label="Time until preorders start" aria-live="off">
  <div class="june-count__unit{% if section.settings.enable_peeks %} has-peek{% endif %}">{% if section.settings.enable_peeks %}<div class="june-count__peek" aria-hidden="true">{% if section.settings.peek_cover_1 != blank %}{{ section.settings.peek_cover_1 | image_url: width: 800 | image_tag: loading: 'lazy', alt: '' }}{% else %}<img src="{{ 'june-preorder-peek-1.jpg' | asset_url }}" width="793" height="1000" alt="" loading="lazy">{% endif %}</div><span class="june-count__face" aria-hidden="true"></span><button type="button" class="june-count__reveal" data-peek aria-expanded="false" aria-label="Reveal a secret planner cover"><span class="june-count__hint" aria-hidden="true">Psst… tap me</span></button>{% endif %}<span class="june-count__number" data-unit="days">—</span><span class="june-count__label">Days</span></div>
  <div class="june-count__unit"><span class="june-count__number" data-unit="hours">—</span><span class="june-count__label">Hours</span></div>
  <div class="june-count__unit"><span class="june-count__number" data-unit="minutes">—</span><span class="june-count__label">Minutes</span></div>
  <div class="june-count__unit{% if section.settings.enable_peeks %} has-peek{% endif %}">{% if section.settings.enable_peeks %}<div class="june-count__peek" aria-hidden="true">{% if section.settings.peek_cover_2 != blank %}{{ section.settings.peek_cover_2 | image_url: width: 800 | image_tag: loading: 'lazy', alt: '' }}{% else %}<img src="{{ 'june-preorder-peek-2.jpg' | asset_url }}" width="793" height="1000" alt="" loading="lazy">{% endif %}</div><span class="june-count__face" aria-hidden="true"></span><button type="button" class="june-count__reveal" data-peek aria-expanded="false" aria-label="Reveal a secret planner cover"><span class="june-count__hint" aria-hidden="true">Psst… tap me</span></button>{% endif %}<span class="june-count__number" data-unit="seconds">—</span><span class="june-count__label">Seconds</span></div>
 </div>
 <div><time class="june-count__date" data-date datetime="{{ section.settings.launch_at | escape }}">{{ section.settings.launch_at | escape }}</time>{% if section.settings.show_confetti %}<div><button type="button" class="june-count__play" data-celebrate hidden><span aria-hidden="true">✳</span>{{ section.settings.confetti_label | escape }}</button></div>{% endif %}</div>
 <div data-complete hidden><p class="june-count__complete">{{ section.settings.complete | escape }}</p>{% if section.settings.launch_link != blank %}<a class="june-count__cta" href="{{ section.settings.launch_link }}">{{ section.settings.cta | escape }}<span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8"/></svg></span></a>{% endif %}</div>
 <span class="june-count__status" role="status" data-status></span>
</june-launch-countdown>
<script src="{{ 'june-2027-countdown.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "June · 2027 countdown",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page heading",
      "default": "2027 Dated Planner"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Countdown heading",
      "default": "Preorders start in"
    },
    {
      "type": "text",
      "id": "launch_at",
      "label": "Launch date and time",
      "default": "2026-10-26T17:00:00+05:30",
      "info": "ISO date with timezone. +05:30 is India time. Example: 2026-10-26T17:00:00+05:30"
    },
    {
      "type": "text",
      "id": "complete",
      "label": "Message when countdown ends",
      "default": "The preorder launch time has arrived."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Optional launch button label",
      "default": "Explore the 2027 planner"
    },
    {
      "type": "url",
      "id": "launch_link",
      "label": "Button destination after countdown"
    },
    {
      "type": "checkbox",
      "id": "master_palette",
      "label": "Use June master palette",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background fallback",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Text fallback",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent fallback",
      "default": "#F56A28"
    },
    {
      "type": "header",
      "content": "Playful details"
    },
    {
      "type": "text",
      "id": "sticker",
      "label": "Launch sticker",
      "default": "Good things take a little planning."
    },
    {
      "type": "checkbox",
      "id": "fun_motion",
      "label": "Animate changing numbers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_confetti",
      "label": "Show confetti button",
      "default": true
    },
    {
      "type": "text",
      "id": "confetti_label",
      "label": "Confetti button label",
      "default": "A little party while we wait"
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font family",
      "default": "poppins_n9"
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Font weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 900
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop size",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 54,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile size",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_tracking",
      "label": "Letter spacing",
      "min": -2,
      "max": 4,
      "step": 0.1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_leading",
      "label": "Line spacing",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.4
    },
    {
      "type": "header",
      "content": "Countdown typography"
    },
    {
      "type": "font_picker",
      "id": "numbers_font",
      "label": "Font family",
      "default": "poppins_n9"
    },
    {
      "type": "range",
      "id": "numbers_weight",
      "label": "Font weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 900
    },
    {
      "type": "range",
      "id": "numbers_size",
      "label": "Desktop size",
      "min": 20,
      "max": 240,
      "step": 4,
      "default": 180,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "numbers_size_mobile",
      "label": "Mobile size",
      "min": 20,
      "max": 240,
      "step": 4,
      "default": 92,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "numbers_tracking",
      "label": "Letter spacing",
      "min": -2,
      "max": 4,
      "step": 0.1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "numbers_leading",
      "label": "Line spacing",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.4
    },
    {
      "type": "header",
      "content": "Labels and supporting text"
    },
    {
      "type": "font_picker",
      "id": "copy_font",
      "label": "Font family",
      "default": "poppins_n5"
    },
    {
