      "id": "copy_weight",
      "label": "Font weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 500
    },
    {
      "type": "range",
      "id": "copy_size",
      "label": "Desktop size",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "copy_size_mobile",
      "label": "Mobile size",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "copy_tracking",
      "label": "Letter spacing",
      "min": -2,
      "max": 4,
      "step": 0.1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "copy_leading",
      "label": "Line spacing",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.4
    },
    {
      "type": "header",
      "content": "Hidden cover sneak peeks"
    },
    {
      "type": "checkbox",
      "id": "enable_peeks",
      "label": "Enable hidden covers",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "peek_cover_1",
      "label": "Cover behind days",
      "info": "Defaults to Create Your Magic from the supplied PDF."
    },
    {
      "type": "image_picker",
      "id": "peek_cover_2",
      "label": "Cover behind seconds",
