{% assign type_block = section.blocks | where: 'type', 'typography' | first %}
{% assign feature_font = type_block.settings.font %}
{% assign feature_weight = type_block.settings.heading_weight | append: '' %}
{% assign feature_heading_font = feature_font | font_modify: 'weight', feature_weight %}
{% if feature_heading_font.family == blank %}{% assign feature_heading_font = feature_font %}{% endif %}
{% style %}
  {{ feature_font | font_face: font_display: 'swap' }}
  {{ feature_heading_font | font_face: font_display: 'swap' }}
  #MemoryFeature-{{ section.id }}{--mf-bg:var(--june-surface,{{ section.settings.background }});--mf-ink:var(--june-ink,{{ section.settings.ink }});--mf-accent:var(--june-accent,{{ section.settings.accent }});--mf-font:{{ feature_font.family }},{{ feature_font.fallback_families }};--mf-heading:{{ type_block.settings.heading_size }}px;--mf-heading-mobile:{{ type_block.settings.heading_mobile }}px;--mf-body:{{ type_block.settings.body_size }}px;--mf-body-mobile:{{ type_block.settings.body_mobile }}px;--mf-button:{{ type_block.settings.button_size }}px;--mf-button-mobile:{{ type_block.settings.button_mobile }}px}
{% endstyle %}
<section id="MemoryFeature-{{ section.id }}" class="jmf jmf--{{ section.settings.art_style }}" aria-labelledby="MemoryFeatureTitle-{{ section.id }}">
  <div class="jmf__inner">
    <div class="jmf__copy">
      <p class="jmf__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="MemoryFeatureTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="jmf__body">{{ section.settings.body }}</div>
      <p class="jmf__price">{{ section.settings.price | escape }}</p>
      <a class="jmf__button" href="{{ section.settings.link }}"><span>{{ section.settings.button_label | escape }}</span><span class="jmf__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
      {% if section.settings.secondary_label != blank %}<a class="jmf__secondary" href="{{ section.settings.secondary_link | default: section.settings.link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
    </div>
    <div class="jmf__scene" aria-label="{{ section.settings.art_alt | escape }}">
      {% if section.settings.art_style == 'our_days' %}
        {% if section.settings.our_days_photo != blank %}{% assign memory_photo = section.settings.our_days_photo | image_url: width: 1400 %}{% else %}{% assign memory_photo = 'june-our-days-family-v2.webp' | asset_url %}{% endif %}
        <div class="jmf__keepsake" aria-hidden="true">
          <span class="jmf__keepsake-kicker">VOLUME 01</span><strong>Little days.<br>One big story.</strong>
          <img src="{{ memory_photo }}" alt="" width="720" height="540" loading="lazy">
        </div>
        <div class="jmf__phone">
          <div class="jmf__phone-top"><b>Our Days</b><span aria-hidden="true">•••</span></div>
          <p class="jmf__prompt">What made everyone laugh today?</p>
          <figure class="jmf__memory-photo"><img src="{{ memory_photo }}" alt="" width="720" height="540" loading="lazy"></figure>
          <p class="jmf__reply">{{ section.settings.sample_text | escape }}</p>
          <small><i aria-hidden="true">✓</i> Saved to your book</small>
        </div>
        <span class="jmf__sticker">one day<br>at a time</span>
      {% else %}
        {% if section.settings.photo_book_photo != blank %}{% assign photo_books_scene = section.settings.photo_book_photo | image_url: width: 2000 %}{% else %}{% assign photo_books_scene = 'june-photo-books-home-realistic-v3.webp' | asset_url %}{% endif %}
        <img class="jmf__photo-books-visual" src="{{ photo_books_scene }}" alt="{{ section.settings.art_alt | escape }}" width="1536" height="1024" loading="lazy">
      {% endif %}
    </div>
  </div>
</section>
{% stylesheet %}
.jmf{max-width:1680px;margin-inline:auto;background:var(--mf-bg);color:var(--mf-ink);font-family:var(--mf-font),Arial,sans-serif;overflow:hidden;border-top:1px solid var(--june-border,#dadada);border-bottom:1px solid var(--june-border,#dadada)}.jmf *{box-sizing:border-box}.jmf__inner{display:grid;grid-template-columns:minmax(0,.88fr) minmax(430px,1.12fr);min-height:620px}.jmf__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(48px,7vw,110px)}.jmf__eyebrow{margin:0 0 18px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.jmf h2{max-width:720px;margin:0;font-size:var(--mf-heading);font-weight:900;letter-spacing:-.055em;line-height:.94}.jmf__body{max-width:600px;margin-top:24px;font-size:var(--mf-body);font-weight:400;letter-spacing:-.01em;line-height:1.5}.jmf__body p{margin:0}.jmf__price{margin:24px 0 18px;font-size:18px;font-weight:800}.jmf__button{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;align-self:flex-start;min-width:260px;min-height:58px;padding:7px 8px 7px 24px;border:2px solid var(--mf-ink);border-radius:999px;background:var(--mf-accent);color:var(--mf-ink);font-size:var(--mf-button);font-weight:700;text-decoration:none;box-shadow:0 5px 0 var(--mf-ink);transition:transform .18s,box-shadow .18s}.jmf__button:hover{transform:translateY(-2px);box-shadow:0 7px 0 var(--mf-ink)}.jmf__arrow{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--june-dark,#171717);color:var(--june-on-dark,#fff)}.jmf__arrow svg{width:21px;height:21px}.jmf__secondary{align-self:flex-start;margin-top:22px;color:inherit;font-size:14px;font-weight:600;text-underline-offset:5px}.jmf__scene{position:relative;min-height:620px;background:color-mix(in srgb,var(--mf-accent) 32%,var(--mf-bg));isolation:isolate;overflow:hidden}.jmf--our_days .jmf__scene{background:radial-gradient(circle at 18% 18%,#fff 0 3px,transparent 4px) 0 0/34px 34px,color-mix(in srgb,#bfe3ed 70%,var(--mf-bg))}.jmf__keepsake{position:absolute;right:-2%;bottom:4%;width:54%;height:63%;padding:27px 28px 25px;border:3px solid var(--mf-ink);border-radius:4px;background:#ef7464;box-shadow:16px 16px 0 var(--mf-ink);transform:rotate(6deg);display:flex;flex-direction:column;color:var(--mf-ink)}.jmf__keepsake-kicker{font-size:11px;font-weight:800;letter-spacing:.16em}.jmf__keepsake strong{margin:14px 0 18px;font-size:clamp(27px,3vw,42px);line-height:.92;letter-spacing:-.05em}.jmf__keepsake img{width:100%;height:44%;margin-top:auto;object-fit:cover;border:2px solid var(--mf-ink);filter:saturate(.92) contrast(1.03)}.jmf__phone{position:absolute;z-index:3;left:7%;top:9%;width:52%;height:78%;min-height:480px;padding:25px 24px 20px;border:3px solid var(--mf-ink);border-radius:38px;background:#e9f5e6;box-shadow:14px 18px 0 var(--mf-ink);transform:rotate(-4deg);display:flex;flex-direction:column;gap:14px}.jmf__phone-top{display:flex;align-items:center;justify-content:space-between}.jmf__phone-top b{font-size:24px}.jmf__phone-top span{font-size:17px;font-weight:900;letter-spacing:2px}.jmf__phone p{margin:0;font-style:normal;line-height:1.28}.jmf__prompt{padding:14px 16px;border-radius:17px;background:#fff;font-size:16px}.jmf__memory-photo{margin:0;min-height:145px;flex:1;overflow:hidden;border-radius:20px;border:2px solid #fff}.jmf__memory-photo img{display:block;width:100%;height:100%;object-fit:cover}.jmf__reply{align-self:flex-end;max-width:88%;padding:13px 16px;border-radius:17px;background:#caf0bd;font-size:15px}.jmf__phone small{display:flex;align-items:center;justify-content:center;gap:8px;font-weight:750}.jmf__phone small i{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--mf-ink);color:#fff;font-style:normal}.jmf__sticker{position:absolute;z-index:5;right:6%;top:7%;display:grid;place-items:center;width:120px;height:120px;border:3px solid var(--mf-ink);border-radius:50%;background:#ffd255;box-shadow:6px 7px 0 #1717172b;text-align:center;font-weight:900;line-height:1.04;transform:rotate(8deg)}.jmf--photo_books .jmf__scene{background:linear-gradient(135deg,#f4b6c8 0 44%,#a8d8ea 44%)}.jmf__album{position:absolute;left:6%;top:8%;width:58%;height:73%;padding:34px;border:3px solid var(--mf-ink);background:#164d3b;box-shadow:16px 16px 0 var(--mf-ink);transform:rotate(-7deg);color:#f3d7a6;display:flex;flex-direction:column;justify-content:space-between}.jmf__album>span,.jmf__album>small{font-size:11px;font-weight:800;letter-spacing:.16em}.jmf__album strong{font-family:Georgia,serif;font-size:clamp(44px,5.3vw,76px);font-weight:400;line-height:.83;letter-spacing:-.07em}.jmf__spread{position:absolute;z-index:3;right:3%;bottom:7%;width:80%;height:66%;display:grid;grid-template-columns:.82fr 1.18fr;border:3px solid var(--mf-ink);border-radius:3px 11px 11px 3px;background:#fffdf6;box-shadow:14px 15px 0 #17171755;transform:rotate(3deg);overflow:hidden}.jmf__spread>div,.jmf__spread>figure{padding:28px}.jmf__story-page{position:relative;display:flex;flex-direction:column}.jmf__story-page small{display:block;font-size:10px;font-weight:800;letter-spacing:.15em}.jmf__story-page strong{display:block;margin-top:28px;font-family:Georgia,serif;font-size:clamp(29px,3vw,42px);font-weight:400;line-height:.94;letter-spacing:-.04em}.jmf__story-page p{font-size:14px;line-height:1.45}.jmf__story-page>span,.jmf__photo>span{position:absolute;bottom:12px;font-size:9px;font-weight:700}.jmf__story-page>span{left:27px}.jmf__photo{position:relative;display:flex;flex-direction:column;margin:0;background:#f0e9df}.jmf__photo img{width:100%;min-height:0;flex:1;object-fit:cover;border-radius:2px;filter:saturate(.94) contrast(1.03)}.jmf__photo figcaption{padding:11px 0 4px;font-size:12px;font-weight:750;line-height:1.25}.jmf__photo>span{right:27px}.jmf__gutter{position:absolute;z-index:2;left:40.8%;top:0;width:12px;height:100%;background:linear-gradient(90deg,#00000008,#00000023 48%,#fff8 52%,transparent);transform:translateX(-50%)}.jmf__tape{position:absolute;z-index:4;width:120px;height:34px;background:#fff1b8c7;box-shadow:0 2px 4px #0001}.jmf__tape--one{right:4%;top:11%;transform:rotate(16deg)}.jmf__tape--two{left:14%;bottom:6%;transform:rotate(-15deg)}@media(max-width:899px){.jmf__inner{grid-template-columns:1fr;min-height:0}.jmf__copy{padding:46px 22px 34px}.jmf h2{font-size:var(--mf-heading-mobile)}.jmf__body{font-size:var(--mf-body-mobile);margin-top:18px}.jmf__button{width:100%;font-size:var(--mf-button-mobile)}.jmf__scene{min-height:520px}.jmf__keepsake{right:-10%;bottom:4%;width:58%;height:59%;padding:18px}.jmf__keepsake strong{font-size:27px}.jmf__keepsake img{height:40%}.jmf__phone{left:5%;top:8%;width:64%;height:80%;min-height:0;padding:18px 17px 15px;border-radius:28px;gap:10px}.jmf__phone-top b{font-size:20px}.jmf__prompt{padding:11px 13px;font-size:13px}.jmf__memory-photo{min-height:125px;border-radius:15px}.jmf__reply{padding:10px 12px;font-size:12px}.jmf__phone small{font-size:10px}.jmf__phone small i{width:19px;height:19px}.jmf__sticker{right:4%;top:5%;width:88px;height:88px;font-size:12px}.jmf__album{left:3%;top:8%;width:66%;height:68%;padding:24px}.jmf__album strong{font-size:43px}.jmf__spread{right:-3%;bottom:8%;width:89%;height:62%;grid-template-columns:.78fr 1.22fr}.jmf__spread>div,.jmf__spread>figure{padding:17px}.jmf__story-page strong{margin-top:20px;font-size:25px}.jmf__story-page p{font-size:11px;line-height:1.35}.jmf__photo figcaption{font-size:10px}.jmf__gutter{left:39%}.jmf__tape{width:88px;height:26px}}@media(prefers-reduced-motion:reduce){.jmf__button{transition:none}}
.jmf--photo_books .jmf__scene{background:#eee8de}.jmf__photo-books-visual{display:block;width:100%;height:100%;min-height:620px;object-fit:cover;object-position:center}
@media(max-width:899px){.jmf--photo_books .jmf__scene{min-height:0}.jmf__photo-books-visual{height:auto;min-height:0;aspect-ratio:3/2}}
{% endstylesheet %}
