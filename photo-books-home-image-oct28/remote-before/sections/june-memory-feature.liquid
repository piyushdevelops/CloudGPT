{"name":"June · Memory feature","tag":"section","max_blocks":1,"settings":[{"type":"checkbox","id":"use_master_palette","label":"Use master palette","default":true},{"type":"select","id":"art_style","label":"Artwork style","options":[{"value":"our_days","label":"Our Days"},{"value":"photo_books","label":"Photo albums"}],"default":"our_days"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ONE DAY AT A TIME"},{"type":"text","id":"heading","label":"Heading","default":"The little moments make the whole story."},{"type":"richtext","id":"body","label":"Supporting copy","default":"<p>Thoughtful prompts help you collect the words and photographs that turn everyday life into a book.</p>"},{"type":"text","id":"price","label":"Price line","default":"From ₹2,999 · Printed book included"},{"type":"url","id":"link","label":"Primary link"},{"type":"text","id":"button_label","label":"Primary button","default":"Discover Our Days"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"secondary_label","label":"Secondary action","default":"See how it works"},{"type":"text","id":"sample_heading","label":"Sample page heading","default":"The bubble afternoon"},{"type":"text","id":"sample_text","label":"Sample memory","default":"She discovered bubbles—and tried to catch every single one."},{"type":"text","id":"art_alt","label":"Artwork description","default":"A memory becoming a printed book"},{"type":"image_picker","id":"our_days_photo","label":"Our Days memory photo"},{"type":"image_picker","id":"photo_book_photo","label":"Photo books section image"},{"type":"color","id":"background","label":"Background","default":"#F5F5F3"},{"type":"color","id":"ink","label":"Text","default":"#171717"},{"type":"color","id":"accent","label":"Accent","default":"#F56A28"}],"blocks":[{"type":"typography","name":"Typography controls","limit":1,"settings":[{"type":"font_picker","id":"font","label":"Font family","default":"poppins_n4"},{"type":"range","id":"heading_weight","label":"Heading thickness","min":100,"max":900,"step":100,"default":900},{"type":"range","id":"heading_size","label":"Heading desktop size","min":32,"max":100,"step":1,"unit":"px","default":68},{"type":"range","id":"heading_mobile","label":"Heading mobile size","min":28,"max":70,"step":1,"unit":"px","default":44},{"type":"range","id":"body_size","label":"Body desktop size","min":12,"max":28,"step":1,"unit":"px","default":18},{"type":"range","id":"body_mobile","label":"Body mobile size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"button_size","label":"Button desktop size","min":11,"max":22,"step":1,"unit":"px","default":15},{"type":"range","id":"button_mobile","label":"Button mobile size","min":11,"max":20,"step":1,"unit":"px","default":14}]}],"presets":[{"name":"June · Memory feature","blocks":[{"type":"typography"}]}]}
{% endschema %}

