{% liquid
  assign artwork_sizes = '(min-width: 750px) 60vw, 100vw'
  if section.settings.desktop_scene
    assign artwork_sizes = '(min-width: 1051px) 100vw, (min-width: 750px) 60vw, 100vw'
  endif
  assign emphasis = section.settings.subheading_emphasis | escape
  capture emphasis_markup
    echo '<strong>'
    echo emphasis
    echo '</strong>'
  endcapture
  assign subtitle_copy = section.settings.subheading | escape | newline_to_br
  if emphasis != blank
    assign subtitle_copy = subtitle_copy | replace: emphasis, emphasis_markup
  endif
  assign hero_id = 'JuneHero-' | append: section.id
  assign primary_url = section.settings.undated_collection.url | default: routes.all_products_collection_url
  assign limited_url = section.settings.limited_collection.url | default: primary_url
  assign life_url = section.settings.life_collection.url | default: primary_url
  assign mystery_url = section.settings.mystery_product.url | default: section.settings.mystery_link
  assign left_image = section.settings.cover_left | default: section.settings.left_product.featured_image
  assign right_image = section.settings.cover_right | default: section.settings.right_product.featured_image
  assign image_index = section.settings.interior_number | minus: 1
  assign spread_image = section.settings.inside_image | default: section.settings.left_product.images[image_index]
  assign edition_image = section.settings.limited_image | default: section.settings.edition_product.featured_image
  assign typography_block = section.blocks | where: 'type', 'typography' | first
  assign typography = typography_block.settings
  assign title_font = section.settings.title_font
  assign heading_weight = typography.heading_weight | append: ''
  assign title_variant = title_font | font_modify: 'weight', heading_weight
  if title_variant.family != blank
    assign title_font = title_variant
  endif
%}
{% style %}
  {{ title_font | font_face: font_display: 'swap' }}
  #{{ hero_id }} {
    --jh-bg: {{ section.settings.background }};
    --jh-ink: {{ section.settings.text_color }};
    --jh-height: {{ section.settings.desktop_height }}px;
    --jh-mobile-art: {{ section.settings.mobile_art_height }}px;
    --jh-title-size: {{ section.settings.heading_size }}px;
    --jh-title-mobile: {{ section.settings.heading_size_mobile }}px;
    --jh-font: {{ title_font.family }}, {{ title_font.fallback_families }};
    --jh-weight: {{ title_font.weight }};
    --jh-accent: {{ typography.button_accent | default: '#d5ff46' }};
  }

{% if typography_block != blank %}
{% if typography.custom_text_font %}
{{ typography.text_font | font_face: font_display: 'swap' }}
{% assign emphasis_font = typography.text_font | font_modify: 'weight', '700' %}{{ emphasis_font | font_face: font_display: 'swap' }}
{% assign role_weight = typography.subtitle_weight | append: '' %}{% assign role_font = typography.text_font | font_modify: 'weight', role_weight %}{{ role_font | font_face: font_display: 'swap' }}
{% assign role_weight = typography.body_weight | append: '' %}{% assign role_font = typography.text_font | font_modify: 'weight', role_weight %}{{ role_font | font_face: font_display: 'swap' }}
{% assign role_weight = typography.eyebrow_weight | append: '' %}{% assign role_font = typography.text_font | font_modify: 'weight', role_weight %}{{ role_font | font_face: font_display: 'swap' }}
{% assign role_weight = typography.button_weight | append: '' %}{% assign role_font = typography.text_font | font_modify: 'weight', role_weight %}{{ role_font | font_face: font_display: 'swap' }}
{% assign role_weight = typography.nav_weight | append: '' %}{% assign role_font = typography.text_font | font_modify: 'weight', role_weight %}{{ role_font | font_face: font_display: 'swap' }}
{% endif %}
#{{ hero_id }} .jh__title, #{{ hero_id }} .jh__alternate-title, #{{ hero_id }} .jh__year { font-weight: {{ typography.heading_weight }}; letter-spacing: {{ typography.heading_tracking | divided_by: 100.0 }}em; line-height: {{ typography.heading_leading | divided_by: 100.0 }}; }
#{{ hero_id }} .jh__subtitle { font-weight: {{ typography.subtitle_weight }}; letter-spacing: {{ typography.subtitle_tracking | divided_by: 100.0 }}em; line-height: {{ typography.subtitle_leading | divided_by: 100.0 }}; }
#{{ hero_id }} .jh__subtitle { font-size: {{ typography.subtitle_size }}px; }
@media(max-width:749px) { #{{ hero_id }} .jh__subtitle { font-size: {{ typography.subtitle_size_mobile }}px; } }
#{{ hero_id }} .jh__body, #{{ hero_id }} .jh__form, #{{ hero_id }} .jh__life-list { font-weight: {{ typography.body_weight }}; letter-spacing: {{ typography.body_tracking | divided_by: 100.0 }}em; line-height: {{ typography.body_leading | divided_by: 100.0 }}; }
#{{ hero_id }} .jh__body, #{{ hero_id }} .jh__form, #{{ hero_id }} .jh__life-list { font-size: {{ typography.body_size }}px; }
@media(max-width:749px) { #{{ hero_id }} .jh__body, #{{ hero_id }} .jh__form, #{{ hero_id }} .jh__life-list { font-size: {{ typography.body_size_mobile }}px; } }
#{{ hero_id }} .jh__eyebrow { font-weight: {{ typography.eyebrow_weight }}; letter-spacing: {{ typography.eyebrow_tracking | divided_by: 100.0 }}em; line-height: {{ typography.eyebrow_leading | divided_by: 100.0 }}; }
#{{ hero_id }} .jh__eyebrow { font-size: {{ typography.eyebrow_size }}px; }
@media(max-width:749px) { #{{ hero_id }} .jh__eyebrow { font-size: {{ typography.eyebrow_size_mobile }}px; } }
#{{ hero_id }} .jh__button, #{{ hero_id }} .jh__text-link { font-weight: {{ typography.button_weight }}; letter-spacing: {{ typography.button_tracking | divided_by: 100.0 }}em; line-height: {{ typography.button_leading | divided_by: 100.0 }}; }
#{{ hero_id }} .jh__button, #{{ hero_id }} .jh__text-link { font-size: {{ typography.button_size }}px; }
@media(max-width:749px) { #{{ hero_id }} .jh__button, #{{ hero_id }} .jh__text-link { font-size: {{ typography.button_size_mobile }}px; } }
#{{ hero_id }} .jh__tab, #{{ hero_id }} .jh__mystery { font-weight: {{ typography.nav_weight }}; letter-spacing: {{ typography.nav_tracking | divided_by: 100.0 }}em; line-height: {{ typography.nav_leading | divided_by: 100.0 }}; }
#{{ hero_id }} .jh__tab, #{{ hero_id }} .jh__mystery { font-size: {{ typography.nav_size }}px; }
@media(max-width:749px) { #{{ hero_id }} .jh__tab, #{{ hero_id }} .jh__mystery { font-size: {{ typography.nav_size_mobile }}px; } }
#{{ hero_id }} { {% if typography.custom_text_font %}font-family: {{ typography.text_font.family }}, {{ typography.text_font.fallback_families }};{% endif %} }
#{{ hero_id }} .jh__title { font-size: clamp(32px, {{ section.settings.heading_size | divided_by: 14.4 }}vw, {{ section.settings.heading_size }}px); }
#{{ hero_id }} .jh__alternate-title { font-size: {{ section.settings.heading_size | times: 0.65 }}px; }
@media(max-width:749px) { #{{ hero_id }} .jh__title { font-size: clamp(28px, {{ section.settings.heading_size_mobile | divided_by: 3.9 }}vw, {{ section.settings.heading_size_mobile }}px); line-height: {{ typography.heading_leading | divided_by: 100.0 }}; } #{{ hero_id }} .jh__alternate-title { font-size: {{ section.settings.heading_size_mobile | times: 0.7 }}px; } }
@media(min-width:750px) and (max-width:1050px) { #{{ hero_id }} .jh__subtitle { font-size: {{ typography.subtitle_size | times: 2.0 | divided_by: 3.0 }}px; } }
{% endif %}
{% endstyle %}
<june-make-room id="{{ hero_id }}" class="jh" data-text-motion="{{ typography.motion_enabled | default: true, allow_false: true }}" data-motion-speed="{{ typography.motion_speed | default: 100 }}" data-motion-plays="{{ typography.motion_plays | default: 1 }}" data-motion-loop="{{ typography.motion_loop | default: false }}" data-motion-gap="{{ typography.motion_gap | default: 4 }}" aria-label="{{ 'june_hero.labels.region' | t | escape }}">
  <div class="jh__stage" {{ typography_block.shopify_attributes }}>
    <div id="{{ hero_id }}-undated" class="jh__panel{% if section.settings.hero_image != blank %} jh__panel--artwork{% if section.settings.desktop_scene %} jh__panel--scene{% endif %}{% endif %}" data-panel="undated">
      <div class="jh__copy">
        <p class="jh__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1 class="jh__title"><span class="jh__title-ink">{{ section.settings.heading | escape }}</span></h1>
        <p class="jh__subtitle">{{ subtitle_copy }}</p>
        <p class="jh__body">{{ section.settings.body | escape }}</p>
      </div>
      <div class="jh__art" aria-label="{{ 'june_hero.labels.planner_images' | t | escape }}">
        {% if section.settings.hero_image != blank %}
          <picture class="jh__full-art">
            {% if section.settings.hero_image_mobile != blank %}
              <source media="(max-width: 1050px)" width="{{ section.settings.hero_image_mobile.width }}" height="{{ section.settings.hero_image_mobile.height }}" srcset="{{ section.settings.hero_image_mobile | image_url: width: 600 }} 600w, {{ section.settings.hero_image_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
            {% endif %}
            {{ section.settings.hero_image | image_url: width: 2000 | image_tag: widths: '500,750,1000,1300,1600,2000', sizes: artwork_sizes, loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_alt }}
          </picture>
        {% else %}
          {% if left_image != blank %}
            <div class="jh__cover jh__cover--left">{{ left_image | image_url: width: 800 | image_tag: widths: '300,500,800', sizes: '(min-width: 750px) 28vw, 48vw', loading: 'eager', alt: section.settings.cover_left_alt }}</div>
          {% endif %}
          {% if right_image != blank %}
            <div class="jh__cover jh__cover--right">{{ right_image | image_url: width: 800 | image_tag: widths: '300,500,800', sizes: '(min-width: 750px) 28vw, 48vw', loading: 'eager', alt: section.settings.cover_right_alt }}</div>
          {% endif %}
          {% if spread_image != blank %}
            <div class="jh__spread{% if section.settings.crop_interior %} jh__spread--crop{% endif %}">{{ spread_image | image_url: width: 1200 | image_tag: widths: '450,700,1000,1200', sizes: '(min-width: 750px) 43vw, 75vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.inside_alt }}</div>
          {% endif %}
          {% if left_image == blank and right_image == blank and spread_image == blank %}
            {{ 'product-1' | placeholder_svg_tag: 'jh__placeholder' }}
          {% endif %}
        {% endif %}
      </div>
      <div class="jh__actions">
        <a class="jh__button" href="{{ primary_url }}">{{ 'june_hero.actions.shop_undated' | t }} <span class="jh__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></span></a>
        <a class="jh__text-link" href="{{ limited_url }}">{{ 'june_hero.actions.explore_limited' | t }} <span class="jh__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></span></a>
      </div>
    </div>
    <div id="{{ hero_id }}-limited" class="jh__panel jh__panel--alternate" data-panel="limited" hidden>
      <div class="jh__copy"><p class="jh__eyebrow">{{ 'june_hero.tabs.limited' | t }}</p><h2 class="jh__alternate-title">{{ section.settings.limited_heading | escape }}</h2><p class="jh__body">{{ section.settings.limited_body | escape }}</p></div>
      <div class="jh__art jh__art--single">{% if edition_image != blank %}{{ edition_image | image_url: width: 1000 | image_tag: widths: '400,650,1000', sizes: '(min-width: 750px) 45vw, 80vw', loading: 'lazy', alt: section.settings.limited_alt }}{% endif %}</div>
      <div class="jh__actions"><a class="jh__button" href="{{ limited_url }}">{{ 'june_hero.actions.shop_limited' | t }} <span class="jh__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></span></a></div>
    </div>
    <div id="{{ hero_id }}-dated" class="jh__panel jh__panel--dated" data-panel="dated" hidden>
      <div class="jh__copy"><p class="jh__eyebrow">{{ 'june_hero.labels.coming_soon' | t }}</p><h2 class="jh__alternate-title">{{ section.settings.dated_heading | escape }}</h2><p class="jh__body">{{ 'june_hero.labels.launch_description' | t }}</p>
        {% assign form_id = hero_id | append: '-launch' %}
        {% form 'customer', id: form_id, class: 'jh__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,2027-planner-launch">
          {% if form.posted_successfully? %}<p role="status" tabindex="-1" class="jh__success">{{ 'june_hero.form.success' | t }}</p>{% else %}
            {% if form.errors %}<div id="{{ form_id }}-error" class="jh__error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            <label for="{{ form_id }}-email">{{ 'june_hero.form.email' | t }}</label>
            <div class="jh__form-row"><input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | escape }}" {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}><button type="submit" class="jh__button">{{ 'june_hero.form.submit' | t }} <span class="jh__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></span></button></div>
            <p class="jh__form-note">{{ 'june_hero.form.note' | t }}</p>
          {% endif %}
        {% endform %}
      </div>
      <div class="jh__year" aria-hidden="true">2027<span>{{ 'june_hero.labels.next_chapter' | t }}</span></div>
    </div>
    <div id="{{ hero_id }}-life" class="jh__panel jh__panel--life" data-panel="life" hidden>
      <div class="jh__copy"><p class="jh__eyebrow">{{ 'june_hero.tabs.life' | t }}</p><h2 class="jh__alternate-title">{{ section.settings.life_heading | escape }}</h2><p class="jh__body">{{ section.settings.life_body | escape }}</p></div>
      <div class="jh__life-list">
        {% for block in section.blocks %}
          {% if block.type == 'life_link' %}
          <a class="jh__life-item" href="{{ block.settings.collection.url | default: life_url }}" {{ block.shopify_attributes }}>
            {% assign life_image = block.settings.image | default: block.settings.collection.image %}
            {% if life_image != blank %}{{ life_image | image_url: width: 240 | image_tag: widths: '120,240', sizes: '90px', loading: 'lazy', alt: '' }}{% endif %}
            <span>{{ block.settings.label | escape }}</span><span class="jh__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
      <div class="jh__actions"><a class="jh__text-link" href="{{ life_url }}">{{ 'june_hero.actions.all_journals' | t }} <span class="jh__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></span></a></div>
    </div>
  </div>
  <div class="jh__navigation">
    <nav class="jh__tabs" aria-label="{{ 'june_hero.labels.categories' | t | escape }}">
      <a class="jh__tab" href="{{ primary_url }}" data-target="undated" id="{{ hero_id }}-tab-undated"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="7" y="3" width="19" height="26" rx="2"/><path d="M11 3v26M4 8h6M4 14h6M4 20h6M4 26h6"/></svg><span>{{ 'june_hero.tabs.undated' | t }}</span></a>
      <a class="jh__tab" href="{{ limited_url }}" data-target="limited" id="{{ hero_id }}-tab-limited"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 26C3 7 16 3 28 4c0 15-8 24-19 19M5 28L23 9M12 20v-8M12 20h8"/></svg><span>{{ 'june_hero.tabs.limited' | t }}</span></a>
      <a class="jh__tab" href="#{{ hero_id }}-dated" data-target="dated" id="{{ hero_id }}-tab-dated"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="7" width="24" height="21" rx="2"/><path d="M4 13h24M10 3v8M22 3v8"/></svg><span>{{ 'june_hero.tabs.dated' | t }}<small>{{ 'june_hero.labels.coming_soon' | t }}</small></span></a>
      <a class="jh__tab" href="{{ life_url }}" data-target="life" id="{{ hero_id }}-tab-life"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M16 7C12 3 6 3 3 5v22c5-3 9-2 13 1 4-3 8-4 13-1V5c-3-2-9-2-13 2ZM16 7v21"/></svg><span>{{ 'june_hero.tabs.life' | t }}</span></a>
    </nav>
    {% if mystery_url != blank %}<a class="jh__mystery" href="{{ mystery_url }}"><img class="jh__mystery-icon" src="https://cdn.shopify.com/s/files/1/0177/5579/9606/files/mystery-box-peeking-eyes-edge-to-edge.ico?v=1790337217" width="32" height="32" alt="" loading="eager"><span>{{ 'june_hero.actions.mystery' | t }}</span><span class="jh__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></span></a>{% endif %}
  </div>
</june-make-room>
<noscript><style>#{{ hero_id }} [data-panel][hidden]{display:grid}#{{ hero_id }} .jh__panel{border-bottom:1px solid #ccc}</style></noscript>
{% stylesheet %}
.jh{display:block;position:relative;background:var(--jh-bg,#f7f3eb);color:var(--jh-ink,#121212);font-family:Arial,sans-serif;isolation:isolate;overflow:clip}.jh *{box-sizing:border-box}.jh h1,.jh h2,.jh p{margin:0;color:inherit}.jh a{color:inherit;text-decoration:none}.jh button,.jh input{font:inherit}.jh a:focus-visible,.jh button:focus-visible,.jh input:focus-visible{outline:3px solid #955331;outline-offset:5px}.jh__stage{position:relative;max-width:1680px;margin:auto}.jh__stage:before{content:"";pointer-events:none;position:absolute;inset:8% -12% -35% 36%;border-radius:50%;background:linear-gradient(145deg,transparent 42%,#fff9 43%,#e0d8c62b 47%,transparent 63%);transform:rotate(-15deg)}.jh__panel{min-height:var(--jh-height,520px);display:grid;grid-template-columns:45% 55%;grid-template-rows:1fr auto;position:relative;padding:48px clamp(24px,4vw,72px) 44px;align-items:center}.jh__panel[hidden]{display:none!important}.jh__copy{grid-column:1;grid-row:1;z-index:2;align-self:center}.jh__eyebrow{font-size:11px;line-height:1.5;letter-spacing:.24em;text-transform:uppercase;font-weight:600;margin-bottom:20px!important}.jh__title{font-family:var(--jh-font),Impact,sans-serif;font-weight:var(--jh-weight,700);font-size:clamp(76px,9.2vw,var(--jh-title-size,144px));line-height:1.04;letter-spacing:-.045em;white-space:nowrap;position:relative;z-index:3;margin-left:-4px!important}.jh__subtitle{font-size:clamp(24px,2.7vw,39px);line-height:1.13;letter-spacing:-.035em;max-width:470px;margin-top:24px!important}.jh__body{font-size:15px;line-height:1.55;max-width:410px;margin-top:18px!important}.jh__art{grid-column:2;grid-row:1 / 3;position:relative;height:100%;min-height:400px;isolation:auto;align-self:stretch}.jh__cover{position:absolute;width:42%;aspect-ratio:.74;overflow:hidden;mix-blend-mode:multiply}.jh__cover img{display:block;width:145%;max-width:none;height:auto;margin-left:-22%;margin-top:-5%}.jh__cover--left{left:12%;top:0;transform:rotate(-9deg)}.jh__cover--right{right:-1%;top:0;transform:rotate(10deg)}.jh__spread{position:absolute;left:10%;bottom:0;width:79%;transform:rotate(-7deg);border-radius:7px;box-shadow:0 1px 0 #f6f1e7,0 2px 0 #cfc5b4,0 3px 0 #eee8dc,0 4px 0 #b9ae9c,0 8px 10px -5px #382a2438,0 23px 28px -15px #382a2459}.jh__spread:after{content:"";position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 1px 0 #ffffff90,inset 0 0 0 1px #382a2414;pointer-events:none}.jh__spread img{display:block;width:100%;height:auto;border-radius:inherit}.jh__spread--crop{aspect-ratio:1.62;overflow:hidden;border-radius:7px}.jh__spread--crop img{width:112%;max-width:none;margin-left:-6%;margin-top:-27%}.jh__full-art{display:block;width:100%;height:100%}.jh__full-art img{width:100%;height:100%;object-fit:contain}.jh__actions{grid-column:1;grid-row:2;display:flex;align-items:center;gap:24px;z-index:3;margin-top:28px;flex-wrap:wrap}.jh__button{border:1px solid var(--jh-ink);background:var(--jh-ink);color:var(--jh-bg)!important;display:inline-flex;align-items:center;justify-content:center;gap:16px;padding:14px 22px;min-height:48px;font-size:13px;font-weight:600;line-height:1.3;cursor:pointer;border-radius:6px;box-shadow:inset 0 1px 0 #ffffff26,0 2px 0 #000,0 5px 9px -4px #221b1940;transition:background .18s,box-shadow .18s,transform .18s}.jh__button:hover{background:#38332e;transform:translateY(-1px);box-shadow:inset 0 1px 0 #ffffff30,0 3px 0 #161310,0 7px 12px -5px #221b194d}.jh__button:active{transform:translateY(1px);box-shadow:inset 0 1px 2px #0003,0 1px 0 #161310}.jh__text-link{font-size:13px;min-height:44px;display:inline-flex;align-items:center;gap:10px;text-decoration:underline!important;text-underline-offset:5px}.jh__navigation{display:flex;border-top:1px solid #24242425;position:relative;z-index:4}.jh__tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));flex:1}.jh__tab{min-height:86px;display:flex;align-items:center;justify-content:center;gap:16px;padding:16px 10px;border-right:1px solid #24242420;position:relative;f