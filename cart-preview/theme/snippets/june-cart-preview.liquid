{% doc %}
  Compact, non-modal presentation of the existing cart after a successful add.
  @param {section} section - Cart drawer section and settings.
{% enddoc %}
<june-cart-preview data-enabled="{{ section.settings.june_preview }}" data-seconds="{{ section.settings.june_preview_seconds | default: 5 }}" data-width="{{ section.settings.june_preview_width | default: 380 }}" data-title="{{ section.settings.june_preview_title | escape }}" data-full="{{ section.settings.june_preview_full | escape }}"></june-cart-preview>
<script src="{{ 'june-cart-preview.js' | asset_url }}" defer></script>
{% style %}
#CartDrawer.june-cart-preview{position:fixed!important;inset:auto!important;left:var(--jcp-left)!important;top:var(--jcp-top)!important;margin:0!important;width:var(--jcp-width)!important;height:auto!important;max-height:min(540px,calc(100dvh - var(--jcp-top) - 12px))!important;border:1px solid var(--jc-border)!important;border-radius:20px!important;box-shadow:0 12px 40px rgb(0 0 0 / .16);z-index:2147483000;transform:none!important;overflow:hidden;flex-direction:column}
#CartDrawer.june-cart-preview[open]{display:flex!important}
#CartDrawer.june-cart-preview .hdt-dialog-drawer__header{padding:12px 16px!important;min-height:54px!important}
#CartDrawer.june-cart-preview .hdt-mini-cart__header-title{font-size:18px!important;line-height:1.2!important}
#CartDrawer.june-cart-preview .hdt-dialog-drawer__header button{width:32px;height:32px}
#CartDrawer.june-cart-preview .hdt-dialog-drawer__inner{flex:0 1 auto!important;min-height:0}
#CartDrawer.june-cart-preview .hdt-mini-cart__wrap{flex:0 1 auto!important;min-height:0}
#CartDrawer.june-cart-preview .hdt-mini-cart__main{flex:1 1 auto;max-height:280px;min-height:70px;overflow:auto}
#CartDrawer.june-cart-preview .hdt-mini-cart__sroll{position:static!important;height:auto!important;padding:0 16px}
#CartDrawer.june-cart-preview .hdt-mini-cart__item{padding:12px 0;gap:12px}
#CartDrawer.june-cart-preview .hdt-mini-cart__image{width:54px;max-width:54px;flex-basis:54px}
#CartDrawer.june-cart-preview .hdt-mini-cart__img{width:54px;height:68px;margin:0;border-radius:7px}
#CartDrawer.june-cart-preview .hdt-mini-cart__title{font-size:12px!important;line-height:1.4!important;margin-bottom:3px}
#CartDrawer.june-cart-preview .hdt-mini-cart__meta-variant{font-size:11px;margin-bottom:2px}
#CartDrawer.june-cart-preview .hdt-mini-cart__price{margin:5px 0 0}
#CartDrawer.june-cart-preview .hdt-mini-cart__price .hdt-price{font-size:16px!important}
#CartDrawer.june-cart-preview .jcp-quantity{font-size:11px;color:var(--june-muted,#656565);margin-top:3px}
#CartDrawer:not(.june-cart-preview) .jcp-quantity{display:none}
#CartDrawer.june-cart-preview .hdt-mini-cart__btns,#CartDrawer.june-cart-preview .june-cart-savings,#CartDrawer.june-cart-preview .hdt-mini-cart__threshold,#CartDrawer.june-cart-preview .hdt-mini-cart__tool,#CartDrawer.june-cart-preview .hdt-minicart-recommendations{display:none!important}
#CartDrawer.june-cart-preview .hdt-mini-cart__bottom{max-height:none;overflow:visible;padding:12px 16px!important;box-shadow:none}
#CartDrawer.june-cart-preview .hdt-mini-cart__totals{margin-bottom:10px}
#CartDrawer.june-cart-preview .hdt-mini-cart__value{font-size:20px!important}
#CartDrawer.june-cart-preview .gokwik-checkout button,#CartDrawer.june-cart-preview .hdt-mini-cart__btn-checkout{min-height:44px!important;padding:8px 14px}
#CartDrawer.june-cart-preview .hdt-mini-cart__view-checkout{gap:5px}
@media(max-width:749px){#CartDrawer.june-cart-preview{border-radius:18px!important}#CartDrawer.june-cart-preview .hdt-mini-cart__main{max-height: min(240px,35dvh)}}
{% endstyle %}
