{% doc %}
  Compare-at savings only. Applied discounts remain in the native discount list.
{% enddoc %}
{% liquid
  assign comparison_savings = 0
  for item in cart.items
    if item.variant.compare_at_price > item.original_price
      assign difference = item.variant.compare_at_price | minus: item.original_price | times: item.quantity
      assign comparison_savings = comparison_savings | plus: difference
    endif
  endfor
%}
{% if comparison_savings > 0 %}
  <div class="hdt-flex hdt-align-center hdt-justify-between" style="padding:12px;border-radius:12px;background:var(--june-surface,#f5f5f3);margin-bottom:12px">
    <span>Savings against original prices</span>
    <strong class="hdt-money">{{ comparison_savings | money }}</strong>
  </div>
{% endif %}
