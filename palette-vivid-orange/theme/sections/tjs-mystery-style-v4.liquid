{% comment %}TJS Mystery Box V5 — Editorial Graphic Design Tokens{% endcomment %}
{{ 'tjs-mystery-v4.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tjs-mystery-v4.js' | asset_url }}" defer="defer"></script>
<style>
  :root {
    --tjs-paper: {{ section.settings.paper }};
    --tjs-paper-2: {{ section.settings.paper_alt }};
    --tjs-ink: {{ section.settings.ink }};
    --tjs-muted: {{ section.settings.muted }};
    --tjs-gold: {{ section.settings.gold }};
    --tjs-yellow: {{ section.settings.yellow }};
    --tjs-dark: {{ section.settings.dark }};
    {% if section.settings.reference_bold_mode %}
      --tjs-display: 'Arial Black', Arial, 'Helvetica Neue', Helvetica, sans-serif;--tjs-display
      --tjs-text: Arial, 'Helvetica Neue', Helvetica, sans-serif;
      --tjs-micro: 'Arial Narrow', Arial, 'Helvetica Neue', sans-serif;
      --tjs-serif: 'Arial Black', Arial, 'Helvetica Neue', Helvetica, sans-serif;
      --tjs-condensed: 'Arial Narrow', Arial, 'Helvetica Neue', sans-serif;
      --tjs-sans: Arial, 'Helvetica Neue', Helvetica, sans-serif;
      --tjs-display-weight: 900;
      --tjs-body-weight: 500;
      --tjs-micro-weight: 800;
      --tjs-value-weight: 900;
    {% else %}
      --tjs-display: {{ section.settings.display_stack }};--tjs-display
      --tjs-text: {{ section.settings.text_stack }};
      --tjs-micro: {{ section.settings.micro_stack }};
      --tjs-serif: {{ section.settings.display_stack }};
      --tjs-condensed: {{ section.settings.micro_stack }};
      --tjs-sans: {{ section.settings.text_stack }};
      --tjs-display-weight: {{ section.settings.display_weight }};
      --tjs-body-weight: {{ section.settings.body_weight }};
      --tjs-micro-weight: {{ section.settings.micro_weight }};
      --tjs-value-weight: {{ section.settings.value_weight }};
    {% endif %}
    --tjs-page-max: {{ section.settings.page_max }}px;--tjs-page-max
    --tjs-content-max: {{ section.settings.content_max }}px;
    --tjs-radius: {{ section.settings.panel_radius }}px;
    --tjs-radius-card: {{ section.settings.card_radius }}px;
    --tjs-radius-button: {{ section.settings.button_radius }}px;
    --tjs-grid-size: {{ section.settings.grid_size }}px;
    --tjs-grid-alpha: {{ section.settings.grid_opacity | divided_by: 100.0 }};
    --tjs-texture-alpha: {{ section.settings.texture_opacity | divided_by: 100.0 }};
    --tjs-story: {{ section.settings.story_duration }}ms;
    --tjs-hero: {{ section.settings.hero_duration }}ms;
    --tjs-tilt-strength: {{ section.settings.tilt_strength }}deg;
    --tjs-reveal-distance: {{ section.settings.reveal_distance }}px;
    --tjs-shake-strength: {{ section.settings.shake_strength }}px;
  }
</style>
<script>
  window.TJSMysteryMotion = {
    enabled: {{ section.settings.enable_motion | json }},
    level: {{ section.settings.motion_level | json }},
    tapeSlap: {{ section.settings.enable_tape_slap | json }},
    boxTilt: {{ section.settings.enable_box_tilt | json }},
    highlightSwipe: {{ section.settings.enable_highlight_swipe | json }},
    tierFill: {{ section.settings.enable_tier_fill | json }},
    numberFlip: {{ section.settings.enable_number_flip | json }},
    kineticValue: {{ section.settings.enable_kinetic_value | json }},
    shakeHalo: {{ section.settings.enable_shake_halo | json }},
    journeyLine: {{ section.settings.enable_journey_line | json }},
    stickyMorph: {{ section.settings.enable_sticky_morph | json }}
  };
  document.documentElement.dataset.tjsMysteryMotion = {{ section.settings.enable_motion | json }} ? 'on' : 'off';
</script>
{% if request.design_mode %}
  <div style="max-width:1100px;margin:8px auto;padding:10px 14px;border:1px dashed rgba(17,17,17,.24);font:12px/1.4 Arial;color:#5F625D;background:#F4F2EA;">
    <strong style="color:#111">Mystery Box V5.1 / Bold Editorial System</strong> — Theme Editor only. Adjust typography, acid accent, grid, texture, spacing and motion here.
  </div>
{% endif %}
{% schema %}
{
  "name": "TJS Mystery Style",
  "tag": "section",
  "class": "tjs-mystery-v4-style",
  "settings": [
    {
      "type": "header",
      "content": "V5 color system"
    },
    {
      "type": "color",
      "id": "paper",
      "label": "Paper background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "paper_alt",
      "label": "Alternate paper",
      "default": "#F5F5F3"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Primary ink",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "muted",
      "label": "Secondary ink",
      "default": "#656565"
    },
    {
      "type": "color",
      "id": "gold",
      "label": "Warm secondary accent",
      "default": "#F56A28"
    },
    {
      "type": "color",
      "id": "yellow",
      "label": "Acid campaign accent",
      "default": "#F56A28"
    },
    {
      "type": "color",
      "id": "dark",
      "label": "Dark campaign field",
      "default": "#171717"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "checkbox",
      "id": "reference_bold_mode",
      "label": "Reference bold type mode",
      "default": true,
      "info": "ON forces the thick, clean reference direction immediately (900 display/value, 800 labels, 500 body). Turn OFF to use the custom font stacks and weight controls below."
    },
    {
      "type": "text",
      "id": "display_stack",
      "label": "Display grotesk CSS stack",
      "default": "'Arial Black', Arial, 'Helvetica Neue', Helvetica, sans-serif",
      "info": "Heavy grotesk display stack. Replace with a loaded theme/webfont such as Neue Montreal, Inter Tight, Satoshi Black, or Helvetica Now Display if available."
    },
    {
      "type": "text",
      "id": "text_stack",
      "label": "Body CSS stack",
      "default": "Arial, 'Helvetica Neue', Helvetica, sans-serif"
    },
    {
      "type": "text",
      "id": "micro_stack",
      "label": "Micro / condensed CSS stack",
      "default": "'Arial Narrow', Arial, 'Helvetica Neue', sans-serif"
    },
    {
      "type": "select",
      "id": "display_weight",
      "label": "Display weight",
      "default": "900",
      "options": [
        {
          "value": "700",
          "label": "700 — Bold"
        },
        {
          "value": "800",
          "label": "800 — Extra bold"
        },
        {
          "value": "900",
          "label": "900 — Black"
        }
      ]
    },
    {
      "type": "select",
      "id": "value_weight",
      "label": "Price / value weight",
      "default": "900",
      "options": [
        {
          "value": "700",
          "label": "700 — Bold"
        },
        {
          "value": "800",
          "label": "800 — Extra bold"
        },
        {
          "value": "900",
          "label": "900 — Black"
        }
      ]
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Body weight",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "400 — Regular"
        },
        {
          "value": "500",
          "label": "500 — Medium"
        },
        {
          "value": "600",
          "label": "600 — Semi bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "micro_weight",
      "label": "Micro / label weight",
      "default": "800",
      "options": [
        {
          "value": "700",
          "label": "700 — Bold"
        },
        {
          "value": "800",
          "label": "800 — Extra bold"
        },
        {
          "value": "900",
          "label": "900 — Black"
        }
      ]
    },
    {
      "type": "header",
      "content": "Grid + print texture"
    },
    {
      "type": "range",
      "id": "grid_size",
      "label": "Grid size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "grid_opacity",
      "label": "Grid strength",
      "min": 0,
      "max": 18,
      "step": 1,
      "unit": "%",
      "default": 7
    },
    {
      "type": "range",
      "id": "texture_opacity",
      "label": "Paper texture strength",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "%",
      "default": 4
    },
    {
      "type": "header",
      "content": "Global layout"
    },
    {
      "type": "range",
      "id": "page_max",
      "label": "Maximum page width",
      "min": 1200,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1480
    },
    {
      "type": "range",
      "id": "content_max",
      "label": "Maximum content width",
      "min": 960,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Large panel radius",
      "min": 0,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Tier/card radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "enable_motion",
      "label": "Enable motion system",
      "default": true
    },
    {
      "type": "select",
      "id": "motion_level",
      "label": "Motion intensity",
      "default": "expressive",
      "options": [
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "expressive",
          "label": "Expressive"
        }
      ]
    },
    {
      "type": "range",
      "id": "story_duration",
      "label": "Story reveal speed",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "ms",
      "default": 440
    },
    {
      "type": "range",
      "id": "hero_duration",
      "label": "Sticker/tape speed",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "ms",
      "default": 620
    },
    {
      "type": "checkbox",
      "id": "enable_tape_slap",
      "label": "Sticker / tape slap",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_box_tilt",
      "label": "Hero box tilt",
      "default": true
    },
    {
      "type": "range",
      "id": "tilt_strength",
      "label": "Box tilt strength",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "deg",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_highlight_swipe",
      "label": "Headline marker swipe",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_tier_fill",
      "label": "Tier selection sweep",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_number_flip",
      "label": "Dynamic number flip",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_kinetic_value",
      "label": "Kinetic value section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_shake_halo",
      "label": "Shake interaction halo",
      "default": true
    },
    {
      "type": "range",
      "id": "shake_strength",
      "label": "Shake strength",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "checkbox",
      "id": "enable_journey_line",
      "label": "Journey line draw",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_morph",
      "label": "Sticky CTA morph",
      "default": true
    },
    {
      "type": "range",
      "id": "reveal_distance",
      "label": "Scroll reveal distance",
      "min": 6,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "TJS Mystery Style"
    }
  ]
}
{% endschema %}
