<section id="TjsMysteryJourney-{{ section.id }}" class="tjs-mv4 tjs-mv4-journey" style="--tjs-journey-pt:{{ section.settings.journey_pt }}px;--tjs-journey-pb:{{ section.settings.journey_pb }}px;--tjs-journey-mpt:{{ section.settings.mobile_pt }}px;--tjs-journey-mpb:{{ section.settings.mobile_pb }}px;--tjs-journey-mgap:{{ section.settings.mobile_step_gap }}px;">
  <div class="tjs-mv4__shell"><div class="tjs-mv4__content">
    <div data-reveal>{% if section.settings.eyebrow != blank %}<div class="tjs-mv4__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}<h2 class="tjs-mv4__display tjs-mv4-journey__heading tjs-mv5-manual-heading" aria-label="{{ section.settings.heading_line_1 | escape }} {{ section.settings.heading_line_2 | escape }} {{ section.settings.heading_line_3 | escape }}">{% if section.settings.heading_line_1 != blank %}<span class="tjs-mv5-manual-line">{{ section.settings.heading_line_1 }}</span>{% endif %}{% if section.settings.heading_line_2 != blank %}<span class="tjs-mv5-manual-line">{{ section.settings.heading_line_2 }}</span>{% endif %}{% if section.settings.heading_line_3 != blank %}<span class="tjs-mv5-manual-line">{{ section.settings.heading_line_3 }}</span>{% endif %}</h2></div>
    <div class="tjs-mv4-journey__track" aria-hidden="true"><span></span></div>
    <div class="tjs-mv4-journey__grid">
      {% for block in section.blocks %}
        <article class="tjs-mv4-step" data-reveal style="transition-delay:{{ forloop.index0 | times: 110 }}ms" {{ block.shopify_attributes }}>
          <div class="tjs-mv4-step__num">{{ forloop.index | prepend: '0' }}</div>
          <h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p>
        </article>
      {% endfor %}
    </div>
  </div></div>
</section>
{% schema %}
{
  "name": "TJS Mystery Journey",
  "tag": "section",
  "class": "tjs-mystery-v4-journey-section",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "journey_pt",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "journey_pb",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "mobile_pt",
      "label": "Mobile top spacing",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_pb",
      "label": "Mobile bottom spacing",
      "min": 16,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_step_gap",
      "label": "Mobile step gap",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HOW / IT WORKS"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "PICK IT."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "WE PACK IT."
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading line 3",
      "default": "YOU REVEAL IT."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "PICK YOUR MYSTERY"
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Copy",
          "default": "Choose the ₹1,499 or ₹1,999 tier."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TJS Mystery Journey",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "PICK YOUR MYSTERY",
            "copy": "Choose the ₹1,499 or ₹1,999 tier."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "WE PACK THE SURPRISE",
            "copy": "Your mystery assortment is selected and securely packed."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "YOU DO THE REVEAL",
            "copy": "The mystery ends when the box reaches you."
          }
        }
      ]
    }
  ]
}
{% endschema %}
