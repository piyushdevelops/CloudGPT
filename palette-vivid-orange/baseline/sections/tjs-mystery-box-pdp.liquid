{% comment %}
  THE JUNE SHOP — Mystery Box PDP v3
  Mobile-first, two-tier buying journey, spoiler-free storytelling.
{% endcomment %}

{% liquid
  assign tier_1_price = section.settings.tier_1_price | default: 1499
  assign tier_1_value = section.settings.tier_1_value | default: 3000
  assign tier_2_price = section.settings.tier_2_price | default: 1999
  assign tier_2_value = section.settings.tier_2_value | default: 5000
  assign tier_1_save = tier_1_value | minus: tier_1_price
  assign tier_2_save = tier_2_value | minus: tier_2_price
  assign variant_1 = product.variants[0]
  assign variant_2 = product.variants[1]
  assign initial_variant = product.selected_or_first_available_variant
%}

<section id="TjsMystery-{{ section.id }}" class="tjs-mystery" data-section-id="{{ section.id }}">
  <style>
    #TjsMystery-{{ section.id }} {
      --ink: {{ section.settings.ink_color }};
      --muted: {{ section.settings.muted_color }};
      --paper: {{ section.settings.paper_color }};
      --paper-2: {{ section.settings.paper_alt_color }};
      --accent: {{ section.settings.accent_color }};
      --line: rgba(28,26,24,.14);
      --line-strong: rgba(28,26,24,.24);
      --serif: Georgia, 'Times New Roman', serif;
      --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
      overflow: clip;
      position: relative;
    }

    #TjsMystery-{{ section.id }} *,
    #TjsMystery-{{ section.id }} *::before,
    #TjsMystery-{{ section.id }} *::after { box-sizing: border-box; }

    #TjsMystery-{{ section.id }} .tjs-shell {
      width: min(100%, 1380px);
      margin: 0 auto;
      padding: 10px 10px 84px;
    }

    #TjsMystery-{{ section.id }} .tjs-hero {
      display: grid;
      gap: 10px;
    }

    /* MEDIA — intentionally compact on mobile */
    #TjsMystery-{{ section.id }} .tjs-media {
      position: relative;
      min-height: 168px;
      max-height: 184px;
      overflow: hidden;
      background:
        radial-gradient(circle at 20% 8%, rgba(255,255,255,.98), transparent 30%),
        radial-gradient(circle at 82% 85%, rgba(225,200,91,.12), transparent 28%),
        linear-gradient(135deg, var(--paper-2), #faf8f3);
      border: 1px solid var(--line);
      border-radius: 20px;
      display: grid;
      place-items: center;
      isolation: isolate;
    }

    #TjsMystery-{{ section.id }} .tjs-media::after {
      content: '';
      position: absolute;
      inset: 0;
      opacity: .10;
      background-image: radial-gradient(rgba(28,26,24,.34) .5px, transparent .5px);
      background-size: 9px 9px;
      pointer-events: none;
    }

    #TjsMystery-{{ section.id }} .tjs-media__tag {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 4;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      padding: 7px 9px;
      background: rgba(255,255,255,.88);
      font-size: 8px;
      font-weight: 850;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    #TjsMystery-{{ section.id }} .tjs-hero-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 20px 42px 10px;
      z-index: 2;
      filter: drop-shadow(0 20px 24px rgba(0,0,0,.14));
    }

    #TjsMystery-{{ section.id }} .tjs-box-stage {
      width: min(65vw, 245px);
      aspect-ratio: 1.18 / .72;
      display: grid;
      place-items: center;
      position: relative;
      z-index: 2;
      transform: translateY(5px);
    }
    #TjsMystery-{{ section.id }} .tjs-box {
      width: 88%;
      height: 78%;
      position: relative;
      border-radius: 7px;
      background: linear-gradient(145deg,#171717,#262626 55%,#101010);
      box-shadow: 0 22px 35px rgba(0,0,0,.22), inset 0 1px rgba(255,255,255,.07);
      transform: rotate(-2deg);
    }
    #TjsMystery-{{ section.id }} .tjs-box::before {
      content: '';
      position: absolute;
      inset: -12% 29%;
      background: linear-gradient(90deg,#ceb34f,#ead572 48%,#c6a53f);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,.12);
    }
    #TjsMystery-{{ section.id }} .tjs-box::after {
      content: 'THE JUNE SHOP';
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%,-50%) rotate(-90deg);
      color: #151515;
      font-size: 7px;
      font-weight: 900;
      letter-spacing: .22em;
      white-space: nowrap;
    }

    #TjsMystery-{{ section.id }} .tjs-seal {
      position: absolute;
      right: 14px;
      bottom: 13px;
      width: 62px;
      height: 62px;
      z-index: 3;
      border-radius: 50%;
      background: rgba(255,255,255,.96);
      border: 1px solid var(--line-strong);
      box-shadow: 0 9px 24px rgba(0,0,0,.08);
      display: grid;
      place-items: center;
      text-align: center;
      transform: rotate(8deg);
      font-size: 7px;
      font-weight: 850;
      line-height: 1.18;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    /* BUY PANEL */
    #TjsMystery-{{ section.id }} .tjs-buy {
      background: rgba(255,255,255,.92);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 17px 14px 14px;
    }
    #TjsMystery-{{ section.id }} .tjs-kicker {
      margin: 0 0 7px;
      color: var(--muted);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    #TjsMystery-{{ section.id }} .tjs-title {
      margin: 0;
      max-width: 12ch;
      font: 400 clamp(34px,9.7vw,49px)/.94 var(--serif);
      letter-spacing: -.045em;
    }
    #TjsMystery-{{ section.id }} .tjs-lead {
      margin: 9px 0 14px;
      max-width: 42ch;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.48;
    }

    #TjsMystery-{{ section.id }} .tjs-label {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 10px;
      margin: 0 0 8px;
      font-size: 10px;
      font-weight: 850;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    #TjsMystery-{{ section.id }} .tjs-label small {
      color: var(--muted);
      font-size: 9px;
      font-weight: 650;
      letter-spacing: 0;
      text-transform: none;
    }

    #TjsMystery-{{ section.id }} .tjs-variants {
      display: grid;
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 8px;
      margin: 0;
      padding: 0;
      border: 0;
    }
    #TjsMystery-{{ section.id }} .tjs-tier {
      position: relative;
      min-width: 0;
      min-height: 126px;
      padding: 12px 10px 11px;
      border: 1px solid var(--line-strong);
      border-radius: 14px;
      background: #fff;
      cursor: pointer;
      transition: transform .18s ease,border-color .18s ease,box-shadow .18s ease,background .18s ease;
      -webkit-tap-highlight-color: transparent;
    }
    #TjsMystery-{{ section.id }} .tjs-tier input { position: absolute; opacity: 0; pointer-events: none; }
    #TjsMystery-{{ section.id }} .tjs-tier.is-selected,
    #TjsMystery-{{ section.id }} .tjs-tier:has(input:checked) {
      border-color: var(--ink);
      box-shadow: inset 0 0 0 1px var(--ink),0 8px 20px rgba(28,26,24,.08);
      background: #fffdf7;
      transform: translateY(-1px);
    }
    #TjsMystery-{{ section.id }} .tjs-tier.is-selected::after,
    #TjsMystery-{{ section.id }} .tjs-tier:has(input:checked)::after {
      content: '✓';
      position: absolute;
      top: 9px;
      right: 9px;
      width: 21px;
      height: 21px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--ink);
      color: #fff;
      font-size: 10px;
      font-weight: 900;
    }
    #TjsMystery-{{ section.id }} .tjs-tier--premium { border-color: rgba(201,165,63,.62); }
    #TjsMystery-{{ section.id }} .tjs-tier--missing { opacity:.48; cursor:not-allowed; }
    #TjsMystery-{{ section.id }} .tjs-tier__eyebrow {
      min-height: 14px;
      padding-right: 24px;
      color: var(--muted);
      font-size: 8px;
      font-weight: 850;
      letter-spacing: .11em;
      text-transform: uppercase;
    }
    #TjsMystery-{{ section.id }} .tjs-tier__price {
      margin-top: 11px;
      font: 400 27px/1 var(--serif);
      letter-spacing: -.035em;
    }
    #TjsMystery-{{ section.id }} .tjs-tier__worth {
      margin-top: 6px;
      font-size: 11px;
      font-weight: 850;
      line-height: 1.2;
    }
    #TjsMystery-{{ section.id }} .tjs-tier__save {
      margin-top: 8px;
      color: var(--muted);
      font-size: 9px;
      line-height: 1.25;
    }
    #TjsMystery-{{ section.id }} .tjs-tier__flag {
      display: inline-block;
      margin-top: 7px;
      width: max-content;
      padding: 4px 6px;
      border-radius: 999px;
      background: rgba(225,200,91,.26);
      font-size: 7px;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    #TjsMystery-{{ section.id }} .tjs-selected-summary {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 0;
      margin: 9px 0;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--paper-2);
      overflow: hidden;
    }
    #TjsMystery-{{ section.id }} .tjs-sum {
      min-width: 0;
      padding: 9px 8px 10px;
      text-align: center;
      border-right: 1px solid var(--line);
    }
    #TjsMystery-{{ section.id }} .tjs-sum:last-child { border-right: 0; }
    #TjsMystery-{{ section.id }} .tjs-sum span {
      display: block;
      color: var(--muted);
      font-size: 7px;
      font-weight: 850;
      letter-spacing: .11em;
      text-transform: uppercase;
    }
    #TjsMystery-{{ section.id }} .tjs-sum b {
      display: block;
      margin-top: 4px;
      font: 400 16px/1 var(--serif);
      letter-spacing: -.02em;
      white-space: nowrap;
    }

    #TjsMystery-{{ section.id }} .tjs-atc {
      width: 100%;
      min-height: 55px;
      border: 0;
      border-radius: 13px;
      background: var(--ink);
      color: #fff;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 11px 24px rgba(28,26,24,.18);
    }
    #TjsMystery-{{ section.id }} .tjs-atc:disabled { opacity:.45; cursor:not-allowed; box-shadow:none; }

    #TjsMystery-{{ section.id }} .tjs-trust {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 8px 10px;
      margin-top: 11px;
    }
    #TjsMystery-{{ section.id }} .tjs-trust span {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 10px;
      line-height: 1.25;
    }
    #TjsMystery-{{ section.id }} .tjs-trust i {
      width: 18px;
      height: 18px;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      border: 1px solid var(--line-strong);
      border-radius: 50%;
      color: var(--ink);
      font-style: normal;
      font-size: 9px;
    }

    #TjsMystery-{{ section.id }} .tjs-config-note {
      margin-top:10px;
      padding:9px 10px;
      border-radius:10px;
      background:#fff3cd;
      border:1px solid #ecd681;
      color:#5a4900;
      font-size:10px;
      line-height:1.4;
    }

    /* EDITORIAL BODY */
    #TjsMystery-{{ section.id }} .tjs-section { margin-top: 12px; }
    #TjsMystery-{{ section.id }} .tjs-section__inner { padding: 31px 14px; border-top:1px solid var(--line); }
    #TjsMystery-{{ section.id }} .tjs-h2 {
      margin: 0;
      max-width: 13ch;
      font: 400 clamp(29px,8.5vw,52px)/.98 var(--serif);
      letter-spacing: -.035em;
    }
    #TjsMystery-{{ section.id }} .tjs-body { margin:9px 0 0; max-width:52ch; color:var(--muted); font-size:13px; line-height:1.55; }

    #TjsMystery-{{ section.id }} .tjs-reveal-grid { margin-top:22px; display:grid; gap:0; }
    #TjsMystery-{{ section.id }} .tjs-reveal-card {
      display:grid;
      grid-template-columns: 42px 1fr;
      gap: 10px;
      padding: 16px 0;
      border-top: 1px solid var(--line);
    }
    #TjsMystery-{{ section.id }} .tjs-reveal-card::before {
      counter-increment: reveal;
      content: '0' counter(reveal);
      color: var(--muted);
      font-size: 9px;
      font-weight: 800;
      letter-spacing:.1em;
    }
    #TjsMystery-{{ section.id }} .tjs-reveal-grid { counter-reset: reveal; }
    #TjsMystery-{{ section.id }} .tjs-reveal-card b { display:block; font:400 20px/1.05 var(--serif); }
    #TjsMystery-{{ section.id }} .tjs-reveal-card p { margin:5px 0 0; color:var(--muted); font-size:11px; line-height:1.5; }

    #TjsMystery-{{ section.id }} .tjs-value-scene {
      margin-inline: -10px;
      padding: 38px 24px;
      background: radial-gradient(circle at 80% 10%,rgba(225,200,91,.18),transparent 30%),#171717;
      color:#fff;
    }
    #TjsMystery-{{ section.id }} .tjs-value-scene .tjs-kicker { color:rgba(255,255,255,.52); }
    #TjsMystery-{{ section.id }} .tjs-value-scene .tjs-h2 { color:#fff; max-width:12ch; }
    #TjsMystery-{{ section.id }} .tjs-equation { margin-top:24px; display:grid; grid-template-columns:1fr auto 1fr; align-items:end; gap:10px; }
    #TjsMystery-{{ section.id }} .tjs-eq-card { border-top:1px solid rgba(255,255,255,.17); padding-top:12px; }
    #TjsMystery-{{ section.id }} .tjs-eq-label { color:rgba(255,255,255,.52); font-size:8px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
    #TjsMystery-{{ section.id }} .tjs-eq-num { margin-top:5px; font:400 clamp(30px,10vw,64px)/1 var(--serif); letter-spacing:-.04em; }
    #TjsMystery-{{ section.id }} .tjs-eq-arrow { padding-bottom:5px; color:var(--accent); font:400 27px/1 var(--serif); }
    #TjsMystery-{{ section.id }} .tjs-eq-note { margin-top:5px; color:rgba(255,255,255,.56); font-size:10px; }
    #TjsMystery-{{ section.id }} .tjs-classified-line { margin-top:24px; padding-top:14px; border-top:1px solid rgba(255,255,255,.15); color:rgba(255,255,255,.68); font-size:11px; }

    #TjsMystery-{{ section.id }} .tjs-shake {
      padding: 44px 14px 48px;
      text-align:center;
      border-top:1px solid var(--line);
    }
    #TjsMystery-{{ section.id }} .tjs-shake .tjs-h2 { margin-inline:auto; max-width:12ch; }
    #TjsMystery-{{ section.id }} .tjs-shake__box {
      width: min(62vw,250px);
      aspect-ratio: 1.45/.82;
      margin: 28px auto 0;
      border-radius: 10px;
      background: linear-gradient(145deg,#151515,#262626 56%,#101010);
      box-shadow: 0 24px 42px rgba(0,0,0,.18);
      position:relative;
      cursor:pointer;
    }
    #TjsMystery-{{ section.id }} .tjs-shake__box::before {
      content:'';
      position:absolute;
      inset:-8% 42%;
      background:linear-gradient(90deg,#d0b54e,#ead575,#c4a53d);
    }
    #TjsMystery-{{ section.id }} .tjs-shake__copy { margin-top:17px; font:400 20px/1.1 var(--serif); }
    #TjsMystery-{{ section.id }} .tjs-shake__hint { margin-top:5px; color:var(--muted); font-size:10px; }
    #TjsMystery-{{ section.id }} .tjs-shake__box.is-shaking { animation:tjsShake .58s cubic-bezier(.36,.07,.19,.97) both; }

    #TjsMystery-{{ section.id }} .tjs-steps { margin-top:22px; }
    #TjsMystery-{{ section.id }} .tjs-step {
      display:grid;
      grid-template-columns: 52px 1fr;
      gap:12px;
      padding:18px 0;
      border-top:1px solid var(--line);
    }
    #TjsMystery-{{ section.id }} .tjs-step::before {
      counter-increment:step;
      content:'0' counter(step);
      font:400 22px/1 var(--serif);
      color:var(--muted);
    }
    #TjsMystery-{{ section.id }} .tjs-steps { counter-reset:step; }
    #TjsMystery-{{ section.id }} .tjs-step b { font:400 19px/1.1 var(--serif); }
    #TjsMystery-{{ section.id }} .tjs-step p { margin:5px 0 0; color:var(--muted); font-size:11px; line-height:1.45; }

    #TjsMystery-{{ section.id }} .tjs-faq details { border-top:1px solid var(--line); }
    #TjsMystery-{{ section.id }} .tjs-faq summary { list-style:none; cursor:pointer; padding:14px 0; font-size:12px; font-weight:760; }
    #TjsMystery-{{ section.id }} .tjs-faq summary::-webkit-details-marker { display:none; }
    #TjsMystery-{{ section.id }} .tjs-faq summary::after { content:'+'; float:right; font-size:16px; font-weight:400; }
    #TjsMystery-{{ section.id }} .tjs-faq details[open] summary::after { content:'–'; }
    #TjsMystery-{{ section.id }} .tjs-faq__answer { padding:0 22px 14px 0; color:var(--muted); font-size:12px; line-height:1.55; }

    /* STICKY BUY BAR */
    #TjsMystery-{{ section.id }} .tjs-sticky {
      position:fixed;
      left:8px;
      right:8px;
      bottom: calc(8px + env(safe-area-inset-bottom));
      z-index: 80;
      display:grid;
      grid-template-columns: 1fr auto;
      gap:10px;
      align-items:center;
      padding: 10px 10px 10px 13px;
      border:1px solid rgba(255,255,255,.15);
      border-radius:16px;
      background:rgba(18,18,18,.96);
      color:#fff;
      box-shadow:0 18px 50px rgba(0,0,0,.28);
      transform:translateY(150%);
      opacity:0;
      transition:transform .3s ease,opacity .3s ease;
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
    }
    #TjsMystery-{{ section.id }} .tjs-sticky.is-visible { transform:translateY(0); opacity:1; }
    #TjsMystery-{{ section.id }} .tjs-sticky__price { font:400 20px/1 var(--serif); }
    #TjsMystery-{{ section.id }} .tjs-sticky__worth { display:block; margin-top:4px; color:rgba(255,255,255,.62); font-size:9px; }
    #TjsMystery-{{ section.id }} .tjs-sticky button {
      min-height:44px;
      padding:0 15px;
      border:0;
      border-radius:11px;
      background:var(--accent);
      color:#17130a;
      font-size:10px;
      font-weight:900;
      letter-spacing:.08em;
      text-transform:uppercase;
      cursor:pointer;
    }

    @keyframes tjsShake {
      10%,90% { transform:translateX(-2px) rotate(-1deg); }
      20%,80% { transform:translateX(4px) rotate(1deg); }
      30%,50%,70% { transform:translateX(-6px) rotate(-2deg); }
      40%,60% { transform:translateX(6px) rotate(2deg); }
    }

    @media (prefers-reduced-motion:reduce) {
      #TjsMystery-{{ section.id }} *, #TjsMystery-{{ section.id }} *::before, #TjsMystery-{{ section.id }} *::after { animation:none!important; transition:none!important; }
    }

    @media (min-width:750px) {
      #TjsMystery-{{ section.id }} .tjs-shell { padding:18px 18px 110px; }
      #TjsMystery-{{ section.id }} .tjs-media { min-height:330px; max-height:none; }
      #TjsMystery-{{ section.id }} .tjs-box-stage { width:min(46vw,430px); }
      #TjsMystery-{{ section.id }} .tjs-seal { width:82px; height:82px; right:7%; bottom:9%; font-size:8px; }
      #TjsMystery-{{ section.id }} .tjs-buy { padding:26px 24px 22px; }
      #TjsMystery-{{ section.id }} .tjs-reveal-grid { grid-template-columns:repeat(2,1fr); column-gap:34px; }
      #TjsMystery-{{ section.id }} .tjs-steps { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
      #TjsMystery-{{ section.id }} .tjs-step { display:block; }
      #TjsMystery-{{ section.id }} .tjs-step::before { display:block; margin-bottom:25px; }
      #TjsMystery-{{ section.id }} .tjs-sticky { left:50%; right:auto; width:min(620px,calc(100vw - 36px)); transform:translate(-50%,150%); }
      #TjsMystery-{{ section.id }} .tjs-sticky.is-visible { transform:translate(-50%,0); }
    }

    @media (min-width:990px) {
      #TjsMystery-{{ section.id }} .tjs-hero { grid-template-columns:minmax(0,1.16fr) minmax(390px,.84fr); gap:16px; align-items:stretch; }
      #TjsMystery-{{ section.id }} .tjs-media { min-height:600px; border-radius:24px; }
      #TjsMystery-{{ section.id }} .tjs-box-stage { width:min(42vw,560px); transform:none; }
      #TjsMystery-{{ section.id }} .tjs-box { width:94%; height:82%; }
      #TjsMystery-{{ section.id }} .tjs-hero-image { padding:52px; object-fit:contain; }
      #TjsMystery-{{ section.id }} .tjs-buy { border-radius:24px; display:flex; flex-direction:column; justify-content:center; padding:36px 30px; }
      #TjsMystery-{{ section.id }} .tjs-title { font-size:clamp(54px,4.3vw,74px); max-width:10ch; }
      #TjsMystery-{{ section.id }} .tjs-lead { font-size:14px; }
      #TjsMystery-{{ section.id }} .tjs-tier { min-height:144px; }
      #TjsMystery-{{ section.id }} .tjs-section__inner { padding:58px 40px; }
      #TjsMystery-{{ section.id }} .tjs-value-scene { margin-inline:-18px; padding:62px 58px; }
      #TjsMystery-{{ section.id }} .tjs-equation { max-width:900px; grid-template-columns:1fr auto 1fr; gap:28px; }
      #TjsMystery-{{ section.id }} .tjs-shake { padding:72px 40px 78px; }
      #TjsMystery-{{ section.id }} .tjs-shake__box { width:310px; }
    }
  </style>

  <div class="tjs-shell">
    <div class="tjs-hero">
      <div class="tjs-media" aria-label="The June Shop Mystery Box visual">
        <div class="tjs-media__tag">{{ section.settings.media_tag }}</div>
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1400 | image_tag: class: 'tjs-hero-image', loading: 'eager', widths: '360,540,720,960,1200,1400', sizes: '(min-width: 990px) 58vw, 100vw', alt: 'The June Shop Mystery Box' }}
        {% else %}
          <div class="tjs-box-stage" aria-hidden="true"><div class="tjs-box"></div></div>
        {% endif %}
        <div class="tjs-seal">Contents<br>Classified</div>
      </div>

      <div class="tjs-buy" id="TjsBuy-{{ section.id }}">
        <p class="tjs-kicker">{{ section.settings.eyebrow }}</p>
        <h1 class="tjs-title">{{ section.settings.heading }}</h1>
        <p class="tjs-lead">{{ section.settings.subheading }}</p>

        {% assign tjs_form_id = 'TjsProductForm-' | append: section.id %}
        {% form 'product', product, id: tjs_form_id, class: 'tjs-form' %}
          <input type="hidden" name="id" value="{{ initial_variant.id }}" data-variant-id>
          <input type="hidden" name="quantity" value="1">

          <div class="tjs-label"><span>Choose your mystery</span><small>Tap a box to select</small></div>
          <fieldset class="tjs-variants" aria-label="Choose Mystery Box tier">
            <label class="tjs-tier{% if initial_variant.id == variant_1.id %} is-selected{% endif %}">
              <input
                type="radio"
                name="tjs-tier-{{ section.id }}"
                value="{{ variant_1.id }}"
                data-variant-radio
                data-tier="1"
                data-worth="{{ tier_1_value }}"
                data-price-cents="{{ tier_1_price | times: 100 }}"
                data-actual-price-cents="{{ variant_1.price }}"
                data-price-label="₹{{ tier_1_price }}"
                data-saving-amount="{{ tier_1_save }}"
                {% if initial_variant.id == variant_1.id %}checked{% endif %}
                {% unless variant_1.available %}disabled{% endunless %}
              >
              <div class="tjs-tier__eyebrow">Mystery Box</div>
              <div class="tjs-tier__price">₹{{ tier_1_price }}</div>
              <div class="tjs-tier__worth">₹{{ tier_1_value }}+ VALUE</div>
              <div class="tjs-tier__save">Save ₹{{ tier_1_save }}+</div>
            </label>

            {% if variant_2 != blank %}
              <label class="tjs-tier tjs-tier--premium{% if initial_variant.id == variant_2.id %} is-selected{% endif %}">
                <input
                  type="radio"
                  name="tjs-tier-{{ section.id }}"
                  value="{{ variant_2.id }}"
                  data-variant-radio
                  data-tier="2"
                  data-worth="{{ tier_2_value }}"
                  data-price-cents="{{ tier_2_price | times: 100 }}"
                  data-actual-price-cents="{{ variant_2.price }}"
                  data-price-label="₹{{ tier_2_price }}"
                  data-saving-amount="{{ tier_2_save }}"
                  {% if initial_variant.id == variant_2.id %}checked{% endif %}
                  {% unless variant_2.available %}disabled{% endunless %}
                >
                <div class="tjs-tier__eyebrow">Bigger Mystery</div>
                <div class="tjs-tier__price">₹{{ tier_2_price }}</div>
                <div class="tjs-tier__worth">₹{{ tier_2_value }}+ VALUE</div>
                <div class="tjs-tier__save">Save ₹{{ tier_2_save }}+</div>
                <div class="tjs-tier__flag">More value</div>
              </label>
            {% else %}
              <div class="tjs-tier tjs-tier--premium tjs-tier--missing" aria-disabled="true">
                <div class="tjs-tier__eyebrow">Bigger Mystery</div>
                <div class="tjs-tier__price">₹{{ tier_2_price }}</div>
                <div class="tjs-tier__worth">₹{{ tier_2_value }}+ VALUE</div>
                <div class="tjs-tier__save">Save ₹{{ tier_2_save }}+</div>
                <div class="tjs-tier__flag">Setup needed</div>
              </div>
            {% endif %}
          </fieldset>

          <div class="tjs-selected-summary" aria-live="polite">
            <div class="tjs-sum"><span>You pay</span><b data-summary-price>₹{{ tier_1_price }}</b></div>
            <div class="tjs-sum"><span>You get</span><b>₹<span data-summary-worth>{{ tier_1_value }}</span>+</b></div>
            <div class="tjs-sum"><span>You save</span><b>₹<span data-summary-save>{{ tier_1_save }}</span>+</b></div>
          </div>

          <button class="tjs-atc" type="submit" name="add" data-main-atc>Unlock My Box →</button>
        {% endform %}

        <div class="tjs-trust" aria-label="Purchase reassurance">
          <span><i>✓</i> Guaranteed value</span>
          <span><i>✓</i> Genuine TJS</span>
          <span><i>✓</i> Securely packed</span>
          <span><i>✓</i> Limited drop</span>
        </div>

        {% if request.design_mode %}
          {% if variant_2 == blank %}<div class="tjs-config-note">Add a second Shopify variant for the ₹1,999 / ₹5,000+ tier. The card is previewed here but cannot be purchased until that variant exists.</div>{% endif %}
          <div class="tjs-config-note" data-config-note style="display:none"></div>
        {% endif %}
      </div>
    </div>

    <section class="tjs-section">
      <div class="tjs-section__inner">
        <p class="tjs-kicker">What we guarantee</p>
        <h2 class="tjs-h2">Enough certainty. Zero spoilers.</h2>
        <p class="tjs-body">The mystery stays intact, but the value and quality promise do not.</p>
        <div class="tjs-reveal-grid">
          <article class="tjs-reveal-card"><div><b>Worth more than you pay.</b><p>Your box meets or exceeds the guaranteed combined listed value shown for the selected tier.</p></div></article>
          <article class="tjs-reveal-card"><div><b>Genuine June Shop.</b><p>Products come from the world of The June Shop — not anonymous filler created just to bulk up a box.</p></div></article>
          <article class="tjs-reveal-card"><div><b>Actually a mystery.</b><p>No item previews, no picking favourites and no spoilers before the unboxing.</p></div></article>
          <article class="tjs-reveal-card"><div><b>Packed with care.</b><p>Each assortment is selected and securely packed for the reveal at your end.</p></div></article>
        </div>
      </div>
    </section>

    <section class="tjs-section">
      <div class="tjs-value-scene">
        <p class="tjs-kicker">The math isn't the mystery</p>
        <h2 class="tjs-h2">The value is guaranteed. The contents are classified.</h2>
        <div class="tjs-equation">
          <div class="tjs-eq-card">
            <div class="tjs-eq-label">You pay</div>
            <div class="tjs-eq-num" data-eq-price>₹{{ tier_1_price }}</div>
            <div class="tjs-eq-note">Selected Mystery Box tier.</div>
          </div>
          <div class="tjs-eq-arrow">→</div>
          <div class="tjs-eq-card">
            <div class="tjs-eq-label">Guaranteed value</div>
            <div class="tjs-eq-num">₹<span data-eq-worth>{{ tier_1_value }}</span>+</div>
            <div class="tjs-eq-note">Combined listed value inside.</div>
          </div>
        </div>
        <div class="tjs-classified-line">What is actually inside? Still classified.</div>
      </div>
    </section>

    <section class="tjs-section">
      <div class="tjs-shake">
        <p class="tjs-kicker">Think you can guess?</p>
        <h2 class="tjs-h2">Go on. Shake the box.</h2>
        <div class="tjs-shake__box" role="button" tabindex="0" aria-label="Shake the mystery box" data-shake-box></div>
        <div class="tjs-shake__copy" data-shake-copy>Still classified.</div>
        <div class="tjs-shake__hint">Tap the box.</div>
      </div>
    </section>

    <section class="tjs-section">
      <div class="tjs-section__inner">
        <p class="tjs-kicker">Three-step journey</p>
        <h2 class="tjs-h2">Pick it. We pack it. You discover it.</h2>
        <div class="tjs-steps">
          <div class="tjs-step"><div><b>Pick your mystery</b><p>Choose the ₹1,499 or ₹1,999 value tier.</p></div></div>
          <div class="tjs-step"><div><b>We pack the surprise</b><p>Your mystery assortment is selected and securely packed.</p></div></div>
          <div class="tjs-step"><div><b>You do the unboxing</b><p>The reveal happens only when the box reaches you.</p></div></div>
        </div>
      </div>
    </section>

    <section class="tjs-section tjs-faq">
      <div class="tjs-section__inner">
        <p class="tjs-kicker">Before you unlock it</p>
        <h2 class="tjs-h2">The non-spoiler FAQ.</h2>
        <div style="margin-top:18px">
          <details><summary>What's inside my Mystery Box?</summary><div class="tjs-faq__answer">That is the one detail we keep secret. Your box contains an assortment of The June Shop products selected by our team.</div></details>
          <details><summary>Can I choose the products?</summary><div class="tjs-faq__answer">No. Product selection is intentionally not customisable because the surprise is part of the Mystery Box experience.</div></details>
          <details><summary>Will every box have the same products?</summary><div class="tjs-faq__answer">Not necessarily. Assortments may vary across orders and mystery combinations.</div></details>
          <details><summary>Is the stated value guaranteed?</summary><div class="tjs-faq__answer">Yes. The combined listed value of the products packed in your box will meet or exceed the stated Mystery Box value.</div></details>
          <details><summary>Can I order more than one?</summary><div class="tjs-faq__answer">Yes. Because assortments are selected from available Mystery Box combinations, duplicate products across multiple boxes may be possible.</div></details>
          <details><summary>Can I send it as a gift?</summary><div class="tjs-faq__answer">Yes. A Mystery Box works especially well as a surprise gift because the contents stay hidden until it is opened.</div></details>
          <details><summary>What if an item arrives damaged?</summary><div class="tjs-faq__answer">Contact The June Shop customer care with the order details and the required unboxing evidence so the team can review the issue under the applicable policy.</div></details>
        </div>
      </div>
    </section>
  </div>

  <div class="tjs-sticky" data-sticky-bar aria-hidden="true">
    <div>
      <span class="tjs-sticky__price" data-sticky-price>₹{{ tier_1_price }}</span>
      <span class="tjs-sticky__worth">₹<span data-sticky-worth>{{ tier_1_value }}</span>+ inside · Save ₹<span data-sticky-save>{{ tier_1_save }}</span>+</span>
    </div>
    <button type="button" data-sticky-atc>Unlock Box →</button>
  </div>

  <script>
    (() => {
      const root = document.getElementById('TjsMystery-{{ section.id }}');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const form = root.querySelector('#TjsProductForm-{{ section.id }}');
      const variantInput = root.querySelector('[data-variant-id]');
      const radios = [...root.querySelectorAll('[data-variant-radio]')];
      const mainAtc = root.querySelector('[data-main-atc]');
      const sticky = root.querySelector('[data-sticky-bar]');
      const stickyAtc = root.querySelector('[data-sticky-atc]');
      const buyPanel = root.querySelector('#TjsBuy-{{ section.id }}');

      const setVariant = (radio) => {
        if (!radio) return;
        const worth = Number(radio.dataset.worth || 0);
        const targetPriceCents = Number(radio.dataset.priceCents || 0);
        const actualPriceCents = Number(radio.dataset.actualPriceCents || 0);
        const save = Number(radio.dataset.savingAmount || 0);

        variantInput.value = radio.value;
        radios.forEach(r => r.closest('.tjs-tier')?.classList.toggle('is-selected', r === radio));

        root.querySelectorAll('[data-summary-worth],[data-eq-worth],[data-sticky-worth]').forEach(el => el.textContent = worth.toLocaleString('en-IN'));
        root.querySelectorAll('[data-summary-save],[data-sticky-save]').forEach(el => el.textContent = save.toLocaleString('en-IN'));
        root.querySelectorAll('[data-summary-price],[data-eq-price],[data-sticky-price]').forEach(el => el.textContent = radio.dataset.priceLabel);

        if (mainAtc) {
          mainAtc.disabled = radio.disabled;
          mainAtc.textContent = radio.disabled ? 'Sold Out' : 'Unlock My Box →';
        }
        if (stickyAtc) stickyAtc.disabled = radio.disabled;

        const configNote = root.querySelector('[data-config-note]');
        if (configNote) {
          const mismatch = actualPriceCents !== targetPriceCents;
          configNote.style.display = mismatch ? 'block' : 'none';
          if (mismatch) {
            const actual = (actualPriceCents / 100).toLocaleString('en-IN', { style:'currency', currency:'INR', maximumFractionDigits:0 });
            configNote.textContent = `Theme setup: this card is designed as ${radio.dataset.priceLabel}, but the connected Shopify variant is ${actual}. Update the variant price before launch.`;
          }
        }

        try {
          const url = new URL(window.location.href);
          url.searchParams.set('variant', radio.value);
          window.history.replaceState({}, '', url.toString());
        } catch(e) {}
      };

      radios.forEach(radio => radio.addEventListener('change', () => setVariant(radio)));
      setVariant(radios.find(r => r.checked) || radios.find(r => !r.disabled));

      const shakeBox = root.querySelector('[data-shake-box]');
      const shakeCopy = root.querySelector('[data-shake-copy]');
      const lines = ['Nice try.', 'Still classified.', 'Almost gave it away.', 'No spoilers.', "You'll have to open it."];
      let shakeIndex = 0;
      const shake = () => {
        if (!shakeBox) return;
        shakeBox.classList.remove('is-shaking');
        void shakeBox.offsetWidth;
        shakeBox.classList.add('is-shaking');
        shakeIndex = (shakeIndex + 1) % lines.length;
        if (shakeCopy) shakeCopy.textContent = lines[shakeIndex];
      };
      if (shakeBox) {
        shakeBox.addEventListener('click', shake);
        shakeBox.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); shake(); }
        });
      }

      if (sticky && buyPanel) {
        const observer = new IntersectionObserver(entries => {
          const visible = entries[0]?.isIntersecting;
          sticky.classList.toggle('is-visible', !visible);
          sticky.setAttribute('aria-hidden', visible ? 'true' : 'false');
        }, { threshold: .12 });
        observer.observe(buyPanel);
      }

      if (stickyAtc && mainAtc) stickyAtc.addEventListener('click', () => mainAtc.click());
    })();
  </script>
</section>

{% schema %}
{
  "name": "TJS Mystery Box PDP",
  "tag": "section",
  "class": "section-tjs-mystery-box",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The June Shop · Limited Mystery Drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You know the value. Not what's inside." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A specially packed assortment of The June Shop favourites, with the combined value guaranteed to exceed what you pay." },
    { "type": "text", "id": "media_tag", "label": "Media badge", "default": "Contents Classified" },
    { "type": "image_picker", "id": "hero_image", "label": "Mystery Box hero artwork" },
    { "type": "number", "id": "tier_1_price", "label": "Tier 1 selling price", "default": 1499 },
    { "type": "number", "id": "tier_1_value", "label": "Tier 1 guaranteed value", "default": 3000 },
    { "type": "number", "id": "tier_2_price", "label": "Tier 2 selling price", "default": 1999 },
    { "type": "number", "id": "tier_2_value", "label": "Tier 2 guaranteed value", "default": 5000 },
    { "type": "header", "content": "Palette" },
    { "type": "color", "id": "paper_color", "label": "Main background", "default": "#F7F4EE" },
    { "type": "color", "id": "paper_alt_color", "label": "Alternate background", "default": "#F0ECE4" },
    { "type": "color", "id": "ink_color", "label": "Ink", "default": "#1C1A18" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#726C64" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E1C85B" }
  ],
  "presets": [{ "name": "TJS Mystery Box PDP" }]
}
{% endschema %}
