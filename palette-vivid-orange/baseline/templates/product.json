        "custom_liquid": "<style>\n.tjs-live-pulse *{box-sizing:border-box;}\n\n.tjs-live-pulse{\n  width:100%;\n  max-width:100%;\n  margin:12px 0;\n  background:#0d0d0d;\n  border:1.5px solid rgba(255,230,0,.55);\n  border-radius:14px;\n  overflow:hidden;\n  position:relative;\n  font-family:Arial,sans-serif;\n  box-shadow:0 8px 22px rgba(0,0,0,.16);\n}\n\n.tjs-live-pulse::after{\n  content:\"\";\n  position:absolute;\n  inset:0;\n  background:linear-gradient(110deg,transparent 20%,rgba(255,255,255,.12) 45%,transparent 70%);\n  transform:translateX(-120%);\n  animation:tjs-lp-shine 4s ease-in-out infinite;\n  pointer-events:none;\n}\n\n@keyframes tjs-lp-shine{\n  0%,55%{transform:translateX(-120%);}\n  85%,100%{transform:translateX(120%);}\n}\n\n.tjs-lp-inner{\n  position:relative;\n  z-index:2;\n  display:flex;\n  align-items:center;\n  gap:14px;\n  min-height:46px;\n  padding:10px 14px;\n}\n\n.tjs-lp-label{\n  display:flex;\n  align-items:center;\n  gap:7px;\n  flex-shrink:0;\n  color:#ffe600;\n  font-size:11px;\n  font-weight:900;\n  letter-spacing:.13em;\n  text-transform:uppercase;\n}\n\n.tjs-lp-dot{\n  width:8px;\n  height:8px;\n  background:#00cc78;\n  border-radius:50%;\n  box-shadow:0 0 0 rgba(0,204,120,.8);\n  animation:tjs-lp-pulse 1.7s infinite;\n}\n\n@keyframes tjs-lp-pulse{\n  0%{box-shadow:0 0 0 0 rgba(0,204,120,.8);}\n  70%{box-shadow:0 0 0 8px rgba(0,204,120,0);}\n  100%{box-shadow:0 0 0 0 rgba(0,204,120,0);}\n}\n\n.tjs-lp-feed{\n  flex:1;\n  overflow:hidden;\n  position:relative;\n  min-height:22px;\n}\n\n.tjs-lp-track{\n  display:flex;\n  width:max-content;\n  animation:tjs-lp-scroll 24s linear infinite;\n}\n\n.tjs-lp-feed:hover .tjs-lp-track{\n  animation-play-state:paused;\n}\n\n@keyframes tjs-lp-scroll{\n  from{transform:translateX(0);}\n  to{transform:translateX(-50%);}\n}\n\n.tjs-lp-item{\n  display:flex;\n  align-items:center;\n  gap:8px;\n  white-space:nowrap;\n  padding-right:34px;\n  color:#fff;\n  font-size:13px;\n  font-weight:800;\n}\n\n.tjs-lp-item b{\n  color:#ff3cac;\n  font-weight:900;\n}\n\n.tjs-lp-icon{\n  color:#ffe600;\n  font-size:14px;\n}\n\n.tjs-lp-lock{\n  flex-shrink:0;\n  background:#ffe600;\n  color:#0d0d0d;\n  border-radius:999px;\n  padding:7px 11px;\n  font-size:11px;\n  font-weight:950;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n  animation:tjs-lp-pop 2.2s ease-in-out infinite;\n}\n\n@keyframes tjs-lp-pop{\n  0%,100%{transform:scale(1);}\n  50%{transform:scale(1.04);}\n}\n\n/* MOBILE: clean message rotator instead of cramped ticker */\n.tjs-lp-mobile{\n  display:none;\n}\n\n@media(max-width:768px){\n  .tjs-lp-inner{\n    display:none;\n  }\n\n  .tjs-lp-mobile{\n    display:block;\n    position:relative;\n    z-index:2;\n    padding:11px 13px;\n  }\n\n  .tjs-lp-mobile-top{\n    display:flex;\n    align-items:center;\n    gap:7px;\n    color:#ffe600;\n    font-size:10px;\n    font-weight:900;\n    letter-spacing:.13em;\n    text-transform:uppercase;\n    margin-bottom:5px;\n  }\n\n  .tjs-lp-mobile-message{\n    height:19px;\n    overflow:hidden;\n    position:relative;\n    color:#fff;\n    font-size:13px;\n    font-weight:800;\n    line-height:19px;\n  }\n\n  .tjs-lp-mobile-message span{\n    position:absolute;\n    inset:0;\n    opacity:0;\n    transform:translateY(8px);\n    animation:tjs-lp-swap 15s infinite;\n  }\n\n  .tjs-lp-mobile-message span:nth-child(1){animation-delay:0s;}\n  .tjs-lp-mobile-message span:nth-child(2){animation-delay:3s;}\n  .tjs-lp-mobile-message span:nth-child(3){animation-delay:6s;}\n  .tjs-lp-mobile-message span:nth-child(4){animation-delay:9s;}\n  .tjs-lp-mobile-message span:nth-child(5){animation-delay:12s;}\n\n  @keyframes tjs-lp-swap{\n    0%{opacity:0;transform:translateY(8px);}\n    6%{opacity:1;transform:translateY(0);}\n    18%{opacity:1;transform:translateY(0);}\n    25%,100%{opacity:0;transform:translateY(-8px);}\n  }\n}\n</style>\n\n<div class=\"tjs-live-pulse\">\n\n  <div class=\"tjs-lp-inner\">\n    <div class=\"tjs-lp-label\">\n      <span class=\"tjs-lp-dot\"></span>\n      Live Clearance Feed\n    </div>\n\n    <div class=\"tjs-lp-feed\">\n      <div class=\"tjs-lp-track\">\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">🔥</span><b>50% Off</b> auto-applied at checkout</div>\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">🚚</span>Free shipping unlocked on this product</div>\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">⚡</span>Add to cart to lock this deal</div>\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">⏳</span>Once sold out, it may not return</div>\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">💛</span>Clearance price is already active</div>\n\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">🔥</span><b>50% Off</b> auto-applied at checkout</div>\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">🚚</span>Free shipping unlocked on this product</div>\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">⚡</span>Add to cart to claim offer</div>\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">⏳</span>Limited Stock, So hurry </div>\n        <div class=\"tjs-lp-item\"><span class=\"tjs-lp-icon\">💛</span>Clearance price active in your cart</div>\n      </div>\n    </div>\n\n    <div class=\"tjs-lp-lock\">Deal Active</div>\n  </div>\n\n  <div class=\"tjs-lp-mobile\">\n    <div class=\"tjs-lp-mobile-top\">\n      <span class=\"tjs-lp-dot\"></span>\n      Live Clearance Feed\n    </div>\n\n    <div class=\"tjs-lp-mobile-message\">\n      <span>🔥 50% Off auto-applied at checkout</span>\n      <span>🚚 Free shipping unlocked</span>\n      <span>⚡ Add to cart to lock this deal</span>\n      <span>⏳ Limited Stock, so hurry</span>\n      <span>💛 Clearance price active in your cart</span>\n    </div>\n  </div>\n\n</div>",
