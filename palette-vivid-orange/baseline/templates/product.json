            "custom_liquid_Hw4KA3": {
              "type": "_custom-liquid",
              "name": "Custom - Variant",
              "settings": {
                "liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n\n<style>\n  .tjs-variant-picker {\n    margin: 14px 0 16px;\n    font-family: inherit;\n  }\n\n  .tjs-variant-picker * {\n    box-sizing: border-box;\n  }\n\n  .tjs-variant-picker__group {\n    margin-bottom: 14px;\n  }\n\n  .tjs-variant-picker__head {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 12px;\n    margin-bottom: 9px;\n  }\n\n  .tjs-variant-picker__label {\n    color: #241c19;\n    font-size: 12.5px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.15px;\n  }\n\n  .tjs-variant-picker__selected {\n    color: #8f6a5a;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 750;\n  }\n\n  .tjs-variant-picker__options {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n\n  .tjs-variant-picker__btn {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 39px;\n    padding: 10px 15px;\n    border-radius: 999px;\n    border: 1px solid rgba(47, 36, 32, 0.14);\n    background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(255,249,245,0.92));\n    color: #2f2420;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 760;\n    cursor: pointer;\n    font-family: inherit;\n    overflow: hidden;\n    box-shadow:\n      0 6px 14px rgba(47, 36, 32, 0.035),\n      inset 0 1px 0 rgba(255,255,255,0.8);\n    transition:\n      background 0.22s ease,\n      color 0.22s ease,\n      border-color 0.22s ease,\n      box-shadow 0.22s ease,\n      transform 0.22s ease;\n  }\n\n  .tjs-variant-picker__btn::before {\n    content: \"\";\n    position: absolute;\n    top: -90%;\n    left: -70%;\n    width: 28px;\n    height: 280%;\n    background: linear-gradient(110deg, transparent, rgba(255,255,255,0.55), transparent);\n    transform: rotate(18deg);\n    opacity: 0;\n    transition: left 0.65s ease, opacity 0.25s ease;\n    pointer-events: none;\n  }\n\n  .tjs-variant-picker__btn:hover {\n    border-color: rgba(47, 36, 32, 0.34);\n    transform: translateY(-1px);\n    box-shadow:\n      0 9px 18px rgba(47, 36, 32, 0.07),\n      inset 0 1px 0 rgba(255,255,255,0.9);\n  }\n\n  .tjs-variant-picker__btn:hover::before {\n    left: 130%;\n    opacity: 1;\n  }\n\n  .tjs-variant-picker__btn.is-active {\n    background: #241c19;\n    color: #fff;\n    border-color: #241c19;\n    box-shadow: 0 10px 22px rgba(47, 36, 32, 0.18);\n  }\n\n  .tjs-variant-picker__btn.is-active::after {\n    content: \"\";\n    width: 6px;\n    height: 6px;\n    margin-left: 8px;\n    border-radius: 999px;\n    background: #ffe2a4;\n    box-shadow: 0 0 0 4px rgba(255, 226, 164, 0.15);\n  }\n\n  .tjs-variant-picker__btn.is-hidden {\n    display: none !important;\n  }\n\n  .tjs-variant-picker__hint {\n    margin-top: 8px;\n    color: #75645d;\n    font-size: 11px;\n    line-height: 1.35;\n    font-weight: 600;\n  }\n\n  .tjs-variant-picker__hint strong {\n    color: #2f2420;\n    font-weight: 850;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-variant-picker {\n      margin: 13px 0 15px;\n    }\n\n    .tjs-variant-picker__group {\n      margin-bottom: 13px;\n    }\n\n    .tjs-variant-picker__head {\n      margin-bottom: 8px;\n    }\n\n    .tjs-variant-picker__label {\n      font-size: 12px;\n    }\n\n    .tjs-variant-picker__selected {\n      font-size: 10.6px;\n    }\n\n    .tjs-variant-picker__options {\n      gap: 7px;\n    }\n\n    .tjs-variant-picker__btn {\n      min-height: 37px;\n      padding: 9px 13px;\n      font-size: 11.5px;\n    }\n\n    .tjs-variant-picker__hint {\n      font-size: 10.7px;\n      margin-top: 7px;\n    }\n  }\n</style>\n\n{% unless product.has_only_default_variant %}\n  <div class=\"tjs-variant-picker\" data-tjs-variant-picker>\n    {% for option in product.options_with_values %}\n      {% assign option_index = option.position | minus: 1 %}\n\n      <div class=\"tjs-variant-picker__group\" data-option-group data-option-index=\"{{ option_index }}\">\n        <div class=\"tjs-variant-picker__head\">\n          <div class=\"tjs-variant-picker__label\">\n            {{ option.name }}\n          </div>\n\n          <div class=\"tjs-variant-picker__selected\" data-selected-label=\"{{ option_index }}\">\n            {{ current_variant.options[option_index] }}\n          </div>\n        </div>\n\n        <div class=\"tjs-variant-picker__options\">\n          {% for value in option.values %}\n            <button\n              type=\"button\"\n              class=\"tjs-variant-picker__btn {% if current_variant.options[option_index] == value %}is-active{% endif %}\"\n              data-option-button\n              data-option-index=\"{{ option_index }}\"\n              data-option-value=\"{{ value | escape }}\"\n            >\n              {{ value }}\n            </button>\n          {% endfor %}\n        </div>\n      </div>\n    {% endfor %}\n\n <div class=\"tjs-variant-picker__hint\">\n  Selected option qualifies for <strong>free shipping..</strong>\n</div>\n  </div>\n{% endunless %}\n\n<script type=\"application/json\" data-tjs-product-variants>\n  {{ product.variants | json }}\n</script>\n\n<script>\n  (function () {\n    function initTjsVariantPicker() {\n      var picker = document.querySelector(\"[data-tjs-variant-picker]\");\n      var variantsJson = document.querySelector(\"[data-tjs-product-variants]\");\n\n      if (!picker || !variantsJson) return;\n\n      var variants = [];\n\n      try {\n        variants = JSON.parse(variantsJson.textContent);\n      } catch (e) {\n        return;\n      }\n\n      var availableVariants = variants.filter(function (variant) {\n        return variant.available;\n      });\n\n      if (!availableVariants.length) {\n        picker.style.display = \"none\";\n        return;\n      }\n\n      var selectedOptions = availableVariants[0].options.slice();\n\n      picker.querySelectorAll(\"[data-option-button].is-active\").forEach(function (button) {\n        var index = Number(button.getAttribute(\"data-option-index\"));\n        var value = button.getAttribute(\"data-option-value\");\n\n        var activeAvailable = availableVariants.some(function (variant) {\n          return variant.options[index] === value;\n        });\n\n        if (activeAvailable) {\n          selectedOptions[index] = value;\n        }\n      });\n\n      function findVariantByOptions(options) {\n        return availableVariants.find(function (variant) {\n          return variant.options.every(function (optionValue, index) {\n            return options[index] === optionValue;\n          });\n        });\n      }\n\n      function canOptionValueExist(optionIndex, optionValue) {\n        var testOptions = selectedOptions.slice();\n        testOptions[optionIndex] = optionValue;\n\n        return availableVariants.some(function (variant) {\n          return variant.options.every(function (variantOption, index) {\n            return index === optionIndex || !testOptions[index] || testOptions[index] === variantOption;\n          }) && variant.options[optionIndex] === optionValue;\n        });\n      }\n\n      function findFirstAvailableForOption(optionIndex, optionValue) {\n        return availableVariants.find(function (variant) {\n          return variant.options[optionIndex] === optionValue;\n        });\n      }\n\n      function updateSelectedLabels() {\n        selectedOptions.forEach(function (value, index) {\n          var label = picker.querySelector('[data-selected-label=\"' + index + '\"]');\n          if (label) label.textContent = value;\n        });\n      }\n\n      function updateButtons() {\n        picker.querySelectorAll(\"[data-option-button]\").forEach(function (button) {\n          var optionIndex = Number(button.getAttribute(\"data-option-index\"));\n          var optionValue = button.getAttribute(\"data-option-value\");\n          var canExist = canOptionValueExist(optionIndex, optionValue);\n\n          button.classList.toggle(\"is-hidden\", !canExist);\n          button.classList.toggle(\"is-active\", selectedOptions[optionIndex] === optionValue);\n        });\n      }\n\n      function ensureValidVariant() {\n        var variant = findVariantByOptions(selectedOptions);\n\n        if (variant) return variant;\n\n        var fallback = availableVariants[0];\n        selectedOptions = fallback.options.slice();\n        return fallback;\n      }\n\n      function updateHiddenVariantInput(variant) {\n        if (!variant) return;\n\n        document.querySelectorAll('form[action*=\"/cart/add\"]').forEach(function (form) {\n          var idInput = form.querySelector('[name=\"id\"]');\n\n          if (idInput) {\n            idInput.value = variant.id;\n            idInput.dispatchEvent(new Event(\"change\", { bubbles: true }));\n          }\n        });\n      }\n\n      function updateUrl(variant) {\n        if (!variant || !window.history || !window.history.replaceState) return;\n\n        var url = new URL(window.location.href);\n        url.searchParams.set(\"variant\", variant.id);\n        window.history.replaceState({}, \"\", url.toString());\n      }\n\n      function updateAddButtons(variant) {\n        if (!variant) return;\n\n        var submitButtons = document.querySelectorAll(\n          'form[action*=\"/cart/add\"] button[type=\"submit\"], form[action*=\"/cart/add\"] [name=\"add\"], .product-form__submit'\n        );\n\n        submitButtons.forEach(function (button) {\n          button.disabled = !variant.available;\n        });\n      }\n\n      function dispatchVariantChange(variant) {\n        if (!variant) return;\n\n        document.dispatchEvent(new CustomEvent(\"variant:change\", {\n          bubbles: true,\n          detail: {\n            variant: variant\n          }\n        }));\n      }\n\n      function updatePicker() {\n        var variant = ensureValidVariant();\n\n        updateSelectedLabels();\n        updateButtons();\n        updateHiddenVariantInput(variant);\n        updateUrl(variant);\n        updateAddButtons(variant);\n        dispatchVariantChange(variant);\n      }\n\n      picker.addEventListener(\"click\", function (event) {\n        var button = event.target.closest(\"[data-option-button]\");\n        if (!button || button.classList.contains(\"is-hidden\")) return;\n\n        var optionIndex = Number(button.getAttribute(\"data-option-index\"));\n        var optionValue = button.getAttribute(\"data-option-value\");\n\n        selectedOptions[optionIndex] = optionValue;\n\n        var exactVariant = findVariantByOptions(selectedOptions);\n\n        if (!exactVariant) {\n          var fallback = findFirstAvailableForOption(optionIndex, optionValue);\n          if (fallback) selectedOptions = fallback.options.slice();\n        }\n\n        updatePicker();\n      });\n\n      updatePicker();\n    }\n\n    document.addEventListener(\"DOMContentLoaded\", initTjsVariantPicker);\n    document.addEventListener(\"shopify:section:load\", initTjsVariantPicker);\n  })();\n</script>"
