        "custom_liquid": "<style>\n  .tjs-product-tabs {\n    margin: 18px 0 22px;\n    font-family: inherit;\n  }\n\n  .tjs-product-tabs * {\n    box-sizing: border-box;\n  }\n\n  .tjs-product-tabs__shell {\n    width: 100%;\n    max-width: 720px;\n    margin-left: auto;\n    margin-right: auto;\n    border-radius: 18px;\n    background: #fff;\n    border: 1px solid rgba(47, 36, 32, 0.10);\n    box-shadow:\n      0 10px 24px rgba(47, 36, 32, 0.045),\n      inset 0 1px 0 rgba(255,255,255,0.9);\n    overflow: hidden;\n  }\n\n  .tjs-product-tabs__nav {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    padding: 6px;\n    gap: 6px;\n    background: linear-gradient(135deg, #fffaf7, #fff3ec);\n    border-bottom: 1px solid rgba(47, 36, 32, 0.08);\n  }\n\n  .tjs-product-tabs__tab {\n    position: relative;\n    border: 0;\n    background: transparent;\n    min-height: 42px;\n    padding: 0 10px;\n    border-radius: 12px;\n    color: #7a675f;\n    font-family: inherit;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 850;\n    cursor: pointer;\n    transition: all 0.22s ease;\n  }\n\n  .tjs-product-tabs__tab:hover {\n    color: #241c19;\n    background: rgba(255,255,255,0.55);\n  }\n\n  .tjs-product-tabs__tab.is-active {\n    color: #fff;\n    background: #241c19;\n    box-shadow: 0 8px 16px rgba(47, 36, 32, 0.14);\n  }\n\n  .tjs-product-tabs__body {\n    padding: 18px;\n  }\n\n  .tjs-product-tabs__panel {\n    display: none;\n    animation: tjsTabsFade 0.24s ease both;\n  }\n\n  .tjs-product-tabs__panel.is-active {\n    display: block;\n  }\n\n  @keyframes tjsTabsFade {\n    from {\n      opacity: 0;\n      transform: translateY(4px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  .tjs-product-tabs__content {\n    color: #4d403b;\n    font-size: 13px;\n    line-height: 1.65;\n    font-weight: 500;\n  }\n\n  .tjs-product-tabs__content p {\n    margin: 0 0 10px;\n  }\n\n  .tjs-product-tabs__content p:last-child {\n    margin-bottom: 0;\n  }\n\n  .tjs-product-tabs__content ul,\n  .tjs-product-tabs__content ol {\n    margin: 8px 0 0;\n    padding-left: 18px;\n  }\n\n  .tjs-product-tabs__content li {\n    margin-bottom: 6px;\n  }\n\n  .tjs-product-tabs__content strong,\n  .tjs-product-tabs__content b {\n    color: #241c19;\n    font-weight: 850;\n  }\n\n  .tjs-product-tabs__empty {\n    color: #6d5b54;\n    font-size: 13px;\n    line-height: 1.55;\n  }\n\n  .tjs-product-tabs__quick {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 9px;\n    margin-top: 13px;\n  }\n\n  .tjs-product-tabs__mini-card {\n    border-radius: 14px;\n    padding: 11px 12px;\n    background: #fffaf7;\n    border: 1px solid rgba(47, 36, 32, 0.08);\n  }\n\n  .tjs-product-tabs__mini-title {\n    color: #241c19;\n    font-size: 11.5px;\n    line-height: 1.2;\n    font-weight: 900;\n    margin-bottom: 4px;\n  }\n\n  .tjs-product-tabs__mini-text {\n    color: #6d5b54;\n    font-size: 10.8px;\n    line-height: 1.35;\n    font-weight: 600;\n  }\n\n  .tjs-policy-flow {\n    display: grid;\n    gap: 10px;\n  }\n\n  .tjs-policy-item {\n    display: grid;\n    grid-template-columns: 28px 1fr;\n    gap: 10px;\n    align-items: start;\n    padding: 11px;\n    border-radius: 14px;\n    background: #fffaf7;\n    border: 1px solid rgba(47, 36, 32, 0.075);\n  }\n\n  .tjs-policy-icon {\n    width: 28px;\n    height: 28px;\n    border-radius: 999px;\n    display: grid;\n    place-items: center;\n    background: #241c19;\n    color: #fff;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 900;\n  }\n\n  .tjs-policy-copy {\n    color: #4d403b;\n    font-size: 12.4px;\n    line-height: 1.5;\n    font-weight: 550;\n  }\n\n  .tjs-policy-copy strong {\n    display: block;\n    color: #241c19;\n    font-size: 12.8px;\n    font-weight: 900;\n    margin-bottom: 2px;\n  }\n\n  .tjs-product-tabs__note {\n    margin-top: 12px;\n    padding: 11px 12px;\n    border-radius: 14px;\n    background: linear-gradient(135deg, #fffaf4, #fff2e7);\n    border: 1px solid rgba(185, 128, 76, 0.20);\n    color: #6d5b54;\n    font-size: 11px;\n    line-height: 1.45;\n    font-weight: 600;\n  }\n\n  .tjs-product-tabs__note strong {\n    color: #241c19;\n    font-weight: 900;\n  }\n\n  .tjs-policy-highlight {\n    margin-bottom: 12px;\n    padding: 12px;\n    border-radius: 15px;\n    background:\n      radial-gradient(circle at top left, rgba(255, 238, 218, 0.9), transparent 38%),\n      linear-gradient(135deg, #fffaf5, #fff2e8);\n    border: 1px solid rgba(185, 128, 76, 0.18);\n  }\n\n  .tjs-policy-highlight__title {\n    color: #241c19;\n    font-size: 12.5px;\n    line-height: 1.25;\n    font-weight: 900;\n    margin-bottom: 4px;\n  }\n\n  .tjs-policy-highlight__text {\n    color: #6d5b54;\n    font-size: 11.2px;\n    line-height: 1.45;\n    font-weight: 600;\n  }\n\n  .tjs-policy-taglist {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    margin-top: 10px;\n  }\n\n  .tjs-policy-tag {\n    display: inline-flex;\n    align-items: center;\n    padding: 6px 8px;\n    border-radius: 999px;\n    background: #fff;\n    border: 1px solid rgba(47, 36, 32, 0.10);\n    color: #5f514c;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 750;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-product-tabs {\n      margin: 16px 0 20px;\n    }\n\n    .tjs-product-tabs__shell {\n      max-width: 100%;\n      margin-left: auto;\n      margin-right: auto;\n      border-radius: 18px;\n      background: linear-gradient(180deg, #ffffff, #fffaf7);\n      box-shadow: 0 8px 20px rgba(47, 36, 32, 0.045);\n      border: 1px solid rgba(47, 36, 32, 0.09);\n    }\n\n    .tjs-product-tabs__nav {\n      display: none;\n    }\n\n    .tjs-product-tabs__body {\n      padding: 6px;\n    }\n\n    .tjs-product-tabs__panel {\n      display: block;\n      border-bottom: 0;\n      animation: none;\n      margin-bottom: 6px;\n      border-radius: 14px;\n      background: #fff;\n      overflow: hidden;\n      border: 1px solid rgba(47, 36, 32, 0.07);\n    }\n\n    .tjs-product-tabs__panel:last-child {\n      margin-bottom: 0;\n    }\n\n    .tjs-product-tabs__mobile-head {\n      width: 100%;\n      min-height: 50px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 12px;\n      padding: 0 14px;\n      border: 0;\n      background: #fff;\n      color: #241c19;\n      font-family: inherit;\n      font-size: 12.5px;\n      line-height: 1;\n      font-weight: 900;\n      cursor: pointer;\n      letter-spacing: 0.1px;\n    }\n\n    .tjs-product-tabs__mobile-head::after {\n      content: \"+\";\n      width: 24px;\n      height: 24px;\n      border-radius: 999px;\n      display: grid;\n      place-items: center;\n      background: #fff2e7;\n      color: #8f5645;\n      font-size: 17px;\n      line-height: 1;\n      font-weight: 500;\n      transition: transform 0.22s ease, background 0.22s ease, color 0.22s ease;\n    }\n\n    .tjs-product-tabs__panel.is-mobile-open {\n      background: linear-gradient(180deg, #fff, #fffaf7);\n      border-color: rgba(185, 128, 76, 0.18);\n      box-shadow: 0 8px 18px rgba(47, 36, 32, 0.04);\n    }\n\n    .tjs-product-tabs__panel.is-mobile-open .tjs-product-tabs__mobile-head::after {\n      content: \"−\";\n      background: #241c19;\n      color: #fff;\n    }\n\n    .tjs-product-tabs__mobile-content {\n      display: none;\n      padding: 0 13px 14px;\n    }\n\n    .tjs-product-tabs__panel.is-mobile-open .tjs-product-tabs__mobile-content {\n      display: block;\n      animation: tjsTabsFade 0.22s ease both;\n    }\n\n    .tjs-product-tabs__content {\n      font-size: 12.5px;\n      line-height: 1.6;\n    }\n\n    .tjs-product-tabs__quick {\n      grid-template-columns: 1fr;\n      gap: 8px;\n      margin-top: 11px;\n    }\n\n    .tjs-product-tabs__mini-card {\n      padding: 10px 11px;\n      border-radius: 13px;\n    }\n\n    .tjs-policy-item {\n      grid-template-columns: 26px 1fr;\n      padding: 10px;\n      gap: 9px;\n      border-radius: 13px;\n      background: #fff;\n    }\n\n    .tjs-policy-icon {\n      width: 26px;\n      height: 26px;\n      font-size: 10px;\n    }\n\n    .tjs-policy-copy {\n      font-size: 11.8px;\n      line-height: 1.45;\n    }\n\n    .tjs-policy-copy strong {\n      font-size: 12.2px;\n    }\n\n    .tjs-product-tabs__note {\n      font-size: 10.7px;\n      padding: 10px;\n      border-radius: 13px;\n    }\n\n    .tjs-policy-highlight {\n      padding: 11px;\n      border-radius: 14px;\n    }\n\n    .tjs-policy-highlight__title {\n      font-size: 12.2px;\n    }\n\n    .tjs-policy-highlight__text {\n      font-size: 10.8px;\n    }\n\n    .tjs-policy-taglist {\n      gap: 5px;\n    }\n\n    .tjs-policy-tag {\n      font-size: 9.7px;\n      padding: 6px 8px;\n    }\n  }\n\n  @media screen and (min-width: 750px) {\n    .tjs-product-tabs__mobile-head {\n      display: none;\n    }\n\n    .tjs-product-tabs__mobile-content {\n      display: block;\n    }\n  }\n</style>\n\n<div class=\"tjs-product-tabs\" data-tjs-product-tabs>\n  <div class=\"tjs-product-tabs__shell\">\n    <div class=\"tjs-product-tabs__nav\" role=\"tablist\">\n      <button type=\"button\" class=\"tjs-product-tabs__tab is-active\" data-tjs-tab-button data-tab=\"description\">\n        Description\n      </button>\n      <button type=\"button\" class=\"tjs-product-tabs__tab\" data-tjs-tab-button data-tab=\"refund\">\n        Refund Policy\n      </button>\n      <button type=\"button\" class=\"tjs-product-tabs__tab\" data-tjs-tab-button data-tab=\"returns\">\n        Returns\n      </button>\n    </div>\n\n    <div class=\"tjs-product-tabs__body\">\n      <div class=\"tjs-product-tabs__panel is-active is-mobile-open\" data-tjs-tab-panel data-panel=\"description\">\n        <button type=\"button\" class=\"tjs-product-tabs__mobile-head\" data-tjs-mobile-tab>\n          Description\n        </button>\n\n        <div class=\"tjs-product-tabs__mobile-content\">\n          <div class=\"tjs-product-tabs__content\">\n            {% if product.description != blank %}\n              {{ product.description }}\n            {% else %}\n              <div class=\"tjs-product-tabs__empty\">\n                Thoughtfully chosen for everyday use, gifting, styling and beautiful spaces.\n              </div>\n            {% endif %}\n          </div>\n\n          <div class=\"tjs-product-tabs__quick\">\n            <div class=\"tjs-product-tabs__mini-card\">\n              <div class=\"tjs-product-tabs__mini-title\">Free Shipping</div>\n              <div class=\"tjs-product-tabs__mini-text\">Eligible orders ship free during the ongoing sale.</div>\n            </div>\n\n            <div class=\"tjs-product-tabs__mini-card\">\n              <div class=\"tjs-product-tabs__mini-title\">Secure Checkout</div>\n              <div class=\"tjs-product-tabs__mini-text\">Your order is processed through a safe checkout flow.</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"tjs-product-tabs__panel\" data-tjs-tab-panel data-panel=\"refund\">\n        <button type=\"button\" class=\"tjs-product-tabs__mobile-head\" data-tjs-mobile-tab>\n          Refund Policy\n        </button>\n\n        <div class=\"tjs-product-tabs__mobile-content\">\n          <div class=\"tjs-policy-highlight\">\n            <div class=\"tjs-policy-highlight__title\">Refunds are generally issued as store credit.</div>\n            <div class=\"tjs-policy-highlight__text\">\n              Once an approved return is picked up, checked and cleared by our team, store credit is issued for the eligible item value. COD charges, if any, are not refundable.\n            </div>\n          </div>\n\n          <div class=\"tjs-policy-flow\">\n            <div class=\"tjs-policy-item\">\n              <div class=\"tjs-policy-icon\">1</div>\n              <div class=\"tjs-policy-copy\">\n                <strong>Damaged item? Inform us quickly.</strong>\n                If your order arrives damaged, share clear photos/videos of the product and box within 2 days/48 hours of delivery so our team can assist with replacement or store credit.\n              </div>\n            </div>\n\n            <div class=\"tjs-policy-item\">\n              <div class=\"tjs-policy-icon\">2</div>\n              <div class=\"tjs-policy-copy\">\n                <strong>Return requests need approval.</strong>\n                Return requests must be raised within 2 days of delivery. Our support team reviews every request before approving the next step.\n              </div>\n            </div>\n\n            <div class=\"tjs-policy-item\">\n              <div class=\"tjs-policy-icon\">3</div>\n              <div class=\"tjs-policy-copy\">\n                <strong>Returned items must pass quality check.</strong>\n                Products should be unused, in original condition and packed properly with original packaging, tags and invoice wherever applicable.\n              </div>\n            </div>\n          </div>\n\n          <div class=\"tjs-product-tabs__note\">\n            <strong>Important:</strong> Ceramic, resin, sunglasses/eyewear, carpets, clothing, baby products, ZenStone mats, face masks, glass items and customised products may not be refundable as per store policy.\n          </div>\n        </div>\n      </div>\n\n      <div class=\"tjs-product-tabs__panel\" data-tjs-tab-panel data-panel=\"returns\">\n        <button type=\"button\" class=\"tjs-product-tabs__mobile-head\" data-tjs-mobile-tab>\n          Returns\n        </button>\n\n        <div class=\"tjs-product-tabs__mobile-content\">\n          <div class=\"tjs-policy-highlight\">\n            <div class=\"tjs-policy-highlight__title\">Simple return flow, subject to approval.</div>\n            <div class=\"tjs-policy-highlight__text\">\n              If eligible, we arrange reverse pickup without an additional reverse pickup charge. Once received and checked, eligible value is issued as store credit.\n            </div>\n          </div>\n\n          <div class=\"tjs-policy-flow\">\n            <div class=\"tjs-policy-item\">\n              <div class=\"tjs-policy-icon\">01</div>\n              <div class=\"tjs-policy-copy\">\n                <strong>Raise your request within 2 days.</strong>\n                Email or WhatsApp our support team with your order details, product images and reason for return.\n              </div>\n            </div>\n\n            <div class=\"tjs-policy-item\">\n              <div class=\"tjs-policy-icon\">02</div>\n              <div class=\"tjs-policy-copy\">\n                <strong>Pack the item securely.</strong>\n                Poor return packaging can damage the item in transit, which may affect replacement or store-credit approval.\n              </div>\n            </div>\n\n            <div class=\"tjs-policy-item\">\n              <div class=\"tjs-policy-icon\">03</div>\n              <div class=\"tjs-policy-copy\">\n                <strong>Receive store credit after QC.</strong>\n                Once your return clears quality checks, store credit is issued and can be used on your next purchase as per policy.\n              </div>\n            </div>\n          </div>\n\n          <div class=\"tjs-policy-taglist\">\n            <span class=\"tjs-policy-tag\">Request within 2 days</span>\n            <span class=\"tjs-policy-tag\">Approval required</span>\n            <span class=\"tjs-policy-tag\">Original packaging needed</span>\n            <span class=\"tjs-policy-tag\">Store credit after QC</span>\n          </div>\n\n          <div class=\"tjs-product-tabs__note\">\n            Orders cannot be cancelled or altered after 12 hours of placing the order. Once packed or shipped, cancellation may be treated as a return as per store policy.\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    function initTjsProductTabs() {\n      var section = document.querySelector(\"[data-tjs-product-tabs]\");\n      if (!section) return;\n\n      var buttons = section.querySelectorAll(\"[data-tjs-tab-button]\");\n      var panels = section.querySelectorAll(\"[data-tjs-tab-panel]\");\n      var mobileHeads = section.querySelectorAll(\"[data-tjs-mobile-tab]\");\n\n      buttons.forEach(function (button) {\n        button.addEventListener(\"click\", function () {\n          var target = button.getAttribute(\"data-tab\");\n\n          buttons.forEach(function (btn) {\n            btn.classList.toggle(\"is-active\", btn === button);\n          });\n\n          panels.forEach(function (panel) {\n            panel.classList.toggle(\"is-active\", panel.getAttribute(\"data-panel\") === target);\n          });\n        });\n      });\n\n      mobileHeads.forEach(function (head) {\n        head.addEventListener(\"click\", function () {\n          var panel = head.closest(\"[data-tjs-tab-panel]\");\n          if (!panel) return;\n\n          panels.forEach(function (item) {\n            if (item !== panel) item.classList.remove(\"is-mobile-open\");\n          });\n\n          panel.classList.toggle(\"is-mobile-open\");\n        });\n      });\n    }\n\n    document.addEventListener(\"DOMContentLoaded\", initTjsProductTabs);\n    document.addEventListener(\"shopify:section:load\", initTjsProductTabs);\n  })();\n</script>",
