                "liquid": "{% assign tjs_whatsapp_number = '917003079822' %}\n{% assign tjs_whatsapp_message = 'Hi The June Shop, I need help with this product: ' | append: product.title | append: ' - ' | append: shop.url | append: product.url %}\n\n<style>\n  .tjs-wa-assist {\n    margin: 10px 0 18px;\n    font-family: inherit;\n  }\n\n  .tjs-wa-assist * {\n    box-sizing: border-box;\n  }\n\n  .tjs-wa-assist__card {\n    position: relative;\n    display: grid;\n    grid-template-columns: 40px 1fr auto;\n    align-items: center;\n    gap: 12px;\n    width: 100%;\n    max-width: 520px;\n    padding: 13px;\n    border-radius: 17px;\n    text-decoration: none;\n    color: #241c19;\n    background:\n      radial-gradient(circle at 8% 0%, rgba(37, 211, 102, 0.13), transparent 34%),\n      linear-gradient(135deg, #ffffff 0%, #fbfffc 100%);\n    border: 1px solid rgba(47, 36, 32, 0.10);\n    box-shadow:\n      0 10px 22px rgba(47, 36, 32, 0.055),\n      inset 0 1px 0 rgba(255,255,255,0.9);\n    overflow: hidden;\n    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;\n  }\n\n  .tjs-wa-assist__card:hover {\n    transform: translateY(-1px);\n    border-color: rgba(37, 211, 102, 0.28);\n    box-shadow:\n      0 15px 30px rgba(47, 36, 32, 0.085),\n      inset 0 1px 0 rgba(255,255,255,0.95);\n  }\n\n  .tjs-wa-assist__icon {\n    width: 40px;\n    height: 40px;\n    border-radius: 999px;\n    display: grid;\n    place-items: center;\n    background: #25d366;\n    color: #fff;\n    box-shadow:\n      0 9px 18px rgba(37, 211, 102, 0.24),\n      inset 0 1px 0 rgba(255,255,255,0.32);\n  }\n\n  .tjs-wa-assist__icon svg {\n    width: 21px;\n    height: 21px;\n    fill: currentColor;\n  }\n\n  .tjs-wa-assist__content {\n    min-width: 0;\n  }\n\n  .tjs-wa-assist__top {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    flex-wrap: wrap;\n  }\n\n  .tjs-wa-assist__title {\n    color: #241c19;\n    font-size: 13.2px;\n    line-height: 1.2;\n    font-weight: 900;\n    letter-spacing: -0.1px;\n  }\n\n  .tjs-wa-assist__live {\n    display: none;\n    align-items: center;\n    gap: 4px;\n    padding: 4px 7px;\n    border-radius: 999px;\n    background: rgba(37, 211, 102, 0.11);\n    color: #147c3b;\n    font-size: 9px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.45px;\n    text-transform: uppercase;\n  }\n\n  .tjs-wa-assist.is-live .tjs-wa-assist__live {\n    display: inline-flex;\n  }\n\n  .tjs-wa-assist__live::before {\n    content: \"\";\n    width: 5px;\n    height: 5px;\n    border-radius: 999px;\n    background: #25d366;\n    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.45);\n    animation: tjsWaPulse 1.8s ease-in-out infinite;\n  }\n\n  @keyframes tjsWaPulse {\n    0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.45); }\n    70% { box-shadow: 0 0 0 7px rgba(37, 211, 102, 0); }\n    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }\n  }\n\n  .tjs-wa-assist__text {\n    margin-top: 4px;\n    color: #6b5c56;\n    font-size: 11.1px;\n    line-height: 1.35;\n    font-weight: 600;\n  }\n\n  .tjs-wa-assist__cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 33px;\n    padding: 8px 12px;\n    border-radius: 999px;\n    background: #241c19;\n    color: #fff;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.35px;\n    text-transform: uppercase;\n    white-space: nowrap;\n    box-shadow: 0 8px 16px rgba(47, 36, 32, 0.14);\n  }\n\n  .tjs-wa-assist__cta span {\n    transition: transform 0.2s ease;\n  }\n\n  .tjs-wa-assist__card:hover .tjs-wa-assist__cta span {\n    transform: translateX(2px);\n  }\n\n  .tjs-wa-assist__trust {\n    max-width: 520px;\n    margin-top: 7px;\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    color: #75645d;\n    font-size: 10.5px;\n    line-height: 1.3;\n    font-weight: 650;\n  }\n\n  .tjs-wa-assist__trust::before {\n    content: \"\";\n    width: 5px;\n    height: 5px;\n    border-radius: 999px;\n    background: #9a7a67;\n    box-shadow: 0 0 0 4px rgba(154, 122, 103, 0.10);\n    flex: 0 0 auto;\n  }\n\n  .tjs-wa-assist__trust strong {\n    color: #2f2420;\n    font-weight: 850;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-wa-assist {\n      margin: 9px 0 16px;\n    }\n\n    .tjs-wa-assist__card {\n      grid-template-columns: 38px 1fr;\n      gap: 10px;\n      padding: 12px;\n      border-radius: 16px;\n      max-width: 100%;\n    }\n\n    .tjs-wa-assist__icon {\n      width: 38px;\n      height: 38px;\n    }\n\n    .tjs-wa-assist__title {\n      font-size: 12.7px;\n    }\n\n    .tjs-wa-assist__text {\n      font-size: 10.7px;\n    }\n\n    .tjs-wa-assist__cta {\n      grid-column: 1 / -1;\n      width: 100%;\n      min-height: 35px;\n      margin-top: 1px;\n      font-size: 9.7px;\n    }\n\n    .tjs-wa-assist__trust {\n      max-width: 100%;\n      font-size: 10.2px;\n    }\n  }\n</style>\n\n<div class=\"tjs-wa-assist\" data-tjs-wa-assist>\n  <a\n    class=\"tjs-wa-assist__card\"\n    href=\"https://wa.me/{{ tjs_whatsapp_number }}?text={{ tjs_whatsapp_message | url_encode }}\"\n    target=\"_blank\"\n    rel=\"noopener\"\n  >\n    <div class=\"tjs-wa-assist__icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 32 32\">\n        <path d=\"M16.01 3.2c-7.03 0-12.75 5.66-12.75 12.62 0 2.22.59 4.39 1.7 6.29L3.2 28.8l6.88-1.78a12.84 12.84 0 0 0 5.93 1.47c7.03 0 12.75-5.66 12.75-12.62S23.04 3.2 16.01 3.2Zm0 22.97c-1.93 0-3.81-.53-5.45-1.54l-.39-.24-4.08 1.06 1.09-3.95-.26-.41a10.21 10.21 0 0 1-1.57-5.27c0-5.68 4.67-10.3 10.41-10.3s10.41 4.62 10.41 10.3-4.67 10.35-10.16 10.35Zm5.72-7.72c-.31-.16-1.83-.9-2.12-1-.28-.1-.49-.16-.7.16-.2.31-.8 1-.98 1.2-.18.21-.36.23-.67.08-.31-.16-1.31-.48-2.5-1.53-.92-.82-1.55-1.83-1.73-2.14-.18-.31-.02-.48.14-.63.14-.14.31-.36.47-.54.16-.18.21-.31.31-.52.1-.21.05-.39-.03-.54-.08-.16-.7-1.69-.96-2.31-.25-.6-.51-.52-.7-.53h-.59c-.21 0-.54.08-.83.39-.28.31-1.09 1.07-1.09 2.6s1.12 3.02 1.27 3.23c.16.21 2.2 3.36 5.33 4.71.75.32 1.33.51 1.78.65.75.24 1.43.21 1.97.13.6-.09 1.83-.75 2.09-1.47.26-.72.26-1.34.18-1.47-.08-.13-.28-.21-.59-.36Z\"/>\n      </svg>\n    </div>\n\n    <div class=\"tjs-wa-assist__content\">\n      <div class=\"tjs-wa-assist__top\">\n        <div class=\"tjs-wa-assist__title\" data-tjs-wa-title>\n          Need quick help before you order?\n        </div>\n        <div class=\"tjs-wa-assist__live\" data-tjs-wa-live>\n          Live\n        </div>\n      </div>\n\n      <div class=\"tjs-wa-assist__text\" data-tjs-wa-text>\n        Ask us about product details, delivery timelines, offers or bulk gifting.\n      </div>\n    </div>\n\n    <div class=\"tjs-wa-assist__cta\">\n      <span data-tjs-wa-cta>Chat On WhatsApp →</span>\n    </div>\n  </a>\n\n  <div class=\"tjs-wa-assist__trust\" data-tjs-wa-trust>\n    Faster help for <strong>order questions, delivery doubts and offer support.</strong>\n  </div>\n</div>\n\n<script>\n  (function () {\n    function initTjsWhatsAppAssist() {\n      var section = document.querySelector(\"[data-tjs-wa-assist]\");\n      if (!section) return;\n\n      var title = section.querySelector(\"[data-tjs-wa-title]\");\n      var text = section.querySelector(\"[data-tjs-wa-text]\");\n      var cta = section.querySelector(\"[data-tjs-wa-cta]\");\n      var trust = section.querySelector(\"[data-tjs-wa-trust]\");\n\n      function getISTHour() {\n        var parts = new Intl.DateTimeFormat(\"en-IN\", {\n          timeZone: \"Asia/Kolkata\",\n          hour: \"numeric\",\n          hour12: false\n        }).formatToParts(new Date());\n\n        var hourPart = parts.find(function (part) {\n          return part.type === \"hour\";\n        });\n\n        return hourPart ? Number(hourPart.value) : new Date().getHours();\n      }\n\n      var hour = getISTHour();\n      var isLive = hour >= 9 && hour < 18;\n\n      section.classList.toggle(\"is-live\", isLive);\n\n      if (isLive) {\n        if (title) title.textContent = \"Need quick help before you order?\";\n        if (text) text.textContent = \"Chat with us for product details, delivery timelines, offers or bulk gifting.\";\n        if (cta) cta.textContent = \"Chat On WhatsApp →\";\n        if (trust) trust.innerHTML = \"Usually replies faster during <strong>9 AM–6 PM.</strong>\";\n      } else {\n        if (title) title.textContent = \"Need help with this product?\";\n        if (text) text.textContent = \"Leave us a WhatsApp message and our team will get back during working hours.\";\n        if (cta) cta.textContent = \"Message Us →\";\n        if (trust) trust.innerHTML = \"Support hours: <strong>9 AM–6 PM.</strong> You can still message us anytime.\";\n      }\n    }\n\n    document.addEventListener(\"DOMContentLoaded\", initTjsWhatsAppAssist);\n    document.addEventListener(\"shopify:section:load\", initTjsWhatsAppAssist);\n  })();\n</script>"
