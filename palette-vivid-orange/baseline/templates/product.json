              "settings": {
                "liquid": "<style>\n  .tjs-qty-selector {\n    margin: 14px 0 17px;\n    font-family: inherit;\n  }\n\n  .tjs-qty-selector * {\n    box-sizing: border-box;\n  }\n\n  .tjs-qty-selector__head {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    margin-bottom: 9px;\n  }\n\n  .tjs-qty-selector__label {\n    color: #241c19;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.25px;\n  }\n\n  .tjs-qty-selector__note {\n    color: #8f6a5a;\n    font-size: 10.8px;\n    line-height: 1;\n    font-weight: 750;\n  }\n\n  .tjs-qty-selector__box {\n    display: inline-flex;\n    align-items: center;\n    height: 42px;\n    border-radius: 14px;\n    background: #fff;\n    border: 1px solid rgba(47, 36, 32, 0.13);\n    box-shadow: 0 7px 16px rgba(47, 36, 32, 0.045);\n    overflow: hidden;\n  }\n\n  .tjs-qty-selector__btn {\n    width: 42px;\n    height: 42px;\n    border: 0;\n    background: transparent;\n    color: #241c19;\n    font-size: 18px;\n    line-height: 1;\n    font-weight: 700;\n    cursor: pointer;\n    font-family: inherit;\n    transition: background 0.2s ease, color 0.2s ease;\n  }\n\n  .tjs-qty-selector__btn:hover {\n    background: #f7eee8;\n  }\n\n  .tjs-qty-selector__input {\n    width: 48px;\n    height: 42px;\n    border: 0;\n    border-left: 1px solid rgba(47, 36, 32, 0.10);\n    border-right: 1px solid rgba(47, 36, 32, 0.10);\n    background: #fffaf7;\n    color: #241c19;\n    text-align: center;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 850;\n    font-family: inherit;\n    -moz-appearance: textfield;\n  }\n\n  .tjs-qty-selector__input::-webkit-outer-spin-button,\n  .tjs-qty-selector__input::-webkit-inner-spin-button {\n    -webkit-appearance: none;\n    margin: 0;\n  }\n\n  .tjs-qty-selector__hint {\n    margin-top: 8px;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    color: #75645d;\n    font-size: 10.8px;\n    line-height: 1.35;\n    font-weight: 650;\n  }\n\n  .tjs-qty-selector__hint::before {\n    content: \"\";\n    width: 5px;\n    height: 5px;\n    border-radius: 999px;\n    background: #9a7a67;\n    box-shadow: 0 0 0 4px rgba(154, 122, 103, 0.10);\n  }\n\n  .tjs-qty-selector__hint strong {\n    color: #2f2420;\n    font-weight: 850;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-qty-selector {\n      margin: 13px 0 16px;\n    }\n\n    .tjs-qty-selector__head {\n      margin-bottom: 8px;\n    }\n\n    .tjs-qty-selector__label {\n      font-size: 11.8px;\n    }\n\n    .tjs-qty-selector__note {\n      font-size: 10.5px;\n    }\n\n    .tjs-qty-selector__box {\n      height: 40px;\n      border-radius: 13px;\n    }\n\n    .tjs-qty-selector__btn {\n      width: 40px;\n      height: 40px;\n      font-size: 17px;\n    }\n\n    .tjs-qty-selector__input {\n      width: 46px;\n      height: 40px;\n      font-size: 12.5px;\n    }\n\n    .tjs-qty-selector__hint {\n      font-size: 10.4px;\n      margin-top: 7px;\n    }\n  }\n</style>\n\n<div class=\"tjs-qty-selector\" data-tjs-qty-selector>\n  <div class=\"tjs-qty-selector__head\">\n    <div class=\"tjs-qty-selector__label\">\n      Quantity\n    </div>\n\n  </div>\n\n  <div class=\"tjs-qty-selector__box\">\n    <button type=\"button\" class=\"tjs-qty-selector__btn\" data-tjs-qty-minus aria-label=\"Decrease quantity\">\n      −\n    </button>\n\n    <input\n      type=\"number\"\n      class=\"tjs-qty-selector__input\"\n      value=\"1\"\n      min=\"1\"\n      inputmode=\"numeric\"\n      data-tjs-qty-input\n      aria-label=\"Quantity\"\n    >\n\n    <button type=\"button\" class=\"tjs-qty-selector__btn\" data-tjs-qty-plus aria-label=\"Increase quantity\">\n      +\n    </button>\n  </div>\n\n\n</div>\n\n<script>\n  (function () {\n    function initTjsQtySelector() {\n      var selector = document.querySelector(\"[data-tjs-qty-selector]\");\n      if (!selector) return;\n\n      var input = selector.querySelector(\"[data-tjs-qty-input]\");\n      var minus = selector.querySelector(\"[data-tjs-qty-minus]\");\n      var plus = selector.querySelector(\"[data-tjs-qty-plus]\");\n\n      if (!input || !minus || !plus) return;\n\n      function getThemeQuantityInputs() {\n        return document.querySelectorAll('form[action*=\"/cart/add\"] [name=\"quantity\"]');\n      }\n\n      function syncThemeQuantity(value) {\n        getThemeQuantityInputs().forEach(function (themeInput) {\n          themeInput.value = value;\n          themeInput.dispatchEvent(new Event(\"change\", { bubbles: true }));\n          themeInput.dispatchEvent(new Event(\"input\", { bubbles: true }));\n        });\n      }\n\n      function cleanValue(value) {\n        var number = parseInt(value, 10);\n        if (isNaN(number) || number < 1) number = 1;\n        return number;\n      }\n\n      function setQty(value) {\n        var finalValue = cleanValue(value);\n        input.value = finalValue;\n        syncThemeQuantity(finalValue);\n        minus.disabled = finalValue <= 1;\n      }\n\n      minus.addEventListener(\"click\", function () {\n        setQty(cleanValue(input.value) - 1);\n      });\n\n      plus.addEventListener(\"click\", function () {\n        setQty(cleanValue(input.value) + 1);\n      });\n\n      input.addEventListener(\"change\", function () {\n        setQty(input.value);\n      });\n\n      input.addEventListener(\"input\", function () {\n        setQty(input.value);\n      });\n\n      setQty(input.value);\n    }\n\n    document.addEventListener(\"DOMContentLoaded\", initTjsQtySelector);\n    document.addEventListener(\"shopify:section:load\", initTjsQtySelector);\n  })();\n</script>"
