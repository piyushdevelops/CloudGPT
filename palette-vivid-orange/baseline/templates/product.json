              "type": "_custom-liquid",
              "name": "Custom liquid",
              "settings": {
                "liquid": "<style>\n  .tjs-atc-row {\n    margin: 15px 0 16px;\n    font-family: inherit;\n  }\n\n  .tjs-atc-row * {\n    box-sizing: border-box;\n  }\n\n  .tjs-atc-row__wrap {\n    display: grid;\n    grid-template-columns: 1fr 54px;\n    gap: 10px;\n    width: 100%;\n    max-width: 520px;\n  }\n\n  .tjs-atc-row__button,\n  .tjs-atc-row__wishlist {\n    border: 0;\n    cursor: pointer;\n    font-family: inherit;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .tjs-atc-row__button {\n    position: relative;\n    min-height: 54px;\n    border-radius: 16px;\n    background: #241c19;\n    color: #fff;\n    overflow: hidden;\n    box-shadow: 0 14px 28px rgba(47, 36, 32, 0.20);\n    transition: transform 0.22s ease, box-shadow 0.22s ease, opacity 0.22s ease;\n  }\n\n  .tjs-atc-row__button::before {\n    content: \"\";\n    position: absolute;\n    inset: 1px;\n    border-radius: 15px;\n    border: 1px solid rgba(255, 255, 255, 0.12);\n    pointer-events: none;\n  }\n\n  .tjs-atc-row__button::after {\n    content: \"\";\n    position: absolute;\n    top: -90%;\n    left: -55%;\n    width: 46px;\n    height: 290%;\n    background: linear-gradient(110deg, transparent, rgba(255,255,255,0.42), transparent);\n    transform: rotate(18deg);\n    animation: tjsAtcShine 4.4s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsAtcShine {\n    0%, 48% {\n      left: -55%;\n      opacity: 0;\n    }\n    60% {\n      opacity: 1;\n    }\n    84%, 100% {\n      left: 130%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-atc-row__button:hover {\n    transform: translateY(-1px);\n    box-shadow: 0 18px 34px rgba(47, 36, 32, 0.24);\n  }\n\n  .tjs-atc-row__button.is-loading {\n    opacity: 0.72;\n    pointer-events: none;\n  }\n\n  .tjs-atc-row__button-inner {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 0 16px;\n    min-height: 54px;\n  }\n\n  .tjs-atc-row__button-text {\n    font-size: 14px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.35px;\n    text-transform: uppercase;\n  }\n\n  .tjs-atc-row__button-icon {\n    display: inline-grid;\n    place-items: center;\n    width: 23px;\n    height: 23px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.13);\n    color: #ffe2a4;\n    font-size: 15px;\n    line-height: 1;\n  }\n\n  .tjs-atc-row__wishlist {\n    position: relative;\n    min-height: 54px;\n    border-radius: 16px;\n    background: #fff;\n    color: #241c19;\n    border: 1px solid rgba(47, 36, 32, 0.14);\n    box-shadow: 0 10px 22px rgba(47, 36, 32, 0.07);\n    display: grid;\n    place-items: center;\n    transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease, color 0.22s ease;\n  }\n\n  .tjs-atc-row__wishlist:hover {\n    transform: translateY(-1px);\n    border-color: rgba(47, 36, 32, 0.32);\n  }\n\n  .tjs-atc-row__wishlist svg {\n    width: 21px;\n    height: 21px;\n    stroke: currentColor;\n    stroke-width: 1.9;\n    fill: none;\n    transition: fill 0.22s ease, transform 0.22s ease;\n  }\n\n  .tjs-atc-row__wishlist.is-active {\n    background: #fff4f1;\n    color: #b64e47;\n    border-color: rgba(182, 78, 71, 0.22);\n  }\n\n  .tjs-atc-row__wishlist.is-active svg {\n    fill: currentColor;\n    transform: scale(1.05);\n  }\n\n  .tjs-atc-row__hint {\n    margin-top: 9px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    color: #75645d;\n    font-size: 10.8px;\n    line-height: 1.35;\n    font-weight: 650;\n  }\n\n  .tjs-atc-row__hint::before {\n    content: \"\";\n    width: 5px;\n    height: 5px;\n    border-radius: 999px;\n    background: #9a7a67;\n    box-shadow: 0 0 0 4px rgba(154, 122, 103, 0.10);\n    flex: 0 0 auto;\n  }\n\n  .tjs-atc-row__hint strong {\n    color: #2f2420;\n    font-weight: 850;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-atc-row {\n      margin: 14px 0 15px;\n    }\n\n    .tjs-atc-row__wrap {\n      grid-template-columns: 1fr 50px;\n      gap: 9px;\n      max-width: 100%;\n    }\n\n    .tjs-atc-row__button,\n    .tjs-atc-row__wishlist {\n      min-height: 51px;\n      border-radius: 15px;\n    }\n\n    .tjs-atc-row__button::before {\n      border-radius: 14px;\n    }\n\n    .tjs-atc-row__button-inner {\n      min-height: 51px;\n      padding: 0 14px;\n      gap: 8px;\n    }\n\n    .tjs-atc-row__button-text {\n      font-size: 13px;\n      letter-spacing: 0.25px;\n    }\n\n    .tjs-atc-row__button-icon {\n      width: 21px;\n      height: 21px;\n      font-size: 14px;\n    }\n\n    .tjs-atc-row__wishlist svg {\n      width: 20px;\n      height: 20px;\n    }\n\n    .tjs-atc-row__hint {\n      font-size: 10.4px;\n      margin-top: 8px;\n    }\n  }\n</style>\n\n<div class=\"tjs-atc-row\" data-tjs-atc-row>\n  <div class=\"tjs-atc-row__wrap\">\n    <button type=\"button\" class=\"tjs-atc-row__button\" data-tjs-custom-atc>\n      <span class=\"tjs-atc-row__button-inner\">\n        <span class=\"tjs-atc-row__button-text\" data-tjs-custom-atc-text>\n          Add To Cart\n        </span>\n        <span class=\"tjs-atc-row__button-icon\">→</span>\n      </span>\n    </button>\n\n    <button type=\"button\" class=\"tjs-atc-row__wishlist\" data-tjs-custom-wishlist aria-label=\"Add to wishlist\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M20.8 4.6c-1.8-1.7-4.6-1.6-6.3.2L12 7.4 9.5 4.8C7.8 3 5 2.9 3.2 4.6 1.4 6.4 1.3 9.2 3 11l9 9 9-9c1.7-1.8 1.6-4.6-.2-6.4z\"></path>\n      </svg>\n    </button>\n  </div>\n\n  <div class=\"tjs-atc-row__hint\">\n    Add now to unlock <strong>free shipping</strong>\n  </div>\n</div>\n\n<script>\n  (function () {\n    function initTjsCustomAtc() {\n      var row = document.querySelector(\"[data-tjs-atc-row]\");\n      if (!row) return;\n\n      var customAtc = row.querySelector(\"[data-tjs-custom-atc]\");\n      var customAtcText = row.querySelector(\"[data-tjs-custom-atc-text]\");\n      var wishlist = row.querySelector(\"[data-tjs-custom-wishlist]\");\n\n      if (!customAtc) return;\n\n      function findRealAddButton() {\n        var buttons = Array.from(document.querySelectorAll(\n          'form[action*=\"/cart/add\"] button[type=\"submit\"], form[action*=\"/cart/add\"] [name=\"add\"], .product-form__submit, [data-add-to-cart]'\n        ));\n\n        return buttons.find(function (button) {\n          return button !== customAtc && !button.disabled && button.offsetParent !== null;\n        }) || buttons.find(function (button) {\n          return button !== customAtc && !button.disabled;\n        });\n      }\n\n      function syncDisabledState() {\n        var realButton = findRealAddButton();\n        customAtc.disabled = !realButton;\n\n        if (!realButton) {\n          customAtcText.textContent = \"Unavailable\";\n        } else if (!customAtc.classList.contains(\"is-loading\")) {\n          customAtcText.textContent = \"Add To Cart\";\n        }\n      }\n\n      customAtc.addEventListener(\"click\", function () {\n        var realButton = findRealAddButton();\n\n        if (!realButton) {\n          customAtcText.textContent = \"Select Option\";\n          setTimeout(syncDisabledState, 1200);\n          return;\n        }\n\n        customAtc.classList.add(\"is-loading\");\n        customAtcText.textContent = \"Adding...\";\n\n        realButton.click();\n\n        setTimeout(function () {\n          customAtcText.textContent = \"Added ✓\";\n        }, 450);\n\n        setTimeout(function () {\n          customAtc.classList.remove(\"is-loading\");\n          customAtcText.textContent = \"Add To Cart\";\n        }, 1500);\n      });\n\n      if (wishlist) {\n        wishlist.addEventListener(\"click\", function () {\n          var realWishlist =\n            document.querySelector('[data-wishlist-add]') ||\n            document.querySelector('[data-wishlist-button]') ||\n            document.querySelector('.wishlist-button') ||\n            document.querySelector('.tinvwl_add_to_wishlist_button') ||\n            document.querySelector('[aria-label*=\"Wishlist\"]') ||\n            document.querySelector('[aria-label*=\"wishlist\"]');\n\n          if (realWishlist && realWishlist !== wishlist && typeof realWishlist.click === \"function\") {\n            realWishlist.click();\n          }\n\n          wishlist.classList.toggle(\"is-active\");\n          wishlist.setAttribute(\n            \"aria-label\",\n            wishlist.classList.contains(\"is-active\") ? \"Remove from wishlist\" : \"Add to wishlist\"\n          );\n        });\n      }\n\n      document.addEventListener(\"variant:change\", function () {\n        setTimeout(syncDisabledState, 120);\n      });\n\n      document.addEventListener(\"change\", function (event) {\n        if (\n          event.target.matches('[name=\"id\"]') ||\n          event.target.matches('input[type=\"radio\"]') ||\n          event.target.matches(\"select\")\n        ) {\n          setTimeout(syncDisabledState, 120);\n        }\n      });\n\n      syncDisabledState();\n    }\n\n    document.addEventListener(\"DOMContentLoaded\", initTjsCustomAtc);\n    document.addEventListener(\"shopify:section:load\", initTjsCustomAtc);\n  })();\n</script>"
