                "liquid": "<style>\n  .tjs-pdp-title {\n    margin: 6px 0 11px;\n    font-family: inherit;\n  }\n\n  .tjs-pdp-title__heading {\n    margin: 0;\n    max-width: 680px;\n    color: #201815;\n    font-size: clamp(24px, 2.9vw, 37px);\n    line-height: 1.13;\n    letter-spacing: -0.75px;\n    font-weight: 720;\n  }\n\n  .tjs-pdp-title__text {\n    position: relative;\n    display: inline;\n    background:\n      linear-gradient(\n        180deg,\n        transparent 64%,\n        rgba(221, 185, 158, 0.34) 64%,\n        rgba(221, 185, 158, 0.34) 88%,\n        transparent 88%\n      );\n    -webkit-box-decoration-break: clone;\n    box-decoration-break: clone;\n    padding: 0 2px;\n  }\n\n  .tjs-pdp-title__text::after {\n    content: \"\";\n    display: inline-block;\n    width: 7px;\n    height: 7px;\n    margin-left: 7px;\n    border-radius: 999px;\n    background: #c99a72;\n    vertical-align: middle;\n    box-shadow: 0 0 0 5px rgba(201, 154, 114, 0.12);\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-pdp-title {\n      margin: 5px 0 10px;\n    }\n\n    .tjs-pdp-title__heading {\n      font-size: 23.5px;\n      line-height: 1.17;\n      letter-spacing: -0.45px;\n      font-weight: 720;\n    }\n\n    .tjs-pdp-title__text::after {\n      width: 6px;\n      height: 6px;\n      margin-left: 6px;\n      box-shadow: 0 0 0 4px rgba(201, 154, 114, 0.12);\n    }\n  }\n</style>\n\n<div class=\"tjs-pdp-title\">\n  <h1 class=\"tjs-pdp-title__heading\">\n    <span class=\"tjs-pdp-title__text\">{{ product.title }}</span>\n  </h1>\n</div>"
