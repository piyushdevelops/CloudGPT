            "custom_liquid_rb3yeM": {
              "type": "_custom-liquid",
              "name": "Custom - Price (Countdown)",
              "settings": {
                "liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n{% assign selling_price = current_variant.price %}\n{% assign compare_price = current_variant.compare_at_price | default: 0 %}\n{% assign total_save = 0 %}\n{% assign final_discount_percent = 0 %}\n\n{% if compare_price > selling_price %}\n  {% assign total_save = compare_price | minus: selling_price %}\n  {% assign final_discount_percent = total_save | times: 100 | divided_by: compare_price | round %}\n{% endif %}\n\n<style>\n  .tjs-price-reveal {\n    margin: 10px 0 16px;\n    font-family: inherit;\n  }\n\n  .tjs-price-reveal * {\n    box-sizing: border-box;\n  }\n\n  .tjs-price-reveal__row {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n\n  .tjs-price-reveal__price {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    color: #241c19;\n    font-size: 38px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: -1.3px;\n    white-space: nowrap;\n    font-variant-numeric: tabular-nums;\n    transition: transform 0.28s ease, color 0.28s ease;\n  }\n\n  .tjs-price-reveal.is-counting .tjs-price-reveal__price {\n    color: #8f5645;\n    transform: translateY(-1px);\n  }\n\n  .tjs-price-reveal.is-final .tjs-price-reveal__price {\n    color: #241c19;\n  }\n\n  .tjs-price-reveal__price::after {\n    content: \"\";\n    position: absolute;\n    left: -5px;\n    right: -5px;\n    bottom: -4px;\n    height: 8px;\n    border-radius: 999px;\n    background: rgba(191, 125, 80, 0.14);\n    z-index: -1;\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform 0.45s ease;\n  }\n\n  .tjs-price-reveal.is-counting .tjs-price-reveal__price::after,\n  .tjs-price-reveal.is-final .tjs-price-reveal__price::after {\n    transform: scaleX(1);\n  }\n\n  .tjs-price-reveal__compare {\n    position: relative;\n    color: #9c8e88;\n    font-size: 15px;\n    line-height: 1;\n    font-weight: 750;\n    white-space: nowrap;\n  }\n\n  .tjs-price-reveal__compare::after {\n    content: \"\";\n    position: absolute;\n    left: -2px;\n    right: -2px;\n    top: 50%;\n    height: 2px;\n    border-radius: 99px;\n    background: #9c8e88;\n    transform: rotate(-6deg);\n  }\n\n  .tjs-price-reveal__badge {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    height: 27px;\n    padding: 0 11px;\n    border-radius: 999px;\n    background: linear-gradient(135deg, #8f8078, #3a2d29);\n    color: #fff;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 900;\n    white-space: nowrap;\n    overflow: hidden;\n    box-shadow: 0 7px 16px rgba(47, 36, 32, 0.16);\n    transition: background 0.35s ease, transform 0.35s ease;\n  }\n\n  .tjs-price-reveal__badge::before {\n    content: \"✦\";\n    color: #fff4ca;\n    font-size: 10px;\n  }\n\n  .tjs-price-reveal__badge::after {\n    content: \"\";\n    position: absolute;\n    top: -80%;\n    left: -60%;\n    width: 30px;\n    height: 260%;\n    background: linear-gradient(110deg, transparent, rgba(255,255,255,0.46), transparent);\n    transform: rotate(18deg);\n    animation: tjsPriceRevealShine 4.5s ease-in-out infinite;\n  }\n\n  .tjs-price-reveal.is-final .tjs-price-reveal__badge {\n    background: linear-gradient(135deg, #2f2420, #8f5645);\n    transform: scale(1.03);\n  }\n\n  @keyframes tjsPriceRevealShine {\n    0%, 50% {\n      left: -60%;\n      opacity: 0;\n    }\n    62% {\n      opacity: 1;\n    }\n    84%, 100% {\n      left: 130%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-price-reveal__line {\n    margin-top: 8px;\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    flex-wrap: wrap;\n    color: #5f514c;\n    font-size: 12.5px;\n    line-height: 1.35;\n    font-weight: 650;\n  }\n\n  .tjs-price-reveal__cart-btn {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 5px 11px;\n    border-radius: 999px;\n    border: 0;\n    background: #241c19;\n    color: #fff;\n    text-decoration: none;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.35px;\n    text-transform: uppercase;\n    white-space: nowrap;\n    overflow: hidden;\n    cursor: pointer;\n    font-family: inherit;\n  }\n\n  .tjs-price-reveal__cart-btn::after {\n    content: \"\";\n    position: absolute;\n    top: -80%;\n    left: -70%;\n    width: 22px;\n    height: 260%;\n    background: linear-gradient(110deg, transparent, rgba(255,255,255,0.42), transparent);\n    transform: rotate(18deg);\n    animation: tjsPriceRevealCtaShine 4.2s ease-in-out infinite;\n  }\n\n  .tjs-price-reveal__cart-btn.is-loading {\n    opacity: 0.72;\n    pointer-events: none;\n  }\n\n  @keyframes tjsPriceRevealCtaShine {\n    0%, 50% {\n      left: -70%;\n      opacity: 0;\n    }\n    62% {\n      opacity: 1;\n    }\n    84%, 100% {\n      left: 130%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-price-reveal[data-has-discount=\"false\"] .tjs-price-reveal__compare,\n  .tjs-price-reveal[data-has-discount=\"false\"] .tjs-price-reveal__badge {\n    display: none !important;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-price-reveal {\n      margin: 9px 0 14px;\n    }\n\n    .tjs-price-reveal__row {\n      gap: 7px;\n    }\n\n    .tjs-price-reveal__price {\n      font-size: 34px;\n      letter-spacing: -1.1px;\n    }\n\n    .tjs-price-reveal__compare {\n      font-size: 14px;\n    }\n\n    .tjs-price-reveal__badge {\n      height: 26px;\n      font-size: 10px;\n      padding: 0 10px;\n    }\n\n    .tjs-price-reveal__line {\n      font-size: 11.7px;\n      gap: 5px;\n      margin-top: 6px;\n    }\n\n    .tjs-price-reveal__cart-btn {\n      padding: 5px 9px;\n      font-size: 9.5px;\n    }\n  }\n</style>\n\n<div\n  class=\"tjs-price-reveal\"\n  data-tjs-price-reveal\n  data-has-discount=\"{% if compare_price > selling_price %}true{% else %}false{% endif %}\"\n>\n  <div class=\"tjs-price-reveal__row\">\n    <div class=\"tjs-price-reveal__price\" data-tjs-reveal-price>\n      ₹{{ selling_price | money_without_currency | remove: '.00' | strip }}\n    </div>\n\n    <div class=\"tjs-price-reveal__compare\" data-tjs-reveal-compare>\n      {% if compare_price > selling_price %}\n        ₹{{ compare_price | money_without_currency | remove: '.00' | strip }}\n      {% endif %}\n    </div>\n\n    <div class=\"tjs-price-reveal__badge\" data-tjs-reveal-badge>\n      {% if compare_price > selling_price %}\n        {{ final_discount_percent }}% Off\n      {% endif %}\n    </div>\n  </div>\n\n  \n</div>\n\n<script type=\"application/json\" data-tjs-price-reveal-variants>\n  {\n    {% for variant in product.variants %}\n      \"{{ variant.id }}\": {\n        \"price\": {{ variant.price | json }},\n        \"compare_at_price\": {{ variant.compare_at_price | default: 0 | json }}\n      }{% unless forloop.last %},{% endunless %}\n    {% endfor %}\n  }\n</script>\n\n<script>\n  (function () {\n    function formatINRFromCents(cents) {\n      var amount = Math.round(Number(cents || 0) / 100);\n\n      try {\n        return \"₹\" + amount.toLocaleString(\"en-IN\", {\n          maximumFractionDigits: 0\n        });\n      } catch (e) {\n        return \"₹\" + amount;\n      }\n    }\n\n    function animateNumber(el, fromCents, toCents, duration) {\n      var start = Math.round(Number(fromCents || 0) / 100);\n      var end = Math.round(Number(toCents || 0) / 100);\n      var startTime = null;\n\n      function easeOutCubic(t) {\n        return 1 - Math.pow(1 - t, 3);\n      }\n\n      function frame(timestamp) {\n        if (!startTime) startTime = timestamp;\n\n        var progress = Math.min((timestamp - startTime) / duration, 1);\n        var eased = easeOutCubic(progress);\n        var current = Math.round(start + (end - start) * eased);\n\n        try {\n          el.textContent = \"₹\" + current.toLocaleString(\"en-IN\", {\n            maximumFractionDigits: 0\n          });\n        } catch (e) {\n          el.textContent = \"₹\" + current;\n        }\n\n        if (progress < 1) {\n          requestAnimationFrame(frame);\n        }\n      }\n\n      requestAnimationFrame(frame);\n    }\n\n    function initTjsPriceReveal() {\n      var box = document.querySelector(\"[data-tjs-price-reveal]\");\n      var priceEl = document.querySelector(\"[data-tjs-reveal-price]\");\n      var compareEl = document.querySelector(\"[data-tjs-reveal-compare]\");\n      var badgeEl = document.querySelector(\"[data-tjs-reveal-badge]\");\n      var addButton = document.querySelector(\"[data-tjs-reveal-add]\");\n      var jsonEl = document.querySelector(\"[data-tjs-price-reveal-variants]\");\n\n      if (!box || !priceEl || !compareEl || !badgeEl || !jsonEl) return;\n\n      var variants = {};\n\n      try {\n        variants = JSON.parse(jsonEl.textContent);\n      } catch (e) {\n        return;\n      }\n\n      function getVariantId() {\n        var idInput = document.querySelector('form[action*=\"/cart/add\"] [name=\"id\"]');\n        return idInput ? idInput.value : null;\n      }\n\n      function updatePrice(variantId) {\n        var variant = variants[String(variantId)];\n        if (!variant) return;\n\n        var price = Number(variant.price || 0);\n        var compare = Number(variant.compare_at_price || 0);\n        var hasDiscount = compare > price;\n        var finalPercent = hasDiscount ? Math.round(((compare - price) * 100) / compare) : 0;\n\n        box.classList.remove(\"is-counting\", \"is-final\");\n\n        if (!hasDiscount) {\n          priceEl.textContent = formatINRFromCents(price);\n          compareEl.textContent = \"\";\n          badgeEl.textContent = \"\";\n          box.setAttribute(\"data-has-discount\", \"false\");\n          return;\n        }\n\n        box.setAttribute(\"data-has-discount\", \"true\");\n\n        priceEl.textContent = formatINRFromCents(compare);\n        compareEl.textContent = formatINRFromCents(compare);\n        badgeEl.textContent = \"Price Drop\";\n\n        setTimeout(function () {\n          box.classList.add(\"is-counting\");\n          animateNumber(priceEl, compare, price, 1100);\n        }, 550);\n\n        setTimeout(function () {\n          box.classList.remove(\"is-counting\");\n          box.classList.add(\"is-final\");\n          priceEl.textContent = formatINRFromCents(price);\n          badgeEl.textContent = finalPercent + \"% Off\";\n        }, 1750);\n      }\n\n      if (addButton && !addButton.dataset.tjsClickReady) {\n        addButton.dataset.tjsClickReady = \"true\";\n\n        addButton.addEventListener(\"click\", function () {\n          var realAddButton =\n            document.querySelector('form[action*=\"/cart/add\"] button[type=\"submit\"]:not([disabled])') ||\n            document.querySelector('form[action*=\"/cart/add\"] [name=\"add\"]:not([disabled])') ||\n            document.querySelector('.product-form__submit:not([disabled])') ||\n            document.querySelector('.product-form button[type=\"submit\"]:not([disabled])') ||\n            document.querySelector('[data-add-to-cart]:not([disabled])');\n\n          if (realAddButton && typeof realAddButton.click === \"function\") {\n            addButton.classList.add(\"is-loading\");\n            addButton.textContent = \"Adding...\";\n            realAddButton.click();\n\n            setTimeout(function () {\n              addButton.textContent = \"Add To Cart →\";\n              addButton.classList.remove(\"is-loading\");\n            }, 1400);\n          } else {\n            addButton.textContent = \"Select Option\";\n\n            setTimeout(function () {\n              addButton.textContent = \"Add To Cart →\";\n            }, 1400);\n          }\n        });\n      }\n\n      document.addEventListener(\"change\", function (event) {\n        if (\n          event.target.matches('[name=\"id\"]') ||\n          event.target.matches('input[type=\"radio\"]') ||\n          event.target.matches(\"select\")\n        ) {\n          setTimeout(function () {\n            var variantId = getVariantId();\n            if (variantId) updatePrice(variantId);\n          }, 100);\n        }\n      });\n\n      document.addEventListener(\"variant:change\", function (event) {\n        if (event.detail && event.detail.variant && event.detail.variant.id) {\n          updatePrice(event.detail.variant.id);\n        }\n      });\n\n      var initialVariantId = getVariantId() || \"{{ current_variant.id }}\";\n\n      if (initialVariantId) {\n        updatePrice(initialVariantId);\n      }\n    }\n\n    document.addEventListener(\"DOMContentLoaded\", initTjsPriceReveal);\n    document.addEventListener(\"shopify:section:load\", initTjsPriceReveal);\n  })();\n</script>"
