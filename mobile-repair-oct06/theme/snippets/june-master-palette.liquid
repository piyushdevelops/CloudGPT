      assign jp_dark = '#272039'
      assign jp_on_dark = '#FAFCFF'
    when 'terracotta_linen'
      assign jp_bg = '#FCF8F0'
      assign jp_surface = '#EEE4D8'
      assign jp_ink = '#362822'
      assign jp_muted = '#716157'
      assign jp_accent = '#A9442E'
