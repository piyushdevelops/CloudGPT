      assign jp_border = '#DDCDC0'
      assign jp_dark = '#362822'
      assign jp_on_dark = '#FCF8F0'
    when 'lemon_black'
      assign jp_bg = '#FFFFFF'
      assign jp_surface = '#F6F6EB'
      assign jp_ink = '#171717'
      assign jp_muted = '#61615A'
      assign jp_accent = '#F4E84B'
      assign jp_on_accent = '#171717'
      assign jp_border = '#DEDED1'
