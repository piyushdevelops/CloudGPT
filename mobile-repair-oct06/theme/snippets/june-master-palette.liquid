{% doc %}
Central colour roles and presets for the June theme.
@example
{% render 'june-master-palette' %}
{% enddoc %}
{% if settings.june_palette_enabled %}
{% liquid
  assign jp_bg = settings.june_palette_bg | default: '#FFFFFF'
  assign jp_surface = settings.june_palette_surface | default: '#F5F5F3'
  assign jp_ink = settings.june_palette_ink | default: '#171717'
  assign jp_muted = settings.june_palette_muted | default: '#656565'
  assign jp_accent = settings.june_palette_accent | default: '#F56A28'
  assign jp_on_accent = settings.june_palette_on_accent | default: '#171717'
  assign jp_border = settings.june_palette_border | default: '#DADADA'
  assign jp_dark = settings.june_palette_dark | default: '#171717'
  assign jp_on_dark = settings.june_palette_on_dark | default: '#FFFFFF'
  case settings.june_palette_preset
    when 'orange'
      assign jp_bg = '#FFFFFF'
      assign jp_surface = '#F5F5F3'
      assign jp_ink = '#171717'
      assign jp_muted = '#656565'
      assign jp_accent = '#F56A28'
      assign jp_on_accent = '#171717'
      assign jp_border = '#DADADA'
      assign jp_dark = '#171717'
      assign jp_on_dark = '#FFFFFF'
    when 'blue'
      assign jp_bg = '#FFFFFF'
      assign jp_surface = '#F5F5F3'
      assign jp_ink = '#171717'
      assign jp_muted = '#656565'
      assign jp_accent = '#2455F5'
      assign jp_on_accent = '#FFFFFF'
      assign jp_border = '#DADADA'
      assign jp_dark = '#171717'
      assign jp_on_dark = '#FFFFFF'
    when 'red'
      assign jp_bg = '#FFFFFF'
      assign jp_surface = '#F5F5F3'
      assign jp_ink = '#171717'
      assign jp_muted = '#656565'
      assign jp_accent = '#D82B32'
      assign jp_on_accent = '#FFFFFF'
      assign jp_border = '#DADADA'
      assign jp_dark = '#171717'
      assign jp_on_dark = '#FFFFFF'
    when 'apricot'
