      assign jp_muted = '#6B635D'
      assign jp_accent = '#F5A477'
      assign jp_on_accent = '#191816'
      assign jp_border = '#D6CDC0'
      assign jp_dark = '#241C18'
      assign jp_on_dark = '#FAF7EF'
    when 'midnight_copper'
      assign jp_bg = '#F6F7F9'
      assign jp_surface = '#E9E5E0'
      assign jp_ink = '#202B40'
      assign jp_muted = '#596273'
      assign jp_accent = '#B56E48'
      assign jp_on_accent = '#171717'
      assign jp_border = '#CFD1D6'
      assign jp_dark = '#202B40'
      assign jp_on_dark = '#F6F7F9'
    when 'olive_peach'
      assign jp_bg = '#FCFAF4'
      assign jp_surface = '#FBE3D2'
      assign jp_ink = '#41452B'
