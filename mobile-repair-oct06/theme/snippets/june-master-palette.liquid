      assign jp_on_dark = '#FFF9F7'
    when 'teal_sand'
      assign jp_bg = '#FBF9F3'
      assign jp_surface = '#ECE5D7'
      assign jp_ink = '#163F43'
      assign jp_muted = '#50666A'
      assign jp_accent = '#14777C'
      assign jp_on_accent = '#FFFFFF'
      assign jp_border = '#CDD8D4'
      assign jp_dark = '#163F43'
      assign jp_on_dark = '#FBF9F3'
    when 'rose_ink'
      assign jp_bg = '#FFFFFF'
