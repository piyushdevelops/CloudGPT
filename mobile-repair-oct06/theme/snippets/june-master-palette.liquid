      assign jp_dark = '#17213C'
      assign jp_on_dark = '#FFFCF4'
    when 'forest_butter'
      assign jp_bg = '#FCFAF2'
      assign jp_surface = '#F2EDCF'
      assign jp_ink = '#193B2E'
