{% stylesheet %}

.jglow .jglow__heading{font-family:var(--jglow-heading-font);font-size:var(--jglow-heading-size);font-weight:var(--jglow-heading-weight);letter-spacing:var(--jglow-heading-tracking);line-height:var(--jglow-heading-leading)}

.jglow .jglow__title{font-family:var(--jglow-title-font);font-size:var(--jglow-title-size);font-weight:var(--jglow-title-weight);letter-spacing:var(--jglow-title-tracking);line-height:var(--jglow-title-leading)}

.jglow .jglow__body{font-family:var(--jglow-body-font);font-size:var(--jglow-body-size);font-weight:var(--jglow-body-weight);letter-spacing:var(--jglow-body-tracking);line-height:var(--jglow-body-leading)}

.jglow .jglow__button-type{font-family:var(--jglow-button-font);font-size:var(--jglow-button-size);font-weight:var(--jglow-button-weight);letter-spacing:var(--jglow-button-tracking);line-height:var(--jglow-button-leading)}

june-glow.jglow{display:flex;flex-direction:column;position:relative;isolation:isolate;max-width:1680px;margin:auto;min-height:calc(min(100vw,1680px)/var(--jglow-ratio));background:#18130f;color:var(--jglow-backdrop-ink);overflow:hidden;scroll-margin-top:110px}

.jglow *{box-sizing:border-box}.jglow [hidden]{display:none!important}.jglow h2,.jglow h3,.jglow p{margin:0;color:inherit}.jglow a{color:inherit;text-decoration:none}.jglow button{appearance:none;cursor:pointer;color:inherit}.jglow strong{font-weight:700}.jglow :is(a,button,summary):focus-visible{outline:3px solid var(--jglow-accent);outline-offset:3px}

.jglow__scenes,.jglow__backdrop,.jglow__scene{position:absolute;inset:0;overflow:hidden}.jglow__scenes,.jglow__backdrop{z-index:0;pointer-events:none}.jglow__scene{animation:jglow-in var(--jglow-duration) ease both}.jglow__scene picture,.jglow__backdrop picture{display:block;width:100%;height:calc(100% / (1 - var(--jglow-crop,0)))}.jglow__scene img,.jglow__backdrop img{display:block;width:100%;height:100%;object-fit:cover;object-position:var(--jglow-focus) top}

.jglow:after{content:'';position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgb(0 0 0 / var(--jglow-shade)),transparent 75%),linear-gradient(0deg,#0006,transparent 50%)}

.jglow__stage{flex:1;min-height:300px}.jglow__header{position:relative;z-index:2;padding:clamp(28px,4vw,64px);max-width:620px;width:50%;text-shadow:0 2px 18px #0007}.jglow .jglow__heading{margin:12px 0 16px;overflow-wrap:break-word}.jglow__eyebrow{text-transform:uppercase;font-size:calc(var(--jglow-button-size)*.75)!important;letter-spacing:.15em!important}

.jglow__dock{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);align-items:center;gap:28px;margin:0 24px 20px;padding:16px 22px;background:rgb(20 17 14 / var(--jglow-dock-alpha));border:1px solid #ffffff55;backdrop-filter:blur(12px);border-radius:4px}

.jglow__selection{min-width:0}.jglow__nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:8px}.jglow__choice{display:flex;flex-direction:column;align-items:center;gap:6px;min-height:100px;padding:4px 6px 8px;background:transparent;border:0;border-bottom:2px solid transparent;opacity:.8;transition:opacity var(--jglow-duration)}.jglow__choice img{display:block;width:80px;height:68px;object-fit:contain;border-radius:3px}.jglow__choice span{overflow-wrap:anywhere}.jglow__choice:hover,.jglow__choice[aria-pressed=true]{opacity:1}.jglow__choice[aria-pressed=true]{border-bottom-color:var(--jglow-accent)}

.jglow__details{min-width:0;border-left:1px solid #ffffff44;padding-left:28px}.jglow__details>[data-product]{display:flex;flex-direction:column;gap:8px}.jglow__product-heading{order:0;display:flex;align-items:baseline;justify-content:space-between;gap:12px}.jglow__product-heading p{white-space:nowrap}.jglow__primary{order:1}.jglow .jglow__spec{order:2;font-size:calc(var(--jglow-body-size)*.875)}.jglow__spec summary{cursor:pointer;min-height:44px;display:flex;align-items:center;gap:8px}.jglow__spec summary:after{content:'+'}.jglow__spec[open] summary:after{content:'âˆ’'}.jglow__spec p{padding-bottom:8px}

.jglow__arrow{display:grid;place-items:center;width:30px;height:30px;flex:none;border-radius:50%;background:#171717;color:var(--jglow-accent)}.jglow__arrow svg{width:17px;height:17px}.jglow .jglow__primary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:48px;padding:7px 8px 7px 20px;border:1px solid #171717;border-radius:999px;background:var(--jglow-accent);color:var(--june-on-accent,#171717);box-shadow:-2px 1px 0 #171717}.jglow .jglow__secondary{display:flex;align-items:center;justify-content:flex-start;gap:8px;min-height:44px;text-decoration:underline;text-underline-offset:4px}.jglow__secondary .jglow__arrow{width:22px;height:22px}.jglow__secondary svg{width:14px;height:14px}

@media(min-width:750px){.jglow__details{position:relative;padding-bottom:44px}.jglow__secondary{position:absolute;bottom:0;right:0}.jglow__spec{margin-bottom:-44px}.jglow__spec[open]{margin-bottom:0}}

@media(min-width:750px) and (max-width:1100px){.jglow__header{width:58%}.jglow .jglow__heading{font-size:calc(var(--jglow-heading-size)*.85)}.jglow__product-heading{display:block}.jglow__product-heading p{margin-top:4px}}

@media(max-width:749px){june-glow.jglow{min-height:680px}.jglow__stage{min-height:350px}.jglow__header{padding:26px 22px;width:100%;max-width:100%}.jglow .jglow__heading{font-size:var(--jglow-heading-mobile);max-width:340px;margin:10px 0 12px}.jglow .jglow__title{font-size:var(--jglow-title-mobile)}.jglow .jglow__body{font-size:var(--jglow-body-mobile)}.jglow .jglow__button-type{font-size:var(--jglow-button-mobile)}.jglow__eyebrow{font-size:calc(var(--jglow-button-mobile)*.75)!important}.jglow__header .jglow__body{max-width:280px}.jglow__scene picture,.jglow__backdrop picture{height:100%}.jglow__scene img,.jglow__backdrop img{object-position:var(--jglow-mobile-focus) top}.jglow:after{background:linear-gradient(180deg,rgb(0 0 0 / var(--jglow-shade)),transparent 45%,#0007)}.jglow__dock{display:block;margin:0 12px 12px;padding:14px;background:rgb(20 17 14 / max(.85,var(--jglow-dock-alpha)))}.jglow__nav{gap:8px;margin-top:6px}.jglow__choice{min-height:96px;padding:4px 0 8px;font-size:12px!important}.jglow__choice img{width:76px;height:64px}.jglow__details{border-left:0;border-top:1px solid #ffffff44;padding:14px 0 0;margin-top:12px}.jglow__product-heading{display:block}.jglow__product-heading p{margin-top:4px}.jglow__details>[data-product]{gap:10px}.jglow__spec{margin-bottom:-44px}.jglow__spec[open]{margin-bottom:0}.jglow .jglow__secondary{justify-content:flex-end}.jglow__spec summary{max-width:80px}}

@keyframes jglow-in{from{opacity:0}to{opacity:1}}@media(prefers-reduced-motion:reduce){.jglow *{animation:none!important;transition:none!important}}.jglow[data-motion=false] *{animation:none!important;transition:none!important}



{% endstylesheet %}



{% javascript %}











if(!customElements.get('june-glow')){



 customElements.define('june-glow',class extends HTMLElement{



  connectedCallback(){



   this.controller?.abort();this.controller=new AbortController();const options={signal:this.controller.signal};



   this.addEventListener('click',event=>{const b=event.target.closest('[data-select]');if(b&&this.contains(b))this.select(Number(b.dataset.select));},options);



   this.addEventListener('keydown',event=>{const b=event.target.closest('[data-select]');if(!b)return;const group=[...b.parentElement.querySelectorAll('[data-select]')];let i=group.indexOf(b),n;if(event.key==='ArrowRight')n=(i+1)%group.length;if(event.key==='ArrowLeft')n=(i-1+group.length)%group.length;if(event.key==='Home')n=0;if(event.key==='End')n=group.length-1;if(n===undefined)return;event.preventDefault();this.select(Number(group[n].dataset.select));group[n].focus();},options);



   this.addEventListener('shopify:block:select',event=>{const b=[...this.querySelectorAll('[data-block]')].find(b=>b.dataset.block===event.detail.blockId);if(b)this.select(Number(b.dataset.select));},options);



  }



  select(index){this.querySelectorAll('[data-select]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.select)===index)));this.querySelectorAll('[data-scene]').forEach(p=>p.hidden=Number(p.dataset.scene)!==index);this.querySelectorAll('[data-product]').forEach(p=>p.hidden=Number(p.dataset.product)!==index);}



  disconnectedCallback(){this.controller?.abort();}



 });



}











{% endjavascript %}



