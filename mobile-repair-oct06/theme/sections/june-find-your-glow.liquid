 {% if scene != blank %}<picture>{% assign mobile_scene = block.settings.mobile_scene | default: block.settings.product.featured_image %}{% if mobile_scene != blank %}<source media="(max-width:749px)" srcset="{{ mobile_scene | image_url: width: 900 }}">{% endif %}{{ scene | image_url: width: 1600 | image_tag: widths: '500,800,1200,1600', sizes: '(min-width: 1680px) 1680px, 100vw', loading: 'lazy', alt: block.settings.product.title }}</picture>{% endif %}



 </div>{% assign number = number | plus: 1 %}{% endif %}{% endfor %}</div>



