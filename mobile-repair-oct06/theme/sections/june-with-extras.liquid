  if block.settings.product != blank

   assign count = count | plus: 1

  endif

 endfor

%}

{% style %}

{% assign role_font = type.heading_font | default: section.settings.fallback_font %}{% assign weight = type.heading_weight | default: 900 | append: '' %}{% assign face = role_font | font_modify: 'weight', weight | default: role_font %}{{ face | font_face: font_display: 'swap' }}

#JuneLimited-{{ section.id }}{--jl-heading-font:{{ role_font.family | default: 'Poppins' }},{{ role_font.fallback_families | default: 'sans-serif' }};--jl-heading-weight:{{ type.heading_weight | default: 900 }};--jl-heading-size:{{ type.heading_size | default: 62 }}px;--jl-heading-mobile:{{ type.heading_mobile | default: 42 }}px;--jl-heading-tracking:{{ type.heading_tracking | default: -2 | divided_by: 100.0 }}em;--jl-heading-leading:{{ type.heading_leading | default: 105 | divided_by: 100.0 }};}

