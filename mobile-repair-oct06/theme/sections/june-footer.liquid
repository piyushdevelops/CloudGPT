{% style %}

#JuneFooter-{{ section.id }}{--jfooter-bg:var(--june-dark,{{ section.settings.background }});--jfooter-ink:var(--june-on-dark,{{ section.settings.ink }});--jfooter-accent:var(--june-accent,{{ section.settings.accent }});--jfooter-duration:{{ 24000 | divided_by: section.settings.speed }}ms;}

{% assign face = type.heading_font | default: section.settings.fallback_font %}{% assign weight = type.heading_weight | default: 900 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneFooter-{{ section.id }}{--jfooter-heading-font:{{ face.family }},{{ face.fallback_families }};--jfooter-heading-weight:{{ type.heading_weight | default: 900 }};--jfooter-heading-size:{{ type.heading_size | default: 36 }}px;--jfooter-heading-mobile:{{ type.heading_mobile | default: 30 }}px;--jfooter-heading-tracking:{{ type.heading_tracking | default: -2 | divided_by: 100.0 }}em;--jfooter-heading-leading:{{ type.heading_leading | default: 105 | divided_by: 100.0 }};}

{% assign face = type.title_font | default: section.settings.fallback_font %}{% assign weight = type.title_weight | default: 600 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneFooter-{{ section.id }}{--jfooter-title-font:{{ face.family }},{{ face.fallback_families }};--jfooter-title-weight:{{ type.title_weight | default: 600 }};--jfooter-title-size:{{ type.title_size | default: 20 }}px;--jfooter-title-mobile:{{ type.title_mobile | default: 20 }}px;--jfooter-title-tracking:{{ type.title_tracking | default: -2 | divided_by: 100.0 }}em;--jfooter-title-leading:{{ type.title_leading | default: 120 | divided_by: 100.0 }};}

{% assign face = type.body_font | default: section.settings.fallback_font %}{% assign weight = type.body_weight | default: 400 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneFooter-{{ section.id }}{--jfooter-body-font:{{ face.family }},{{ face.fallback_families }};--jfooter-body-weight:{{ type.body_weight | default: 400 }};--jfooter-body-size:{{ type.body_size | default: 14 }}px;--jfooter-body-mobile:{{ type.body_mobile | default: 14 }}px;--jfooter-body-tracking:{{ type.body_tracking | default: -1 | divided_by: 100.0 }}em;--jfooter-body-leading:{{ type.body_leading | default: 150 | divided_by: 100.0 }};}

{% assign face = type.button_font | default: section.settings.fallback_font %}{% assign weight = type.button_weight | default: 600 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneFooter-{{ section.id }}{--jfooter-button-font:{{ face.family }},{{ face.fallback_families }};--jfooter-button-weight:{{ type.button_weight | default: 600 }};--jfooter-button-size:{{ type.button_size | default: 14 }}px;--jfooter-button-mobile:{{ type.button_mobile | default: 14 }}px;--jfooter-button-tracking:{{ type.button_tracking | default: -1 | divided_by: 100.0 }}em;--jfooter-button-leading:{{ type.button_leading | default: 130 | divided_by: 100.0 }};}

