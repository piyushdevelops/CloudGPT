{% endstyle %}



{% style %}

{% assign face = brand.brand_font | default: section.settings.fallback_font %}{% assign weight = brand.brand_weight | default: 900 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneFooter-{{ section.id }}{--jfooter-brand-font:{{ face.family }},{{ face.fallback_families }};--jfooter-brand-weight:{{ brand.brand_weight | default: 900 }};--jfooter-brand-size:{{ brand.brand_size | default: 150 }}px;--jfooter-brand-mobile:{{ brand.brand_mobile | default: 54 }}px;--jfooter-brand-tracking:{{ brand.brand_tracking | default: -4 | divided_by: 100.0 }}em;--jfooter-brand-leading:{{ brand.brand_leading | default: 105 | divided_by: 100.0 }};}

{% endstyle %}



{% capture arrow %}<span class="jfooter__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endcapture %}

<june-footer id="JuneFooter-{{ section.id }}" class="jfooter{% if settings.june_type_enabled != false and section.settings.use_master_typography != false %} june-type{% endif %}" data-motion="{{ section.settings.motion }}">

 <div class="jfooter__top"><h2 class="jfooter__heading">{{ section.settings.heading | escape }}</h2>{% if section.settings.instagram != blank %}<a class="jfooter__social jfooter__button-type" href="{{ section.settings.instagram }}">{{ section.settings.instagram_label | escape }}{{ arrow }}</a>{% endif %}</div>

 <div class="jfooter__middle">

 {% for block in groups %}<details class="jfooter__group" open {{ block.shopify_attributes }}><summary class="jfooter__title">{{ block.settings.heading | escape }}<span aria-hidden="true">+</span></summary><nav aria-label="{{ block.settings.heading | escape }}" class="jfooter__links jfooter__body">{% if block.settings.menu != blank %}{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}{% for i in (1..6) %}{% assign label_key = 'label_' | append: i %}{% assign url_key = 'url_' | append: i %}{% if block.settings[label_key] != blank and block.settings[url_key] != blank %}<a href="{{ block.settings[url_key] }}">{{ block.settings[label_key] | escape }}</a>{% endif %}{% endfor %}{% endif %}</nav></details>{% endfor %}

 <div class="jfooter__aside"><p class="jfooter__title">{{ section.settings.tagline | escape }}<br>{{ section.settings.tagline_second | escape }}</p><a class="jfooter__back jfooter__button-type" href="#" data-top>{{ section.settings.back | escape }}<span aria-hidden="true">&uarr;</span></a>

 {% if section.settings.newsletter %}<details class="jfooter__newsletter"><summary class="jfooter__button-type">{{ section.settings.signup_heading | escape }}<span aria-hidden="true">+</span></summary>{% form 'customer', id: form_id, class: 'jfooter__form' %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p class="jfooter__body" role="status">{{ section.settings.success | escape }}</p>{% else %}{% if form.errors %}<div role="alert" class="jfooter__body">{{ form.errors | default_errors }}</div>{% endif %}<label for="{{ form_id }}-email" class="jfooter__body">{{ section.settings.email_label | escape }}</label><input id="{{ form_id }}-email" class="jfooter__email jfooter__body" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | escape }}"><button class="jfooter__primary jfooter__button-type" type="submit">{{ section.settings.subscribe | escape }}{{ arrow }}</button><p class="jfooter__note jfooter__body">{{ section.settings.signup_note | escape }} <a href="{{ shop.privacy_policy.url }}">{{ section.settings.privacy | escape }}</a></p>{% endif %}{% endform %}</details>{% endif %}

 </div></div>

 <div class="jfooter__mobile-actions">{% if section.settings.instagram != blank %}<a class="jfooter__button-type" href="{{ section.settings.instagram }}">{{ section.settings.mobile_instagram_label | escape }}<span aria-hidden="true">↗</span></a>{% endif %}<a class="jfooter__button-type" href="#" data-top>{{ section.settings.back | escape }}<span aria-hidden="true">&uarr;</span></a></div>

 <div class="jfooter__brand" aria-label="{{ section.settings.brand_name | escape }}">{{ section.settings.brand_name | escape }}<span aria-hidden="true">.</span></div>

<div class="jfooter__commerce">
{% if section.settings.payments and payment_block != blank %}
<div class="jfooter__payment-panel jfooter__body" {{ payment_block.shopify_attributes }}>
<p class="jfooter__payment-title jfooter__button-type">{{ pay.heading | escape }}</p>
{% if pay.artwork != blank %}
{{ pay.artwork | image_url: width: 1000 | image_tag: class: 'jfooter__payment-art', loading: 'lazy', widths: '400,600,1000', sizes: '(max-width:749px) 100vw, 600px', alt: pay.artwork_alt }}
{% else %}<ul class="jfooter__payment-list" role="list" aria-label="{{ pay.heading | escape }}">{% if pay.upi %}<li class="jfooter__pay-badge jfooter__pay-badge--upi"><span>UPI</span></li>{% endif %}
{% if pay.google_pay %}<li class="jfooter__pay-badge"><span>Google Pay</span></li>{% endif %}
{% if pay.phonepe %}<li class="jfooter__pay-badge"><span>PhonePe</span></li>{% endif %}
{% if pay.paytm %}<li class="jfooter__pay-badge"><span>Paytm</span></li>{% endif %}
{% if pay.rupay %}<li class="jfooter__pay-badge"><span>RuPay</span></li>{% endif %}
{% if pay.visa %}<li class="jfooter__pay-badge"><span aria-hidden="true">{{ 'visa' | payment_type_svg_tag }}</span><span>Visa</span></li>{% endif %}
{% if pay.master %}<li class="jfooter__pay-badge"><span aria-hidden="true">{{ 'master' | payment_type_svg_tag }}</span><span>Mastercard</span></li>{% endif %}
{% if pay.netbanking %}<li class="jfooter__pay-badge"><span>Net banking</span></li>{% endif %}
{% if pay.cod %}<li class="jfooter__pay-badge"><span>Cash on delivery</span></li>{% endif %}
{% if pay.emi %}<li class="jfooter__pay-badge"><span>EMI / Pay later</span></li>{% endif %}
{% if pay.wallets %}<li class="jfooter__pay-badge"><span>Other wallets</span></li>{% endif %}</ul>{% endif %}
{% if pay.note != blank %}<p class="jfooter__payment-note">{{ pay.note | escape }}</p>{% endif %}
</div>{% endif %}
 {% if section.settings.localization %}{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}{% form 'localization', id: locale_id, class: 'jfooter__localization jfooter__button-type' %}{% if localization.available_countries.size > 1 %}<div class="jfooter__locale-field"><label class="jfooter__country-label" for="{{ locale_id }}-country">{{ section.settings.country_label | escape }}</label><select id="{{ locale_id }}-country" name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name | escape }} · {{ country.currency.iso_code }}</option>{% endfor %}</select></div>{% endif %}{% if localization.available_languages.size > 1 %}<div class="jfooter__locale-field"><label class="jfooter__country-label" for="{{ locale_id }}-language">{{ section.settings.language_label | escape }}</label><select id="{{ locale_id }}-language" name="language_code">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | escape }}</option>{% endfor %}</select></div>{% endif %}<button type="submit">{{ section.settings.update | escape }}</button>{% endform %}{% endif %}{% endif %}
</div>
 <div class="jfooter__bottom jfooter__body"><p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | escape }}</p><div class="jfooter__legal">{% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">{{ section.settings.privacy | escape }}</a>{% endif %}{% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">{{ section.settings.terms | escape }}</a>{% endif %}</div>



 </div>



</june-footer>



{% stylesheet %}



june-footer.jfooter{display:block;max-width:1680px;margin:auto;padding:36px 52px 20px;background:var(--jfooter-bg);color:var(--jfooter-ink)}.jfooter *{box-sizing:border-box}.jfooter h2,.jfooter p{margin:0;color:inherit}.jfooter a{color:inherit;text-decoration:none}.jfooter a:hover{text-decoration:underline;text-underline-offset:4px}.jfooter button,.jfooter input,.jfooter select{font:inherit}.jfooter a:focus-visible,.jfooter summary:focus-visible,.jfooter button:focus-visible,.jfooter input:focus-visible,.jfooter select:focus-visible{outline:2px solid var(--jfooter-ink);outline-offset:4px}.jfooter summary{cursor:pointer;list-style:none}.jfooter summary::-webkit-details-marker{display:none}

.jfooter .jfooter__heading{font-family:var(--jfooter-heading-font);font-size:var(--jfooter-heading-size);font-weight:var(--jfooter-heading-weight);letter-spacing:var(--jfooter-heading-tracking);line-height:var(--jfooter-heading-leading)}

.jfooter .jfooter__title{font-family:var(--jfooter-title-font);font-size:var(--jfooter-title-size);font-weight:var(--jfooter-title-weight);letter-spacing:var(--jfooter-title-tracking);line-height:var(--jfooter-title-leading)}

.jfooter .jfooter__body{font-family:var(--jfooter-body-font);font-size:var(--jfooter-body-size);font-weight:var(--jfooter-body-weight);letter-spacing:var(--jfooter-body-tracking);line-height:var(--jfooter-body-leading)}

.jfooter .jfooter__button-type{font-family:var(--jfooter-button-font);font-size:var(--jfooter-button-size);font-weight:var(--jfooter-button-weight);letter-spacing:var(--jfooter-button-tracking);line-height:var(--jfooter-button-leading)}





.jfooter__top{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-bottom:26px;border-bottom:1px solid var(--jfooter-ink)}.jfooter__top .jfooter__heading{max-width:900px}.jfooter__social{display:flex;align-items:center;gap:10px;flex:none;min-height:44px}.jfooter__arrow{display:grid;place-items:center;width:24px;height:24px;flex:none;border-radius:50%;background:var(--june-dark,var(--june-dark,#171717));color:var(--june-on-dark,var(--jfooter-accent))}.jfooter__arrow svg{width:16px;height:16px}.jfooter__middle{display:grid;grid-template-columns:1fr 1fr 1.15fr 1.4fr;gap:32px;padding:30px 0;border-bottom:1px solid var(--jfooter-ink)}.jfooter__group summary{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px;pointer-events:none}.jfooter__group summary span{display:none}.jfooter__links{display:flex;flex-direction:column}.jfooter__links a{display:flex;align-items:center;min-height:36px;padding:4px 0;overflow-wrap:anywhere}.jfooter__aside{border-left:1px solid var(--jfooter-ink);padding-left:32px}.jfooter__aside>.jfooter__title{font-size:calc(var(--jfooter-title-size)*1.2);margin-bottom:16px}.jfooter__back{display:inline-flex;align-items:center;gap:10px;min-height:44px;text-decoration:underline!important;text-underline-offset:5px}.jfooter__newsletter{margin-top:10px}.jfooter__newsletter>summary{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:44px;border-top:1px solid color-mix(in srgb,var(--june-dark,#FFFFFF) 26.67%,transparent)}.jfooter__newsletter[open]>summary>span{transform:rotate(45deg)}.jfooter__form label{display:block;margin:12px 0 6px}.jfooter .jfooter__email{width:100%;min-height:46px;background:transparent;color:inherit;border:1px solid color-mix(in srgb,var(--june-dark,#FFFFFF) 53.33%,transparent);border-radius:3px;padding:10px;font-size:16px}.jfooter .jfooter__primary{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:50px;width:100%;padding:8px 9px 8px 20px;border:1px solid var(--june-on-dark,#171717);border-radius:999px;background:var(--jfooter-accent);color:var(--june-on-accent,var(--june-on-dark,#171717));box-shadow:-2px 1px 0 #171717;margin-top:12px;cursor:pointer}.jfooter__primary{transition:transform var(--jfooter-duration) ease}@media(hover:hover){.jfooter[data-motion=true] .jfooter__primary:hover{transform:translateY(-2px)}}@media(prefers-reduced-motion:reduce){.jfooter .jfooter__primary{transition:none!important;transform:none!important}}.jfooter[data-motion=false] .jfooter__primary{transition:none}.jfooter__primary .jfooter__arrow{width:32px;height:32px}.jfooter .jfooter__note{font-size:12px;margin-top:10px}.jfooter__mobile-actions{display:none}

.jfooter__brand{font-family:var(--jfooter-brand-font);font-weight:var(--jfooter-brand-weight);font-size:clamp(40px,10.4vw,var(--jfooter-brand-size));letter-spacing:var(--jfooter-brand-tracking);line-height:var(--jfooter-brand-leading);padding:22px 0 18px;text-transform:uppercase;overflow-wrap:anywhere}.jfooter__brand>span{color:inherit}.jfooter__bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:12px!important}.jfooter__legal{display:flex;gap:20px}.jfooter__legal a{min-height:44px;display:flex;align-items:center}.jfooter__payments{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:7px;margin-top:8px}.jfooter__payments svg{width:36px;height:23px}.jfooter__localization{display:flex;gap:8px;max-width:100%}.jfooter__localization select{min-width:0;max-width:210px}.jfooter__localization select,.jfooter__localization button{padding:9px;background:transparent;border:1px solid color-mix(in srgb,var(--june-dark,#FFFFFF) 26.67%,transparent);border-radius:3px;color:inherit}.jfooter__sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0)}

@media(max-width:1100px) and (min-width:750px){june-footer.jfooter{padding:30px}.jfooter__middle{gap:20px}.jfooter__aside{padding-left:20px}.jfooter__top .jfooter__heading{font-size:calc(var(--jfooter-heading-size)*.8)}}

@media(max-width:749px){june-footer.jfooter{padding:28px 24px 18px}.jfooter .jfooter__heading{font-size:var(--jfooter-heading-mobile)}.jfooter .jfooter__title{font-size:var(--jfooter-title-mobile)}.jfooter .jfooter__body{font-size:var(--jfooter-body-mobile)}.jfooter .jfooter__button-type{font-size:var(--jfooter-button-mobile)}.jfooter__top{padding-bottom:22px}.jfooter__social{display:none}.jfooter__middle{display:block;padding:0;border-bottom:0}.jfooter__group{border-bottom:1px solid color-mix(in srgb,var(--june-on-dark,#171717) 33.33%,transparent)}.jfooter__group summary{min-height:62px;margin:0;pointer-events:auto}.jfooter__group summary span{display:block;font-weight:400;font-size:25px}.jfooter__group[open] summary span{transform:rotate(45deg)}.jfooter__links{padding-bottom:14px}.jfooter__links a{min-height:44px}.jfooter__aside{border:0;padding:0}.jfooter__aside>.jfooter__title,.jfooter__aside>.jfooter__back{display:none}.jfooter__newsletter{margin:0}.jfooter__newsletter>summary{border-top:0;border-bottom:1px solid color-mix(in srgb,var(--june-on-dark,#171717) 33.33%,transparent);min-height:56px}.jfooter__form{padding-bottom:18px}.jfooter__mobile-actions{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--jfooter-ink);padding:10px 0}.jfooter__mobile-actions a{display:flex;align-items:center;gap:8px;min-height:44px}.jfooter__brand{font-size:min(var(--jfooter-brand-mobile),14.2vw);padding:22px 0 14px;max-width:100%}.jfooter__bottom{gap:4px 14px}.jfooter__payments{justify-content:flex-start}.jfooter .jfooter__note{font-size:12px}.jfooter__localization{flex-wrap:wrap}}




.jfooter{scroll-margin-top:100px}.jfooter__country-label{display:grid;gap:5px;font-size:inherit}.jfooter__localization{align-items:end}.jfooter__localization button{min-height:44px}.jfooter__brand{padding-block:26px}.jfooter__bottom{gap:16px}.jfooter__payments{margin-top:14px}.jfooter__note a{text-decoration:underline}.jfooter .jfooter__note,.jfooter__bottom{font-size:var(--jfooter-body-mobile)!important}
@media(max-width:749px){.jfooter__brand{padding-block:20px}.jfooter__bottom{gap:12px}.jfooter__localization{width:100%}}


/* Payment and delivery utility row: separate hierarchy, shared merchant typography. */
.jfooter .jfooter__commerce{display:flex;justify-content:space-between;align-items:flex-start;gap:28px 40px;padding:24px 0;border-top:1px solid color-mix(in srgb,var(--jfooter-ink) 25%,transparent);border-bottom:1px solid color-mix(in srgb,var(--jfooter-ink) 25%,transparent);margin-bottom:12px}
.jfooter .jfooter__payment-panel{min-width:0;flex:1}
.jfooter .jfooter__payment-title{font-weight:700;margin-bottom:12px}
.jfooter .jfooter__payment-list{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:0}
.jfooter .jfooter__pay-badge{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:38px;padding:7px 12px;border:1px solid color-mix(in srgb,var(--jfooter-ink) 25%,transparent);border-radius:6px;font:600 13px/1.3 var(--jtype-action-font,var(--jfooter-button-font));color:var(--jfooter-ink);background:color-mix(in srgb,var(--jfooter-ink) 5%,transparent)}
.jfooter .jfooter__pay-badge--upi{border-color:var(--jfooter-accent);box-shadow:inset 3px 0 var(--jfooter-accent);padding-left:15px;font-weight:800}
.jfooter .jfooter__pay-badge svg{display:block;width:32px;height:21px}
.jfooter .jfooter__payment-note{font-size:var(--jtype-utility-size,13px);line-height:1.5;opacity:.75;margin-top:10px}
.jfooter .jfooter__payment-art{display:block;max-width:100%;width:480px;height:auto;max-height:100px;object-fit:contain;object-position:left}
.jfooter .jfooter__localization{display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;flex:0 1 360px;margin:0}
.jfooter .jfooter__locale-field{display:grid;gap:8px;flex:1;min-width:130px}
.jfooter .jfooter__country-label{font-size:13px;font-weight:600;line-height:1.4}
.jfooter .jfooter__localization select{appearance:auto;color-scheme:dark;width:100%;min-width:0;max-width:none;min-height:46px;padding:10px 12px;background:var(--jfooter-bg);border:1px solid color-mix(in srgb,var(--jfooter-ink) 45%,transparent);border-radius:6px;font-size:16px;color:var(--jfooter-ink)}
.jfooter .jfooter__localization button{min-width:76px;min-height:46px;padding:10px 16px;border:1px solid var(--jfooter-accent);border-radius:6px;background:var(--jfooter-accent);color:var(--june-on-accent,#171717);font-weight:700;cursor:pointer}
.jfooter .jfooter__bottom{padding-top:4px}
@media(max-width:749px){.jfooter .jfooter__commerce{flex-direction:column;gap:24px;padding:20px 0}.jfooter .jfooter__localization{flex:auto;width:100%}.jfooter .jfooter__payment-panel{width:100%}.jfooter .jfooter__payment-note{font-size:var(--jtype-utility-mobile,13px)}.jfooter .jfooter__pay-badge{padding:7px 10px}.jfooter .jfooter__pay-badge--upi{padding-left:13px}}

