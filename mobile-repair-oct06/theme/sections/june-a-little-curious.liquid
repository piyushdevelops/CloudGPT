{% if section.settings.use_master_palette == false %}
{% style %}#shopify-section-{{ section.id }}{--june-bg:initial;--june-surface:initial;--june-ink:initial;--june-muted:initial;--june-accent:initial;--june-on-accent:initial;--june-border:initial;--june-dark:initial;--june-on-dark:initial;}{% endstyle %}
{% endif %}
{% liquid

 assign typography = section.blocks | where: 'type', 'typography' | first

 assign type = typography.settings

 assign product = section.settings.product

 assign image = section.settings.image | default: product.featured_image

%}

{% style %}

#JuneMystery-{{ section.id }}{--jmystery-bg:var(--june-bg,{{ section.settings.background }});--jmystery-ink:var(--june-ink,{{ section.settings.ink }});--jmystery-accent:var(--june-accent,{{ section.settings.accent }});--jmystery-duration:{{ 24000 | divided_by: section.settings.speed }}ms;}

{% assign face = type.heading_font | default: section.settings.fallback_font %}{% assign weight = type.heading_weight | default: 900 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneMystery-{{ section.id }}{--jmystery-heading-font:{{ face.family }},{{ face.fallback_families }};--jmystery-heading-weight:{{ type.heading_weight | default: 900 }};--jmystery-heading-size:{{ type.heading_size | default: 54 }}px;--jmystery-heading-mobile:{{ type.heading_mobile | default: 34 }}px;--jmystery-heading-tracking:{{ type.heading_tracking | default: -2 | divided_by: 100.0 }}em;--jmystery-heading-leading:{{ type.heading_leading | default: 105 | divided_by: 100.0 }};}

{% assign face = type.title_font | default: section.settings.fallback_font %}{% assign weight = type.title_weight | default: 600 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneMystery-{{ section.id }}{--jmystery-title-font:{{ face.family }},{{ face.fallback_families }};--jmystery-title-weight:{{ type.title_weight | default: 600 }};--jmystery-title-size:{{ type.title_size | default: 28 }}px;--jmystery-title-mobile:{{ type.title_mobile | default: 20 }}px;--jmystery-title-tracking:{{ type.title_tracking | default: -2 | divided_by: 100.0 }}em;--jmystery-title-leading:{{ type.title_leading | default: 120 | divided_by: 100.0 }};}

{% assign face = type.body_font | default: section.settings.fallback_font %}{% assign weight = type.body_weight | default: 400 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneMystery-{{ section.id }}{--jmystery-body-font:{{ face.family }},{{ face.fallback_families }};--jmystery-body-weight:{{ type.body_weight | default: 400 }};--jmystery-body-size:{{ type.body_size | default: 16 }}px;--jmystery-body-mobile:{{ type.body_mobile | default: 14 }}px;--jmystery-body-tracking:{{ type.body_tracking | default: -1 | divided_by: 100.0 }}em;--jmystery-body-leading:{{ type.body_leading | default: 150 | divided_by: 100.0 }};}

{% assign face = type.button_font | default: section.settings.fallback_font %}{% assign weight = type.button_weight | default: 600 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneMystery-{{ section.id }}{--jmystery-button-font:{{ face.family }},{{ face.fallback_families }};--jmystery-button-weight:{{ type.button_weight | default: 600 }};--jmystery-button-size:{{ type.button_size | default: 14 }}px;--jmystery-button-mobile:{{ type.button_mobile | default: 14 }}px;--jmystery-button-tracking:{{ type.button_tracking | default: -1 | divided_by: 100.0 }}em;--jmystery-button-leading:{{ type.button_leading | default: 130 | divided_by: 100.0 }};}

{% assign face = type.body_font | default: section.settings.fallback_font %}{% assign bold = face | font_modify: 'weight', '700' %}{{ bold | font_face: font_display: 'swap' }}

{% endstyle %}





{% capture arrow %}<span class="jmystery__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endcapture %}

<section id="JuneMystery-{{ section.id }}" class="jmystery{% if settings.june_type_enabled != false and section.settings.use_master_typography != false %} june-type{% endif %}" data-motion="{{ section.settings.motion }}" aria-labelledby="JuneMysteryHeading-{{ section.id }}">

 <header class="jmystery__header"><p class="jmystery__eyebrow jmystery__button-type">{{ section.settings.eyebrow | escape }}</p><h2 class="jmystery__heading" id="JuneMysteryHeading-{{ section.id }}">{{ section.settings.heading | escape }}<br>{{ section.settings.heading_second | escape }}</h2><div class="jmystery__body jmystery__intro">{{ section.settings.body }}</div></header>

 <div class="jmystery__visual">

  {% if image != blank %}<div class="jmystery__art">{{ image | image_url: width: 1000 | image_tag: widths: '400,600,800,1000', sizes: '(min-width: 1680px) 580px, (min-width: 900px) 40vw, 90vw', loading: 'lazy', alt: section.settings.image_alt }}</div>{% else %}<div class="jmystery__placeholder" aria-hidden="true">?</div>{% endif %}

  <details class="jmystery__peek"><summary class="jmystery__button-type"><span class="jmystery__peek-closed">{{ section.settings.peek | escape }}</span><span class="jmystery__peek-open">{{ section.settings.close | escape }}</span><span class="jmystery__plus" aria-hidden="true">+</span></summary><div class="jmystery__reveal"><p class="jmystery__reveal-title jmystery__title">{{ section.settings.reveal_heading | escape }}</p><div class="jmystery__body">{{ section.settings.reveal_body }}</div></div></details>

 </div>

 <div class="jmystery__offer"><p class="jmystery__eyebrow jmystery__button-type">{{ section.settings.offer_eyebrow | escape }}</p><h3 class="jmystery__title">{{ section.settings.offer_heading | escape }}</h3>{% if product != blank %}<p class="jmystery__price jmystery__body">{% if product.price_varies %}<span class="jmoney-prefix">{{ section.settings.from | escape }} </span>{% endif %}{% render 'june-price', amount: product.price %}</p><ul class="jmystery__tiers jmystery__body">{% for variant in product.variants %}<li><a href="{{ product.url }}?variant={{ variant.id }}"><strong>{% render 'june-price', amount: variant.price, compact: true %}</strong>{% assign tier_value = variant.title | times: 100 %}<span>{% if tier_value > 0 %}{{ section.settings.value_label | escape }} {% render 'june-price', amount: tier_value, compact: true %}+{% else %}{{ variant.title | escape }}{% endif %}</span></a></li>{% endfor %}</ul><a class="jmystery__primary jmystery__button-type" href="{{ product.url }}">{% if product.available %}{{ section.settings.shop | escape }}{% else %}{{ section.settings.unavailable | escape }}{% endif %}{{ arrow }}</a>{% elsif request.design_mode %}<p class="jmystery__body">{{ section.settings.setup | escape }}</p>{% endif %}<p class="jmystery__note jmystery__body">{{ section.settings.note | escape }}</p></div>

</section>



{% stylesheet %}



.jmystery{position:relative;display:grid;grid-template-columns:1fr 1.25fr 1fr;align-items:center;gap:20px;max-width:1680px;margin:auto;padding:38px 52px 40px;background:var(--jmystery-bg);color:var(--jmystery-ink);isolation:isolate;overflow:hidden}

.jmystery *{box-sizing:border-box}.jmystery h2,.jmystery h3,.jmystery p{margin:0;color:inherit}.jmystery a{color:inherit;text-decoration:none}.jmystery strong{font-weight:700}.jmystery a:focus-visible,.jmystery summary:focus-visible{outline:3px solid var(--jmystery-ink);outline-offset:5px}

.jmystery .jmystery__heading{font-family:var(--jmystery-heading-font);font-size:var(--jmystery-heading-size);font-weight:var(--jmystery-heading-weight);letter-spacing:var(--jmystery-heading-tracking);line-height:var(--jmystery-heading-leading)}

.jmystery .jmystery__title{font-family:var(--jmystery-title-font);font-size:var(--jmystery-title-size);font-weight:var(--jmystery-title-weight);letter-spacing:var(--jmystery-title-tracking);line-height:var(--jmystery-title-leading)}

.jmystery .jmystery__body{font-family:var(--jmystery-body-font);font-size:var(--jmystery-body-size);font-weight:var(--jmystery-body-weight);letter-spacing:var(--jmystery-body-tracking);line-height:var(--jmystery-body-leading)}

.jmystery .jmystery__button-type{font-family:var(--jmystery-button-font);font-size:var(--jmystery-button-size);font-weight:var(--jmystery-button-weight);letter-spacing:var(--jmystery-button-tracking);line-height:var(--jmystery-button-leading)}





.jmystery__eyebrow{text-transform:uppercase;font-size:calc(var(--jmystery-button-size)*.75)!important;letter-spacing:.12em!important}.jmystery .jmystery__heading{margin:20px 0 22px;overflow-wrap:break-word}.jmystery__header{position:relative;z-index:1}.jmystery__intro{max-width:290px}.jmystery__visual{position:relative;text-align:center;min-width:0}.jmystery__art{width:100%;transition:transform var(--jmystery-duration) ease}.jmystery__art img{display:block;width:100%;height:auto;mix-blend-mode:multiply}.jmystery__visual:has(details[open]) .jmystery__art{transform:translateY(-8px) rotate(-2deg)}.jmystery__placeholder{font-size:220px;line-height:1.3;font-weight:900}

.jmystery__peek{position:relative;z-index:2;margin-top:-16px}.jmystery__peek summary{display:inline-flex;align-items:center;justify-content:center;gap:24px;cursor:pointer;list-style:none;min-height:50px;padding:10px 22px;border:1px solid var(--jmystery-ink);border-radius:999px;background:var(--jmystery-bg)}.jmystery__peek summary::-webkit-details-marker{display:none}.jmystery__plus{font-size:22px;line-height:1}.jmystery__peek-open{display:none}.jmystery__peek[open] .jmystery__peek-closed{display:none}.jmystery__peek[open] .jmystery__peek-open{display:inline}.jmystery__peek[open] .jmystery__plus{transform:rotate(45deg)}.jmystery__reveal{position:absolute;bottom:calc(100% + 12px);left:0;right:0;padding:24px;text-align:left;background:var(--jmystery-bg);border:1px solid var(--jmystery-ink);border-radius:6px;box-shadow:0 12px 35px #17171722}.jmystery .jmystery__reveal-title{font-size:calc(var(--jmystery-title-size)*.75);margin-bottom:10px}.jmystery__reveal .jmystery__body{font-size:calc(var(--jmystery-body-size)*.9)}

.jmystery__offer{position:relative;z-index:1}.jmystery__offer .jmystery__title{margin:18px 0;max-width:340px}.jmystery .jmystery__price{margin-bottom:16px}.jmystery__arrow{display:grid;place-items:center;width:32px;height:32px;flex:none;border-radius:50%;background:var(--june-dark,var(--june-dark,#171717));color:var(--june-on-dark,var(--jmystery-accent))}.jmystery__arrow svg{width:18px;height:18px}.jmystery .jmystery__primary{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:50px;padding:8px 9px 8px 20px;border:1px solid var(--june-ink,#171717);border-radius:999px;background:var(--jmystery-accent);color:var(--june-on-accent,var(--june-ink,#171717));box-shadow:-2px 1px 0 #171717;transition:transform var(--jmystery-duration) ease}.jmystery .jmystery__note{margin-top:14px;font-size:calc(var(--jmystery-body-size)*.8);opacity:.75}

@media(hover:hover){.jmystery[data-motion=true] .jmystery__primary:hover{transform:translateY(-2px)}}

@media(min-width:900px) and (max-width:1200px){.jmystery{padding:30px;gap:12px;grid-template-columns:1fr 1.1fr 1fr}.jmystery .jmystery__heading{font-size:calc(var(--jmystery-heading-size)*.82)}.jmystery__primary{font-size:calc(var(--jmystery-button-size)*.9)!important}}

@media(max-width:899px){.jmystery{grid-template-columns:1fr;padding:30px 24px;gap:10px}.jmystery .jmystery__heading{font-size:var(--jmystery-heading-mobile);margin:12px 0}.jmystery .jmystery__title{font-size:var(--jmystery-title-mobile)}.jmystery .jmystery__body{font-size:var(--jmystery-body-mobile)}.jmystery .jmystery__button-type{font-size:var(--jmystery-button-mobile)}.jmystery__eyebrow{font-size:calc(var(--jmystery-button-mobile)*.75)!important}.jmystery__intro{max-width:none}.jmystery__visual{width:100%;max-width:400px;margin:auto}.jmystery__art{max-width:300px;margin:auto}.jmystery__peek{margin-top:-10px}.jmystery__offer{margin-top:12px}.jmystery__offer .jmystery__eyebrow{display:none}.jmystery__offer .jmystery__title{margin:8px 0 10px;max-width:none}.jmystery .jmystery__note{font-size:calc(var(--jmystery-body-mobile)*.85);margin-top:12px}.jmystery .jmystery__price{margin-bottom:12px}.jmystery .jmystery__reveal-title{font-size:var(--jmystery-title-mobile)}.jmystery__reveal{padding:20px}.jmystery__reveal .jmystery__body{font-size:var(--jmystery-body-mobile)}}

@media(prefers-reduced-motion:reduce){.jmystery *{transition:none!important;animation:none!important}.jmystery .jmystery__art,.jmystery .jmystery__primary{transform:none!important}}.jmystery[data-motion=false] *{transition:none!important}.jmystery[data-motion=false] .jmystery__art{transform:none!important}




.jmystery{scroll-margin-top:110px}.jmystery__tiers{list-style:none;padding:0;margin:16px 0}.jmystery__tiers li+li{border-top:1px solid color-mix(in srgb,var(--june-ink,#171717) 20%,transparent)}.jmystery__tiers a{display:flex;flex-wrap:wrap;gap:5px 16px;justify-content:space-between;min-height:48px;align-items:center;text-decoration:underline;text-underline-offset:4px}.jmystery__tiers span{font-size:.9em}.jmystery__note{opacity:1!important}
@media(max-width:899px){.jmystery__art{height:210px!important}.jmystery__reveal{position:static!important;transform:none!important;width:auto!important;margin:12px 0;max-width:none}.jmystery__peek[open]{display:flex;flex-direction:column}.jmystery__peek summary{order:0}.jmystery__reveal{order:1}.jmystery__offer{margin-top:16px!important}}

@media(max-width:899px){.jmystery{padding:18px 24px;gap:4px}.jmystery .jmystery__heading{margin:8px 0}.jmystery__offer{margin-top:8px!important}.jmystery__offer .jmystery__title{margin:4px 0 8px}.jmystery__tiers{margin-block:8px}.jmystery .jmystery__price{margin-bottom:8px}.jmystery .jmystery__note{margin-top:8px}}
{% endstylesheet %}

<!-- Mobile visual repair: 6 October 2026 -->
<style>
@media(max-width:749px){.jmystery .jmystery__offer>.jmystery__price{display:none}.jmystery .jmystery__art img{height:100%;object-fit:contain}.jmystery .jmystery__peek{margin-top:12px}.jmystery .jmystery__tiers a{position:relative;padding-right:26px;min-height:58px}.jmystery .jmystery__tiers a:after{content:"↗";position:absolute;right:0}.jmystery .jmystery__visual{margin-bottom:8px}}
</style>
{% schema %}
{
  "name": "June · A little curious",
  "tag": "section",
  "class": "june-mystery-section",
  "max_blocks": 1,
  "settings": [
