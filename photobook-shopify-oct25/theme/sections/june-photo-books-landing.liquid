{% liquid
  assign studio_url = section.settings.studio_page.url | default: '/pages/photo-book-studio'
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign cf = section.settings.button_font
%}
{% style %}
{{ hf | font_face: font_display: 'swap' }}{{ bf | font_face: font_display: 'swap' }}{{ cf | font_face: font_display: 'swap' }}
#shopify-section-{{ section.id }} .pbl{--a:{{ section.settings.accent }};--i:{{ section.settings.ink }};--s:{{ section.settings.surface }};--hf:{{ hf.family }},{{ hf.fallback_families }};--bf:{{ bf.family }},{{ bf.fallback_families }};--cf:{{ cf.family }},{{ cf.fallback_families }};--hs:{{ section.settings.heading_size }}px;--hm:{{ section.settings.heading_mobile }}px;--hw:{{ section.settings.heading_weight }};--hl:{{ section.settings.heading_leading | divided_by: 100.0 }};--ht:{{ section.settings.heading_tracking | divided_by: 100.0 }}em;--bs:{{ section.settings.body_size }}px;--bm:{{ section.settings.body_mobile }}px;--bw:{{ section.settings.body_weight }};--bl:{{ section.settings.body_leading | divided_by: 100.0 }};--cs:{{ section.settings.button_size }}px;--cm:{{ section.settings.button_mobile }}px;--cw:{{ section.settings.button_weight }}}
{% endstyle %}
<section class="pbl">
 <div class="pbl__hero pbl__wrap"><div><p class="pbl__eye">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><div>{{ section.settings.intro }}</div><div class="pbl__prices"><span><b>Regular · 8 × 8 in</b><strong>₹2,799</strong></span><span><b>Large · 11 × 11 in</b><strong>₹3,099</strong></span></div><a class="pbl__cta" href="{{ studio_url }}"><span>{{ section.settings.cta }}</span><i>→</i></a><small>20 pages included · Add pages in sets of four · Your work saves as you go</small></div><div class="pbl__covers"><img src="{{ 'june-photobook-cover-3.jpg' | asset_url }}" alt="Photo book cover" width="650" height="650"><img src="{{ 'june-photobook-cover-12.jpg' | asset_url }}" alt="Photo book cover" width="650" height="650"><img src="{{ 'june-photobook-cover-21.jpg' | asset_url }}" alt="Photo book cover" width="650" height="650"></div></div>
 <div class="pbl__strip"><span>Thick lay-flat pages</span><span>Edit on your phone</span><span>Download your designed PDF</span></div>
 <div class="pbl__story pbl__wrap"><p class="pbl__eye">START WITH THE STORY</p><h2>Every camera roll has a book in it.</h2><div class="pbl__cards">{% for block in section.blocks %}{% if block.type == 'occasion' %}<a href="{{ studio_url }}?occasion={{ block.settings.title | handleize }}" {{ block.shopify_attributes }}><img src="{{ block.settings.asset | asset_url }}" alt="" width="600" height="700" loading="lazy"><b>{{ block.settings.title }} <i>↗</i></b></a>{% endif %}{% endfor %}</div></div>
 <div class="pbl__dark"><div class="pbl__quality pbl__wrap"><img src="{{ 'june-photobook-cover-18.jpg' | asset_url }}" alt="A June photo book cover" width="900" height="900" loading="lazy"><div><p class="pbl__eye">THE GOOD-PAPER PART</p><h2>A real book changes how a memory feels.</h2><p>Sharp colour, generous pages and a cover that belongs on the coffee table. Choose the photos; the studio helps turn them into a finished story.</p><ul><li><b>Lay-flat viewing</b> for panoramas and two-page moments</li><li><b>Durable premium pages</b> made for repeat opening</li><li><b>Two useful sizes</b> for gifts, trips and family archives</li><li><b>Clear final pricing</b> before anything reaches your bag</li></ul><a class="pbl__cta" href="{{ studio_url }}"><span>Create yours</span><i>→</i></a></div></div></div>
 <div class="pbl__steps pbl__wrap"><p class="pbl__eye">FROM PHOTOS TO PHOTO BOOK</p><h2>Three small steps. One very keepable thing.</h2><ol><li><b>1</b><span><strong>Choose the story</strong>Pick an occasion, cover and size.</span></li><li><b>2</b><span><strong>Make every page yours</strong>Add, crop, move, layer and write.</span></li><li><b>3</b><span><strong>Review, save and order</strong>See the price, download a PDF or add to your bag.</span></li></ol></div>
 <div class="pbl__save pbl__wrap"><div><p class="pbl__eye">CLOSE THE TAB. KEEP THE BOOK.</p><h2>Your progress stays with you.</h2><p>Uploaded ten photos and stopped at page three? Your draft saves on this device as you work, so an accidental close does not send you back to the beginning.</p></div><a class="pbl__cta" href="{{ studio_url }}"><span>Start my photo book</span><i>→</i></a></div>
 <div class="pbl__faq pbl__wrap"><div><p class="pbl__eye">BEFORE YOU BEGIN</p><h2>Good to know.</h2></div><div>{% for block in section.blocks %}{% if block.type == 'faq' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}<b>+</b></summary>{{ block.settings.a }}</details>{% endif %}{% endfor %}</div></div>
 <div class="pbl__final"><p class="pbl__eye">YOUR PHOTOS ARE READY WHEN YOU ARE</p><h2>Make the book you keep saying you’ll make.</h2><p>Regular from ₹2,799 · Large from ₹3,099</p><a class="pbl__cta" href="{{ studio_url }}"><span>{{ section.settings.cta }}</span><i>→</i></a></div>
</section>
{% stylesheet %}
.pbl{overflow:hidden;background:#fff;color:var(--i);font:var(--bw) var(--bs)/var(--bl) var(--bf)}.pbl *{box-sizing:border-box}.pbl__wrap{width:min(1680px,calc(100% - clamp(36px,8vw,160px)));margin:auto}.pbl h1,.pbl h2{font-family:var(--hf);font-weight:var(--hw);letter-spacing:var(--ht);line-height:var(--hl);margin:0}.pbl h1{font-size:var(--hs)}.pbl h2{font-size:clamp(42px,5vw,82px)}.pbl__eye{font-size:11px;font-weight:800;letter-spacing:.17em}.pbl__hero{display:grid;grid-template-columns:.9fr 1.1fr;gap:7vw;align-items:center;min-height:720px;padding-block:80px}.pbl__prices{display:flex;gap:10px;margin:25px 0}.pbl__prices span{display:grid;min-width:185px;padding:14px 17px;border:1px solid #ddd;border-radius:16px}.pbl__prices b{font-size:12px}.pbl__prices strong{font-size:25px}.pbl__cta{display:inline-flex;align-items:center;gap:26px;padding:8px 9px 8px 22px;border:2px solid;border-radius:999px;background:var(--a);color:var(--i);box-shadow:0 6px 0 var(--i);font:var(--cw) var(--cs) var(--cf);text-decoration:none}.pbl__cta i{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--i);color:#fff;font-style:normal}.pbl small{display:block;margin-top:18px;color:#666}.pbl__covers{position:relative;min-height:550px}.pbl__covers img{position:absolute;width:55%;aspect-ratio:1;object-fit:cover;border:2px solid;border-radius:28px;box-shadow:10px 12px 0 var(--i)}.pbl__covers img:nth-child(1){left:0;top:3%;transform:rotate(-8deg)}.pbl__covers img:nth-child(2){right:0;top:12%;transform:rotate(7deg)}.pbl__covers img:nth-child(3){left:24%;bottom:0}.pbl__strip{display:flex;justify-content:space-around;padding:18px;background:var(--i);color:#fff;font-size:12px;font-weight:800}.pbl__strip span:before{content:'✦';color:var(--a);margin-right:18px}.pbl__story,.pbl__steps,.pbl__faq{padding-block:110px}.pbl__cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:42px}.pbl__cards a{display:grid;gap:12px;color:inherit;text-decoration:none}.pbl__cards img{width:100%;aspect-ratio:.86;object-fit:cover;border:1px solid #ccc;border-radius:25px}.pbl__cards b{display:flex;justify-content:space-between}.pbl__cards i{font-style:normal}.pbl__dark{background:var(--i);color:#fff}.pbl__quality{display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:center;padding-block:110px}.pbl__quality>img{width:88%;aspect-ratio:1;object-fit:cover;border-radius:30px;transform:rotate(-4deg);box-shadow:18px 18px 0 var(--a)}.pbl__quality li{padding:12px 0;border-bottom:1px solid #555}.pbl__quality li b{display:block}.pbl__steps ol{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:0}.pbl__steps li{display:flex;gap:16px;padding:26px;border:1px solid #ddd;border-radius:24px}.pbl__steps strong{display:block}.pbl__save{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;padding:60px;border:2px solid;border-radius:35px;background:var(--s)}.pbl__save>div{max-width:760px}.pbl__faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:8vw}.pbl details{padding:20px 0;border-top:1px solid #bbb}.pbl summary{display:flex;justify-content:space-between;font-weight:800;cursor:pointer}.pbl__final{padding:110px 20px;text-align:center;background:linear-gradient(135deg,var(--a),#fff 70%)}.pbl__final h2{max-width:1000px;margin:auto;font-size:clamp(50px,7vw,110px)}
@media(max-width:1100px){.pbl{font-size:var(--bm)}.pbl__wrap{width:calc(100% - 36px)}.pbl h1{font-size:var(--hm)}.pbl h2{font-size:42px}.pbl__hero,.pbl__quality,.pbl__faq{grid-template-columns:1fr}.pbl__hero{padding-block:50px}.pbl__covers{min-height:390px}.pbl__prices{display:grid;grid-template-columns:1fr 1fr}.pbl__prices span{min-width:0}.pbl__cards{display:flex;overflow:auto;margin-right:-18px}.pbl__cards a{flex:0 0 74vw}.pbl__steps ol{grid-template-columns:1fr}.pbl__save{align-items:flex-start;flex-direction:column;padding:32px}.pbl__cta{font-size:var(--cm)}.pbl__strip{justify-content:flex-start;gap:30px;white-space:nowrap}}
{% endstylesheet %}
{% schema %}
{"name":"Photo books landing","max_blocks":16,"settings":[{"type":"page","id":"studio_page","label":"Studio page"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE JUNE PHOTO BOOK"},{"type":"text","id":"heading","label":"Heading","default":"Your camera roll deserves a cover."},{"type":"richtext","id":"intro","label":"Introduction","default":"<p>Turn trips, tiny moments and big days into a photo book you can actually pass around.</p>"},{"type":"text","id":"cta","label":"Button label","default":"Create your photo book"},{"type":"color","id":"accent","label":"Accent","default":"#CBF36B"},{"type":"color","id":"ink","label":"Ink","default":"#171717"},{"type":"color","id":"surface","label":"Soft background","default":"#F3EDFF"},{"type":"header","content":"Heading typography"},{"type":"font_picker","id":"heading_font","label":"Font family","default":"poppins_n9"},{"type":"range","id":"heading_size","label":"Desktop size","min":44,"max":116,"step":2,"default":92},{"type":"range","id":"heading_mobile","label":"Mobile size","min":38,"max":68,"step":1,"default":54},{"type":"range","id":"heading_weight","label":"Weight","min":500,"max":900,"step":100,"default":900},{"type":"range","id":"heading_tracking","label":"Letter spacing","min":-8,"max":8,"step":1,"default":-5},{"type":"range","id":"heading_leading","label":"Line height","min":85,"max":125,"step":5,"default":95},{"type":"header","content":"Body typography"},{"type":"font_picker","id":"body_font","label":"Font family","default":"poppins_n4"},{"type":"range","id":"body_size","label":"Desktop size","min":14,"max":24,"step":1,"default":18},{"type":"range","id":"body_mobile","label":"Mobile size","min":13,"max":20,"step":1,"default":16},{"type":"range","id":"body_weight","label":"Weight","min":400,"max":700,"step":100,"default":400},{"type":"range","id":"body_tracking","label":"Letter spacing","min":-4,"max":8,"step":1,"default":0},{"type":"range","id":"body_leading","label":"Line height","min":120,"max":180,"step":5,"default":150},{"type":"header","content":"Button typography"},{"type":"font_picker","id":"button_font","label":"Font family","default":"poppins_n8"},{"type":"range","id":"button_size","label":"Desktop size","min":13,"max":22,"step":1,"default":16},{"type":"range","id":"button_mobile","label":"Mobile size","min":12,"max":19,"step":1,"default":15},{"type":"range","id":"button_weight","label":"Weight","min":500,"max":900,"step":100,"default":800},{"type":"range","id":"button_tracking","label":"Letter spacing","min":-3,"max":8,"step":1,"default":0}],"blocks":[{"type":"occasion","name":"Occasion","settings":[{"type":"text","id":"title","label":"Title","default":"Anniversary"},{"type":"text","id":"asset","label":"Asset filename","default":"june-photobook-anniversary.jpg"}]},{"type":"faq","name":"FAQ","settings":[{"type":"text","id":"q","label":"Question","default":"How much does it cost?"},{"type":"richtext","id":"a","label":"Answer","default":"<p>Regular starts at ₹2,799 and Large starts at ₹3,099.</p>"}]}],"presets":[{"name":"Photo books landing"}]}
{% endschema %}
