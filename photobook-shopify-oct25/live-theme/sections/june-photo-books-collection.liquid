<section class="jpbc" style="--accent:{{ section.settings.accent }};--heading-size:{{ section.settings.heading_size }}px;--heading-mobile:{{ section.settings.heading_size_mobile }}px;--heading-weight:{{ section.settings.heading_weight }};--heading-spacing:{{ section.settings.heading_spacing | divided_by: 100.0 }}em;--heading-leading:{{ section.settings.heading_leading | divided_by: 100.0 }};--body-size:{{ section.settings.body_size }}px;--body-mobile:{{ section.settings.body_size_mobile }}px;--body-weight:{{ section.settings.body_weight }};--body-spacing:{{ section.settings.body_spacing | divided_by: 100.0 }}em;--body-leading:{{ section.settings.body_leading | divided_by: 100.0 }}">
  <header><p>THE JUNE PHOTO BOOKS</p><h1>{{ collection.title }}</h1><div>{{ collection.description }}</div></header>
  <div class="jpbc__grid">
    {% for product in collection.products %}
      <a href="{{ product.url }}" class="jpbc__card">
        {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 750px) 42vw, 92vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
        <div><h2>{{ product.title }}</h2><p>From {{ product.price_min | money }}</p><span>Start creating <i aria-hidden="true">→</i></span></div>
      </a>
    {% else %}
      <div class="jpbc__empty"><h2>Your photo book is being prepared.</h2><p>Add the June Photo Book product to this collection to preview it here.</p></div>
    {% endfor %}
  </div>
</section>
{% stylesheet %}
  .jpbc{max-width:1680px;margin:auto;padding:clamp(54px,8vw,120px) clamp(20px,6vw,96px);color:#171717}.jpbc header{max-width:920px}.jpbc header>p{font-size:11px;font-weight:800;letter-spacing:.16em}.jpbc h1{margin:12px 0;font-size:var(--heading-size);font-weight:var(--heading-weight);letter-spacing:var(--heading-spacing);line-height:var(--heading-leading)}.jpbc header>div{font-size:var(--body-size);font-weight:var(--body-weight);letter-spacing:var(--body-spacing);line-height:var(--body-leading)}.jpbc__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:46px}.jpbc__card{display:grid;grid-template-columns:1.2fr 1fr;min-height:380px;border:1px solid #dadada;border-radius:30px;overflow:hidden;color:#171717;text-decoration:none}.jpbc__card img,.jpbc__card svg{width:100%;height:100%;object-fit:cover;background:#f5f5f3}.jpbc__card>div{display:flex;flex-direction:column;justify-content:flex-end;padding:28px}.jpbc__card h2{font-size:32px;line-height:1;margin:0}.jpbc__card span{display:flex;justify-content:space-between;align-items:center;margin-top:24px;padding:8px 9px 8px 18px;border:2px solid;border-radius:999px;background:var(--accent);font-weight:800}.jpbc__card i{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#171717;color:#fff;font-style:normal}.jpbc__empty{padding:35px;border:2px dashed;border-radius:24px}@media(max-width:749px){.jpbc{padding:42px 18px}.jpbc h1{font-size:var(--heading-mobile)}.jpbc header>div{font-size:var(--body-mobile)}.jpbc__grid{grid-template-columns:1fr}.jpbc__card{grid-template-columns:1fr;min-height:0}.jpbc__card img,.jpbc__card svg{aspect-ratio:1}}
{% endstylesheet %}
{% schema %}
{"name":"Photo books collection","settings":[{"type":"color","id":"accent","label":"Accent","default":"#CBF36B"},{"type":"header","content":"Heading typography"},{"type":"range","id":"heading_size","label":"Desktop size","min":40,"max":104,"step":2,"unit":"px","default":82},{"type":"range","id":"heading_size_mobile","label":"Mobile size","min":34,"max":64,"step":1,"unit":"px","default":50},{"type":"range","id":"heading_weight","label":"Weight","min":500,"max":900,"step":100,"default":900},{"type":"range","id":"heading_spacing","label":"Letter spacing","min":-8,"max":8,"step":1,"default":-5},{"type":"range","id":"heading_leading","label":"Line height","min":85,"max":130,"step":5,"default":95},{"type":"header","content":"Supporting copy typography"},{"type":"range","id":"body_size","label":"Desktop size","min":14,"max":26,"step":1,"unit":"px","default":18},{"type":"range","id":"body_size_mobile","label":"Mobile size","min":13,"max":21,"step":1,"unit":"px","default":16},{"type":"range","id":"body_weight","label":"Weight","min":400,"max":700,"step":100,"default":400},{"type":"range","id":"body_spacing","label":"Letter spacing","min":-4,"max":8,"step":1,"default":0},{"type":"range","id":"body_leading","label":"Line height","min":120,"max":180,"step":5,"default":150}],"presets":[{"name":"Photo books collection"}]}
{% endschema %}
