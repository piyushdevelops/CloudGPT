{% style %}
/* June tab treatment A: navigation-only; uses existing merchant accent. */
#{{ hero_id }} .jh__tabs{position:relative;isolation:isolate;--jh-tab-index:0}
#{{ hero_id }} .jh__tabs:has(.jh__tab[data-target="limited"][aria-selected="true"]){--jh-tab-index:1}
#{{ hero_id }} .jh__tabs:has(.jh__tab[data-target="dated"][aria-selected="true"]){--jh-tab-index:2}
#{{ hero_id }} .jh__tabs:has(.jh__tab[data-target="life"][aria-selected="true"]){--jh-tab-index:3}
#{{ hero_id }} .jh__tabs::before,#{{ hero_id }} .jh__tabs::after{content:"";position:absolute;pointer-events:none;transition:left .32s cubic-bezier(.2,.8,.2,1)}
#{{ hero_id }} .jh__tabs::before{left:calc(var(--jh-tab-index)*25%);top:0;bottom:0;width:25%;background:linear-gradient(color-mix(in srgb,var(--jh-accent) 32%,transparent),color-mix(in srgb,var(--jh-accent) 9%,transparent));z-index:0}
#{{ hero_id }} .jh__tabs::after{left:calc(var(--jh-tab-index)*25% + 6%);bottom:0;width:13%;height:3px;border-radius:3px 3px 0 0;background:color-mix(in srgb,var(--jh-accent) 65%,var(--jh-ink));z-index:2}
#{{ hero_id }} .jh__tab{z-index:1}
#{{ hero_id }} .jh__tab[aria-selected="true"]::after{display:none}
#{{ hero_id }} .jh__tab[aria-selected="true"]>svg{color:color-mix(in srgb,var(--jh-accent) 60%,var(--jh-ink));animation:june-tab-ink-lift .42s cubic-bezier(.2,.8,.2,1)}
@keyframes june-tab-ink-lift{0%,100%{transform:translateY(0) rotate(0)}40%{transform:translateY(-4px) rotate(-6deg)}}
@media(prefers-reduced-motion:reduce){#{{ hero_id }} .jh__tabs::before,#{{ hero_id }} .jh__tabs::after{transition:none}#{{ hero_id }} .jh__tab[aria-selected="true"]>svg{animation:none}}
{% endstyle %}

