if (!customElements.get('june-make-room')) {
  customElements.define('june-make-room', class extends HTMLElement {
    connectedCallback() {
      if (this.ready) { document.addEventListener('shopify:block:select', this.editorHandler); this.setupTextSequence(); this.setupYearSequence(); return; }
      this.ready = true;
      this.tabs = [...this.querySelectorAll('[data-target]')];
      this.panels = [...this.querySelectorAll('[data-panel]')];
      this.querySelector('.jh__tabs').setAttribute('role', 'tablist');
      this.tabs.forEach(tab => {
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', this.id + '-' + tab.dataset.target);
        tab.addEventListener('click', event => { event.preventDefault(); this.select(tab.dataset.target); });
        tab.addEventListener('keydown', event => {
          const index = this.tabs.indexOf(tab);
          let next;
          if (event.key === 'ArrowRight') next = (index + 1) % this.tabs.length;
          if (event.key === 'ArrowLeft') next = (index + this.tabs.length - 1) % this.tabs.length;
          if (event.key === 'Home') next = 0;
          if (event.key === 'End') next = this.tabs.length - 1;
          if (event.key === ' ') { event.preventDefault(); this.select(tab.dataset.target); }
          if (next !== undefined) { event.preventDefault(); this.tabs[next].focus(); this.select(this.tabs[next].dataset.target); }
        });
      });
      this.panels.forEach(panel => {
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', this.id + '-tab-' + panel.dataset.panel);
        panel.tabIndex = 0;
      });
      const launch = this.querySelector('.jh__form');
      this.select(launch && (launch.querySelector('.jh__success, .jh__error') || location.hash.startsWith('#' + this.id + '-launch')) ? 'dated' : 'undated');
      launch?.addEventListener('submit', () => { launch.action = launch.action.split('#')[0] + '#' + this.id + '-launch'; });
      this.editorHandler = event => { if (!this.contains(event.target)) return; if (event.target.closest('.jh__life-item')) this.select('life'); if (event.target.closest('.jh__year-wrap')) this.select('dated'); };
      document.addEventListener('shopify:block:select', this.editorHandler);
      this.setupTextSequence();
      this.setupYearSequence();
    }
    disconnectedCallback() {
      document.removeEventListener('shopify:block:select', this.editorHandler);
      this.textObserver?.disconnect();
      this.motionPreference?.removeEventListener('change', this.motionHandler);
      this.stopTextSequence();
      this.stopYearSequence();
      this.yearObserver?.disconnect();
      this.yearMedia?.removeEventListener('change', this.yearMotionHandler);
      document.removeEventListener('visibilitychange', this.yearVisibilityHandler);
      this.yearControl?.removeEventListener('click', this.yearControlHandler);
    }
    setupTextSequence() {
      this.motionSpeed = Math.max(.5, Math.min(2, Number(this.dataset.motionSpeed) / 100 || 1));
      this.motionPlays = this.dataset.motionLoop === 'true' ? Infinity : Math.max(1, Math.min(10, Number(this.dataset.motionPlays) || 1));
      this.motionGap = Math.max(1, Math.min(20, Number(this.dataset.motionGap) || 4)) * 1000;
      if (this.dataset.textMotion === 'false') return;
      this.motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
      this.motionHandler = () => { if (this.motionPreference.matches) this.stopTextSequence(); };
      this.motionPreference.addEventListener('change', this.motionHandler);
      const panel = this.querySelector('[data-panel="undated"]');
      const body = panel.querySelector('.jh__body');
      const walker = document.createTreeWalker(body, NodeFilter.SHOW_TEXT);
      const nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      nodes.forEach(node => {
        if (node.parentElement.closest('[data-glow]')) return;
        const pieces = node.textContent.split(/(\bany\b|\byours\b)/gi);
        if (pieces.length < 2) return;
        const fragment = document.createDocumentFragment();
        pieces.forEach((part, index) => {
          if (index % 2) {
            const span = document.createElement('span');
            span.className = 'jh__word-glow'; span.dataset.glow = part.toLowerCase(); span.textContent = part;
            fragment.append(span);
          } else fragment.append(document.createTextNode(part));
        });
        node.replaceWith(fragment);
      });
      document.fonts.ready.then(() => {
        if (!this.isConnected || this.motionPreference.matches || !('IntersectionObserver' in window)) return;
        this.textObserver = new IntersectionObserver(entries => {
          const entry = entries[0];
          if (entry.isIntersecting && entry.intersectionRatio >= .6 && !panel.hidden && !this.textPlayed) {
            this.textPlayed = true; this.textStopped = false;
            this.runTextSequence(panel);
          } else if (!entry.isIntersecting && this.textPlayed) this.stopTextSequence();
        }, { threshold: [0, .6] });
        this.textObserver.observe(panel.querySelector('.jh__copy'));
      });
    }
    stopTextSequence() {
      this.textStopped = true;
      this.textRun = (this.textRun || 0) + 1;
      if (this.dataset.motionLoop === 'true') this.textPlayed = false;
      this.textAnimation?.cancel();
      clearTimeout(this.repeatTimer);
      this.repeatResolve?.();
      this.repeatResolve = null;
    }
    async textStep(element, frames, duration, delay = 100) {
      if (!element || this.textStopped || this.motionPreference.matches || !this.isConnected) return;
      this.textAnimation = element.animate(frames, { duration: duration / this.motionSpeed, delay: delay / this.motionSpeed, easing: 'ease-in-out', fill: 'none' });
      await this.textAnimation.finished;
    }
    async runTextSequence(panel) {
      const sequence = this.textRun || 0;
      try {
        for (let play = 0; play < this.motionPlays && !this.textStopped && sequence === (this.textRun || 0); play++) {
        await this.textStep(panel.querySelector('.jh__title-ink'), [
          { transform: 'scale(1)' }, { transform: 'scale(1.025)', offset: .48 }, { transform: 'scale(1)' }
        ], 700, 180);
        const plans = panel.querySelector('.jh__subtitle strong');
        if (plans) {
          const subtitle = plans.parentElement;
          const base = parseFloat(getComputedStyle(plans).letterSpacing) || 0;
          const peak = base + Math.min(.65, parseFloat(getComputedStyle(plans).fontSize) * .025);
          const height = subtitle.getBoundingClientRect().height;
          const savedSpacing = plans.style.letterSpacing;
          plans.style.letterSpacing = peak + 'px';
          const fits = subtitle.getBoundingClientRect().height <= height + 1 && subtitle.scrollWidth <= subtitle.clientWidth;
          plans.style.letterSpacing = savedSpacing;
          await this.textStep(plans, fits ? [
            { letterSpacing: base + 'px' }, { letterSpacing: peak + 'px', offset: .5 }, { letterSpacing: base + 'px' }
          ] : [{ opacity: 1 }, { opacity: .7, offset: .5 }, { opacity: 1 }], 750);
        }
        const accent = getComputedStyle(this).getPropertyValue('--jh-accent').trim() || '#F5A477';
        const glow = [
          { backgroundColor: `color-mix(in srgb, ${accent} 0%, transparent)`, boxShadow: `0 0 0 color-mix(in srgb, ${accent} 0%, transparent)` },
          { backgroundColor: `color-mix(in srgb, ${accent} 45%, transparent)`, boxShadow: `0 0 12px color-mix(in srgb, ${accent} 60%, transparent)`, offset: .45 },
          { backgroundColor: `color-mix(in srgb, ${accent} 0%, transparent)`, boxShadow: `0 0 0 color-mix(in srgb, ${accent} 0%, transparent)` }
        ];
        await this.textStep(panel.querySelector('[data-glow="any"]'), glow, 650);
        await this.textStep(panel.querySelector('[data-glow="yours"]'), glow, 750);
        if (!this.textStopped && play + 1 < this.motionPlays) {
          await new Promise(resolve => { this.repeatResolve = resolve; this.repeatTimer = setTimeout(resolve, this.motionGap); });
          this.repeatResolve = null;
        }
        }
        if (this.dataset.motionLoop !== 'true') this.textObserver?.disconnect();
      } catch (error) {
        if (error.name !== 'AbortError') console.error('June text sequence:', error);
      }
    }
    setupYearSequence() {
      this.year = this.querySelector('.jh__year[data-year-effect]');
      this.yearControl = this.querySelector('.jh__year-control');
      if (!this.year || !this.yearControl) return;
      this.yearMedia = matchMedia('(prefers-reduced-motion: reduce)');
      this.yearInView = false;
      this.yearMotionHandler = () => {
        if (this.yearMedia.matches) this.stopYearSequence();
        else if (this.activeTab === 'dated') this.startYearSequence();
        this.updateYearPlayback();
      };
      this.yearVisibilityHandler = () => this.updateYearPlayback();
      this.yearControlHandler = () => {
        if (this.yearDone) { this.yearUserPaused = false; this.startYearSequence(); }
        else { this.yearUserPaused = !this.yearUserPaused; this.updateYearPlayback(); }
      };
      this.yearControl.addEventListener('click', this.yearControlHandler);
      this.yearMedia.addEventListener('change', this.yearMotionHandler);
      document.addEventListener('visibilitychange', this.yearVisibilityHandler);
      if ('IntersectionObserver' in window) {
        this.yearObserver = new IntersectionObserver(entries => {
          this.yearInView = entries[0].isIntersecting;
          this.updateYearPlayback();
        }, { threshold: 0 });
        this.yearObserver.observe(this.year);
      } else this.yearInView = true;
      if (this.activeTab === 'dated') this.startYearSequence();
    }
    updateYearPlayback() {
      if (!this.yearControl) return;
      const enabled = this.year.dataset.enabled !== 'false' && !this.yearMedia.matches;
      this.yearControl.hidden = !enabled;
      const label = this.yearDone ? this.yearControl.dataset.replayLabel : this.yearUserPaused ? this.yearControl.dataset.playLabel : this.yearControl.dataset.pauseLabel;
      this.yearControl.textContent = this.yearDone ? '↻' : this.yearUserPaused ? '▶' : 'Ⅱ';
      this.yearControl.setAttribute('aria-label', label);
      this.yearControl.setAttribute('title', label);
      this.yearControl.setAttribute('aria-pressed', String(Boolean(this.yearUserPaused)));
      if (this.yearDone) return;
      const paused = !enabled || this.activeTab !== 'dated' || !this.yearInView || document.hidden || this.yearUserPaused;
      for (const animation of [this.yearAnimation, ...(this.yearRollAnimations || [])].filter(Boolean)) { if (paused) animation.pause(); else animation.play(); }
    }
    stopYearSequence() {
      this.yearRun = (this.yearRun || 0) + 1;
      this.yearAnimation?.cancel();
      this.yearRollAnimations?.forEach(animation => animation.cancel());
      this.yearRollAnimations = [];
      this.yearAnimation = null;
      this.yearDone = false;
      if (this.year) { delete this.year.dataset.activeDigit; delete this.year.dataset.sequencePlay; }
    }
    async yearStep(element, frames, duration, iterations = 1) {
      if (!this.isConnected || this.yearMedia.matches) return;
      this.yearAnimation = element.animate(frames, { duration, iterations, fill: 'none', easing: 'linear' });
      this.updateYearPlayback();
      await this.yearAnimation.finished;
    }
    async startYearSequence() {
      this.stopYearSequence();
      this.updateYearPlayback();
      if (this.year.dataset.enabled === 'false' || this.yearMedia.matches || this.activeTab !== 'dated') return;
      const run = this.yearRun;
      const number = (key, fallback) => Number.isFinite(Number(this.year.dataset[key])) ? Number(this.year.dataset[key]) : fallback;
      const speed = Math.max(.5, Math.min(2, number('speed', 100) / 100));
      const duration = Math.max(600, number('rollDuration', 1800) / speed);
      const stagger = number('rollStagger', 180) / speed;
      const turns = Math.max(1, Math.min(3, number('rollTurns', 1)));
      const digits = [...this.year.querySelectorAll('.jh__digit')];
      const plays = this.year.dataset.loop === 'true' ? Infinity : Math.max(1, Math.min(10, number('plays', 1)));
      const wait = ms => ms > 0 ? this.yearStep(this.year, [{opacity:1},{opacity:1}], ms / speed) : Promise.resolve();
      try {
        await wait(number('start', 600));
        for (let play = 0; play < plays && run === this.yearRun; play++) {
          this.year.dataset.sequencePlay = String(play + 1);
          this.yearRollAnimations = digits.map((digit, i) => {
            const track = digit.querySelector('.jh__digit-track');
            const target = Number(digit.querySelector('.jh__digit-flash').textContent);
            const steps = turns * 10;
            track.replaceChildren(...Array.from({length:steps + 1}, (_, n) => {
              const face = document.createElement('span');
              face.className = 'jh__digit-face';
              face.textContent = String((target + n) % 10);
              return face;
            }));
            const finish = steps * 100 / (steps + 1);
            const bounce = Math.max(0, Math.min(4, number('landingBounce', 2))) / (steps + 1);
            return track.animate([{transform:'translateY(0)',offset:0,easing:'cubic-bezier(.18,.65,.2,1)'},{transform:'translateY(-' + (finish + bounce) + '%)',offset:.88,easing:'ease-out'},{transform:'translateY(-' + finish + '%)',offset:1}], {duration,delay:i * stagger,fill:'none'});
          });
          this.updateYearPlayback();
          await Promise.all(this.yearRollAnimations.map(animation => animation.finished));
          this.yearRollAnimations = [];
          if (run !== this.yearRun) return;
          const strength = Math.max(.2, Math.min(1, number('intensity', 100) / 100));
          this.yearRollAnimations = digits.map(digit => digit.querySelector('.jh__digit-flash').animate([{opacity:0},{opacity:strength,offset:.25},{opacity:strength,offset:.6},{opacity:0}], {duration:Math.max(300, number('highlightDuration',700) / speed),fill:'none',easing:'ease-in-out'}));
          this.updateYearPlayback();
          await Promise.all(this.yearRollAnimations.map(animation => animation.finished));
          this.yearRollAnimations = [];
          if (play + 1 < plays && run === this.yearRun) await wait(number('repeatGap', 3000));
        }
        if (run === this.yearRun) { this.yearDone = true; this.yearAnimation = null; this.updateYearPlayback(); }
      } catch (error) {
        if (error.name !== 'AbortError') console.error('June year effect:', error);
      }
    }
    select(key) {
      if (key !== 'undated' && this.textPlayed) this.stopTextSequence();
      this.tabs.forEach(tab => { const active = tab.dataset.target === key; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; });
