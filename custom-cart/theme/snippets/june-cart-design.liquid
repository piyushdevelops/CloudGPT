{% doc %}
  June cart presentation; retains native cart components and GoKwik checkout.
  @param {section} section - Cart drawer section.
{% enddoc %}
{% assign type = section.blocks | where: 'type', 'june_typography' | first %}
{% style %}
{% assign font = type.settings.heading_font | font_modify: 'weight', type.settings.heading_weight %}{{ font | font_face: font_display: 'swap' }}
{% assign font = type.settings.body_font | font_modify: 'weight', type.settings.body_weight %}{{ font | font_face: font_display: 'swap' }}
{% assign font = type.settings.action_font | font_modify: 'weight', type.settings.action_weight %}{{ font | font_face: font_display: 'swap' }}
{% assign font = type.settings.price_font | font_modify: 'weight', type.settings.price_weight %}{{ font | font_face: font_display: 'swap' }}
#CartDrawer{
--jc-bg:var(--june-bg,#fff);--jc-ink:var(--june-ink,#171717);--jc-border:var(--june-border,#ddd);
width:min({{ section.settings.june_width | default: 460 }}px,100vw)!important;max-width:100vw!important;
height:100dvh;max-height:100dvh;margin:0 0 0 auto;padding:0;border:0;border-radius:24px 0 0 24px;
background:var(--jc-bg);color:var(--jc-ink);overflow:hidden;
}
#CartDrawer::backdrop{background:rgb(23 23 23 / .36);backdrop-filter:blur(3px)}
#CartDrawer .hdt-dialog-drawer__header{padding:22px 24px 18px;margin:0;min-height:80px;border-bottom:1px solid var(--jc-border);gap:12px;background:var(--jc-bg)}
#CartDrawer .hdt-dialog-drawer__header button{width:44px;height:44px;flex-shrink:0;border:1px solid var(--jc-border);border-radius:50%;display:grid;place-items:center}
#CartDrawer .hdt-dialog-drawer__inner{padding:0;min-height:0;flex:1;display:flex;flex-direction:column;overflow:hidden}
#CartDrawer .hdt-mini-cart__wrap{min-height:0;flex:1;height:auto;overflow:hidden}
#CartDrawer .hdt-mini-cart__main{min-height:0;flex:1;overflow:auto}
#CartDrawer .hdt-mini-cart__sroll{padding:0 24px;height:100%;overflow:auto}
#CartDrawer .hdt-mini-cart__item{margin:0;padding:22px 0;gap:16px;border-bottom:1px solid var(--jc-border);align-items:flex-start}
#CartDrawer .hdt-mini-cart__image{width:92px;flex:0 0 92px;max-width:92px}
#CartDrawer .hdt-mini-cart__img{border-radius:10px;background:var(--june-surface,#f5f5f3);height:116px}
#CartDrawer .hdt-mini-cart__img img{object-fit:contain}
#CartDrawer .hdt-mini-cart__info{min-width:0;flex:1;padding:0}
#CartDrawer .hdt-mini-cart__title{white-space:normal;overflow:visible;display:block;margin:0 0 5px;text-decoration:none}
#CartDrawer .hdt-mini-cart__meta-variant{margin:0 0 7px;color:var(--june-muted,#656565)}
#CartDrawer .hdt-mini-cart__price{margin:8px 0 12px;display:flex;gap:7px;align-items:baseline;flex-wrap:wrap}
#CartDrawer .hdt-mini-cart__price del,#CartDrawer .hdt-compare-at-price{font-size:12px!important;color:var(--june-muted,#656565);font-weight:400!important}
#CartDrawer .hdt-mini-cart__btns>div{display:flex;gap:14px;align-items:center;width:100%;justify-content:space-between}
#CartDrawer .hdt-quantity-wrapper{width:112px;height:40px;border:1px solid var(--jc-border);border-radius:20px;background:transparent}
#CartDrawer .hdt-quantity__button{width:36px;height:38px;padding:10px!important}
#CartDrawer .hdt-quantity-input{width:100%;height:38px;padding:0 36px!important;font-size:14px!important;appearance:textfield}
#CartDrawer .hdt-mini-cart__remove{margin:0;min-height:40px;display:flex;align-items:center;text-decoration:underline;font-size:12px;cursor:pointer}
#CartDrawer .hdt-mini-cart__bottom{flex:none;max-height:48dvh;overflow:auto;border-top:1px solid var(--jc-border);background:var(--jc-bg);padding:16px 24px max(18px,env(safe-area-inset-bottom));box-shadow:0 -8px 24px rgb(0 0 0 / .025)}
#CartDrawer .hdt-mini-cart__bottom-wrap{padding:0}
#CartDrawer .hdt-mini-cart__tool:empty{display:none}
#CartDrawer .hdt-mini-cart__tool{padding:0;margin:0 0 8px}
#CartDrawer .june-cart-savings{display:flex;align-items:center;justify-content:space-between;gap:12px;background:color-mix(in srgb,var(--june-accent,#bfaee8) 20%,var(--jc-bg));padding:10px 12px;border-radius:9px;margin-bottom:12px;font-size:12px}
#CartDrawer .hdt-mini-cart__totals{margin:0 0 14px;gap:10px}
#CartDrawer .hdt-mini-cart__total{font-size:15px;font-weight:600;margin:0}
#CartDrawer .hdt-mini-cart__view-checkout{display:flex;flex-direction:column;gap:9px;margin:0}
#CartDrawer .gokwik-checkout{order:-1;width:100%;margin:0}
#CartDrawer .gokwik-checkout button,#CartDrawer .hdt-mini-cart__btn-checkout{width:100%;min-height:52px;border:1.5px solid var(--jc-ink)!important;border-radius:999px;background:var(--june-accent,#bfaee8)!important;color:var(--jc-ink)!important;padding:10px 18px;box-shadow:0 2px 0 var(--jc-ink)}
#CartDrawer .gokwik-checkout .btn-text{color:var(--jc-ink)!important}
#CartDrawer .gokwik-checkout .pay-opt-icon{margin-left:auto;align-items:center}
#CartDrawer .hdt-mini-cart__btn-viewcart{min-height:30px;border:0;background:none;box-shadow:none;text-decoration:underline;font-size:12px}
#CartDrawer .hdt-mini-cart__emty{display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:65dvh;padding:30px 12px}
#CartDrawer .june-cart-bag{width:82px;height:92px;margin-bottom:28px;transform:rotate(-6deg)}
#CartDrawer .hdt-mini-cart__emty-heading{max-width:280px;margin:0 0 12px}
#CartDrawer .hdt-mini-cart__emty p{max-width:280px;color:var(--june-muted,#656565);margin:0 0 24px}
#CartDrawer .hdt-mini-cart__emty-button{border:1.5px solid var(--jc-ink);border-radius:999px;background:var(--june-accent,#bfaee8);color:var(--jc-ink);min-height:48px;padding:12px 22px}
#CartDrawer :focus-visible{outline:2px solid var(--jc-ink);outline-offset:3px}
@media(max-width:749px){#CartDrawer{width:100vw!important;border-radius:0}#CartDrawer .hdt-dialog-drawer__header{padding:14px 18px;min-height:72px}#CartDrawer .hdt-mini-cart__sroll{padding:0 18px}#CartDrawer .hdt-mini-cart__item{padding:18px 0;gap:12px}#CartDrawer .hdt-mini-cart__bottom{padding:14px 18px max(18px,env(safe-area-inset-bottom))}}
#CartDrawer .hdt-mini-cart__header-title,#CartDrawer .hdt-mini-cart__emty-heading{font-family:{{ type.settings.heading_font.family | default: 'Poppins' }},sans-serif!important;font-weight:{{ type.settings.heading_weight | default: 700 }}!important;font-size:{{ type.settings.heading_size | default: 28 }}px!important;letter-spacing:{{ type.settings.heading_tracking | default: 0 | times: 0.01 }}em!important;line-height:{{ type.settings.heading_line | default: 14 | times: 0.1 }}!important}
@media(max-width:749px){#CartDrawer .hdt-mini-cart__header-title,#CartDrawer .hdt-mini-cart__emty-heading{font-size:{{ type.settings.heading_mobile | default: 28 }}px!important}}
#CartDrawer .hdt-mini-cart__title,#CartDrawer .hdt-mini-cart__emty p{font-family:{{ type.settings.body_font.family | default: 'Poppins' }},sans-serif!important;font-weight:{{ type.settings.body_weight | default: 700 }}!important;font-size:{{ type.settings.body_size | default: 14 }}px!important;letter-spacing:{{ type.settings.body_tracking | default: 0 | times: 0.01 }}em!important;line-height:{{ type.settings.body_line | default: 14 | times: 0.1 }}!important}
@media(max-width:749px){#CartDrawer .hdt-mini-cart__title,#CartDrawer .hdt-mini-cart__emty p{font-size:{{ type.settings.body_mobile | default: 14 }}px!important}}
#CartDrawer .gokwik-checkout .btn-text>span:first-child,#CartDrawer .hdt-mini-cart__btn-checkout,#CartDrawer .hdt-mini-cart__emty-button{font-family:{{ type.settings.action_font.family | default: 'Poppins' }},sans-serif!important;font-weight:{{ type.settings.action_weight | default: 700 }}!important;font-size:{{ type.settings.action_size | default: 14 }}px!important;letter-spacing:{{ type.settings.action_tracking | default: 0 | times: 0.01 }}em!important;line-height:{{ type.settings.action_line | default: 14 | times: 0.1 }}!important}
@media(max-width:749px){#CartDrawer .gokwik-checkout .btn-text>span:first-child,#CartDrawer .hdt-mini-cart__btn-checkout,#CartDrawer .hdt-mini-cart__emty-button{font-size:{{ type.settings.action_mobile | default: 14 }}px!important}}
#CartDrawer .hdt-mini-cart__value,#CartDrawer .hdt-mini-cart__price .hdt-price{font-family:{{ type.settings.price_font.family | default: 'Poppins' }},sans-serif!important;font-weight:{{ type.settings.price_weight | default: 700 }}!important;font-size:{{ type.settings.price_size | default: 23 }}px!important;letter-spacing:{{ type.settings.price_tracking | default: 0 | times: 0.01 }}em!important;line-height:{{ type.settings.price_line | default: 14 | times: 0.1 }}!important}
@media(max-width:749px){#CartDrawer .hdt-mini-cart__value,#CartDrawer .hdt-mini-cart__price .hdt-price{font-size:{{ type.settings.price_mobile | default: 23 }}px!important}}
#CartDrawer .hdt-mini-cart__price .hdt-price{color:var(--jc-ink)!important}
#CartDrawer .hdt-mini-cart__btn-viewcart{display:flex!important;align-items:center;justify-content:center;padding:4px!important;height:auto!important;min-height:28px!important;color:var(--jc-ink)!important}
#CartDrawer .hdt-mini-cart__btn-viewcart span{display:inline!important;visibility:visible!important;opacity:1!important;transform:none!important}
#CartDrawer .hdt-mini-cart__btn-viewcart::before,#CartDrawer .hdt-mini-cart__btn-viewcart::after{display:none!important}
{% endstyle %}