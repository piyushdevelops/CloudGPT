{% if section.settings.use_master_palette == false %}

{% style %}#shopify-section-{{ section.id }}{--june-bg:initial;--june-surface:initial;--june-ink:initial;--june-muted:initial;--june-accent:initial;--june-on-accent:initial;--june-border:initial;--june-dark:initial;--june-on-dark:initial;}{% endstyle %}

{% endif %}

{% liquid

 assign typography = section.blocks | where: 'type', 'typography' | first

 assign type = typography.settings

 assign form_id = 'JuneNextForm-' | append: section.id

%}

{% style %}

#JuneNext-{{ section.id }}{--jn-bg:var(--june-bg,{{ section.settings.background }});--jn-ink:var(--june-ink,{{ section.settings.ink }});--jn-accent:var(--june-accent,{{ section.settings.accent }});--jn-pad:{{ section.settings.padding }}px;--jn-mobile-pad:{{ section.settings.mobile_padding }}px;--jn-duration:{{ 24000 | divided_by: section.settings.speed }}ms;}

{% assign face = type.heading_font | default: section.settings.fallback_font %}{% assign weight = type.heading_weight | default: 900 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneNext-{{ section.id }}{--jn-heading-font:{{ face.family }},{{ face.fallback_families }};--jn-heading-weight:{{ type.heading_weight | default: 900 }};--jn-heading-size:{{ type.heading_size | default: 52 }}px;--jn-heading-mobile:{{ type.heading_mobile | default: 34 }}px;--jn-heading-tracking:{{ type.heading_tracking | default: -2 | divided_by: 100.0 }}em;--jn-heading-leading:{{ type.heading_leading | default: 105 | divided_by: 100.0 }};}

{% assign face = type.year_font | default: section.settings.fallback_font %}{% assign weight = type.year_weight | default: 900 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneNext-{{ section.id }}{--jn-year-font:{{ face.family }},{{ face.fallback_families }};--jn-year-weight:{{ type.year_weight | default: 900 }};--jn-year-size:{{ type.year_size | default: 150 }}px;--jn-year-mobile:{{ type.year_mobile | default: 60 }}px;--jn-year-tracking:{{ type.year_tracking | default: -5 | divided_by: 100.0 }}em;--jn-year-leading:{{ type.year_leading | default: 100 | divided_by: 100.0 }};}

{% assign face = type.signup_font | default: section.settings.fallback_font %}{% assign weight = type.signup_weight | default: 900 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneNext-{{ section.id }}{--jn-signup-font:{{ face.family }},{{ face.fallback_families }};--jn-signup-weight:{{ type.signup_weight | default: 900 }};--jn-signup-size:{{ type.signup_size | default: 38 }}px;--jn-signup-mobile:{{ type.signup_mobile | default: 32 }}px;--jn-signup-tracking:{{ type.signup_tracking | default: -2 | divided_by: 100.0 }}em;--jn-signup-leading:{{ type.signup_leading | default: 105 | divided_by: 100.0 }};}

{% assign face = type.body_font | default: section.settings.fallback_font %}{% assign weight = type.body_weight | default: 400 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneNext-{{ section.id }}{--jn-body-font:{{ face.family }},{{ face.fallback_families }};--jn-body-weight:{{ type.body_weight | default: 400 }};--jn-body-size:{{ type.body_size | default: 16 }}px;--jn-body-mobile:{{ type.body_mobile | default: 16 }}px;--jn-body-tracking:{{ type.body_tracking | default: -1 | divided_by: 100.0 }}em;--jn-body-leading:{{ type.body_leading | default: 150 | divided_by: 100.0 }};}

{% assign face = type.button_font | default: section.settings.fallback_font %}{% assign weight = type.button_weight | default: 600 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}

#JuneNext-{{ section.id }}{--jn-button-font:{{ face.family }},{{ face.fallback_families }};--jn-button-weight:{{ type.button_weight | default: 600 }};--jn-button-size:{{ type.button_size | default: 14 }}px;--jn-button-mobile:{{ type.button_mobile | default: 14 }}px;--jn-button-tracking:{{ type.button_tracking | default: -1 | divided_by: 100.0 }}em;--jn-button-leading:{{ type.button_leading | default: 130 | divided_by: 100.0 }};}

{% assign face = type.body_font | default: section.settings.fallback_font %}{% assign bold = face | font_modify: 'weight', '700' %}{{ bold | font_face: font_display: 'swap' }}

{% endstyle %}

<section id="JuneNext-{{ section.id }}" class="jn{% if settings.june_type_enabled != false and section.settings.use_master_typography != false %} june-type{% endif %} jn--portal" data-portal-motion="{{ section.settings.portal_motion }}" style="--portal-glow:{{ section.settings.portal_glow }};--portal-duration:{{ section.settings.portal_duration }}s;--portal-tilt:{{ section.settings.portal_tilt }}deg" data-motion="{{ section.settings.motion }}" aria-labelledby="JuneNextHeading-{{ section.id }}">

 <div class="jn__teaser">

  <header class="jn__copy">

   <p class="jn__eyebrow jn__button-type">{{ section.settings.eyebrow | escape }}</p>

   <h2 id="JuneNextHeading-{{ section.id }}" class="jn__heading">{{ section.settings.heading | escape }}<br>{{ section.settings.heading_second | escape }}</h2>

   <p class="jn__caption jn__body">{{ section.settings.caption | escape }}</p>

  </header>

  <div class="jn__portal-scene">

   <div class="jn__doorway" aria-hidden="true"><div class="jn__door-light"></div></div>

   <div class="jn__light-spill" aria-hidden="true"></div>

   <div class="jn__stars" aria-hidden="true">{% for i in (1..5) %}<i style="--i:{{ i }}"></i>{% endfor %}</div>

   <div class="jn__portal-year"><span class="jn__year">{{ section.settings.year | escape }}</span><span class="jn__badge jn__button-type">{{ section.settings.badge | escape }}</span></div>

  </div>

 </div>

 <div class="jn__ticket">

  {% if section.settings.preorders_open %}
   <p class="jn__eyebrow jn__button-type">{{ section.settings.list_label | escape }}</p>
   <h3 class="jn__signup">Your 2027 planner is here.</h3>
   <p class="jn__body jn__description">{{ section.settings.preorders_body | escape }}</p>
   <a class="jn__submit jn__button-type" href="{{ section.settings.preorders_link | default: '/collections/2027-dated-planners' }}">{{ section.settings.preorders_button | escape }}<span class="jn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
  {% else %}
  {% form 'customer', id: form_id, class: 'jn__form' %}

   <input type="hidden" name="contact[tags]" value="newsletter,{{ section.settings.tag | escape }}">

   {% if form.posted_successfully? %}

    <div class="jn__success" role="status" tabindex="-1">

     <span class="jn__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>

     <h3 class="jn__signup">{{ section.settings.success_heading | escape }}</h3>

     <p class="jn__body">{{ section.settings.success_body | escape }}</p>

    </div>

   {% else %}

    <p class="jn__eyebrow jn__button-type">{{ section.settings.list_label | escape }}</p>

    <h3 class="jn__signup">{{ section.settings.signup_heading | escape }}</h3>

    <div class="jn__body jn__description">{{ section.settings.body }}</div>

    <div class="jn__perforation" aria-hidden="true"></div>

    {% if form.errors %}<div id="{{ form_id }}-error" class="jn__error jn__body" role="alert">{{ form.errors | default_errors }}</div>{% endif %}

    <label class="jn__button-type" for="{{ form_id }}-email">{{ section.settings.email_label | escape }}</label>

    <input class="jn__email jn__body" id="{{ form_id }}-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocapitalize="off" spellcheck="false" required placeholder="{{ section.settings.placeholder | escape }}" aria-describedby="{{ form_id }}-note{% if form.errors %} {{ form_id }}-error{% endif %}" {% if form.errors %}aria-invalid="true"{% endif %}>

    <button class="jn__submit jn__button-type" type="submit">{{ section.settings.button | escape }}<span class="jn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button>

    <p class="jn__note jn__body" id="{{ form_id }}-note">{{ section.settings.consent | escape }}</p>

   {% endif %}

  {% endform %}
  {% endif %}

 </div>

</section>

{% stylesheet %}
.jn .jn__ticket a.jn__submit{text-decoration:none;cursor:pointer}

.jn{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(320px,1fr);gap:40px;max-width:1680px;margin:0 auto;padding:var(--jn-pad) 48px;background:var(--jn-bg);color:var(--jn-ink);border-bottom:1px solid color-mix(in srgb,var(--june-ink,#171717) 20%,transparent)}

.jn *{box-sizing:border-box}.jn h2,.jn h3,.jn p{margin:0;color:inherit}.jn strong{font-weight:700}.jn__teaser{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.1fr);gap:24px;align-items:center;min-width:0}

.jn .jn__heading{font-family:var(--jn-heading-font);font-weight:var(--jn-heading-weight);font-size:var(--jn-heading-size);letter-spacing:var(--jn-heading-tracking);line-height:var(--jn-heading-leading)}

.jn .jn__year{font-family:var(--jn-year-font);font-weight:var(--jn-year-weight);font-size:var(--jn-year-size);letter-spacing:var(--jn-year-tracking);line-height:var(--jn-year-leading)}

.jn .jn__signup{font-family:var(--jn-signup-font);font-weight:var(--jn-signup-weight);font-size:var(--jn-signup-size);letter-spacing:var(--jn-signup-tracking);line-height:var(--jn-signup-leading)}

.jn .jn__body{font-family:var(--jn-body-font);font-weight:var(--jn-body-weight);font-size:var(--jn-body-size);letter-spacing:var(--jn-body-tracking);line-height:var(--jn-body-leading)}

.jn .jn__button-type{font-family:var(--jn-button-font);font-weight:var(--jn-button-weight);font-size:var(--jn-button-size);letter-spacing:var(--jn-button-tracking);line-height:var(--jn-button-leading)}

.jn__copy{min-width:0}.jn__eyebrow{text-transform:uppercase;letter-spacing:.08em!important}.jn .jn__heading{margin:18px 0 20px;overflow-wrap:break-word}.jn__caption{opacity:.8}

.jn__paper-wrap{min-width:0;padding:20px 0;filter:drop-shadow(3px 14px 10px color-mix(in srgb,var(--june-ink,#111111) 13.33%,transparent))}.jn__paper-wrap>img{display:block;width:100%;height:auto;max-height:350px;object-fit:contain}

.jn__paper{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;min-height:280px;padding:34px 14px 20px;background:linear-gradient(135deg,var(--june-bg,#FFFFFF),var(--june-surface,#F5F5F3));border:1px solid color-mix(in srgb,var(--june-ink,#171717) 13.33%,transparent);transform:rotate(-5deg)}

.jn .jn__year{font-size:min(var(--jn-year-size),10vw);white-space:nowrap}.jn__badge{align-self:flex-end;background:var(--jn-accent);color:var(--june-on-accent,var(--june-ink,#171717));padding:6px 10px}.jn__paper-note{background:var(--jn-accent);color:var(--june-on-accent,var(--june-ink,#171717));padding:7px 10px;text-align:center}

.jn__clip{position:absolute;top:-14px;left:46%;width:32px;height:28px;background:var(--june-dark,#171717);border-radius:3px;box-shadow:1px 3px 3px #17171744}.jn__clip:before{content:"";position:absolute;left:8px;bottom:19px;width:16px;height:26px;border:3px solid var(--june-border,#DADADA);border-radius:7px;background:transparent}

.jn__ticket{position:relative;align-self:center;padding:28px;border:1px solid color-mix(in srgb,var(--june-ink,#171717) 13.33%,transparent);border-radius:14px;background:color-mix(in srgb,var(--jn-accent) 46%,var(--jn-bg));box-shadow:0 8px 18px #11112;min-width:0}

.jn .jn__signup{margin:12px 0;overflow-wrap:break-word}.jn__description{margin-top:10px}.jn__perforation{position:relative;margin:22px -28px 20px;border-top:2px dashed color-mix(in srgb,var(--june-ink,#171717) 33.33%,transparent)}.jn__perforation:before,.jn__perforation:after{content:"";position:absolute;top:-11px;width:20px;height:20px;background:var(--jn-bg);border-radius:50%}.jn__perforation:before{left:-11px}.jn__perforation:after{right:-11px}

.jn__form label{display:block;margin-bottom:8px}.jn .jn__email{display:block;width:100%;min-height:52px;padding:12px 14px;border:1px solid color-mix(in srgb,var(--june-ink,#171717) 46.67%,transparent);border-radius:6px;background:var(--june-bg,#FFFFFF);color:var(--june-ink,#171717);font-size:max(16px,var(--jn-body-size))}

.jn .jn__submit{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;margin:14px 0 0;min-height:52px;padding:9px 10px 9px 20px;border:1px solid var(--june-ink,#171717);border-radius:999px;background:var(--jn-accent);color:var(--june-on-accent,var(--june-ink,#171717));box-shadow:-2px 1px 0 #171717;cursor:pointer;transition:transform var(--jn-duration) ease}

.jn__arrow{display:grid;place-items:center;width:32px;height:32px;background:var(--june-dark,var(--june-dark,#171717));color:var(--june-on-dark,var(--jn-accent));border-radius:50%;flex:none}.jn__arrow svg{width:18px;height:18px}

.jn .jn__note{margin-top:12px;opacity:.8;font-size:calc(var(--jn-body-size)*.8)}.jn input:focus-visible,.jn button:focus-visible{outline:2px solid currentColor;outline-offset:4px}.jn__error{margin-bottom:14px}.jn__error a{color:inherit;text-decoration:underline}.jn__check{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--june-dark,#171717);color:var(--jn-accent)}.jn__check svg{width:30px;height:30px}

@media(hover:hover){.jn[data-motion=true] .jn__submit:hover{transform:translateY(-2px)}}

@media(min-width:901px) and (max-width:1200px){.jn{gap:24px;padding-inline:28px;grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr)}.jn__teaser{gap:12px}.jn .jn__heading{font-size:calc(var(--jn-heading-size)*.82)}.jn__paper{min-height:230px}.jn__ticket{padding:24px}.jn__perforation{margin-inline:-24px}.jn .jn__year{font-size:min(var(--jn-year-size),9vw)}}

@media(max-width:900px){.jn{display:block;padding:var(--jn-mobile-pad) 20px}.jn__teaser{grid-template-columns:1fr 1fr;gap:16px;margin-bottom:26px}.jn__paper-wrap{padding:16px 0}.jn__paper{min-height:160px;padding:25px 8px 14px;gap:12px}.jn__clip{transform:scale(.7);transform-origin:bottom center}

.jn .jn__heading{font-size:var(--jn-heading-mobile)}

.jn .jn__year{font-size:var(--jn-year-mobile)}

.jn .jn__signup{font-size:var(--jn-signup-mobile)}

.jn .jn__body{font-size:var(--jn-body-mobile)}

.jn .jn__button-type{font-size:var(--jn-button-mobile)}

.jn .jn__heading{margin:12px 0;font-size:min(var(--jn-heading-mobile),8vw)}.jn .jn__year{font-size:min(var(--jn-year-mobile),12vw)}.jn .jn__badge,.jn .jn__paper-note{font-size:calc(var(--jn-button-mobile)*.72);padding:5px 7px}.jn .jn__eyebrow{font-size:calc(var(--jn-button-mobile)*.75)}.jn .jn__caption{font-size:calc(var(--jn-body-mobile)*.8)}.jn__ticket{max-width:520px;margin:auto;padding:24px}.jn__perforation{margin-inline:-24px}.jn .jn__note{font-size:calc(var(--jn-body-mobile)*.8)}.jn .jn__email{font-size:max(16px,var(--jn-body-mobile))}

}

@media(prefers-reduced-motion:reduce){.jn *{transition:none!important;animation:none!important}.jn .jn__submit{transform:none!important}}

.jn[data-motion=false] *{transition:none!important}



.jn{scroll-margin-top:110px}.jn__paper-note:empty{display:none}

@media(max-width:749px){.jn__ticket{padding:22px!important}.jn__layout{gap:20px!important}.jn__paper{max-height:180px}.jn__signup{padding:0!important}}



@media(max-width:900px){.jn__teaser{margin-bottom:12px}.jn__paper-wrap{padding:8px 0}.jn__paper{min-height:135px}.jn__perforation{margin-block:14px}.jn__ticket{padding:20px}.jn .jn__note{font-size:var(--jn-body-mobile)}}

@media(max-width:900px){.jn{padding-block:calc(var(--jn-mobile-pad)*.65)}.jn__teaser{margin-bottom:8px;gap:12px}.jn__paper-wrap{padding-block:4px}.jn__ticket{padding:16px!important}.jn__perforation{margin-block:10px}.jn__submit{margin-top:10px!important}}

/* Portal announcement: scoped to this section; global palette is preserved. */

.jn.jn--portal{position:relative;isolation:isolate;overflow:hidden;align-items:center;gap:40px;padding-block:max(48px,var(--jn-pad));background:radial-gradient(ellipse at 48% 50%,color-mix(in srgb,var(--portal-glow) 22%,transparent),transparent 55%),var(--jn-bg)}

.jn--portal .jn__teaser{grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:12px}

.jn--portal .jn__heading{font-size:min(var(--jn-heading-size),3.4vw);line-height:var(--jn-heading-leading)}

.jn--portal .jn__portal-scene{position:relative;min-width:0;height:420px;display:grid;place-items:center;isolation:isolate}

.jn--portal .jn__doorway{position:absolute;width:66%;height:83%;bottom:9%;border-radius:48% 48% 3px 3px;border:2px solid color-mix(in srgb,var(--portal-glow) 65%,white);background:linear-gradient(160deg,color-mix(in srgb,var(--portal-glow) 70%,var(--jn-bg)),var(--jn-bg) 80%);box-shadow:0 0 24px var(--portal-glow),0 0 70px color-mix(in srgb,var(--portal-glow) 55%,transparent),inset 0 0 30px #ffffffaa;transform:perspective(900px) rotateY(-12deg)}

.jn--portal .jn__door-light{position:absolute;inset:12px;border:1px solid #ffffffb8;border-radius:inherit;background:radial-gradient(ellipse at 50% 65%,#fff9,transparent 70%)}

.jn--portal .jn__light-spill{position:absolute;width:110%;height:90px;bottom:-3%;background:radial-gradient(ellipse,var(--portal-glow),transparent 67%);opacity:.55;transform:rotate(-6deg);filter:blur(12px);z-index:-1}

.jn--portal .jn__portal-year{position:relative;display:flex;flex-direction:column;align-items:center;transform:rotate(var(--portal-tilt));gap:20px;padding-top:35px}

.jn--portal .jn__year{font-size:min(var(--jn-year-size),10vw);text-shadow:0 4px 30px color-mix(in srgb,var(--jn-bg) 85%,transparent)}

.jn--portal .jn__badge{align-self:center;background:transparent;color:var(--jn-ink);border:1px solid color-mix(in srgb,var(--jn-ink) 30%,transparent);border-radius:999px;padding:8px 15px;font-size:11px;letter-spacing:.08em;text-transform:uppercase}

.jn--portal .jn__stars{position:absolute;inset:5%;pointer-events:none}

.jn--portal .jn__stars i{position:absolute;left:calc(8% + mod(var(--i)*29,85)*1%);top:calc(5% + mod(var(--i)*17,80)*1%);width:4px;height:4px;background:var(--jn-ink);opacity:.4;border-radius:50%;box-shadow:0 0 10px var(--portal-glow)}

.jn--portal .jn__stars i:nth-child(3n){width:12px;height:12px;clip-path:polygon(50% 0,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0 50%,40% 40%);border-radius:0}

.jn--portal .jn__ticket{padding:0!important;background:none;border:0;border-radius:0;box-shadow:none}

.jn--portal .jn__perforation{display:none}

.jn--portal .jn__description{margin-bottom:22px}

.jn--portal .jn__signup{font-size:min(var(--jn-signup-size),2.6vw)}

.jn--portal .jn__email{background:color-mix(in srgb,var(--jn-bg) 80%,transparent)}

.jn--portal .jn__note{font-size:max(12px,calc(var(--jn-body-size)*.8))}

.jn--portal[data-portal-motion=true].is-revealed .jn__doorway{animation:jn-portal-light var(--portal-duration) ease-out both}

.jn--portal[data-portal-motion=true].is-revealed .jn__portal-year{animation:jn-portal-arrive var(--portal-duration) cubic-bezier(.2,.7,.2,1) both}

.jn--portal[data-portal-motion=true].is-revealed .jn__stars i{animation:jn-portal-dust calc(var(--portal-duration)*1.5) ease-out both;animation-delay:calc(var(--i)*.08s)}

@keyframes jn-portal-light{from{opacity:.25;filter:brightness(.9)}to{opacity:1;filter:brightness(1)}}

@keyframes jn-portal-arrive{from{opacity:0;transform:translateY(20px) rotate(var(--portal-tilt))}to{opacity:1;transform:translateY(0) rotate(var(--portal-tilt))}}

@keyframes jn-portal-dust{from{opacity:0;transform:translateY(18px)}to{opacity:.4;transform:translateY(0)}}

@media(max-width:900px){

 .jn.jn--portal{padding:32px 24px 36px;display:block}

 .jn--portal .jn__teaser{display:flex;flex-direction:column;gap:0;margin:0}

 .jn--portal .jn__copy{text-align:center;max-width:540px}

 .jn--portal .jn__heading{font-size:var(--jn-heading-mobile);margin:12px 0}

 .jn--portal .jn__caption{font-size:var(--jn-body-mobile)}

 .jn--portal .jn__portal-scene{width:100%;max-width:360px;height:310px;margin:12px auto 24px}

 .jn--portal .jn__year{font-size:min(calc(var(--jn-year-mobile)*1.8),26vw)}

 .jn--portal .jn__ticket{max-width:480px}

 .jn--portal .jn__signup{font-size:var(--jn-signup-mobile)}

 .jn--portal .jn__note{font-size:12px;line-height:1.6}

}

@media(prefers-reduced-motion:reduce){.jn.jn--portal *{animation:none!important;transition:none!important}}



/* Directional doorway depth, rather than a uniformly glowing plaque. */
.jn.jn--portal{grid-template-columns:minmax(0,2.15fr) minmax(280px,1fr);gap:36px;background:radial-gradient(ellipse at 48% 75%,color-mix(in srgb,var(--portal-glow) 14%,transparent),transparent 48%),var(--jn-bg)}
.jn--portal .jn__teaser{grid-template-columns:minmax(0,.8fr) minmax(0,1.4fr);gap:24px}
.jn--portal .jn__heading{font-size:min(calc(var(--jn-heading-size)*.88),2.8vw)}
.jn--portal .jn__portal-scene{height:440px;perspective:900px}
.jn--portal .jn__doorway{width:60%;height:79%;bottom:16%;border-radius:48% 48% 1px 1px;border:2px solid #fff;background:radial-gradient(ellipse at 70% 85%,color-mix(in srgb,var(--portal-glow) 80%,white),transparent 65%),linear-gradient(145deg,color-mix(in srgb,var(--portal-glow) 55%,#302344),color-mix(in srgb,var(--portal-glow) 85%,#302344) 58%,var(--portal-glow));box-shadow:5px 3px 0 color-mix(in srgb,var(--portal-glow) 65%,#443553),8px 6px 0 color-mix(in srgb,var(--portal-glow) 40%,transparent),0 0 14px color-mix(in srgb,var(--portal-glow) 65%,transparent),inset 12px 9px 26px #30234455;transform:perspective(900px) rotateY(-15deg)}
.jn--portal .jn__door-light{inset:10px 9px 0 12px;border:1px solid #ffffff80;border-bottom:0;background:linear-gradient(115deg,#ffffff08 30%,#ffffff55);box-shadow:inset -5px 0 10px #ffffff55}
.jn--portal .jn__doorway:after{content:"";position:absolute;left:0;right:0;bottom:-2px;height:3px;background:#fff;box-shadow:0 0 12px white}
.jn--portal .jn__light-spill{width:110%;height:110px;bottom:-5%;background:linear-gradient(180deg,color-mix(in srgb,var(--portal-glow) 65%,white),color-mix(in srgb,var(--portal-glow) 20%,transparent) 65%,transparent);clip-path:polygon(25% 0,78% 0,100% 100%,0 100%);filter:blur(4px);opacity:.65;transform:rotate(-3deg);z-index:-1}
.jn--portal .jn__portal-year{gap:22px;padding-top:25px;transform:translateX(-7%) rotate(var(--portal-tilt));z-index:2}
.jn--portal .jn__year{font-size:min(calc(var(--jn-year-size)*1.15),12vw);text-shadow:1px 2px 0 #ffffffb3,0 12px 18px #24143233}
.jn--portal .jn__badge{border:0;border-radius:0;padding:0;background:transparent;letter-spacing:.18em;font-size:11px;color:var(--jn-ink);transform:rotate(calc(-1*var(--portal-tilt)));text-shadow:0 0 8px var(--jn-bg)}
.jn--portal .jn__stars{inset:6% 13% 18%;z-index:3}
.jn--portal .jn__stars i{background:white;opacity:.85;box-shadow:0 0 5px white,0 0 9px var(--portal-glow)}
.jn--portal .jn__stars i:nth-child(1){left:22%;top:20%}
.jn--portal .jn__stars i:nth-child(2){left:78%;top:32%}
.jn--portal .jn__stars i:nth-child(3){left:14%;top:68%;width:9px;height:9px}
.jn--portal .jn__stars i:nth-child(4){left:72%;top:10%}
.jn--portal .jn__stars i:nth-child(5){left:85%;top:78%}
.jn--portal .jn__signup{font-size:min(calc(var(--jn-signup-size)*.8),2.1vw);line-height:1.18}
.jn--portal .jn__submit{background:color-mix(in srgb,var(--jn-accent) 25%,var(--jn-bg));box-shadow:none}
@keyframes jn-portal-arrive{from{opacity:0;transform:translateX(-3%) translateY(-10px) translateZ(-80px) rotate(var(--portal-tilt))}to{opacity:1;transform:translateX(-7%) translateY(0) translateZ(0) rotate(var(--portal-tilt))}}
@keyframes jn-portal-dust{from{opacity:0;transform:translateY(12px)}to{opacity:.85;transform:translateY(0)}}
@media(max-width:900px){
 .jn.jn--portal{display:block}
 .jn--portal .jn__teaser{display:flex;gap:0}
 .jn--portal .jn__heading{font-size:calc(var(--jn-heading-mobile)*.9)}
 .jn--portal .jn__portal-scene{height:330px;margin-bottom:28px}
 .jn--portal .jn__year{font-size:min(calc(var(--jn-year-mobile)*1.9),27vw)}
 .jn--portal .jn__signup{font-size:calc(var(--jn-signup-mobile)*.85)}
 .jn--portal .jn__light-spill{height:85px}
}



{% endstylesheet %}

{% javascript %}

(() => {

 const initialise = (root=document) => root.querySelectorAll('.jn--portal:not([data-portal-ready])').forEach(section => {

  section.dataset.portalReady = 'true';

  if (!window.IntersectionObserver) return;

  const observer = new IntersectionObserver(entries => {

   if (entries.some(entry => entry.isIntersecting)) { section.classList.add('is-revealed'); observer.disconnect(); }

  }, {threshold: .18});

  observer.observe(section);

  const unload = event => { if (event.target.contains(section)) { observer.disconnect(); document.removeEventListener('shopify:section:unload', unload); } };

  document.addEventListener('shopify:section:unload', unload);

 });

 initialise();

 document.addEventListener('shopify:section:load', event => initialise(event.target));

})();

{% endjavascript %}

