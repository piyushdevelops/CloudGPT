<script>
(() => {
  const root = document.getElementById('TjsCollectionWorlds-{{ section.id }}');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';
  const tabs = [...root.querySelectorAll('[data-world-tab]')];
  const panels = [...root.querySelectorAll('[data-world-panel]')];
  const autoplay = root.dataset.autoplay === 'true';
  const autoplaySpeed = Number(root.dataset.autoplaySpeed || 5000);

  const activateWorld = index => {
    tabs.forEach((tab, i) => {
      const active = i === index;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    panels.forEach((panel, i) => panel.classList.toggle('is-active', i === index));
    panels[index]?.querySelector('[data-world-hero]')?.dispatchEvent(new CustomEvent('tjs:hero:activate'));
  };

  tabs.forEach((tab, index) => tab.addEventListener('click', () => {
    activateWorld(index);
    tab.scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block:'nearest', inline:'center'});
  }));

  panels.forEach(panel => {
    const hero = panel.querySelector('[data-world-hero]');
    if (!hero) return;
    const track = hero.querySelector('[data-world-hero-track]');
    const slides = [...hero.querySelectorAll('[data-world-hero-slide]')];
    const dotsWrap = hero.querySelector('[data-world-hero-dots]');
    if (!track || !slides.length || !dotsWrap) return;
    let current = 0, timer = null;
    slides.forEach((slide, index) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', `Go to banner ${index + 1}`);
      if (index === 0) dot.classList.add('is-active');
      dot.addEventListener('click', () => track.scrollTo({left: slide.offsetLeft, behavior:'smooth'}));
      dotsWrap.appendChild(dot);
    });
    const dots = [...dotsWrap.children];
    const update = () => {
      const width = track.clientWidth || 1;
      current = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / width)));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
    const start = () => {
      stop();
      if (!autoplay || slides.length < 2) return;
      timer = setInterval(() => {
        const next = (current + 1) % slides.length;
        track.scrollTo({left: slides[next].offsetLeft, behavior:'smooth'});
      }, autoplaySpeed);
    };
    track.addEventListener('scroll', () => requestAnimationFrame(update), {passive:true});
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    hero.addEventListener('touchstart', stop, {passive:true});
    hero.addEventListener('touchend', start, {passive:true});
    hero.addEventListener('tjs:hero:activate', start);
    if (panel.classList.contains('is-active')) start();
  });
  activateWorld(0);
})();
</script>

