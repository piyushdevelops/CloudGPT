{% liquid
 assign typography = section.blocks | where: 'type', 'typography' | first
 assign type = typography.settings
 assign form_id = 'JuneNextForm-' | append: section.id
%}
{% style %}
#JuneNext-{{ section.id }}{--jn-bg:{{ section.settings.background }};--jn-ink:{{ section.settings.ink }};--jn-accent:{{ section.settings.accent }};--jn-pad:{{ section.settings.padding }}px;--jn-mobile-pad:{{ section.settings.mobile_padding }}px;--jn-duration:{{ 24000 | divided_by: section.settings.speed }}ms;}
{% assign face = type.heading_font | default: section.settings.fallback_font %}{% assign weight = type.heading_weight | default: 900 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}
#JuneNext-{{ section.id }}{--jn-heading-font:{{ face.family }},{{ face.fallback_families }};--jn-heading-weight:{{ type.heading_weight | default: 900 }};--jn-heading-size:{{ type.heading_size | default: 52 }}px;--jn-heading-mobile:{{ type.heading_mobile | default: 34 }}px;--jn-heading-tracking:{{ type.heading_tracking | default: -2 | divided_by: 100.0 }}em;--jn-heading-leading:{{ type.heading_leading | default: 105 | divided_by: 100.0 }};}
{% assign face = type.year_font | default: section.settings.fallback_font %}{% assign weight = type.year_weight | default: 900 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}
#JuneNext-{{ section.id }}{--jn-year-font:{{ face.family }},{{ face.fallback_families }};--jn-year-weight:{{ type.year_weight | default: 900 }};--jn-year-size:{{ type.year_size | default: 150 }}px;--jn-year-mobile:{{ type.year_mobile | default: 60 }}px;--jn-year-tracking:{{ type.year_tracking | default: -5 | divided_by: 100.0 }}em;--jn-year-leading:{{ type.year_leading | default: 100 | divided_by: 100.0 }};}
{% assign face = type.signup_font | default: section.settings.fallback_font %}{% assign weight = type.signup_weight | default: 900 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}
#JuneNext-{{ section.id }}{--jn-signup-font:{{ face.family }},{{ face.fallback_families }};--jn-signup-weight:{{ type.signup_weight | default: 900 }};--jn-signup-size:{{ type.signup_size | default: 38 }}px;--jn-signup-mobile:{{ type.signup_mobile | default: 32 }}px;--jn-signup-tracking:{{ type.signup_tracking | default: -2 | divided_by: 100.0 }}em;--jn-signup-leading:{{ type.signup_leading | default: 105 | divided_by: 100.0 }};}
{% assign face = type.body_font | default: section.settings.fallback_font %}{% assign weight = type.body_weight | default: 400 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}
#JuneNext-{{ section.id }}{--jn-body-font:{{ face.family }},{{ face.fallback_families }};--jn-body-weight:{{ type.body_weight | default: 400 }};--jn-body-size:{{ type.body_size | default: 16 }}px;--jn-body-mobile:{{ type.body_mobile | default: 16 }}px;--jn-body-tracking:{{ type.body_tracking | default: -1 | divided_by: 100.0 }}em;--jn-body-leading:{{ type.body_leading | default: 150 | divided_by: 100.0 }};}
{% assign face = type.button_font | default: section.settings.fallback_font %}{% assign weight = type.button_weight | default: 600 | append: '' %}{% assign variant = face | font_modify: 'weight', weight | default: face %}{{ variant | font_face: font_display: 'swap' }}
#JuneNext-{{ section.id }}{--jn-button-font:{{ face.family }},{{ face.fallback_families }};--jn-button-weight:{{ type.button_weight | default: 600 }};--jn-button-size:{{ type.button_size | default: 14 }}px;--jn-button-mobile:{{ type.button_mobile | default: 14 }}px;--jn-button-tracking:{{ type.button_tracking | default: -1 | divided_by: 100.0 }}em;--jn-button-leading:{{ type.button_leading | default: 130 | divided_by: 100.0 }};}
{% assign face = type.body_font | default: section.settings.fallback_font %}{% assign bold = face | font_modify: 'weight', '700' %}{{ bold | font_face: font_display: 'swap' }}
{% endstyle %}
<section id="JuneNext-{{ section.id }}" class="jn" data-motion="{{ section.settings.motion }}" aria-labelledby="JuneNextHeading-{{ section.id }}">
 <div class="jn__teaser">
  <header class="jn__copy">
   <p class="jn__eyebrow jn__button-type">{{ section.settings.eyebrow | escape }}</p>
   <h2 id="JuneNextHeading-{{ section.id }}" class="jn__heading">{{ section.settings.heading | escape }}<br>{{ section.settings.heading_second | escape }}</h2>
   <p class="jn__caption jn__body">{{ section.settings.caption | escape }}</p>
  </header>
  <div class="jn__paper-wrap">
   {% if section.settings.teaser != blank %}
    {{ section.settings.teaser | image_url: width: 1000 | image_tag: widths: '300,500,750,1000', sizes: '(min-width: 901px) 30vw, 45vw', loading: 'lazy', alt: section.settings.teaser_alt }}
   {% else %}
    <div class="jn__paper">
     <span class="jn__clip" aria-hidden="true"></span>
     <span class="jn__badge jn__button-type">{{ section.settings.badge | escape }}</span>
     <span class="jn__year">{{ section.settings.year | escape }}</span>
     <span class="jn__paper-note jn__button-type">{{ section.settings.paper_note | escape }}</span>
    </div>
   {% endif %}
  </div>
 </div>
 <div class="jn__ticket">
  {% form 'customer', id: form_id, class: 'jn__form' %}
   <input type="hidden" name="contact[tags]" value="newsletter,{{ section.settings.tag | escape }}">
   {% if form.posted_successfully? %}
    <div class="jn__success" role="status" tabindex="-1">
     <span class="jn__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
     <h3 class="jn__signup">{{ section.settings.success_heading | escape }}</h3>
     <p class="jn__body">{{ section.settings.success_body | escape }}</p>
    </div>
   {% else %}
    <p class="jn__eyebrow jn__button-type">{{ section.settings.list_label | escape }}</p>
    <h3 class="jn__signup">{{ section.settings.signup_heading | escape }}</h3>
    <div class="jn__body jn__description">{{ section.settings.body }}</div>
    <div class="jn__perforation" aria-hidden="true"></div>
    {% if form.errors %}<div id="{{ form_id }}-error" class="jn__error jn__body" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    <label class="jn__button-type" for="{{ form_id }}-email">{{ section.settings.email_label | escape }}</label>
    <input class="jn__email jn__body" id="{{ form_id }}-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocapitalize="off" spellcheck="false" required placeholder="{{ section.settings.placeholder | escape }}" aria-describedby="{{ form_id }}-note{% if form.errors %} {{ form_id }}-error{% endif %}" {% if form.errors %}aria-invalid="true"{% endif %}>
    <button class="jn__submit jn__button-type" type="submit">{{ section.settings.button | escape }}<span class="jn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button>
    <p class="jn__note jn__body" id="{{ form_id }}-note">{{ section.settings.consent | escape }}</p>
   {% endif %}
  {% endform %}
 </div>
</section>
{% stylesheet %}
.jn{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(320px,1fr);gap:40px;max-width:1680px;margin:0 auto;padding:var(--jn-pad) 48px;background:var(--jn-bg);color:var(--jn-ink);border-bottom:1px solid #17171733}
.jn *{box-sizing:border-box}.jn h2,.jn h3,.jn p{margin:0;color:inherit}.jn strong{font-weight:700}.jn__teaser{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.1fr);gap:24px;align-items:center;min-width:0}
.jn .jn__heading{font-family:var(--jn-heading-font);font-weight:var(--jn-heading-weight);font-size:var(--jn-heading-size);letter-spacing:var(--jn-heading-tracking);line-height:var(--jn-heading-leading)}
.jn .jn__year{font-family:var(--jn-year-font);font-weight:var(--jn-year-weight);font-size:var(--jn-year-size);letter-spacing:var(--jn-year-tracking);line-height:var(--jn-year-leading)}
.jn .jn__signup{font-family:var(--jn-signup-font);font-weight:var(--jn-signup-weight);font-size:var(--jn-signup-size);letter-spacing:var(--jn-signup-tracking);line-height:var(--jn-signup-leading)}
.jn .jn__body{font-family:var(--jn-body-font);font-weight:var(--jn-body-weight);font-size:var(--jn-body-size);letter-spacing:var(--jn-body-tracking);line-height:var(--jn-body-leading)}
.jn .jn__button-type{font-family:var(--jn-button-font);font-weight:var(--jn-button-weight);font-size:var(--jn-button-size);letter-spacing:var(--jn-button-tracking);line-height:var(--jn-button-leading)}
.jn__copy{min-width:0}.jn__eyebrow{text-transform:uppercase;letter-spacing:.08em!important}.jn .jn__heading{margin:18px 0 20px;overflow-wrap:break-word}.jn__caption{opacity:.8}
.jn__paper-wrap{min-width:0;padding:20px 0;filter:drop-shadow(3px 14px 10px #1112)}.jn__paper-wrap>img{display:block;width:100%;height:auto;max-height:350px;object-fit:contain}
.jn__paper{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;min-height:280px;padding:34px 14px 20px;background:linear-gradient(135deg,#FFFFFF,#F5F5F3);border:1px solid #17171722;transform:rotate(-5deg)}
.jn .jn__year{font-size:min(var(--jn-year-size),10vw);white-space:nowrap}.jn__badge{align-self:flex-end;background:var(--jn-accent);color:#171717;padding:6px 10px}.jn__paper-note{background:var(--jn-accent);color:#171717;padding:7px 10px;text-align:center}
.jn__clip{position:absolute;top:-14px;left:46%;width:32px;height:28px;background:#171717;border-radius:3px;box-shadow:1px 3px 3px #17171744}.jn__clip:before{content:"";position:absolute;left:8px;bottom:19px;width:16px;height:26px;border:3px solid #DADADA;border-radius:7px;background:transparent}
.jn__ticket{position:relative;align-self:center;padding:28px;border:1px solid #17171722;border-radius:14px;background:color-mix(in srgb,var(--jn-accent) 46%,var(--jn-bg));box-shadow:0 8px 18px #11112;min-width:0}
.jn .jn__signup{margin:12px 0;overflow-wrap:break-word}.jn__description{margin-top:10px}.jn__perforation{position:relative;margin:22px -28px 20px;border-top:2px dashed #17171755}.jn__perforation:before,.jn__perforation:after{content:"";position:absolute;top:-11px;width:20px;height:20px;background:var(--jn-bg);border-radius:50%}.jn__perforation:before{left:-11px}.jn__perforation:after{right:-11px}
.jn__form label{display:block;margin-bottom:8px}.jn .jn__email{display:block;width:100%;min-height:52px;padding:12px 14px;border:1px solid #17171777;border-radius:6px;background:#FFFFFF;color:#171717;font-size:max(16px,var(--jn-body-size))}
.jn .jn__submit{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;margin:14px 0 0;min-height:52px;padding:9px 10px 9px 20px;border:1px solid #171717;border-radius:999px;background:var(--jn-accent);color:#171717;box-shadow:-2px 1px 0 #171717;cursor:pointer;transition:transform var(--jn-duration) ease}
.jn__arrow{display:grid;place-items:center;width:32px;height:32px;background:#171717;color:var(--jn-accent);border-radius:50%;flex:none}.jn__arrow svg{width:18px;height:18px}
.jn .jn__note{margin-top:12px;opacity:.8;font-size:calc(var(--jn-body-size)*.8)}.jn input:focus-visible,.jn button:focus-visible{outline:2px solid currentColor;outline-offset:4px}.jn__error{margin-bottom:14px}.jn__error a{color:inherit;text-decoration:underline}.jn__check{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:#171717;color:var(--jn-accent)}.jn__check svg{width:30px;height:30px}
@media(hover:hover){.jn[data-motion=true] .jn__submit:hover{transform:translateY(-2px)}}
@media(min-width:901px) and (max-width:1200px){.jn{gap:24px;padding-inline:28px;grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr)}.jn__teaser{gap:12px}.jn .jn__heading{font-size:calc(var(--jn-heading-size)*.82)}.jn__paper{min-height:230px}.jn__ticket{padding:24px}.jn__perforation{margin-inline:-24px}.jn .jn__year{font-size:min(var(--jn-year-size),9vw)}}
@media(max-width:900px){.jn{display:block;padding:var(--jn-mobile-pad) 20px}.jn__teaser{grid-template-columns:1fr 1fr;gap:16px;margin-bottom:26px}.jn__paper-wrap{padding:16px 0}.jn__paper{min-height:160px;padding:25px 8px 14px;gap:12px}.jn__clip{transform:scale(.7);transform-origin:bottom center}
.jn .jn__heading{font-size:var(--jn-heading-mobile)}
.jn .jn__year{font-size:var(--jn-year-mobile)}
.jn .jn__signup{font-size:var(--jn-signup-mobile)}
.jn .jn__body{font-size:var(--jn-body-mobile)}
.jn .jn__button-type{font-size:var(--jn-button-mobile)}
.jn .jn__heading{margin:12px 0;font-size:min(var(--jn-heading-mobile),8vw)}.jn .jn__year{font-size:min(var(--jn-year-mobile),12vw)}.jn .jn__badge,.jn .jn__paper-note{font-size:calc(var(--jn-button-mobile)*.72);padding:5px 7px}.jn .jn__eyebrow{font-size:calc(var(--jn-button-mobile)*.75)}.jn .jn__caption{font-size:calc(var(--jn-body-mobile)*.8)}.jn__ticket{max-width:520px;margin:auto;padding:24px}.jn__perforation{margin-inline:-24px}.jn .jn__note{font-size:calc(var(--jn-body-mobile)*.8)}.jn .jn__email{font-size:max(16px,var(--jn-body-mobile))}
}
@media(prefers-reduced-motion:reduce){.jn *{transition:none!important;animation:none!important}.jn .jn__submit{transform:none!important}}
.jn[data-motion=false] *{transition:none!important}

.jn{scroll-margin-top:110px}.jn__paper-note:empty{display:none}
@media(max-width:749px){.jn__ticket{padding:22px!important}.jn__layout{gap:20px!important}.jn__paper{max-height:180px}.jn__signup{padding:0!important}}

@media(max-width:900px){.jn__teaser{margin-bottom:12px}.jn__paper-wrap{padding:8px 0}.jn__paper{min-height:135px}.jn__perforation{margin-block:14px}.jn__ticket{padding:20px}.jn .jn__note{font-size:var(--jn-body-mobile)}}
{% endstylesheet %}
{% schema %}
{
  "name": "June · Next chapter",
  "tag": "section",
  "class": "june-next-section",
  "max_blocks": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The next chapter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Next year."
    },
    {
      "type": "text",
      "id": "heading_second",
      "label": "Heading second line",
      "default": "Loading…"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Planner caption",
      "default": "2027 dated planners"
    },
    {
      "type": "text",
      "id": "year",
      "label": "Year",
      "default": "2027"
    },
    {
      "type": "text",
      "id": "badge",
