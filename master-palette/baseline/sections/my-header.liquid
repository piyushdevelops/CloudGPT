      right: 5px !important;
    }

    #TjsPremiumHeader-{{ section.id }}
      .tjs-ph__search-wrap.is-search-active
      .tjs-ph__typing {
      left: 54px;
      max-width: calc(100% - 112px);
    }
  }


  /* =====================================================
     SMART COLLECTION / PRODUCT-TYPE MEGA MENU V4
  ===================================================== */

  @media (min-width: 1150px) {
    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-main {
      grid-template-columns: minmax(220px, .62fr) minmax(0, 2.38fr);
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-content: start;
      gap: 0;
      padding: 0;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-column {
      min-height: 174px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 20px 18px 17px;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-heading {
      font-size: 16px;
      font-weight: 590;
      line-height: 1.08;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-types {
      width: 100%;
      display: grid;
      align-content: start;
      gap: 1px;
      margin-top: 10px;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child {
      width: fit-content;
      margin-top: 0;
      padding: 5px 0;
      font-size: 11px;
      font-weight: 570;
      line-height: 1.28;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-view-all {
      min-height: 28px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: auto;
      padding-top: 10px;
      color: var(--tjs-ph-text);
      font-size: 9px;
      font-weight: 780;
      letter-spacing: .035em;
      text-decoration: none;
      text-transform: uppercase;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-view-all span:last-child {
      transition: transform .18s ease;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-view-all:hover span:last-child {
      transform: translateX(3px);
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-editorial {
      max-width: 26ch;
      margin: 12px 0 0;
      color: var(--tjs-ph-muted);
      font-size: 11px;
      font-weight: 520;
      line-height: 1.5;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-column.is-editorial {
      background:
        linear-gradient(
          145deg,
          color-mix(in srgb, var(--tjs-ph-accent) 5%, transparent),
          transparent 64%
        );
    }
  }

  @media (max-width: 1370px) and (min-width: 1150px) {
    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-main {
      grid-template-columns: 190px minmax(0, 1fr);
    }
  }

  @media (max-width: 1149px) {
    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu details[data-tjs-mobile-child] {
      border-top: 1px solid color-mix(in srgb, var(--tjs-ph-border) 66%, transparent);
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu details[data-tjs-mobile-child] > summary {
      min-height: 44px;
      color: var(--tjs-ph-text);
      font-size: 13px;
      font-weight: 650;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu details[data-tjs-mobile-child] > summary svg {
      width: 12px;
      height: 8px;
      flex: 0 0 12px;
      transition: transform .2s ease;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu details[data-tjs-mobile-child][open] > summary svg {
      transform: rotate(180deg);
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu--grand {
      display: grid;
      gap: 0;
      padding: 2px 0 10px 14px;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu--grand li {
      border: 0;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu--grand .tjs-ph__mobile-type-link {
      min-height: 36px !important;
      display: flex;
      align-items: center;
      color: var(--tjs-ph-muted) !important;
      font-size: 12px !important;
      font-weight: 560 !important;
      line-height: 1.3;
      text-decoration: none;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-view-all-row {
      margin-top: 3px;
      padding-top: 6px;
      border-top: 1px solid color-mix(in srgb, var(--tjs-ph-border) 66%, transparent) !important;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-view-all {
      min-height: 38px !important;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: var(--tjs-ph-accent) !important;
      font-size: 10px !important;
      font-weight: 760 !important;
      letter-spacing: .025em;
      text-decoration: none;
    }
  }

{% endstyle %}

<tjs-premium-header
  id="TjsPremiumHeader-{{ section.id }}"
  data-sticky-mode="{{ section.settings.sticky_mode }}"
  data-predictive-url="{{ routes.predictive_search_url }}"
  data-search-url="{{ routes.search_url }}"
  data-min-search-characters="2"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-typing-enabled="{{ section.settings.enable_typing_effect }}"
  data-typing-speed="55"
  data-typing-hold="2000"
  class="{% if section.settings.transparent_home and request.page_type == 'index' %}is-home-transparent{% endif %}"
>
  <script type="application/json" data-tjs-header-popular>
    {{ tjs_popular_searches | json }}
  </script>

  <script type="application/json" data-tjs-exact-search-routes>
    {{ section.settings.exact_search_routes | json }}
  </script>

  <script type="application/json" data-tjs-search-synonyms>
    {{ section.settings.search_synonyms | json }}
  </script>

  <script type="application/json" data-tjs-typing-terms>
    {{ section.settings.typing_terms | newline_to_br | split: '<br />' | json }}
  </script>

  {% if section.settings.top_note != blank %}
    <div class="tjs-ph__note">
      {% if section.settings.top_note_link != blank %}
        <a href="{{ section.settings.top_note_link }}">{{ section.settings.top_note | escape }}</a>
      {% else %}
        <span>{{ section.settings.top_note | escape }}</span>
      {% endif %}
    </div>
  {% endif %}

  <div class="tjs-ph__shell">
    <div class="tjs-ph__inner">
      <div class="tjs-ph__desktop">
        <a class="tjs-ph__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo
              | image_url: width: tjs_logo_width_2x
              | image_tag:
                widths: '100,140,180,220,280,360,440',
                sizes: tjs_logo_sizes,
                loading: 'eager',
                fetchpriority: 'high',
                alt: tjs_logo_alt
            }}
          {% else %}
            <span class="tjs-ph__brand-text">{{ shop.name | escape }}</span>
          {% endif %}
        </a>

        <nav class="tjs-ph__nav" aria-label="Main navigation">
          <ul class="tjs-ph__nav-list">
            {% for link in tjs_header_menu.links %}
              {% liquid
                assign tjs_nav_title = link.title
                assign tjs_nav_badge = blank
                if link.title contains '['
                  assign tjs_nav_parts = link.title | split: '['
                  assign tjs_nav_title = tjs_nav_parts.first | strip
                  assign tjs_nav_badge = tjs_nav_parts[1] | remove: ']' | strip
                endif
              %}

              <li class="tjs-ph__nav-item">
                {% if link.links != blank %}
                  <details class="tjs-ph__nav-details" data-tjs-nav-details>
                    <summary class="tjs-ph__nav-summary">
                      <span>{{ tjs_nav_title | escape }}</span>
                      {% if tjs_nav_badge != blank %}
                        <span class="tjs-ph__nav-badge">{{ tjs_nav_badge | escape }}</span>
                      {% endif %}
                      <svg class="tjs-ph__nav-caret" viewBox="0 0 10 7" fill="none" aria-hidden="true">
                        <path d="m1 1.25 4 4 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>

                    <div class="tjs-ph__dropdown">
                      <div class="tjs-ph__dropdown-panel{% if section.settings.show_desktop_promo and tjs_menu_promo_block != blank %} has-promo{% endif %}">
                        <div class="tjs-ph__dropdown-main">
                          <div class="tjs-ph__dropdown-intro">
                            <small>Explore</small>
                            <strong>{{ tjs_nav_title | escape }}</strong>
                            <a href="{{ link.url }}">View all</a>
                          </div>

                          <div class="tjs-ph__dropdown-columns">
                            {% for childlink in link.links %}
                              {% liquid
                                assign tjs_child_title = childlink.title
                                if childlink.title contains '['
                                  assign tjs_child_parts = childlink.title | split: '['
                                  assign tjs_child_title = tjs_child_parts.first | strip
                                endif

                                assign tjs_child_title_downcase = tjs_child_title | downcase
                                assign tjs_skip_child = false
                                if tjs_mega_hide_shop_all and tjs_child_title_downcase contains 'shop all'
                                  assign tjs_skip_child = true
                                endif

                                assign tjs_child_collection = blank
                                if childlink.type == 'collection_link'
                                  assign tjs_child_collection = childlink.object
                                endif

                                assign tjs_curated_types = blank
                                assign tjs_automatic_types = blank
                                if tjs_child_collection != blank
                                  assign tjs_curated_types = tjs_child_collection.metafields.custom.mega_menu_product_types.value
                                  assign tjs_automatic_types = tjs_child_collection.all_types
                                endif

                                assign tjs_type_source = 'none'
                                if tjs_mega_types_enabled
                                  case tjs_mega_source
                                    when 'menu_only'
                                      if childlink.links != blank
                                        assign tjs_type_source = 'manual'
                                      endif
                                    when 'automatic'
                                      if tjs_automatic_types != blank
                                        assign tjs_type_source = 'automatic'
                                      elsif childlink.links != blank
                                        assign tjs_type_source = 'manual'
                                      endif
                                    else
                                      if tjs_curated_types != blank
                                        assign tjs_type_source = 'curated'
                                      elsif childlink.links != blank
                                        assign tjs_type_source = 'manual'
                                      elsif tjs_automatic_types != blank
                                        assign tjs_type_source = 'automatic'
                                      endif
                                  endcase
                                elsif childlink.links != blank
                                  assign tjs_type_source = 'manual'
                                endif

                                assign tjs_editorial_copy = blank
                                if tjs_type_source == 'none' and tjs_child_collection.description != blank
                                  assign tjs_editorial_copy = tjs_child_collection.description | strip_html | strip | truncatewords: 16
                                endif
                              %}

                              {% unless tjs_skip_child %}
                                <div
                                  class="tjs-ph__dropdown-column{% if tjs_type_source == 'none' %} is-editorial{% endif %}"
                                  data-tjs-mega-group
                                >
                                  <a class="tjs-ph__dropdown-heading" href="{{ childlink.url }}">
                                    {{ tjs_child_title | escape }}
                                  </a>

                                  {% if tjs_type_source != 'none' %}
                                    <div class="tjs-ph__dropdown-types">
                                      {% case tjs_type_source %}
                                        {% when 'curated' %}
                                          {% for tjs_product_type in tjs_curated_types limit: tjs_mega_types_limit %}
                                            {% assign tjs_product_type_encoded = tjs_product_type | url_encode %}
                                            <a
                                              class="tjs-ph__dropdown-child"
                                              href="{{ tjs_child_collection.url }}?filter.p.product_type={{ tjs_product_type_encoded }}"
                                            >
                                              {{ tjs_product_type | escape }}
                                            </a>
                                          {% endfor %}

                                        {% when 'automatic' %}
                                          {% for tjs_product_type in tjs_automatic_types limit: tjs_mega_types_limit %}
                                            {% assign tjs_product_type_encoded = tjs_product_type | url_encode %}
                                            <a
                                              class="tjs-ph__dropdown-child"
                                              href="{{ tjs_child_collection.url }}?filter.p.product_type={{ tjs_product_type_encoded }}"
                                            >
                                              {{ tjs_product_type | escape }}
                                            </a>
                                          {% endfor %}

                                        {% when 'manual' %}
                                          {% for grandchildlink in childlink.links limit: tjs_mega_types_limit %}
                                            {% liquid
                                              assign tjs_grand_title = grandchildlink.title
                                              if grandchildlink.title contains '['
                                                assign tjs_grand_parts = grandchildlink.title | split: '['
                                                assign tjs_grand_title = tjs_grand_parts.first | strip
                                              endif
                                            %}
                                            <a class="tjs-ph__dropdown-child" href="{{ grandchildlink.url }}">
                                              {{ tjs_grand_title | escape }}
                                            </a>
                                          {% endfor %}
                                      {% endcase %}
                                    </div>
                                  {% elsif tjs_editorial_copy != blank %}
                                    <p class="tjs-ph__dropdown-editorial">
                                      {{ tjs_editorial_copy | escape }}
                                    </p>
                                  {% endif %}

                                  {% if tjs_mega_view_all %}
                                    <a class="tjs-ph__dropdown-view-all" href="{{ childlink.url }}">
                                      <span>View all</span>
                                      <span aria-hidden="true">→</span>
                                    </a>
                                  {% endif %}
                                </div>
                              {% endunless %}
                            {% endfor %}
                          </div>
                        </div>

                        {% if section.settings.show_desktop_promo and tjs_menu_promo_block != blank %}
                          <a class="tjs-ph__dropdown-promo" href="{{ tjs_menu_promo_block.settings.link | default: routes.root_url }}">
                            {% if tjs_menu_promo_block.settings.image != blank %}
                              {{ tjs_menu_promo_block.settings.image
                                | image_url: width: 620
                                | image_tag:
                                  widths: '260,360,480,620',
                                  sizes: '250px',
                                  loading: 'lazy',
                                  alt: tjs_menu_promo_alt
                              }}
                            {% endif %}
                            <span class="tjs-ph__dropdown-promo-copy">
                              <small>Featured edit</small>
                              <strong>{{ tjs_menu_promo_block.settings.title | escape }}</strong>
                              {% if tjs_menu_promo_block.settings.subtitle != blank %}
                                <span>{{ tjs_menu_promo_block.settings.subtitle | escape }}</span>
                              {% endif %}
                            </span>
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  </details>
                {% else %}
                  <a class="tjs-ph__nav-link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                    <span>{{ tjs_nav_title | escape }}</span>
                    {% if tjs_nav_badge != blank %}
                      <span class="tjs-ph__nav-badge">{{ tjs_nav_badge | escape }}</span>
                    {% endif %}
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>

        {% if section.settings.show_desktop_search %}
          <div class="tjs-ph__search-wrap" data-tjs-search-root>
            <form
              class="tjs-ph__search"
              action="{{ routes.search_url }}"
              method="get"
              role="search"
              data-frm-search
            >
              <input type="hidden" name="type" value="product">
              <input type="hidden" name="options[prefix]" value="last">
              <input type="hidden" name="options[unavailable_products]" value="last">
              <input type="hidden" name="options[fields]" value="title,product_type,variants.title,variants.sku">
              <input
                id="TjsHeaderSearchDesktop-{{ section.id }}"
                type="search"
                name="q"
                data-input-search
                autocomplete="off"
                enterkeyhint="search"
                placeholder="{% unless section.settings.enable_typing_effect %}{{ section.settings.search_placeholder | escape }}{% endunless %}"
                aria-label="{{ section.settings.search_placeholder | escape }}"
              >
              <span class="tjs-ph__typing" data-tjs-typing aria-hidden="true">
                <span data-tjs-typing-text></span><i></i>
              </span>
              <button type="submit" aria-label="Search">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="10.8" cy="10.8" r="6.7" stroke="currentColor" stroke-width="1.8"/>
                  <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </button>
            </form>
            <div class="tjs-ph__predictive" data-tjs-search-results hidden></div>
          </div>
        {% endif %}

        <div class="tjs-ph__actions">
          {% if section.settings.show_account %}
            <a class="tjs-ph__icon-link tjs-ph__icon-link--account" href="{{ routes.account_url }}" aria-label="Account">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="8" r="3.7" stroke="currentColor" stroke-width="1.6"/>
                <path d="M4.8 20c.4-4 3-6 7.2-6s6.8 2 7.2 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </a>
          {% endif %}

          {% if section.settings.show_wishlist and settings.wishlist_mode != '0' %}
            <a class="tjs-ph__icon-link tjs-ph__icon-link--heart" href="{{ routes.search_url }}?view=wishlist" aria-label="Wishlist">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M20.5 5.8c-1.9-2-5-2-6.9 0L12 7.5l-1.6-1.7c-1.9-2-5-2-6.9 0-2 2.1-2 5.4 0 7.5L12 22l8.5-8.7c2-2.1 2-5.4 0-7.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}

          <a
            class="tjs-ph__icon-link tjs-ph__icon-link--cart"
            href="{{ routes.cart_url }}"
            {% if request.page_type != 'cart' %}aria-controls="CartDrawer"{% endif %}
            aria-label="Cart"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5.5 8.5h13l-1 11h-11l-1-11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <path d="M9 9V6.5a3 3 0 0 1 6 0V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <hdt-cart-count class="tjs-ph__count" data-tjs-cart-count>{{ cart.item_count }}</hdt-cart-count>
          </a>
        </div>
      </div>

      <div class="tjs-ph__mobile">
        <div class="tjs-ph__mobile-top">
          <button
            type="button"
            class="tjs-ph__menu-toggle tjs-ph__menu-toggle--liquid"
            data-tjs-menu-open
            aria-expanded="false"
            aria-controls="TjsHeaderMenu-{{ section.id }}"
            aria-label="Open menu"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h12M4 17h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>

          <a class="tjs-ph__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            {% if tjs_logo_mobile != blank %}
              {{ tjs_logo_mobile
                | image_url: width: tjs_logo_mobile_width_2x
                | image_tag:
                  widths: '90,120,150,180,220,260,300',
                  sizes: tjs_logo_mobile_sizes,
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: tjs_logo_mobile_alt
              }}
            {% else %}
              <span class="tjs-ph__brand-text">{{ shop.name | escape }}</span>
            {% endif %}
          </a>

          <button type="button" class="tjs-ph__mobile-search-toggle tjs-ph__icon-link" data-june-search-open aria-label="Open search" aria-expanded="false" aria-controls="JuneMobileSearch-{{ section.id }}"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.8"/></svg></button>
          <a
            class="tjs-ph__icon-link tjs-ph__icon-link--cart"
            href="{{ routes.cart_url }}"
            {% if request.page_type != 'cart' %}aria-controls="CartDrawer"{% endif %}
            aria-label="Cart"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5.5 8.5h13l-1 11h-11l-1-11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <path d="M9 9V6.5a3 3 0 0 1 6 0V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <hdt-cart-count class="tjs-ph__count" data-tjs-cart-count>{{ cart.item_count }}</hdt-cart-count>
          </a>
        </div>

        <div id="JuneMobileSearch-{{ section.id }}" class="tjs-ph__search-wrap" data-tjs-search-root data-tjs-mobile-search>
          <form
            class="tjs-ph__search"
            action="{{ routes.search_url }}"
            method="get"
            role="search"
            data-frm-search
          >
            <button
              type="button"
              class="tjs-ph__search-back"
              data-tjs-search-back
              aria-label="Back"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m14.5 5.5-6.5 6.5 6.5 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <input type="hidden" name="options[unavailable_products]" value="last">
            <input
              id="TjsHeaderSearchMobile-{{ section.id }}"
              type="search"
              name="q"
              data-input-search
              autocomplete="off"
              enterkeyhint="search"
              placeholder="{% unless section.settings.enable_typing_effect %}{{ section.settings.search_placeholder | escape }}{% endunless %}"
              aria-label="{{ section.settings.search_placeholder | escape }}"
            >
              <span class="tjs-ph__typing" data-tjs-typing aria-hidden="true">
                <span data-tjs-typing-text></span><i></i>
              </span>
            <button
              type="button"
              class="tjs-ph__search-close"
              data-tjs-search-close
              aria-label="Close search"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
            </button>
            <button type="submit" aria-label="Search">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="10.8" cy="10.8" r="6.7" stroke="currentColor" stroke-width="1.8"/>
                <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </button>
          </form>
          <div class="tjs-ph__predictive" data-tjs-search-results hidden></div>
        </div>
      </div>
    </div>
  </div>

  <div
    id="TjsHeaderMenu-{{ section.id }}"
    class="tjs-ph__mobile-menu"
    data-tjs-menu-overlay
    aria-hidden="true"
    hidden
  >
    <aside class="tjs-ph__drawer" role="dialog" aria-modal="true" aria-label="Navigation menu">
      <div class="tjs-ph__drawer-head">
        <a class="tjs-ph__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if tjs_logo_mobile != blank %}
            {{ tjs_logo_mobile
              | image_url: width: tjs_logo_mobile_width_2x
              | image_tag:
                widths: '90,120,150,180,220,260,300',
                sizes: tjs_logo_mobile_sizes,
                loading: 'lazy',
                alt: tjs_logo_mobile_alt
            }}
          {% else %}
            <span class="tjs-ph__brand-text">{{ shop.name | escape }}</span>
          {% endif %}
        </a>

        <button type="button" class="tjs-ph__drawer-close" data-tjs-menu-close aria-label="Close menu">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <div class="tjs-ph__drawer-scroll">
        <div class="tjs-ph__drawer-search tjs-ph__search-wrap" data-tjs-search-root>
          <form
            class="tjs-ph__search"
            action="{{ routes.search_url }}"
            method="get"
            role="search"
            data-frm-search
          >
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <input type="hidden" name="options[unavailable_products]" value="last">
            <input
              id="TjsHeaderSearchDrawer-{{ section.id }}"
              type="search"
              name="q"
              data-input-search
              autocomplete="off"
              enterkeyhint="search"
              placeholder="{{ section.settings.drawer_search_placeholder | escape }}"
              aria-label="{{ section.settings.drawer_search_placeholder | escape }}"
            >
            <button type="submit" aria-label="Search">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="10.8" cy="10.8" r="6.7" stroke="currentColor" stroke-width="1.8"/>
                <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </button>
          </form>
          <div class="tjs-ph__predictive" data-tjs-search-results hidden></div>
        </div>

        {% if section.settings.popular_searches != blank %}
          <div class="tjs-ph__popular">
            <small>Popular right now</small>
            <div class="tjs-ph__popular-list">
              {% for term in tjs_popular_searches %}
                {% assign tjs_term = term | strip %}
                {% if tjs_term != blank %}
                  <a href="{{ routes.search_url }}?q={{ tjs_term | url_encode }}&type=product&options%5Bprefix%5D=last">
                    {{ tjs_term | escape }}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <nav aria-label="Mobile navigation">
          <ul class="tjs-ph__mobile-nav">
            {% for link in tjs_mobile_menu.links %}
              {% liquid
                assign tjs_mobile_title = link.title
                if link.title contains '['
                  assign tjs_mobile_parts = link.title | split: '['
                  assign tjs_mobile_title = tjs_mobile_parts.first | strip
                endif
              %}

              <li>
                {% if link.links != blank %}
                  <details data-tjs-mobile-main>
                    <summary class="tjs-ph__mobile-summary">
                      <span>{{ tjs_mobile_title | escape }}</span>
                      <svg viewBox="0 0 12 8" fill="none" aria-hidden="true">
                        <path d="m1 1.5 5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>

                    <a class="tjs-ph__mobile-all" href="{{ link.url }}">View all {{ tjs_mobile_title | escape }}</a>

                    <ul class="tjs-ph__mobile-submenu">
                      {% for childlink in link.links %}
                        {% liquid
                          assign tjs_mobile_child_title = childlink.title
                          if childlink.title contains '['
                            assign tjs_mobile_child_parts = childlink.title | split: '['
                            assign tjs_mobile_child_title = tjs_mobile_child_parts.first | strip
                          endif

                          assign tjs_mobile_child_downcase = tjs_mobile_child_title | downcase
                          assign tjs_mobile_skip_child = false
                          if tjs_mega_hide_shop_all and tjs_mobile_child_downcase contains 'shop all'
                            assign tjs_mobile_skip_child = true
                          endif

                          assign tjs_mobile_collection = blank
                          if childlink.type == 'collection_link'
                            assign tjs_mobile_collection = childlink.object
                          endif

                          assign tjs_mobile_curated_types = blank
                          assign tjs_mobile_automatic_types = blank
                          if tjs_mobile_collection != blank
                            assign tjs_mobile_curated_types = tjs_mobile_collection.metafields.custom.mega_menu_product_types.value
                            assign tjs_mobile_automatic_types = tjs_mobile_collection.all_types
                          endif

                          assign tjs_mobile_source = 'none'
                          if tjs_mega_types_enabled and tjs_mega_types_mobile
                            case tjs_mega_source
                              when 'menu_only'
                                if childlink.links != blank
                                  assign tjs_mobile_source = 'manual'
                                endif
                              when 'automatic'
                                if tjs_mobile_automatic_types != blank
                                  assign tjs_mobile_source = 'automatic'
                                elsif childlink.links != blank
                                  assign tjs_mobile_source = 'manual'
                                endif
                              else
                                if tjs_mobile_curated_types != blank
                                  assign tjs_mobile_source = 'curated'
                                elsif childlink.links != blank
                                  assign tjs_mobile_source = 'manual'
                                elsif tjs_mobile_automatic_types != blank
                                  assign tjs_mobile_source = 'automatic'
                                endif
                            endcase
                          elsif childlink.links != blank
                            assign tjs_mobile_source = 'manual'
                          endif

                          assign tjs_mobile_has_children = false
                          if tjs_mobile_source != 'none'
                            assign tjs_mobile_has_children = true
                          endif
                        %}

                        {% unless tjs_mobile_skip_child %}
                          <li>
                            {% if tjs_mobile_has_children %}
                              <details data-tjs-mobile-child>
                                <summary>
                                  <span>{{ tjs_mobile_child_title | escape }}</span>
                                  <svg viewBox="0 0 12 8" fill="none" aria-hidden="true">
                                    <path d="m1 1.5 5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </summary>

                                <ul class="tjs-ph__mobile-submenu tjs-ph__mobile-submenu--grand">
                                  {% case tjs_mobile_source %}
                                    {% when 'curated' %}
                                      {% for tjs_product_type in tjs_mobile_curated_types limit: tjs_mega_types_limit %}
                                        {% assign tjs_product_type_encoded = tjs_product_type | url_encode %}
                                        <li>
                                          <a
                                            class="tjs-ph__mobile-type-link"
                                            href="{{ tjs_mobile_collection.url }}?filter.p.product_type={{ tjs_product_type_encoded }}"
                                          >
                                            {{ tjs_product_type | escape }}
                                          </a>
                                        </li>
                                      {% endfor %}

                                    {% when 'automatic' %}
                                      {% for tjs_product_type in tjs_mobile_automatic_types limit: tjs_mega_types_limit %}
                                        {% assign tjs_product_type_encoded = tjs_product_type | url_encode %}
                                        <li>
                                          <a
                                            class="tjs-ph__mobile-type-link"
                                            href="{{ tjs_mobile_collection.url }}?filter.p.product_type={{ tjs_product_type_encoded }}"
                                          >
                                            {{ tjs_product_type | escape }}
                                          </a>
                                        </li>
                                      {% endfor %}

                                    {% when 'manual' %}
                                      {% for grandchildlink in childlink.links limit: tjs_mega_types_limit %}
                                        {% liquid
                                          assign tjs_mobile_grand_title = grandchildlink.title
                                          if grandchildlink.title contains '['
                                            assign tjs_mobile_grand_parts = grandchildlink.title | split: '['
                                            assign tjs_mobile_grand_title = tjs_mobile_grand_parts.first | strip
                                          endif
                                        %}
                                        <li>
                                          <a class="tjs-ph__mobile-type-link" href="{{ grandchildlink.url }}">
                                            {{ tjs_mobile_grand_title | escape }}
                                          </a>
                                        </li>
                                      {% endfor %}
                                  {% endcase %}

                                  {% if tjs_mega_view_all %}
                                    <li class="tjs-ph__mobile-view-all-row">
                                      <a class="tjs-ph__mobile-view-all" href="{{ childlink.url }}">
                                        <span>View all {{ tjs_mobile_child_title | escape }}</span>
                                        <span aria-hidden="true">→</span>
                                      </a>
                                    </li>
                                  {% endif %}
                                </ul>
                              </details>
                            {% else %}
                              <a href="{{ childlink.url }}">
                                {{ tjs_mobile_child_title | escape }}
                              </a>
                            {% endif %}
                          </li>
                        {% endunless %}
                      {% endfor %}
                    </ul>
                  </details>
                {% else %}
                  <a class="tjs-ph__mobile-link" href="{{ link.url }}">{{ tjs_mobile_title | escape }}</a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>

        {% if section.blocks.size > 0 %}
          <div class="tjs-ph__menu-cards">
            {% for block in section.blocks %}
              {% if block.type == 'menu_card' %}
                <a class="tjs-ph__menu-card" href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>
                  {% if block.settings.image != blank %}
                    {{ block.settings.image
                      | image_url: width: 600
                      | image_tag:
                        widths: '220,320,440,600',
                        sizes: '76vw',
                        loading: 'lazy',
                        alt: block.settings.title
                    }}
                  {% endif %}
                  <span class="tjs-ph__menu-card-copy">
                    <strong>{{ block.settings.title | escape }}</strong>
                    {% if block.settings.subtitle != blank %}
                      <small>{{ block.settings.subtitle | escape }}</small>
                    {% endif %}
                  </span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="tjs-ph__drawer-footer">
        {% if section.settings.show_account %}
          <a href="{{ routes.account_url }}">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="8" r="3.7" stroke="currentColor" stroke-width="1.6"/>
              <path d="M4.8 20c.4-4 3-6 7.2-6s6.8 2 7.2 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>{% if customer %}Account{% else %}Sign in{% endif %}</span>
          </a>
        {% endif %}

        {% if section.settings.show_wishlist and settings.wishlist_mode != '0' %}
          <a href="{{ routes.search_url }}?view=wishlist">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20.5 5.8c-1.9-2-5-2-6.9 0L12 7.5l-1.6-1.7c-1.9-2-5-2-6.9 0-2 2.1-2 5.4 0 7.5L12 22l8.5-8.7c2-2.1 2-5.4 0-7.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
            <span>Wishlist</span>
          </a>
        {% endif %}
      </div>
    </aside>
  </div>
</tjs-premium-header>

<script>
  (() => {
    if (customElements.get('tjs-premium-header')) return;

    class TJSPremiumHeader extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready === 'true') return;
        this.dataset.ready = 'true';

        this.stickyMode = this.dataset.stickyMode || 'on_scroll_up';
        this.predictiveUrl = this.dataset.predictiveUrl || '/search/suggest';
        this.searchUrl = this.dataset.searchUrl || '/search';
        this.minimumCharacters = Number(this.dataset.minSearchCharacters || 2);
        this.currency = this.dataset.currency || 'INR';
        this.lastScrollY = window.scrollY;
        this.scrollTicking = false;
        this.lastFocusedElement = null;
        this.menuOverlay = this.querySelector('[data-tjs-menu-overlay]');
        this.menuOpenButton = this.querySelector('[data-tjs-menu-open]');
        this.menuCloseButton = this.querySelector('[data-tjs-menu-close]');
        this.popularSearches = this.readPopularSearches();
        this.recentSearches = this.readRecentSearches();
        this.exactSearchRoutes = this.parseSearchMap(
          this.querySelector('[data-tjs-exact-search-routes]')?.textContent || '""'
        );
        this.searchSynonyms = this.parseSearchMap(
          this.querySelector('[data-tjs-search-synonyms]')?.textContent || '""'
        );
        this.typingEnabled = this.dataset.typingEnabled === 'true';
        this.typingSpeed = Math.max(20, Number(this.dataset.typingSpeed || 55));
        this.typingHold = Math.max(800, Number(this.dataset.typingHold || 2000));
        this.typingTerms = this.readTypingTerms();
        this.typingControllers = [];

        this.handleDocumentClick = this.handleDocumentClick.bind(this);
        this.handleKeydown = this.handleKeydown.bind(this);
        this.handleScroll = this.handleScroll.bind(this);

        this.menuOpenButton?.addEventListener('click', () => this.openMenu());
        this.menuCloseButton?.addEventListener('click', () => this.closeMenu());
        this.menuOverlay?.addEventListener('click', event => {
          if (event.target === this.menuOverlay) this.closeMenu();
        });

        document.addEventListener('click', this.handleDocumentClick);
        document.addEventListener('keydown', this.handleKeydown);
        window.addEventListener('scroll', this.handleScroll, { passive: true });
        document.addEventListener('cart:updated', () => this.refreshCartCount());

        this.setupDesktopNavigation();
        this.setupMobileNavigation();
        this.setupSearches();
        this.mobileSearchMedia=matchMedia('(max-width:1149px)');this.mobileSearchResize=()=>{if(!this.mobileSearchMedia.matches)this.closeMobileSearch()};this.mobileSearchMedia.addEventListener('change',this.mobileSearchResize);
        this.querySelector('[data-june-search-open]')?.addEventListener('click', () => {
          const root=this.querySelector('[data-tjs-mobile-search]');
          this.openMobileSearch(root,root.querySelector('input[name="q"]'));
        });
        this.setupTyping();
        this.updateScrollState();
      }

      disconnectedCallback() {
        this.closeMobileSearch();
        this.mobileSearchMedia?.removeEventListener('change',this.mobileSearchResize);
        document.removeEventListener('click', this.handleDocumentClick);
        document.removeEventListener('keydown', this.handleKeydown);
        window.removeEventListener('scroll', this.handleScroll);
        this.typingControllers?.forEach(controller => controller.abort());
      }

      readTypingTerms() {
        try {
          const values = JSON.parse(
            this.querySelector('[data-tjs-typing-terms]')?.textContent || '[]'
          );
          return Array.isArray(values)
            ? values.map(value => String(value || '').trim()).filter(Boolean)
            : [];
        } catch (error) {
          return [];
        }
      }

      setupTyping() {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        this.querySelectorAll('[data-tjs-search-root]').forEach(root => {
          const input = root.querySelector('input[name="q"]');
          const wrapper = root.querySelector('[data-tjs-typing]');
          const output = root.querySelector('[data-tjs-typing-text]');

          if (!input || !wrapper || !output) return;

          if (!this.typingEnabled || !this.typingTerms.length || reducedMotion) {
            output.textContent = this.typingTerms[0] || '';
            wrapper.hidden = Boolean(input.value);
            return;
          }

          const controller = new AbortController();
          this.typingControllers.push(controller);
          this.runTypingLoop(input, wrapper, output, controller.signal);
        });
      }

      async runTypingLoop(input, wrapper, output, signal) {
        let termIndex = 0;
        const sleep = milliseconds => new Promise(resolve => {
          const timer = window.setTimeout(resolve, milliseconds);
          signal.addEventListener('abort', () => window.clearTimeout(timer), { once: true });
        });

        while (!signal.aborted) {
          if (input.value || document.activeElement === input) {
            wrapper.hidden = true;
            await sleep(150);
            continue;
          }

          wrapper.hidden = false;
          const term = this.typingTerms[termIndex % this.typingTerms.length];

          for (let index = 1; index <= term.length && !signal.aborted; index += 1) {
            if (input.value || document.activeElement === input) break;
            output.textContent = term.slice(0, index);
            await sleep(this.typingSpeed);
          }

          if (input.value || document.activeElement === input) continue;
          await sleep(this.typingHold);

          for (let index = term.length - 1; index >= 0 && !signal.aborted; index -= 1) {
            if (input.value || document.activeElement === input) break;
            output.textContent = term.slice(0, index);
            await sleep(Math.max(18, this.typingSpeed * .55));
          }

          termIndex += 1;
          await sleep(220);
        }
      }

      readPopularSearches() {
        try {
          const data = JSON.parse(
            this.querySelector('[data-tjs-header-popular]')?.textContent || '[]'
          );

          return Array.isArray(data)
            ? data.map(item => String(item || '').trim()).filter(Boolean)
            : [];
        } catch (error) {
          return [];
        }
      }

      readRecentSearches() {
        try {
          const stored = JSON.parse(
            window.localStorage.getItem('tjs_header_recent_searches') || '[]'
          );
          return Array.isArray(stored)
            ? stored.map(item => String(item || '').trim()).filter(Boolean).slice(0, 5)
            : [];
        } catch (error) {
          return [];
        }
      }

      saveRecentSearch(query) {
        const cleanQuery = String(query || '').trim();
        if (!cleanQuery) return;
        this.recentSearches = [
          cleanQuery,
          ...this.recentSearches.filter(item =>
            item.toLowerCase() !== cleanQuery.toLowerCase()
          )
        ].slice(0, 5);
        try {
          window.localStorage.setItem(
            'tjs_header_recent_searches',
            JSON.stringify(this.recentSearches)
          );
        } catch (error) {}
      }

      parseSearchMap(jsonText) {
        let rawText = '';

        try {
          rawText = JSON.parse(jsonText || '""') || '';
        } catch (error) {
          rawText = '';
        }

        const map = new Map();

        String(rawText)
          .split(/\r?\n/)
          .map(line => line.trim())
          .filter(Boolean)
          .forEach(line => {
            const parts = line.split('=>');
            if (parts.length < 2) return;

            const destination = parts.slice(1).join('=>').trim();
            if (!destination) return;

            parts[0]
              .split('|')
              .map(alias => this.normaliseSearchKey(alias))
              .filter(Boolean)
              .forEach(alias => map.set(alias, destination));
          });

        return map;
      }

      normaliseSearchKey(value) {
        return String(value || '')
          .toLowerCase()
          .replace(/[“”"'`]/g, '')
          .replace(/&/g, ' and ')
          .replace(/[^a-z0-9]+/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      normaliseSearchQuery(query) {
        const original = String(query || '').trim();
        const key = this.normaliseSearchKey(original);
        return this.searchSynonyms.get(key) || original;
      }

      exactSearchDestination(query) {
        const key = this.normaliseSearchKey(query);
        return this.exactSearchRoutes.get(key) || '';
      }

      setupDesktopNavigation() {
        const detailsList = [...this.querySelectorAll('[data-tjs-nav-details]')];
        const hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)');
        const closeTimers = new WeakMap();

        const clearCloseTimer = details => {
          const timer = closeTimers.get(details);
          if (timer) {
            window.clearTimeout(timer);
            closeTimers.delete(details);
          }
        };

        const closeOthers = activeDetails => {
          detailsList.forEach(details => {
            if (details === activeDetails) return;
            clearCloseTimer(details);
            details.open = false;
          });
        };

        detailsList.forEach(details => {
          const summary = details.querySelector(':scope > summary');

          details.addEventListener('toggle', () => {
            if (details.open) closeOthers(details);
          });

          details.addEventListener('mouseenter', () => {
            if (!hoverCapable.matches) return;
            clearCloseTimer(details);
            closeOthers(details);
            details.open = true;
          });

          details.addEventListener('mouseleave', () => {
            if (!hoverCapable.matches) return;
            clearCloseTimer(details);

            const timer = window.setTimeout(() => {
              details.open = false;
              closeTimers.delete(details);
            }, 180);

            closeTimers.set(details, timer);
          });

          summary?.addEventListener('click', event => {
            if (!hoverCapable.matches) return;

            event.preventDefault();
            clearCloseTimer(details);

            const nextState = !details.open;
            closeOthers(details);
            details.open = nextState;
          });

          details.addEventListener('focusin', () => {
            clearCloseTimer(details);
            closeOthers(details);
            details.open = true;
          });

          details.addEventListener('focusout', event => {
            if (details.contains(event.relatedTarget)) return;

            window.setTimeout(() => {
              if (!details.contains(document.activeElement)) {
                details.open = false;
              }
            }, 0);
          });
        });
      }

      setupMobileNavigation() {
        const mainDetails = [
          ...this.querySelectorAll('[data-tjs-mobile-main]')
        ];

        mainDetails.forEach(details => {
          details.addEventListener('toggle', () => {
            if (!details.open) return;

            mainDetails.forEach(otherDetails => {
              if (otherDetails !== details) {
                otherDetails.open = false;
              }
            });
          });
        });

        this.querySelectorAll('[data-tjs-mobile-main]').forEach(main => {
          const childDetails = [
            ...main.querySelectorAll('[data-tjs-mobile-child]')
          ];

          childDetails.forEach(details => {
            details.addEventListener('toggle', () => {
              if (!details.open) return;

              childDetails.forEach(otherDetails => {
                if (otherDetails !== details) {
                  otherDetails.open = false;
                }
              });
            });
          });
        });
      }

      setupSearches() {
        this.querySelectorAll('[data-tjs-search-root]').forEach(root => {
          const form = root.querySelector('form');
          const input = root.querySelector('input[name="q"]');
          const results = root.querySelector('[data-tjs-search-results]');
          const closeButton = root.querySelector('[data-tjs-search-close]');
          const backButton = root.querySelector('[data-tjs-search-back]');
          if (!form || !input || !results) return;

          const state = { timer: null, controller: null };
          const typing = root.querySelector('[data-tjs-typing]');
          const syncTypingVisibility = () => {
            if (!typing) return;

            const shouldHide =
              Boolean(input.value) ||
              document.activeElement === input;

            typing.hidden = shouldHide;

            if (shouldHide) {
              const typingText = typing.querySelector('[data-tjs-typing-text]');
              if (typingText) typingText.textContent = '';
            }
          };

          input.addEventListener('focus', () => {
            syncTypingVisibility();
            if (root.hasAttribute('data-tjs-mobile-search')) {
              this.openMobileSearch(root, input);
            }
            if (input.value.trim().length >= this.minimumCharacters) {
              this.requestSuggestions(input, results, state);
            } else {
              this.renderPopular(results, input.value);
            }
          });

          input.addEventListener('blur', () => {
            window.setTimeout(syncTypingVisibility, 120);
          });

          input.addEventListener('input', () => {
            syncTypingVisibility();
            window.clearTimeout(state.timer);
            const query = input.value.trim();
            if (query.length < this.minimumCharacters) {
              state.controller?.abort();
              this.renderPopular(results, query);
              return;
            }
            state.timer = window.setTimeout(() => {
              this.requestSuggestions(input, results, state);
            }, 190);
          });

          input.addEventListener('keydown', event => {
            if (event.key === 'Escape') {
              this.closeMobileSearch(root);
              this.hideResults(results);
              input.blur();
              return;
            }
            if (event.key === 'ArrowDown' && !results.hidden) {
              const firstLink = results.querySelector('a[href]');
              if (firstLink) {
                event.preventDefault();
                firstLink.focus();
              }
            }
          });

          const closeSearchOverlay = () => {
            this.closeMobileSearch(root);
            this.hideResults(results);
            input.blur();
          };

          closeButton?.addEventListener('click', closeSearchOverlay);
          backButton?.addEventListener('click', closeSearchOverlay);

          results.addEventListener('click', event => {
            const link = event.target.closest('a[href]');
            if (!link) return;
            try {
              const url = new URL(link.href, window.location.origin);
              const query = url.searchParams.get('q');
              if (query) this.saveRecentSearch(query);
            } catch (error) {}
          });

          results.addEventListener('keydown', event => {
            const links = [...results.querySelectorAll('a[href]')];
            const index = links.indexOf(document.activeElement);
            if (event.key === 'ArrowDown' && index > -1) {
              event.preventDefault();
              links[(index + 1) % links.length]?.focus();
            }
            if (event.key === 'ArrowUp' && index > -1) {
              event.preventDefault();
              if (index === 0) input.focus();
              else links[index - 1]?.focus();
            }
            if (event.key === 'Escape') {
              this.closeMobileSearch(root);
              this.hideResults(results);
              this.querySelector('[data-june-search-open]')?.focus({preventScroll:true});
            }
          });

          form.addEventListener('submit', event => {
            event.preventDefault();

            const query = input.value.trim();
            if (!query) return;

            this.saveRecentSearch(query);
            this.closeMobileSearch(root);
            this.hideResults(results);

            window.location.assign(this.buildSearchUrl(query));
          });
        });
      }

      openMobileSearch(root, input) {
        if (!root?.hasAttribute('data-tjs-mobile-search') || !matchMedia('(max-width:1149px)').matches || root.classList.contains('is-search-active')) return;
        this.mobileSearchScroll=window.scrollY;this.mobileSearchWidth=document.documentElement.clientWidth;
        this.mobileSearchBody={position:document.body.style.position,top:document.body.style.top,width:document.body.style.width};
        this.mobileSearchInert=[...document.body.children].filter(e=>e!==this.closest('.shopify-section')&&!e.contains(this)&&!['SCRIPT','STYLE'].includes(e.tagName)).map(e=>[e,e.inert]);
        this.mobileSearchInert.forEach(([e])=>e.inert=true);
        root.classList.add('is-search-active');root.setAttribute('role','dialog');root.setAttribute('aria-modal','true');root.setAttribute('aria-label','Search the shop');
        this.classList.add('is-mobile-search-open');document.documentElement.classList.add('tjs-ph-search-open');
        document.body.style.position='fixed';document.body.style.top=-this.mobileSearchScroll+'px';document.body.style.width=this.mobileSearchWidth+'px';
        this.querySelector('[data-june-search-open]')?.setAttribute('aria-expanded','true');
        this.mobileSearchViewport=()=>{const v=window.visualViewport;root.style.setProperty('--june-search-height',(v?.height||innerHeight)+'px');root.style.setProperty('--june-search-top',(v?.offsetTop||0)+'px')};
        this.mobileSearchViewport();window.visualViewport?.addEventListener('resize',this.mobileSearchViewport);window.visualViewport?.addEventListener('scroll',this.mobileSearchViewport);
        this.mobileSearchTrap=e=>{if(e.key!=='Tab')return;const items=[...root.querySelectorAll('a[href],button,input:not([type="hidden"])')].filter(el=>el.getClientRects().length&&!el.disabled);if(!items.length)return;const first=items[0],last=items[items.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}};
        root.addEventListener('keydown',this.mobileSearchTrap);
        input?.focus({preventScroll:true});
      }

      closeMobileSearch(root = null) {
        const targets=root?[root]:[...this.querySelectorAll('[data-tjs-mobile-search].is-search-active')];
        const wasOpen=this.classList.contains('is-mobile-search-open');
        targets.forEach(target=>{target.classList.remove('is-search-active');target.removeAttribute('role');target.removeAttribute('aria-modal');target.removeAttribute('aria-label');target.removeEventListener('keydown',this.mobileSearchTrap)});
        if(!this.querySelector('[data-tjs-mobile-search].is-search-active')){
          this.classList.remove('is-mobile-search-open');document.documentElement.classList.remove('tjs-ph-search-open');
          if(wasOpen){
            Object.assign(document.body.style,this.mobileSearchBody||{});
            this.mobileSearchInert?.forEach(([e,inert])=>e.inert=inert);this.mobileSearchInert=null;
            window.visualViewport?.removeEventListener('resize',this.mobileSearchViewport);window.visualViewport?.removeEventListener('scroll',this.mobileSearchViewport);
            const returnY=this.mobileSearchScroll||0;window.scrollTo({top:returnY,behavior:'instant'});requestAnimationFrame(()=>{if(!this.classList.contains('is-mobile-search-open'))window.scrollTo({top:returnY,behavior:'instant'})});
            this.querySelector('[data-june-search-open]')?.setAttribute('aria-expanded','false');
            this.querySelector('[data-june-search-open]')?.focus({preventScroll:true});
          }
        }
      }

      async requestSuggestions(input, results, state) {
        const query = input.value.trim();
        if (query.length < this.minimumCharacters) return;

        const requestQuery = this.normaliseSearchQuery(query);

        state.controller?.abort();
        state.controller = new AbortController();

        const endpoint = this.predictiveUrl.endsWith('.json')
          ? this.predictiveUrl
          : `${this.predictiveUrl}.json`;

        const url = new URL(endpoint, window.location.origin);
        url.searchParams.set('q', requestQuery);
        url.searchParams.set('resources[type]', 'product,query,collection');
        url.searchParams.set('resources[limit]', '6');
        url.searchParams.set('resources[limit_scope]', 'each');
        url.searchParams.set('resources[options][unavailable_products]', 'last');
        url.searchParams.set('resources[options][prefix]', 'last');
        url.searchParams.set(
          'resources[options][fields]',
          'title,product_type,variants.title,variants.sku'
        );

        results.hidden = false;
        results.innerHTML = `
          <div class="tjs-ph__predictive-group">
            <span class="tjs-ph__predictive-label">Searching</span>
            <a class="tjs-ph__predictive-link" href="${this.buildSearchUrl(query)}">
              Finding the best matches…
            </a>
          </div>
        `;

        try {
          const response = await fetch(url.toString(), {
            signal: state.controller.signal,
            headers: { Accept: 'application/json' }
          });

          if (!response.ok) throw new Error('Search request failed.');

          const payload = await response.json();

          if (input.value.trim() !== query) return;

          const resources =
            payload?.resources?.results ||
            payload?.resources ||
            payload?.results ||
            {};

          this.renderPredictiveResults(results, query, resources);
        } catch (error) {
          if (error.name === 'AbortError') return;
          this.renderFallback(results, query);
        }
      }

      renderPredictiveResults(results, query, resources) {
        const products = Array.isArray(resources.products) ? resources.products : [];
        const queries = Array.isArray(resources.queries) ? resources.queries : [];
        const collections = Array.isArray(resources.collections) ? resources.collections : [];

        const groups = [];

        if (queries.length) {
          groups.push(`
            <div class="tjs-ph__predictive-group">
              <span class="tjs-ph__predictive-label">Suggested searches</span>
              <ul class="tjs-ph__predictive-list">
                ${queries.slice(0, 4).map(item => {
                  const text = item.text || item.title || query;
                  const href = this.buildSearchUrl(text);

                  return `
                    <li>
                      <a class="tjs-ph__predictive-link" href="${this.escapeAttribute(href)}">
                        <span>${this.escapeHtml(text)}</span>
                      </a>
                    </li>
                  `;
                }).join('')}
              </ul>
            </div>
          `);
        }

        if (products.length) {
          groups.push(`
            <div class="tjs-ph__predictive-group">
              <span class="tjs-ph__predictive-label">Products</span>
              <ul class="tjs-ph__predictive-list">
                ${products.slice(0, 6).map(product => {
                  const image =
                    product.featured_image?.url ||
                    product.image?.url ||
                    product.image ||
                    product.featured_image ||
                    '';
                  const title = product.title || 'Product';
                  const href = product.url || '#';
                  const priceMarkup = this.productPriceMarkup(product);
                  const meta =
                    product.available === false
                      ? 'Sold out'
                      : (product.type || product.product_type || product.vendor || 'Available');

                  return `
                    <li>
                      <a class="tjs-ph__predictive-link" href="${this.escapeAttribute(href)}">
                        ${image ? `
                          <span class="tjs-ph__predictive-image">
                            <img src="${this.escapeAttribute(image)}" alt="" loading="lazy">
                          </span>
                        ` : ''}
                        <span class="tjs-ph__predictive-copy">
                          <strong>${this.escapeHtml(title)}</strong>
                          ${priceMarkup}
                          <span class="tjs-ph__predictive-meta">${this.escapeHtml(meta)}</span>
                        </span>
                      </a>
                    </li>
                  `;
                }).join('')}
              </ul>
            </div>
          `);
        }

        if (collections.length) {
          groups.push(`
            <div class="tjs-ph__predictive-group">
              <span class="tjs-ph__predictive-label">Collections</span>
              <ul class="tjs-ph__predictive-list">
                ${collections.slice(0, 3).map(collection => `
                  <li>
                    <a class="tjs-ph__predictive-link" href="${this.escapeAttribute(collection.url || '#')}">
                      <span>${this.escapeHtml(collection.title || 'Collection')}</span>
                    </a>
                  </li>
                `).join('')}
              </ul>
            </div>
          `);
        }

        if (!groups.length) {
          this.renderFallback(results, query);
          return;
        }

        results.innerHTML = `
          ${groups.join('')}
          <a class="tjs-ph__predictive-view-all" href="${this.buildSearchUrl(query)}">
            <span>View all results</span>
            <span aria-hidden="true">→</span>
          </a>
        `;
        results.hidden = false;
      }

      renderPopular(results, currentQuery = '') {
        if (currentQuery) {
          this.hideResults(results);
          return;
        }

        const groups = [];

        if (this.recentSearches.length) {
          groups.push(`
            <div class="tjs-ph__predictive-group">
              <span class="tjs-ph__predictive-label">Recent searches</span>
              <ul class="tjs-ph__predictive-list">
                ${this.recentSearches.slice(0, 5).map(term => `
                  <li><a class="tjs-ph__predictive-link" href="${this.buildSearchUrl(term)}"><span>${this.escapeHtml(term)}</span></a></li>
                `).join('')}
              </ul>
            </div>
          `);
        }

        if (this.popularSearches.length) {
          groups.push(`
            <div class="tjs-ph__predictive-group">
              <span class="tjs-ph__predictive-label">Popular right now</span>
              <ul class="tjs-ph__predictive-list">
                ${this.popularSearches.slice(0, 6).map(term => `
                  <li><a class="tjs-ph__predictive-link" href="${this.buildSearchUrl(term)}"><span>${this.escapeHtml(term)}</span></a></li>
                `).join('')}
              </ul>
            </div>
          `);
        }

        if (!groups.length) {
          this.hideResults(results);
          return;
        }

        results.innerHTML = groups.join('');
        results.hidden = false;
      }

      productPriceMarkup(product) {
        const priceValue = product.price ?? product.price_min ?? product.price_max ?? '';
        const compareValue =
          product.compare_at_price ??
          product.compare_at_price_min ??
          product.compare_at_price_max ??
          '';

        const priceText = this.formatPredictiveMoney(priceValue);
        const compareText = this.formatPredictiveMoney(compareValue);
        const priceNumber = this.predictiveMoneyNumber(priceValue);
        const compareNumber = this.predictiveMoneyNumber(compareValue);
        const hasCompare =
          priceText &&
          compareText &&
          Number.isFinite(priceNumber) &&
          Number.isFinite(compareNumber) &&
          compareNumber > priceNumber;

        if (!priceText) return '';

        const saving = hasCompare
          ? Math.round(((compareNumber - priceNumber) * 100) / compareNumber)
          : 0;

        return `
          <span class="tjs-ph__predictive-price">
            <strong>${this.escapeHtml(priceText)}</strong>
            ${hasCompare ? `<s>${this.escapeHtml(compareText)}</s>` : ''}
            ${saving > 0 ? `<span class="tjs-ph__predictive-saving">Save ${saving}%</span>` : ''}
          </span>
        `;
      }

      predictiveMoneyRaw(value) {
        if (value === null || value === undefined) return '';
        if (typeof value === 'object') {
          return value.amount ?? value.value ?? value.min ?? value.max ?? '';
        }
        return value;
      }

      predictiveMoneyNumber(value) {
        const raw = this.predictiveMoneyRaw(value);
        if (raw === '') return Number.NaN;
        return Number(String(raw).replace(/,/g, '').replace(/[^0-9.-]/g, ''));
      }

      formatPredictiveMoney(value) {
        const raw = this.predictiveMoneyRaw(value);
        if (raw === '') return '';
        const rawText = String(raw).trim();
        if (/[₹$£€]|Rs\.?|INR/i.test(rawText)) return rawText;
        const number = Number(rawText.replace(/,/g, ''));
        if (!Number.isFinite(number)) return rawText;
        try {
          return new Intl.NumberFormat('en-IN', {
            style: 'currency',
            currency: this.currency,
            maximumFractionDigits: 0
          }).format(number);
        } catch (error) {
          return `₹${Math.round(number).toLocaleString('en-IN')}`;
        }
      }

      renderFallback(results, query) {
        results.innerHTML = `
          <div class="tjs-ph__predictive-group">
            <span class="tjs-ph__predictive-label">Search The June Shop</span>
            <a class="tjs-ph__predictive-link" href="${this.buildSearchUrl(query)}">
              View results for “${this.escapeHtml(query)}”
            </a>
          </div>
        `;
        results.hidden = false;
      }

      hideResults(results) {
        results.hidden = true;
        results.innerHTML = '';
      }

      buildSearchUrl(query) {
        const cleanQuery = String(query || '').trim();
        const exactDestination = this.exactSearchDestination(cleanQuery);

        if (exactDestination) {
          const destinationUrl = new URL(exactDestination, window.location.origin);
          return destinationUrl.pathname + destinationUrl.search;
        }

        const normalizedQuery = this.normaliseSearchQuery(cleanQuery);
        const url = new URL(this.searchUrl, window.location.origin);

        url.search = '';
        url.searchParams.set('q', normalizedQuery);
        url.searchParams.set('type', 'product');
        url.searchParams.set('options[prefix]', 'last');
        url.searchParams.set('options[unavailable_products]', 'last');
        url.searchParams.set(
          'options[fields]',
          'title,product_type,variants.title,variants.sku'
        );

        return url.pathname + url.search;
      }

      escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, character => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;'
        })[character]);
      }

      escapeAttribute(value) {
        return this.escapeHtml(String(value || ''));
      }

      openMenu() {
        if (!this.menuOverlay) return;

        this.lastFocusedElement = document.activeElement;
        this.menuOverlay.hidden = false;
        this.menuOverlay.setAttribute('aria-hidden', 'false');
        this.menuOpenButton?.setAttribute('aria-expanded', 'true');
        document.documentElement.classList.add('tjs-ph-menu-open');

        requestAnimationFrame(() => {
          this.menuOverlay.classList.add('is-open');
          this.menuCloseButton?.focus();
        });
      }

      closeMenu() {
        if (!this.menuOverlay || this.menuOverlay.hidden) return;

        this.menuOverlay.classList.remove('is-open');
        this.menuOverlay.setAttribute('aria-hidden', 'true');
        this.menuOpenButton?.setAttribute('aria-expanded', 'false');
        document.documentElement.classList.remove('tjs-ph-menu-open');

        window.setTimeout(() => {
          this.menuOverlay.hidden = true;
          if(!this.classList.contains('is-mobile-search-open'))this.lastFocusedElement?.focus?.({preventScroll:true});
        }, 240);
      }

      handleDocumentClick(event) {
        if(event.target.closest('[data-june-search-open]')) return;
        if (!this.contains(event.target)) {
          this.querySelectorAll('[data-tjs-nav-details][open]').forEach(details => {
            details.open = false;
          });
        }

        this.querySelectorAll('[data-tjs-search-root]').forEach(root => {
          if (root.contains(event.target)) return;
          const results = root.querySelector('[data-tjs-search-results]');
          if (results) this.hideResults(results);
        });
      }

      handleKeydown(event) {
        if (event.key === 'Escape') {
          this.closeMenu();
          this.closeMobileSearch();

          this.querySelectorAll('[data-tjs-nav-details][open]').forEach(details => {
            details.open = false;
          });

          this.querySelectorAll('[data-tjs-search-results]').forEach(results => {
            this.hideResults(results);
          });
        }
      }

      handleScroll() {
        if (this.scrollTicking) return;

        this.scrollTicking = true;

        requestAnimationFrame(() => {
          this.updateScrollState();
          this.scrollTicking = false;
        });
      }

      updateScrollState() {
        const currentY = Math.max(0, window.scrollY);
        const delta = currentY - this.lastScrollY;

        this.classList.toggle('is-scrolled', currentY > 18);

        const desktopViewport =
          window.matchMedia('(min-width: 1150px)').matches;

        if (this.stickyMode === 'on_scroll_up' && desktopViewport) {
          const shouldHide =
            currentY > 150 &&
            delta > 7 &&
            !this.menuOverlay?.classList.contains('is-open') &&
            !this.classList.contains('is-mobile-search-open');

          const shouldShow = delta < -5 || currentY < 90;

          if (shouldHide) this.classList.add('is-hidden');
          if (shouldShow) this.classList.remove('is-hidden');
        } else {
          this.classList.remove('is-hidden');
        }

        this.lastScrollY = currentY;
      }

      async refreshCartCount() {
        try {
          const response = await fetch('/cart.js', {
            headers: { Accept: 'application/json' }
          });

          if (!response.ok) return;

          const cart = await response.json();

          this.querySelectorAll('[data-tjs-cart-count]').forEach(node => {
            node.textContent = cart.item_count;
          });
        } catch (error) {}
      }
    }

    customElements.define('tjs-premium-header', TJSPremiumHeader);
  })();
</script>

