{% comment %}
  TJS Fun + Premium Floating Header
  Standalone header section for The June Shop.

  Integrations retained:
  - Existing CartDrawer through aria-controls="CartDrawer"
  - Native Shopify account and wishlist routes
  - TJS Smart Search through data-frm-search / data-input-search
  - Native Shopify Predictive Search JSON endpoint
{% endcomment %}

{% liquid
  assign tjs_header_menu = section.settings.main_menu
  if tjs_header_menu == blank
    assign tjs_header_menu = linklists['main-menu']
  endif

  assign tjs_mobile_menu = section.settings.mobile_menu | default: tjs_header_menu
  assign tjs_logo_mobile = section.settings.logo_mobile | default: section.settings.logo
  assign tjs_logo_width_2x = section.settings.logo_width | times: 2
  assign tjs_logo_mobile_width_2x = section.settings.logo_width_mobile | times: 2
  assign tjs_logo_sizes = section.settings.logo_width | append: 'px'
  assign tjs_logo_mobile_sizes = section.settings.logo_width_mobile | append: 'px'
  assign tjs_logo_alt = section.settings.logo.alt | default: shop.name
  assign tjs_logo_mobile_alt = tjs_logo_mobile.alt | default: tjs_logo_alt
  assign tjs_logo_scrolled_width = section.settings.logo_width | times: 88 | divided_by: 100
  assign tjs_popular_searches = section.settings.popular_searches | split: ','
  assign tjs_glass_strength = section.settings.glass_strength
  assign tjs_menu_promo_block = blank
  assign tjs_menu_promo_alt = blank

  comment
    Smart mega-menu defaults remain active even when the optional
    "Mega menu controls" block has not been added to an existing header.
  endcomment
  assign tjs_mega_controls_block = blank
  assign tjs_mega_types_enabled = true
  assign tjs_mega_types_mobile = true
  assign tjs_mega_types_limit = 5
  assign tjs_mega_view_all = true
  assign tjs_mega_hide_shop_all = true
  assign tjs_mega_source = 'curated_fallback'

  for block in section.blocks
    if block.type == 'menu_card' and tjs_menu_promo_block == blank
      assign tjs_menu_promo_block = block
      assign tjs_menu_promo_alt = block.settings.image.alt | default: block.settings.title
    elsif block.type == 'mega_menu_controls' and tjs_mega_controls_block == blank
      assign tjs_mega_controls_block = block
      assign tjs_mega_types_enabled = block.settings.enable_product_types
      assign tjs_mega_types_mobile = block.settings.show_product_types_mobile
      assign tjs_mega_types_limit = block.settings.max_product_types
      assign tjs_mega_view_all = block.settings.show_child_view_all
      assign tjs_mega_hide_shop_all = block.settings.hide_duplicate_shop_all
      assign tjs_mega_source = block.settings.product_type_source
    endif
  endfor
%}

{% style %}
  {% unless section.settings.sticky_mode == 'none' %}
    #shopify-section-{{ section.id }} {
      position: sticky;
      z-index: 80;
      top: 0;
    }
  {% endunless %}

  #shopify-section-{{ section.id }} {
    isolation: isolate;
  }

  #TjsPremiumHeader-{{ section.id }} {
    --tjs-ph-bg: {{ section.settings.background }};
    --tjs-ph-text: {{ section.settings.text_color }};
    --tjs-ph-muted: {{ section.settings.muted_color }};
    --tjs-ph-accent: {{ section.settings.accent }};
    --tjs-ph-border: {{ section.settings.border_color }};
    --tjs-ph-glass: {{ tjs_glass_strength }}%;
    --tjs-ph-glass-blur: {{ section.settings.glass_blur }}px;
    --tjs-ph-glass-saturate: {{ section.settings.glass_saturation }}%;
    --tjs-ph-glass-highlight: {{ section.settings.glass_highlight | times: 0.01 }};
    --tjs-ph-radius: {{ section.settings.shell_radius }}px;
    --tjs-ph-max: {{ section.settings.max_width }}px;
    --tjs-ph-desktop-height: {{ section.settings.desktop_height }}px;
    --tjs-ph-mobile-top-height: {{ section.settings.mobile_top_height }}px;
    --tjs-ph-search-height: {{ section.settings.search_height }}px;

    position: relative;
    z-index: 80;
    display: block;
    width: 100%;
    color: var(--tjs-ph-text);
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    transform: translateY(0);
    transition: transform .28s cubic-bezier(.22, .61, .36, 1);
    -webkit-font-smoothing: antialiased;
  }

  #TjsPremiumHeader-{{ section.id }} *,
  #TjsPremiumHeader-{{ section.id }} *::before,
  #TjsPremiumHeader-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #TjsPremiumHeader-{{ section.id }} a {
    color: inherit;
  }

  #TjsPremiumHeader-{{ section.id }} button,
  #TjsPremiumHeader-{{ section.id }} input {
    font: inherit;
  }

  #TjsPremiumHeader-{{ section.id }}.is-hidden {
    transform: translateY(calc(-100% - 14px));
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__note {
    min-height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 5px 14px;
    background: var(--tjs-ph-text);
    color: var(--tjs-ph-bg);
    font-size: 9px;
    font-weight: 720;
    letter-spacing: .045em;
    text-align: center;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__note::before {
    content: "";
    width: 5px;
    height: 5px;
    flex: 0 0 5px;
    border-radius: 50%;
    background: var(--tjs-ph-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--tjs-ph-accent) 18%, transparent);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__note a {
    text-decoration: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__shell {
    position: relative;
    z-index: 2;
    width: 100%;
    overflow: visible;
    border-bottom: 1px solid var(--tjs-ph-border);
    background: var(--tjs-ph-bg);
    transition:
      margin .28s cubic-bezier(.22, .61, .36, 1),
      border-radius .28s cubic-bezier(.22, .61, .36, 1),
      border-color .2s ease,
      background-color .2s ease,
      box-shadow .28s ease;
  }

  #TjsPremiumHeader-{{ section.id }}.is-home-transparent:not(.is-scrolled) .tjs-ph__shell {
    border-color: transparent;
    background: transparent;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__inner {
    width: min(calc(100% - 30px), var(--tjs-ph-max));
    margin-inline: auto;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__desktop {
    min-height: var(--tjs-ph-desktop-height);
    display: none;
    grid-template-columns: auto minmax(260px, 1fr) minmax(230px, 330px) auto;
    align-items: center;
    gap: clamp(18px, 2vw, 34px);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    color: var(--tjs-ph-text);
    text-decoration: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__brand img {
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
    display: block;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__brand-text {
    font-family: var(--font-heading-family, var(--font-body-family, serif));
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -.035em;
    white-space: nowrap;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav {
    min-width: 0;
    height: 100%;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-list {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.menu_alignment }};
    gap: clamp(14px, 1.55vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-item {
    height: 100%;
    display: flex;
    align-items: center;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-link,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-summary {
    position: relative;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--tjs-ph-text);
    cursor: pointer;
    font-size: 11px;
    font-weight: 690;
    line-height: 1;
    letter-spacing: .006em;
    text-decoration: none;
    white-space: nowrap;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-link::after,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-summary::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 4px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .22s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-link:hover::after,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-link:focus-visible::after,
  #TjsPremiumHeader-{{ section.id }} details[open] > .tjs-ph__nav-summary::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-badge {
    position: absolute;
    top: -7px;
    right: -10px;
    min-height: 14px;
    display: inline-flex;
    align-items: center;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--tjs-ph-accent);
    color: var(--tjs-ph-text);
    font-size: 6px;
    font-weight: 820;
    letter-spacing: .045em;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-details {
    height: 100%;
    display: flex;
    align-items: center;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-details > summary {
    list-style: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-details > summary::-webkit-details-marker {
    display: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-caret {
    width: 8px;
    height: 8px;
    transition: transform .2s ease;
  }

  #TjsPremiumHeader-{{ section.id }} details[open] .tjs-ph__nav-caret {
    transform: rotate(180deg);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown {
    position: absolute;
    z-index: 20;
    top: calc(100% - 1px);
    right: 0;
    left: 0;
    padding: 14px 15px 18px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-7px);
    transition:
      opacity .18s ease,
      visibility .18s ease,
      transform .22s cubic-bezier(.22, .61, .36, 1);
  }

  #TjsPremiumHeader-{{ section.id }} details[open] > .tjs-ph__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-panel {
    width: min(100%, var(--tjs-ph-max));
    display: grid;
    grid-template-columns: minmax(170px, .65fr) minmax(0, 2.35fr);
    gap: 28px;
    margin-inline: auto;
    padding: 24px;
    border: 1px solid color-mix(in srgb, var(--tjs-ph-border) 88%, transparent);
    border-radius: calc(var(--tjs-ph-radius) + 2px);
    background: color-mix(in srgb, var(--tjs-ph-bg) 94%, transparent);
    box-shadow: 0 26px 70px rgba(23, 18, 14, .14);
    backdrop-filter: blur(22px) saturate(145%);
    -webkit-backdrop-filter: blur(22px) saturate(145%);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 4px 22px 4px 2px;
    border-right: 1px solid var(--tjs-ph-border);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro small {
    color: var(--tjs-ph-text);
    font-size: 7px;
    font-weight: 820;
    letter-spacing: .095em;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro strong {
    font-family: var(--font-heading-family, var(--font-body-family, serif));
    font-size: 24px;
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -.035em;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro a {
    width: max-content;
    margin-top: 7px;
    color: var(--tjs-ph-text);
    font-size: 9px;
    font-weight: 780;
    letter-spacing: .04em;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-columns {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-column {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 9px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-heading {
    color: var(--tjs-ph-text);
    font-size: 10px;
    font-weight: 780;
    line-height: 1.25;
    text-decoration: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child {
    color: var(--tjs-ph-muted);
    font-size: 9px;
    font-weight: 560;
    line-height: 1.35;
    text-decoration: none;
    transition: color .16s ease, transform .16s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child:hover {
    color: var(--tjs-ph-text);
    transform: translateX(2px);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search-wrap {
    position: relative;
    z-index: 15;
    min-width: 0;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search {
    position: relative;
    min-width: 0;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search input {
    width: 100%;
    height: var(--tjs-ph-search-height);
    padding: 0 44px 0 16px;
    border: 1px solid var(--tjs-ph-border);
    border-radius: 999px;
    outline: 0;
    background: color-mix(in srgb, var(--tjs-ph-bg) 76%, transparent);
    color: var(--tjs-ph-text);
    font-size: 10px;
    font-weight: 560;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.6);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition:
      border-color .18s ease,
      box-shadow .18s ease,
      background-color .18s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search input::placeholder {
    color: var(--tjs-ph-muted);
    opacity: .82;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search input:focus {
    border-color: color-mix(in srgb, var(--tjs-ph-accent) 48%, var(--tjs-ph-border));
    background: color-mix(in srgb, var(--tjs-ph-bg) 92%, transparent);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--tjs-ph-accent) 9%, transparent),
      0 10px 28px rgba(24, 18, 14, .08);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search button {
    width: 36px;
    height: 36px;
    position: absolute;
    top: 50%;
    right: 5px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--tjs-ph-text);
    color: var(--tjs-ph-bg);
    cursor: pointer;
    transform: translateY(-50%);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search button svg {
    width: 15px;
    height: 15px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive {
    position: absolute;
    z-index: 50;
    top: calc(100% + 9px);
    right: 0;
    left: 0;
    max-height: min(64vh, 520px);
    overflow-y: auto;
    padding: 10px;
    border: 1px solid var(--tjs-ph-border);
    border-radius: calc(var(--tjs-ph-radius) + 1px);
    background: color-mix(in srgb, var(--tjs-ph-bg) 95%, transparent);
    box-shadow: 0 22px 58px rgba(23, 18, 14, .16);
    backdrop-filter: blur(22px) saturate(145%);
    -webkit-backdrop-filter: blur(22px) saturate(145%);
    scrollbar-width: thin;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive[hidden] {
    display: none !important;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-group + .tjs-ph__predictive-group {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--tjs-ph-border);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-label {
    display: block;
    margin: 0 0 7px;
    padding-inline: 4px;
    color: var(--tjs-ph-muted);
    font-size: 7px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-list {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-link {
    min-height: 36px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 5px 7px;
    border-radius: 8px;
    color: var(--tjs-ph-text);
    font-size: 9px;
    font-weight: 620;
    line-height: 1.25;
    text-decoration: none;
    transition: background-color .16s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-link:hover,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-link:focus-visible {
    outline: none;
    background: color-mix(in srgb, var(--tjs-ph-accent) 8%, transparent);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-image {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    overflow: hidden;
    border-radius: 7px;
    background: color-mix(in srgb, var(--tjs-ph-border) 55%, transparent);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-copy {
    min-width: 0;
    display: grid;
    gap: 2px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-copy strong {
    overflow: hidden;
    font-size: 9px;
    font-weight: 690;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-copy small {
    color: var(--tjs-ph-muted);
    font-size: 7px;
    font-weight: 560;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__predictive-view-all {
    min-height: 38px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    padding: 0 10px;
    border-radius: 8px;
    background: var(--tjs-ph-text);
    color: var(--tjs-ph-bg);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__icon-link,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__menu-toggle {
    position: relative;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--tjs-ph-border) 82%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--tjs-ph-bg) 72%, transparent);
    color: var(--tjs-ph-text);
    cursor: pointer;
    text-decoration: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      border-color .16s ease,
      background-color .16s ease,
      transform .16s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__icon-link:hover,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__menu-toggle:hover {
    border-color: color-mix(in srgb, var(--tjs-ph-accent) 45%, var(--tjs-ph-border));
    background: color-mix(in srgb, var(--tjs-ph-accent) 7%, var(--tjs-ph-bg));
    transform: translateY(-1px);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__icon-link svg,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__menu-toggle svg {
    width: 18px;
    height: 18px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__count {
    min-width: 17px;
    height: 17px;
    position: absolute;
    top: -4px;
    right: -4px;
    display: grid;
    place-items: center;
    padding: 0 4px;
    border: 2px solid var(--tjs-ph-bg);
    border-radius: 999px;
    background: var(--tjs-ph-accent);
    color: var(--tjs-ph-text);
    font-size: 7px;
    font-weight: 840;
    line-height: 1;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile {
    display: grid;
    gap: 8px;
    padding: 8px 0 10px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-top {
    min-height: var(--tjs-ph-mobile-top-height);
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 42px;
    align-items: center;
    gap: 8px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile .tjs-ph__brand {
    justify-self: center;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile .tjs-ph__brand img {
    width: {{ section.settings.logo_width_mobile }}px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile .tjs-ph__search input {
    background: color-mix(in srgb, var(--tjs-ph-bg) 84%, transparent);
    box-shadow: 0 7px 22px rgba(23, 18, 14, .055);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-menu {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: rgba(17, 14, 12, .38);
    opacity: 0;
    visibility: hidden;
