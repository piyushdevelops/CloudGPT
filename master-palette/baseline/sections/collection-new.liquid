{% comment %}
  TJS Collection Grid — corrected clean build
  - No hero or banner
  - Edge-to-edge product media
  - Single-select tabs with removable active state
  - Meaningful badges only
  - Dynamic collection title after AJAX category changes
  - Selected variant specifications beneath each product
  - No collection-page Add to Cart action
  - Smart colour/text variant presentation with expandable values
  - Editorial curtain reveal on desktop hover and mobile swipe
  - Animated variant-image transitions and one-time scroll settling
  - Compact mobile-first layout
{% endcomment %}

{% liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign tabs_root = section.settings.tabs_root_collection
  if tabs_root == blank
    assign tabs_root = collection
  endif

  assign manual_tab_count = 0
  for block in section.blocks
    if block.type == 'tab' and block.settings.collection != blank
      if block.settings.parent_collection == blank or block.settings.parent_collection.handle == tabs_root.handle
        assign manual_tab_count = manual_tab_count | plus: 1
      endif
    endif
  endfor

  assign product_type_filter = nil
  assign availability_filter = nil
  assign availability_param = blank
  assign availability_value = blank

  for filter in collection.filters
    if filter.param_name contains 'product_type'
      assign product_type_filter = filter
    elsif filter.param_name contains 'availability'
      assign availability_filter = filter
      for value in filter.values
        assign availability_label_downcase = value.label | downcase
        if availability_value == blank and value.count > 0
          if value.value == '1' or availability_label_downcase contains 'in stock'
            assign availability_param = value.param_name
            assign availability_value = value.value
          endif
        endif
      endfor
    endif
  endfor

  assign automatic_type_active = false
  if product_type_filter != nil and product_type_filter.active_values.size > 0
    assign automatic_type_active = true
  endif

  assign dynamic_collection_title = collection.title
  if product_type_filter != nil and product_type_filter.active_values.size > 0
    assign active_type_title = product_type_filter.active_values.first.label
    if active_type_title != blank
      assign dynamic_collection_title = active_type_title
    endif
  endif

  assign smart_filter_count = 0
  assign active_filter_count = 0

  for filter in collection.filters
    unless filter.param_name contains 'availability' or filter.param_name contains 'product_type'
      assign filter_has_available_values = false

      if filter.type == 'price_range'
        assign filter_has_available_values = true
        if filter.min_value.value != blank or filter.max_value.value != blank
          assign active_filter_count = active_filter_count | plus: 1
        endif
      else
        for value in filter.values
          if value.count > 0 or value.active
            assign filter_has_available_values = true
            break
          endif
        endfor
        assign active_filter_count = active_filter_count | plus: filter.active_values.size
      endif

      if filter_has_available_values
        assign smart_filter_count = smart_filter_count | plus: 1
      endif
    endunless
  endfor
%}

<tjs-final-collection
  id="TjsFinalCollection-{{ section.id }}"
  class="tjs-final-collection"
  data-section-id="{{ section.id }}"
  data-force-in-stock="{{ section.settings.force_in_stock }}"
  data-availability-param="{{ availability_param | escape }}"
  data-availability-value="{{ availability_value | escape }}"
  style="
    --tjs-bg: {{ section.settings.page_background }};
    --tjs-text: {{ section.settings.text_color }};
    --tjs-muted: {{ section.settings.muted_text_color }};
    --tjs-surface: {{ section.settings.image_surface }};
    --tjs-accent: {{ section.settings.accent_color }};
    --tjs-accent-soft: {{ section.settings.accent_soft }};
    --tjs-button: {{ section.settings.button_background }};
    --tjs-button-text: {{ section.settings.button_text }};
    --tjs-border: {{ section.settings.border_color }};
    --tjs-max: {{ section.settings.max_width }}px;
    --tjs-columns: {{ section.settings.desktop_columns }};
    --tjs-gap: {{ section.settings.card_gap }}px;
    --tjs-radius: {{ section.settings.image_radius }}px;
    --tjs-image-ratio: {% case section.settings.image_ratio %}{% when 'square' %}1 / 1{% when 'three-four' %}3 / 4{% else %}4 / 5{% endcase %};
    --tjs-image-fit: {{ section.settings.image_fit }};
    --tjs-image-scale: {{ section.settings.image_scale | times: 0.01 }};
    --tjs-top: {{ section.settings.padding_top }}px;
    --tjs-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <section class="tjs-final-collection__section">
    <div class="tjs-final-collection__inner">
      <header class="tjs-final-collection__header">
        <div class="tjs-final-collection__heading-wrap">
          {% if section.settings.dynamic_eyebrow %}
            <p class="tjs-final-collection__eyebrow">{{ dynamic_collection_title | escape }}</p>
          {% elsif section.settings.eyebrow != blank %}
            <p class="tjs-final-collection__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          <h1 class="tjs-final-collection__heading" data-dynamic-collection-title>{{ dynamic_collection_title | escape }}</h1>
        </div>

        <div class="tjs-final-collection__controls">
          {% if smart_filter_count > 0 %}
            <button class="tjs-final-collection__filter-button" type="button" data-open-filters>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M3 5h14M6 10h8M8.5 15h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <span>{{ section.settings.filter_label | escape }}</span>
              {% if active_filter_count > 0 %}<b>{{ active_filter_count }}</b>{% endif %}
            </button>
          {% endif %}

          <label class="tjs-final-collection__sort">
            <span>{{ section.settings.sort_label | escape }}</span>
            <select data-sort>
              {% for option in collection.sort_options %}
                <option value="{{ option.value | escape }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name | escape }}</option>
              {% endfor %}
            </select>
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="m6 8 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </label>
        </div>
      </header>

      {% if manual_tab_count > 0 or product_type_filter != nil %}
        <nav class="tjs-final-collection__tabs" aria-label="{{ section.settings.tabs_label | escape }}">
          {% if manual_tab_count > 0 %}
            <a
              class="tjs-final-collection__tab{% if collection.handle == tabs_root.handle %} is-active{% endif %}"
              href="{{ tabs_root.url }}"
              data-ajax-link
            >
              <span>{{ section.settings.all_tab_label | escape }}</span>
            </a>

            {% for block in section.blocks %}
              {% if block.type == 'tab' and block.settings.collection != blank %}
                {% if block.settings.parent_collection == blank or block.settings.parent_collection.handle == tabs_root.handle %}
                  {% assign tab_collection = block.settings.collection %}
                  {% assign tab_is_active = false %}
                  {% if tab_collection.handle == collection.handle %}
                    {% assign tab_is_active = true %}
                  {% endif %}
                  <a
                    class="tjs-final-collection__tab{% if tab_is_active %} is-active{% endif %}"
                    href="{% if tab_is_active %}{{ tabs_root.url }}{% else %}{{ tab_collection.url }}{% endif %}"
                    data-ajax-link
                    {{ block.shopify_attributes }}
                  >
                    <span>{% if block.settings.label != blank %}{{ block.settings.label | escape }}{% else %}{{ tab_collection.title | escape }}{% endif %}</span>
                    {% if tab_is_active %}<small aria-hidden="true">×</small>{% endif %}
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% elsif product_type_filter != nil %}
            <a
              class="tjs-final-collection__tab{% unless automatic_type_active %} is-active{% endunless %}"
              href="{{ collection.url }}"
              data-single-tab
              data-tab-param="{{ product_type_filter.param_name | escape }}"
              data-tab-value=""
              data-tab-active="{% unless automatic_type_active %}true{% else %}false{% endunless %}"
            >
              <span>{{ section.settings.all_tab_label | escape }}</span>
            </a>

            {% for value in product_type_filter.values limit: section.settings.max_type_tabs %}
              {% if value.count > 0 or value.active %}
                <a
                  class="tjs-final-collection__tab{% if value.active %} is-active{% endif %}"
                  href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                  data-single-tab
                  data-tab-param="{{ value.param_name | escape }}"
                  data-tab-value="{{ value.value | escape }}"
                  data-tab-active="{{ value.active }}"
                >
                  <span>{{ value.label | escape }}</span>
                  {% if value.active %}<small aria-hidden="true">×</small>{% endif %}
                </a>
              {% endif %}
            {% endfor %}
          {% endif %}
        </nav>
      {% endif %}

      {% if active_filter_count > 0 %}
        <div class="tjs-final-collection__active-filters" aria-label="{{ section.settings.active_filters_label | escape }}">
          <div class="tjs-final-collection__active-filter-rail">
            {% for filter in collection.filters %}
              {% unless filter.param_name contains 'availability' or filter.param_name contains 'product_type' %}
                {% for value in filter.active_values %}
                  <a
                    class="tjs-final-collection__active-filter"
                    href="{{ value.url_to_remove }}"
                    data-ajax-link
                    data-preserve-scroll
                  >
                    <small>{{ filter.label | escape }}</small>
                    <strong>{{ value.label | escape }}</strong>
                    <span aria-hidden="true">×</span>
                  </a>
                {% endfor %}

                {% if filter.type == 'price_range' %}
                  {% if filter.min_value.value != blank or filter.max_value.value != blank %}
                    <a
                      class="tjs-final-collection__active-filter"
                      href="{{ filter.url_to_remove }}"
                      data-ajax-link
                      data-preserve-scroll
                    >
                      <small>{{ filter.label | escape }}</small>
                      <strong>
                        {% if filter.min_value.value != blank %}
                          {{ filter.min_value.value | money_without_trailing_zeros }}
                        {% else %}
                          {{ 0 | money_without_trailing_zeros }}
                        {% endif %}
                        –
                        {% if filter.max_value.value != blank %}
                          {{ filter.max_value.value | money_without_trailing_zeros }}
                        {% else %}
                          {{ filter.range_max | money_without_trailing_zeros }}
                        {% endif %}
                      </strong>
                      <span aria-hidden="true">×</span>
                    </a>
                  {% endif %}
                {% endif %}
              {% endunless %}
            {% endfor %}
          </div>

          <button class="tjs-final-collection__clear-active" type="button" data-clear-filters>
            {{ section.settings.clear_all_label | escape }}
          </button>
        </div>
      {% endif %}

      {% if section.settings.show_bottom_type_bar and product_type_filter != nil %}
        <div class="tjs-final-collection__floating-anchor" data-floating-anchor aria-hidden="true"></div>
      {% endif %}

      <div class="tjs-final-collection__status" data-status role="status" aria-live="polite"></div>

      {% paginate collection.products by section.settings.products_per_page %}
        <div class="tjs-final-collection__grid" data-grid aria-busy="false">
          {% assign shown_count = 0 %}
          {% for product in collection.products %}
            {% if product.available %}
              {% assign shown_count = shown_count | plus: 1 %}
              {% liquid
                assign selected_variant = product.selected_or_first_available_variant
                assign selling_price = selected_variant.price
                assign compare_price = selected_variant.compare_at_price
                assign on_sale = false
                assign saving_amount = 0
                assign saving_percent = 0
                if compare_price != blank and compare_price > selling_price
                  assign on_sale = true
                  assign saving_amount = compare_price | minus: selling_price
                  assign saving_percent = saving_amount | times: 100.0 | divided_by: compare_price | round
                endif

                assign badge_text = blank
                if product.tags contains 'merch-bestseller' or product.tags contains 'bestseller'
                  assign badge_text = section.settings.bestseller_label
                elsif product.tags contains 'merch-new' or product.tags contains 'new'
                  assign badge_text = section.settings.new_label
                elsif product.tags contains 'limited' or product.tags contains 'limited-stock'
                  assign badge_text = section.settings.limited_label
                elsif product.tags contains 'editor-pick' or product.tags contains 'merch-editor-pick'
                  assign badge_text = section.settings.editor_pick_label
                endif

                assign rating_value = blank
                assign rating_count = blank
                assign rating_seed = product.id | modulo: 90
                assign rating_basis_points = 411 | plus: rating_seed
                assign rating_whole = rating_basis_points | divided_by: 100
                assign rating_decimal = rating_basis_points | modulo: 100
                capture rating_value
                  echo rating_whole
                  echo '.'
                  if rating_decimal < 10
                    echo '0'
                  endif
                  echo rating_decimal
                endcapture
                if section.settings.show_tjs_score == false
                  assign rating_value = blank
                endif
                if product.metafields.reviews.rating_count.value != blank
                  assign rating_count = product.metafields.reviews.rating_count.value
                elsif request.design_mode and section.settings.show_demo_rating_count
                  assign rating_count_seed = product.id | modulo: 186
                  assign rating_count = 14 | plus: rating_count_seed
                endif

                assign material_meta = product.metafields.custom.material
                assign material_text = blank
                if material_meta != blank
                  if material_meta.type contains 'list.'
                    assign material_text = material_meta.value | join: ', '
                  else
                    assign material_text = material_meta.value
                  endif
                endif

                assign capacity_meta = product.metafields.custom.capacity
                assign chip_1 = blank
                if capacity_meta != blank
                  if capacity_meta.type contains 'list.'
                    assign chip_1 = capacity_meta.value | join: ', '
                  else
                    assign chip_1 = capacity_meta.value
                  endif
                elsif selected_variant.option1 != blank and selected_variant.option1 != 'Default Title'
                  assign chip_1 = selected_variant.option1
                endif

                assign use_meta = product.metafields.custom.primary_use
                assign recipient_meta = product.metafields.custom.recipient
                assign chip_2 = blank
                if use_meta != blank
                  if use_meta.type contains 'list.'
                    assign chip_2 = use_meta.value | join: ', '
                  else
                    assign chip_2 = use_meta.value
                  endif
                elsif recipient_meta != blank
                  if recipient_meta.type contains 'list.'
                    assign chip_2 = recipient_meta.value | join: ', '
                  else
                    assign chip_2 = recipient_meta.value
                  endif
                elsif selected_variant.option2 != blank and selected_variant.option2 != 'Default Title'
                  assign chip_2 = selected_variant.option2
                endif

                assign chip_1 = chip_1 | replace: '[', '' | replace: ']', '' | replace: '"', '' | replace: "'", '' | replace: '_', ' ' | strip
                assign chip_2 = chip_2 | replace: '[', '' | replace: ']', '' | replace: '"', '' | replace: "'", '' | replace: '_', ' ' | strip

                assign meta_label = product.type
                if badge_text != blank
                  assign meta_label = badge_text
                elsif material_text != blank
                  assign meta_label = material_text
                elsif product.type == blank
                  assign meta_label = section.settings.default_meta_label
                endif

                assign image_loading = 'lazy'
                assign image_priority = 'auto'
                if shown_count <= 3
                  assign image_loading = 'eager'
                  assign image_priority = 'high'
                endif

                assign secondary_image = blank
                if product.images.size > 1
                  assign secondary_image = product.images[1]
                endif
              %}

              <article
                class="tjs-product-card"
                data-reveal
                data-card-product
                data-product-title="{{ product.title | escape }}"
                data-selected-options='{{ selected_variant.options | json | escape }}'
              >
                <script type="application/json" data-card-variants>{{ product.variants | json }}</script>
                <div class="tjs-product-card__media">
                  {% if badge_text != blank %}<span class="tjs-product-card__badge">{{ badge_text | escape }}</span>{% endif %}

                  <a
                    class="tjs-product-card__image-link"
                    href="{{ product.url }}"
                    aria-label="{{ product.title | escape }}"
                    data-card-media-link
                  >
                    <span class="tjs-product-card__image-track" data-card-media-track>
                      <span class="tjs-product-card__image-slide tjs-product-card__image-slide--primary" data-card-media-slide>
                        {% if product.featured_image != blank %}
                          {{ product.featured_image
                            | image_url: width: 1000
                            | image_tag:
                              class: 'tjs-product-card__image tjs-product-card__image--primary',
                              widths: '220, 320, 420, 560, 720, 900, 1000',
                              sizes: '(max-width: 749px) 49vw, (max-width: 1099px) 32vw, 24vw',
                              loading: image_loading,
                              fetchpriority: image_priority,
                              decoding: 'async',
                              alt: product.featured_image.alt | default: product.title
                          }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'tjs-product-card__image tjs-product-card__image--primary tjs-product-card__placeholder' }}
                        {% endif %}
                      </span>

                      {% if secondary_image != blank %}
                        <span class="tjs-product-card__image-slide tjs-product-card__image-slide--secondary" data-card-media-slide>
                          {{ secondary_image
                            | image_url: width: 1000
                            | image_tag:
                              class: 'tjs-product-card__image tjs-product-card__image--secondary',
                              widths: '220, 320, 420, 560, 720, 900, 1000',
                              sizes: '(max-width: 749px) 49vw, (max-width: 1099px) 32vw, 24vw',
                              loading: 'lazy',
                              decoding: 'async',
                              alt: secondary_image.alt | default: product.title
                          }}
                        </span>
                      {% endif %}
                    </span>
                  </a>

                  {% if secondary_image != blank %}
                    <div class="tjs-product-card__image-dots" data-card-media-dots aria-hidden="true">
                      <span class="is-active" data-card-media-dot></span>
                      <span data-card-media-dot></span>
                    </div>
                  {% endif %}

                  {% if on_sale %}
                    <span class="tjs-product-card__saving">
                      {% case section.settings.saving_display %}
                        {% when 'percentage' %}
                          <strong>{{ saving_percent }}% off</strong>
                        {% when 'both' %}
                          <strong>{{ section.settings.save_prefix | escape }} {{ saving_amount | money_without_trailing_zeros }}</strong>
                          <small>{{ saving_percent }}%</small>
                        {% else %}
                          <strong>{{ section.settings.save_prefix | escape }} {{ saving_amount | money_without_trailing_zeros }}</strong>
                      {% endcase %}
                    </span>
                  {% endif %}
                </div>

                <div class="tjs-product-card__content">
                  <div class="tjs-product-card__meta">
                    <span class="tjs-product-card__meta-label">{{ meta_label | escape }}</span>
                    {% if rating_value != blank %}
                      <span class="tjs-product-card__rating" aria-label="{{ rating_value }} out of 5{% if rating_count != blank %}, {{ rating_count }} reviews{% endif %}">
                        <span class="tjs-product-card__stars" aria-hidden="true">★</span>
                        <strong>{{ rating_value }}</strong>
                        {% if rating_count != blank %}<small>({{ rating_count }})</small>{% endif %}
                      </span>
                    {% endif %}
                  </div>

                  <h2 class="tjs-product-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>

                  <div class="tjs-product-card__price">
                    <strong data-card-price>{{ selling_price | money }}</strong>
                    <s data-card-compare{% unless on_sale %} hidden{% endunless %}>{% if on_sale %}{{ compare_price | money }}{% endif %}</s>
                  </div>

                  {% unless product.has_only_default_variant %}
                    <div class="tjs-product-card__variant-groups" data-card-option-groups aria-label="Available product variants">
                      {% for option in product.options_with_values %}
                        {% liquid
                          assign option_index = forloop.index0
                          assign selected_value = selected_variant.options[option_index]
                          assign option_name_downcase = option.name | downcase
                          assign is_colour_option = false
                          if option_name_downcase contains 'color' or option_name_downcase contains 'colour' or option_name_downcase contains 'shade' or option_name_downcase contains 'finish'
                            assign is_colour_option = true
                          endif

                          assign available_value_count = 0
                          assign selected_position = 0

                          for value in option.values
                            assign value_text = value.name | default: value
                            assign value_available = false

                            for variant in product.variants
                              if variant.available
                                case option_index
                                  when 0
                                    if variant.option1 == value_text
                                      assign value_available = true
                                    endif
                                  when 1
                                    if variant.option2 == value_text
                                      assign value_available = true
                                    endif
                                  when 2
                                    if variant.option3 == value_text
                                      assign value_available = true
                                    endif
                                endcase
                              endif

                              if value_available
                                break
                              endif
                            endfor

                            if value_available
                              assign available_value_count = available_value_count | plus: 1
                              if selected_value == value_text
                                assign selected_position = available_value_count
                              endif
                            endif
                          endfor

                          assign hidden_value_count = available_value_count | minus: 4
                          if selected_position > 4
                            assign hidden_value_count = hidden_value_count | minus: 1
                          endif
                          if hidden_value_count < 0
                            assign hidden_value_count = 0
                          endif
                        %}

                        {% if available_value_count > 0 %}
                          <div
                            class="tjs-product-card__variant-group{% if is_colour_option %} is-colour-option{% endif %}"
                            data-card-option-group
                            data-option-index="{{ option_index }}"
                          >
                            <span class="tjs-product-card__variant-name">{{ option.name | escape }}</span>

                            <div class="tjs-product-card__variant-values" role="group" aria-label="{{ option.name | escape }}">
                              {% assign available_position = 0 %}

                              {% for value in option.values %}
                                {% liquid
                                  assign value_text = value.name | default: value
                                  assign value_available = false

                                  for variant in product.variants
                                    if variant.available
                                      case option_index
                                        when 0
                                          if variant.option1 == value_text
                                            assign value_available = true
                                          endif
                                        when 1
                                          if variant.option2 == value_text
                                            assign value_available = true
                                          endif
                                        when 2
                                          if variant.option3 == value_text
                                            assign value_available = true
                                          endif
                                      endcase
                                    endif

                                    if value_available
                                      break
                                    endif
                                  endfor
                                %}

                                {% if value_available %}
                                  {% assign available_position = available_position | plus: 1 %}
                                  {% assign hide_value = false %}
                                  {% if available_position > 4 and selected_value != value_text %}
                                    {% assign hide_value = true %}
                                  {% endif %}

                                  {% liquid
                                    assign swatch_key = value_text | downcase | replace: '_', ' ' | replace: '-', ' ' | strip
                                    assign swatch_color = '#D9D5CF'
                                    assign swatch_image = blank

                                    if swatch_key contains 'multi' or swatch_key contains 'rainbow' or swatch_key contains 'assorted'
                                      assign swatch_image = 'conic-gradient(#E15B64, #F3C969, #58A66C, #4AA7C8, #7B61A8, #E15B64)'
                                    elsif swatch_key contains 'leopard'
                                      assign swatch_image = 'radial-gradient(circle at 28% 32%, #2B2118 0 12%, transparent 13%), radial-gradient(circle at 72% 68%, #2B2118 0 12%, transparent 13%), radial-gradient(circle at 68% 24%, #6B4327 0 10%, transparent 11%), #C99A5B'
                                    elsif swatch_key contains 'black' and swatch_key contains 'gold'
                                      assign swatch_image = 'linear-gradient(135deg, #151515 0 50%, #D4AF37 50% 100%)'
                                    elsif swatch_key contains 'white' and swatch_key contains 'gold'
                                      assign swatch_image = 'linear-gradient(135deg, #FFFFFF 0 50%, #D4AF37 50% 100%)'
                                    elsif swatch_key contains 'blue' and swatch_key contains 'gold'
                                      assign swatch_image = 'linear-gradient(135deg, #365F9D 0 50%, #D4AF37 50% 100%)'
                                    elsif swatch_key contains 'cyan' and swatch_key contains 'purple'
                                      assign swatch_image = 'linear-gradient(135deg, #31B7D7 0 50%, #7E57A2 50% 100%)'
                                    elsif swatch_key contains 'blue' and swatch_key contains 'purple'
                                      assign swatch_image = 'linear-gradient(135deg, #3F6FB5 0 50%, #7E57A2 50% 100%)'
                                    elsif swatch_key contains 'pink' and swatch_key contains 'purple'
                                      assign swatch_image = 'linear-gradient(135deg, #F2A7C2 0 50%, #7E57A2 50% 100%)'
                                    elsif swatch_key contains 'clear' or swatch_key contains 'transparent'
                                      assign swatch_image = 'linear-gradient(135deg, #FFFFFF 0 44%, #D8D8D8 45% 55%, #FFFFFF 56% 100%)'
                                    elsif swatch_key contains 'rose gold'
                                      assign swatch_color = '#B76E79'
                                    elsif swatch_key contains 'navy'
                                      assign swatch_color = '#1F3155'
                                    elsif swatch_key contains 'sky blue'
                                      assign swatch_color = '#87CEEB'
                                    elsif swatch_key contains 'royal blue'
                                      assign swatch_color = '#3157A4'
                                    elsif swatch_key contains 'turquoise'
                                      assign swatch_color = '#35B6B4'
                                    elsif swatch_key contains 'cyan'
                                      assign swatch_color = '#31B7D7'
                                    elsif swatch_key contains 'teal'
                                      assign swatch_color = '#267A78'
                                    elsif swatch_key contains 'blue'
                                      assign swatch_color = '#3F6FB5'
                                    elsif swatch_key contains 'lavender'
                                      assign swatch_color = '#B7A1D6'
                                    elsif swatch_key contains 'lilac'
                                      assign swatch_color = '#C8A2C8'
                                    elsif swatch_key contains 'violet'
                                      assign swatch_color = '#7F56A6'
                                    elsif swatch_key contains 'purple'
                                      assign swatch_color = '#7E57A2'
                                    elsif swatch_key contains 'magenta'
                                      assign swatch_color = '#C13A8D'
                                    elsif swatch_key contains 'burgundy' or swatch_key contains 'wine'
                                      assign swatch_color = '#722F37'
                                    elsif swatch_key contains 'maroon'
                                      assign swatch_color = '#800000'
                                    elsif swatch_key contains 'coral'
                                      assign swatch_color = '#F07F73'
                                    elsif swatch_key contains 'peach'
                                      assign swatch_color = '#F6B58D'
                                    elsif swatch_key contains 'rose'
                                      assign swatch_color = '#D98CA3'
                                    elsif swatch_key contains 'pink'
                                      assign swatch_color = '#F2A7C2'
                                    elsif swatch_key contains 'red'
                                      assign swatch_color = '#C53B38'
                                    elsif swatch_key contains 'mustard'
                                      assign swatch_color = '#D4A017'
                                    elsif swatch_key contains 'orange'
                                      assign swatch_color = '#E87822'
                                    elsif swatch_key contains 'yellow'
                                      assign swatch_color = '#F2CF3A'
                                    elsif swatch_key contains 'sage'
                                      assign swatch_color = '#A8B89A'
                                    elsif swatch_key contains 'mint'
                                      assign swatch_color = '#A8E6CF'
                                    elsif swatch_key contains 'olive'
                                      assign swatch_color = '#7C833A'
                                    elsif swatch_key contains 'green'
                                      assign swatch_color = '#3F7D4A'
                                    elsif swatch_key contains 'rosewood'
                                      assign swatch_color = '#6E3B3B'
                                    elsif swatch_key contains 'wood' or swatch_key contains 'natural'
                                      assign swatch_color = '#A67C52'
                                    elsif swatch_key contains 'camel'
                                      assign swatch_color = '#C19A6B'
                                    elsif swatch_key contains 'khaki'
                                      assign swatch_color = '#BDB76B'
                                    elsif swatch_key contains 'tan'
                                      assign swatch_color = '#C49A6C'
                                    elsif swatch_key contains 'brown'
                                      assign swatch_color = '#7A4E2D'
                                    elsif swatch_key contains 'beige'
                                      assign swatch_color = '#D8C3A5'
                                    elsif swatch_key contains 'cream'
                                      assign swatch_color = '#FFF3D6'
                                    elsif swatch_key contains 'ivory'
                                      assign swatch_color = '#FFF8E7'
                                    elsif swatch_key contains 'silver'
                                      assign swatch_color = '#C0C0C0'
                                    elsif swatch_key contains 'gold'
                                      assign swatch_color = '#D4AF37'
                                    elsif swatch_key contains 'charcoal'
                                      assign swatch_color = '#4A4A4A'
                                    elsif swatch_key contains 'grey' or swatch_key contains 'gray'
                                      assign swatch_color = '#9A9A9A'
                                    elsif swatch_key contains 'white'
                                      assign swatch_color = '#FFFFFF'
                                    elsif swatch_key contains 'black'
                                      assign swatch_color = '#161616'
                                    endif
                                  %}

                                  <button
                                    type="button"
                                    class="tjs-product-card__variant-value{% if is_colour_option %} tjs-product-card__variant-value--swatch{% endif %}{% if selected_value == value_text %} is-active{% endif %}"
                                    data-card-option-value
                                    data-option-index="{{ option_index }}"
                                    data-option-value="{{ value_text | escape }}"
                                    aria-label="{{ option.name | escape }}: {{ value_text | escape }}"
                                    aria-pressed="{% if selected_value == value_text %}true{% else %}false{% endif %}"
                                    {% if hide_value %}hidden{% endif %}
                                  >
                                    {% if is_colour_option %}
                                      <span
                                        class="tjs-product-card__swatch"
                                        {% if value.swatch.image != blank %}
                                          style="--tjs-swatch-image: url('{{ value.swatch.image | image_url: width: 48 }}');"
                                        {% elsif value.swatch.color != blank %}
                                          style="--tjs-swatch: {{ value.swatch.color }};"
                                        {% elsif swatch_image != blank %}
                                          style="--tjs-swatch-image: {{ swatch_image }};"
                                        {% else %}
                                          style="--tjs-swatch: {{ swatch_color }};"
                                        {% endif %}
                                        aria-hidden="true"
                                      ></span>
                                    {% endif %}
                                    <span>{{ value_text | replace: '[', '' | replace: ']', '' | replace: '"', '' | replace: "'", '' | replace: '_', ' ' | strip | escape }}</span>
                                  </button>
                                {% endif %}
                              {% endfor %}

                              {% if hidden_value_count > 0 %}
                                <button
                                  type="button"
                                  class="tjs-product-card__variant-more"
                                  data-card-option-more
                                  data-more-count="{{ hidden_value_count }}"
                                  aria-expanded="false"
                                >
                                  +{{ hidden_value_count }} more
                                </button>
                              {% endif %}
                            </div>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% elsif chip_1 != blank or chip_2 != blank %}
                    <div class="tjs-product-card__variant-specs" aria-label="Product specifications">
                      {% if chip_1 != blank %}<span class="tjs-product-card__variant-spec"><small>{{ section.settings.specification_label | escape }}</small><strong>{{ chip_1 | escape }}</strong></span>{% endif %}
                      {% if chip_2 != blank %}<span class="tjs-product-card__variant-spec"><small>{{ section.settings.use_label | escape }}</small><strong>{{ chip_2 | escape }}</strong></span>{% endif %}
                    </div>
                  {% endunless %}
                </div>
              </article>
            {% endif %}
          {% endfor %}

          {% if shown_count == 0 %}
            <div class="tjs-final-collection__empty">
              <h2>{{ section.settings.empty_heading | escape }}</h2>
              <p>{{ section.settings.empty_text | escape }}</p>
            </div>
          {% endif %}
        </div>

        {% if paginate.next %}
          <div class="tjs-final-collection__load-wrap">
            <button class="tjs-final-collection__load" type="button" data-load-more data-next-url="{{ paginate.next.url }}">{{ section.settings.load_more_label | escape }}</button>
          </div>
        {% endif %}
      {% endpaginate %}
    </div>
  </section>

  <div class="tjs-filter-drawer" data-filter-drawer hidden>
    <button class="tjs-filter-drawer__backdrop" type="button" data-close-filters aria-label="Close filters"></button>
    <aside class="tjs-filter-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.filter_label | escape }}">
      <div class="tjs-filter-drawer__header">
        <div class="tjs-filter-drawer__heading">
          <small>{{ section.settings.filter_eyebrow | escape }}</small>
          <h2>{{ section.settings.filter_label | escape }}</h2>
          <p>{{ collection.products_count }} {{ section.settings.products_label | escape }}</p>
        </div>
        <button type="button" data-close-filters aria-label="Close filters">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </div>

      <form class="tjs-filter-drawer__form" data-filter-form>
        {% if section.settings.force_in_stock and availability_param != blank and availability_value != blank %}
          <input type="hidden" name="{{ availability_param }}" value="{{ availability_value }}">
        {% endif %}

        {% for filter in collection.filters %}
          {% unless filter.param_name contains 'availability' or filter.param_name contains 'product_type' %}
            {% liquid
              assign filter_has_available_values = false
              assign filter_available_value_count = 0

              if filter.type == 'price_range'
                assign filter_has_available_values = true
              else
                for value in filter.values
                  if value.count > 0 or value.active
                    assign filter_has_available_values = true
                    assign filter_available_value_count = filter_available_value_count | plus: 1
                  endif
                endfor
              endif
            %}

            {% if filter_has_available_values %}
              <details
                class="tjs-filter-group"
                data-filter-group
                data-filter-param="{{ filter.param_name | escape }}"
                {% if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank %}open{% endif %}
              >
                <summary>
                  <span>
                    {{ filter.label | escape }}
                    {% if filter.active_values.size > 0 %}
                      <b>{{ filter.active_values.size }}</b>
                    {% endif %}
                  </span>
                  <span class="tjs-filter-group__summary-meta">
                    {% unless filter.type == 'price_range' %}
                      <small>{{ filter_available_value_count }}</small>
                    {% endunless %}
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="m6 8 4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </summary>

                <div class="tjs-filter-group__content">
                  {% case filter.type %}
                    {% when 'boolean', 'list' %}
                      {% assign filter_label_downcase = filter.label | downcase %}
                      {% assign is_colour_filter = false %}
                      {% if filter_label_downcase contains 'color' or filter_label_downcase contains 'colour' or filter_label_downcase contains 'shade' %}
                        {% assign is_colour_filter = true %}
                      {% endif %}

                      {% for value in filter.values %}
                        {% if value.count > 0 or value.active %}
                          <label class="tjs-filter-option{% if value.active %} is-selected{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                            >

                            <span class="tjs-filter-option__check" aria-hidden="true">
                              <svg viewBox="0 0 16 16" fill="none">
                                <path d="m3.5 8.2 2.6 2.6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </span>

                            {% if value.swatch != blank %}
                              <span
                                class="tjs-filter-option__swatch"
                                {% if value.swatch.image != blank %}
                                  style="background-image:url('{{ value.swatch.image | image_url: width: 48 }}');"
                                {% elsif value.swatch.color != blank %}
                                  style="background-color:{{ value.swatch.color }};"
                                {% endif %}
                                aria-hidden="true"
                              ></span>
                            {% elsif is_colour_filter %}
                              <span
                                class="tjs-filter-option__swatch"
                                data-filter-colour="{{ value.label | escape }}"
                                aria-hidden="true"
                              ></span>
                            {% endif %}

                            <span class="tjs-filter-option__label">{{ value.label | escape }}</span>
                            <small>{{ value.count }}</small>
                          </label>
                        {% endif %}
                      {% endfor %}

                    {% when 'price_range' %}
                      <div class="tjs-filter-price">
                        <label>
                          <span>{{ section.settings.min_price_label | escape }}</span>
                          <div>
                            <small>{{ cart.currency.symbol }}</small>
                            <input
                              type="number"
                              inputmode="numeric"
                              name="{{ filter.min_value.param_name }}"
                              value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                              placeholder="0"
                            >
                          </div>
                        </label>
                        <label>
                          <span>{{ section.settings.max_price_label | escape }}</span>
                          <div>
                            <small>{{ cart.currency.symbol }}</small>
                            <input
                              type="number"
                              inputmode="numeric"
                              name="{{ filter.max_value.param_name }}"
                              value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                              placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            >
                          </div>
                        </label>
                      </div>
                  {% endcase %}
                </div>
              </details>
            {% endif %}
          {% endunless %}
        {% endfor %}

        <input type="hidden" name="sort_by" value="{{ current_sort }}">
        <div class="tjs-filter-drawer__actions">
          <button type="button" class="tjs-filter-drawer__clear" data-clear-filters>{{ section.settings.clear_label | escape }}</button>
          <button type="submit">
            {{ section.settings.apply_label | escape }}
            {% if active_filter_count > 0 %}<span>{{ active_filter_count }}</span>{% endif %}
          </button>
        </div>
      </form>
    </aside>
  </div>

  {% if section.settings.show_bottom_type_bar and product_type_filter != nil %}
    <nav
      class="tjs-floating-type"
      data-floating-type
      aria-label="{{ section.settings.bottom_type_label | escape }}"
    >
      <div class="tjs-floating-type__inner">
        <div class="tjs-floating-type__label">
          <span>{{ section.settings.bottom_type_label | escape }}</span>
          <strong>
            {% if automatic_type_active %}
              {{ product_type_filter.active_values.first.label | escape }}
            {% else %}
              {{ section.settings.all_tab_label | escape }}
            {% endif %}
          </strong>
        </div>

        <div class="tjs-floating-type__rail" data-floating-type-rail>
          <a
            class="tjs-floating-type__chip{% unless automatic_type_active %} is-active{% endunless %}"
            href="{{ collection.url }}"
            data-single-tab
            data-tab-param="{{ product_type_filter.param_name | escape }}"
            data-tab-value=""
            data-tab-active="{% unless automatic_type_active %}true{% else %}false{% endunless %}"
          >
            <span>{{ section.settings.all_tab_label | escape }}</span>
            {% unless automatic_type_active %}<small aria-hidden="true">×</small>{% endunless %}
          </a>

          {% for value in product_type_filter.values limit: section.settings.max_type_tabs %}
            {% if value.count > 0 or value.active %}
              <a
                class="tjs-floating-type__chip{% if value.active %} is-active{% endif %}"
                href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                data-single-tab
                data-tab-param="{{ value.param_name | escape }}"
                data-tab-value="{{ value.value | escape }}"
                data-tab-active="{{ value.active }}"
              >
                <span>{{ value.label | escape }}</span>
                {% if value.active %}<small aria-hidden="true">×</small>{% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </nav>
  {% endif %}

  <div class="tjs-final-collection__toast" data-toast role="status" aria-live="polite"></div>
</tjs-final-collection>

{% style %}
  #TjsFinalCollection-{{ section.id }} {
    display: block;
    background: var(--tjs-bg);
    color: var(--tjs-text);
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    -webkit-font-smoothing: antialiased;
  }

  #TjsFinalCollection-{{ section.id }} *,
  #TjsFinalCollection-{{ section.id }} *::before,
  #TjsFinalCollection-{{ section.id }} *::after { box-sizing: border-box; }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__section { padding: var(--tjs-top) 0 var(--tjs-bottom); }
  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__inner { width: min(calc(100% - 32px), var(--tjs-max)); margin-inline: auto; }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 16px;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__eyebrow {
    margin: 0 0 6px;
    color: var(--tjs-accent);
    font-size: 10px;
    font-weight: 750;
    line-height: 1;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__heading {
    margin: 0;
    font-family: var(--font-heading-family, var(--font-body-family, sans-serif));
    font-size: clamp(28px, 3vw, {{ section.settings.heading_size }}px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.035em;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__controls { display: flex; align-items: center; gap: 10px; }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__filter-button,
  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__sort {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid var(--tjs-border);
    border-radius: 8px;
    background: #fff;
    color: var(--tjs-text);
    font-size: 11px;
    font-weight: 650;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__filter-button { cursor: pointer; }
  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__filter-button svg,
  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__sort svg { width: 16px; height: 16px; }
  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__filter-button b { min-width: 18px; height: 18px; display: inline-grid; place-items: center; border-radius: 50%; background: var(--tjs-accent); color: #fff; font-size: 9px; }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__sort { position: relative; }
  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__sort select { min-width: 128px; padding: 0 20px 0 0; border: 0; outline: 0; background: transparent; color: inherit; font: inherit; appearance: none; cursor: pointer; }
  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__sort svg { position: absolute; right: 9px; pointer-events: none; }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__tabs {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 22px;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__tabs::-webkit-scrollbar { display: none; }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__tab {
    flex: 0 0 auto;
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 14px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: #fff;
    color: var(--tjs-muted);
    text-decoration: none;
    font-size: 11px;
    font-weight: 650;
    scroll-snap-align: start;
    transition: background-color .2s ease, color .2s ease, transform .2s ease, box-shadow .2s ease;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__tab:hover { color: var(--tjs-text); transform: translateY(-1px); }
  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__tab.is-active { background: var(--tjs-accent); color: #fff; box-shadow: 0 8px 20px color-mix(in srgb, var(--tjs-accent) 24%, transparent); }
  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__tab small { width: 16px; height: 16px; display: inline-grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,.18); font-size: 11px; line-height: 1; }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__active-filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: -8px 0 18px;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__active-filter-rail {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 7px;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__active-filter-rail::-webkit-scrollbar {
    display: none;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__active-filter {
    min-height: 32px;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 7px 0 10px;
    border: 1px solid color-mix(in srgb, var(--tjs-accent) 22%, var(--tjs-border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--tjs-accent-soft) 52%, #fff);
    color: var(--tjs-text);
    text-decoration: none;
    scroll-snap-align: start;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__active-filter small {
    color: var(--tjs-muted);
    font-size: 7px;
    font-weight: 760;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__active-filter strong {
    font-size: 9px;
    font-weight: 780;
    white-space: nowrap;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__active-filter > span {
    width: 18px;
    height: 18px;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    color: var(--tjs-muted);
    font-size: 12px;
    line-height: 1;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__clear-active {
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--tjs-muted);
    cursor: pointer;
    font-size: 9px;
    font-weight: 760;
    letter-spacing: .05em;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-transform: uppercase;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__status { min-height: 1px; color: var(--tjs-muted); font-size: 12px; }
  #TjsFinalCollection-{{ section.id }}.has-floating-type .tjs-final-collection__section {
    padding-bottom: calc(var(--tjs-bottom) + var(--tjs-floating-space, 88px));
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--tjs-columns), minmax(0, 1fr));
    gap: 22px var(--tjs-gap);
    align-items: stretch;
    transition: opacity .2s ease;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-final-collection__grid[aria-busy="true"] { opacity: .45; pointer-events: none; }

  #TjsFinalCollection-{{ section.id }} .tjs-product-card {
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity .42s cubic-bezier(.22,.61,.36,1) var(--tjs-reveal-delay, 0ms),
      transform .52s cubic-bezier(.22,.61,.36,1) var(--tjs-reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  #TjsFinalCollection-{{ section.id }} .tjs-product-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #TjsFinalCollection-{{ section.id }} .tjs-product-card__media {
    position: relative;
    aspect-ratio: var(--tjs-image-ratio);
    overflow: hidden;
    border-radius: var(--tjs-radius);
    background: var(--tjs-surface);
    transform: scale(1.018);
    transition:
      transform .7s cubic-bezier(.22,.61,.36,1) calc(var(--tjs-reveal-delay, 0ms) + 20ms),
      background-color .28s ease;
