      "settings": {
        "section_fullwidth": true,
        "custom_liquid": "<style>\n  .tjs-seo-footer {\n    margin: 34px 0 0;\n    padding: 34px 18px 30px;\n    font-family: inherit;\n    background: var(--june-bg,#FFFFFF);\n    border-top: 1px solid rgba(0, 0, 0, 0.08);\n    border-bottom: 1px solid rgba(0, 0, 0, 0.08);\n  }\n\n  .tjs-seo-footer * {\n    box-sizing: border-box;\n  }\n\n  .tjs-seo-footer__inner {\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  .tjs-seo-footer__top {\n    display: grid;\n    grid-template-columns: 1.25fr 1.75fr;\n    gap: 42px;\n    align-items: start;\n  }\n\n  .tjs-seo-footer__brand {\n    max-width: 430px;\n  }\n\n  .tjs-seo-footer__kicker {\n    margin-bottom: 10px;\n    color: var(--june-muted,#656565);\n    font-size: 10px;\n    line-height: 1;\n    letter-spacing: 1.4px;\n    text-transform: uppercase;\n    font-weight: 800;\n  }\n\n  .tjs-seo-footer__title {\n    margin: 0;\n    color: var(--june-ink,#171717);\n    font-size: clamp(24px, 2.6vw, 34px);\n    line-height: 1.08;\n    letter-spacing: -0.7px;\n    font-weight: 700;\n  }\n\n  .tjs-seo-footer__text {\n    margin-top: 14px;\n    color: var(--june-muted,#656565);\n    font-size: 13px;\n    line-height: 1.72;\n    font-weight: 400;\n  }\n\n  .tjs-seo-footer__trust {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px 14px;\n    margin-top: 18px;\n  }\n\n  .tjs-seo-footer__trust span {\n    color: var(--june-ink,#171717);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 600;\n  }\n\n  .tjs-seo-footer__links {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 34px;\n  }\n\n  .tjs-seo-footer__group-title {\n    margin: 0 0 14px;\n    color: var(--june-ink,#171717);\n    font-size: 11px;\n    line-height: 1;\n    letter-spacing: 1.1px;\n    text-transform: uppercase;\n    font-weight: 800;\n  }\n\n  .tjs-seo-footer__list {\n    display: grid;\n    gap: 9px;\n  }\n\n  .tjs-seo-footer__link {\n    color: var(--june-muted,#656565);\n    text-decoration: none;\n    font-size: 13px;\n    line-height: 1.35;\n    font-weight: 400;\n    transition: color 0.18s ease, transform 0.18s ease;\n  }\n\n  .tjs-seo-footer__link:hover {\n    color: var(--june-ink,#171717);\n    transform: translateX(2px);\n  }\n\n  .tjs-seo-footer__pills {\n    margin-top: 30px;\n    padding-top: 22px;\n    border-top: 1px solid rgba(0, 0, 0, 0.08);\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px 18px;\n  }\n\n  .tjs-seo-footer__pill {\n    color: var(--june-ink,#171717);\n    text-decoration: none;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 500;\n  }\n\n  .tjs-seo-footer__pill:hover {\n    color: var(--june-ink,#171717);\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .tjs-seo-footer__mobile-button {\n    display: none;\n  }\n\n  @media screen and (max-width: 989px) {\n    .tjs-seo-footer__top {\n      grid-template-columns: 1fr;\n      gap: 28px;\n    }\n\n    .tjs-seo-footer__brand {\n      max-width: 100%;\n    }\n\n    .tjs-seo-footer__links {\n      gap: 24px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-seo-footer {\n      margin-top: 28px;\n      padding: 28px 16px 24px;\n    }\n\n    .tjs-seo-footer__top {\n      gap: 24px;\n    }\n\n    .tjs-seo-footer__title {\n      font-size: 25px;\n      line-height: 1.12;\n    }\n\n    .tjs-seo-footer__text {\n      font-size: 12.5px;\n      line-height: 1.68;\n    }\n\n    .tjs-seo-footer__trust {\n      gap: 9px 12px;\n    }\n\n    .tjs-seo-footer__trust span {\n      font-size: 11.5px;\n    }\n\n    .tjs-seo-footer__links {\n      grid-template-columns: 1fr;\n      gap: 0;\n      border-top: 1px solid rgba(0, 0, 0, 0.08);\n    }\n\n    .tjs-seo-footer__group {\n      border-bottom: 1px solid rgba(0, 0, 0, 0.08);\n    }\n\n    .tjs-seo-footer__mobile-button {\n      width: 100%;\n      min-height: 48px;\n      padding: 0;\n      border: 0;\n      background: transparent;\n      color: var(--june-ink,#171717);\n      font-family: inherit;\n      font-size: 11px;\n      line-height: 1;\n      letter-spacing: 1.1px;\n      text-transform: uppercase;\n      font-weight: 800;\n      text-align: left;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      cursor: pointer;\n    }\n\n    .tjs-seo-footer__mobile-button::after {\n      content: \"+\";\n      color: var(--june-ink,#171717);\n      font-size: 18px;\n      line-height: 1;\n      font-weight: 400;\n    }\n\n    .tjs-seo-footer__group.is-open .tjs-seo-footer__mobile-button::after {\n      content: \"âˆ’\";\n    }\n\n    .tjs-seo-footer__group-title {\n      display: none;\n    }\n\n    .tjs-seo-footer__list {\n      display: none;\n      padding: 0 0 16px;\n      gap: 10px;\n    }\n\n    .tjs-seo-footer__group.is-open .tjs-seo-footer__list {\n      display: grid;\n    }\n\n    .tjs-seo-footer__link {\n      font-size: 12.5px;\n    }\n\n    .tjs-seo-footer__pills {\n      margin-top: 22px;\n      padding-top: 18px;\n      gap: 10px 14px;\n    }\n\n    .tjs-seo-footer__pill {\n      font-size: 11.5px;\n    }\n  }\n</style>\n\n<section class=\"tjs-seo-footer\" data-tjs-seo-footer>\n  <div class=\"tjs-seo-footer__inner\">\n    <div class=\"tjs-seo-footer__top\">\n      <div class=\"tjs-seo-footer__brand\">\n        <div class=\"tjs-seo-footer__kicker\">The June Shop</div>\n\n        <h2 class=\"tjs-seo-footer__title\">\n          Home, lifestyle & gifting finds online\n        </h2>\n\n        <div class=\"tjs-seo-footer__text\">\n          Discover curated home decor, glassware, planners, lunch boxes, dinnerware, organisers, eyewear and gifting essentials at The June Shop. From everyday utility to statement pieces, find products designed to make your home, table, routine and celebrations feel more put together.\n        </div>\n\n        <div class=\"tjs-seo-footer__trust\">\n          <span>Fast Shipping</span>\n          <span>Secure Checkout</span>\n          <span>Curated Finds</span>\n          <span>WhatsApp Support</span>\n        </div>\n      </div>\n\n      <div class=\"tjs-seo-footer__links\">\n        <div class=\"tjs-seo-footer__group is-open\">\n          <button class=\"tjs-seo-footer__mobile-button\" type=\"button\">\n            Popular Collections\n          </button>\n          <h3 class=\"tjs-seo-footer__group-title\">Popular Collections</h3>\n\n          <div class=\"tjs-seo-footer__list\">\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/champagne-glasses\">Champagne Glasses</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/glassware\">Glassware</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/eyewear\">Sunglasses & Eyewear</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/undated-yearly-planners\">Undated Planners</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/lunch-boxes\">Lunch Boxes</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/insulated-lunch-bags\">Insulated Lunch Bags</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/sippers\">Sippers</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/dinner-sets\">Dinner Sets</a>\n          </div>\n        </div>\n\n        <div class=\"tjs-seo-footer__group\">\n          <button class=\"tjs-seo-footer__mobile-button\" type=\"button\">\n            Shop By Need\n          </button>\n          <h3 class=\"tjs-seo-footer__group-title\">Shop By Need</h3>\n\n          <div class=\"tjs-seo-footer__list\">\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/glassware\">Hosting & Dining</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/planners\">Planning & Journaling</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/lunch-boxes\">Everyday Lunch Essentials</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/organisers\">Home Organisation</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/home-decor\">Home Styling</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/gifts\">Thoughtful Gifts</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/baby-record-books\">Baby Keepsakes</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/wedding-planners\">Wedding Planning</a>\n          </div>\n        </div>\n\n        <div class=\"tjs-seo-footer__group\">\n          <button class=\"tjs-seo-footer__mobile-button\" type=\"button\">\n            Customer Care\n          </button>\n          <h3 class=\"tjs-seo-footer__group-title\">Customer Care</h3>\n\n          <div class=\"tjs-seo-footer__list\">\n            <a class=\"tjs-seo-footer__link\" href=\"/pages/contact-us\">Contact Us</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/pages/track-order\">Track Order</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/policies/shipping-policy\">Shipping Policy</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/policies/refund-policy\">Return & Refund Policy</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/policies/privacy-policy\">Privacy Policy</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/policies/terms-of-service\">Terms of Service</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/pages/about-us\">About The June Shop</a>\n            <a class=\"tjs-seo-footer__link\" href=\"/collections/all\">Shop All Products</a>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"tjs-seo-footer__pills\">\n      <a class=\"tjs-seo-footer__pill\" href=\"/collections/champagne-glasses\">Host Beautifully</a>\n      <a class=\"tjs-seo-footer__pill\" href=\"/collections/undated-yearly-planners\">Plan Better</a>\n      <a class=\"tjs-seo-footer__pill\" href=\"/collections/lunch-boxes\">Pack Smarter</a>\n      <a class=\"tjs-seo-footer__pill\" href=\"/collections/eyewear\">Step Out Styled</a>\n      <a class=\"tjs-seo-footer__pill\" href=\"/collections/home-decor\">Style Your Home</a>\n      <a class=\"tjs-seo-footer__pill\" href=\"/collections/gifts\">Find A Gift</a>\n    </div>\n  </div>\n</section>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    document.querySelectorAll(\"[data-tjs-seo-footer]\").forEach(function (section) {\n      const groups = section.querySelectorAll(\".tjs-seo-footer__group\");\n\n      groups.forEach(function (group) {\n        const button = group.querySelector(\".tjs-seo-footer__mobile-button\");\n\n        if (!button) return;\n\n        button.addEventListener(\"click\", function () {\n          group.classList.toggle(\"is-open\");\n        });\n      });\n    });\n  });\n</script>",
