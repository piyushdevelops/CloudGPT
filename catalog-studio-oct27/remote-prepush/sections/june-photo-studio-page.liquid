{% liquid
  assign studio_product = section.settings.product
  capture builder_query
    echo '?shopify_store=https%3A%2F%2Fthejuneshop.com'
    if studio_product != blank
      for variant in studio_product.variants
        assign size_key = variant.option1 | downcase
        echo '&variant_' | append: size_key | append: '_' | append: variant.option2 | append: '=' | append: variant.id
      endfor
    else
      assign variant_pairs = section.settings.variant_map | newline_to_br | split: '<br />'
      for pair in variant_pairs
        assign clean_pair = pair | strip
        if clean_pair != blank
          echo '&variant_' | append: clean_pair
        endif
      endfor
    endif
  endcapture
%}
<section class="jps-page" style="--accent:{{ section.settings.accent }};--heading-size:{{ section.settings.heading_size }}px;--heading-mobile:{{ section.settings.heading_size_mobile }}px;--heading-weight:{{ section.settings.heading_weight }};--heading-spacing:{{ section.settings.heading_spacing | divided_by: 100.0 }}em;--heading-leading:{{ section.settings.heading_leading | divided_by: 100.0 }};--body-size:{{ section.settings.body_size }}px;--body-mobile:{{ section.settings.body_size_mobile }}px;--body-weight:{{ section.settings.body_weight }};--body-spacing:{{ section.settings.body_spacing | divided_by: 100.0 }}em;--body-leading:{{ section.settings.body_leading | divided_by: 100.0 }}">
  <header class="jps-page__intro"><p>JUNE PHOTO STUDIO</p><h1>{{ section.settings.heading }}</h1><div>{{ section.settings.copy }}</div></header>
  {% if section.settings.builder_url != blank and studio_product != blank or section.settings.builder_url != blank and section.settings.variant_map != blank %}
    <iframe class="jps-page__frame" src="{{ section.settings.builder_url | append: builder_query | escape }}" title="Create your June photo book" allow="clipboard-write" loading="eager"></iframe>
  {% else %}
    <div class="jps-page__setup"><h2>Studio setup is almost complete.</h2><p>Select the photo book product for both size settings and add the hosted builder URL in this section.</p></div>
  {% endif %}
</section>
{% stylesheet %}
  .jps-page{max-width:1680px;margin:auto;color:#171717}.jps-page__intro{padding:clamp(45px,7vw,100px) clamp(20px,6vw,96px) 36px;background:linear-gradient(132deg,#f3edff 0 42%,#fff 42%)}.jps-page__intro>p{font-size:11px;font-weight:800;letter-spacing:.16em}.jps-page__intro h1{max-width:920px;margin:10px 0 16px;font-size:var(--heading-size);font-weight:var(--heading-weight);letter-spacing:var(--heading-spacing);line-height:var(--heading-leading)}.jps-page__intro div{max-width:690px;font-size:var(--body-size);font-weight:var(--body-weight);letter-spacing:var(--body-spacing);line-height:var(--body-leading)}.jps-page__frame{display:block;width:100%;height:max(820px,100dvh);border:0;background:#fff}.jps-page__setup{margin:36px;padding:40px;border:2px dashed #171717;border-radius:24px;background:#f5f5f3}.jps-page__setup h2{margin-top:0}@media(max-width:749px){.jps-page__intro{padding:38px 20px 24px}.jps-page__intro h1{font-size:var(--heading-mobile)}.jps-page__intro div{font-size:var(--body-mobile)}.jps-page__frame{height:calc(100dvh - 64px)}}
{% endstylesheet %}
{% schema %}
{"name":"June photo studio","settings":[{"type":"text","id":"heading","label":"Heading","default":"Make a book worth opening."},{"type":"richtext","id":"copy","label":"Supporting copy","default":"<p>Choose the memory, name the story and build every page right here.</p>"},{"type":"url","id":"builder_url","label":"Hosted builder URL"},{"type":"product","id":"product","label":"Photo book product"},{"type":"textarea","id":"variant_map","label":"Draft product variant map","info":"Fallback used while the photo book product remains draft. One key=value pair per line."},{"type":"color","id":"accent","label":"Accent","default":"#CBF36B"},{"type":"header","content":"Heading typography"},{"type":"range","id":"heading_size","label":"Desktop size","min":40,"max":104,"step":2,"unit":"px","default":82},{"type":"range","id":"heading_size_mobile","label":"Mobile size","min":34,"max":64,"step":1,"unit":"px","default":50},{"type":"range","id":"heading_weight","label":"Weight","min":500,"max":900,"step":100,"default":900},{"type":"range","id":"heading_spacing","label":"Letter spacing","min":-8,"max":8,"step":1,"default":-5},{"type":"range","id":"heading_leading","label":"Line height","min":85,"max":130,"step":5,"default":95},{"type":"header","content":"Supporting copy typography"},{"type":"range","id":"body_size","label":"Desktop size","min":14,"max":26,"step":1,"unit":"px","default":19},{"type":"range","id":"body_size_mobile","label":"Mobile size","min":13,"max":21,"step":1,"unit":"px","default":16},{"type":"range","id":"body_weight","label":"Weight","min":400,"max":700,"step":100,"default":400},{"type":"range","id":"body_spacing","label":"Letter spacing","min":-4,"max":8,"step":1,"default":0},{"type":"range","id":"body_leading","label":"Line height","min":120,"max":180,"step":5,"default":150}],"presets":[{"name":"June photo studio"}]}
{% endschema %}

