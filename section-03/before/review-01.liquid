{% javascript %}
if(!customElements.get('june-limited')){
 customElements.define('june-limited',class extends HTMLElement{
  connectedCallback(){
   if(this.controller)return;
   this.controller=new AbortController();
   const options={signal:this.controller.signal};
   this.buttons=[...this.querySelectorAll('[data-select]')];
   this.selected=0;
   this.mobile=matchMedia('(max-width:900px)');
   this.querySelectorAll('details').forEach(d=>d.open=!this.mobile.matches);
   this.addEventListener('click',event=>{
    const button=event.target.closest('[data-select]');
    if(button&&this.contains(button))this.select(Number(button.dataset.select));
   },options);
   this.addEventListener('keydown',event=>{
    const button=event.target.closest('[data-select]');
    if(!button)return;
    const index=this.buttons.indexOf(button);
    let next;
    if(event.key==='ArrowRight')next=(index+1)%this.buttons.length;
    if(event.key==='ArrowLeft')next=(index-1+this.buttons.length)%this.buttons.length;
    if(event.key==='Home')next=0;
    if(event.key==='End')next=this.buttons.length-1;
    if(next===undefined)return;
    event.preventDefault();this.select(next);this.buttons[next].focus();
   },options);
   this.addEventListener('shopify:block:select',event=>{
    const button=this.buttons.find(b=>b.dataset.block===event.detail.blockId);
    if(button)this.select(Number(button.dataset.select));
   },options);
  }
  select(index){
   if(!this.buttons[index])return;
   this.selected=index;
   this.buttons.forEach((b,i)=>b.setAttribute('aria-pressed',String(i===index)));
   ['scene','heading','buy','offer'].forEach(key=>{
    this.querySelectorAll('[data-'+key+']').forEach(el=>el.hidden=Number(el.dataset[key])!==index);
   });
  }
  disconnectedCallback(){this.controller?.abort();this.controller=null;}
 });
}
{% endjavascript %}
{% schema %}
{
  "name": "June · With extras",
  "tag": "section",
  "class": "june-limited-section",
  "max_blocks": 7,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited Edition"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your planner."
    },
    {
      "type": "text",
      "id": "heading_second",
      "label": "Heading second line",
      "default": "With extras."
    },
    {
      "type": "inline_richtext",
      "id": "intro",
      "label": "Supporting copy",
      "default": "An undated planner. <strong>A whole lot of joy.</strong>"
    },
    {
      "type": "text",
      "id": "product_caption",
      "label": "Product description",
      "default": "Limited Edition undated planner"
    },
    {
      "type": "text",
      "id": "offer_note",
      "label": "Offer note",
      "default": "Freebies vary by planner."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Limited Edition collection"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFBF1"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent and button fill",
      "default": "#D5FF46"
    },
    {
      "type": "font_picker",
      "id": "fallback_font",
      "label": "Fallback font when typography block is removed",
      "default": "poppins_n4"
    },
    {
      "type": "range",
      "id": "scene_height",
      "label": "Desktop minimum scene height",
      "min": 360,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile scene height",
      "min": 240,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 330
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Enable selection and button motion",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Motion speed",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "planner",
      "name": "Planner and gifts",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Planner"
        },
        {
          "type": "text",
          "id": "short_name",
          "label": "Short display name"
        },
        {
          "type": "image_picker",
          "id": "cover",
          "label": "Cover thumbnail override"
        },
        {
          "type": "image_picker",
          "id": "scene",
          "label": "Desktop product and gifts photograph"
        },
        {
          "type": "image_picker",
          "id": "mobile_scene",
          "label": "Mobile photograph override"
