{% liquid
 assign type_block = section.blocks | where: 'type', 'typography' | first
 assign type = type_block.settings
 assign planners = section.blocks | where: 'type', 'planner'
 assign count = 0
 for block in planners
  if block.settings.product != blank
   assign count = count | plus: 1
  endif
 endfor
%}
{% style %}
{% assign role_font = type.heading_font | default: section.settings.fallback_font %}{% assign weight = type.heading_weight | default: 900 | append: '' %}{% assign face = role_font | font_modify: 'weight', weight | default: role_font %}{{ face | font_face: font_display: 'swap' }}
#JuneLimited-{{ section.id }}{--jl-heading-font:{{ role_font.family | default: 'Poppins' }},{{ role_font.fallback_families | default: 'sans-serif' }};--jl-heading-weight:{{ type.heading_weight | default: 900 }};--jl-heading-size:{{ type.heading_size | default: 62 }}px;--jl-heading-mobile:{{ type.heading_mobile | default: 42 }}px;--jl-heading-tracking:{{ type.heading_tracking | default: -4 | divided_by: 100.0 }}em;--jl-heading-leading:{{ type.heading_leading | default: 105 | divided_by: 100.0 }};}
{% assign role_font = type.subheading_font | default: section.settings.fallback_font %}{% assign weight = type.subheading_weight | default: 600 | append: '' %}{% assign face = role_font | font_modify: 'weight', weight | default: role_font %}{{ face | font_face: font_display: 'swap' }}
#JuneLimited-{{ section.id }}{--jl-subheading-font:{{ role_font.family | default: 'Poppins' }},{{ role_font.fallback_families | default: 'sans-serif' }};--jl-subheading-weight:{{ type.subheading_weight | default: 600 }};--jl-subheading-size:{{ type.subheading_size | default: 30 }}px;--jl-subheading-mobile:{{ type.subheading_mobile | default: 25 }}px;--jl-subheading-tracking:{{ type.subheading_tracking | default: -2 | divided_by: 100.0 }}em;--jl-subheading-leading:{{ type.subheading_leading | default: 120 | divided_by: 100.0 }};}
{% assign role_font = type.body_font | default: section.settings.fallback_font %}{% assign weight = type.body_weight | default: 400 | append: '' %}{% assign face = role_font | font_modify: 'weight', weight | default: role_font %}{{ face | font_face: font_display: 'swap' }}
#JuneLimited-{{ section.id }}{--jl-body-font:{{ role_font.family | default: 'Poppins' }},{{ role_font.fallback_families | default: 'sans-serif' }};--jl-body-weight:{{ type.body_weight | default: 400 }};--jl-body-size:{{ type.body_size | default: 16 }}px;--jl-body-mobile:{{ type.body_mobile | default: 16 }}px;--jl-body-tracking:{{ type.body_tracking | default: -1 | divided_by: 100.0 }}em;--jl-body-leading:{{ type.body_leading | default: 150 | divided_by: 100.0 }};}
{% assign role_font = type.label_font | default: section.settings.fallback_font %}{% assign weight = type.label_weight | default: 500 | append: '' %}{% assign face = role_font | font_modify: 'weight', weight | default: role_font %}{{ face | font_face: font_display: 'swap' }}
#JuneLimited-{{ section.id }}{--jl-label-font:{{ role_font.family | default: 'Poppins' }},{{ role_font.fallback_families | default: 'sans-serif' }};--jl-label-weight:{{ type.label_weight | default: 500 }};--jl-label-size:{{ type.label_size | default: 11 }}px;--jl-label-mobile:{{ type.label_mobile | default: 10 }}px;--jl-label-tracking:{{ type.label_tracking | default: 12 | divided_by: 100.0 }}em;--jl-label-leading:{{ type.label_leading | default: 150 | divided_by: 100.0 }};}
{% assign role_font = type.button_font | default: section.settings.fallback_font %}{% assign weight = type.button_weight | default: 600 | append: '' %}{% assign face = role_font | font_modify: 'weight', weight | default: role_font %}{{ face | font_face: font_display: 'swap' }}
#JuneLimited-{{ section.id }}{--jl-button-font:{{ role_font.family | default: 'Poppins' }},{{ role_font.fallback_families | default: 'sans-serif' }};--jl-button-weight:{{ type.button_weight | default: 600 }};--jl-button-size:{{ type.button_size | default: 14 }}px;--jl-button-mobile:{{ type.button_mobile | default: 14 }}px;--jl-button-tracking:{{ type.button_tracking | default: -1 | divided_by: 100.0 }}em;--jl-button-leading:{{ type.button_leading | default: 130 | divided_by: 100.0 }};}
{% assign body_font = type.body_font | default: section.settings.fallback_font %}{% assign strong_font = body_font | font_modify: 'weight', '700' %}{{ strong_font | font_face: font_display: 'swap' }}
#JuneLimited-{{ section.id }}{--jl-bg:{{ section.settings.background }};--jl-ink:{{ section.settings.ink }};--jl-accent:{{ section.settings.accent }};--jl-scene:{{ section.settings.scene_height }}px;--jl-mobile-scene:{{ section.settings.mobile_height }}px;--jl-duration:{{ 24000 | divided_by: section.settings.speed }}ms;}
{% endstyle %}
{% capture arrow %}<span class="jl__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endcapture %}
{% if count > 0 %}
<june-limited id="JuneLimited-{{ section.id }}" class="jl" data-motion="{{ section.settings.motion }}" aria-labelledby="JuneLimitedTitle-{{ section.id }}">
 <div class="jl__editorial">
  <header class="jl__header">
   <p class="jl__label">{{ section.settings.eyebrow | escape }}</p>
   <h2 class="jl__heading" id="JuneLimitedTitle-{{ section.id }}">{{ section.settings.heading | escape }}<br>{{ section.settings.heading_second | escape }}</h2>
   <div class="jl__body jl__intro">{{ section.settings.intro }}</div>
  </header>
  <div class="jl__scenes">
   {% assign number = 0 %}{% for block in planners %}{% assign product = block.settings.product %}{% if product != blank %}
    {% liquid
     assign name = block.settings.short_name | default: product.title
     assign image_index = block.settings.scene_number | minus: 1
     assign scene = block.settings.scene | default: product.images[image_index] | default: product.featured_image
     assign mobile_scene = block.settings.mobile_scene | default: scene
     assign scene_alt = block.settings.scene_alt | default: scene.alt | default: name
     assign gifts = 0
     for i in (1..5)
      assign gift_key = 'gift_' | append: i
      if block.settings[gift_key] != blank
       assign gifts = gifts | plus: 1
      endif
     endfor
    %}
    <div class="jl__scene" data-scene="{{ number }}" {% unless number == 0 %}hidden{% endunless %}>
     <picture>
      <source media="(max-width: 900px)" srcset="{{ mobile_scene | image_url: width: 500 }} 500w, {{ mobile_scene | image_url: width: 900 }} 900w" sizes="100vw">
      {{ scene | image_url: width: 1500 | image_tag: widths: '600,900,1200,1500', sizes: '(min-width: 1680px) 980px, (min-width: 901px) 60vw, 100vw', loading: 'lazy', alt: scene_alt }}
     </picture>
     {% if gifts > 0 %}<span class="jl__stamp jl__label">{{ 'june_limited.gift_count' | t: count: gifts }}</span>{% endif %}
    </div>
    {% assign number = number | plus: 1 %}
   {% endif %}{% endfor %}
  </div>
 </div>
 <div class="jl__shopping">
  <div class="jl__product-heads" aria-live="polite" aria-atomic="true">
   {% assign number = 0 %}{% for block in planners %}{% assign product = block.settings.product %}{% if product != blank %}
   <div data-heading="{{ number }}" {% unless number == 0 %}hidden{% endunless %}>
    <h3 class="jl__subheading">{{ block.settings.short_name | default: product.title | escape }}</h3>
    <p class="jl__body jl__caption">{{ section.settings.product_caption | escape }}</p>
    <p class="jl__price jl__subheading">{% if product.price_varies %}<span class="jl__body">{{ 'june_limited.from' | t }}</span> {% endif %}{{ product.price | money }}</p>
    {% unless product.available %}<p class="jl__body">{{ 'june_limited.sold_out' | t }}</p>{% endunless %}
   </div>{% assign number = number | plus: 1 %}{% endif %}{% endfor %}
  </div>
  <div class="jl__choose">
   <p class="jl__body" id="JuneLimitedChoose-{{ section.id }}">{{ 'june_limited.choose' | t }}</p>
   <div class="jl__covers" role="group" aria-labelledby="JuneLimitedChoose-{{ section.id }}">
    {% assign number = 0 %}{% for block in planners %}{% assign product = block.settings.product %}{% if product != blank %}
     {% assign cover = block.settings.cover | default: product.featured_image %}{% assign name = block.settings.short_name | default: product.title %}
     <button class="jl__cover" type="button" data-select="{{ number }}" data-block="{{ block.id }}" aria-pressed="{% if number == 0 %}true{% else %}false{% endif %}" aria-label="{{ name | escape }}" {{ block.shopify_attributes }}>{{ cover | image_url: width: 300 | image_tag: widths: '120,200,300', sizes: '100px', loading: 'lazy', alt: name }}</button>
     {% assign number = number | plus: 1 %}
    {% endif %}{% endfor %}
   </div>
  </div>
  <div class="jl__actions">
   {% assign number = 0 %}{% for block in planners %}{% assign product = block.settings.product %}{% if product != blank %}
    <div data-buy="{{ number }}" {% unless number == 0 %}hidden{% endunless %}>
     <a class="jl__primary jl__button" href="{{ product.url }}">{% if product.available %}{{ 'june_limited.shop' | t }}{% else %}{{ 'june_limited.view' | t }}{% endif %}{{ arrow }}</a>
    </div>{% assign number = number | plus: 1 %}{% endif %}{% endfor %}
   <p class="jl__note jl__body">{{ section.settings.offer_note | escape }}</p>
  </div>
  <div class="jl__offers">
   {% assign number = 0 %}{% for block in planners %}{% assign product = block.settings.product %}{% if product != blank %}
   {% assign gifts = 0 %}{% for i in (1..5) %}{% assign gift_key = 'gift_' | append: i %}{% if block.settings[gift_key] != blank %}{% assign gifts = gifts | plus: 1 %}{% endif %}{% endfor %}
   <div data-offer="{{ number }}" {% unless number == 0 %}hidden{% endunless %}>
    {% if gifts > 0 %}
    <details class="jl__gifts" open>
     <summary class="jl__button"><span>{{ 'june_limited.included' | t }}</span><span class="jl__plus" aria-hidden="true">+</span></summary>
     <ol>
      {% assign gift_number = 0 %}{% for i in (1..5) %}{% assign gift_key = 'gift_' | append: i %}{% assign note_key = 'gift_note_' | append: i %}{% if block.settings[gift_key] != blank %}
      {% assign gift_number = gift_number | plus: 1 %}<li><span class="jl__number jl__label" aria-hidden="true">0{{ gift_number }}</span><div class="jl__body">{{ block.settings[gift_key] | escape }}{% if block.settings[note_key] != blank %}<span class="jl__gift-note">{{ block.settings[note_key] | escape }}</span>{% endif %}</div></li>
      {% endif %}{% endfor %}
     </ol>
    </details>
    {% endif %}
   </div>{% assign number = number | plus: 1 %}{% endif %}{% endfor %}
  </div>
  {% if section.settings.collection != blank %}<a class="jl__textlink jl__button" href="{{ section.settings.collection.url }}">{{ 'june_limited.view_all' | t }}{{ arrow }}</a>{% endif %}
 </div>
 <noscript><div class="jl__fallback jl__body">{{ 'june_limited.no_script' | t }} {% for block in planners %}{% if block.settings.product != blank %}<a href="{{ block.settings.product.url }}">{{ block.settings.short_name | default: block.settings.product.title | escape }}</a>{% endif %}{% endfor %}</div></noscript>
</june-limited>
{% elsif request.design_mode %}<div class="jl__empty">{{ 'june_limited.setup' | t }}</div>{% endif %}

{% stylesheet %}
june-limited.jl{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(340px,1fr);max-width:1680px;margin:0 auto;background:var(--jl-bg);color:var(--jl-ink);border-bottom:1px solid #1113;}
.jl *{box-sizing:border-box}.jl [hidden]{display:none!important}.jl h2,.jl h3,.jl p{margin:0;color:inherit}.jl a{color:inherit;text-decoration:none}.jl button,.jl summary{font:inherit;color:inherit}.jl button{appearance:none;cursor:pointer}.jl button:focus-visible,.jl a:focus-visible,.jl summary:focus-visible{outline:2px solid currentColor;outline-offset:5px}.jl img{display:block;max-width:100%}.jl strong{font-weight:700}
