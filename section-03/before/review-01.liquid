.jl .jl__label{font-family:var(--jl-label-font);font-size:var(--jl-label-size);font-weight:var(--jl-label-weight);letter-spacing:var(--jl-label-tracking);line-height:var(--jl-label-leading);}
.jl .jl__button{font-family:var(--jl-button-font);font-size:var(--jl-button-size);font-weight:var(--jl-button-weight);letter-spacing:var(--jl-button-tracking);line-height:var(--jl-button-leading);}
.jl__editorial{min-width:0;display:flex;flex-direction:column}.jl__header{padding:48px 48px 30px}.jl__heading{margin:14px 0 18px!important;overflow-wrap:break-word}.jl__label{text-transform:uppercase}.jl__scenes{min-width:0;min-height:var(--jl-scene);flex:1;position:relative}.jl__scene{position:absolute;inset:0;height:100%;overflow:hidden}.jl__scene picture{display:block;width:100%;height:100%}.jl__scene img{width:100%;height:100%;object-fit:cover;object-position:50% 52%}.jl__stamp{position:absolute;top:22px;right:22px;max-width:160px;min-height:70px;display:flex;align-items:center;justify-content:center;text-align:center;padding:14px 22px;border:1px solid currentColor;border-radius:50%;background:var(--jl-bg);transform:rotate(8deg);box-shadow:2px 3px 0 #1111;}
.jl__shopping{min-width:0;margin:48px 0 40px;padding:0 44px;border-left:1px solid #1114;display:flex;flex-direction:column;align-items:stretch;justify-content:center}.jl__product-heads{min-height:125px}.jl__caption{margin-top:10px!important}.jl__price{margin-top:14px!important}.jl__choose{border-top:1px solid #1114;margin-top:16px;padding-top:16px}.jl__covers{display:grid;grid-template-columns:repeat(auto-fit,minmax(54px,1fr));gap:10px;margin:16px 0 20px}.jl__cover{display:block;min-width:0;min-height:44px;border:1px solid transparent;padding:5px;background:transparent;border-radius:3px;transition:border-color var(--jl-duration) ease,transform var(--jl-duration) ease}.jl__cover img{width:100%;height:90px;object-fit:contain;mix-blend-mode:multiply}.jl__cover[aria-pressed=true]{border:2px solid var(--jl-ink);padding:4px;background:#11105}.jl__arrow{flex:none;width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;background:#111;color:var(--jl-accent);border-radius:50%}.jl__arrow svg{width:16px;height:16px}.jl .jl__primary{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:50px;padding:8px 9px 8px 22px;background:var(--jl-accent);color:#111;border:1px solid #111;border-radius:999px;box-shadow:-2px 1px 0 #111;transition:transform var(--jl-duration) ease}.jl__primary .jl__arrow{width:32px;height:32px;transition:transform var(--jl-duration) ease}.jl__primary svg{width:18px;height:18px}.jl__note{text-align:center;margin:12px 0 20px!important;opacity:.75}.jl__gifts{border-top:1px solid #1114}.jl__gifts summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:15px;min-height:56px;padding:14px 0}.jl__gifts summary::-webkit-details-marker{display:none}.jl__plus{font-size:24px;font-weight:400;line-height:1}.jl__gifts[open] .jl__plus{transform:rotate(45deg)}.jl__gifts ol{list-style:none;padding:0;margin:0}.jl__gifts li{display:flex;gap:14px;align-items:center;border-top:1px solid #1112;padding:10px 0;min-height:49px}.jl__number{display:grid;place-items:center;flex:none;width:31px;height:31px;border-radius:50%;background:color-mix(in srgb,var(--jl-accent) 40%,var(--jl-bg))}.jl__gift-note{display:block;font-size:.8em;margin-top:3px;opacity:.75}.jl .jl__textlink{align-self:flex-start;display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:20px;text-decoration:underline;text-underline-offset:5px}.jl__fallback{grid-column:1/-1;padding:20px}.jl__fallback a{display:inline-block;margin:8px;text-decoration:underline}.jl__empty{padding:40px;text-align:center}
@media(hover:hover){.jl[data-motion=true] .jl__primary:hover{transform:translateY(-2px)}.jl[data-motion=true] .jl__primary:hover .jl__arrow{transform:translateX(2px)}.jl[data-motion=true] .jl__cover:hover{transform:translateY(-3px)}}.jl[data-motion=true] .jl__primary:active{transform:translateY(1px)}
@media(min-width:901px) and (max-width:1150px){.jl__header{padding:36px 28px 28px}.jl__shopping{padding:0 28px;margin-top:36px}.jl .jl__heading{font-size:calc(var(--jl-heading-size)*.85)}.jl__cover img{height:80px}}
@media(max-width:900px){
 june-limited.jl{display:block}.jl__editorial{display:block}
 .jl .jl__heading{font-size:var(--jl-heading-mobile);}
.jl .jl__subheading{font-size:var(--jl-subheading-mobile);}
.jl .jl__body{font-size:var(--jl-body-mobile);}
.jl .jl__label{font-size:var(--jl-label-mobile);}
.jl .jl__button{font-size:var(--jl-button-mobile);}
 .jl__header{padding:30px 20px 24px}.jl__heading{margin:12px 0 14px!important}.jl__scenes{min-height:0}.jl__scene{position:relative;height:var(--jl-mobile-scene);min-height:0}.jl__scene img{object-position:50% 50%}.jl__stamp{top:18px;right:18px;max-width:130px;min-height:58px;padding:10px 16px}.jl__shopping{margin:0;padding:25px 20px 30px;border-left:0}.jl__product-heads{min-height:0}.jl__caption{margin-top:7px!important}.jl__price{margin-top:10px!important}.jl__choose{margin-top:18px;padding-top:16px}.jl__covers{gap:10px;margin:12px 0 20px}.jl__cover img{height:90px}.jl__note{margin-bottom:16px!important}.jl__gifts summary{min-height:54px}.jl__gifts li{padding:12px 0}.jl .jl__textlink{margin-top:16px}.jl__scene{max-height:520px}
}
