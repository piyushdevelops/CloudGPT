{% comment %}
  TJS FEATURED FOCUS — 50% DISPLAY PRICE
  This section visually shows half of each stored Shopify selling price.
  Keep the matching 50% automatic product discount active for cart and checkout.
{% endcomment %}

{% liquid
  assign featured_collection = section.settings.collection
  assign section_heading = section.settings.heading
  if section_heading == blank and featured_collection != blank
    assign section_heading = featured_collection.title
  endif

  assign active_image_multiplier = section.settings.active_image_scale | times: 0.01
  assign shadow_alpha = section.settings.shadow_strength | times: 0.01
  assign shadow_mid_alpha = section.settings.shadow_strength | times: 0.0055
  assign shadow_soft_alpha = section.settings.shadow_strength | times: 0.0038
  assign border_alpha = 0.10

  assign image_position = 'center center'
  case section.settings.image_position
    when 'top'
      assign image_position = 'center top'
    when 'bottom'
      assign image_position = 'center bottom'
    when 'left'
      assign image_position = 'left center'
    when 'right'
      assign image_position = 'right center'
  endcase

  assign mobile_center_width = section.settings.mobile_center_width
  assign mobile_side_width = 100 | minus: mobile_center_width | divided_by: 2
  assign mobile_center_left = mobile_side_width
  assign mobile_right_left = mobile_side_width | plus: mobile_center_width

  assign mobile_height_factor = 1.25
  case section.settings.mobile_card_ratio
    when 'square'
      assign mobile_height_factor = 1.0
    when 'five-six'
      assign mobile_height_factor = 1.2
  endcase

  assign mobile_viewport_vw = mobile_center_width | times: mobile_height_factor
  assign mobile_gutter_total = section.settings.mobile_gutter | times: 2
  assign mobile_gutter_adjust = mobile_gutter_total | times: mobile_viewport_vw | divided_by: 100.0
  assign mobile_gap_adjust = section.settings.card_gap | times: mobile_height_factor
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --tjs-focus-space-top: {{ section.settings.padding_top }}px;
    --tjs-focus-space-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus {
    --tjs-focus-bg: {{ section.settings.section_bg }};
    --tjs-focus-card-bg: {{ section.settings.card_bg }};
    --tjs-focus-image-bg: {{ section.settings.image_bg }};
    --tjs-focus-text: {{ section.settings.text_color }};
    --tjs-focus-muted: {{ section.settings.muted_color }};
    --tjs-focus-accent: {{ section.settings.accent_color }};
    --tjs-focus-gap: {{ section.settings.card_gap }}px;
    --tjs-focus-radius: {{ section.settings.corner_radius }}px;
    --tjs-focus-height: {{ section.settings.desktop_height }}px;
    --tjs-focus-image-scale: {{ section.settings.image_scale }}%;
    --tjs-focus-active-image-scale: {{ active_image_multiplier }};
    --tjs-focus-shadow-alpha: {{ shadow_alpha }};
    --tjs-focus-shadow-mid-alpha: {{ shadow_mid_alpha }};
    --tjs-focus-shadow-soft-alpha: {{ shadow_soft_alpha }};
    --tjs-focus-border-alpha: {{ border_alpha }};
    --tjs-focus-drag-x: 0px;
    padding-block: var(--tjs-focus-space-top) var(--tjs-focus-space-bottom);
    overflow: hidden;
    background: var(--tjs-focus-bg);
    color: var(--tjs-focus-text);
    font-family: var(--font-body-family, Arial, sans-serif);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus,
  #shopify-section-{{ section.id }} .tjs-featured-focus * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__outer {
    width: min(100%, {{ section.settings.max_width }}px);
    margin-inline: auto;
    padding-inline: {{ section.settings.page_gutter }}px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: clamp(22px, 3vw, 38px);
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__header[data-align='center'] {
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__heading-wrap {
    max-width: 760px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__header[data-align='center'] .tjs-featured-focus__heading-wrap {
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    color: var(--tjs-focus-accent);
    font-size: 10px;
    font-weight: 750;
    line-height: 1;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__header[data-align='center'] .tjs-featured-focus__eyebrow {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__heading {
    margin: 0;
    color: var(--tjs-focus-text);
    font-family: var(--font-heading-family, var(--font-body-family, Arial, sans-serif));
    font-size: clamp(38px, 4.6vw, {{ section.settings.heading_size }}px);
    font-weight: 500;
    line-height: .96;
    letter-spacing: -.045em;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__description {
    max-width: 52ch;
    margin: 14px 0 0;
    color: var(--tjs-focus-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__header[data-align='center'] .tjs-featured-focus__description {
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__description > * {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__header-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 42px;
    padding: 11px 15px;
    border: 1px solid color-mix(in srgb, var(--tjs-focus-text) 14%, transparent);
    border-radius: 10px;
    background: transparent;
    color: var(--tjs-focus-text);
    font-size: 9px;
    font-weight: 760;
    line-height: 1;
    letter-spacing: .12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform .25s ease, border-color .25s ease, background-color .25s ease;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__view-all:hover,
  #shopify-section-{{ section.id }} .tjs-featured-focus__view-all:focus-visible {
    transform: translateY(-2px);
    border-color: var(--tjs-focus-text);
    background: color-mix(in srgb, var(--tjs-focus-text) 4%, transparent);
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__view-all svg {
    width: 13px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__arrows {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__arrow {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--tjs-focus-text) 14%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--tjs-focus-card-bg) 86%, transparent);
    color: var(--tjs-focus-text);
    cursor: pointer;
    transition: transform .25s ease, background-color .25s ease, border-color .25s ease;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__arrow:hover,
  #shopify-section-{{ section.id }} .tjs-featured-focus__arrow:focus-visible {
    transform: translateY(-2px);
    border-color: var(--tjs-focus-text);
    background: var(--tjs-focus-card-bg);
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__arrow svg {
    width: 16px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__viewport {
    position: relative;
    height: min(var(--tjs-focus-height), clamp(380px, 33vw, 500px));
    margin-inline: calc(var(--tjs-focus-gap) / -2);
    outline: none;
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__viewport.is-dragging {
    cursor: grabbing;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__viewport:focus-visible {
    box-shadow: 0 0 0 2px var(--tjs-focus-accent) inset;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item {
    --tjs-slot-left: 100%;
    --tjs-slot-width: 18.75%;
    --tjs-slot-opacity: 0;
    --tjs-slot-scale: .94;
    --tjs-slot-lift: 8px;
    position: absolute;
    top: 0;
    left: var(--tjs-slot-left);
    z-index: 1;
    width: var(--tjs-slot-width);
    height: 100%;
    padding-inline: calc(var(--tjs-focus-gap) / 2);
    opacity: var(--tjs-slot-opacity);
    pointer-events: none;
    transform: translate3d(var(--tjs-focus-drag-x), var(--tjs-slot-lift), 0) scale(var(--tjs-slot-scale));
    transform-origin: center center;
    will-change: left, width, transform, opacity;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus.is-ready .tjs-featured-focus__item {
    transition:
      left .66s cubic-bezier(.22, .8, .3, 1),
      width .66s cubic-bezier(.22, .8, .3, 1),
      transform .66s cubic-bezier(.22, .8, .3, 1),
      opacity .35s ease;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='-2'] {
    --tjs-slot-left: 0%;
    --tjs-slot-width: 18.75%;
    --tjs-slot-opacity: .84;
    --tjs-slot-scale: .975;
    --tjs-slot-lift: 7px;
    z-index: 2;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='-1'] {
    --tjs-slot-left: 18.75%;
    --tjs-slot-width: 18.75%;
    --tjs-slot-opacity: .92;
    --tjs-slot-scale: .985;
    --tjs-slot-lift: 4px;
    z-index: 3;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='0'] {
    --tjs-slot-left: 37.5%;
    --tjs-slot-width: 25%;
    --tjs-slot-opacity: 1;
    --tjs-slot-scale: 1;
    --tjs-slot-lift: -7px;
    z-index: 5;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='1'] {
    --tjs-slot-left: 62.5%;
    --tjs-slot-width: 18.75%;
    --tjs-slot-opacity: .92;
    --tjs-slot-scale: .985;
    --tjs-slot-lift: 4px;
    z-index: 3;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='2'] {
    --tjs-slot-left: 81.25%;
    --tjs-slot-width: 18.75%;
    --tjs-slot-opacity: .84;
    --tjs-slot-scale: .975;
    --tjs-slot-lift: 7px;
    z-index: 2;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='before'] {
    --tjs-slot-left: -24%;
    --tjs-slot-opacity: 0;
    --tjs-slot-lift: 10px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='after'] {
    --tjs-slot-left: 105%;
    --tjs-slot-opacity: 0;
    --tjs-slot-lift: 10px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__card {
    position: relative;
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(25, 23, 21, var(--tjs-focus-border-alpha));
    border-radius: var(--tjs-focus-radius);
    background: var(--tjs-focus-card-bg);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .72) inset,
      0 14px 30px rgba(26, 21, 18, var(--tjs-focus-shadow-soft-alpha)),
      0 28px 58px rgba(26, 21, 18, var(--tjs-focus-shadow-soft-alpha));
    color: var(--tjs-focus-text);
    transition: box-shadow .35s ease, border-color .35s ease, transform .35s ease;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 8;
    border-radius: inherit;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .72) inset,
      0 0 0 1px rgba(255, 255, 255, .18) inset;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus[data-card-style='minimal'] .tjs-featured-focus__card {
    border-color: transparent;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus[data-card-style='outline'] .tjs-featured-focus__card {
    box-shadow: none;
    border-color: color-mix(in srgb, var(--tjs-focus-text) 18%, transparent);
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus[data-card-style='soft'] .tjs-featured-focus__card {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .65) inset,
      0 12px 28px rgba(26, 21, 18, var(--tjs-focus-shadow-soft-alpha));
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus[data-card-style='elevated'] .tjs-featured-focus__item[data-slot='0'] .tjs-featured-focus__card {
    border-color: color-mix(in srgb, var(--tjs-focus-accent) 15%, rgba(25, 23, 21, var(--tjs-focus-border-alpha)));
    box-shadow:
      0 1px 0 rgba(255,255,255,.76) inset,
      0 24px 54px rgba(26, 21, 18, var(--tjs-focus-shadow-mid-alpha)),
      0 38px 78px rgba(26, 21, 18, var(--tjs-focus-shadow-alpha));
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__media-shell {
    position: relative;
    isolation: isolate;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 74% 18%, color-mix(in srgb, var(--tjs-focus-accent) 12%, transparent) 0, transparent 34%),
      linear-gradient(145deg, color-mix(in srgb, var(--tjs-focus-image-bg) 97%, white) 0%, var(--tjs-focus-image-bg) 62%, color-mix(in srgb, var(--tjs-focus-image-bg) 91%, var(--tjs-focus-accent)) 100%);
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__media-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(180deg, rgba(255,255,255,.22), transparent 24%, transparent 76%, rgba(26,21,18,.035)),
      radial-gradient(circle at 50% 48%, rgba(255,255,255,.30), transparent 54%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__media {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__media::before {
    content: '';
    position: absolute;
    inset: 10px;
    z-index: 1;
    border: 1px solid rgba(255,255,255,.24);
    border-radius: max(calc(var(--tjs-focus-radius) - 8px), 4px);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__media::after {
    content: '';
    position: absolute;
    right: 8%;
    bottom: 4%;
    left: 8%;
    z-index: 0;
    height: 13%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(23, 20, 18, .18) 0%, transparent 72%);
    opacity: .42;
    filter: blur(2px);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__image {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: block;
    width: min(112%, calc(var(--tjs-focus-image-scale) + 12%));
    height: min(112%, calc(var(--tjs-focus-image-scale) + 12%));
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ image_position }};
    transform: translate(-50%, -50%) scale(1);
    transition: transform .55s cubic-bezier(.22, .8, .3, 1), filter .35s ease;
    filter:
      drop-shadow(0 2px 2px rgba(24, 20, 18, .08))
      drop-shadow(0 15px 22px rgba(24, 20, 18, .15))
      drop-shadow(0 30px 42px rgba(24, 20, 18, .10));
    -webkit-user-drag: none;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='0'] .tjs-featured-focus__image {
    width: min(116%, calc(var(--tjs-focus-image-scale) + 16%));
    height: min(116%, calc(var(--tjs-focus-image-scale) + 16%));
    transform: translate(-50%, -50%) scale(var(--tjs-focus-active-image-scale));
    filter:
      drop-shadow(0 2px 1px rgba(24, 20, 18, .10))
      drop-shadow(0 20px 28px rgba(24, 20, 18, .19))
      drop-shadow(0 40px 54px rgba(24, 20, 18, .13));
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .76) inset,
      0 20px 42px rgba(26, 21, 18, var(--tjs-focus-shadow-mid-alpha)),
      0 34px 68px rgba(26, 21, 18, var(--tjs-focus-shadow-soft-alpha));
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__card:hover .tjs-featured-focus__image {
    transform: translate(-50%, -50%) scale(1.035);
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='0'] .tjs-featured-focus__card:hover .tjs-featured-focus__image {
    transform: translate(-50%, -50%) scale(calc(var(--tjs-focus-active-image-scale) + .03));
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__badges {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__badge {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 6px 8px;
    border-radius: 7px;
    background: var(--tjs-focus-text);
    color: #FFFFFF;
    font-size: 7px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: .10em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__badge--sold {
    background: var(--tjs-focus-text);
    color: var(--tjs-focus-card-bg);
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__info {
    position: relative;
    z-index: 3;
    flex: 0 0 auto;
    min-height: 82px;
    padding: 14px 14px 13px;
    border-top: 1px solid color-mix(in srgb, var(--tjs-focus-text) 7%, transparent);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tjs-focus-card-bg) 96%, transparent), var(--tjs-focus-card-bg));
    box-shadow: 0 -10px 24px rgba(26, 21, 18, .035);
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='0'] .tjs-featured-focus__info {
    min-height: 86px;
    padding-inline: 16px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__vendor {
    margin: 0 0 6px;
    overflow: hidden;
    color: var(--tjs-focus-muted);
    font-size: 7px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: .12em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__title {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--tjs-focus-text);
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 12px;
    font-weight: 620;
    line-height: 1.3;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='0'] .tjs-featured-focus__title {
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 5px;
    margin-top: 8px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__price {
    color: var(--tjs-focus-text);
    font-size: 11px;
    font-weight: 760;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__item[data-slot='0'] .tjs-featured-focus__price {
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__compare {
    color: var(--tjs-focus-muted);
    font-size: 9px;
    line-height: 1;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus__actions {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 6;
    display: flex;
    align-items: center;
    gap: 7px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(7px);
    transition: opacity .25s ease, transform .25s ease;
  }

  #shopify-section-{{ section.id }} .tjs-featured-focus[data-actions-mode='active'] .tjs-featured-focus__item[data-slot='0'] .tjs-featured-focus__actions,
  #shopify-section-{{ section.id }} .tjs-featured-focus[data-actions-mode='hover'] .tjs-featured-focus__item[data-slot='0'] .tjs-featured-focus__actions,
  #shopify-section-{{ section.id }} .tjs-featured-focus[data-actions-mode='hover'] .tjs-featured-focus__card:hover .tjs-featured-focus__actions,
