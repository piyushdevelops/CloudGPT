    #shopify-section-{{ section.id }} .tjs-featured-focus__modal-actions {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .tjs-featured-focus__item,
    #shopify-section-{{ section.id }} .tjs-featured-focus__image,
    #shopify-section-{{ section.id }} .tjs-featured-focus__card,
    #shopify-section-{{ section.id }} .tjs-featured-focus__action,
    #shopify-section-{{ section.id }} .tjs-featured-focus__arrow,
    #shopify-section-{{ section.id }} .tjs-featured-focus__toast {
      transition-duration: .01ms !important;
      animation: none !important;
    }
  }
{% endstyle %}

<section
  class="tjs-featured-focus"
  data-tjs-featured-focus="{{ section.id }}"
  data-card-style="{{ section.settings.card_style }}"
  data-actions-mode="{{ section.settings.actions_mode }}"
  data-button-style="{{ section.settings.button_style }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}.js"
>
  <div class="tjs-featured-focus__outer">
    {% if section.settings.show_header %}
      <header class="tjs-featured-focus__header" data-align="{{ section.settings.heading_alignment }}">
        <div class="tjs-featured-focus__heading-wrap">
          {% if section.settings.eyebrow != blank %}
            <p class="tjs-featured-focus__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}

          {% if section_heading != blank %}
            <h2 class="tjs-featured-focus__heading">{{ section_heading | escape }}</h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="tjs-featured-focus__description rte">{{ section.settings.description }}</div>
          {% endif %}
        </div>

        <div class="tjs-featured-focus__header-actions">
          {% if section.settings.show_view_all and featured_collection != blank and section.settings.view_all_label != blank %}
            <a class="tjs-featured-focus__view-all" href="{{ featured_collection.url }}">
              <span>{{ section.settings.view_all_label | escape }}</span>
              <svg viewBox="0 0 18 12" aria-hidden="true"><path d="M1 6h15M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {% endif %}

          {% if section.settings.show_arrows %}
            <div class="tjs-featured-focus__arrows">
              <button class="tjs-featured-focus__arrow" type="button" data-focus-prev aria-label="Previous product">
                <svg viewBox="0 0 18 12" aria-hidden="true"><path d="M17 6H2M7 1 2 6l5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="tjs-featured-focus__arrow" type="button" data-focus-next aria-label="Next product">
                <svg viewBox="0 0 18 12" aria-hidden="true"><path d="M1 6h15M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          {% endif %}
        </div>
      </header>
    {% elsif section.settings.show_arrows %}
      <div class="tjs-featured-focus__header-actions" style="justify-content:flex-end;margin-bottom:18px;">
        <div class="tjs-featured-focus__arrows">
          <button class="tjs-featured-focus__arrow" type="button" data-focus-prev aria-label="Previous product">
            <svg viewBox="0 0 18 12" aria-hidden="true"><path d="M17 6H2M7 1 2 6l5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="tjs-featured-focus__arrow" type="button" data-focus-next aria-label="Next product">
            <svg viewBox="0 0 18 12" aria-hidden="true"><path d="M1 6h15M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    {% endif %}

    {% if featured_collection != blank %}
      <div class="tjs-featured-focus__viewport" data-focus-viewport tabindex="0" aria-label="Swipe or use arrow keys to browse products">
        {% assign rendered_count = 0 %}
        {% for product in featured_collection.products limit: 50 %}
          {% if section.settings.hide_sold_out and product.available == false %}
            {% continue %}
          {% endif %}
          {% if rendered_count >= section.settings.product_limit %}
            {% break %}
          {% endif %}

          {% liquid
            assign initial_variant = product.selected_or_first_available_variant
            if initial_variant == blank
              assign initial_variant = product.variants.first
            endif

            assign tjs_display_price = product.price | times: 1 | round
            assign has_discount = true
            assign saving_percent = 50

            assign image_loading = 'lazy'
            assign image_priority = 'low'
            if section.index != blank and section.index <= 2 and rendered_count < 3
              assign image_loading = 'eager'
              assign image_priority = 'high'
            endif
          %}

          <article
            class="tjs-featured-focus__item"
            data-focus-item
            data-index="{{ rendered_count }}"
            data-product-id="{{ product.id }}"
            data-slot="after"
          >
            <div class="tjs-featured-focus__card">
              <div class="tjs-featured-focus__media-shell">
                <a class="tjs-featured-focus__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  {% if product.featured_image != blank %}
                    {{ product.featured_image
                      | image_url: width: 1800
                      | image_tag:
                        class: 'tjs-featured-focus__image',
                        loading: image_loading,
                        fetchpriority: image_priority,
                        decoding: 'async',
                        widths: '240, 320, 420, 520, 680, 840, 1080, 1320, 1600, 1800',
                        sizes: '(max-width: 749px) 44vw, 27vw',
                        alt: product.featured_image.alt | default: product.title
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'tjs-featured-focus__image placeholder-svg' }}
                  {% endif %}

                  <div class="tjs-featured-focus__badges">
                    {% unless product.available %}
                      <span class="tjs-featured-focus__badge tjs-featured-focus__badge--sold">Sold out</span>
                    {% endunless %}
                    {% if section.settings.show_sale_badge and has_discount %}
                      <span class="tjs-featured-focus__badge">Save {{ saving_percent }}%</span>
                    {% endif %}
                  </div>
                </a>

                {% if section.settings.show_quick_add or section.settings.show_quick_view %}
                  <div class="tjs-featured-focus__actions">
                    {% if section.settings.show_quick_add %}
                      <button
                        class="tjs-featured-focus__action"
                        type="button"
                        data-quick-add
                        data-product-id="{{ product.id }}"
                        data-variant-id="{{ initial_variant.id }}"
                        data-variant-count="{{ product.variants.size }}"
                        data-product-url="{{ product.url }}"
                        aria-label="{% if product.available %}Quick add {{ product.title | escape }}{% else %}{{ product.title | escape }} is sold out{% endif %}"
                        {% unless product.available %}disabled{% endunless %}
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 9V6a3 3 0 0 1 6 0v3M12 12v5M9.5 14.5h5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      </button>
                    {% endif %}

                    {% if section.settings.show_quick_view %}
                      <button class="tjs-featured-focus__action" type="button" data-quick-view data-product-id="{{ product.id }}" aria-label="Quick view {{ product.title | escape }}">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="2.8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                      </button>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              <div class="tjs-featured-focus__info">
                {% if section.settings.show_vendor and product.vendor != blank %}
                  <p class="tjs-featured-focus__vendor">{{ product.vendor | escape }}</p>
                {% endif %}

                <a class="tjs-featured-focus__title" href="{{ product.url }}">{{ product.title | escape }}</a>

                <div class="tjs-featured-focus__price-row">
                  <span class="tjs-featured-focus__price">
                    {% if product.price_varies %}From {% endif %}{{ tjs_display_price | money }}
                  </span>
                  <span class="tjs-featured-focus__compare">{{ product.price | money }}</span>
                </div>
              </div>
            </div>
          </article>

          <script type="application/json" data-focus-product-json="{{ product.id }}">
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "vendor": {{ product.vendor | json }},
              "url": {{ product.url | json }},
              "image": {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1000 | json }}{% else %}""{% endif %},
              "description": {{ product.description | strip_html | strip_newlines | truncate: 280 | json }},
              "variants": [
                {% for variant in product.variants %}
                  {% assign tjs_variant_display_price = variant.price | times: 1 | round %}
                  {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ tjs_variant_display_price | json }},
                    "priceFormatted": {{ tjs_variant_display_price | money | json }},
                    "compareAt": {{ variant.price | json }},
                    "compareFormatted": {{ variant.price | money | json }},
                    "image": {% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 1000 | json }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 1000 | json }}{% else %}""{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          </script>

          {% assign rendered_count = rendered_count | plus: 1 %}
        {% endfor %}

        {% if rendered_count == 0 %}
          <div class="tjs-featured-focus__empty" style="position:absolute;inset:0;">
            <p>No available products were found in this collection.</p>
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="tjs-featured-focus__empty">
        <p>Select a collection to display its first {{ section.settings.product_limit }} products.</p>
      </div>
    {% endif %}
  </div>

  {% if section.settings.show_quick_add or section.settings.show_quick_view %}
    <div class="tjs-featured-focus__modal" data-focus-modal hidden aria-hidden="true">
      <button class="tjs-featured-focus__modal-backdrop" type="button" data-modal-close aria-label="Close quick view"></button>
      <div class="tjs-featured-focus__modal-panel" role="dialog" aria-modal="true" aria-labelledby="tjs-focus-modal-title-{{ section.id }}">
        <button class="tjs-featured-focus__modal-close" type="button" data-modal-close aria-label="Close quick view">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>

        <div class="tjs-featured-focus__modal-media">
          <img class="tjs-featured-focus__modal-image" data-modal-image src="" alt="">
        </div>

        <div class="tjs-featured-focus__modal-content">
          <p class="tjs-featured-focus__modal-vendor" data-modal-vendor></p>
          <h3 class="tjs-featured-focus__modal-title" id="tjs-focus-modal-title-{{ section.id }}" data-modal-title></h3>
          <div class="tjs-featured-focus__modal-price">
            <span data-modal-price></span>
            <span class="tjs-featured-focus__modal-compare" data-modal-compare></span>
          </div>
          <p class="tjs-featured-focus__modal-description" data-modal-description></p>

          <div class="tjs-featured-focus__modal-field" data-modal-variant-field>
            <label for="tjs-focus-variant-{{ section.id }}">Choose an option</label>
            <select class="tjs-featured-focus__modal-select" id="tjs-focus-variant-{{ section.id }}" data-modal-variant></select>
          </div>

          <div class="tjs-featured-focus__modal-field">
            <label for="tjs-focus-quantity-{{ section.id }}">Quantity</label>
            <input class="tjs-featured-focus__modal-quantity" id="tjs-focus-quantity-{{ section.id }}" data-modal-quantity type="number" min="1" value="1" inputmode="numeric">
          </div>

          <div class="tjs-featured-focus__modal-actions">
            <button class="tjs-featured-focus__modal-add" type="button" data-modal-add>Add to cart</button>
            <a class="tjs-featured-focus__modal-link" data-modal-link href="#">View details</a>
          </div>
        </div>
      </div>
    </div>

    <div class="tjs-featured-focus__toast" data-focus-toast role="status" aria-live="polite"></div>
  {% endif %}
</section>

<script>
  (() => {
    const selector = '[data-tjs-featured-focus="{{ section.id }}"]';

    const initialise = (root) => {
      if (!root || root.dataset.initialised === 'true') return;
      root.dataset.initialised = 'true';

      const controller = new AbortController();
      const { signal } = controller;
      const viewport = root.querySelector('[data-focus-viewport]');
      const items = Array.from(root.querySelectorAll('[data-focus-item]'));
      const previousButtons = Array.from(root.querySelectorAll('[data-focus-prev]'));
      const nextButtons = Array.from(root.querySelectorAll('[data-focus-next]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mobileQuery = window.matchMedia('(max-width: 749px)');
      const autoplayEnabled = root.dataset.autoplay === 'true';
      const autoplaySpeed = Math.max(parseInt(root.dataset.autoplaySpeed, 10) || 4500, 2500);

      const modal = root.querySelector('[data-focus-modal]');
      const toast = root.querySelector('[data-focus-toast]');
      const productData = new Map();

      root.querySelectorAll('[data-focus-product-json]').forEach((node) => {
        try {
          productData.set(String(node.dataset.focusProductJson), JSON.parse(node.textContent));
        } catch (error) {
          console.warn('TJS featured focus: invalid product data', error);
        }
      });

      let current = mobileQuery.matches ? Math.min(1, items.length - 1) : Math.min(2, items.length - 1);
      let autoplayTimer = null;
      let inViewport = true;
      let pointerStart = null;
      let pointerDelta = 0;
      let observer = null;
      let lastFocused = null;
      let toastTimer = null;
      let activeModalProduct = null;
      let suppressClick = false;

      const setSlot = (item, slot) => {
        const hidden = ['before', 'after'].includes(slot);
        const active = slot === '0';
        const actionsMode = root.dataset.actionsMode || 'active';

        item.dataset.slot = slot;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-hidden', hidden ? 'true' : 'false');

        item.querySelectorAll('a, button').forEach((control) => {
          const isAction = control.closest('.tjs-featured-focus__actions');
          const actionAccessible = actionsMode === 'always' || actionsMode === 'hover' || active;
          control.tabIndex = hidden || (isAction && !actionAccessible) ? -1 : 0;
        });
      };

      const signedDistance = (index) => {
        const count = items.length;
        let distance = (index - current + count) % count;
        if (distance > count / 2) distance -= count;
        return distance;
      };

      const updateSlots = (animate = true) => {
        if (!items.length) return;
        if (!animate) root.classList.remove('is-ready');

        items.forEach((item, index) => {
          const distance = signedDistance(index);
          if (distance < -2) setSlot(item, 'before');
          else if (distance > 2) setSlot(item, 'after');
          else setSlot(item, String(distance));
        });

        if (!animate) {
          requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('is-ready')));
        }
      };

      const stopAutoplay = () => {
        if (autoplayTimer) window.clearInterval(autoplayTimer);
        autoplayTimer = null;
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (!autoplayEnabled || reduceMotion.matches || document.hidden || !inViewport || items.length < 2) return;
        autoplayTimer = window.setInterval(() => move(1), autoplaySpeed);
      };

      const move = (direction, restart = false) => {
        if (items.length < 2) return;
        current = (current + direction + items.length) % items.length;
        updateSlots(true);
        if (restart) startAutoplay();
      };

      const showToast = (message, isError = false) => {
        if (!toast) return;
        if (toastTimer) window.clearTimeout(toastTimer);
        toast.textContent = message;
        toast.style.background = isError ? '#7A2626' : '';
        toast.classList.add('is-visible');
        toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 3200);
      };

      const refreshCartSignals = async (addedItem) => {
        try {
          const response = await fetch(root.dataset.cartUrl, { headers: { Accept: 'application/json' } });
          const cart = await response.json();

          document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart, item: addedItem } }));
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart, item: addedItem } }));
          document.documentElement.dispatchEvent(new CustomEvent('product:added', { bubbles: true, detail: { cart, item: addedItem } }));

          document.querySelectorAll('[data-cart-count]').forEach((node) => {
            node.textContent = cart.item_count;
            node.hidden = cart.item_count === 0;
          });
        } catch (error) {
          console.warn('TJS featured focus: cart refresh event failed', error);
        }
      };

      const addVariant = async (variantId, quantity, button) => {
        if (!variantId || !button) return;

        const originalLabel = button.textContent;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');

        if (button.matches('[data-modal-add]')) button.textContent = 'Adding…';

        try {
          const response = await fetch(root.dataset.cartAddUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({ items: [{ id: Number(variantId), quantity: Math.max(Number(quantity) || 1, 1) }] })
          });

          const payload = await response.json();
          if (!response.ok) throw new Error(payload.description || payload.message || 'Unable to add this item.');

          showToast('Added to cart.');
          await refreshCartSignals(payload.items?.[0] || payload);

          if (modal && !modal.hidden) closeModal();
        } catch (error) {
          showToast(error.message || 'Unable to add this item.', true);
        } finally {
          button.disabled = false;
          button.removeAttribute('aria-busy');
          if (button.matches('[data-modal-add]')) button.textContent = originalLabel || 'Add to cart';
        }
      };

      const updateModalVariant = () => {
        if (!modal || !activeModalProduct) return;

        const select = modal.querySelector('[data-modal-variant]');
        const variant = activeModalProduct.variants.find((entry) => String(entry.id) === String(select.value));

        if (!variant) return;

        modal.querySelector('[data-modal-price]').textContent = variant.priceFormatted;

        const compare = modal.querySelector('[data-modal-compare]');
        compare.textContent = variant.compareFormatted || '';
        compare.hidden = !variant.compareFormatted;

        const image = modal.querySelector('[data-modal-image]');
        if (variant.image) image.src = variant.image;

        const addButton = modal.querySelector('[data-modal-add]');
        addButton.disabled = !variant.available;
        addButton.textContent = variant.available ? 'Add to cart' : 'Sold out';
      };

      const openModal = (productId) => {
        if (!modal) return;

        const product = productData.get(String(productId));
        if (!product) return;

        activeModalProduct = product;
        lastFocused = document.activeElement;

        const image = modal.querySelector('[data-modal-image]');
        image.src = product.image || '';
        image.alt = product.title || '';

        modal.querySelector('[data-modal-title]').textContent = product.title || '';
        modal.querySelector('[data-modal-vendor]').textContent = product.vendor || '';
        modal.querySelector('[data-modal-description]').textContent = product.description || '';
        modal.querySelector('[data-modal-link]').href = product.url || '#';
        modal.querySelector('[data-modal-quantity]').value = 1;

        const select = modal.querySelector('[data-modal-variant]');
        select.innerHTML = '';

        let selectedAvailableVariant = false;

        product.variants.forEach((variant) => {
          const option = document.createElement('option');
          option.value = variant.id;
          option.textContent = `${variant.title}${variant.available ? '' : ' — Sold out'}`;
          option.disabled = !variant.available;

          if (variant.available && !selectedAvailableVariant) {
            option.selected = true;
            selectedAvailableVariant = true;
          }

          select.appendChild(option);
        });

        if (!selectedAvailableVariant && select.options.length) select.selectedIndex = 0;

        const variantField = modal.querySelector('[data-modal-variant-field]');
        variantField.hidden = product.variants.length <= 1;

        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = '';

        updateModalVariant();
        modal.querySelector('[data-modal-close]').focus();
      };

      const closeModal = () => {
        if (!modal) return;

        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
        activeModalProduct = null;

        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      };

      previousButtons.forEach((button) => button.addEventListener('click', () => move(-1, true), { signal }));
      nextButtons.forEach((button) => button.addEventListener('click', () => move(1, true), { signal }));

      root.querySelectorAll('[data-quick-view]').forEach((button) => {
        button.addEventListener('click', () => openModal(button.dataset.productId), { signal });
      });

      root.querySelectorAll('.tjs-featured-focus__media, .tjs-featured-focus__title, .tjs-featured-focus__view-all').forEach((link) => {
        link.addEventListener('click', (event) => {
          if (suppressClick) return;
          if (event.defaultPrevented) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          if (event.button && event.button !== 0) return;

          event.preventDefault();
          window.location.href = link.href;
        }, { signal });
      });

      root.querySelectorAll('[data-quick-add]').forEach((button) => {
        button.addEventListener('click', () => {
          const variantCount = Number(button.dataset.variantCount || 0);
          if (variantCount > 1) openModal(button.dataset.productId);
          else addVariant(button.dataset.variantId, 1, button);
        }, { signal });
      });

      if (modal) {
        modal.querySelectorAll('[data-modal-close]').forEach((button) => button.addEventListener('click', closeModal, { signal }));

        modal.querySelector('[data-modal-variant]').addEventListener('change', updateModalVariant, { signal });

        modal.querySelector('[data-modal-add]').addEventListener('click', () => {
          const variantId = modal.querySelector('[data-modal-variant]').value;
          const quantity = modal.querySelector('[data-modal-quantity]').value;
          addVariant(variantId, quantity, modal.querySelector('[data-modal-add]'));
        }, { signal });
      }

      if (viewport) {
        viewport.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            move(-1, true);
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            move(1, true);
          }
        }, { signal });

        viewport.addEventListener('pointerdown', (event) => {
          const interactiveTarget = event.target.closest(
            'a[href], button, input, select, textarea, label, summary, [role="button"]'
          );

          if (interactiveTarget) return;
          if (event.pointerType === 'mouse' && event.button !== 0) return;

          pointerStart = { x: event.clientX, y: event.clientY, time: performance.now() };
          pointerDelta = 0;
          viewport.classList.add('is-dragging');
          viewport.setPointerCapture?.(event.pointerId);
          stopAutoplay();
        }, { passive: true, signal });

        viewport.addEventListener('pointermove', (event) => {
          if (!pointerStart) return;

          pointerDelta = Math.max(-70, Math.min(70, event.clientX - pointerStart.x));
          root.style.setProperty('--tjs-focus-drag-x', `${pointerDelta}px`);
        }, { passive: true, signal });

        const finishPointer = (event) => {
          if (!pointerStart) return;

          const deltaX = event.clientX - pointerStart.x;
          const deltaY = event.clientY - pointerStart.y;
          const elapsed = performance.now() - pointerStart.time;

          pointerStart = null;
          pointerDelta = 0;
          root.style.setProperty('--tjs-focus-drag-x', '0px');
          viewport.classList.remove('is-dragging');

          const isSwipe = Math.abs(deltaX) > 38 && Math.abs(deltaX) > Math.abs(deltaY) * 1.12 && elapsed < 1000;

          if (isSwipe) {
            suppressClick = true;
            move(deltaX < 0 ? 1 : -1, true);
            window.setTimeout(() => { suppressClick = false; }, 80);
          } else {
            startAutoplay();
          }
        };

        viewport.addEventListener('pointerup', finishPointer, { passive: true, signal });

        viewport.addEventListener('click', (event) => {
          if (!suppressClick) return;

          event.preventDefault();
          event.stopPropagation();
          suppressClick = false;
        }, { capture: true, signal });

        viewport.addEventListener('pointercancel', () => {
          if (!pointerStart) return;

          pointerStart = null;
          root.style.setProperty('--tjs-focus-drag-x', '0px');
          viewport.classList.remove('is-dragging');
          startAutoplay();
        }, { signal });
      }

      root.addEventListener('mouseenter', stopAutoplay, { signal });
      root.addEventListener('mouseleave', startAutoplay, { signal });
      root.addEventListener('focusin', stopAutoplay, { signal });
      root.addEventListener('focusout', (event) => {
        if (!root.contains(event.relatedTarget)) startAutoplay();
      }, { signal });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
      }, { signal });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      }, { signal });

      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver((entries) => {
          inViewport = entries[0]?.isIntersecting ?? true;
          if (inViewport) startAutoplay();
          else stopAutoplay();
        }, { threshold: 0.12 });

        observer.observe(root);
      }

      document.addEventListener('shopify:block:select', stopAutoplay, { signal });

      updateSlots(false);
      startAutoplay();

      root.tjsFeaturedFocusDestroy = () => {
        stopAutoplay();
        if (observer) observer.disconnect();
        if (modal && !modal.hidden) closeModal();
        controller.abort();
      };
    };

    initialise(document.querySelector(selector));

    document.addEventListener('shopify:section:load', (event) => {
      initialise(event.target.querySelector(selector));
    });

    document.addEventListener('shopify:section:unload', (event) => {
      const root = event.target.querySelector(selector);
      if (root && typeof root.tjsFeaturedFocusDestroy === 'function') root.tjsFeaturedFocusDestroy();
    });
  })();
</script>

