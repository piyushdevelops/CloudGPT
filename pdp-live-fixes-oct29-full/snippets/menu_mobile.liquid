<script>
  document.addEventListener('DOMContentLoaded', function () {
    var slider = document.querySelector('[data-tjs-menu-slider]');

    if (slider) {
      var slides = slider.querySelectorAll('.tjs-menu-banner-slide');
      var dots = slider.querySelectorAll('[data-slide-dot]');
      var currentSlide = 0;

      function showSlide(index) {
        if (!slides.length) return;

        currentSlide = index;

        slides.forEach(function (slide, slideIndex) {
          slide.classList.toggle('is-active', slideIndex === currentSlide);
        });

        dots.forEach(function (dot, dotIndex) {
          dot.classList.toggle('is-active', dotIndex === currentSlide);
        });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          var index = parseInt(dot.getAttribute('data-slide-dot'), 10);
          showSlide(index);
        });
      });

      if (slides.length > 1) {
        setInterval(function () {
          var nextSlide = currentSlide + 1 >= slides.length ? 0 : currentSlide + 1;
          showSlide(nextSlide);
        }, 3500);
      }

      showSlide(0);
    }

    var nav = document.getElementById('sub-hdt-nav-mb');
    if (!nav) return;

    var tabPanels = nav.querySelectorAll('.hdt-mobile-tab-panel');

    tabPanels.forEach(function (panel) {
      if (panel.getAttribute('data-tab-panel') === 'menu') {
        panel.style.display = 'block';
      } else {
        panel.style.display = 'none';
      }
    });

    var otherContent = nav.querySelector('.hdt-mobile-other-content');
    if (otherContent) {
      otherContent.style.display = '';
    }
  });
</script>
