{%- liquid
	assign menu_mobile = section.settings.main_menu_mobile | default: section.settings.main_menu | default: linklists.theme_brands
  assign menu_categories = section.settings.menu_categories
	if section.settings.only_click_icon
		assign only_click_icon = 'only-click-icon'
	else
		assign only_click_icon = ''
	endif
-%}
{%- if menu_mobile != blank -%}
	{%- liquid
		if request.design_mode or search.terms == "submenu" or section.index == null
			assign lazyMn = false
		else
			assign lazyMn = section.settings.lazy_mn
		endif
	-%}

	{%- if lazyMn -%}
		<hdt-lazy-submenu id="sub-hdt-nav-mb"{% if key_brand != blank %} key="{{ key_brand }}"{%- endif %} data-section="{{ section.id }}"></hdt-lazy-submenu>
	{%- else -%}
		<nav id="sub-hdt-nav-mb" class="hdt-navigation hdt-navigation-mobile hdt-menu-uppercase-{{ section.settings.text_transform }} hdt-current-scrollbar" >
      
      <div class="tjs-mobile-menu-top">
  <a href="/search" class="tjs-mobile-search">
    <span>Search The June Shop</span>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
      <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </a>

  <div class="tjs-menu-banner-slider" data-tjs-menu-slider>
    <a href="/collections/undated-yearly-planners" class="tjs-menu-banner-slide is-active">
      <img src="https://cdn.shopify.com/s/files/1/0177/5579/9606/files/ChatGPT_Image_May_22_2026_08_59_42_PM.png?v=1779464577" alt="Undated Yearly Planners">
    </a>

    <a href="/collections/glassware" class="tjs-menu-banner-slide">
      <img src="https://cdn.shopify.com/s/files/1/0177/5579/9606/files/ChatGPT_Image_May_22_2026_09_19_21_PM.png?v=1779464981" alt="Glassware">
    </a>

    <a href="/collections/lunch-bags-boxes" class="tjs-menu-banner-slide">
      <img src="https://cdn.shopify.com/s/files/1/0177/5579/9606/files/ChatGPT_Image_May_22_2026_09_26_54_PM.png?v=1779465432" alt="Lunch Boxes & Bags">
    </a>

    <div class="tjs-menu-banner-dots">
      <button type="button" class="is-active" data-slide-dot="0"></button>
      <button type="button" data-slide-dot="1"></button>
      <button type="button" data-slide-dot="2"></button>
    </div>
  </div>

  <a href="/collections/all" class="tjs-menu-feature-card">
    <span>Brands</span>
    <span>›</span>
  </a>
</div>
      {%- if section.settings.show_menu_mb -%}
