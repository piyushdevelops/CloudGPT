{%- liquid
  assign preorder_tag = 'June-Preorder-2027'
  assign is_preorder = false
  if product.tags contains preorder_tag
    assign is_preorder = true
  endif
  assign variants_share_sku = false
  if product.variants.size > 1 and product.variants.first.sku != blank and product.variants.first.sku == product.variants.last.sku
    assign variants_share_sku = true
  endif
  assign preorder_available_at = '2026-11-10T00:00:00+05:30'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@id": {{ canonical_url | append: '#product-group' | json }},
  "@type": "ProductGroup",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | strip_newlines | json }},
  "url": {{ canonical_url | json }},
  "productGroupID": {{ product.id | append: '' | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: shop.name | json }}
  },
  "category": "Dated Planners",
  "variesBy": ["https://schema.org/additionalProperty"],
  "image": [
    {%- for image in product.images limit: 8 -%}
      {{ image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "hasVariant": [
    {%- for variant in product.variants -%}
      {
        "@id": {{ shop.url | append: variant.url | append: '#product' | json }},
        "@type": "Product",
        "name": {{ product.title | append: ' — ' | append: variant.title | json }},
        "description": {{ product.description | strip_html | strip_newlines | json }},
        "url": {{ shop.url | append: variant.url | json }},
        "isVariantOf": {
          "@id": {{ canonical_url | append: '#product-group' | json }}
        },
        "additionalProperty": [{
          "@type": "PropertyValue",
          "name": {{ product.options_with_values.first.name | default: 'Planner option' | json }},
          "value": {{ variant.title | json }}
        }],
        {%- if variant.sku != blank and variants_share_sku == false %}
          "sku": {{ variant.sku | json }},
        {%- endif %}
        {%- if variant.barcode != blank %}
          "gtin": {{ variant.barcode | json }},
        {%- endif %}
        "image": {{ variant.image | default: product.featured_image | image_url: width: 1600 | prepend: 'https:' | json }},
        "offers": {
          "@type": "Offer",
          "url": {{ shop.url | append: variant.url | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ shop.currency | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "https://schema.org/{% if is_preorder %}PreOrder{% elsif variant.available %}InStock{% else %}OutOfStock{% endif %}",
          {%- if is_preorder %}
            "availabilityStarts": {{ preorder_available_at | json }},
          {%- endif %}
          "seller": {
            "@type": "Organization",
            "name": {{ shop.name | json }}
          }
        }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

