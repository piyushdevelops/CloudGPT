{% doc %}
  Renders the quantity-based planner bag while preserving the header cart link.
  @param {number} cart_count - Total units in the cart.
  @param {object} header_settings - Header appearance and motion controls.
{% enddoc %}
{% liquid
  assign mood = 0
  if cart_count >= 4
    assign mood = 3
  elsif cart_count >= 2
    assign mood = 2
  elsif cart_count == 1
    assign mood = 1
  endif
%}
<june-happy-cart data-count="{{ cart_count }}" data-mood="{{ mood }}" data-motion="{{ header_settings.june_happy_cart_motion }}" aria-hidden="true" style="--jhc-mobile-size:{{ header_settings.june_happy_cart_mobile_size | default: 24 }}px;--jhc-desktop-size:{{ header_settings.june_happy_cart_desktop_size | default: 24 }}px;--jhc-body:{{ header_settings.june_happy_cart_body | default: '#929292' }};--jhc-accent:{{ header_settings.june_happy_cart_accent | default: '#BFAEE9' }}">
<span data-jhc-state="0" {% unless mood == 0 %}hidden{% endunless %}><svg style="width:100%!important;height:100%!important;animation:none!important" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 34" aria-hidden="true"><g class="shell"><path d="M16 10h5q5 0 5.5 5l.5 11q.5 5-5 5h-6Z" fill="#171717"/><path d="M10 10h8q4 0 4.5 5l.5 11q.3 5-4 5H9q-4.3 0-4-5l.5-11Q6 10 10 10Z" fill="var(--jhc-body)"/><path d="M9.5 12.5c.5 3.7 7.5 3.7 8 0" fill="none" stroke="#171717" stroke-width="2" stroke-linecap="round"/></g><g class="expression" fill="#171717"></g></svg></span>
<span data-jhc-state="1" {% unless mood == 1 %}hidden{% endunless %}><svg style="width:100%!important;height:100%!important;animation:none!important" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 34" aria-hidden="true"><g class="contents"><rect x="10" y="4" width="9" height="15" rx="1.4" fill="var(--jhc-accent)" stroke="#171717" stroke-width="1.3" transform="rotate(-8 14 14)"/><path d="m12 5 1.5 10" stroke="#171717" stroke-width="1.2"/></g><g class="shell"><path d="M16 10h6q5 0 5.5 5l.6 11q.5 5-5 5H16Z" fill="#171717"/><path d="M9 10h9q4.5 0 5 5l.7 11q.3 5-4.5 5H8q-4.8 0-4.3-5l.8-11Q5 10 9 10Z" fill="var(--jhc-body)"/><path d="M9.5 12.5c.5 3.7 7.5 3.7 8 0" fill="none" stroke="#171717" stroke-width="2" stroke-linecap="round"/></g><g class="expression" fill="#171717"><ellipse cx="9.5" cy="21.5" rx="1.05" ry="1.3"/><ellipse cx="17.5" cy="21.5" rx="1.05" ry="1.3"/><path d="M10.5 25c1.3 2.4 4.7 2.4 6 0" fill="none" stroke="#171717" stroke-width="1.7" stroke-linecap="round"/></g></svg></span>
<span data-jhc-state="2" {% unless mood == 2 %}hidden{% endunless %}><svg style="width:100%!important;height:100%!important;animation:none!important" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 34" aria-hidden="true"><g class="contents"><rect x="16" y="3" width="9" height="16" rx="1.4" fill="#f4f0e7" stroke="#171717" stroke-width="1.3" transform="rotate(10 20 14)"/><rect x="7" y="4" width="10" height="15" rx="1.4" fill="var(--jhc-accent)" stroke="#171717" stroke-width="1.3" transform="rotate(-10 12 14)"/><path d="m10 5 1.5 10" stroke="#171717" stroke-width="1.2"/></g><g class="shell"><path d="M16 10h7q5 0 5.5 5l.7 11q.5 5-5 5H16Z" fill="#171717"/><path d="M8 10h11q4.5 0 5 5l1 11q.5 5-5 5H7q-5 0-4.5-5l1-11Q4 10 8 10Z" fill="var(--jhc-body)"/><path d="M9.5 12.5c.5 3.7 7.5 3.7 8 0" fill="none" stroke="#171717" stroke-width="2" stroke-linecap="round"/></g><g class="expression" fill="#171717"><ellipse cx="9" cy="21" rx="1.1" ry="1.35"/><ellipse cx="18" cy="21" rx="1.1" ry="1.35"/><path d="M9.5 24.5c1.4 4.2 6.6 4.2 8 0" fill="none" stroke="#171717" stroke-width="1.8" stroke-linecap="round"/></g></svg></span>
<span data-jhc-state="3" {% unless mood == 3 %}hidden{% endunless %}><svg style="width:100%!important;height:100%!important;animation:none!important" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 34" aria-hidden="true"><g class="contents"><rect x="16" y="3" width="10" height="16" rx="1.4" fill="#f4f0e7" stroke="#171717" stroke-width="1.3" transform="rotate(12 21 14)"/><rect x="6" y="3" width="11" height="16" rx="1.4" fill="var(--jhc-accent)" stroke="#171717" stroke-width="1.3" transform="rotate(-12 12 14)"/><path d="m9 4 2 11" stroke="#171717" stroke-width="1.2"/></g><g class="shell"><path d="M16 10h8q5 0 5.5 5l1 10.5Q31 31 25 31h-9Z" fill="var(--jhc-accent)"/><path d="M7.5 10h12q4.5 0 5 5l1 10.5Q26 31 20 31H6.5Q1 31 1.5 25.5l1-10.5q.5-5 5-5Z" fill="var(--jhc-body)"/><path d="M9.5 12.5c.5 3.7 7.5 3.7 8 0" fill="none" stroke="#171717" stroke-width="2" stroke-linecap="round"/></g><g class="expression" fill="#171717"><path d="M7.5 21.8c.5-2 2.8-2 3.3-.2m5.4 0c.5-1.8 2.8-1.8 3.3.2" fill="none" stroke="#171717" stroke-width="1.7" stroke-linecap="round"/><path d="M9.5 24.5q4 1.5 8 0c-.5 5.5-7.5 5.5-8 0Z"/></g></svg></span>
</june-happy-cart>
