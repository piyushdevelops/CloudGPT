blend-mode:screen;\n}\n\n.tjs-game-disc.spin{\n  animation:tjs-disc-spin 1.1s cubic-bezier(.2,.8,.2,1) forwards;\n}\n\n@keyframes tjs-disc-spin{\n  0%{transform:rotate(0deg) scale(1);}\n  70%{transform:rotate(860deg) scale(1.08);}\n  100%{transform:rotate(1080deg) scale(1);}\n}\n\n.tjs-game-disc-inner{\n  width:72px;\n  aspect-ratio:1/1;\n  background:\n    radial-gradient(circle at 35% 22%,var(--june-surface,#F5F5F3) 0 12%,transparent 13%),\n    linear-gradient(135deg,var(--june-surface,#F5F5F3),var(--june-surface,#F5F5F3) 45%,var(--june-surface,#F5F5F3));\n  border-radius:50%;\n  display:flex;\n  flex-direction:column;\n  justify-content:center;\n  align-items:center;\n  text-align:center;\n  border:3px solid var(--june-ink,#171717);\n  z-index:4;\n  box-shadow:\n    inset 0 2px 8px rgba(255,255,255,.45),\n    inset 0 -8px 12px rgba(0,0,0,.22),\n    0 4px 10px rgba(0,0,0,.35);\n}\n\n.tjs-game-main{\n  font-family:Impact,Arial Black,sans-serif;\n  font-size:31px;\n  line-height:.85;\n  color:var(--june-ink,#171717);\n}\n\n.tjs-game-small{\n  font-family:Impact,Arial Black,sans-serif;\n  font-size:12px;\n  letter-spacing:.08em;\n  color:var(--june-ink,#171717);\n}\n\n/* BUTTON + SUBTEXT */\n.tjs-game-action{\n  width:100%;\n  max-width:145px;\n  text-align:center;\n}\n\n.tjs-game-btn{\n  width:100%;\n  text-align:center;\n  border:2px dashed rgba(23,23,23,.38);\n  color:currentColor;\n  padding:10px;\n  border-radius:10px;\n  font-family:Impact,Arial Black,sans-serif;\n  font-size:13px;\n  letter-spacing:.09em;\n  cursor:pointer;\n  background:transparent;\n  position:relative;\n  overflow:visible;\n}\n\n.tjs-game-btn.unlocked{\n  background:var(--june-accent,#F56A28);\n  color:var(--june-on-accent,var(--june-ink,#171717));\n  border-color:var(--june-border,#DADADA);\n}\n\n.tjs-game-cart-note{\n  display:none;\n  margin-top:5px;\n  font-size:10px;\n  font-weight:800;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n  color:rgba(255,255,255,.62);\n}\n\n.tjs-game-cart-note.show{\n  display:block;\n}\n\n.tjs-burst{\n  position:absolute;\n  left:50%;\n  top:50%;\n  transform:translate(-50%,-50%);\n  pointer-events:none;\n  font-size:11px;\n  font-weight:900;\n  color:currentColor;\n  background:var(--june-surface,#F5F5F3);\n  border-radius:999px;\n  padding:3px 7px;\n  white-space:nowrap;\n  animation:tjs-burst .9s ease-out forwards;\n  z-index:20;\n}\n\n@keyframes tjs-burst{\n  0%{opacity:0;transform:translate(-50%,-50%) scale(.5);}\n  20%{opacity:1;}\n  100%{\n    opacity:0;\n    transform:translate(calc(-50% + var(--x)),calc(-50% + var(--y))) scale(1.2) rotate(8deg);\n  }\n}\n\n@media(max-width:768px){\n  .tjs-game-inner{\n    grid-template-columns:1fr;\n  }\n\n  .tjs-game-right{\n    flex-direction:row;\n    justify-content:space-between;\n    width:100%;\n    background:rgba(255,255,255,.04);\n    border:1px solid rgba(255,255,255,.07);\n    border-radius:14px;\n    padding:10px;\n  }\n\n  .tjs-game-disc{\n    width:92px;\n    flex-shrink:0;\n  }\n\n  .tjs-game-disc-inner{\n    width:60px;\n  }\n\n  .tjs-game-main{\n    font-size:25px;\n  }\n\n  .tjs-game-small{\n    font-size:10px;\n  }\n\n  .tjs-game-action{\n    flex:1;\n    max-width:none;\n    margin-left:12px;\n  }\n\n  .tjs-game-btn{\n    padding:13px 8px;\n  }\n\n  .tjs-game-pointer{\n    left:43px;\n    top:-8px;\n  }\n}\n\n@media(max-width:420px){\n  .tjs-game-inner{padding:13px;}\n  .tjs-game-title{font-size:26px;}\n  .tjs-game-sub{font-size:12px;}\n\n  .tjs-game-points{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n  }\n\n  .tjs-game-pill{\n    justify-content:center;\n    text-align:center;\n    font-size:10.5px;\n  }\n\n  .tjs-game-pill:nth-child(3){\n    grid-column:1/-1;\n  }\n}\n</style>\n\n<div class=\"tjs-game-box\">\n  <div class=\"tjs-game-inner\">\n\n    <div>\n      <div class=\"tjs-game-eyebrow\">Tap To Unlock Your Deal</div>\n\n      <div class=\"tjs-game-title\">\n        <span class=\"pink\">SPIN IT.</span><br>\n        <span class=\"yellow\">UNLOCK 50% OFF.</span>\n      </div>\n\n      <div class=\"tjs-game-sub\">\n        Your clearance deal is already waiting — tap the disc to activate the fun.\n      </div>\n\n      <div class=\"tjs-game-points\">\n        <div class=\"tjs-game-pill\">🚚 Free Shipping</div>\n        <div class=\"tjs-game-pill\">⚡ Auto Applied</div>\n        <div class=\"tjs-game-pill\">🔒 Secure Checkout</div>\n      </div>\n    </div>\n\n    <div class=\"tjs-game-right\">\n\n      <div class=\"tjs-game-pointer\"></div>\n\n      <div class=\"tjs-game-disc\" id=\"tjs-spin-disc\">\n        <div class=\"tjs-game-disc-inner\">\n          <div class=\"tjs-game-main\">50%</div>\n          <div class=\"tjs-game-small\">OFF</div>\n        </div>\n      </div>\n\n      <div class=\"tjs-game-action\">\n        <button class=\"tjs-game-btn\" id=\"tjs-spin-btn\" type=\"button\">\n          TAP TO UNLOCK\n        </button>\n        <div class=\"tjs-game-cart-note\" id=\"tjs-cart-note\">\n          Just Add To Cart\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function(){\n  var disc=document.getElementById('tjs-spin-disc');\n  var btn=document.getElementById('tjs-spin-btn');\n  var note=document.getElementById('tjs-cart-note');\n\n  if(!disc || !btn || !note) return;\n\n  function burst(){\n    var labels=['UNLOCKED','50% OFF','YAY','SAVED','ADDED'];\n    for(var i=0;i<40;i++){\n      var el=document.createElement('span');\n      el.className='tjs-burst';\n      el.innerText=labels[i%labels.length];\n\n      el.style.setProperty('--x',(Math.random()*500-205)+'px');\n      el.style.setProperty('--y',(-Math.random()*500-5)+'px');\n\n      btn.appendChild(el);\n\n      setTimeout(function(e){\n        if(e && e.parentNode) e.parentNode.removeChild(e);\n      },900,el);\n    }\n  }\n\n  function unlock(){\n    if(disc.classList.contains('spin')) return;\n\n    btn.innerText='SPINNING...';\n    btn.classList.remove('unlocked');\n    note.classList.remove('show');\n\n    disc.classList.add('spin');\n\n    setTimeout(function(){\n      btn.innerText='Activated✓';\n      btn.classList.add('unlocked');\n      note.classList.add('show');\n      burst();\n    },1050);\n\n    setTimeout(function(){\n      disc.classList.remove('spin');\n    },1250);\n  }\n\n  disc.addEventListener('click',unlock);\n  btn.addEventListener('click',unlock);\n})();\n</script>"
