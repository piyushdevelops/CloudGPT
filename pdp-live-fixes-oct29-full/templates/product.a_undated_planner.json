              "name": "Custom liquid",
              "settings": {
                "liquid": "<style>\n  .tjs-planner-atc-wrap {\n    margin: 18px 0 16px;\n    font-family: inherit;\n  }\n\n  .tjs-planner-atc-row {\n    display: flex;\n    align-items: stretch;\n    gap: 10px;\n    width: 100%;\n    max-width: 520px;\n  }\n\n  .tjs-planner-atc-btn {\n    position: relative;\n    flex: 1;\n    min-height: 52px;\n    border: 0;\n    border-radius: 999px;\n    background: var(--june-accent,#F56A28);\n    color: var(--june-on-accent,var(--june-ink,#171717));\n    font-size: 14px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.25px;\n    cursor: pointer;\n    overflow: hidden;\n    box-shadow:\n      0 12px 24px rgba(47, 36, 32, 0.18),\n      inset 0 1px 0 rgba(255, 255, 255, 0.16);\n    transition: transform 0.22s ease, box-shadow 0.22s ease, opacity 0.22s ease;\n  }\n\n  .tjs-planner-atc-btn:hover {\n    transform: translateY(-1px);\n    box-shadow:\n      0 16px 30px rgba(47, 36, 32, 0.22),\n      inset 0 1px 0 rgba(255, 255, 255, 0.18);\n  }\n\n  .tjs-planner-atc-btn:active {\n    transform: translateY(0) scale(0.99);\n  }\n\n  .tjs-planner-atc-btn::before {\n    content: \"\";\n    position: absolute;\n    top: -70%;\n    left: -35%;\n    width: 70px;\n    height: 240%;\n    background: linear-gradient(\n      110deg,\n      transparent 0%,\n      rgba(255, 255, 255, 0.18) 35%,\n      rgba(255, 255, 255, 0.7) 50%,\n      rgba(255, 255, 255, 0.16) 65%,\n      transparent 100%\n    );\n    transform: rotate(18deg);\n    animation: tjsAtcSheen 4.6s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsAtcSheen {\n    0% {\n      left: -40%;\n      opacity: 0;\n    }\n    16% {\n      opacity: 0.85;\n    }\n    34% {\n      left: 115%;\n      opacity: 0;\n    }\n    100% {\n      left: 115%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-planner-atc-btn__inner {\n    position: relative;\n    z-index: 1;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n  }\n\n  .tjs-planner-atc-btn__icon {\n    font-size: 14px;\n    color: currentColor;\n    animation: tjsAtcSparkle 2.2s ease-in-out infinite;\n  }\n\n  @keyframes tjsAtcSparkle {\n    0%, 100% {\n      transform: scale(0.85) rotate(0deg);\n      opacity: 0.7;\n    }\n    45% {\n      transform: scale(1.2) rotate(18deg);\n      opacity: 1;\n    }\n  }\n\n  .tjs-planner-fav-btn {\n    position: relative;\n    width: 54px;\n    min-width: 54px;\n    min-height: 52px;\n    border-radius: 50%;\n    border: 1px solid rgba(23,23,23, 0.55);\n    background: var(--june-accent,#F56A28);\n    color: var(--june-on-accent,var(--june-ink,#171717));\n    cursor: pointer;\n    display: inline-grid;\n    place-items: center;\n    box-shadow: 0 8px 18px rgba(47, 36, 32, 0.08);\n    transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;\n  }\n\n  .tjs-planner-fav-btn:hover {\n    transform: translateY(-1px);\n    border-color: rgba(23,23,23, 0.62);\n    box-shadow: 0 12px 24px rgba(47, 36, 32, 0.12);\n  }\n\n  .tjs-planner-fav-btn svg {\n    width: 21px;\n    height: 21px;\n    display: block;\n    stroke: currentColor;\n    stroke-width: 2;\n    fill: transparent;\n    transition: fill 0.22s ease, transform 0.22s ease, color 0.22s ease;\n  }\n\n  .tjs-planner-fav-btn.is-active {\n    background: var(--june-accent,#F56A28);\n    border-color: rgba(23,23,23, 0.55);\n    color: var(--june-on-accent,var(--june-ink,#171717));\n  }\n\n  .tjs-planner-fav-btn.is-active svg {\n    fill: currentColor;\n    transform: scale(1.08);\n  }\n\n  .tjs-planner-fav-btn.is-active::after {\n    content: \"Saved\";\n    position: absolute;\n    top: -28px;\n    left: 50%;\n    transform: translateX(-50%);\n    padding: 5px 8px;\n    border-radius: 999px;\n    background: rgba(47, 36, 32, 0.9);\n    color: var(--june-on-dark,#FFFFFF);\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 800;\n    white-space: nowrap;\n    animation: tjsFavBubble 1.4s ease forwards;\n    pointer-events: none;\n  }\n\n  @keyframes tjsFavBubble {\n    0% {\n      opacity: 0;\n      transform: translateX(-50%) translateY(5px);\n    }\n    18%, 72% {\n      opacity: 1;\n      transform: translateX(-50%) translateY(0);\n    }\n    100% {\n      opacity: 0;\n      transform: translateX(-50%) translateY(-4px);\n    }\n  }\n\n  .tjs-planner-atc-subnote {\n    margin-top: 9px;\n    max-width: 520px;\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    font-size: 11.5px;\n    line-height: 1.4;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-planner-atc-subnote::before {\n    content: \"✦\";\n    color: currentColor;\n    font-size: 9px;\n  }\n\n  .tjs-planner-atc-btn.is-loading {\n    pointer-events: none;\n    opacity: 0.82;\n  }\n\n  .tjs-planner-atc-btn.is-loading .tjs-planner-atc-btn__text {\n    opacity: 0;\n  }\n\n  .tjs-planner-atc-btn.is-loading .tjs-planner-atc-btn__inner::after {\n    content: \"Adding...\";\n    position: absolute;\n    left: 50%;\n    transform: translateX(-50%);\n    white-space: nowrap;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-planner-atc-wrap {\n      margin: 17px 0 15px;\n    }\n\n    .tjs-planner-atc-row {\n      max-width: 100%;\n      gap: 9px;\n    }\n\n    .tjs-planner-atc-btn {\n      min-height: 50px;\n      font-size: 13.5px;\n    }\n\n    .tjs-planner-fav-btn {\n      width: 50px;\n      min-width: 50px;\n      min-height: 50px;\n    }\n\n    .tjs-planner-fav-btn svg {\n      width: 20px;\n      height: 20px;\n    }\n\n    .tjs-planner-atc-subnote {\n      justify-content: center;\n      text-align: center;\n      font-size: 11px;\n    }\n  }\n</style>\n\n<div class=\"tjs-planner-atc-wrap\" data-tjs-atc-wrap>\n  <div class=\"tjs-planner-atc-row\">\n    <button type=\"button\" class=\"tjs-planner-atc-btn\" data-tjs-custom-atc>\n      <span class=\"tjs-planner-atc-btn__inner\">\n        <span class=\"tjs-planner-atc-btn__icon\">✦</span>\n        <span class=\"tjs-planner-atc-btn__text\">Add to Cart</span>\n      </span>\n    </button>\n\n    <button type=\"button\" class=\"tjs-planner-fav-btn\" data-tjs-fav-btn aria-label=\"Add to favourites\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M20.84 4.61c-1.54-1.38-3.93-1.28-5.34.23L12 8.58 8.5 4.84C7.09 3.33 4.7 3.23 3.16 4.61c-1.77 1.59-1.86 4.3-.21 6l8.2 8.46c.47.49 1.23.49 1.7 0l8.2-8.46c1.65-1.7 1.56-4.41-.21-6z\"></path>\n      </svg>\n    </button>\n  </div>\n\n  <div class=\"tjs-planner-atc-subnote\">\n    Free Ultimate Sticker Book included with your planner\n  </div>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const atcWrap = document.querySelector(\"[data-tjs-atc-wrap]\");\n    if (!atcWrap) return;\n\n    const customAtcBtn = atcWrap.querySelector(\"[data-tjs-custom-atc]\");\n    const favBtn = atcWrap.querySelector(\"[data-tjs-fav-btn]\");\n\n    const productForm =\n      atcWrap.closest(\"section\")?.querySelector('form[action*=\"/cart/add\"]') ||\n      document.querySelector('form[action*=\"/cart/add\"]');\n\n    if (!productForm) return;\n\n    const productHandle = \"{{ product.handle }}\";\n    const favStorageKey = \"tjs_favourite_\" + productHandle;\n\n    function syncFavouriteState() {\n      if (localStorage.getItem(favStorageKey) === \"true\") {\n        favBtn.classList.add(\"is-active\");\n        favBtn.setAttribute(\"aria-label\", \"Remove from favourites\");\n      } else {\n        favBtn.classList.remove(\"is-active\");\n        favBtn.setAttribute(\"aria-label\", \"Add to favourites\");\n      }\n    }\n\n    syncFavouriteState();\n\n    favBtn.addEventListener(\"click\", function () {\n      const isActive = favBtn.classList.contains(\"is-active\");\n\n      if (isActive) {\n        localStorage.removeItem(favStorageKey);\n      } else {\n        localStorage.setItem(favStorageKey, \"true\");\n      }\n\n      syncFavouriteState();\n    });\n\n    customAtcBtn.addEventListener(\"click\", function () {\n      customAtcBtn.classList.add(\"is-loading\");\n\n      const nativeSubmit =\n        productForm.querySelector('[type=\"submit\"]') ||\n        productForm.querySelector('button[name=\"add\"]');\n\n      if (nativeSubmit) {\n        nativeSubmit.click();\n      } else {\n        productForm.requestSubmit();\n      }\n\n      setTimeout(function () {\n        customAtcBtn.classList.remove(\"is-loading\");\n      }, 1400);\n    });\n  });\n</script>"
