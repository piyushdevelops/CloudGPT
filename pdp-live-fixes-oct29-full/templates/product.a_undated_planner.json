                "liquid": "<style>\n  .tjs-planner-tagline-wrap {\n    margin: 8px 0 16px;\n    font-family: inherit;\n  }\n\n  .tjs-planner-tagline {\n    position: relative;\n    display: inline-block;\n    max-width: 520px;\n    font-size: 18px;\n    line-height: 1.45;\n    color: var(--june-ink,#171717);\n    font-weight: 500;\n    letter-spacing: -0.2px;\n  }\n\n  .tjs-planner-tagline strong {\n    color: currentColor;\n    font-weight: 700;\n  }\n\n  .tjs-planner-tagline::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    bottom: -7px;\n    width: 72px;\n    height: 2px;\n    border-radius: 999px;\n    background: linear-gradient(90deg, var(--june-surface,#F5F5F3), var(--june-surface,#F5F5F3), transparent);\n  }\n\n  .tjs-planner-subline {\n    margin-top: 16px;\n    max-width: 540px;\n    font-size: 13.5px;\n    line-height: 1.6;\n    color: var(--june-muted,#656565);\n    font-weight: 400;\n  }\n\n  .tjs-planner-subline span {\n    color: currentColor;\n    font-weight: 600;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-planner-tagline-wrap {\n      margin: 8px 0 14px;\n      text-align: center;\n    }\n\n    .tjs-planner-tagline {\n      font-size: 16px;\n      line-height: 1.45;\n      max-width: 100%;\n    }\n\n    .tjs-planner-tagline::after {\n      left: 50%;\n      transform: translateX(-50%);\n      width: 64px;\n      bottom: -8px;\n    }\n\n    .tjs-planner-subline {\n      margin: 16px auto 0;\n      font-size: 12.5px;\n      line-height: 1.55;\n      max-width: 92%;\n    }\n  }\n</style>\n\n<div class=\"tjs-planner-tagline-wrap\">\n  <div class=\"tjs-planner-tagline\">\n    The planner that starts <strong>whenever you do.</strong>\n  </div>\n\n  <div class=\"tjs-planner-subline\">\n    An undated life planner made for goals, routines, dreams, affirmations, travel plans, reflections, and everyday main-character moments.\n  </div>\n</div>"
              },
