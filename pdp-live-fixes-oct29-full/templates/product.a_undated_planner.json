    "custom_liquid_hcMjrd": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": true,
        "custom_liquid": "{% assign sticker_image_url = \"https://thejuneshop.com/cdn/shop/files/zUnDatedStickerbook_ab559cc7-53d1-4a0e-bd1a-17e04575d710.gif?v=1697707538&width=990\" %}\n\n<style>\n  .tjs-sticker-real-section {\n    position: relative;\n    margin: 40px 0;\n    padding: 44px 18px;\n    font-family: inherit;\n    overflow: hidden;\n    border-radius: 34px;\n    background:\n      radial-gradient(circle at 12% 16%, rgba(23,23,23, 0.48), transparent 27%),\n      radial-gradient(circle at 86% 20%, rgba(23,23,23, 0.48), transparent 30%),\n      radial-gradient(circle at 50% 100%, rgba(220, 238, 222, 0.42), transparent 34%),\n      linear-gradient(135deg, var(--june-bg,#FFFFFF) 0%, var(--june-bg,#FFFFFF) 48%, var(--june-bg,#FFFFFF) 100%);\n    border: 1px solid rgba(23,23,23, 0.32);\n  }\n\n  .tjs-sticker-real-section::before {\n    content: \"\";\n    position: absolute;\n    inset: -40%;\n    background:\n      radial-gradient(circle, rgba(255,255,255,0.56) 0 1px, transparent 2px) 0 0 / 36px 36px,\n      linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.35) 48%, transparent 60%);\n    animation: tjsStickerBgDrift 16s linear infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsStickerBgDrift {\n    0% {\n      transform: translate3d(-2%, -2%, 0) rotate(0deg);\n    }\n    100% {\n      transform: translate3d(2%, 2%, 0) rotate(3deg);\n    }\n  }\n\n  .tjs-sticker-real-container {\n    position: relative;\n    z-index: 1;\n    max-width: 1180px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1.05fr 0.95fr;\n    gap: 24px;\n    align-items: stretch;\n  }\n\n  .tjs-sticker-real-visual {\n    position: relative;\n    min-height: 540px;\n    border-radius: 34px;\n    overflow: hidden;\n    background: var(--june-bg,#FFFFFF);\n    border: 1px solid rgba(23,23,23,0.38);\n    box-shadow: 0 20px 42px rgba(47,36,32,0.08);\n  }\n\n  .tjs-sticker-real-image-wrap {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: var(--june-bg,#FFFFFF);\n  }\n\n  .tjs-sticker-real-image {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .tjs-sticker-real-image-wrap::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(\n      115deg,\n      transparent 0%,\n      transparent 38%,\n      rgba(255,255,255,0.42) 48%,\n      transparent 58%,\n      transparent 100%\n    );\n    transform: translateX(-120%);\n    animation: tjsStickerImageShine 4.6s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsStickerImageShine {\n    0%, 45% {\n      transform: translateX(-120%);\n      opacity: 0;\n    }\n    58% {\n      opacity: 1;\n    }\n    76%, 100% {\n      transform: translateX(120%);\n      opacity: 0;\n    }\n  }\n\n  .tjs-sticker-float-chip {\n    position: absolute;\n    z-index: 4;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 70px;\n    height: 42px;\n    padding: 0 14px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.82);\n    border: 1px solid rgba(23,23,23,0.42);\n    color: currentColor;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 900;\n    box-shadow: 0 14px 26px rgba(47,36,32,0.12);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    animation: tjsStickerChipFloat 4.2s ease-in-out infinite;\n  }\n\n  .tjs-sticker-float-chip.one {\n    left: 24px;\n    top: 24px;\n    transform: rotate(-9deg);\n  }\n\n  .tjs-sticker-float-chip.two {\n    right: 24px;\n    top: 28px;\n    min-width: 52px;\n    width: 52px;\n    height: 52px;\n    padding: 0;\n    font-size: 18px;\n    animation-delay: 0.8s;\n  }\n\n  .tjs-sticker-float-chip.three {\n    right: 26px;\n    bottom: 28px;\n    transform: rotate(8deg);\n    animation-delay: 1.4s;\n  }\n\n  .tjs-sticker-float-chip.four {\n    left: 26px;\n    bottom: 28px;\n    min-width: 52px;\n    width: 52px;\n    height: 52px;\n    padding: 0;\n    font-size: 18px;\n    animation-delay: 2s;\n  }\n\n  @keyframes tjsStickerChipFloat {\n    0%, 100% {\n      translate: 0 0;\n    }\n    50% {\n      translate: 0 -12px;\n    }\n  }\n\n  .tjs-sticker-real-content {\n    position: relative;\n    overflow: hidden;\n    border-radius: 34px;\n    padding: 34px;\n    background: rgba(255,255,255,0.66);\n    border: 1px solid rgba(23,23,23,0.38);\n    box-shadow: 0 20px 42px rgba(47,36,32,0.07);\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n  }\n\n  .tjs-sticker-real-content::before {\n    content: \"\";\n    position: absolute;\n    top: -80%;\n    left: -50%;\n    width: 120px;\n    height: 260%;\n    background: linear-gradient(110deg, transparent, rgba(255,255,255,0.72), transparent);\n    transform: rotate(18deg);\n    animation: tjsStickerPanelShine 6s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsStickerPanelShine {\n    0% {\n      left: -55%;\n      opacity: 0;\n    }\n    14% {\n      opacity: 0.65;\n    }\n    32% {\n      left: 120%;\n      opacity: 0;\n    }\n    100% {\n      left: 120%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-sticker-real-content-inner {\n    position: relative;\n    z-index: 1;\n  }\n\n  .tjs-sticker-real-kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    margin-bottom: 13px;\n    padding: 8px 12px;\n    border-radius: 999px;\n    background: rgba(255, 244, 239, 0.94);\n    border: 1px solid rgba(23,23,23,0.38);\n    color: currentColor;\n    font-size: 10px;\n    line-height: 1;\n    letter-spacing: 1.2px;\n    text-transform: uppercase;\n    font-weight: 900;\n  }\n\n  .tjs-sticker-real-kicker::before {\n    content: \"FREE\";\n    display: inline-grid;\n    place-items: center;\n    height: 20px;\n    padding: 0 8px;\n    border-radius: 999px;\n    background: var(--june-dark,#171717);\n    color: var(--june-on-dark,#FFFFFF);\n    font-size: 8px;\n    letter-spacing: 0.7px;\n  }\n\n  .tjs-sticker-real-title {\n    margin: 0;\n    font-size: clamp(32px, 3.8vw, 56px);\n    line-height: 0.98;\n    letter-spacing: -1.8px;\n    color: var(--june-ink,#171717);\n    font-weight: 950;\n  }\n\n  .tjs-sticker-real-title span {\n    display: inline-block;\n    background: linear-gradient(115deg, var(--june-surface,#F5F5F3), var(--june-surface,#F5F5F3), var(--june-surface,#F5F5F3), var(--june-surface,#F5F5F3));\n    background-size: 260% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    animation: tjsStickerGoldFlow 4s ease-in-out infinite;\n  }\n\n  @keyframes tjsStickerGoldFlow {\n    0%, 100% {\n      background-position: 100% 0;\n    }\n    50% {\n      background-position: 0 0;\n    }\n  }\n\n  .tjs-sticker-real-text {\n    margin-top: 15px;\n    font-size: 14px;\n    line-height: 1.72;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-sticker-real-stats {\n    margin-top: 24px;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 10px;\n  }\n\n  .tjs-sticker-real-stat {\n    min-height: 112px;\n    padding: 16px 12px;\n    border-radius: 24px;\n    background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(255,247,243,0.74));\n    border: 1px solid rgba(23,23,23,0.34);\n    box-shadow: 0 12px 24px rgba(47,36,32,0.05);\n  }\n\n  .tjs-sticker-real-stat-number {\n    font-size: 30px;\n    line-height: 1;\n    color: currentColor;\n    font-weight: 950;\n    letter-spacing: -1px;\n  }\n\n  .tjs-sticker-real-stat-label {\n    margin-top: 8px;\n    font-size: 11px;\n    line-height: 1.35;\n    color: var(--june-muted,#656565);\n    font-weight: 750;\n  }\n\n  .tjs-sticker-real-unlock {\n    margin-top: 22px;\n    padding: 15px 16px;\n    border-radius: 24px;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: var(--june-on-dark,#FFFFFF);\n    box-shadow: 0 16px 30px rgba(47,36,32,0.16);\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .tjs-sticker-real-unlock-icon {\n    width: 42px;\n    height: 42px;\n    min-width: 42px;\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    background: var(--june-bg,#FFFFFF);\n    color: currentColor;\n    font-size: 18px;\n    animation: tjsStickerGiftPulse 2s ease-in-out infinite;\n  }\n\n  @keyframes tjsStickerGiftPulse {\n    0%, 100% {\n      transform: scale(1);\n    }\n    50% {\n      transform: scale(1.08) rotate(-4deg);\n    }\n  }\n\n  .tjs-sticker-real-unlock-title {\n    font-size: 13px;\n    line-height: 1.25;\n    font-weight: 950;\n  }\n\n  .tjs-sticker-real-unlock-text {\n    margin-top: 3px;\n    font-size: 11px;\n    line-height: 1.35;\n    color: rgba(255,249,243,0.75);\n    font-weight: 600;\n  }\n\n  @media screen and (max-width: 989px) {\n    .tjs-sticker-real-container {\n      grid-template-columns: 1fr;\n    }\n\n    .tjs-sticker-real-visual {\n      min-height: 520px;\n    }\n\n    .tjs-sticker-real-content {\n      text-align: center;\n    }\n\n    .tjs-sticker-real-unlock {\n      text-align: left;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-sticker-real-section {\n      margin: 28px -4px;\n      padding: 30px 12px;\n      border-radius: 26px;\n    }\n\n    .tjs-sticker-real-container {\n      gap: 14px;\n    }\n\n    .tjs-sticker-real-visual {\n      min-height: 380px;\n      border-radius: 24px;\n    }\n\n    .tjs-sticker-float-chip {\n      font-size: 9.5px;\n      height: 34px;\n      min-width: 48px;\n      padding: 0 10px;\n    }\n\n    .tjs-sticker-float-chip.one {\n      left: 12px;\n      top: 12px;\n    }\n\n    .tjs-sticker-float-chip.two {\n      right: 12px;\n      top: 14px;\n      width: 44px;\n      height: 44px;\n      min-width: 44px;\n      font-size: 15px;\n    }\n\n    .tjs-sticker-float-chip.three {\n      right: 12px;\n      bottom: 14px;\n    }\n\n    .tjs-sticker-float-chip.four {\n      left: 12px;\n      bottom: 14px;\n      width: 44px;\n      height: 44px;\n      min-width: 44px;\n      font-size: 15px;\n    }\n\n    .tjs-sticker-real-content {\n      padding: 24px 16px;\n      border-radius: 24px;\n    }\n\n    .tjs-sticker-real-title {\n      font-size: 34px;\n      line-height: 1;\n    }\n\n    .tjs-sticker-real-text {\n      font-size: 12.7px;\n      line-height: 1.6;\n    }\n\n    .tjs-sticker-real-stats {\n      gap: 8px;\n      margin-top: 18px;\n    }\n\n    .tjs-sticker-real-stat {\n      min-height: 100px;\n      padding: 14px 8px;\n      border-radius: 18px;\n    }\n\n    .tjs-sticker-real-stat-number {\n      font-size: 23px;\n    }\n\n    .tjs-sticker-real-stat-label {\n      font-size: 9.8px;\n    }\n\n    .tjs-sticker-real-unlock {\n      padding: 13px;\n      border-radius: 20px;\n    }\n\n    .tjs-sticker-real-unlock-icon {\n      width: 38px;\n      height: 38px;\n      min-width: 38px;\n    }\n  }\n</style>\n\n<section class=\"tjs-sticker-real-section\">\n  <div class=\"tjs-sticker-real-container\">\n    <div class=\"tjs-sticker-real-visual\">\n      <div class=\"tjs-sticker-float-chip one\">Goals</div>\n      <div class=\"tjs-sticker-float-chip two\">♡</div>\n\n      <div class=\"tjs-sticker-real-image-wrap\">\n        <img\n          class=\"tjs-sticker-real-image\"\n          src=\"{{ sticker_image_url }}\"\n          alt=\"The Ultimate Sticker Book\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"tjs-sticker-float-chip three\">Mood</div>\n      <div class=\"tjs-sticker-float-chip four\">✦</div>\n    </div>\n\n    <div class=\"tjs-sticker-real-content\">\n      <div class=\"tjs-sticker-real-content-inner\">\n        <div class=\"tjs-sticker-real-kicker\">Included With This Planner</div>\n\n        <h2 class=\"tjs-sticker-real-title\">\n          Peel. Stick. <span>Romanticise Everything.</span>\n        </h2>\n\n        <div class=\"tjs-sticker-real-text\">\n          Your planner comes with The Ultimate Sticker Book — packed with fun, expressive stickers for moods, memories, reminders, goals, habits and every tiny main-character moment.\n        </div>\n\n        <div class=\"tjs-sticker-real-stats\">\n          <div class=\"tjs-sticker-real-stat\">\n            <div class=\"tjs-sticker-real-stat-number\">8</div>\n            <div class=\"tjs-sticker-real-stat-label\">Pages of stickers</div>\n          </div>\n\n          <div class=\"tjs-sticker-real-stat\">\n            <div class=\"tjs-sticker-real-stat-number\">200+</div>\n            <div class=\"tjs-sticker-real-stat-label\">Unique & fun stickers</div>\n          </div>\n\n          <div class=\"tjs-sticker-real-stat\">\n            <div class=\"tjs-sticker-real-stat-number\">Peel</div>\n            <div class=\"tjs-sticker-real-stat-label\">& stick instantly</div>\n          </div>\n        </div>\n\n        <div class=\"tjs-sticker-real-unlock\">\n          <div class=\"tjs-sticker-real-unlock-icon\">✦</div>\n          <div>\n            <div class=\"tjs-sticker-real-unlock-title\">Automatically added with every planner</div>\n            <div class=\"tjs-sticker-real-unlock-text\">No code. No extra step. Your sticker book comes free.</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
