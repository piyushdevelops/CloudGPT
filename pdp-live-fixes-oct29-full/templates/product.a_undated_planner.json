              "settings": {
                "liquid": "<style>\n  .tjs-planner-usp-wrap {\n    margin: 16px 0 20px;\n    font-family: inherit;\n  }\n\n  .tjs-planner-usp-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 9px;\n    max-width: 520px;\n  }\n\n  .tjs-planner-usp-card {\n    position: relative;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-height: 64px;\n    padding: 11px 12px;\n    border-radius: 17px;\n    background: linear-gradient(135deg, var(--june-bg,#FFFFFF) 0%, var(--june-bg,#FFFFFF) 100%);\n    border: 1px solid rgba(23,23,23, 0.42);\n    box-shadow: 0 8px 18px rgba(47, 36, 32, 0.055);\n  }\n\n  .tjs-planner-usp-card::before {\n    content: \"\";\n    position: absolute;\n    top: -70%;\n    left: -45%;\n    width: 52px;\n    height: 220%;\n    background: linear-gradient(\n      110deg,\n      transparent,\n      rgba(255, 255, 255, 0.65),\n      transparent\n    );\n    transform: rotate(18deg);\n    animation: tjsUspSheen 5.2s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  .tjs-planner-usp-card:nth-child(2)::before {\n    animation-delay: 0.6s;\n  }\n\n  .tjs-planner-usp-card:nth-child(3)::before {\n    animation-delay: 1.2s;\n  }\n\n  .tjs-planner-usp-card:nth-child(4)::before {\n    animation-delay: 1.8s;\n  }\n\n  @keyframes tjsUspSheen {\n    0% {\n      left: -45%;\n      opacity: 0;\n    }\n    14% {\n      opacity: 0.7;\n    }\n    31% {\n      left: 120%;\n      opacity: 0;\n    }\n    100% {\n      left: 120%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-planner-usp-icon {\n    position: relative;\n    z-index: 1;\n    width: 36px;\n    height: 36px;\n    min-width: 36px;\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: currentColor;\n    box-shadow: 0 8px 16px rgba(47, 36, 32, 0.12);\n  }\n\n  .tjs-planner-usp-icon svg {\n    width: 18px;\n    height: 18px;\n    stroke: currentColor;\n    stroke-width: 1.9;\n    fill: none;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .tjs-planner-usp-card:hover .tjs-planner-usp-icon {\n    animation: tjsUspIconPop 0.36s ease;\n  }\n\n  @keyframes tjsUspIconPop {\n    0% {\n      transform: scale(1);\n    }\n    45% {\n      transform: scale(1.08) rotate(-4deg);\n    }\n    100% {\n      transform: scale(1);\n    }\n  }\n\n  .tjs-planner-usp-content {\n    position: relative;\n    z-index: 1;\n  }\n\n  .tjs-planner-usp-title {\n    font-size: 12.5px;\n    line-height: 1.2;\n    color: var(--june-ink,#171717);\n    font-weight: 850;\n    margin-bottom: 3px;\n  }\n\n  .tjs-planner-usp-text {\n    font-size: 11px;\n    line-height: 1.35;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-planner-usp-wrap {\n      margin: 15px 0 18px;\n    }\n\n    .tjs-planner-usp-grid {\n      max-width: 100%;\n      gap: 8px;\n    }\n\n    .tjs-planner-usp-card {\n      min-height: 62px;\n      padding: 10px;\n      border-radius: 15px;\n      gap: 8px;\n    }\n\n    .tjs-planner-usp-icon {\n      width: 32px;\n      height: 32px;\n      min-width: 32px;\n    }\n\n    .tjs-planner-usp-icon svg {\n      width: 16px;\n      height: 16px;\n    }\n\n    .tjs-planner-usp-title {\n      font-size: 11.5px;\n    }\n\n    .tjs-planner-usp-text {\n      font-size: 10.2px;\n    }\n  }\n</style>\n\n<div class=\"tjs-planner-usp-wrap\">\n  <div class=\"tjs-planner-usp-grid\">\n\n    <div class=\"tjs-planner-usp-card\">\n      <div class=\"tjs-planner-usp-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M4 19.5V5.8C4 4.8 4.8 4 5.8 4h12.4C19.2 4 20 4.8 20 5.8v13.7\"/>\n          <path d=\"M4 19.5c0-1 0.8-1.8 1.8-1.8h14.2\"/>\n          <path d=\"M8 8h8\"/>\n          <path d=\"M8 11h6\"/>\n        </svg>\n      </div>\n      <div class=\"tjs-planner-usp-content\">\n   