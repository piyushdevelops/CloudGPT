    "custom_liquid_QkpCAp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": true,
        "custom_liquid": "<style>\n  .tjs-main-character-section {\n    margin: 36px 0;\n    padding: 38px 18px;\n    font-family: inherit;\n    background:\n      radial-gradient(circle at top left, rgba(255, 238, 231, 0.95), transparent 34%),\n      radial-gradient(circle at bottom right, rgba(255, 247, 239, 0.95), transparent 34%),\n      linear-gradient(135deg, var(--june-bg,#FFFFFF) 0%, var(--june-bg,#FFFFFF) 100%);\n    border-radius: 30px;\n    border: 1px solid rgba(23,23,23, 0.28);\n    overflow: hidden;\n  }\n\n  .tjs-main-character-container {\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  .tjs-main-character-head {\n    max-width: 760px;\n    margin: 0 auto 28px;\n    text-align: center;\n  }\n\n  .tjs-main-character-kicker {\n    margin-bottom: 9px;\n    font-size: 10.5px;\n    line-height: 1;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n    color: currentColor;\n    font-weight: 850;\n  }\n\n  .tjs-main-character-title {\n    margin: 0;\n    font-size: clamp(28px, 3.2vw, 44px);\n    line-height: 1.08;\n    letter-spacing: -1px;\n    color: var(--june-ink,#171717);\n    font-weight: 850;\n  }\n\n  .tjs-main-character-title span {\n    position: relative;\n    display: inline-block;\n    color: currentColor;\n  }\n\n  .tjs-main-character-title span::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    bottom: 4px;\n    width: 100%;\n    height: 8px;\n    border-radius: 999px;\n    background: rgba(23,23,23, 0.65);\n    z-index: -1;\n  }\n\n  .tjs-main-character-subtitle {\n    max-width: 650px;\n    margin: 13px auto 0;\n    font-size: 14px;\n    line-height: 1.7;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-main-character-tabs {\n    display: flex;\n    gap: 8px;\n    justify-content: center;\n    flex-wrap: wrap;\n    margin: 0 auto 22px;\n  }\n\n  .tjs-main-character-tab {\n    border: 1px solid rgba(23,23,23, 0.42);\n    background: rgba(255, 255, 255, 0.74);\n    color: var(--june-muted,#656565);\n    padding: 10px 14px;\n    border-radius: 999px;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 800;\n    cursor: pointer;\n    transition: all 0.22s ease;\n    font-family: inherit;\n  }\n\n  .tjs-main-character-tab:hover {\n    transform: translateY(-1px);\n    border-color: rgba(23,23,23, 0.42);\n    color: var(--june-ink,#171717);\n    box-shadow: 0 8px 18px rgba(47, 36, 32, 0.06);\n  }\n\n  .tjs-main-character-tab.is-active {\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: var(--june-on-dark,#FFFFFF);\n    border-color: var(--june-ink,#171717);\n    box-shadow: 0 9px 20px rgba(47, 36, 32, 0.14);\n  }\n\n  .tjs-main-character-layout {\n    display: grid;\n    grid-template-columns: 0.86fr 1.14fr;\n    gap: 22px;\n    align-items: stretch;\n  }\n\n  .tjs-main-character-visual {\n    position: relative;\n    overflow: hidden;\n    min-height: 470px;\n    border-radius: 26px;\n    background: var(--june-bg,#FFFFFF);\n    border: 1px solid rgba(23,23,23, 0.35);\n    box-shadow: 0 14px 30px rgba(47, 36, 32, 0.06);\n  }\n\n  .tjs-main-character-image {\n    width: 100%;\n    height: 100%;\n    min-height: 470px;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .tjs-main-character-panel {\n    position: relative;\n    overflow: hidden;\n    border-radius: 26px;\n    background: rgba(255, 255, 255, 0.78);\n    border: 1px solid rgba(23,23,23, 0.34);\n    box-shadow: 0 14px 30px rgba(47, 36, 32, 0.055);\n    padding: 24px;\n  }\n\n  .tjs-main-character-panel::before {\n    content: \"\";\n    position: absolute;\n    top: -75%;\n    left: -35%;\n    width: 86px;\n    height: 240%;\n    background: linear-gradient(110deg, transparent, rgba(255, 255, 255, 0.68), transparent);\n    transform: rotate(18deg);\n    animation: tjsMcSheen 6s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsMcSheen {\n    0% { left: -40%; opacity: 0; }\n    14% { opacity: 0.7; }\n    32%, 100% { left: 115%; opacity: 0; }\n  }\n\n  .tjs-main-character-pane {\n    display: none;\n    position: relative;\n    z-index: 1;\n  }\n\n  .tjs-main-character-pane.is-active {\n    display: block;\n    animation: tjsMcPaneReveal 0.28s ease;\n  }\n\n  @keyframes tjsMcPaneReveal {\n    from { opacity: 0; transform: translateY(5px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  .tjs-main-character-pane-head {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    margin-bottom: 18px;\n  }\n\n  .tjs-main-character-pane-icon {\n    width: 46px;\n    height: 46px;\n    min-width: 46px;\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: currentColor;\n    box-shadow: 0 9px 18px rgba(47, 36, 32, 0.14);\n  }\n\n  .tjs-main-character-pane-icon svg {\n    width: 22px;\n    height: 22px;\n    stroke: currentColor;\n    stroke-width: 1.9;\n    fill: none;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .tjs-main-character-pane-title {\n    margin: 0;\n    font-size: 24px;\n    line-height: 1.1;\n    letter-spacing: -0.5px;\n    color: var(--june-ink,#171717);\n    font-weight: 850;\n  }\n\n  .tjs-main-character-pane-subtitle {\n    margin-top: 5px;\n    font-size: 13px;\n    line-height: 1.5;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-main-character-list {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 9px;\n  }\n\n  .tjs-main-character-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 8px;\n    padding: 11px;\n    border-radius: 15px;\n    background: var(--june-bg,#FFFFFF);\n    border: 1px solid rgba(23,23,23, 0.28);\n    color: var(--june-ink,#171717);\n    font-size: 12.5px;\n    line-height: 1.35;\n    font-weight: 700;\n  }\n\n  .tjs-main-character-item::before {\n    content: \"✦\";\n    color: currentColor;\n    font-size: 9px;\n    line-height: 1.7;\n    flex-shrink: 0;\n  }\n\n  .tjs-main-character-foot {\n    margin-top: 16px;\n    padding-top: 15px;\n    border-top: 1px solid rgba(23,23,23, 0.3);\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n\n  .tjs-main-character-pill {\n    padding: 7px 10px;\n    border-radius: 999px;\n    background: rgba(255, 244, 239, 0.92);\n    border: 1px solid rgba(23,23,23, 0.34);\n    color: currentColor;\n    font-size: 10.5px;\n    line-height: 1;\n    font-weight: 850;\n  }\n\n  @media screen and (max-width: 989px) {\n    .tjs-main-character-layout {\n      grid-template-columns: 1fr;\n    }\n\n    .tjs-main-character-visual,\n    .tjs-main-character-image {\n      min-height: 360px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-main-character-section {\n      margin: 28px -4px;\n      padding: 28px 12px;\n      border-radius: 24px;\n    }\n\n    .tjs-main-character-head {\n      margin-bottom: 20px;\n    }\n\n    .tjs-main-character-kicker {\n      font-size: 9.5px;\n      letter-spacing: 1.2px;\n    }\n\n    .tjs-main-character-title {\n      font-size: 28px;\n      line-height: 1.08;\n    }\n\n    .tjs-main-character-subtitle {\n      font-size: 12.5px;\n      line-height: 1.58;\n      max-width: 94%;\n    }\n\n    .tjs-main-character-tabs {\n      justify-content: flex-start;\n      flex-wrap: nowrap;\n      overflow-x: auto;\n      padding: 2px 2px 8px;\n      margin-bottom: 14px;\n      scrollbar-width: none;\n      -webkit-overflow-scrolling: touch;\n    }\n\n    .tjs-main-character-tabs::-webkit-scrollbar {\n      display: none;\n    }\n\n    .tjs-main-character-tab {\n      flex: 0 0 auto;\n      font-size: 11px;\n      padding: 10px 12px;\n    }\n\n    .tjs-main-character-layout {\n      gap: 14px;\n    }\n\n    .tjs-main-character-visual {\n      border-radius: 22px;\n      min-height: 250px;\n    }\n\n    .tjs-main-character-image {\n      min-height: 250px;\n      border-radius: 22px;\n    }\n\n    .tjs-main-character-panel {\n      padding: 16px;\n      border-radius: 22px;\n    }\n\n    .tjs-main-character-pane-head {\n      flex-direction: column;\n      text-align: center;\n      gap: 10px;\n      margin-bottom: 15px;\n    }\n\n    .tjs-main-character-pane-icon {\n      width: 42px;\n      height: 42px;\n      min-width: 42px;\n    }\n\n    .tjs-main-character-pane-icon svg {\n      width: 20px;\n      height: 20px;\n    }\n\n    .tjs-main-character-pane-title {\n      font-size: 21px;\n    }\n\n    .tjs-main-character-pane-subtitle {\n      font-size: 12.2px;\n    }\n\n    .tjs-main-character-list {\n      grid-template-columns: 1fr;\n      gap: 8px;\n    }\n\n    .tjs-main-character-item {\n      padding: 10px 11px;\n      font-size: 12px;\n    }\n\n    .tjs-main-character-foot {\n      justify-content: center;\n    }\n  }\n</style>\n\n<section class=\"tjs-main-character-section\" data-tjs-main-character>\n  <div class=\"tjs-main-character-container\">\n    <div class=\"tjs-main-character-head\">\n      <div class=\"tjs-main-character-kicker\">Everything You Need To</div>\n      <h2 class=\"tjs-main-character-title\">\n        Plan, Dream &amp; <span>Reset</span>\n      </h2>\n      <div class=\"tjs-main-character-subtitle\">\n        Your undated planner is a canvas for your evolving story — no perfect date needed. Start scripting your goals, routines, memories and main-character moments, your way.\n      </div>\n    </div>\n\n    <div class=\"tjs-main-character-tabs\" role=\"tablist\">\n      <button class=\"tjs-main-character-tab is-active\" type=\"button\" data-tjs-mc-tab=\"dream\">Dream & Direction</button>\n      <button class=\"tjs-main-character-tab\" type=\"button\" data-tjs-mc-tab=\"monthly\">Monthly Reset</button>\n      <button class=\"tjs-main-character-tab\" type=\"button\" data-tjs-mc-tab=\"wellness\">Routine & Wellness</button>\n      <button class=\"tjs-main-character-tab\" type=\"button\" data-tjs-mc-tab=\"everyday\">Everyday Planning</button>\n      <button class=\"tjs-main-character-tab\" type=\"button\" data-tjs-mc-tab=\"memory\">Memory & Life Admin</button>\n    </div>\n\n    <div class=\"tjs-main-character-layout\">\n      <div class=\"tjs-main-character-visual\">\n        <img\n          class=\"tjs-main-character-image\"\n          src=\"https://cdn.shopify.com/s/files/1/0177/5579/9606/files/ChatGPT_Image_May_23_2026_01_16_47_PM.png?v=1779522466\"\n          alt=\"Undated Planner\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"tjs-main-character-panel\">\n        <div class=\"tjs-main-character-pane is-active\" data-tjs-mc-pane=\"dream\">\n          <div class=\"tjs-main-character-pane-head\">\n            <div class=\"tjs-main-character-pane-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M12 3l2.4 5.1L20 9l-4 4 1 5.8L12 16l-5 2.8L8 13 4 9l5.6-.9L12 3z\"/>\n              </svg>\n            </div>\n            <div>\n              <h3 class=\"tjs-main-character-pane-title\">Dream & Direction</h3>\n              <div class=\"tjs-main-character-pane-subtitle\">For the big-picture pages that help you understand what you actually want.</div>\n            </div>\n          </div>\n\n          <div class=\"tjs-main-character-list\">\n            <div class=\"tjs-main-character-item\">Bucket List</div>\n            <div class=\"tjs-main-character-item\">Vision Board</div>\n            <div class=\"tjs-main-character-item\">Goals for the Year</div>\n            <div class=\"tjs-main-character-item\">Ikigai Worksheet</div>\n            <div class=\"tjs-main-character-item\">Mind-storming Spread</div>\n            <div class=\"tjs-main-character-item\">Your Dream’s Voice Spread</div>\n            <div class=\"tjs-main-character-item\">Win Your Life Spread</div>\n            <div class=\"tjs-main-character-item\">Highlight of the Year Spread</div>\n          </div>\n\n          <div class=\"tjs-main-character-foot\">\n            <span class=\"tjs-main-character-pill\">Goal Setting</span>\n            <span class=\"tjs-main-character-pill\">Self Discovery</span>\n            <span class=\"tjs-main-character-pill\">Fresh Starts</span>\n          </div>\n        </div>\n\n        <div class=\"tjs-main-character-pane\" data-tjs-mc-pane=\"monthly\">\n          <div class=\"tjs-main-character-pane-head\">\n            <div class=\"tjs-main-character-pane-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M7 3v3\"/>\n                <path d=\"M17 3v3\"/>\n                <path d=\"M4 8h16\"/>\n                <path d=\"M5 5h14v15H5z\"/>\n                <path d=\"M8 12h3\"/>\n                <path d=\"M13 12h3\"/>\n                <path d=\"M8 16h3\"/>\n              </svg>\n            </div>\n            <div>\n              <h3 class=\"tjs-main-character-pane-title\">Monthly Main Character Reset</h3>\n              <div class=\"tjs-main-character-pane-subtitle\">Each month gets its own mood, intention, reflection and little main-character moment.</div>\n            </div>\n          </div>\n\n          <div class=\"tjs-main-character-list\">\n            <div class=\"tjs-main-character-item\">12 Main Character Trait Illustrations</div>\n            <div class=\"tjs-main-character-item\">Monthly Affirmations</div>\n            <div class=\"tjs-main-character-item\">Illustrated Monthly Dividers</div>\n            <div class=\"tjs-main-character-item\">Spotify Codes for Curated Songs</div>\n            <div class=\"tjs-main-character-item\">Monthly Intentions</div>\n            <div class=\"tjs-main-character-item\">Experience List Spread</div>\n            <div class=\"tjs-main-character-item\">Monthly Goals Spread</div>\n            <div class=\"tjs-main-character-item\">Monthly Reflection Spread</div>\n          </div>\n\n          <div class=\"tjs-main-character-foot\">\n            <span class=\"tjs-main-character-pill\">12 Months</span>\n            <span class=\"tjs-main-character-pill\">Affirmations</span>\n            <span class=\"tjs-main-character-pill\">Spotify Codes</span>\n          </div>\n        </div>\n\n        <div class=\"tjs-main-character-pane\" data-tjs-mc-pane=\"wellness\">\n          <div class=\"tjs-main-character-pane-head\">\n            <div class=\"tjs-main-character-pane-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z\"/>\n              </svg>\n            </div>\n            <div>\n              <h3 class=\"tjs-main-character-pane-title\">Routine & Wellness</h3>\n              <div class=\"tjs-main-character-pane-subtitle\">For tracking the small habits, resets and self-care moments that make life feel lighter.</div>\n            </div>\n          </div>\n\n          <div class=\"tjs-main-character-list\">\n            <div class=\"tjs-main-character-item\">Morning Routine</div>\n            <div class=\"tjs-main-character-item\">Night Routine</div>\n            <div class=\"tjs-main-character-item\">Habit Tracker</div>\n            <div class=\"tjs-main-character-item\">Health Tracker</div>\n            <div class=\"tjs-main-character-item\">Period Tracker</div>\n            <div class=\"tjs-main-character-item\">Gratitude Spread</div>\n            <div class=\"tjs-main-character-item\">De-Stress Colouring Spread</div>\n            <div class=\"tjs-main-character-item\">Notes Pages Every Month</div>\n          </div>\n\n          <div class=\"tjs-main-character-foot\">\n            <span class=\"tjs-main-character-pill\">Wellness</span>\n            <span class=\"tjs-main-character-pill\">Routines</span>\n            <span class=\"tjs-main-character-pill\">Self-Care</span>\n          </div>\n        </div>\n\n        <div class=\"tjs-main-character-pane\" data-tjs-mc-pane=\"everyday\">\n          <div class=\"tjs-main-character-pane-head\">\n            <div class=\"tjs-main-character-pane-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M8 6h13\"/>\n                <path d=\"M8 12h13\"/>\n                <path d=\"M8 18h13\"/>\n                <path d=\"M3 6l1 1 2-2\"/>\n                <path d=\"M3 12l1 1 2-2\"/>\n                <path d=\"M3 18l1 1 2-2\"/>\n              </svg>\n            </div>\n            <div>\n              <h3 class=\"tjs-main-character-pane-title\">Everyday Planning</h3>\n              <div class=\"tjs-main-character-pane-subtitle\">For weekly plans, daily priorities, tiny wins and lessons that keep your days moving.</div>\n            </div>\n          </div>\n\n          <div class=\"tjs-main-character-list\">\n            <div class=\"tjs-main-character-item\">Weekly Spread</div>\n            <div class=\"tjs-main-character-item\">Day-to-Day To-Do List</div>\n            <div class=\"tjs-main-character-item\">Priorities</div>\n            <div class=\"tjs-main-character-item\">Wins and Lessons</div>\n            <div class=\"tjs-main-character-item\">Expense Tracker</div>\n            <div class=\"tjs-main-character-item\">Monthly Notes Pages</div>\n            <div class=\"tjs-main-character-item\">Back Notes Pages</div>\n            <div class=\"tjs-main-character-item\">Plans You Can Start Anytime</div>\n          </div>\n\n          <div class=\"tjs-main-character-foot\">\n            <span class=\"tjs-main-character-pill\">Weekly Planning</span>\n            <span class=\"tjs-main-character-pill\">To-Do Lists</span>\n            <span class=\"tjs-main-character-pill\">Priorities</span>\n          </div>\n        </div>\n\n        <div class=\"tjs-main-character-pane\" data-tjs-mc-pane=\"memory\">\n          <div class=\"tjs-main-character-pane-head\">\n            <div class=\"tjs-main-character-pane-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M4 19.5V5.8C4 4.8 4.8 4 5.8 4h12.4C19.2 4 20 4.8 20 5.8v13.7\"/>\n                <path d=\"M4 19.5c0-1 0.8-1.8 1.8-1.8h14.2\"/>\n                <path d=\"M8 8h8\"/>\n                <path d=\"M8 11h6\"/>\n              </svg>\n            </div>\n            <div>\n              <h3 class=\"tjs-main-character-pane-title\">Memory & Life Admin</h3>\n              <div class=\"tjs-main-character-pane-subtitle\">For memories, practical details and the pieces of your year you’ll want to come back to.</div>\n            </div>\n          </div>\n\n          <div class=\"tjs-main-character-list\">\n            <div class=\"tjs-main-character-item\">Travel Packing Checklist</div>\n            <div class=\"tjs-main-character-item\">Password Manager</div>\n            <div class=\"tjs-main-character-item\">Letter From a Loved One Spread</div>\n            <div class=\"tjs-main-character-item\">Year-End Review Spread</div>\n            <div class=\"tjs-main-character-item\">Highlight of the Year Spread</div>\n            <div class=\"tjs-main-character-item\">Back Notes Pages</div>\n            <div class=\"tjs-main-character-item\">Keepsake-Friendly Planning</div>\n            <div class=\"tjs-main-character-item\">Your Story, Your Way</div>\n          </div>\n\n          <div class=\"tjs-main-character-foot\">\n            <span class=\"tjs-main-character-pill\">Memories</span>\n            <span class=\"tjs-main-character-pill\">Life Admin</span>\n            <span class=\"tjs-main-character-pill\">Year Review</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const section = document.querySelector(\"[data-tjs-main-character]\");\n    if (!section) return;\n\n    const tabs = section.querySelectorAll(\"[data-tjs-mc-tab]\");\n    const panes = section.querySelectorAll(\"[data-tjs-mc-pane]\");\n\n    tabs.forEach(function (tab) {\n      tab.addEventListener(\"click\", function () {\n        const target = tab.getAttribute(\"data-tjs-mc-tab\");\n\n        tabs.forEach(function (item) {\n          item.classList.remove(\"is-active\");\n        });\n\n        panes.forEach(function (pane) {\n          pane.classList.remove(\"is-active\");\n        });\n\n        tab.classList.add(\"is-active\");\n\n        const activePane = section.querySelector('[data-tjs-mc-pane=\"' + target + '\"]');\n        if (activePane) {\n          activePane.classList.add(\"is-active\");\n        }\n      });\n    });\n  });\n</script>",
