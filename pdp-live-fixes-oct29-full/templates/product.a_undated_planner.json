      "settings": {
        "section_fullwidth": true,
        "custom_liquid": "<style>\n  .tjs-version-section {\n    margin: 36px 0;\n    padding: 18px;\n    font-family: inherit;\n  }\n\n  .tjs-version-wrap {\n    max-width: 1180px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 0.95fr 1.05fr;\n    gap: 20px;\n    align-items: stretch;\n  }\n\n  .tjs-version-visual {\n    position: relative;\n    min-height: 420px;\n    border-radius: 30px;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 20% 18%, rgba(255,255,255,0.95), transparent 24%),\n      linear-gradient(135deg, var(--june-surface,#F5F5F3) 0%, var(--june-bg,#FFFFFF) 55%, var(--june-surface,#F5F5F3) 100%);\n    border: 1px solid rgba(23,23,23, 0.34);\n    box-shadow: 0 16px 34px rgba(47, 36, 32, 0.07);\n    display: grid;\n    place-items: center;\n    padding: 34px;\n  }\n\n  .tjs-version-visual::before {\n    content: \"\";\n    position: absolute;\n    width: 170px;\n    height: 170px;\n    right: -42px;\n    top: -42px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.42);\n  }\n\n  .tjs-version-visual::after {\n    content: \"No dates. No pressure. Just you.\";\n    position: absolute;\n    left: 22px;\n    bottom: 22px;\n    padding: 10px 13px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.74);\n    border: 1px solid rgba(23,23,23, 0.34);\n    color: currentColor;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    box-shadow: 0 8px 18px rgba(47, 36, 32, 0.06);\n    z-index: 3;\n  }\n\n  .tjs-version-image-wrap {\n    position: relative;\n    z-index: 2;\n    width: min(92%, 480px);\n    height: 100%;\n    display: grid;\n    place-items: center;\n  }\n\n  .tjs-version-image {\n    display: block;\n    width: 100%;\n    max-height: 360px;\n    object-fit: contain;\n    border-radius: 22px;\n    filter: drop-shadow(0 24px 30px rgba(23,23,23, 0.16));\n  }\n\n  .tjs-version-sparkle {\n    position: absolute;\n    color: currentColor;\n    font-size: 18px;\n    animation: tjsVersionSparkle 2.4s ease-in-out infinite;\n    z-index: 1;\n  }\n\n  .tjs-version-sparkle.one {\n    top: 38px;\n    left: 38px;\n  }\n\n  .tjs-version-sparkle.two {\n    right: 54px;\n    bottom: 92px;\n    animation-delay: 0.8s;\n  }\n\n  @keyframes tjsVersionSparkle {\n    0%, 100% {\n      opacity: 0.42;\n      transform: scale(0.8) rotate(0deg);\n    }\n    48% {\n      opacity: 1;\n      transform: scale(1.25) rotate(18deg);\n    }\n  }\n\n  .tjs-version-content {\n    border-radius: 30px;\n    padding: 34px;\n    background:\n      radial-gradient(circle at top right, rgba(255, 240, 234, 0.9), transparent 34%),\n      linear-gradient(135deg, var(--june-bg,#FFFFFF) 0%, var(--june-bg,#FFFFFF) 100%);\n    border: 1px solid rgba(23,23,23, 0.3);\n    box-shadow: 0 16px 34px rgba(47, 36, 32, 0.055);\n  }\n\n  .tjs-version-kicker {\n    margin-bottom: 10px;\n    font-size: 10.5px;\n    line-height: 1;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n    color: currentColor;\n    font-weight: 850;\n  }\n\n  .tjs-version-title {\n    margin: 0;\n    max-width: 620px;\n    font-size: clamp(28px, 3vw, 42px);\n    line-height: 1.08;\n    letter-spacing: -1px;\n    color: var(--june-ink,#171717);\n    font-weight: 850;\n  }\n\n  .tjs-version-title span {\n    color: currentColor;\n  }\n\n  .tjs-version-copy {\n    max-width: 610px;\n    margin-top: 14px;\n    font-size: 14px;\n    line-height: 1.75;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-version-script {\n    margin-top: 16px;\n    font-size: 16px;\n    line-height: 1.4;\n    color: currentColor;\n    font-weight: 750;\n    font-style: italic;\n  }\n\n  .tjs-version-cards {\n    margin-top: 22px;\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 10px;\n  }\n\n  .tjs-version-card {\n    position: relative;\n    overflow: hidden;\n    padding: 15px 14px;\n    border-radius: 18px;\n    background: rgba(255, 255, 255, 0.76);\n    border: 1px solid rgba(23,23,23, 0.32);\n    box-shadow: 0 9px 20px rgba(47, 36, 32, 0.045);\n    transition: transform 0.24s ease, box-shadow 0.24s ease;\n  }\n\n  .tjs-version-card:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 13px 25px rgba(47, 36, 32, 0.08);\n  }\n\n  .tjs-version-card-icon {\n    width: 36px;\n    height: 36px;\n    margin-bottom: 10px;\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: currentColor;\n    box-shadow: 0 8px 16px rgba(47, 36, 32, 0.12);\n  }\n\n  .tjs-version-card-icon svg {\n    width: 18px;\n    height: 18px;\n    stroke: currentColor;\n    stroke-width: 1.9;\n    fill: none;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .tjs-version-card-title {\n    font-size: 13px;\n    line-height: 1.25;\n    color: var(--june-ink,#171717);\n    font-weight: 850;\n    margin-bottom: 5px;\n  }\n\n  .tjs-version-card-text {\n    font-size: 11.5px;\n    line-height: 1.45;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  @media screen and (max-width: 989px) {\n    .tjs-version-wrap {\n      grid-template-columns: 1fr;\n    }\n\n    .tjs-version-visual {\n      min-height: 320px;\n      padding: 24px;\n    }\n\n    .tjs-version-image-wrap {\n      width: min(90%, 380px);\n    }\n\n    .tjs-version-image {\n      max-height: 270px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-version-section {\n      margin: 28px 0;\n      padding: 12px;\n    }\n\n    .tjs-version-wrap {\n      gap: 14px;\n    }\n\n    .tjs-version-visual,\n    .tjs-version-content {\n      border-radius: 24px;\n    }\n\n    .tjs-version-visual {\n      min-height: 280px;\n      padding: 18px;\n    }\n\n    .tjs-version-visual::after {\n      left: 14px;\n      bottom: 14px;\n      font-size: 10px;\n      padding: 9px 11px;\n    }\n\n    .tjs-version-image {\n      max-height: 230px;\n      border-radius: 18px;\n    }\n\n    .tjs-version-sparkle.one {\n      top: 22px;\n      left: 22px;\n    }\n\n    .tjs-version-sparkle.two {\n      right: 26px;\n      bottom: 62px;\n    }\n\n    .tjs-version-content {\n      padding: 22px 18px;\n    }\n\n    .tjs-version-kicker {\n      font-size: 9.5px;\n      letter-spacing: 1.2px;\n    }\n\n    .tjs-version-title {\n      font-size: 26px;\n      line-height: 1.1;\n    }\n\n    .tjs-version-copy {\n      font-size: 13px;\n      line-height: 1.7;\n    }\n\n    .tjs-version-script {\n      font-size: 15px;\n    }\n\n    .tjs-version-cards {\n      grid-template-columns: 1fr;\n      gap: 10px;\n    }\n  }\n</style>\n\n<section class=\"tjs-version-section\">\n  <div class=\"tjs-version-wrap\">\n    <div class=\"tjs-version-visual\">\n      <span class=\"tjs-version-sparkle one\">✦</span>\n      <span class=\"tjs-version-sparkle two\">✦</span>\n\n      <div class=\"tjs-version-image-wrap\">\n        <img\n          class=\"tjs-version-image\"\n          src=\"https://cdn.shopify.com/s/files/1/0177/5579/9606/files/ChatGPT_Image_May_23_2026_01_36_52_PM.png?v=1779524300\"\n          alt=\"Undated Planner\"\n          loading=\"lazy\"\n        >\n      </div>\n    </div>\n\n    <div class=\"tjs-version-content\">\n      <div class=\"tjs-version-kicker\">Designed for every version of you</div>\n\n      <h2 class=\"tjs-version-title\">\n        For the one who plans, dreams, resets &amp; starts <span>over beautifully.</span>\n      </h2>\n\n      <div class=\"tjs-version-copy\">\n        No fixed dates. No pressure. Just a planner that moves with your life — whether you’re building routines, chasing goals, tracking your mood, planning your travels, or simply trying to feel a little more put together every day.\n      </div>\n\n      <div class=\"tjs-version-script\">\n        Start today. Restart tomorrow. Make it yours.\n      </div>\n\n      <div class=\"tjs-version-cards\">\n        <div class=\"tjs-version-card\">\n          <div class=\"tjs-version-card-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M8 4h8\"></path>\n              <path d=\"M9 2v4\"></path>\n              <path d=\"M15 2v4\"></path>\n              <rect x=\"4\" y=\"6\" width=\"16\" height=\"14\" rx=\"2\"></rect>\n              <path d=\"M8 11h8\"></path>\n              <path d=\"M8 15h5\"></path>\n            </svg>\n          </div>\n          <div class=\"tjs-version-card-title\">Start Anytime</div>\n          <div class=\"tjs-version-card-text\">\n            Completely undated, so your planner begins when you do.\n          </div>\n        </div>\n\n        <div class=\"tjs-version-card\">\n          <div class=\"tjs-version-card-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M4 19h16\"></path>\n              <path d=\"M7 16V9\"></path>\n              <path d=\"M12 16V5\"></path>\n              <path d=\"M17 16v-7\"></path>\n            </svg>\n          </div>\n          <div class=\"tjs-version-card-title\">Plan Your Goals</div>\n          <div class=\"tjs-version-card-text\">\n            Vision boards, yearly goals, monthly goals and weekly priorities.\n          </div>\n        </div>\n\n        <div class=\"tjs-version-card\">\n          <div class=\"tjs-version-card-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z\"></path>\n            </svg>\n          </div>\n          <div class=\"tjs-version-card-title\">Romanticise Routine</div>\n          <div class=\"tjs-version-card-text\">\n            Morning, night, gratitude, wellness and habit tracking.\n          </div>\n        </div>\n\n        <div class=\"tjs-version-card\">\n          <div class=\"tjs-version-card-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M20 12v7a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-7\"></path>\n              <path d=\"M2 7h20v5H2z\"></path>\n              <path d=\"M12 20V7\"></path>\n              <path d=\"M12 7H8.5a2.5 2.5 0 1 1 0-5c2.2 0 3.5 2 3.5 5z\"></path>\n              <path d=\"M12 7h3.5a2.5 2.5 0 1 0 0-5c-2.2 0-3.5 2-3.5 5z\"></path>\n            </svg>\n          </div>\n          <div class=\"tjs-version-card-title\">Make It Yours</div>\n          <div class=\"tjs-version-card-text\">\n            Stickers, notes, colouring spreads, affirmations and reflections.\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
