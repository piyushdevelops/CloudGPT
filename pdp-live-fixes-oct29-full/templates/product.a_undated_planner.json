padding: 8px 11px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.76);\n    border: 1px solid rgba(23,23,23,0.36);\n    color: currentColor;\n    font-size: 10.5px;\n    line-height: 1;\n    font-weight: 900;\n  }\n\n  .tjs-review-cards-wrap {\n    position: relative;\n    overflow: hidden;\n    border-radius: 34px;\n    padding: 24px;\n    background: rgba(255,255,255,0.68);\n    border: 1px solid rgba(23,23,23,0.38);\n    box-shadow: 0 20px 42px rgba(47,36,32,0.07);\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n  }\n\n  .tjs-review-cards-wrap::before {\n    content: \"\";\n    position: absolute;\n    top: -80%;\n    left: -50%;\n    width: 120px;\n    height: 260%;\n    background: linear-gradient(110deg, transparent, rgba(255,255,255,0.72), transparent);\n    transform: rotate(18deg);\n    animation: tjsReviewPanelShine 6s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsReviewPanelShine {\n    0% {\n      left: -55%;\n      opacity: 0;\n    }\n    14% {\n      opacity: 0.65;\n    }\n    32% {\n      left: 120%;\n      opacity: 0;\n    }\n    100% {\n      left: 120%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-review-cards {\n    position: relative;\n    z-index: 1;\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  .tjs-review-card {\n    position: relative;\n    min-height: 190px;\n    padding: 18px 16px;\n    border-radius: 24px;\n    background: linear-gradient(135deg, rgba(255,255,255,0.82), rgba(255,247,243,0.76));\n    border: 1px solid rgba(23,23,23,0.34);\n    box-shadow: 0 12px 24px rgba(47,36,32,0.05);\n    overflow: hidden;\n    transition: transform 0.24s ease, box-shadow 0.24s ease;\n  }\n\n  .tjs-review-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 16px 30px rgba(47,36,32,0.09);\n  }\n\n  .tjs-review-card-stars {\n    color: currentColor;\n    font-size: 12px;\n    line-height: 1;\n    letter-spacing: 1.2px;\n    margin-bottom: 12px;\n  }\n\n  .tjs-review-card-text {\n    font-size: 12.5px;\n    line-height: 1.62;\n    color: var(--june-ink,#171717);\n    font-weight: 600;\n  }\n\n  .tjs-review-card-author {\n    margin-top: 16px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .tjs-review-avatar {\n    width: 34px;\n    height: 34px;\n    min-width: 34px;\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: currentColor;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 950;\n    box-shadow: 0 8px 16px rgba(47,36,32,0.13);\n  }\n\n  .tjs-review-name {\n    font-size: 12px;\n    line-height: 1.2;\n    color: var(--june-ink,#171717);\n    font-weight: 900;\n  }\n\n  .tjs-review-tag {\n    margin-top: 3px;\n    font-size: 10.5px;\n    line-height: 1;\n    color: currentColor;\n    font-weight: 700;\n  }\n\n  .tjs-review-footnote {\n    position: relative;\n    z-index: 1;\n    margin-top: 18px;\n    padding: 15px 16px;\n    border-radius: 24px;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: var(--june-on-dark,#FFFFFF);\n    box-shadow: 0 16px 30px rgba(47,36,32,0.16);\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .tjs-review-footnote-icon {\n    width: 42px;\n    height: 42px;\n    min-width: 42px;\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    background: var(--june-bg,#FFFFFF);\n    color: currentColor;\n    font-size: 18px;\n    animation: tjsReviewPulse 2s ease-in-out infinite;\n  }\n\n  @keyframes tjsReviewPulse {\n    0%, 100% {\n      transform: scale(1);\n    }\n    50% {\n      transform: scale(1.08) rotate(-4deg);\n    }\n  }\n\n  .tjs-review-footnote-title {\n    font-size: 13px;\n    line-height: 1.25;\n    font-weight: 950;\n  }\n\n  .tjs-review-footnote-text {\n    margin-top: 3px;\n   