            "custom_liquid_rb3yeM": {
              "type": "_custom-liquid",
              "name": "Custom liquid",
              "disabled": true,
              "settings": {
                "liquid": "<style>\n.tjs-mini-drop *{box-sizing:border-box;}\n\n.tjs-mini-drop{\n  margin:10px 0 16px;\n  padding:14px;\n  max-width:420px;\n  border-radius:14px;\n  background:var(--june-dark,#171717);\n  border:1px solid rgba(23,23,23,.75);\n  color:var(--june-on-dark,#FFFFFF);\n  font-family:Arial,sans-serif;\n}\n\n.tjs-mini-top{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  margin-bottom:10px;\n}\n\n.tjs-mini-kicker{\n  font-size:10px;\n  letter-spacing:.16em;\n  text-transform:uppercase;\n  color:rgba(255,255,255,.48);\n  font-weight:900;\n}\n\n.tjs-mini-badge{\n  background:var(--june-surface,#F5F5F3);\n  color:var(--june-ink,#171717);\n  border-radius:999px;\n  padding:5px 8px;\n  font-size:10px;\n  font-weight:950;\n}\n\n.tjs-mini-title{\n  font-family:Impact,Arial Black,sans-serif;\n  font-size:22px;\n  line-height:1;\n  text-transform:uppercase;\n  margin-bottom:10px;\n}\n\n.tjs-mini-title span{color:currentColor;}\n\n.tjs-mini-price-row{\n  display:flex;\n  align-items:flex-end;\n  gap:10px;\n  margin-bottom:10px;\n}\n\n.tjs-mini-old{\n  font-size:14px;\n  color:rgba(255,255,255,.38);\n  text-decoration:line-through;\n  font-weight:700;\n}\n\n.tjs-mini-live{\n  font-size:32px;\n  font-weight:950;\n  color:var(--june-on-dark,#FFFFFF);\n}\n\n.tjs-mini-btn{\n  width:100%;\n  border:0;\n  border-radius:10px;\n  padding:12px;\n  background:var(--june-accent,#F56A28);\n  color:var(--june-on-accent,var(--june-ink,#171717));\n  font-family:Impact,Arial Black,sans-serif;\n  font-size:13px;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n  cursor:pointer;\n}\n\n.tjs-mini-btn.claimed{\n  background:var(--june-accent,#F56A28);\n  color:var(--june-on-accent,var(--june-ink,#171717));\n}\n\n.tjs-mini-note{\n  margin-top:8px;\n  font-size:11px;\n  color:rgba(255,255,255,.55);\n  text-align:center;\n}\n\n.tjs-mini-pop{\n  animation:tjsMiniPop .4s ease;\n}\n\n@keyframes tjsMiniPop{\n  0%{transform:scale(1);}\n  45%{transform:scale(1.09);}\n  100%{transform:scale(1);}\n}\n</style>\n\n<div class=\"tjs-mini-drop\">\n  \n  <div class=\"tjs-mini-top\">\n    <div class=\"tjs-mini-kicker\">Private Cart Price</div>\n    <div class=\"tjs-mini-badge\">50% OFF</div>\n  </div>\n\n  <div class=\"tjs-mini-title\">\n    Reveal your <span>deal price</span>\n  </div>\n\n  <div class=\"tjs-mini-price-row\">\n\n    <!-- Hidden initially -->\n    <div \n      class=\"tjs-mini-old\" \n      id=\"tjs-mini-old\"\n      style=\"display:none;\"\n    >\n      {{ product.selected_or_first_available_variant.price | money }}\n    </div>\n\n    <div \n      class=\"tjs-mini-live\" \n      id=\"tjs-mini-live\"\n      data-original=\"{{ product.selected_or_first_available_variant.price }}\"\n    >\n      {{ product.selected_or_first_available_variant.price | money }}\n    </div>\n\n  </div>\n\n  <button type=\"button\" class=\"tjs-mini-btn\" id=\"tjs-mini-btn\">\n    Reveal Cart Price\n  </button>\n\n  <div class=\"tjs-mini-note\" id=\"tjs-mini-note\">\n    Final discount applies after adding to cart.\n  </div>\n\n</div>\n\n<script>\n(function(){\n  var btn = document.getElementById('tjs-mini-btn');\n  var priceEl = document.getElementById('tjs-mini-live');\n  var oldPriceEl = document.getElementById('tjs-mini-old');\n  var note = document.getElementById('tjs-mini-note');\n\n  if(!btn || !priceEl) return;\n\n  var original = parseInt(priceEl.getAttribute('data-original'), 10);\n  var discounted = Math.round(original / 2);\n\n  function formatMoney(cents){\n    return 'Rs. ' + Math.round(cents / 100).toLocaleString('en-IN');\n  }\n\n  function animatePrice(start, end, duration){\n    var startTime = null;\n\n    function step(timestamp){\n      if(!startTime) startTime = timestamp;\n      var progress = Math.min((timestamp - startTime) / duration, 1);\n      var eased = 1 - Math.pow(1 - progress, 3);\n      var current = Math.round(start + (end - start) * eased);\n\n      priceEl.innerText = formatMoney(current);\n\n      if(progress < 1){\n        requestAnimationFrame(step);\n      } else {\n        priceEl.innerText = formatMoney(end);\n        priceEl.classList.add('tjs-mini-pop');\n        setTimeout(function(){\n          priceEl.classList.remove('tjs-mini-pop');\n        },400);\n      }\n    }\n\n    requestAnimationFrame(step);\n  }\n\n  btn.addEventListener('click', function(){\n\n    if(btn.classList.contains('claimed')) return;\n\n    animatePrice(original, discounted, 700);\n\n    // show original slashed AFTER click\n    if(oldPriceEl){\n      oldPriceEl.style.display = 'block';\n    }\n\n    btn.classList.add('claimed');\n    btn.innerText = 'Deal Price Revealed ✓';\n\n    if(note){\n      note.innerText = 'Add to cart — 50% off applies automatically.';\n    }\n  });\n})();\n</script>"
              },
              "blocks": {}
