            "custom_liquid_KNReFD": {
              "type": "_custom-liquid",
              "name": "Custom liquid",
              "settings": {
                "liquid": "<style>\n  .tjs-planner-variant-wrap {\n    margin: 16px 0 18px;\n    font-family: inherit;\n  }\n\n  .tjs-planner-variant-head {\n    margin-bottom: 10px;\n  }\n\n  .tjs-planner-variant-label {\n    font-size: 11px;\n    line-height: 1;\n    letter-spacing: 1.1px;\n    text-transform: uppercase;\n    color: currentColor;\n    font-weight: 800;\n    margin-bottom: 6px;\n  }\n\n  .tjs-planner-variant-selected {\n    font-size: 13px;\n    line-height: 1.35;\n    color: var(--june-ink,#171717);\n    font-weight: 500;\n  }\n\n  .tjs-planner-variant-selected strong {\n    color: var(--june-ink,#171717);\n    font-weight: 800;\n  }\n\n  .tjs-planner-variant-grid {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 9px;\n  }\n\n  .tjs-planner-variant-option {\n    position: relative;\n    cursor: pointer;\n  }\n\n  .tjs-planner-variant-option input {\n    position: absolute;\n    opacity: 0;\n    pointer-events: none;\n  }\n\n  .tjs-planner-variant-pill {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 38px;\n    padding: 10px 14px;\n    border-radius: 999px;\n    border: 1px solid rgba(23,23,23, 0.48);\n    background: var(--june-bg,#FFFFFF);\n    color: var(--june-ink,#171717);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 700;\n    transition: all 0.22s ease;\n  }\n\n  .tjs-planner-variant-option:hover .tjs-planner-variant-pill {\n    transform: translateY(-1px);\n    border-color: rgba(23,23,23, 0.55);\n    box-shadow: 0 8px 18px rgba(47, 36, 32, 0.08);\n  }\n\n  .tjs-planner-variant-option input:checked + .tjs-planner-variant-pill {\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: var(--june-on-dark,#FFFFFF);\n    border-color: var(--june-ink,#171717);\n    box-shadow: 0 9px 20px rgba(47, 36, 32, 0.14);\n  }\n\n  .tjs-planner-variant-option input:disabled + .tjs-planner-variant-pill {\n    opacity: 0.45;\n    cursor: not-allowed;\n    text-decoration: line-through;\n  }\n\n  .tjs-planner-custom-name-box {\n    display: none;\n    margin-top: 13px;\n    padding: 12px 13px;\n    border-radius: 16px;\n    background: linear-gradient(135deg, var(--june-bg,#FFFFFF), var(--june-bg,#FFFFFF));\n    border: 1px solid rgba(23,23,23, 0.42);\n  }\n\n  .tjs-planner-custom-name-box.is-visible {\n    display: block;\n    animation: tjsCustomNameReveal 0.28s ease;\n  }\n\n  @keyframes tjsCustomNameReveal {\n    from {\n      opacity: 0;\n      transform: translateY(-4px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  .tjs-planner-custom-name-label {\n    display: block;\n    margin-bottom: 7px;\n    font-size: 12px;\n    line-height: 1.3;\n    color: var(--june-ink,#171717);\n    font-weight: 800;\n  }\n\n  .tjs-planner-custom-name-input {\n    width: 100%;\n    min-height: 44px;\n    padding: 12px 13px;\n    border-radius: 12px;\n    border: 1px solid rgba(23,23,23, 0.28);\n    background: var(--june-bg,#FFFFFF);\n    color: var(--june-ink,#171717);\n    font-size: 14px;\n    line-height: 1.3;\n    font-weight: 600;\n    outline: none;\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);\n  }\n\n  .tjs-planner-custom-name-input:focus {\n    border-color: rgba(23,23,23, 0.65);\n    box-shadow: 0 0 0 3px rgba(23,23,23, 0.22);\n  }\n\n  .tjs-planner-custom-name-note {\n    margin-top: 6px;\n    font-size: 11px;\n    line-height: 1.4;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-planner-custom-name-error {\n    display: none;\n    margin-top: 6px;\n    font-size: 11.5px;\n    line-height: 1.35;\n    color: #b8463d;\n    font-weight: 700;\n  }\n\n  .tjs-planner-custom-name-error.is-visible {\n    display: block;\n  }\n\n  .tjs-name-preview {\n    display: block;\n    margin-top: 11px;\n    padding: 12px 13px;\n    border-radius: 14px;\n    background: linear-gradient(135deg, var(--june-bg,#FFFFFF), var(--june-bg,#FFFFFF));\n    border: 1px solid rgba(23,23,23, 0.45);\n    box-shadow: 0 8px 18px rgba(47, 36, 32, 0.06);\n  }\n\n  .tjs-name-preview__label {\n    margin-bottom: 5px;\n    font-size: 10px;\n    line-height: 1;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    color: currentColor;\n    font-weight: 800;\n  }\n\n  .tjs-name-preview__text {\n    position: relative;\n    display: inline-block;\n    font-size: 20px;\n    line-height: 1.2;\n    font-weight: 850;\n    letter-spacing: 0.35px;\n    text-transform: uppercase;\n    background: linear-gradient(\n      115deg,\n      var(--june-surface,#F5F5F3) 0%,\n      var(--june-surface,#F5F5F3) 16%,\n      var(--june-surface,#F5F5F3) 28%,\n      var(--june-surface,#F5F5F3) 40%,\n      var(--june-surface,#F5F5F3) 52%,\n      var(--june-surface,#F5F5F3) 64%,\n      var(--june-surface,#F5F5F3) 78%,\n      var(--june-surface,#F5F5F3) 100%\n    );\n    background-size: 260% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    -webkit-text-fill-color: transparent;\n    animation: tjsGoldFoilShimmer 3.4s linear infinite;\n    text-shadow: 0 0 1px rgba(23,23,23, 0.18);\n  }\n\n  @keyframes tjsGoldFoilShimmer {\n    0% {\n      background-position: 200% 0;\n    }\n    100% {\n      background-position: -60% 0;\n    }\n  }\n\n  .tjs-name-preview__text.tjs-name-pop {\n    animation: tjsNamePop 0.32s ease, tjsGoldFoilShimmer 3.4s linear infinite;\n  }\n\n  @keyframes tjsNamePop {\n    0% {\n      transform: scale(1);\n    }\n    45% {\n      transform: scale(1.04);\n    }\n    100% {\n      transform: scale(1);\n    }\n  }\n\n  .tjs-name-preview__sparkle {\n    display: inline-block;\n    margin-left: 6px;\n    color: currentColor;\n    font-size: 12px;\n    animation: tjsPreviewSparkle 1.8s ease-in-out infinite;\n  }\n\n  @keyframes tjsPreviewSparkle {\n    0%, 100% {\n      transform: scale(0.8) rotate(0deg);\n      opacity: 0.55;\n    }\n    45% {\n      transform: scale(1.25) rotate(18deg);\n      opacity: 1;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-planner-variant-wrap {\n      margin: 15px 0 17px;\n      text-align: center;\n    }\n\n    .tjs-planner-variant-label {\n      font-size: 10px;\n    }\n\n    .tjs-planner-variant-selected {\n      font-size: 12.5px;\n    }\n\n    .tjs-planner-variant-grid {\n      justify-content: center;\n      gap: 8px;\n    }\n\n    .tjs-planner-variant-pill {\n      min-height: 36px;\n      padding: 9px 12px;\n      font-size: 12px;\n    }\n\n    .tjs-planner-custom-name-box {\n      text-align: left;\n      padding: 12px;\n    }\n\n    .tjs-name-preview__text {\n      font-size: 18px;\n    }\n  }\n</style>\n\n{% assign current_variant = product.selected_or_first_available_variant %}\n\n<div\n  class=\"tjs-planner-variant-wrap\"\n  data-tjs-custom-variant-picker\n  data-product-json='{{ product | json | escape }}'\n>\n  <div class=\"tjs-planner-variant-head\">\n    <div class=\"tjs-planner-variant-label\">\n      Select Your Planner Option\n    </div>\n\n    <div class=\"tjs-planner-variant-selected\">\n      Selected: <strong data-tjs-selected-variant-title>{{ current_variant.title }}</strong>\n    </div>\n  </div>\n\n  <div class=\"tjs-planner-variant-grid\">\n    {% for variant in product.variants %}\n      <label class=\"tjs-planner-variant-option\">\n        <input\n          type=\"radio\"\n          name=\"tjs-planner-variant\"\n          value=\"{{ variant.id }}\"\n          data-variant-title=\"{{ variant.title | escape }}\"\n          {% if variant.id == current_variant.id %}checked{% endif %}\n          {% unless variant.available %}disabled{% endunless %}\n        >\n        <span class=\"tjs-planner-variant-pill\">\n          {{ variant.title }}\n        </span>\n      </label>\n    {% endfor %}\n  </div>\n\n  <div class=\"tjs-planner-custom-name-box\" data-tjs-custom-name-box>\n    <label class=\"tjs-planner-custom-name-label\" for=\"tjsPlannerCustomName\">\n      Type your name customisation\n    </label>\n\n    <input\n      id=\"tjsPlannerCustomName\"\n      class=\"tjs-planner-custom-name-input\"\n      type=\"text\"\n      placeholder=\"Example: Anushka\"\n      maxlength=\"24\"\n      data-tjs-custom-name-input\n    >\n\n    <div class=\"tjs-name-preview\" data-tjs-name-preview>\n      <div class=\"tjs-name-preview__label\">Preview</div>\n      <div>\n        <span class=\"tjs-name-preview__text\" data-tjs-name-preview-text>\n          ANUSHKA\n        </span>\n        <span class=\"tjs-name-preview__sparkle\">✦</span>\n      </div>\n    </div>\n\n    <div class=\"tjs-planner-custom-name-note\">\n      This name will be added to your planner customisation request.\n    </div>\n\n    <div class=\"tjs-planner-custom-name-error\" data-tjs-custom-name-error>\n      Please enter the name for customisation before adding to cart.\n    </div>\n  </div>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const picker = document.querySelector(\"[data-tjs-custom-variant-picker]\");\n    if (!picker) return;\n\n    const selectedTitleEl = picker.querySelector(\"[data-tjs-selected-variant-title]\");\n    const customNameBox = picker.querySelector(\"[data-tjs-custom-name-box]\");\n    const customNameInput = picker.querySelector(\"[data-tjs-custom-name-input]\");\n    const customNameError = picker.querySelector(\"[data-tjs-custom-name-error]\");\n    const namePreviewText = picker.querySelector(\"[data-tjs-name-preview-text]\");\n    const variantRadios = picker.querySelectorAll('input[name=\"tjs-planner-variant\"]');\n\n    const productForm =\n      picker.closest(\"section\")?.querySelector('form[action*=\"/cart/add\"]') ||\n      document.querySelector('form[action*=\"/cart/add\"]');\n\n    if (!productForm) return;\n\n    const formVariantInput =\n      productForm.querySelector('input[name=\"id\"]') ||\n      productForm.querySelector('select[name=\"id\"]');\n\n    function isCustomisationVariant(title) {\n      const cleanTitle = title.toLowerCase();\n      return cleanTitle.includes(\"add your name\") || cleanTitle.includes(\"name customisation\") || cleanTitle.includes(\"personalised name\") || cleanTitle.includes(\"personalized name\");\n    }\n\n    function getOrCreatePropertyInput() {\n      let propertyInput = productForm.querySelector('input[name=\"properties[Name Customisation]\"]');\n\n      if (!propertyInput) {\n        propertyInput = document.createElement(\"input\");\n        propertyInput.type = \"hidden\";\n        propertyInput.name = \"properties[Name Customisation]\";\n        productForm.appendChild(propertyInput);\n      }\n\n      return propertyInput;\n    }\n\n    function removePropertyInput() {\n      const propertyInput = productForm.querySelector('input[name=\"properties[Name Customisation]\"]');\n      if (propertyInput) propertyInput.remove();\n    }\n\n    function formatPreviewName(name) {\n      const cleanName = name.trim();\n      if (!cleanName) return \"ANUSHKA\";\n      return cleanName.toUpperCase();\n    }\n\n    function animateNamePreview() {\n      if (!namePreviewText) return;\n\n      namePreviewText.classList.remove(\"tjs-name-pop\");\n      void namePreviewText.offsetWidth;\n      namePreviewText.classList.add(\"tjs-name-pop\");\n    }\n\n    function updateNamePreview() {\n      if (!namePreviewText || !customNameInput) return;\n\n      namePreviewText.textContent = formatPreviewName(customNameInput.value);\n      animateNamePreview();\n    }\n\n    function updateCustomNameVisibility(variantTitle) {\n      if (isCustomisationVariant(variantTitle)) {\n        customNameBox.classList.add(\"is-visible\");\n        customNameInput.setAttribute(\"required\", \"required\");\n        updateNamePreview();\n      } else {\n        customNameBox.classList.remove(\"is-visible\");\n        customNameInput.removeAttribute(\"required\");\n        customNameInput.value = \"\";\n        customNameError.classList.remove(\"is-visible\");\n        removePropertyInput();\n\n        if (namePreviewText) {\n          namePreviewText.textContent = \"ANUSHKA\";\n        }\n      }\n    }\n\n    function updateVariantSelection(radio) {\n      const variantId = radio.value;\n      const variantTitle = radio.getAttribute(\"data-variant-title\") || \"\";\n\n      if (selectedTitleEl) selectedTitleEl.textContent = variantTitle;\n\n      if (formVariantInput) {\n        formVariantInput.value = variantId;\n        formVariantInput.dispatchEvent(new Event(\"change\", { bubbles: true }));\n      }\n\n      updateCustomNameVisibility(variantTitle);\n    }\n\n    variantRadios.forEach(function (radio) {\n      radio.addEventListener(\"change\", function () {\n        if (radio.checked) updateVariantSelection(radio);\n      });\n\n      if (radio.checked) {\n        updateVariantSelection(radio);\n      }\n    });\n\n    customNameInput.addEventListener(\"input\", function () {\n      customNameError.classList.remove(\"is-visible\");\n      updateNamePreview();\n\n      const checkedRadio = picker.querySelector('input[name=\"tjs-planner-variant\"]:checked');\n      if (!checkedRadio) return;\n\n      const variantTitle = checkedRadio.getAttribute(\"data-variant-title\") || \"\";\n\n      if (isCustomisationVariant(variantTitle)) {\n        const propertyInput = getOrCreatePropertyInput();\n        propertyInput.value = customNameInput.value.trim();\n      }\n    });\n\n    formVariantInput?.addEventListener(\"change\", function () {\n      const radio = Array.from(variantRadios).find(item => item.value === formVariantInput.value);\n      if (!radio) return;\n      radio.checked = true;\n      const title = radio.getAttribute(\"data-variant-title\") || \"\";\n      if (selectedTitleEl) selectedTitleEl.textContent = title;\n      updateCustomNameVisibility(title);\n    });\n\n    // This custom layout has no standard main product form for the native sticky observer.\n    const productSection = picker.closest(\".shopify-section\");\n    const stickyBar = productSection?.querySelector(\"hdt-sticky-btn-atc\");\n    const mainAtc = productSection?.querySelector(\"[data-tjs-custom-atc]\");\n    if (stickyBar && mainAtc && !document.getElementById(stickyBar.getAttribute(\"form\"))) {\n      let stickyFrame = 0;\n      function updateStickyVisibility() {\n        stickyFrame = 0;\n        document.body.classList.toggle(\"sticky-shown\", mainAtc.getBoundingClientRect().bottom < 0);\n      }\n      function scheduleStickyVisibility() {\n        if (!stickyFrame) stickyFrame = requestAnimationFrame(updateStickyVisibility);\n      }\n      const stickyObserver = new IntersectionObserver(scheduleStickyVisibility);\n      stickyObserver.observe(mainAtc);\n      window.addEventListener(\"scroll\", scheduleStickyVisibility, { passive: true });\n      window.addEventListener(\"resize\", scheduleStickyVisibility);\n      updateStickyVisibility();\n      document.addEventListener(\"shopify:section:unload\", function (event) {\n        if (event.target.contains(stickyBar)) {\n          stickyObserver.disconnect();\n          cancelAnimationFrame(stickyFrame);\n          window.removeEventListener(\"scroll\", scheduleStickyVisibility);\n          window.removeEventListener(\"resize\", scheduleStickyVisibility);\n          document.body.classList.remove(\"sticky-shown\");\n        }\n      });\n    }\n\n    function validatePersonalisation(event) {\n      const checkedRadio = picker.querySelector('input[name=\"tjs-planner-variant\"]:checked');\n      if (!checkedRadio) return;\n\n      const variantTitle = checkedRadio.getAttribute(\"data-variant-title\") || \"\";\n\n      if (isCustomisationVariant(variantTitle)) {\n        const customName = customNameInput.value.trim();\n\n        if (!customName || customName.length > 24) {\n          event.preventDefault();\n          event.stopImmediatePropagation();\n\n          customNameError.classList.add(\"is-visible\");\n          customNameInput.focus();\n          return false;\n        }\n\n        const propertyInput = getOrCreatePropertyInput();\n        propertyInput.value = customName;\n      } else {\n        removePropertyInput();\n      }\n    }\n\n    document.addEventListener(\"submit\", function (event) {\n      if (event.target === productForm) validatePersonalisation(event);\n    }, true);\n    document.addEventListener(\"click\", function (event) {\n      const submit = event.target.closest('button[type=\"submit\"], input[type=\"submit\"]');\n      if (submit?.form === productForm) validatePersonalisation(event);\n    }, true);\n  });\n</script>"
              },
              "blocks": {}
            },
            "custom_liquid_TDWL9R": {
              "type": "_custom-liquid",
              "name": "Custom liquid",
              "settings": {
                "liquid": "<style>\n  .tjs-planner-qty-wrap {\n    margin: 16px 0 18px;\n    font-family: inherit;\n  }\n\n  .tjs-planner-qty-label {\n    margin-bottom: 8px;\n    font-size: 11px;\n    line-height: 1;\n    letter-spacing: 1.1px;\n    text-transform: uppercase;\n    color: currentColor;\n    font-weight: 800;\n  }\n\n  .tjs-planner-qty-row {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n\n  .tjs-planner-qty-control {\n    display: inline-flex;\n    align-items: center;\n    height: 44px;\n    border-radius: 999px;\n    background: var(--june-bg,#FFFFFF);\n    border: 1px solid rgba(23,23,23, 0.5);\n    box-shadow: 0 8px 18px rgba(47, 36, 32, 0.06);\n    overflow: hidden;\n  }\n\n  .tjs-planner-qty-btn {\n    width: 42px;\n    height: 44px;\n    border: 0;\n    background: transparent;\n    color: var(--june-ink,#171717);\n    font-size: 20px;\n    line-height: 1;\n    font-weight: 700;\n    cursor: pointer;\n    transition: all 0.2s ease;\n  }\n\n  .tjs-planner-qty-btn:hover {\n    background: rgba(23,23,23, 0.18);\n    color: var(--june-ink,#171717);\n  }\n\n  .tjs-planner-qty-btn:active {\n    transform: scale(0.92);\n  }\n\n  .tjs-planner-qty-number {\n    min-width: 46px;\n    text-align: center;\n    font-size: 15px;\n    line-height: 1;\n    font-weight: 850;\n    color: var(--june-ink,#171717);\n  }\n\n  .tjs-planner-qty-number.tjs-qty-pop {\n    animation: tjsQtyPop 0.22s ease;\n  }\n\n  @keyframes tjsQtyPop {\n    0% {\n      transform: scale(1);\n    }\n    45% {\n      transform: scale(1.18);\n    }\n    100% {\n      transform: scale(1);\n    }\n  }\n\n  .tjs-planner-qty-note {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 12px;\n    line-height: 1.35;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-planner-qty-note::before {\n    content: \"✦\";\n    color: currentColor;\n    font-size: 10px;\n  }\n\n  .tjs-planner-qty-note strong {\n    color: var(--june-ink,#171717);\n    font-weight: 800;\n  }\n\n  .tjs-planner-qty-gift-note {\n    display: none;\n    margin-top: 8px;\n    font-size: 12px;\n    line-height: 1.45;\n    color: currentColor;\n    font-weight: 650;\n  }\n\n  .tjs-planner-qty-gift-note.is-visible {\n    display: block;\n    animation: tjsQtyNoteReveal 0.25s ease;\n  }\n\n  @keyframes tjsQtyNoteReveal {\n    from {\n      opacity: 0;\n      transform: translateY(-3px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-planner-qty-wrap {\n      margin: 15px 0 17px;\n      text-align: center;\n    }\n\n    .tjs-planner-qty-label {\n      font-size: 10px;\n    }\n\n    .tjs-planner-qty-row {\n      justify-content: center;\n      gap: 10px;\n    }\n\n    .tjs-planner-qty-control {\n      height: 42px;\n    }\n\n    .tjs-planner-qty-btn {\n      width: 40px;\n      height: 42px;\n      font-size: 19px;\n    }\n\n    .tjs-planner-qty-number {\n      min-width: 44px;\n      font-size: 14px;\n    }\n\n    .tjs-planner-qty-note {\n      justify-content: center;\n      width: 100%;\n      font-size: 11.5px;\n    }\n\n    .tjs-planner-qty-gift-note {\n      font-size: 11.5px;\n    }\n  }\n</style>\n\n<div class=\"tjs-planner-qty-wrap\" data-tjs-qty-selector>\n  <div class=\"tjs-planner-qty-label\">\n    Quantity\n  </div>\n\n  <div class=\"tjs-planner-qty-row\">\n    <div class=\"tjs-planner-qty-control\">\n      <button type=\"button\" class=\"tjs-planner-qty-btn\" data-tjs-qty-minus aria-label=\"Decrease quantity\">\n        −\n      </button>\n\n      <div class=\"tjs-planner-qty-number\" data-tjs-qty-number>\n        1\n      </div>\n\n      <button type=\"button\" class=\"tjs-planner-qty-btn\" data-tjs-qty-plus aria-label=\"Increase quantity\">\n        +\n      </button>\n    </div>\n\n    <div class=\"tjs-planner-qty-note\">\n      <strong>Free sticker book</strong> included with every planner\n    </div>\n  </div>\n\n  <div class=\"tjs-planner-qty-gift-note\" data-tjs-qty-gift-note>\n    Adding more than one? These make beautiful gifts for friends, teams, and fresh starts.\n  </div>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const qtySelector = document.querySelector(\"[data-tjs-qty-selector]\");\n    if (!qtySelector) return;\n\n    const minusBtn = qtySelector.querySelector(\"[data-tjs-qty-minus]\");\n    const plusBtn = qtySelector.querySelector(\"[data-tjs-qty-plus]\");\n    const qtyNumber = qtySelector.querySelector(\"[data-tjs-qty-number]\");\n    const giftNote = qtySelector.querySelector(\"[data-tjs-qty-gift-note]\");\n\n    const productForm =\n      qtySelector.closest(\"section\")?.querySelector('form[action*=\"/cart/add\"]') ||\n      document.querySelector('form[action*=\"/cart/add\"]');\n\n    if (!productForm) return;\n\n    let formQtyInput = productForm.querySelector('input[name=\"quantity\"]');\n\n    if (!formQtyInput) {\n      formQtyInput = document.createElement(\"input\");\n      formQtyInput.type = \"hidden\";\n      formQtyInput.name = \"quantity\";\n      productForm.appendChild(formQtyInput);\n    }\n\n    function getQty() {\n      const currentQty = parseInt(formQtyInput.value, 10);\n      return Number.isFinite(currentQty) && currentQty > 0 ? currentQty : 1;\n    }\n\n    function animateQty() {\n      qtyNumber.classList.remove(\"tjs-qty-pop\");\n      void qtyNumber.offsetWidth;\n      qtyNumber.classList.add(\"tjs-qty-pop\");\n    }\n\n    function updateQty(newQty) {\n      const qty = Math.max(1, newQty);\n\n      formQtyInput.value = qty;\n      qtyNumber.textContent = qty;\n\n      formQtyInput.dispatchEvent(new Event(\"change\", { bubbles: true }));\n\n      if (qty >= 2) {\n        giftNote.classList.add(\"is-visible\");\n      } else {\n        giftNote.classList.remove(\"is-visible\");\n      }\n\n      animateQty();\n    }\n\n    updateQty(getQty());\n\n    minusBtn.addEventListener(\"click\", function () {\n      updateQty(getQty() - 1);\n    });\n\n    plusBtn.addEventListener(\"click\", function () {\n      updateQty(getQty() + 1);\n    });\n  });\n</script>"
