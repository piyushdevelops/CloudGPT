            "custom_liquid_FQfirh": {
              "type": "_custom-liquid",
              "name": "Custom liquid",
              "disabled": true,
              "settings": {
                "liquid": "<style>\n  .tjs-planner-price-wrap {\n    margin: 12px 0 16px;\n    font-family: inherit;\n  }\n\n  .tjs-planner-price-row {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    flex-wrap: wrap;\n  }\n\n  .tjs-planner-current-price {\n    position: relative;\n    display: inline-block;\n    font-size: 32px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.9px;\n    color: var(--june-ink,#171717);\n    background: linear-gradient(110deg, var(--june-dark,#171717) 0%, var(--june-dark,#171717) 38%, var(--june-surface,#F5F5F3) 50%, var(--june-dark,#171717) 62%, var(--june-dark,#171717) 100%);\n    background-size: 220% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    animation: tjsPriceTextSheen 4.2s ease-in-out infinite;\n  }\n\n  @keyframes tjsPriceTextSheen {\n    0%, 55% {\n      background-position: 110% 0;\n    }\n    75%, 100% {\n      background-position: -20% 0;\n    }\n  }\n\n  .tjs-planner-current-price.tjs-price-pop {\n    animation: tjsPricePop 0.42s ease, tjsPriceTextSheen 4.2s ease-in-out infinite;\n  }\n\n  @keyframes tjsPricePop {\n    0% {\n      transform: scale(1);\n      filter: blur(0);\n    }\n    35% {\n      transform: scale(1.055);\n      filter: blur(0.2px);\n    }\n    100% {\n      transform: scale(1);\n      filter: blur(0);\n    }\n  }\n\n  .tjs-planner-compare-price {\n    position: relative;\n    font-size: 17px;\n    line-height: 1;\n    font-weight: 650;\n    color: var(--june-muted,#656565);\n  }\n\n  .tjs-planner-compare-price::after {\n    content: \"\";\n    position: absolute;\n    left: -3px;\n    top: 50%;\n    height: 1.5px;\n    width: calc(100% + 6px);\n    border-radius: 999px;\n    background: linear-gradient(90deg, var(--june-surface,#F5F5F3), var(--june-surface,#F5F5F3));\n    transform: rotate(-7deg) scaleX(0);\n    transform-origin: left center;\n    animation: tjsCompareSlash 0.7s ease forwards;\n  }\n\n  @keyframes tjsCompareSlash {\n    to {\n      transform: rotate(-7deg) scaleX(1);\n    }\n  }\n\n  .tjs-planner-discount-badge {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    padding: 6px 9px;\n    border-radius: 999px;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: var(--june-on-dark,#FFFFFF);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: 0.25px;\n    white-space: nowrap;\n    box-shadow: 0 7px 16px rgba(47, 36, 32, 0.13);\n    overflow: hidden;\n  }\n\n  .tjs-planner-discount-badge::before {\n    content: \"✦\";\n    color: currentColor;\n    font-size: 10px;\n    animation: tjsBadgeSparkle 1.8s ease-in-out infinite;\n  }\n\n  @keyframes tjsBadgeSparkle {\n    0%, 100% {\n      transform: scale(0.8) rotate(0deg);\n      opacity: 0.65;\n    }\n    45% {\n      transform: scale(1.22) rotate(18deg);\n      opacity: 1;\n    }\n  }\n\n  .tjs-planner-discount-badge::after {\n    content: \"\";\n    position: absolute;\n    top: -60%;\n    left: -45%;\n    width: 28px;\n    height: 220%;\n    background: linear-gradient(\n      110deg,\n      transparent,\n      rgba(255, 255, 255, 0.75),\n      transparent\n    );\n    transform: rotate(18deg);\n    animation: tjsPriceBadgeShine 4s ease-in-out infinite;\n  }\n\n  @keyframes tjsPriceBadgeShine {\n    0% {\n      left: -45%;\n      opacity: 0;\n    }\n    18% {\n      opacity: 0.85;\n    }\n    36%, 100% {\n      left: 125%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-planner-save-line {\n    margin-top: 7px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 13px;\n    line-height: 1.45;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-planner-save-line::before {\n    content: \"↳\";\n    color: currentColor;\n    font-weight: 800;\n  }\n\n  .tjs-planner-save-line strong {\n    color: currentColor;\n    font-weight: 850;\n  }\n\n  .tjs-planner-price-note {\n    margin-top: 5px;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 11.5px;\n    line-height: 1.4;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-planner-price-note::before {\n    content: \"✦\";\n    color: currentColor;\n    font-size: 9px;\n  }\n\n  .tjs-planner-price-note span {\n    color: var(--june-ink,#171717);\n    font-weight: 750;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-planner-price-wrap {\n      margin: 12px 0 15px;\n      text-align: center;\n    }\n\n    .tjs-planner-price-row {\n      justify-content: center;\n      gap: 8px;\n    }\n\n    .tjs-planner-current-price {\n      font-size: 30px;\n      letter-spacing: -0.7px;\n    }\n\n    .tjs-planner-compare-price {\n      font-size: 15.5px;\n    }\n\n    .tjs-planner-discount-badge {\n      font-size: 10.5px;\n      padding: 6px 8px;\n    }\n\n    .tjs-planner-save-line {\n      justify-content: center;\n      font-size: 12.5px;\n      margin-top: 8px;\n    }\n\n    .tjs-planner-save-line::before {\n      display: none;\n    }\n\n    .tjs-planner-price-note {\n      justify-content: center;\n      font-size: 11px;\n    }\n  }\n</style>\n\n{% assign current_variant = product.selected_or_first_available_variant %}\n{% assign price = current_variant.price %}\n{% assign compare_price = current_variant.compare_at_price %}\n\n<div class=\"tjs-planner-price-wrap\"\n  data-tjs-price-section\n  data-product-json='{{ product | json | escape }}'>\n\n  <div class=\"tjs-planner-price-row\">\n    <div class=\"tjs-planner-current-price\" data-tjs-current-price>\n      ₹ \n{{ price | money_without_currency | replace: '.00', '' }}\n    </div>\n\n    {% if compare_price > price %}\n      <div class=\"tjs-planner-compare-price\" data-tjs-compare-price>\n        ₹{{ compare_price | money_without_currency | replace: '.00', '' }}\n      </div>\n\n      {% assign discount_percent = compare_price | minus: price | times: 100 | divided_by: compare_price %}\n      {% assign save_amount = compare_price | minus: price %}\n\n      <div class=\"tjs-planner-discount-badge\" data-tjs-discount-badge>\n        {{ discount_percent }}% Off\n      </div>\n    {% else %}\n      <div class=\"tjs-planner-compare-price\" data-tjs-compare-price style=\"display:none;\"></div>\n      <div class=\"tjs-planner-discount-badge\" data-tjs-discount-badge style=\"display:none;\"></div>\n    {% endif %}\n  </div>\n\n  {% if compare_price > price %}\n    <div class=\"tjs-planner-save-line\" data-tjs-save-line>\n      Your planning upgrade saves you <strong>₹ {{ save_amount | money_without_currency | replace: '.00', '' }}</strong>\n    </div>\n  {% else %}\n    <div class=\"tjs-planner-save-line\" data-tjs-save-line style=\"display:none;\"></div>\n  {% endif %}\n\n  <div class=\"tjs-planner-price-note\">\n    <span>Free Ultimate Sticker Book included</span>\n  </div>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const section = document.querySelector(\"[data-tjs-price-section]\");\n    if (!section) return;\n\n    const productData = JSON.parse(section.getAttribute(\"data-product-json\"));\n    const currentPriceEl = section.querySelector(\"[data-tjs-current-price]\");\n    const comparePriceEl = section.querySelector(\"[data-tjs-compare-price]\");\n    const discountBadgeEl = section.querySelector(\"[data-tjs-discount-badge]\");\n    const saveLineEl = section.querySelector(\"[data-tjs-save-line]\");\n\n    function formatMoney(cents) {\n      const amount = cents / 100;\n\n      return \"₹ \" + new Intl.NumberFormat(\"en-IN\", {\n        maximumFractionDigits: 0\n      }).format(amount);\n    }\n\n    function triggerPriceEffect() {\n      currentPriceEl.classList.remove(\"tjs-price-pop\");\n      void currentPriceEl.offsetWidth;\n      currentPriceEl.classList.add(\"tjs-price-pop\");\n    }\n\n    function updatePrice(variant) {\n      if (!variant) return;\n\n      const price = variant.price;\n      const comparePrice = variant.compare_at_price;\n\n      currentPriceEl.textContent = formatMoney(price);\n      triggerPriceEffect();\n\n      if (comparePrice && comparePrice > price) {\n        const saveAmount = comparePrice - price;\n        const discountPercent = Math.round((saveAmount * 100) / comparePrice);\n\n        comparePriceEl.style.display = \"\";\n        discountBadgeEl.style.display = \"\";\n        saveLineEl.style.display = \"\";\n\n        comparePriceEl.textContent = formatMoney(comparePrice);\n        discountBadgeEl.textContent = discountPercent + \"% Off\";\n        saveLineEl.innerHTML = 'Your planning upgrade saves you <strong>' + formatMoney(saveAmount) + '</strong>';\n      } else {\n        comparePriceEl.style.display = \"none\";\n        discountBadgeEl.style.display = \"none\";\n        saveLineEl.style.display = \"none\";\n      }\n    }\n\n    function getSelectedOptions() {\n      const selectedOptions = [];\n\n      document.querySelectorAll('input[type=\"radio\"]:checked, select').forEach(function (input) {\n        if (input.name && input.name.includes(\"options\")) {\n          selectedOptions.push(input.value);\n        }\n      });\n\n      return selectedOptions;\n    }\n\n    function findVariantByOptions() {\n      const selectedOptions = getSelectedOptions();\n\n      return productData.variants.find(function (variant) {\n        return variant.options.every(function (option, index) {\n          return option === selectedOptions[index];\n        });\n      });\n    }\n\n    document.addEventListener(\"change\", function () {\n      setTimeout(function () {\n        const selectedVariant = findVariantByOptions();\n        updatePrice(selectedVariant);\n      }, 100);\n    });\n  });\n</script>"
              },
