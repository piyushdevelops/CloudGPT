lanning Style</td>\n              <td>Mostly daily or monthly pages</td>\n              <td><span class=\"tjs-compare-check\">Goals, routines, wellness, memories and reflection spreads</span></td>\n            </tr>\n\n            <tr>\n              <td>Monthly Experience</td>\n              <td>Basic monthly dividers</td>\n              <td><span class=\"tjs-compare-check\">Illustrated dividers with affirmations and Spotify codes</span></td>\n            </tr>\n\n            <tr>\n              <td>Self-Growth</td>\n              <td>Limited or missing</td>\n              <td><span class=\"tjs-compare-check\">Ikigai, dream voice, win your life and year-end review spreads</span></td>\n            </tr>\n\n            <tr>\n              <td>Creativity</td>\n              <td>Plain layouts</td>\n              <td><span class=\"tjs-compare-check\">De-stress colouring, notes pages and sticker-friendly layouts</span></td>\n            </tr>\n\n            <tr>\n              <td>Free Extras</td>\n              <td>Usually none</td>\n              <td><span class=\"tjs-compare-check\">Free Ultimate Sticker Book with 200+ stickers</span></td>\n            </tr>\n\n            <tr>\n              <td>Quality</td>\n              <td>Basic paper and binding</td>\n              <td><span class=\"tjs-compare-check\">100 GSM paper, hardbound cover and gold wiro binding</span></td>\n            </tr>\n          </tbody>\n        </table>\n\n        <div class=\"tjs-compare-note\">\n          <div class=\"tjs-compare-note-icon\">✦</div>\n          <div>\n            <div class=\"tjs-compare-note-title\">Made for planning your actual life</div>\n            <div class=\"tjs-compare-note-text\">Not just tasks. Your goals, routines, memories, resets and everyday main-character energy.</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
