n    -webkit-backdrop-filter: blur(14px);\n  }\n\n  .tjs-cover-gallery-kicker::before {\n    content: \"✦\";\n    color: currentColor;\n  }\n\n  .tjs-cover-gallery-title {\n    margin: 0;\n    font-size: clamp(34px, 4vw, 58px);\n    line-height: 0.98;\n    letter-spacing: -1.8px;\n    color: var(--june-ink,#171717);\n    font-weight: 950;\n  }\n\n  .tjs-cover-gallery-title span {\n    display: inline-block;\n    background: linear-gradient(115deg, var(--june-surface,#F5F5F3), var(--june-surface,#F5F5F3), var(--june-surface,#F5F5F3));\n    background-size: 240% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    animation: tjsCoverGalleryGold 4s ease-in-out infinite;\n  }\n\n  @keyframes tjsCoverGalleryGold {\n    0%, 100% {\n      background-position: 100% 0;\n    }\n    50% {\n      background-position: 0 0;\n    }\n  }\n\n  .tjs-cover-gallery-subtitle {\n    max-width: 650px;\n    margin: 14px auto 0;\n    font-size: 14px;\n    line-height: 1.7;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-cover-gallery-frame {\n    position: relative;\n    overflow: hidden;\n    border-radius: 36px;\n    padding: 28px;\n    background: rgba(255,255,255,0.64);\n    border: 1px solid rgba(23,23,23,0.38);\n    box-shadow: 0 22px 46px rgba(47,36,32,0.075);\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n  }\n\n  .tjs-cover-gallery-frame::before {\n    content: \"\";\n    position: absolute;\n    top: -80%;\n    left: -50%;\n    width: 120px;\n    height: 260%;\n    background: linear-gradient(110deg, transparent, rgba(255,255,255,0.7), transparent);\n    transform: rotate(18deg);\n    animation: tjsCoverGalleryPanelShine 6s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsCoverGalleryPanelShine {\n    0% {\n      left: -55%;\n      opacity: 0;\n    }\n    14% {\n      opacity: 0.65;\n    }\n    32% {\n      left: 120%;\n      opacity: 0;\n    }\n    100% {\n      left: 120%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-cover-gallery-track {\n    position: relative;\n    z-index: 1;\n    display: grid;\n    grid-auto-flow: column;\n    grid-auto-columns: calc((100% - 40px) / 3);\n    gap: 20px;\n    overflow-x: auto;\n    padding: 8px 6px 18px;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  .tjs-cover-gallery-track::-webkit-scrollbar {\n    display: none;\n  }\n\n  .tjs-cover-gallery-card {\n    position: relative;\n    display: block;\n    text-decoration: none;\n    color: inherit;\n    scroll-snap-align: start;\n  }\n\n  .tjs-cover-gallery-cover {\n    position: relative;\n    overflow: hidden;\n    aspect-ratio: 3 / 4.25;\n    border-radius: 30px;\n    background: var(--june-bg,#FFFFFF);\n    border: 1px solid rgba(23,23,23,0.34);\n    box-shadow:\n      0 24px 44px rgba(47,36,32,0.16),\n      0 0 0 1px rgba(255,255,255,0.75) inset;\n    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n  }\n\n  .tjs-cover-gallery-card:nth-child(3n + 1) .tjs-cover-gallery-cover {\n    transform: rotate(-1.4deg);\n  }\n\n  .tjs-cover-gallery-card:nth-child(3n + 2) .tjs-cover-gallery-cover {\n    transform: translateY(10px) rotate(1deg);\n  }\n\n  .tjs-cover-gallery-card:nth-child(3n + 3) .tjs-cover-gallery-cover {\n    transform: rotate(-0.6deg);\n  }\n\n  .tjs-cover-gallery-card:hover .tjs-cover-gallery-cover {\n    transform: translateY(-8px) rotate(0deg) scale(1.015);\n    box-shadow:\n      0 30px 58px rgba(47,36,32,0.22),\n      0 0 0 1px rgba(255,255,255,0.85) inset;\n    border-color: rgba(23,23,23,0.46);\n  }\n\n  .tjs-cover-gallery-image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    transition: transform 0.45s ease;\n  }\n\n  .tjs-cover-gallery-card:hover .tjs-cover-gallery-image {\n    transform: scale(1.035);\n  }\n\n  .tjs-cover-gallery-cover::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(\n        180deg,\n        transparent 0%,\n        transparent 58%,\n        rgba(47,36,32,0.52) 100%\n      ),\n      linear-gradient(\n        115deg,\n        transparent 0%,\n        transparent 40%,\n        rgba(255,255,255,0.52) 50%,\n        transparent 60%,\n        transparent 100%\n      );\n    transform: translateX(-120%);\n    transition: transform 0.8s ease;\n    pointer-events: none;\n  }\n\n  .tjs-cover-gallery-card:hover .tjs-cover-gallery-cover::after {\n    transform: translateX(120%);\n  }\n\n  .tjs-cover-gallery-info {\n    position: absolute;\n    left: 14px;\n    right: 14px;\n    bottom: 14px;\n    z-index: 3;\n    padding: 12px 13px;\n    border-radius: 18px;\n    background: rgba(255, 255, 255, 0.78);\n    border: 1px solid rgba(255,255,255,0.56);\n    box-shadow: 0 12px 24px rgba(47,36,32,0.12);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    transform: translateY(4px);\n    transition: transform 0.28s ease, background 0.28s ease;\n  }\n\n  .tjs-cover-gallery-card:hover .tjs-cover-gallery-info {\n    transform: translateY(0);\n    background: rgba(255, 255, 255, 0.86);\n  }\n\n  .tjs-cover-gallery-product-title {\n    font-size: 13px;\n    line-height: 1.25;\n    color: var(--june-ink,#171717);\n    font-weight: 950;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n  }\n\n  .tjs-cover-gallery-product-meta {\n    margin-top: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n  }\n\n  .tjs-cover-gallery-price {\n    font-size: 12px;\n    line-height: 1;\n    color: currentColor;\n    font-weight: 900;\n  }\n\n  .tjs-cover-gallery-view {\n    font-size: 10px;\n    line-height: 1;\n    color: var(--june-ink,#171717);\n    font-weight: 900;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .tjs-cover-gallery-badge {\n    position: absolute;\n    top: 14px;\n    left: 14px;\n    z-index: 4;\n    padding: 8px 11px;\n    border-radius: 999px;\n    background: rgba(47,36,32,0.88);\n    color: var(--june-on-dark,#FFFFFF);\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n  }\n\n  .tjs-cover-gallery-empty {\n    position: relative;\n    z-index: 1;\n    padding: 40px;\n    text-align: center;\n    color: var(--june-muted,#656565);\n    font-size: 14px;\n    font-weight: 600;\n  }\n\n  .tjs-cover-gallery-foot {\n    position: relative;\n    z-index: 1;\n    margin-top: 18px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 14px;\n    flex-wrap: wrap;\n  }\n\n  .tjs-cover-gallery-note {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    font-size: 12px;\n    line-height: 1.4;\n    color: var(--june-muted,#656565);\n    font-weight: 650;\n  }\n\n  .tjs-cover-gallery-note::before {\n    content: \"Swipe\";\n    padding: 5px 8px;\n    border-radius: 999px;\n    background: rgba(255,244,239,0.92);\n    border: 1px solid rgba(23,23,23,0.34);\n    color: currentColor;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n  }\n\n  .tjs-cover-gallery-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 42px;\n    padding: 12px 18px;\n    border-radius: 999px;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: var(--june-on-dark,#FFFFFF);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 900;\n    text-decoration: none;\n    box-shadow: 0 12px 24px rgba(47,36,32,0.14);\n    transition: transform 0.22s ease, box-shadow 0.22s ease;\n  }\n\n  .tjs-cover-gallery-button:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 16px 28px rgba(47,36,32,0.18);\n  }\n\n  @media screen and (max-width: 989px) {\n    .tjs-cover-gallery-track {\n      grid-auto-columns: 42%;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-cover-gallery-section {\n      margin: 28px -4px;\n      padding: 30px 12px;\n      border-radius: 26px;\n    }\n\n    .tjs-cover-gallery-head {\n      margin-bottom: 22px;\n    }\n\n    .tjs-cover-gallery-title {\n      font-size: 34px;\n      line-height: 1;\n    }\n\n    .tjs-cover-gallery-subtitle {\n      font-size: 12.7px;\n      line-height: 1.58;\n      max-width: 94%;\n    }\n\n    .tjs-cover-gallery-frame {\n      padding: 12px;\n      border-radius: 24px;\n    }\n\n    .tjs-cover-gallery-track {\n      grid-auto-columns: 82%;\n      gap: 14px;\n      padding: 4px 4px 14px;\n    }\n\n    .tjs-cover-gallery-cover {\n      border-radius: 24px;\n      aspect-ratio: 3 / 4.35;\n    }\n\n    .tjs-cover-gallery-card:nth-child(n) .tjs-cover-gallery-cover {\n      transform: none;\n    }\n\n    .tjs-cover-gallery-info {\n      left: 11px;\n      right: 11px;\n      bottom: 11px;\n      padding: 11px;\n      border-radius: 16px;\n    }\n\n    .tjs-cover-gallery-product-title {\n      font-size: 12px;\n    }\n\n    .tjs-cover-gallery-price {\n      font-size: 11.5px;\n    }\n\n    .tjs-cover-gallery-view {\n      font-size: 9.5px;\n    }\n\n    .tjs-cover-gallery-badge {\n      top: 11px;\n      left: 11px;\n      font-size: 9.5px;\n      padding: 7px 10px;\n    }\n\n    .tjs-cover-gallery-foot {\n      justify-content: center;\n      text-align: center;\n      gap: 10px;\n    }\n\n    .tjs-cover-gallery-note {\n      justify-content: center;\n      width: 100%;\n      font-size: 11.5px;\n    }\n\n    .tjs-cover-gallery-button {\n      width: 100%;\n    }\n  }\n</style>\n\n{% if planner_collection != blank and planner_collection.products_count > 0 %}\n  <section class=\"tjs-cover-gallery-section\">\n    <div class=\"tjs-cover-gallery-container\">\n      <div class=\"tjs-cover-gallery-head\">\n        <div class=\"tjs-cover-gallery-kicker\">\n          Explore The Collection\n        </div>\n\n        <h2 class=\"tjs-cover-gallery-title\">\n          Choose the cover that feels <span>most like you</span>\n        </h2>\n\n        <div class=\"tjs-cover-gallery-subtitle\">\n          Every cover has its own personality. Swipe through the planner gallery and find the design that matches your next chapter.\n        </div>\n      </div>\n\n      <div class=\"tjs-cover-gallery-frame\">\n        <div class=\"tjs-cover-gallery-track\">\n          {% for linked_product in planner_collection.products limit: 12 %}\n            {% assign style_title = linked_product.title\n              | remove: \"Undated Yearly Planner 2025 Collection\"\n              | remove: \"Undated Yearly Planner Current State\"\n              | remove: \"Undated Yearly Planner\"\n              | remove: \"Undated Yealry Planner\"\n              | remove: \"Limited Edition Undated Planner\"\n              | remove: \"(Limited Hardbound Collection)\"\n              | remove: \"Limited Hardbound Collection\"\n              | remove: \"Ultimate Sticker Book\"\n              | remove: \"+\"\n              | remove: \"–\"\n              | remove: \"—\"\n              | remove: \"-\"\n              | strip\n            %}\n\n            <a class=\"tjs-cover-gallery-card\" href=\"{{ linked_product.url }}\">\n              <div class=\"tjs-cover-gallery-cover\">\n                {% if linked_product.handle == product.handle %}\n                  <div class=\"tjs-cover-gallery-badge\">Viewing Now</div>\n                {% endif %}\n\n                {% if linked_product.featured_image %}\n                  <img\n                    class=\"tjs-cover-gallery-image\"\n                    src=\"{{ linked_product.featured_image | image_url: width: 900 }}\"\n                    alt=\"{{ style_title | escape }}\"\n                    loading=\"lazy\"\n                  >\n                {% else %}\n                  <div class=\"tjs-cover-gallery-empty\">\n                    {{ style_title }}\n                  </div>\n                {% endif %}\n\n                <div class=\"tjs-cover-gallery-info\">\n                  <div class=\"tjs-cover-gallery-product-title\">\n                    {{ style_title }}\n                  </div>\n\n                  <div class=\"tjs-cover-gallery-product-meta\">\n                    <div class=\"tjs-cover-gallery-price\">\n                      {{ linked_product.price | money }}\n                    </div>\n                    <div class=\"tjs-cover-gallery-view\">\n                      View\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </a>\n          {% endfor %}\n        </div>\n\n        <div class=\"tjs-cover-gallery-foot\">\n          <div class=\"tjs-cover-gallery-note\">\n            Explore more planner covers from this collection\n          </div>\n\n          <a class=\"tjs-cover-gallery-button\" href=\"{{ planner_collection.url }}\">\n            View Full Collection\n          </a>\n        </div>\n      </div>\n    </div>\n  </section>\n{% endif %}",
