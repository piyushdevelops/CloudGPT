    "custom_liquid_Bm8637": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": true,
        "custom_liquid": "<style>\n  .tjs-monthly-mood-section {\n    position: relative;\n    margin: 38px 0;\n    padding: 42px 18px;\n    font-family: inherit;\n    overflow: hidden;\n    border-radius: 34px;\n    background:\n      radial-gradient(circle at 10% 14%, rgba(23,23,23, 0.42), transparent 26%),\n      radial-gradient(circle at 88% 20%, rgba(23,23,23, 0.45), transparent 28%),\n      radial-gradient(circle at 52% 100%, rgba(23,23,23, 0.5), transparent 34%),\n      linear-gradient(135deg, var(--june-bg,#FFFFFF) 0%, var(--june-bg,#FFFFFF) 48%, var(--june-bg,#FFFFFF) 100%);\n    border: 1px solid rgba(23,23,23, 0.32);\n  }\n\n  .tjs-monthly-mood-section::before {\n    content: \"\";\n    position: absolute;\n    inset: -40%;\n    background:\n      linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.42) 45%, transparent 58%),\n      repeating-linear-gradient(\n        90deg,\n        rgba(255,255,255,0.16) 0 1px,\n        transparent 1px 72px\n      );\n    animation: tjsMoodAuraMove 12s linear infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsMoodAuraMove {\n    0% {\n      transform: translateX(-8%) rotate(0deg);\n    }\n    100% {\n      transform: translateX(8%) rotate(4deg);\n    }\n  }\n\n  .tjs-monthly-mood-container {\n    position: relative;\n    z-index: 1;\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  .tjs-monthly-mood-head {\n    max-width: 760px;\n    margin: 0 auto 30px;\n    text-align: center;\n  }\n\n  .tjs-monthly-mood-kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    margin-bottom: 11px;\n    padding: 8px 12px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.58);\n    border: 1px solid rgba(23,23,23, 0.36);\n    color: currentColor;\n    font-size: 10px;\n    line-height: 1;\n    letter-spacing: 1.2px;\n    text-transform: uppercase;\n    font-weight: 850;\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n  }\n\n  .tjs-monthly-mood-kicker::before {\n    content: \"♪\";\n    color: currentColor;\n    font-size: 12px;\n  }\n\n  .tjs-monthly-mood-title {\n    margin: 0;\n    font-size: clamp(30px, 3.6vw, 52px);\n    line-height: 1.02;\n    letter-spacing: -1.5px;\n    color: var(--june-ink,#171717);\n    font-weight: 900;\n  }\n\n  .tjs-monthly-mood-title span {\n    position: relative;\n    display: inline-block;\n    background: linear-gradient(110deg, var(--june-surface,#F5F5F3), var(--june-surface,#F5F5F3), var(--june-surface,#F5F5F3));\n    background-size: 220% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    animation: tjsGoldTextFlow 4.2s ease-in-out infinite;\n  }\n\n  @keyframes tjsGoldTextFlow {\n    0%, 100% {\n      background-position: 100% 0;\n    }\n    50% {\n      background-position: 0 0;\n    }\n  }\n\n  .tjs-monthly-mood-subtitle {\n    max-width: 660px;\n    margin: 14px auto 0;\n    font-size: 14.5px;\n    line-height: 1.72;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-monthly-mood-stage {\n    display: grid;\n    grid-template-columns: 1.05fr 0.95fr;\n    gap: 24px;\n    align-items: stretch;\n  }\n\n  .tjs-mood-artboard {\n    position: relative;\n    min-height: 520px;\n    border-radius: 32px;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 25% 20%, rgba(255,255,255,0.92), transparent 22%),\n      radial-gradient(circle at 80% 30%, rgba(23,23,23,0.82), transparent 24%),\n      linear-gradient(135deg, rgba(23,23,23, 0.88), rgba(255, 250, 247, 0.9) 52%, rgba(23,23,23, 0.86));\n    border: 1px solid rgba(23,23,23, 0.38);\n    box-shadow: 0 18px 38px rgba(47, 36, 32, 0.08);\n    display: grid;\n    place-items: center;\n    padding: 34px;\n  }\n\n  .tjs-mood-blob {\n    position: absolute;\n    border-radius: 999px;\n    filter: blur(2px);\n    opacity: 0.78;\n    animation: tjsMoodFloatBlob 7s ease-in-out infinite;\n  }\n\n  .tjs-mood-blob.one {\n    width: 150px;\n    height: 150px;\n    left: -42px;\n    top: 42px;\n    background: rgba(23,23,23, 0.72);\n  }\n\n  .tjs-mood-blob.two {\n    width: 190px;\n    height: 190px;\n    right: -60px;\n    bottom: 40px;\n    background: rgba(23,23,23, 0.62);\n    animation-delay: 1.4s;\n  }\n\n  .tjs-mood-blob.three {\n    width: 96px;\n    height: 96px;\n    right: 70px;\n    top: 64px;\n    background: rgba(255, 244, 239, 0.9);\n    animation-delay: 2.1s;\n  }\n\n  @keyframes tjsMoodFloatBlob {\n    0%, 100% {\n      transform: translateY(0) scale(1);\n    }\n    50% {\n      transform: translateY(-14px) scale(1.04);\n    }\n  }\n\n  .tjs-mood-floating-note {\n    position: absolute;\n    z-index: 3;\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    padding: 10px 12px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.72);\n    border: 1px solid rgba(23,23,23, 0.38);\n    color: currentColor;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    box-shadow: 0 10px 22px rgba(47, 36, 32, 0.08);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    animation: tjsMoodFloatNote 4s ease-in-out infinite;\n  }\n\n  .tjs-mood-floating-note.one {\n    left: 28px;\n    top: 30px;\n  }\n\n  .tjs-mood-floating-note.two {\n    right: 26px;\n    bottom: 32px;\n    animation-delay: 1.1s;\n  }\n\n  .tjs-mood-floating-note::before {\n    content: \"✦\";\n    color: currentColor;\n  }\n\n  @keyframes tjsMoodFloatNote {\n    0%, 100% {\n      transform: translateY(0);\n    }\n    50% {\n      transform: translateY(-8px);\n    }\n  }\n\n  .tjs-divider-stack {\n    position: relative;\n    z-index: 2;\n    width: min(360px, 82%);\n    height: 420px;\n    perspective: 1000px;\n  }\n\n  .tjs-divider-card {\n    position: absolute;\n    inset: 0;\n    border-radius: 28px;\n    border: 1px solid rgba(23,23,23, 0.18);\n    overflow: hidden;\n    box-shadow:\n      0 24px 42px rgba(23,23,23, 0.18),\n      inset 0 1px 0 rgba(255, 255, 255, 0.9);\n  }\n\n  .tjs-divider-card.back {\n    transform: rotate(-10deg) translateX(-36px) translateY(16px) scale(0.92);\n    background: linear-gradient(135deg, var(--june-surface,#F5F5F3), var(--june-bg,#FFFFFF));\n    opacity: 0.76;\n  }\n\n  .tjs-divider-card.mid {\n    transform: rotate(8deg) translateX(32px) translateY(22px) scale(0.94);\n    background: linear-gradient(135deg, var(--june-surface,#F5F5F3), var(--june-bg,#FFFFFF));\n    opacity: 0.88;\n  }\n\n  .tjs-divider-card.front {\n    background:\n      radial-gradient(circle at 24% 18%, rgba(255,255,255,0.95), transparent 24%),\n      linear-gradient(135deg, var(--june-bg,#FFFFFF), var(--june-surface,#F5F5F3) 52%, var(--june-bg,#FFFFFF));\n    transform: rotate(-2deg);\n    animation: tjsFrontCardFloat 4.8s ease-in-out infinite;\n  }\n\n  @keyframes tjsFrontCardFloat {\n    0%, 100% {\n      transform: rotate(-2deg) translateY(0);\n    }\n    50% {\n      transform: rotate(-1deg) translateY(-10px);\n    }\n  }\n\n  .tjs-divider-card::before {\n    content: \"\";\n    position: absolute;\n    left: -13px;\n    top: 22px;\n    bottom: 22px;\n    width: 10px;\n    border-radius: 999px;\n    background: repeating-linear-gradient(\n      to bottom,\n      var(--june-surface,#F5F5F3) 0 8px,\n      transparent 8px 15px\n    );\n  }\n\n  .tjs-divider-art {\n    position: absolute;\n    inset: 25px 25px 132px;\n    border-radius: 24px;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 32% 34%, var(--june-surface,#F5F5F3) 0 15%, transparent 16%),\n      radial-gradient(circle at 66% 32%, var(--june-surface,#F5F5F3) 0 12%, transparent 13%),\n      radial-gradient(circle at 52% 72%, var(--june-bg,#FFFFFF) 0 26%, transparent 27%),\n      linear-gradient(135deg, var(--june-bg,#FFFFFF), var(--june-surface,#F5F5F3));\n    border: 1px solid rgba(23,23,23, 0.3);\n  }\n\n  .tjs-divider-art::before {\n    content: \"\";\n    position: absolute;\n    width: 150px;\n    height: 150px;\n    left: 50%;\n    top: 50%;\n    border-radius: 42% 58% 52% 48%;\n    background:\n      radial-gradient(circle at 50% 36%, rgba(255,255,255,0.9), transparent 26%),\n      linear-gradient(135deg, rgba(23,23,23,0.42), rgba(23,23,23,0.5));\n    transform: translate(-50%, -50%);\n    animation: tjsMorphArt 5.2s ease-in-out infinite;\n  }\n\n  @keyframes tjsMorphArt {\n    0%, 100% {\n      border-radius: 42% 58% 52% 48%;\n      transform: translate(-50%, -50%) rotate(0deg);\n    }\n    50% {\n      border-radius: 58% 42% 46% 54%;\n      transform: translate(-50%, -50%) rotate(10deg);\n    }\n  }\n\n  .tjs-divider-month {\n    position: absolute;\n    left: 28px;\n    right: 28px;\n    bottom: 76px;\n    text-align: center;\n    font-size: 34px;\n    line-height: 1;\n    color: var(--june-ink,#171717);\n    font-weight: 900;\n    letter-spacing: -1px;\n  }\n\n  .tjs-divider-trait {\n    position: absolute;\n    left: 28px;\n    right: 28px;\n    bottom: 52px;\n    text-align: center;\n    font-size: 12px;\n    line-height: 1;\n    color: currentColor;\n    font-weight: 850;\n    letter-spacing: 0.4px;\n    text-transform: uppercase;\n  }\n\n  .tjs-divider-spotify {\n    position: absolute;\n    left: 50%;\n    bottom: 22px;\n    transform: translateX(-50%);\n    display: flex;\n    align-items: flex-end;\n    gap: 3px;\n    height: 22px;\n    padding: 0 10px;\n  }\n\n  .tjs-divider-spotify span {\n    display: block;\n    width: 3px;\n    border-radius: 999px;\n    background: var(--june-dark,#171717);\n    opacity: 0.76;\n    animation: tjsSpotifyWave 1.15s ease-in-out infinite;\n  }\n\n  .tjs-divider-spotify span:nth-child(1) { height: 8px; animation-delay: 0s; }\n  .tjs-divider-spotify span:nth-child(2) { height: 16px; animation-delay: 0.08s; }\n  .tjs-divider-spotify span:nth-child(3) { height: 11px; animation-delay: 0.16s; }\n  .tjs-divider-spotify span:nth-child(4) { height: 20px; animation-delay: 0.24s; }\n  .tjs-divider-spotify span:nth-child(5) { height: 13px; animation-delay: 0.32s; }\n  .tjs-divider-spotify span:nth-child(6) { height: 22px; animation-delay: 0.40s; }\n  .tjs-divider-spotify span:nth-child(7) { height: 10px; animation-delay: 0.48s; }\n  .tjs-divider-spotify span:nth-child(8) { height: 17px; animation-delay: 0.56s; }\n  .tjs-divider-spotify span:nth-child(9) { height: 9px; animation-delay: 0.64s; }\n  .tjs-divider-spotify span:nth-child(10) { height: 18px; animation-delay: 0.72s; }\n\n  @keyframes tjsSpotifyWave {\n    0%, 100% {\n      transform: scaleY(0.55);\n      opacity: 0.42;\n    }\n    50% {\n      transform: scaleY(1);\n      opacity: 0.95;\n    }\n  }\n\n  .tjs-mood-content {\n    position: relative;\n    border-radius: 32px;\n    padding: 30px;\n    background: rgba(255, 255, 255, 0.62);\n    border: 1px solid rgba(23,23,23, 0.38);\n    box-shadow: 0 18px 38px rgba(47, 36, 32, 0.07);\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n    overflow: hidden;\n  }\n\n  .tjs-mood-content::before {\n    content: \"\";\n    position: absolute;\n    top: -80%;\n    left: -50%;\n    width: 110px;\n    height: 260%;\n    background: linear-gradient(110deg, transparent, rgba(255,255,255,0.68), transparent);\n    transform: rotate(18deg);\n    animation: tjsContentShine 6s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  @keyframes tjsContentShine {\n    0% {\n      left: -50%;\n      opacity: 0;\n    }\n    14% {\n      opacity: 0.65;\n    }\n    32% {\n      left: 120%;\n      opacity: 0;\n    }\n    100% {\n      left: 120%;\n      opacity: 0;\n    }\n  }\n\n  .tjs-mood-content-inner {\n    position: relative;\n    z-index: 1;\n  }\n\n  .tjs-mood-content-title {\n    margin: 0;\n    font-size: 32px;\n    line-height: 1.06;\n    letter-spacing: -1px;\n    color: var(--june-ink,#171717);\n    font-weight: 900;\n  }\n\n  .tjs-mood-content-text {\n    margin-top: 13px;\n    font-size: 14px;\n    line-height: 1.72;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-mood-feature-grid {\n    margin-top: 24px;\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 11px;\n  }\n\n  .tjs-mood-feature-card {\n    position: relative;\n    overflow: hidden;\n    min-height: 128px;\n    padding: 17px 15px;\n    border-radius: 22px;\n    background:\n      linear-gradient(135deg, rgba(255,255,255,0.78), rgba(255,247,243,0.72));\n    border: 1px solid rgba(23,23,23, 0.32);\n    box-shadow: 0 10px 22px rgba(47, 36, 32, 0.05);\n    transition: transform 0.24s ease, box-shadow 0.24s ease;\n  }\n\n  .tjs-mood-feature-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 16px 30px rgba(47, 36, 32, 0.09);\n  }\n\n  .tjs-mood-feature-icon {\n    width: 38px;\n    height: 38px;\n    margin-bottom: 12px;\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: currentColor;\n    box-shadow: 0 8px 16px rgba(47, 36, 32, 0.13);\n  }\n\n  .tjs-mood-feature-icon svg {\n    width: 19px;\n    height: 19px;\n    stroke: currentColor;\n    stroke-width: 1.9;\n    fill: none;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .tjs-mood-feature-title {\n    font-size: 13px;\n    line-height: 1.25;\n    color: var(--june-ink,#171717);\n    font-weight: 900;\n    margin-bottom: 6px;\n  }\n\n  .tjs-mood-feature-text {\n    font-size: 11.5px;\n    line-height: 1.48;\n    color: var(--june-muted,#656565);\n    font-weight: 500;\n  }\n\n  .tjs-mood-mini-player {\n    margin-top: 22px;\n    padding: 13px 14px;\n    border-radius: 20px;\n    background: linear-gradient(135deg, var(--june-dark,#171717), var(--june-surface,#F5F5F3));\n    color: var(--june-on-dark,#FFFFFF);\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    box-shadow: 0 14px 26px rgba(47, 36, 32, 0.14);\n  }\n\n  .tjs-mood-play-button {\n    width: 38px;\n    height: 38px;\n    min-width: 38px;\n    border-radius: 50%;\n    background: var(--june-bg,#FFFFFF);\n    color: var(--june-ink,#171717);\n    display: grid;\n    place-items: center;\n  }\n\n  .tjs-mood-play-button::before {\n    content: \"\";\n    margin-left: 3px;\n    width: 0;\n    height: 0;\n    border-top: 7px solid transparent;\n    border-bottom: 7px solid transparent;\n    border-left: 11px solid currentColor;\n  }\n\n  .tjs-mood-player-text {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .tjs-mood-player-title {\n    font-size: 12px;\n    line-height: 1.2;\n    font-weight: 900;\n  }\n\n  .tjs-mood-player-subtitle {\n    margin-top: 3px;\n    font-size: 10.5px;\n    line-height: 1.25;\n    color: rgba(255, 249, 243, 0.72);\n    font-weight: 600;\n  }\n\n  .tjs-mood-player-bars {\n    display: flex;\n    align-items: flex-end;\n    gap: 3px;\n    height: 22px;\n  }\n\n  .tjs-mood-player-bars span {\n    width: 3px;\n    border-radius: 999px;\n    background: var(--june-surface,#F5F5F3);\n    animation: tjsPlayerBars 1s ease-in-out infinite;\n  }\n\n  .tjs-mood-player-bars span:nth-child(1) { height: 8px; animation-delay: 0s; }\n  .tjs-mood-player-bars span:nth-child(2) { height: 18px; animation-delay: 0.12s; }\n  .tjs-mood-player-bars span:nth-child(3) { height: 12px; animation-delay: 0.24s; }\n  .tjs-mood-player-bars span:nth-child(4) { height: 21px; animation-delay: 0.36s; }\n  .tjs-mood-player-bars span:nth-child(5) { height: 10px; animation-delay: 0.48s; }\n\n  @keyframes tjsPlayerBars {\n    0%, 100% {\n      transform: scaleY(0.55);\n      opacity: 0.55;\n    }\n    50% {\n      transform: scaleY(1);\n      opacity: 1;\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    .tjs-monthly-mood-stage {\n      grid-template-columns: 1fr;\n    }\n\n    .tjs-mood-artboard {\n      min-height: 390px;\n    }\n\n    .tjs-divider-stack {\n      width: min(300px, 76%);\n      height: 350px;\n    }\n\n    .tjs-divider-month {\n      font-size: 28px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .tjs-monthly-mood-section {\n      margin: 28px -4px;\n      padding: 30px 12px;\n      border-radius: 26px;\n    }\n\n    .tjs-monthly-mood-head {\n      margin-bottom: 22px;\n    }\n\n    .tjs-monthly-mood-kicker {\n      font-size: 9.5px;\n      padding: 7px 10px;\n    }\n\n    .tjs-monthly-mood-title {\n      font-size: 31px;\n      line-height: 1.04;\n      letter-spacing: -1px;\n    }\n\n    .tjs-monthly-mood-subtitle {\n      font-size: 12.7px;\n      line-height: 1.58;\n      max-width: 94%;\n    }\n\n    .tjs-monthly-mood-stage {\n      gap: 14px;\n    }\n\n    .tjs-mood-artboard {\n      min-height: 320px;\n      padding: 20px;\n      border-radius: 24px;\n    }\n\n    .tjs-mood-floating-note {\n      font-size: 9.5px;\n      padding: 8px 10px;\n    }\n\n    .tjs-mood-floating-note.one {\n      left: 12px;\n      top: 14px;\n    }\n\n    .tjs-mood-floating-note.two {\n      right: 12px;\n      bottom: 14px;\n    }\n\n    .tjs-divider-stack {\n      width: min(230px, 72%);\n      height: 278px;\n    }\n\n    .tjs-divider-card {\n      border-radius: 20px;\n    }\n\n    .tjs-divider-card::before {\n      left: -9px;\n      top: 16px;\n      bottom: 16px;\n      width: 8px;\n    }\n\n    .tjs-divider-art {\n      inset: 18px 18px 94px;\n      border-radius: 17px;\n    }\n\n    .tjs-divider-month {\n      bottom: 62px;\n      font-size: 22px;\n    }\n\n    .tjs-divider-trait {\n      bottom: 43px;\n      font-size: 9.5px;\n    }\n\n    .tjs-divider-spotify {\n      bottom: 17px;\n      height: 16px;\n    }\n\n    .tjs-divider-spotify span {\n      width: 2.4px;\n    }\n\n    .tjs-mood-content {\n      padding: 22px 16px;\n      border-radius: 24px;\n      text-align: center;\n    }\n\n    .tjs-mood-content-title {\n      font-size: 25px;\n      line-height: 1.1;\n    }\n\n    .tjs-mood-content-text {\n      font-size: 12.6px;\n      line-height: 1.62;\n    }\n\n    .tjs-mood-feature-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 8px;\n      margin-top: 18px;\n    }\n\n    .tjs-mood-feature-card {\n      min-height: 130px;\n      padding: 14px 10px;\n      border-radius: 18px;\n    }\n\n    .tjs-mood-feature-icon {\n      width: 34px;\n      height: 34px;\n      margin: 0 auto 10px;\n    }\n\n    .tjs-mood-feature-icon svg {\n      width: 16px;\n      height: 16px;\n    }\n\n    .tjs-mood-feature-title {\n      font-size: 11.8px;\n    }\n\n    .tjs-mood-feature-text {\n      font-size: 10.2px;\n      line-height: 1.38;\n    }\n\n    .tjs-mood-mini-player {\n      padding: 12px;\n      border-radius: 18px;\n      text-align: left;\n    }\n\n    .tjs-mood-play-button {\n      width: 34px;\n      height: 34px;\n      min-width: 34px;\n    }\n\n    .tjs-mood-player-bars {\n      display: none;\n    }\n  }\n</style>\n\n<section class=\"tjs-monthly-mood-section\">\n  <div class=\"tjs-monthly-mood-container\">\n    <div class=\"tjs-monthly-mood-head\">\n      <div class=\"tjs-monthly-mood-kicker\">12 Monthly Dividers + Spotify Codes</div>\n      <h2 class=\"tjs-monthly-mood-title\">\n        Every month gets its own <span>main character mood</span>\n      </h2>\n      <div class=\"tjs-monthly-mood-subtitle\">\n        Illustrated dividers, affirmations, and curated Spotify codes turn every monthly reset into a little ritual — one page, one mood, one fresh start at a time.\n      </div>\n    </div>\n\n    <div class=\"tjs-monthly-mood-stage\">\n      <div class=\"tjs-mood-artboard\" aria-hidden=\"true\">\n        <span class=\"tjs-mood-blob one\"></span>\n        <span class=\"tjs-mood-blob two\"></span>\n        <span class=\"tjs-mood-blob three\"></span>\n\n        <div class=\"tjs-mood-floating-note one\">monthly affirmation</div>\n        <div class=\"tjs-mood-floating-note two\">curated playlist</div>\n\n        <div class=\"tjs-divider-stack\">\n          <div class=\"tjs-divider-card back\"></div>\n          <div class=\"tjs-divider-card mid\"></div>\n\n          <div class=\"tjs-divider-card front\">\n            <div class=\"tjs-divider-art\"></div>\n\n            <div class=\"tjs-divider-month\">January</div>\n            <div class=\"tjs-divider-trait\">main character energy</div>\n\n            <div class=\"tjs-divider-spotify\">\n              <span></span><span></span><span></span><span></span><span></span>\n              <span></span><span></span><span></span><span></span><span></span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"tjs-mood-content\">\n        <div class=\"tjs-mood-content-inner\">\n          <h3 class=\"tjs-mood-content-title\">\n            A monthly reset that feels like a vibe shift.\n          </h3>\n\n          <div class=\"tjs-mood-content-text\">\n            Before the planning begins, every month opens with a designed divider that sets the tone — with a main-character trait, an affirmation, and a Spotify code to soundtrack the version of you stepping into that month.\n          </div>\n\n          <div class=\"tjs-mood-feature-grid\">\n            <div class=\"tjs-mood-feature-card\">\n              <div class=\"tjs-mood-feature-icon\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M4 5h16v14H4z\"/>\n                  <path d=\"M8 9h8\"/>\n                  <path d=\"M8 13h5\"/>\n                </svg>\n              </div>\n              <div class=\"tjs-mood-feature-title\">Illustrated Dividers</div>\n              <div class=\"tjs-mood-feature-text\">A beautiful visual opening for all 12 months.</div>\n            </div>\n\n            <div class=\"tjs-mood-feature-card\">\n              <div class=\"tjs-mood-feature-icon\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M12 3l2.4 5.1L20 9l-4 4 1 5.8L12 16l-5 2.8L8 13 4 9l5.6-.9L12 3z\"/>\n                </svg>\n              </div>\n              <div class=\"tjs-mood-feature-title\">Trait Inspired</div>\n              <div class=\"tjs-mood-feature-text\">Main-character themes to match your evolving story.</div>\n            </div>\n\n            <div class=\"tjs-mood-feature-card\">\n              <div class=\"tjs-mood-feature-icon\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z\"/>\n                </svg>\n              </div>\n              <div class=\"tjs-mood-feature-title\">Affirmations</div>\n              <div class=\"tjs-mood-feature-text\">A gentle push before your monthly planning begins.</div>\n            </div>\n\n            <div class=\"tjs-mood-feature-card\">\n              <div class=\"tjs-mood-feature-icon\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M9 18V5l12-2v13\"/>\n                  <circle cx=\"6\" cy=\"18\" r=\"3\"/>\n                  <circle cx=\"18\" cy=\"16\" r=\"3\"/>\n                </svg>\n              </div>\n              <div class=\"tjs-mood-feature-title\">Spotify Codes</div>\n              <div class=\"tjs-mood-feature-text\">Curated songs to soundtrack your monthly reset.</div>\n            </div>\n          </div>\n\n          <div class=\"tjs-mood-mini-player\">\n            <div class=\"tjs-mood-play-button\"></div>\n            <div class=\"tjs-mood-player-text\">\n              <div class=\"tjs-mood-player-title\">Your month, on play.</div>\n              <div class=\"tjs-mood-player-subtitle\">Scan the Spotify code and set the tone.</div>\n            </div>\n            <div class=\"tjs-mood-player-bars\">\n              <span></span><span></span><span></span><span></span><span></span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
