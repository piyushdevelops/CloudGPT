th: 38px;\n    }\n  }\n</style>\n\n<section class=\"tjs-review-wall-section\">\n  <div class=\"tjs-review-wall-container\">\n    <div class=\"tjs-review-wall-head\">\n      <div class=\"tjs-review-wall-kicker\">Customer Love</div>\n\n      <h2 class=\"tjs-review-wall-title\">\n        Loved by <span>happy planners</span>\n      </h2>\n\n      <div class=\"tjs-review-wall-subtitle\">\n        From fresh starts to daily routines, this planner has become a favourite for customers who want their goals, memories and everyday plans in one beautiful place.\n      </div>\n    </div>\n\n    <div class=\"tjs-review-wall-stats\">\n      <div class=\"tjs-review-score-card\">\n        <div class=\"tjs-review-score-inner\">\n          <div class=\"tjs-review-score-stars\">★★★★★</div>\n\n          <div class=\"tjs-review-score-number\">\n            4.9<span>/5</span>\n          </div>\n\n          <div class=\"tjs-review-score-copy\">\n            Loved by <strong>175,000+ happy planners</strong> across India.\n          </div>\n\n          <div class=\"tjs-review-score-pills\">\n            <span class=\"tjs-review-score-pill\">India’s Most Loved</span>\n            <span class=\"tjs-review-score-pill\">Planner Favourite</span>\n            <span class=\"tjs-review-score-pill\">Free Sticker Book</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"tjs-review-cards-wrap\">\n        <div class=\"tjs-review-cards\">\n          <div class=\"tjs-review-card\">\n            <div class=\"tjs-review-card-stars\">★★★★★</div>\n            <div class=\"tjs-review-card-text\">\n              “This planner genuinely made me excited to start planning again. The pages feel thoughtful, not boring.”\n            </div>\n            <div class=\"tjs-review-card-author\">\n              <div class=\"tjs-review-avatar\">A</div>\n              <div>\n                <div class=\"tjs-review-name\">Anushka</div>\n                <div class=\"tjs-review-tag\">Verified Planner Buyer</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"tjs-review-card\">\n            <div class=\"tjs-review-card-stars\">★★★★★</div>\n            <div class=\"tjs-review-card-text\">\n              “The stickers, dividers and monthly pages are so cute. It feels like a planner and a memory book together.”\n            </div>\n            <div class=\"tjs-review-card-author\">\n              <div class=\"tjs-review-avatar\">R</div>\n              <div>\n                <div class=\"tjs-review-name\">Riya</div>\n                <div class=\"tjs-review-tag\">Verified Planner Buyer</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"tjs-review-card\">\n            <div class=\"tjs-review-card-stars\">★★★★★</div>\n            <div class=\"tjs-review-card-text\">\n              “I love that it’s undated. I don’t feel guilty if I miss a week. I just come back and restart.”\n            </div>\n            <div class=\"tjs-review-card-author\">\n              <div class=\"tjs-review-avatar\">S</div>\n              <div>\n                <div class=\"tjs-review-name\">Simran</div>\n                <div class=\"tjs-review-tag\">Verified Planner Buyer</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"tjs-review-card\">\n            <div class=\"tjs-review-card-stars\">★★★★★</div>\n            <div class=\"tjs-review-card-text\">\n              “The paper quality and gold binding feel premium. It looks beautiful on my desk and I actually use it daily.”\n            </div>\n            <div class=\"tjs-review-card-author\">\n              <div class=\"tjs-review-avatar\">M</div>\n              <div>\n                <div class=\"tjs-review-name\">Megha</div>\n                <div class=\"tjs-review-tag\">Verified Planner Buyer</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"tjs-review-footnote\">\n 