-on-dark,#FFFFFF);\n  font-size:13px;\n  font-weight:800;\n}\n\n.tjs-lp-item b{\n  color:currentColor;\n  font-weight:900;\n}\n\n.tjs-lp-icon{\n  color:currentColor;\n  font-size:14px;\n}\n\n.tjs-lp-lock{\n  flex-shrink:0;\n  background:var(--june-surface,#F5F5F3);\n  color:var(--june-ink,#171717);\n  border-radius:999px;\n  padding:7px 11px;\n  font-size:11px;\n  font-weight:950;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n  animation:tjs-lp-pop 2.2s ease-in-out infinite;\n}\n\n@keyframes tjs-lp-pop{\n  0%,100%{transform:scale(1);}\n  50%{transform:scale(1.04);}\n}\n\n/* MOBILE: clean message rotator instead of cramped ticker */\n.tjs-lp-mobile{\n  display:none;\n}\n\n@media(max-width:768px){\n  .tjs-lp-inner{\n    display:none;\n  }\n\n  .tjs-lp-mobile{\n    display:block;\n    position:relative;\n    z-index:2;\n    padding:11px 13px;\n  }\n\n  .tjs-lp-mobile-top{\n    display:flex;\n    align-items:center;\n    gap:7px;\n    color:currentColor;\n    font-size:10px;\n    font-weight:900;\n    letter-spacing:.13em;\n    text-transform:uppercase;\n    margin-bottom:5px;\n  }\n\n  .tjs-lp-mobile-message{\n    height:19px;\n    overflow:hidden;\n    position:relative;\n    color:var(--june-on-dark,#FFFFFF);\n    font-size:13px;\n    font-weight:800;\n    line-height:19px;\n  }\n\n  .tjs-lp-mobile-message span{\n    position:absolute;\n    inset:0;\n    opacity:0;\n    transform:translateY(8px);\n    animation:tjs-lp-swap 15s infinite;\n  }\n\n  .tjs-lp-mobile-message span:nth-child(1){animation-delay:0s;}\n  .tjs-lp-mobile-message span:nth-child(2){animation-delay:3s;}\n  .tjs-lp-mobile-message span:nth-child(3){animation-delay:6s;}\n  .tjs-lp-mobile-message span:nth-child(4){animation-delay:9s;}\n  .tjs-lp-mobile-message span:nth-child(5){animation-delay:12s;}\n\n  @keyframes tjs-lp-swap{\n    0%{opacity:0;transform:translateY(8px);}\n    6%{opacity:1;transform:translateY(0);}\n    18%{opacity:1;transform:translateY(0);}\n    25%,100%{opacity:0;transform: