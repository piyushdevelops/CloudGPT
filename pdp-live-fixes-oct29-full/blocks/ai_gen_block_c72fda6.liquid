{% doc %}
  @prompt
    preorder best selling headline on top
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-preorder-headline-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .ai-preorder-headline-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.background_gradient }};
    opacity: 1;
    z-index: 0;
  }

  .ai-preorder-headline__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.spacing }}px;
    flex-wrap: wrap;
  }

  .ai-preorder-headline__icon-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-preorder-headline__icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    fill: {{ block.settings.icon_color }};
  }

  .ai-preorder-headline__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    line-height: 1.4;
    margin: 0;
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  .ai-preorder-headline__text-{{ ai_gen_id }} strong {
    font-weight: 700;
  }

  .ai-preorder-headline__badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 12px;
    border-radius: {{ block.settings.badge_radius }}px;
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 749px) {
    .ai-preorder-headline-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-preorder-headline__content-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing_mobile }}px;
    }

    .ai-preorder-headline__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-preorder-headline__icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-preorder-headline__badge-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_text_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-preorder-headline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-preorder-headline__content-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <div class="ai-preorder-headline__icon-{{ ai_gen_id }}">
        {% if block.settings.custom_icon != blank %}
          {{ block.settings.custom_icon }}
        {% else %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
          </svg>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_badge %}
      <span class="ai-preorder-headline__badge-{{ ai_gen_id }}">
        {{ block.settings.badge_text }}
      </span>
    {% endif %}

    {% if block.settings.headline_text != blank %}
      <div class="ai-preorder-headline__text-{{ ai_gen_id }}">
        {{ block.settings.headline_text }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Preorder headline",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "headline_text",
      "label": "Headline text",
      "default": "<p><strong>Preorder Now</strong> - Best Selling Product Available Soon!</p>"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Preorder"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "html",
      "id": "custom_icon",
      "label": "Custom icon SVG"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Spacing between elements",
      "default": 12
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 15
    },
    {
      "type": "range",
      "id": "spacing_mobile",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Spacing between elements",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#55a653"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#55a653"
    },
    {
      "type": "header",
