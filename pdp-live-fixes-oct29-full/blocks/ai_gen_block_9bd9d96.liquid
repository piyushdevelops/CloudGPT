{% doc %}
  @prompt
    I want in announcement bar that has a button on the right that takes them to a different page, can we have 2-3 word divisions, so that each word can have different colour font or background colour that can switch colours or something to grab the attention, remove button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.text_alignment }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    width: 100%;
  }

  .ai-announcement-bar__content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.text_alignment }};
    gap: 8px;
    flex-wrap: wrap;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
  }

  .ai-announcement-bar__word-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.word_padding_vertical }}px {{ block.settings.word_padding_horizontal }}px;
    border-radius: {{ block.settings.word_border_radius }}px;
    font-weight: {{ block.settings.word_font_weight }};
    transition: all 0.4s ease;
  }

  .ai-announcement-bar__word-1-{{ ai_gen_id }} {
    color: {{ block.settings.word_1_text_color }};
    background-color: {{ block.settings.word_1_background_color }};
  }

  .ai-announcement-bar__word-2-{{ ai_gen_id }} {
    color: {{ block.settings.word_2_text_color }};
    background-color: {{ block.settings.word_2_background_color }};
  }

  .ai-announcement-bar__word-3-{{ ai_gen_id }} {
    color: {{ block.settings.word_3_text_color }};
    background-color: {{ block.settings.word_3_background_color }};
  }

  {% if block.settings.enable_color_switch %}
    @keyframes ai-word-switch-1-{{ ai_gen_id }} {
      0%, 100% {
        color: {{ block.settings.word_1_text_color }};
        background-color: {{ block.settings.word_1_background_color }};
      }
      50% {
        color: {{ block.settings.word_1_alt_text_color }};
        background-color: {{ block.settings.word_1_alt_background_color }};
      }
    }

    @keyframes ai-word-switch-2-{{ ai_gen_id }} {
      0%, 100% {
        color: {{ block.settings.word_2_text_color }};
        background-color: {{ block.settings.word_2_background_color }};
      }
      50% {
        color: {{ block.settings.word_2_alt_text_color }};
        background-color: {{ block.settings.word_2_alt_background_color }};
      }
    }

    @keyframes ai-word-switch-3-{{ ai_gen_id }} {
      0%, 100% {
        color: {{ block.settings.word_3_text_color }};
        background-color: {{ block.settings.word_3_background_color }};
      }
      50% {
        color: {{ block.settings.word_3_alt_text_color }};
        background-color: {{ block.settings.word_3_alt_background_color }};
      }
    }

    .ai-announcement-bar__word-1-{{ ai_gen_id }} {
      animation: ai-word-switch-1-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite;
    }

    .ai-announcement-bar__word-2-{{ ai_gen_id }} {
      animation: ai-word-switch-2-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite;
      animation-delay: {{ block.settings.animation_delay }}s;
    }

    .ai-announcement-bar__word-3-{{ ai_gen_id }} {
      animation: ai-word-switch-3-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite;
      animation-delay: calc({{ block.settings.animation_delay }}s * 2);
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-announcement-bar__content-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<div class="ai-announcement-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-bar__content-{{ ai_gen_id }}">
    {% if block.settings.word_1 != blank %}
      <span class="ai-announcement-bar__word-{{ ai_gen_id }} ai-announcement-bar__word-1-{{ ai_gen_id }}">
        {{ block.settings.word_1 }}
      </span>
    {% endif %}

    {% if block.settings.word_2 != blank %}
      <span class="ai-announcement-bar__word-{{ ai_gen_id }} ai-announcement-bar__word-2-{{ ai_gen_id }}">
        {{ block.settings.word_2 }}
      </span>
    {% endif %}

    {% if block.settings.word_3 != blank %}
      <span class="ai-announcement-bar__word-{{ ai_gen_id }} ai-announcement-bar__word-3-{{ ai_gen_id }}">
        {{ block.settings.word_3 }}
      </span>
    {% endif %}
  </div>
</div>

