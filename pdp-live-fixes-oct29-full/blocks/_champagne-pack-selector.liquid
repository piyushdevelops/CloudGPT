<script>
  (() => {
    if (customElements.get('tjs-champagne-pack-block-v5')) return;

    class TJSChampagnePackBlockV5 extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready === 'true') return;
        this.dataset.ready = 'true';

        this.formId = this.dataset.formId || '';
        this.productId = Number(this.dataset.productId || 0);
        this.baseItems = Math.max(1, Number(this.dataset.baseItems || 2));
        this.defaultPack = this.dataset.defaultPack || '2';
        this.syncQuantity = this.dataset.syncQuantity === 'true';
        this.passProperty = this.dataset.passProperty === 'true';
        this.propertyName = this.dataset.propertyName || 'Bundle';
        this.addLabelText = this.dataset.addLabel || 'Add selected set';
        this.showCompare = this.dataset.showCompare === 'true';
        this.showSavings = this.dataset.showSavings === 'true';
        this.showPerItem = this.dataset.showPerItem === 'true';
        this.moneyFormat = this.dataset.moneyFormat || '${{amount}}';
        this.currency = this.dataset.currency || 'INR';
        this.syncingQuantity = false;
        this.nativeInputSetter = Object.getOwnPropertyDescriptor(
          window.HTMLInputElement.prototype,
          'value'
        )?.set || null;

        try {
          this.variants = JSON.parse(
            this.querySelector('[data-cps-variants]')?.textContent || '[]'
          );
        } catch (error) {
          this.variants = [];
        }

        try {
          this.optionNames = JSON.parse(
            this.querySelector('[data-cps-option-names]')?.textContent || '[]'
          );
        } catch (error) {
          this.optionNames = [];
        }

        this.variantIds = new Set(
          this.variants.map(variant => Number(variant.id))
        );

        this.options = [...this.querySelectorAll('[data-cps-option]')];
        this.summary = this.querySelector('[data-cps-summary]');
        this.variantNode = this.querySelector('[data-cps-variant]');
        this.addButton = this.querySelector('[data-cps-add]');
        this.addLabel = this.querySelector('[data-cps-add-label]');

        this.selectedOption =
          this.options.find(item => item.dataset.packKey === this.defaultPack) ||
          this.options[0] ||
          null;

        this.currentVariant =
          this.readVariant() ||
          this.variants.find(item => item.available) ||
          this.variants[0] ||
          null;

        this.options.forEach(option => {
          option.addEventListener('click', () => {
            this.selectOption(option, true);
          });
        });

        this.addButton?.addEventListener('click', () => {
          this.triggerNativeAdd();
        });

        this.boundChange = event => {
          if (
            event.target.matches('[name="id"]') ||
            event.target.matches('select') ||
            event.target.matches('input[type="radio"]')
          ) {
            window.setTimeout(() => this.syncVariant(), 30);
          }

          if (
            this.isVisibleQuantityInput(event.target) &&
            !this.syncingQuantity
          ) {
            this.selectFromQuantity(event.target.value);
          }
        };

        /*
          Capture custom and native Add to Cart clicks before their own
          handlers run. This is essential because the current PDP button is
          a proxy that subsequently clicks the Ecomus sticky product form.
        */
        this.boundAddClick = event => {
          const trigger = event.target.closest(
            '[data-tjs-custom-atc], ' +
            '[data-cps-add], ' +
            'button[type="submit"][name="add"], ' +
            'button[name="add"], ' +
            '[data-add-to-cart]'
          );

          if (!trigger) return;
          if (!this.isRelevantAddTrigger(trigger)) return;

          this.applyQuantityEverywhere(false);
          this.syncBundlePropertyEverywhere();
        };

        /*
          Capture form submission before Ecomus ProductForm creates FormData.
          The submitted form therefore always contains quantity 1 / 2 / 3.
        */
        this.boundSubmit = event => {
          const form = event.target;
          if (!this.isMatchingProductForm(form)) return;

          this.applyQuantityToForm(form, false);
          this.syncBundleProperty(form);
        };

        document.addEventListener('change', this.boundChange, true);
        document.addEventListener('input', this.boundChange, true);
        document.addEventListener('click', this.boundAddClick, true);
        document.addEventListener('submit', this.boundSubmit, true);

        [
          'variant:change',
          'variant:changed',
          'variant:update',
          'product:variant-change',
          'hdt:variant:change',
          'hdt:variant-changed'
        ].forEach(eventName => {
          document.addEventListener(eventName, event => {
            const source =
              event.detail?.variant ||
              event.detail?.productVariant ||
              event.detail;

            const id = Number(source?.id || source?.variant_id || 0);
            const variant = this.variants.find(
              item => Number(item.id) === id
            );

            if (variant) this.setVariant(variant);
            else window.setTimeout(() => this.syncVariant(), 30);
          });
        });

        this.productObserver = new MutationObserver(() => {
          this.applyQuantityEverywhere(false);
          this.syncBundlePropertyEverywhere();
          this.updateAddState();
        });

        const observationRoot =
          this.closest('.hdt-main-product-wrap') ||
          this.closest('.shopify-section');

        if (observationRoot) {
          this.productObserver.observe(observationRoot, {
            childList: true,
            subtree: true
          });
        }

        this.syncTimer = window.setInterval(() => {
          if (!document.documentElement.contains(this)) {
            window.clearInterval(this.syncTimer);
            return;
          }

          this.syncVariant();
          this.applyQuantityEverywhere(false);
          this.syncBundlePropertyEverywhere();
          this.updateAddState();
        }, 500);

        this.selectOption(this.selectedOption, false);
      }

      disconnectedCallback() {
        window.clearInterval(this.syncTimer);
        this.productObserver?.disconnect();
        document.removeEventListener('change', this.boundChange, true);
        document.removeEventListener('input', this.boundChange, true);
        document.removeEventListener('click', this.boundAddClick, true);
        document.removeEventListener('submit', this.boundSubmit, true);
      }

      get productRoot() {
        return (
          this.closest('.hdt-main-product-wrap') ||
          this.closest('.hdt-section--feature-product') ||
          this.closest('.shopify-section') ||
          document
        );
      }

      formCandidates() {
        const forms = [];
        const add = form => {
          if (
            form instanceof HTMLFormElement &&
            !form.closest('#CartDrawer, cart-drawer, hdt-cart-drawer') &&
            !forms.includes(form)
          ) {
            forms.push(form);
          }
        };

        add(document.getElementById(this.formId));
        add(document.getElementById(`form-product-sticky${this.productId}`));

        const scopes = [this.productRoot, document];

        scopes.forEach(scope => {
          scope
            .querySelectorAll?.(
              'form[action*="/cart/add"], ' +
              'form[id^="product-form-"], ' +
              'form[id^="form-product-sticky"]'
            )
            .forEach(add);
        });

        const matching = forms.filter(form => this.isMatchingProductForm(form));
        return matching.length ? matching : forms.slice(0, 1);
      }

      get form() {
        return this.formCandidates()[0] || null;
      }

      isMatchingProductForm(form) {
        if (!(form instanceof HTMLFormElement)) return false;
        if (form.closest('#CartDrawer, cart-drawer, hdt-cart-drawer')) return false;

        if (form.id === this.formId) return true;
        if (form.id === `form-product-sticky${this.productId}`) return true;

        const productInput = form.querySelector('[name="product-id"]');
        if (Number(productInput?.value || 0) === this.productId) return true;

        const variantInput = form.querySelector('[name="id"]');
        return this.variantIds.has(Number(variantInput?.value || 0));
      }

      readVariant() {
        for (const form of this.formCandidates()) {
          const input = form.querySelector('[name="id"]');
          const id = Number(input?.value || 0);
          const variant = this.variants.find(
            item => Number(item.id) === id
          );
          if (variant) return variant;
        }

        const urlId = Number(
          new URL(window.location.href).searchParams.get('variant') || 0
        );

        return this.variants.find(item => Number(item.id) === urlId) || null;
      }

      syncVariant() {
        const variant = this.readVariant();
        if (variant) this.setVariant(variant);
      }

      setVariant(variant) {
        if (
          !variant ||
          Number(variant.id) === Number(this.currentVariant?.id)
        ) {
          return;
        }

        this.currentVariant = variant;
        this.render();
        this.applyQuantityEverywhere(false);
        this.syncBundlePropertyEverywhere();
      }

      selectOption(option, scroll) {
        if (!option) return;

        this.selectedOption = option;

        this.options.forEach(item => {
          const active = item === option;
          item.classList.toggle('is-selected', active);
          item.setAttribute('aria-checked', active ? 'true' : 'false');
        });

        this.render();
        this.applyQuantityEverywhere(true);
        this.syncBundlePropertyEverywhere();

        if (scroll) {
          option.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'auto'
              : 'smooth',
            block: 'nearest',
            inline: 'center'
          });
        }
      }

      multiplier() {
        return Math.max(
          1,
          Number(this.selectedOption?.dataset.multiplier || 1)
        );
      }

      bundleTitle() {
        return (
          this.selectedOption?.dataset.title ||
          `Set of ${this.baseItems * this.multiplier()}`
        );
      }

      isPackOptionName(name) {
        const normalized = String(name || '').toLowerCase().trim();
        return (
          normalized === 'title' ||
          normalized === 'qty' ||
          normalized.includes('set') ||
          normalized.includes('pack') ||
          normalized.includes('quantity')
        );
      }

      meaningfulVariantText() {
        if (!this.currentVariant) return '';

        return (this.currentVariant.options || [])
          .filter((value, index) => !this.isPackOptionName(this.optionNames[index]))
          .filter(Boolean)
          .join(' · ');
      }

      render() {
        if (!this.currentVariant) return;

        this.options.forEach(option => {
          const multiplier = Math.max(
            1,
            Number(option.dataset.multiplier || 1)
          );
          const discount = Math.max(
            0,
            Number(option.dataset.discount || 0)
          );
          const totalItems = this.baseItems * multiplier;
          const fullTotal = Number(this.currentVariant.price || 0) * multiplier;
          const displayTotal = Math.round(
            fullTotal * (100 - discount) / 100
          );

          let compareTotal =
            Number(this.currentVariant.compare_at_price || 0) * multiplier;

          if (compareTotal <= displayTotal && discount > 0) {
            compareTotal = fullTotal;
          }

          const saving = Math.max(0, compareTotal - displayTotal);
          const perItem = totalItems
            ? Math.round(displayTotal / totalItems)
            : displayTotal;

          const price = option.querySelector('[data-cps-price]');
          const compare = option.querySelector('[data-cps-compare]');
          const perItemNode = option.querySelector('[data-cps-per-item]');
          const savingNode = option.querySelector('[data-cps-saving]');

          if (price) price.textContent = this.money(displayTotal);

          if (compare) {
            const show = this.showCompare && compareTotal > displayTotal;
            compare.hidden = !show;
            compare.textContent = show ? this.money(compareTotal) : '';
          }

          if (perItemNode) {
            perItemNode.hidden = !this.showPerItem;
            perItemNode.textContent = `${this.money(perItem)} per glass`;
          }

          if (savingNode) {
            const show = this.showSavings && saving > 0;
            savingNode.hidden = !show;
            savingNode.textContent = show
              ? `Save ${this.money(saving)}`
              : '';
          }
        });

        if (this.summary) {
          this.summary.textContent =
            `${this.bundleTitle()} · ${this.baseItems * this.multiplier()} glasses`;
        }

        if (this.variantNode) {
          const variantText = this.meaningfulVariantText();
          this.variantNode.textContent = variantText;
          this.variantNode.closest('.tjs-cps__variant').hidden = !variantText;
        }

        this.updateAddState();
      }

      visibleQuantityInputs() {
        const inputs = [];
        const productInfo = this.closest('.hdt-product-info__list');
        const root = productInfo || this.productRoot;

        root
          .querySelectorAll?.(
            '[data-tjs-qty-input], ' +
            '.hdt-quantity__input, ' +
            '[data-quantity-input], ' +
            'input[data-quantity]'
          )
          .forEach(input => {
            if (
              input instanceof HTMLInputElement &&
              !input.closest('#CartDrawer, cart-drawer, hdt-cart-drawer')
            ) {
              inputs.push(input);
            }
          });

        return [...new Set(inputs)];
      }

      isVisibleQuantityInput(element) {
        return this.visibleQuantityInputs().includes(element);
      }

      selectFromQuantity(value) {
        const quantity = Math.max(1, Number(value || 1));
        const option = this.options.find(
          item => Number(item.dataset.multiplier) === quantity
        );

        if (option && option !== this.selectedOption) {
          this.selectOption(option, false);
        }
      }

      formQuantityInputs(form) {
        const inputs = [...form.querySelectorAll('[name="quantity"]')];

        if (form.id) {
          document
            .querySelectorAll(
              `[name="quantity"][form="${CSS.escape(form.id)}"]`
            )
            .forEach(input => inputs.push(input));
        }

        return [...new Set(inputs)].filter(
          input => input instanceof HTMLInputElement
        );
      }

      setInputValue(input, value, dispatch = true) {
        if (!(input instanceof HTMLInputElement)) return;

        const stringValue = String(value);
        const changed = input.value !== stringValue;

        try {
          if (this.nativeInputSetter) {
            this.nativeInputSetter.call(input, stringValue);
          } else {
            input.value = stringValue;
          }
        } catch (error) {
          input.value = stringValue;
        }

        input.setAttribute('value', stringValue);
        input.dataset.quantityValue = stringValue;

        if (dispatch && changed) {
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      applyQuantityToForm(form, dispatch = true) {
        if (!this.syncQuantity || !this.isMatchingProductForm(form)) {
          return false;
        }

        const quantity = this.multiplier();
        let inputs = this.formQuantityInputs(form);

        if (!inputs.length) {
          const hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'quantity';
          hidden.dataset.cpsAuthoritativeQuantity = 'true';
          form.prepend(hidden);
          inputs = [hidden];
        }

        inputs.forEach(input => {
          this.setInputValue(input, quantity, dispatch);
        });

        form.dataset.cpsPackQuantity = String(quantity);
        return true;
      }

      applyQuantityEverywhere(dispatch = true) {
        if (!this.syncQuantity) return false;

        const quantity = this.multiplier();
        this.syncingQuantity = true;

        this.visibleQuantityInputs().forEach(input => {
          this.setInputValue(input, quantity, dispatch);
        });

        const forms = this.formCandidates();
        forms.forEach(form => {
          this.applyQuantityToForm(form, dispatch);
        });

        if (dispatch) {
          document.dispatchEvent(
            new CustomEvent('quantity-selector:update', {
              bubbles: true,
              detail: {
                quantity,
                source: 'champagne-pack-picker'
              }
            })
          );
        }

        window.setTimeout(() => {
          this.syncingQuantity = false;
        }, 0);

        return forms.length > 0;
      }

      syncBundleProperty(form) {
        if (!this.passProperty || !this.isMatchingProductForm(form)) return;

        const name = `properties[${this.propertyName}]`;
        let property = [
          ...form.querySelectorAll('input[name^="properties["]')
        ].find(input => input.name === name);

        if (!property) {
          property = document.createElement('input');
          property.type = 'hidden';
          property.name = name;
          form.appendChild(property);
        }

        property.value = this.bundleTitle();
      }

      syncBundlePropertyEverywhere() {
        this.formCandidates().forEach(form => {
          this.syncBundleProperty(form);
        });
      }

      isRelevantAddTrigger(trigger) {
        if (this.contains(trigger)) return true;
        if (trigger.closest('#CartDrawer, cart-drawer, hdt-cart-drawer')) {
          return false;
        }

        if (trigger.matches('[data-tjs-custom-atc]')) {
          return Boolean(trigger.closest('.hdt-product-info__list'));
        }

        const form = trigger.form || trigger.closest('form');
        return this.isMatchingProductForm(form);
      }

      updateAddState() {
        if (!this.addButton) return;

        const available = Boolean(this.currentVariant?.available);
        const hasDestination =
          this.formCandidates().length > 0 ||
          Boolean(
            this.closest('.hdt-product-info__list')?.querySelector(
              '[data-tjs-custom-atc]'
            )
          );

        this.addButton.disabled = !available || !hasDestination;

        if (
          this.addLabel &&
          !this.addButton.classList.contains('is-loading')
        ) {
          this.addLabel.textContent = available
            ? this.addLabelText
            : 'Sold out';
        }
      }

      triggerNativeAdd() {
        if (!this.currentVariant?.available) return;

        this.applyQuantityEverywhere(false);
        this.syncBundlePropertyEverywhere();

        const productInfo = this.closest('.hdt-product-info__list');
        const proxy = productInfo?.querySelector(
          '[data-tjs-custom-atc]:not([disabled])'
        );

        const nativeButtons = this.formCandidates().flatMap(form =>
          [...form.querySelectorAll(
            'button[type="submit"], [name="add"], [data-add-to-cart]'
          )]
        );

        const nativeButton =
          nativeButtons.find(button => !button.disabled && button.offsetParent !== null) ||
          nativeButtons.find(button => !button.disabled);

        const target = proxy || nativeButton;
        if (!target) return;

        this.addButton?.classList.add('is-loading');
        if (this.addLabel) this.addLabel.textContent = 'Adding…';

        target.click();

        window.setTimeout(() => {
          this.addButton?.classList.remove('is-loading');
          if (this.addLabel) {
            this.addLabel.textContent = this.addLabelText;
          }
        }, 1400);
      }

      money(cents) {
        if (window.Shopify?.formatMoney) {
          try {
            return window.Shopify.formatMoney(
              Number(cents || 0),
              this.moneyFormat
            );
          } catch (error) {}
        }

        return new Intl.NumberFormat('en-IN', {
          style: 'currency',
          currency: this.currency,
          maximumFractionDigits: 0
        }).format(Number(cents || 0) / 100);
      }
    }

    customElements.define(
      'tjs-champagne-pack-block-v5',
      TJSChampagnePackBlockV5
    );
  })();
</script>

