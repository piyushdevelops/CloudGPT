{% comment %}
  TJS Champagne Pack Picker — Native Quantity Bridge V5

  Base SKU logic:
  - Set of 2 = native quantity 1
  - Set of 4 = native quantity 2
  - Set of 6 = native quantity 3

  This block does not call Shopify's Cart API.
  It synchronises and optionally submits the existing native Ecomus
  product form: product-form-{{ section.id }}{{ product.id }}
{% endcomment %}

{% liquid
  assign cps_product = product
  if cps_product == blank and section.settings.product != blank
    assign cps_product = section.settings.product
  endif

  assign cps_variant = cps_product.selected_or_first_available_variant
  assign cps_form_id = 'product-form-' | append: section.id | append: cps_product.id
  assign cps_base_items = block.settings.base_items_per_pack

  assign cps_context_count = 0
  capture cps_variant_context_text
    for cps_product_option in cps_product.options_with_values
      assign cps_option_name_downcase = cps_product_option.name | downcase | strip
      assign cps_option_is_pack = false

      if cps_option_name_downcase == 'title' or cps_option_name_downcase contains 'set' or cps_option_name_downcase contains 'pack' or cps_option_name_downcase contains 'quantity' or cps_option_name_downcase == 'qty'
        assign cps_option_is_pack = true
      endif

      unless cps_option_is_pack
        if cps_context_count > 0
          echo ' · '
        endif
        echo cps_product_option.selected_value
        assign cps_context_count = cps_context_count | plus: 1
      endunless
    endfor
  endcapture
%}

{% if cps_product != blank and cps_variant != blank %}
  <tjs-champagne-pack-block-v5
    id="TjsChampagnePack-{{ block.id }}"
    class="tjs-cps"
    data-form-id="{{ cps_form_id }}"
    data-product-id="{{ cps_product.id }}"
    data-base-items="{{ cps_base_items }}"
    data-default-pack="{{ block.settings.default_pack }}"
    data-sync-quantity="{{ block.settings.sync_main_quantity }}"
    data-pass-property="{{ block.settings.pass_bundle_property }}"
    data-property-name="{{ block.settings.bundle_property_name | escape }}"
    data-add-label="{{ block.settings.add_button_label | escape }}"
    data-show-compare="{{ block.settings.show_compare_price }}"
    data-show-savings="{{ block.settings.show_savings }}"
    data-show-per-item="{{ block.settings.show_per_item_price }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
    {{ block.shopify_attributes }}
    style="
      --cps-bg: {{ block.settings.background }};
      --cps-card: {{ block.settings.card_background }};
      --cps-selected: {{ block.settings.selected_background }};
      --cps-text: {{ block.settings.text_color }};
      --cps-muted: {{ block.settings.muted_color }};
      --cps-border: {{ block.settings.border_color }};
      --cps-accent: {{ block.settings.accent_color }};
      --cps-soft: {{ block.settings.accent_soft }};
      --cps-button: {{ block.settings.button_background }};
      --cps-button-text: {{ block.settings.button_text }};
      --cps-radius: {{ block.settings.card_radius }}px;
      --cps-gap: {{ block.settings.card_gap }}px;
      --cps-mobile-width: {{ block.settings.mobile_card_width }}%;
    "
  >
    <script type="application/json" data-cps-variants>
      [
        {% for variant in cps_product.variants %}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
            "options": {{ variant.options | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>

    <script type="application/json" data-cps-option-names>
      {{ cps_product.options | json }}
    </script>

    <header class="tjs-cps__head">
      {% if block.settings.eyebrow != blank %}
        <p class="tjs-cps__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h3 class="tjs-cps__heading">{{ block.settings.heading | escape }}</h3>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="tjs-cps__subheading">{{ block.settings.subheading | escape }}</p>
      {% endif %}

      <div class="tjs-cps__utility-row">
        {% if block.settings.show_selected_summary %}
          <span class="tjs-cps__summary">
            <span>{{ block.settings.selected_summary_label | escape }}</span>
            <strong data-cps-summary></strong>
          </span>
        {% endif %}

        {% if block.settings.show_variant_context and cps_context_count > 0 %}
          <span class="tjs-cps__variant">
            <span>{{ block.settings.variant_context_label | escape }}</span>
            <strong data-cps-variant>{{ cps_variant_context_text | strip | escape }}</strong>
          </span>
        {% endif %}
      </div>
    </header>

    <div class="tjs-cps__grid" role="radiogroup" aria-label="Choose your Champagne Glass set">
      {% for cps_index in (1..3) %}
        {% liquid
          case cps_index
            when 1
              assign cps_title = 'Set of 2'
              assign cps_multiplier = 1
            when 2
              assign cps_title = 'Set of 4'
              assign cps_multiplier = 2
            else
              assign cps_title = 'Set of 6'
              assign cps_multiplier = 3
          endcase

          assign cps_image_key = 'pack_' | append: cps_index | append: '_image'
          assign cps_badge_key = 'pack_' | append: cps_index | append: '_badge'
          assign cps_badge_style_key = 'pack_' | append: cps_index | append: '_badge_style'
          assign cps_discount_key = 'pack_' | append: cps_index | append: '_discount'

          assign cps_image = block.settings[cps_image_key]
          assign cps_badge = block.settings[cps_badge_key]
          assign cps_badge_style = block.settings[cps_badge_style_key]
          assign cps_discount = block.settings[cps_discount_key]

          if cps_image == blank
            assign cps_image = cps_product.featured_image
          endif

          assign cps_image_alt = cps_image.alt | default: cps_title
          assign cps_total_items = cps_base_items | times: cps_multiplier
          assign cps_full_total = cps_variant.price | times: cps_multiplier
          assign cps_discount_factor = 100 | minus: cps_discount
          assign cps_display_total = cps_full_total | times: cps_discount_factor | divided_by: 100

          assign cps_compare_total = cps_variant.compare_at_price | times: cps_multiplier
          if cps_compare_total <= cps_display_total and cps_discount > 0
            assign cps_compare_total = cps_full_total
          endif

          assign cps_saving = cps_compare_total | minus: cps_display_total
          assign cps_per_item = cps_display_total | divided_by: cps_total_items
        %}

        <button
          type="button"
          class="tjs-cps__option"
          role="radio"
          aria-checked="false"
          data-cps-option
          data-pack-key="{{ cps_index }}"
          data-title="{{ cps_title }}"
          data-multiplier="{{ cps_multiplier }}"
          data-discount="{{ cps_discount }}"
        >
          {% if cps_badge != blank %}
            <span class="tjs-cps__badge" data-style="{{ cps_badge_style }}">
              {{ cps_badge | escape }}
            </span>
          {% endif %}

          <span class="tjs-cps__check" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none">
              <path d="m5 10 3.2 3.2L15 6.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>

          <span class="tjs-cps__pack-hero">
            <strong class="tjs-cps__pack-number">{{ cps_total_items }}</strong>
            <span class="tjs-cps__pack-unit">glasses</span>
          </span>

          <span class="tjs-cps__media">
            {% if cps_image != blank %}
              {{ cps_image
                | image_url: width: 520
                | image_tag:
                  class: 'tjs-cps__image',
                  widths: '120,180,240,320,420,520',
                  sizes: '(max-width: 749px) 28vw, 160px',
                  loading: 'lazy',
                  alt: cps_image_alt
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'tjs-cps__placeholder' }}
            {% endif %}
          </span>

          <span class="tjs-cps__content">
            <strong class="tjs-cps__title">{{ cps_title }}</strong>
            <span class="tjs-cps__caption">
              {% case cps_index %}
                {% when 1 %}Perfect for two
                {% when 2 %}Made for sharing
                {% else %}Best for hosting
              {% endcase %}
            </span>

            <span class="tjs-cps__price">
              <strong data-cps-price>{{ cps_display_total | money }}</strong>
              <s
                data-cps-compare
                {% unless block.settings.show_compare_price and cps_compare_total > cps_display_total %}hidden{% endunless %}
              >
                {% if cps_compare_total > cps_display_total %}
                  {{ cps_compare_total | money }}
                {% endif %}
              </s>
            </span>

            <span
              class="tjs-cps__per-item"
              data-cps-per-item
              {% unless block.settings.show_per_item_price %}hidden{% endunless %}
            >
              {{ cps_per_item | money }} per glass
            </span>

            <span
              class="tjs-cps__saving"
              data-cps-saving
              {% unless block.settings.show_savings and cps_saving > 0 %}hidden{% endunless %}
            >
              {% if cps_saving > 0 %}
                Save {{ cps_saving | money_without_trailing_zeros }}
              {% endif %}
            </span>
          </span>
        </button>
      {% endfor %}
    </div>

    <footer class="tjs-cps__footer">
      {% if block.settings.show_add_button %}
        <button
          type="button"
          class="tjs-cps__add"
          data-cps-add
          {% unless cps_variant.available %}disabled{% endunless %}
        >
          <span data-cps-add-label>
            {% if cps_variant.available %}
              {{ block.settings.add_button_label | escape }}
            {% else %}
              Sold out
            {% endif %}
          </span>
          <span aria-hidden="true">→</span>
        </button>
      {% endif %}

      {% if block.settings.note != blank %}
        <p class="tjs-cps__note">{{ block.settings.note | escape }}</p>
      {% endif %}
    </footer>
  </tjs-champagne-pack-block-v5>
{% elsif request.design_mode %}
  <div class="tjs-cps tjs-cps--empty" {{ block.shopify_attributes }}>
    This block requires a product.
  </div>
{% endif %}

{% style %}
  #TjsChampagnePack-{{ block.id }} {
    width: 100%;
    display: block;
    margin-block: {{ block.settings.margin_top }}px {{ block.settings.margin_bottom }}px;
    padding: {{ block.settings.block_padding }}px;
    border: 0;
    border-radius: calc(var(--cps-radius) + 8px);
    background: var(--cps-bg);
    color: var(--cps-text);
    box-shadow: none;
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  }

  #TjsChampagnePack-{{ block.id }} *,
  #TjsChampagnePack-{{ block.id }} *::before,
  #TjsChampagnePack-{{ block.id }} *::after {
    box-sizing: border-box;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__head {
    display: grid;
    gap: 7px;
    margin-bottom: 16px;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__eyebrow {
    margin: 0;
    color: var(--cps-accent);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .16em;
    line-height: 1;
    text-transform: uppercase;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__heading {
    max-width: 15ch;
    margin: 0;
    color: var(--cps-text);
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 950;
    line-height: .96;
    letter-spacing: -.055em;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__subheading {
    max-width: 46ch;
    margin: 0;
    color: var(--cps-muted);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.48;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__utility-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__variant,
  #TjsChampagnePack-{{ block.id }} .tjs-cps__summary {
    width: fit-content;
    min-height: 29px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0 10px;
    border: 1px solid var(--cps-border);
    border-radius: 999px;
    background: #fff;
    color: var(--cps-muted);
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__variant strong,
  #TjsChampagnePack-{{ block.id }} .tjs-cps__summary strong {
    color: var(--cps-text);
    font-weight: 850;
  }

  /* One connected pricing table rather than three image cards. */
  #TjsChampagnePack-{{ block.id }} .tjs-cps__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    overflow: visible;
    border: 1px solid var(--cps-border);
    border-radius: var(--cps-radius);
    background: var(--cps-card);
    box-shadow: 0 16px 40px rgba(24, 18, 15, .08);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option {
    position: relative;
    min-width: 0;
    min-height: 310px;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: visible;
    padding: 21px 12px 13px;
    border: 0;
    border-right: 1px solid var(--cps-border);
    border-radius: 0;
    background: transparent;
    color: var(--cps-text);
    cursor: pointer;
    font: inherit;
    text-align: center;
    transition: transform .22s ease, background-color .22s ease, color .22s ease, box-shadow .22s ease;
    -webkit-tap-highlight-color: transparent;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option:first-child {
    border-radius: var(--cps-radius) 0 0 var(--cps-radius);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option:last-child {
    border-right: 0;
    border-radius: 0 var(--cps-radius) var(--cps-radius) 0;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option:hover {
    background: color-mix(in srgb, var(--cps-soft) 58%, #fff);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option.is-selected {
    z-index: 3;
    margin: -8px -1px;
    padding-top: 29px;
    padding-bottom: 21px;
    border-radius: calc(var(--cps-radius) + 2px);
    background:
      radial-gradient(circle at 50% -12%, rgba(255,255,255,.24), transparent 36%),
      var(--cps-accent);
    color: #fff;
    box-shadow: 0 22px 48px color-mix(in srgb, var(--cps-accent) 34%, transparent);
    transform: translateY(-2px);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__badge {
    position: absolute;
    z-index: 5;
    top: -12px;
    left: 50%;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--cps-text);
    color: #fff;
    box-shadow: 0 8px 18px rgba(24, 18, 15, .16);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__badge[data-style="popular"] { background: #27202f; }
  #TjsChampagnePack-{{ block.id }} .tjs-cps__badge[data-style="value"] { background: #ff4f84; }
  #TjsChampagnePack-{{ block.id }} .tjs-cps__badge[data-style="soft"] { background: #a990c7; }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__check {
    position: absolute;
    z-index: 4;
    top: 10px;
    right: 10px;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border: 1px solid var(--cps-border);
    border-radius: 50%;
    background: #fff;
    color: transparent;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option.is-selected .tjs-cps__check {
    border-color: rgba(255,255,255,.55);
    background: #fff;
    color: var(--cps-accent);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__check svg {
    width: 12px;
    height: 12px;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__pack-hero {
    display: grid;
    justify-items: center;
    gap: 0;
    margin-top: 3px;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__pack-number {
    font-size: clamp(40px, 5.2vw, 64px);
    font-weight: 950;
    line-height: .82;
    letter-spacing: -.075em;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__pack-unit {
    margin-top: 5px;
    color: var(--cps-muted);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option.is-selected .tjs-cps__pack-unit {
    color: rgba(255,255,255,.74);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__media {
    width: min(100%, 112px);
    height: 78px;
    display: grid;
    place-items: center;
    margin: 8px auto 3px;
    overflow: hidden;
    border-radius: 14px;
    background: color-mix(in srgb, var(--cps-soft) 52%, #fff);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option.is-selected .tjs-cps__media {
    background: rgba(255,255,255,.92);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__image,
  #TjsChampagnePack-{{ block.id }} .tjs-cps__placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__image {
    object-fit: {{ block.settings.image_fit }};
    object-position: center;
    transform: scale(.92);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__placeholder {
    padding: 18%;
    color: var(--cps-muted);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__content {
    width: 100%;
    display: grid;
    justify-items: center;
    gap: 4px;
    margin-top: auto;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__title {
    font-size: 16px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -.03em;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__caption {
    color: var(--cps-muted);
    font-size: 8px;
    font-weight: 700;
    line-height: 1.25;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option.is-selected .tjs-cps__caption {
    color: rgba(255,255,255,.7);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__price {
    display: grid;
    justify-items: center;
    gap: 2px;
    margin-top: 5px;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__price strong {
    font-size: clamp(22px, 2.7vw, 32px);
    font-weight: 950;
    line-height: .94;
    letter-spacing: -.06em;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__price s {
    color: var(--cps-muted);
    font-size: 9px;
    font-weight: 700;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option.is-selected .tjs-cps__price s {
    color: rgba(255,255,255,.64);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__per-item {
    color: var(--cps-muted);
    font-size: 8px;
    font-weight: 700;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option.is-selected .tjs-cps__per-item {
    color: rgba(255,255,255,.72);
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__saving {
    width: calc(100% - 8px);
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 5px;
    padding: 0 7px;
    border-radius: 999px;
    background: var(--cps-text);
    color: #fff;
    font-size: 8px;
    font-weight: 900;
    line-height: 1;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__option.is-selected .tjs-cps__saving {
    background: #fff;
    color: var(--cps-accent);
  }

  #TjsChampagnePack-{{ block.id }} [hidden] {
    display: none !important;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__footer {
    display: grid;
    gap: 8px;
    margin-top: 15px;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__add {
    width: 100%;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 18px;
    border: 0;
    border-radius: 14px;
    background: var(--cps-button);
    color: var(--cps-button-text);
    box-shadow: 0 14px 30px rgba(24, 18, 15, .14);
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__add:disabled {
    cursor: not-allowed;
    opacity: .42;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__add.is-loading {
    pointer-events: none;
    opacity: .68;
  }

  #TjsChampagnePack-{{ block.id }} .tjs-cps__note {
    margin: 0;
    color: var(--cps-muted);
    font-size: 9px;
    font-weight: 600;
    line-height: 1.4;
  }

  .tjs-cps--empty {
    margin-block: 12px;
    padding: 13px;
    border: 1px dashed #cbc3bd;
    color: #746d67;
    font-size: 11px;
  }

  @media (max-width: 749px) {
    #TjsChampagnePack-{{ block.id }} {
      padding: max(10px, {{ block.settings.block_padding }}px);
    }

    #TjsChampagnePack-{{ block.id }} .tjs-cps__heading {
      max-width: 16ch;
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

