<script>
  (() => {
    if (customElements.get('rakhi-pdp-bundle')) return;

    class RakhiPdpBundle extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready === 'true') return;
        this.dataset.ready = 'true';

        this.mainProductId = Number(this.dataset.mainProductId || 0);
        this.requireMain = this.dataset.requireMain === 'true';
        this.discountCode = (this.dataset.discountCode || '').trim();
        this.afterAdd = this.dataset.afterAdd || 'cart';
        this.moneyFormat = this.dataset.moneyFormat || '${{amount}}';
        this.currency = this.dataset.currency || 'INR';

        this.addButton = this.querySelector('[data-rb-add]');
        this.countNode = this.querySelector('[data-rb-count]');
        this.totalNode = this.querySelector('[data-rb-total]');
        this.toast = this.querySelector('[data-rb-toast]');
        this.activeGender = '';
        this.activePersona = '';

        this.addEventListener('click', event => this.handleClick(event));
        this.addEventListener('change', event => this.handleChange(event));

        const firstGender = this.querySelector('[data-rb-gender]');
        if (firstGender) this.selectGender(firstGender.dataset.rbGender);
      }

      handleClick(event) {
        const gender = event.target.closest('[data-rb-gender]');
        if (gender) {
          this.selectGender(gender.dataset.rbGender);
          return;
        }

        const persona = event.target.closest('[data-rb-persona]');
        if (persona) {
          this.selectPersona(persona.dataset.rbPersona);
          return;
        }

        const product = event.target.closest('[data-rb-select-product]');
        if (product) {
          this.toggleProduct(product.closest('[data-rb-product]'));
          return;
        }

        const selectAll = event.target.closest('[data-rb-select-all]');
        if (selectAll) {
          this.toggleAll(selectAll.closest('[data-rb-panel]'));
          return;
        }

        if (event.target.closest('[data-rb-add]')) {
          this.addSelected();
        }
      }

      handleChange(event) {
        const select = event.target.closest('[data-rb-variant-select]');
        if (!select) return;

        this.changeVariant(select.closest('[data-rb-product]'), Number(select.value));
      }

      selectGender(gender) {
        this.activeGender = gender;

        this.querySelectorAll('[data-rb-gender]').forEach(button => {
          const active = button.dataset.rbGender === gender;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        let firstPersona = null;

        this.querySelectorAll('[data-rb-persona]').forEach(button => {
          const visible = button.dataset.rbPersonaGender === gender;
          button.hidden = !visible;
          if (visible && !firstPersona) firstPersona = button;
        });

        if (firstPersona) this.selectPersona(firstPersona.dataset.rbPersona);
      }

      selectPersona(personaId) {
        this.activePersona = personaId;

        this.querySelectorAll('[data-rb-persona]').forEach(button => {
          const active = button.dataset.rbPersona === personaId;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        this.querySelectorAll('[data-rb-panel]').forEach(panel => {
          panel.hidden = panel.dataset.rbPanel !== personaId;
        });

        this.updateSummary();
      }

      currentPanel() {
        return this.querySelector(`[data-rb-panel="${CSS.escape(this.activePersona)}"]`);
      }

      toggleProduct(card, forcedState = null) {
        if (!card) return;

        const selected = forcedState === null
          ? card.dataset.selected !== 'true'
          : Boolean(forcedState);

        card.dataset.selected = selected ? 'true' : 'false';
        card.classList.toggle('is-selected', selected);
        card.querySelector('[data-rb-select-product]')
          ?.setAttribute('aria-pressed', selected ? 'true' : 'false');

        this.updateSummary();
      }

      toggleAll(panel) {
        if (!panel) return;

        const cards = [...panel.querySelectorAll('[data-rb-product]')];
        const shouldSelect = cards.some(card => card.dataset.selected !== 'true');

        cards.forEach(card => this.toggleProduct(card, shouldSelect));

        const control = panel.querySelector('[data-rb-select-all]');
        if (control) control.textContent = shouldSelect ? 'Clear selection' : 'Select all';
      }

      variantsFor(card) {
        if (card._rbVariants) return card._rbVariants;

        try {
          card._rbVariants = JSON.parse(
            card.querySelector('[data-rb-variants]')?.textContent || '[]'
          );
        } catch (error) {
          card._rbVariants = [];
        }

        return card._rbVariants;
      }

      changeVariant(card, variantId) {
        const variant = this.variantsFor(card)
          .find(item => Number(item.id) === Number(variantId));

        if (!variant) return;

        card.dataset.variantId = String(variant.id);
        card.dataset.price = String(variant.price);
        card.dataset.discountedPrice = String(variant.discountedPrice);

        const salePrice = card.querySelector('[data-rb-sale-price]');
        const originalPrice = card.querySelector('[data-rb-original-price]');

        if (salePrice) salePrice.textContent = this.formatMoney(variant.discountedPrice);
        if (originalPrice) originalPrice.textContent = this.formatMoney(variant.price);

        if (variant.image) {
          const image = card.querySelector('.rb-pdp-product__image');
          const preloader = new Image();

          preloader.onload = () => {
            image.src = variant.image;
            image.removeAttribute('srcset');
          };

          preloader.src = variant.image;
        }

        this.updateSummary();
      }

      selectedCards() {
        return [
          ...(this.currentPanel()
            ?.querySelectorAll('[data-rb-product][data-selected="true"]') || [])
        ];
      }

      updateSummary() {
        const cards = this.selectedCards();
        const total = cards.reduce(
          (sum, card) => sum + Number(card.dataset.discountedPrice || 0),
          0
        );

        if (this.countNode) {
          this.countNode.textContent =
            `${cards.length} item${cards.length === 1 ? '' : 's'} selected`;
        }

        if (this.totalNode) this.totalNode.textContent = this.formatMoney(total);
        if (this.addButton) this.addButton.disabled = cards.length === 0;
      }

      async mainProductIsInCart() {
        if (!this.requireMain || !this.mainProductId) return true;

        try {
          const response = await fetch(
            `${window.Shopify?.routes?.root || '/'}cart.js`,
            { headers: { Accept: 'application/json' } }
          );

          if (!response.ok) return false;

          const cart = await response.json();

          return Array.isArray(cart.items) &&
            cart.items.some(item => Number(item.product_id) === this.mainProductId);
        } catch (error) {
          return false;
        }
      }

      async addSelected() {
        const cards = this.selectedCards();
        if (!cards.length || !this.addButton) return;

        if (!(await this.mainProductIsInCart())) {
          this.showToast('Add the Rakhi to cart first, then add the gift bundle.');
          return;
        }

        const panel = this.currentPanel();
        const personaTitle = panel?.dataset.rbPersonaTitle || '';
        const genderTitle =
          this.querySelector(`[data-rb-gender="${CSS.escape(this.activeGender)}"]`)
            ?.textContent?.trim() || this.activeGender;

        const items = cards.map(card => ({
          id: Number(card.dataset.variantId),
          quantity: 1,
          properties: {
            '_rakhi_bundle': 'true',
            '_rakhi_bundle_gender': genderTitle,
            '_rakhi_bundle_persona': personaTitle,
            '_rakhi_main_product': this.dataset.mainProductTitle || ''
          }
        }));

        const label = this.addButton.querySelector('span');
        const originalLabel = label?.textContent || 'Add selected gifts';

        this.addButton.disabled = true;
        if (label) label.textContent = 'Adding…';

        try {
          const response = await fetch(
            `${window.Shopify?.routes?.root || '/'}cart/add.js`,
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json'
              },
              body: JSON.stringify({ items })
            }
          );

          const payload = await response.json();

          if (!response.ok) {
            throw new Error(
              payload.description || payload.message || 'Unable to add the bundle.'
            );
          }

          document.dispatchEvent(
            new CustomEvent('cart:refresh', { bubbles: true })
          );

          document.dispatchEvent(
            new CustomEvent('cart:updated', {
              bubbles: true,
              detail: payload
            })
          );

          if (this.discountCode) {
            const redirect = this.afterAdd === 'stay'
              ? window.location.pathname + window.location.search
              : '/cart';

            window.location.href =
              `/discount/${encodeURIComponent(this.discountCode)}` +
              `?redirect=${encodeURIComponent(redirect)}`;
            return;
          }

          if (this.afterAdd === 'cart') {
            window.location.href = '/cart';
            return;
          }

          cards.forEach(card => this.toggleProduct(card, false));
          this.showToast('The selected gifts were added to cart.');
        } catch (error) {
          this.showToast(error.message || 'Unable to add the selected gifts.');
        } finally {
          if (label) label.textContent = originalLabel;
          this.addButton.disabled = this.selectedCards().length === 0;
        }
      }

      formatMoney(cents) {
        if (window.Shopify?.formatMoney) {
          try {
            return window.Shopify.formatMoney(
              Number(cents || 0),
              this.moneyFormat
            );
          } catch (error) {}
        }

        return new Intl.NumberFormat(undefined, {
          style: 'currency',
          currency: this.currency,
          maximumFractionDigits: 0
        }).format(Number(cents || 0) / 100);
      }

      showToast(message) {
        if (!this.toast) return;

        this.toast.textContent = message;
        this.toast.classList.add('is-visible');

        clearTimeout(this.toast._rbTimer);
        this.toast._rbTimer = setTimeout(() => {
          this.toast.classList.remove('is-visible');
        }, 3000);
      }
    }

    customElements.define('rakhi-pdp-bundle', RakhiPdpBundle);
  })();
</script>

