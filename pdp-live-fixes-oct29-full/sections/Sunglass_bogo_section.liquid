      padding: 11px;
    }

    #tjs-bogo-sunnies-{{ section.id }} .tjs-sunny-card__title {
      font-size: 10.5px;
      min-height: 32px;
      padding-right: 36px;
    }

    #tjs-bogo-sunnies-{{ section.id }} .tjs-sunny-card__price b {
      font-size: 15px;
    }

    #tjs-bogo-sunnies-{{ section.id }} .tjs-sunny-card__plus {
      width: 32px;
      height: 32px;
    }

    #tjs-bogo-sunnies-{{ section.id }} .tjs-bogo-sunnies__summary-inner {
