    #tjs-bogo-sunnies-{{ section.id }} .tjs-bogo-sunnies__badge {
      transform: rotate(-2deg);
    }

    #tjs-bogo-sunnies-{{ section.id }} .tjs-bogo-sunnies__grid {
      gap: 9px;
