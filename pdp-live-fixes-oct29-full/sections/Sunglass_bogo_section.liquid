</style>

<script>
  (function () {
    function initSunniesBogo() {
      const root = document.getElementById("tjs-bogo-sunnies-{{ section.id }}");
      if (!root || root.dataset.ready === "true") return;
      root.dataset.ready = "true";

      const cards = Array.from(root.querySelectorAll("[data-tjs-bogo-card]"));
      const picks = Array.from(root.querySelectorAll("[data-tjs-bogo-pick]"));
      const countEl = root.querySelector("[data-tjs-bogo-count]");
      const totalEl = root.querySelector("[data-tjs-bogo-total]");
      const dealEl = root.querySelector("[data-tjs-bogo-deal]");
      const saveEl = root.querySelector("[data-tjs-bogo-save]");
      const statusEl = root.querySelector("[data-tjs-bogo-status]");
      const addBtn = root.querySelector("[data-tjs-bogo-add]");
      const buyBtn = root.querySelector("[data-tjs-bogo-buy]");
      const selectPairBtn = root.querySelector("[data-tjs-bogo-select-pair]");
      const clearBtn = root.querySelector("[data-tjs-bogo-clear]");
      const discountCode = {{ discount_code | json }};

      function money(cents) {
        const value = Number(cents || 0) / 100;
        return "₹" + new Intl.NumberFormat("en-IN", {
          maximumFractionDigits: 0
        }).format(value);
      }

      function selectedCards() {
        return cards.filter(function (card) {
          const pick = card.querySelector("[data-tjs-bogo-pick]");
          return pick && pick.checked && card.dataset.available === "true";
        });
      }

      function calcBogo(selected) {
        const prices = selected
          .map(function (card) {
            return Number(card.dataset.price || 0);
          })
          .sort(function (a, b) {
            return a - b;
          });

        const count = prices.length;
        const total = prices.reduce(function (sum, price) {
          return sum + price;
        }, 0);

        const freeCount = Math.floor(count / 2);
        const savings = prices.slice(0, freeCount).reduce(function (sum, price) {
          return sum + price;
        }, 0);

        return {
          count: count,
          total: total,
          savings: savings,
          deal: total - savings,
          needsOne: count % 2 !== 0
        };
      }

      function updateSummary() {
        cards.forEach(function (card) {
          const pick = card.querySelector("[data-tjs-bogo-pick]");
          const isPicked = pick && pick.checked;
          card.classList.toggle("is-picked", isPicked);

          const plus = card.querySelector("[data-tjs-bogo-toggle] span");
          if (plus) plus.textContent = isPicked ? "✓" : "+";
        });

        const selected = selectedCards();
        const result = calcBogo(selected);

        if (countEl) countEl.textContent = result.count;
        if (totalEl) totalEl.textContent = money(result.total);
        if (dealEl) dealEl.textContent = money(result.deal);
        if (saveEl) saveEl.textContent = money(result.savings);

        if (statusEl) {
          if (result.count === 0) {
            statusEl.textContent = "Select 2 sunglasses to unlock BOGO.";
          } else if (result.count === 1) {
            statusEl.textContent = "Add 1 more sunglass. Your second pair unlocks the deal.";
          } else if (result.needsOne) {
            statusEl.textContent = "Nice haul. Add 1 more to complete another BOGO pair.";
          } else {
            statusEl.textContent = "BOGO unlocked. Every pair is working harder.";
          }
        }

        if (addBtn) addBtn.disabled = result.count < 2;
        if (buyBtn) buyBtn.disabled = result.count < 2;
      }

      function getCartSectionIds() {
        const hardcoded = ["cart-drawer", "cart-icon-bubble", "cart-notification", "header"];

        const detected = Array.from(document.querySelectorAll('[id^="shopify-section-"]'))
          .map(function (el) {
            return el.id.replace("shopify-section-", "");
          })
          .filter(function (id) {
            return /cart|drawer|header/i.test(id);
          });

        return Array.from(new Set(hardcoded.concat(detected))).slice(0, 8);
      }

      function renderSections(sections) {
        if (!sections) return Promise.resolve();

        Object.keys(sections).forEach(function (id) {
          const html = sections[id];
          if (!html) return;

          const currentSection = document.getElementById("shopify-section-" + id);

          if (currentSection) {
            const doc = new DOMParser().parseFromString(html, "text/html");
            const nextSection = doc.getElementById("shopify-section-" + id);
            currentSection.innerHTML = nextSection ? nextSection.innerHTML : html;
            return;
          }

          const currentDrawer = document.querySelector("cart-drawer-component, cart-drawer");

          if (currentDrawer && /cart|drawer/i.test(id)) {
            const doc = new DOMParser().parseFromString(html, "text/html");
            const nextDrawer = doc.querySelector("cart-drawer-component, cart-drawer");
            if (nextDrawer) currentDrawer.replaceWith(nextDrawer);
          }
        });

        return Promise.resolve();
      }

      function fetchCart() {
        return fetch("/cart.js?tjs=" + Date.now(), {
          headers: {
            "Accept": "application/json"
          }
        }).then(function (res) {
          return res.json();
        });
      }

      function updateCartBubble(cart) {
        const count = Number(cart.item_count || 0);

        document.querySelectorAll("[data-cart-count]").forEach(function (el) {
          el.textContent = count;
        });

        document.querySelectorAll(".cart-bubble__text, .cart-count-bubble span[aria-hidden='true']").forEach(function (el) {
          el.textContent = count;
        });

        document.querySelectorAll("cart-icon").forEach(function (icon) {
          icon.classList.toggle("header-actions__cart-icon--has-cart", count > 0);
          icon.classList.toggle("pf-header-cart-icon--has-cart", count > 0);
        });
      }

      function broadcastCart(cart) {
        ["cart:refresh", "cart:updated", "cart:change", "cart-drawer:refresh", "ajaxCart:updated", "product:added"].forEach(function (eventName) {
          document.dispatchEvent(new CustomEvent(eventName, {
            bubbles: true,
            detail: { cart: cart }
          }));
        });
      }

      function openCartDrawer() {
        const drawer = document.querySelector("cart-drawer-component, cart-drawer");

        if (drawer && typeof drawer.open === "function") {
          drawer.open();
          return;
        }

        const trigger = document.querySelector('[data-testid="cart-drawer-trigger"], button[aria-label*="cart" i], button[aria-label*="Cart" i]');
        if (trigger) trigger.click();
      }

      function cartAddPayload(items) {
        const payload = { items: items };
        const sectionIds = getCartSectionIds();

        if (sectionIds.length) {
          payload.sections = sectionIds;
          payload.sections_url = window.location.pathname;
        }

        return payload;
      }

      function afterCartAdd(responseData, openDrawer) {
        const sections = responseData && responseData.sections ? responseData.sections : null;
        const sectionIds = getCartSectionIds();
        let sectionPromise = Promise.resolve();

        if (sections) {
          sectionPromise = renderSections(sections);
        } else if (sectionIds.length) {
          sectionPromise = fetch(window.location.pathname + "?sections=" + sectionIds.join(","))
            .then(function (res) { return res.json(); })
            .then(renderSections)
            .catch(function () {});
        }

        return sectionPromise
          .then(fetchCart)
          .then(function (cart) {
            updateCartBubble(cart);
            broadcastCart(cart);

            if (openDrawer) {
              setTimeout(openCartDrawer, 120);
            }

            return cart;
          });
      }

      function addToCart(items, options) {
        const openDrawer = options && options.openDrawer;
        const redirectAfter = options && options.redirectAfter;

        return fetch("/cart/add.js", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify(cartAddPayload(items))
        })
        .then(function (response) {
          if (!response.ok) throw new Error("Could not add items");
          return response.json();
        })
        .then(function (responseData) {
          return afterCartAdd(responseData, openDrawer).then(function () {
            if (redirectAfter) {
              if (discountCode) {
                window.location.href = "/discount/" + encodeURIComponent(discountCode) + "?redirect=/cart";
              } else {
                window.location.href = "/cart";
              }
            }
          });
        });
      }

      function addSelected(redirectAfter) {
        const selected = selectedCards();

        if (selected.length < 2) return;

        const items = selected.map(function (card) {
          return {
            id: Number(card.dataset.variantId),
            quantity: 1
          };
        });

        const addOriginal = addBtn ? addBtn.textContent : "";
        const buyOriginal = buyBtn ? buyBtn.textContent : "";

        if (addBtn) {
          addBtn.disabled = true;
          addBtn.textContent = "Adding...";
        }

        if (buyBtn) {
          buyBtn.disabled = true;
          buyBtn.textContent = "Adding...";
        }

        addToCart(items, {
          openDrawer: !redirectAfter,
          redirectAfter: redirectAfter
        })
        .then(function () {
          if (!redirectAfter && addBtn) addBtn.textContent = "Added ✓";

          setTimeout(function () {
            if (addBtn) addBtn.textContent = addOriginal || "Add BOGO Pair To Cart";
            if (buyBtn) buyBtn.textContent = buyOriginal || "Buy BOGO Pair";
            updateSummary();
          }, 1300);
        })
        .catch(function () {
          if (addBtn) addBtn.textContent = "Try Again";
          if (buyBtn) buyBtn.textContent = "Try Again";

          setTimeout(function () {
            if (addBtn) addBtn.textContent = addOriginal || "Add BOGO Pair To Cart";
            if (buyBtn) buyBtn.textContent = buyOriginal || "Buy BOGO Pair";
            updateSummary();
          }, 1400);
        });
      }

      function toggleCard(card) {
        const pick = card.querySelector("[data-tjs-bogo-pick]");
        if (!pick || pick.disabled) return;

        pick.checked = !pick.checked;
        updateSummary();
      }

      picks.forEach(function (pick) {
        pick.addEventListener("change", updateSummary);
      });

      cards.forEach(function (card) {
        const toggle = card.querySelector("[data-tjs-bogo-toggle]");

        if (toggle) {
          toggle.addEventListener("click", function () {
            toggleCard(card);
          });
        }
      });

      if (selectPairBtn) {
        selectPairBtn.addEventListener("click", function () {
          let selected = selectedCards().length;

          cards.forEach(function (card) {
            if (selected >= 2) return;

            const pick = card.querySelector("[data-tjs-bogo-pick]");
            if (pick && !pick.disabled && !pick.checked) {
              pick.checked = true;
              selected += 1;
            }
          });

          updateSummary();
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener("click", function () {
          picks.forEach(function (pick) {
            pick.checked = false;
          });

          updateSummary();
        });
      }

      if (addBtn) {
        addBtn.addEventListener("click", function () {
          addSelected(false);
        });
      }

      if (buyBtn) {
        buyBtn.addEventListener("click", function () {
          addSelected(true);
        });
      }

      updateSummary();
    }

    document.addEventListener("DOMContentLoaded", initSunniesBogo);
    document.addEventListener("shopify:section:load", initSunniesBogo);
  })();
</script>

