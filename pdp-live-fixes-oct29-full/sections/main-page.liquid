<!-- sections/main-page.liquid -->
{% style %}
  #shopify-section-{{ section.id }}{
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px; 
    --section-prate: {{ section.settings.padding_rate }};
  }
{% endstyle %}
<div timeline hdt-reveal="slide-in" class="hdt-main-page hdt-relative hdt-s-gradient" color-scheme="{{ section.settings.color_scheme }}">
  <div class="hdt-container{%- if section.settings.section_fullwidth -%}-full{% endif %} hdt-section-spacing">
    {%- if section.settings.image_bg != blank -%}
      <div class="hdt-main-page_imagebg hdt-h-full hdt-w-full hdt-absolute hdt-left-0 hdt-top-0">
        {{ section.settings.image_bg | image_url: width: section.settings.image_bg.width | image_tag: loading: 'lazy', width: section.settings.image_bg.width, height: section.settings.image_bg.height, class: 'hdt-w-full hdt-h-full hdt-object-cover', sizes: "100vw", widths: "375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840" }}
      </div>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="hdt-main-area hdt-rte hdt-relative">
      {% if page.handle == 'our-story' %}{% render 'june-story-text' %}{% endif %}
      {{ page.content }}
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "t:sections.main-page.name",
  "class": "hdt-section hdt-section-main-page",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "section_fullwidth",
      "label": "t:sections.all.section_fullwidth",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "image_picker",
      "id": "image_bg",
      "label": "t:sections.main-page.image.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_rate",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:sections.all.padding.padding_rate",
      "default": 100
    },
    {
      "type": "header",
      "content": "Our Story typography"
    },
    {
      "type": "paragraph",
      "content": "Applies only to the readable text on the Our Story page."
    },
    {
      "type": "header",
      "content": "Headings"
    },
    {
      "type": "font_picker",
      "id": "story_heading_font",
      "label": "Font",
      "default": "poppins_n4"
    },
    {
      "type": "range",
      "id": "story_heading_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 800
    },
    {
      "type": "range",
      "id": "story_heading_desktop",
      "label": "Desktop size",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "story_heading_mobile",
      "label": "Mobile size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "story_heading_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 4,
      "step": 0.1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "story_heading_line",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.3
    },
    {
      "type": "header",
      "content": "Story paragraphs"
    },
    {
      "type": "font_picker",
      "id": "story_body_font",
      "label": "Font",
      "default": "poppins_n4"
    },
    {
      "type": "range",
      "id": "story_body_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 400
    },
    {
      "type": "range",
      "id": "story_body_desktop",
      "label": "Desktop size",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "story_body_mobile",
      "label": "Mobile size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "story_body_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 4,
      "step": 0.1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "story_body_line",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Disclosure label"
    },
    {
      "type": "font_picker",
      "id": "story_control_font",
      "label": "Font",
      "default": "poppins_n4"
    },
    {
      "type": "range",
      "id": "story_control_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 600
    },
    {
      "type": "range",
      "id": "story_control_desktop",
      "label": "Desktop size",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "story_control_mobile",
      "label": "Mobile size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "story_control_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 4,
      "step": 0.1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "story_control_line",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.3
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-page.name"
    }
  ]
}
{% endschema %}

