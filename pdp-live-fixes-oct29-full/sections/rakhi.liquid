{% liquid
  assign rakhi_collection = section.settings.collection
  assign rendered_products = 0
  assign first_image_is_critical = false
  if section.index != blank and section.index <= 2
    assign first_image_is_critical = true
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --tjs-rakhi-bg: {{ section.settings.section_background }};
    --tjs-rakhi-stage-bg: {{ section.settings.stage_background }};
    --tjs-rakhi-text: {{ section.settings.text_color }};
    --tjs-rakhi-muted: {{ section.settings.muted_text_color }};
    --tjs-rakhi-accent: {{ section.settings.accent_color }};
    --tjs-rakhi-card-bg: {{ section.settings.card_background }};
    --tjs-rakhi-ring: {{ section.settings.ring_color }};
    --tjs-rakhi-radius: {{ section.settings.corner_radius }}px;
    --tjs-rakhi-center-size: {{ section.settings.center_size_desktop }}px;
    --tjs-rakhi-center-size-mobile: {{ section.settings.center_size_mobile }}px;
    --tjs-rakhi-product-scale: {{ section.settings.product_scale }}%;
    --tjs-rakhi-image-fit: {{ section.settings.circle_image_fit }};
    --tjs-rakhi-image-position-x: {{ section.settings.circle_image_position_x }}%;
    --tjs-rakhi-image-position-y: {{ section.settings.circle_image_position_y }}%;
    --tjs-rakhi-image-inset: {{ section.settings.circle_image_inset }}%;
    --tjs-rakhi-image-zoom: {{ section.settings.circle_image_zoom | times: 0.01 }};
    --tjs-rakhi-max-width: {{ section.settings.max_width }}px;
    --tjs-rakhi-page-gutter: {{ section.settings.page_gutter }}px;
    --tjs-rakhi-mobile-gutter: {{ section.settings.mobile_gutter }}px;
    --tjs-rakhi-scroll-desktop: {{ section.settings.scroll_length_desktop }}vh;
    --tjs-rakhi-scroll-mobile: {{ section.settings.scroll_length_mobile }}vh;
    --tjs-rakhi-sticky-top: {{ section.settings.sticky_top }}px;
    --tjs-rakhi-shadow-opacity: {{ section.settings.shadow_strength | times: 0.01 }};
    --tjs-rakhi-info-gap-desktop: {{ section.settings.product_info_gap_desktop }}px;
    --tjs-rakhi-info-gap-mobile: {{ section.settings.product_info_gap_mobile }}px;
    --tjs-rakhi-mandala-color: {{ section.settings.mandala_color }};
    --tjs-rakhi-mandala-opacity: {{ section.settings.mandala_opacity | times: 0.01 }};
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story,
  #shopify-section-{{ section.id }} .tjs-rakhi-story * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story {
    position: relative;
    min-height: var(--tjs-rakhi-scroll-desktop);
    background: var(--tjs-rakhi-bg);
    color: var(--tjs-rakhi-text);
    font-family: var(--font-body-family, Arial, sans-serif);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__sticky {
    position: sticky;
    top: var(--tjs-rakhi-sticky-top);
    height: calc(100svh - var(--tjs-rakhi-sticky-top));
    min-height: 620px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 50% 48%, color-mix(in srgb, var(--tjs-rakhi-accent) 15%, transparent) 0%, transparent 25%),
      linear-gradient(145deg, color-mix(in srgb, var(--tjs-rakhi-stage-bg) 98%, white) 0%, var(--tjs-rakhi-stage-bg) 66%, color-mix(in srgb, var(--tjs-rakhi-stage-bg) 92%, var(--tjs-rakhi-accent)) 100%);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__sticky::before {
    content: '';
    position: absolute;
    inset: 18px;
    z-index: 20;
    border: 1px solid color-mix(in srgb, var(--tjs-rakhi-text) 7%, transparent);
    border-radius: var(--tjs-rakhi-radius);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__sticky::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: min(68vw, 900px);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--tjs-rakhi-ring) 24%, transparent);
    border-radius: 50%;
    opacity: .52;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__mandala-wrap {
    position: absolute;
    left: 50%;
    top: 54%;
    z-index: 1;
    width: min(72vw, 1040px);
    aspect-ratio: 1;
    opacity: var(--tjs-rakhi-mandala-opacity);
    transform: translate(-50%, -50%) scale(.88);
    transform-origin: center center;
    pointer-events: none;
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__mandala {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    filter: drop-shadow(0 0 24px color-mix(in srgb, var(--tjs-rakhi-mandala-color) 10%, transparent));
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__mandala-segment,
  #shopify-section-{{ section.id }} .tjs-rakhi-story__mandala-dot {
    fill: none;
    stroke: color-mix(in srgb, var(--tjs-rakhi-mandala-color) 82%, transparent);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__mandala-segment.is-soft {
    stroke: color-mix(in srgb, var(--tjs-rakhi-mandala-color) 52%, transparent);
    stroke-width: .8;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__mandala-segment.is-strong {
    stroke-width: 1.15;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__mandala-dot {
    fill: color-mix(in srgb, var(--tjs-rakhi-mandala-color) 72%, transparent);
    stroke: none;
    transform-box: fill-box;
    transform-origin: center;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__inner {
    position: relative;
    z-index: 2;
    width: min(100%, var(--tjs-rakhi-max-width));
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--tjs-rakhi-page-gutter);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__header {
    position: absolute;
    top: clamp(34px, 5vh, 68px);
    left: 50%;
    z-index: 14;
    width: min(760px, calc(100% - 80px));
    text-align: center;
    transform: translateX(-50%);
    transition: opacity .35s ease, transform .35s ease;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    color: var(--tjs-rakhi-accent);
    font-size: 10px;
    font-weight: 760;
    line-height: 1;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__eyebrow::before,
  #shopify-section-{{ section.id }} .tjs-rakhi-story__eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: .7;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__heading {
    margin: 0;
    color: var(--tjs-rakhi-text);
    font-family: var(--font-heading-family, var(--font-body-family, Arial, sans-serif));
    font-size: clamp(40px, 5.2vw, {{ section.settings.heading_size }}px);
    font-weight: 500;
    line-height: .95;
    letter-spacing: -.046em;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__description {
    max-width: 56ch;
    margin: 14px auto 0;
    color: var(--tjs-rakhi-muted);
    font-size: 13px;
    line-height: 1.58;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__description > * {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__hands {
    position: absolute;
    inset: 0;
    z-index: 8;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__hand {
    position: absolute;
    top: var(--hand-y-desktop, 50%);
    z-index: var(--hand-z, 6);
    width: var(--hand-width-desktop, 40vw);
    max-width: min(70vw, 760px);
    opacity: 0;
    transform-origin: var(--hand-origin, 50% 50%);
    will-change: transform, opacity;
    filter: drop-shadow(0 24px 34px rgba(28, 21, 17, .16));
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__hand[data-side='left'] {
    left: 0;
    transform-origin: left center;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__hand[data-side='right'] {
    right: 0;
    transform-origin: right center;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__hand-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
    user-select: none;
    -webkit-user-drag: none;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__center {
    position: absolute;
    left: 50%;
    top: 53%;
    z-index: 12;
    width: var(--tjs-rakhi-center-size);
    height: var(--tjs-rakhi-center-size);
    opacity: .18;
    transform: translate(-50%, -50%) scale(.82);
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__center::before {
    content: '';
    position: absolute;
    inset: -18%;
    z-index: 0;
    border: 1px solid color-mix(in srgb, var(--tjs-rakhi-ring) 48%, transparent);
    border-radius: 50%;
    box-shadow:
      0 0 0 12px color-mix(in srgb, var(--tjs-rakhi-ring) 5%, transparent),
      0 28px 70px rgba(31, 24, 20, .14);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__center::after {
    content: '';
    position: absolute;
    inset: -30%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--tjs-rakhi-accent) 16%, transparent) 0%, transparent 68%);
    filter: blur(10px);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__product-stage {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--tjs-rakhi-text) 9%, transparent);
    border-radius: 50%;
    background:
      radial-gradient(circle at 42% 32%, rgba(255,255,255,.95) 0%, color-mix(in srgb, var(--tjs-rakhi-card-bg) 94%, white) 46%, var(--tjs-rakhi-card-bg) 100%);
    box-shadow:
      0 1px 0 rgba(255,255,255,.8) inset,
      0 24px 54px rgba(28, 21, 17, var(--tjs-rakhi-shadow-opacity));
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__slide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    opacity: 0;
    transform: translate3d(18%, 0, 0) scale(.92) rotate(4deg);
    transition:
      opacity .42s cubic-bezier(.22, .8, .3, 1),
      transform .54s cubic-bezier(.22, .8, .3, 1);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__slide.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__slide.is-leaving {
    opacity: 0;
    transform: translate3d(-18%, 0, 0) scale(.92) rotate(-4deg);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__product-link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__media {
    position: absolute;
    inset: var(--tjs-rakhi-image-inset);
    display: block;
    overflow: hidden;
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--tjs-rakhi-image-fit);
    object-position: var(--tjs-rakhi-image-position-x) var(--tjs-rakhi-image-position-y);
    transform: scale(var(--tjs-rakhi-image-zoom));
    transform-origin: center center;
    filter:
      drop-shadow(0 2px 1px rgba(28, 20, 16, .10))
      drop-shadow(0 18px 24px rgba(28, 20, 16, .16));
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__empty {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 30px;
    color: var(--tjs-rakhi-muted);
    text-align: center;
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__product-info {
    position: absolute;
    left: 50%;
    top: calc(53% + (var(--tjs-rakhi-center-size) / 2) + var(--tjs-rakhi-info-gap-desktop));
    z-index: 14;
    width: min(580px, calc(100% - 56px));
    opacity: 0;
    transform: translate(-50%, 18px);
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-card {
    position: relative;
    display: none;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: center;
    gap: 15px;
    min-height: 98px;
    padding: 12px 13px 12px 12px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--tjs-rakhi-text) 12%, transparent);
    border-radius: 20px;
    background: color-mix(in srgb, var(--tjs-rakhi-card-bg) 98%, white);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .88) inset,
      0 20px 46px rgba(28, 21, 17, .14);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 18px;
    right: 18px;
    height: 2px;
    border-radius: 0 0 999px 999px;
    background: linear-gradient(90deg, transparent, var(--tjs-rakhi-accent), transparent);
    opacity: .72;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-card.is-active {
    display: grid;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-thumb {
    position: relative;
    width: 72px;
    height: 72px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--tjs-rakhi-text) 9%, transparent);
    border-radius: 15px;
    background: color-mix(in srgb, var(--tjs-rakhi-card-bg) 93%, var(--tjs-rakhi-stage-bg));
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, .52);
    border-radius: inherit;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-copy {
    min-width: 0;
    display: grid;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-meta {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-kicker,
  #shopify-section-{{ section.id }} .tjs-rakhi-story__save-badge {
    display: inline-flex;
    align-items: center;
    min-height: 21px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 8px;
    font-weight: 760;
    line-height: 1;
    letter-spacing: .1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__info-kicker {
    color: var(--tjs-rakhi-accent);
    background: color-mix(in srgb, var(--tjs-rakhi-accent) 10%, transparent);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__save-badge {
    color: var(--tjs-rakhi-text);
    background: color-mix(in srgb, var(--tjs-rakhi-text) 7%, transparent);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__product-title {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--tjs-rakhi-text);
    font-size: 15px;
    font-weight: 680;
    line-height: 1.23;
    letter-spacing: -.012em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 7px;
    color: var(--tjs-rakhi-text);
    font-size: 13px;
    font-weight: 760;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__compare-price {
    color: var(--tjs-rakhi-muted);
    font-size: 10px;
    font-weight: 520;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--tjs-rakhi-text);
    border-radius: 999px;
    background: var(--tjs-rakhi-text);
    color: var(--tjs-rakhi-card-bg);
    font-size: 9px;
    font-weight: 760;
    line-height: 1;
    letter-spacing: .11em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__button svg {
    width: 14px;
    height: 14px;
    transition: transform .25s ease;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__button:hover,
  #shopify-section-{{ section.id }} .tjs-rakhi-story__button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(28, 21, 17, .16);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__button:hover svg,
  #shopify-section-{{ section.id }} .tjs-rakhi-story__button:focus-visible svg {
    transform: translateX(2px);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__progress {
    position: absolute;
    left: 50%;
    bottom: 26px;
    z-index: 15;
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity .3s ease;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__dot {
    width: 22px;
    height: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tjs-rakhi-text) 18%, transparent);
    transition: width .32s ease, background-color .32s ease;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__dot.is-active {
    width: 40px;
    background: var(--tjs-rakhi-accent);
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 24px;
    z-index: 16;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--tjs-rakhi-muted);
    font-size: 8px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: .14em;
    text-transform: uppercase;
    transform: translateX(-50%);
    transition: opacity .3s ease;
  }

  #shopify-section-{{ section.id }} .tjs-rakhi-story__scroll-hint::after {
    content: '';
    width: 34px;
    height: 1px;
    background: currentColor;
    animation: tjs-rakhi-hint-{{ section.id }} 1.8s ease-in-out infinite;
  }

  @keyframes tjs-rakhi-hint-{{ section.id }} {
    0%, 100% { transform: scaleX(.55); transform-origin: left center; }
    50% { transform: scaleX(1); transform-origin: left center; }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .tjs-rakhi-story {
      min-height: var(--tjs-rakhi-scroll-mobile);
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__sticky {
      height: clamp(620px, 82svh, 700px);
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__sticky::before {
      inset: 4px;
      border-radius: min(var(--tjs-rakhi-radius), 18px);
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__inner {
      padding-inline: var(--tjs-rakhi-mobile-gutter);
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__header {
      top: 12px;
      width: calc(100% - 28px);
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__mandala-wrap {
      width: min(98vw, 620px);
      top: 44%;
      opacity: calc(var(--tjs-rakhi-mandala-opacity) * .92);
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__heading {
      font-size: clamp(28px, 8.4vw, {{ section.settings.mobile_heading_size }}px);
      line-height: .96;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__eyebrow {
      margin-bottom: 7px;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__description {
      display: -webkit-box;
      max-width: 34ch;
      margin-top: 8px;
      overflow: hidden;
      font-size: 10.5px;
      line-height: 1.4;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__hand {
      top: calc(var(--hand-y-mobile, 52%) - 7%);
      width: var(--hand-width-mobile, 74vw);
      max-width: 110vw;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__hand[data-role='female_secondary'][data-hide-mobile='true'] {
      display: none;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__center {
      top: 44%;
      width: var(--tjs-rakhi-center-size-mobile);
      height: var(--tjs-rakhi-center-size-mobile);
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__product-info {
      top: calc(44% + (var(--tjs-rakhi-center-size-mobile) / 2) + var(--tjs-rakhi-info-gap-mobile));
      width: min(390px, calc(100% - 16px));
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__info-card {
      grid-template-columns: 48px minmax(0, 1fr) auto;
      min-height: 0;
      padding: 9px;
      border-radius: 15px;
      gap: 9px;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__info-thumb {
      width: 48px;
      height: 48px;
      border-radius: 11px;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__info-copy {
      gap: 5px;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__info-kicker,
    #shopify-section-{{ section.id }} .tjs-rakhi-story__save-badge {
      min-height: 18px;
      padding-inline: 6px;
      font-size: 7px;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__product-title {
      font-size: 12.5px;
      line-height: 1.22;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__price {
      font-size: 11.5px;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__button {
      grid-column: auto;
      width: auto;
      min-width: 78px;
      min-height: 36px;
      padding-inline: 12px;
      font-size: 7.5px;
      align-self: center;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__progress {
      bottom: 8px;
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__scroll-hint {
      bottom: 8px;
    }

  }

  @media screen and (max-width: 359px) {
    #shopify-section-{{ section.id }} .tjs-rakhi-story__info-card {
      grid-template-columns: 44px minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .tjs-rakhi-story__button {
      grid-column: 1 / -1;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .tjs-rakhi-story__scroll-hint::after,
    #shopify-section-{{ section.id }} .tjs-rakhi-story__slide,
    #shopify-section-{{ section.id }} .tjs-rakhi-story__button {
      animation: none !important;
      transition-duration: .01ms !important;
    }
  }
{% endstyle %}

