{% liquid
  assign collection = collections[section.settings.collection] | default: collections['all']
  assign product_limit = section.settings.product_limit | default: 12
%}

<section class="tjs-epicenter-v2-3" id="Epicenter-{{ section.id }}">
  <div class="scroll-duration-wrap">
    
    <div class="sticky-viewport">
      <!-- THE RADIAL EXPLOSION -->
      <div class="supernova-gravity-zone">
        {% for product in collection.products limit: product_limit %}
          {% liquid
            assign angle_step = 360 | divided_by: product_limit
            assign angle = forloop.index0 | times: angle_step
          %}
          <a href="{{ product.url }}" 
             class="epicenter-card" 
             data-angle="{{ angle }}">
            
            <div class="card-visual">
              <img src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" alt="{{ product.title }}">
              <span class="card-price">₹{{ product.price | money_without_currency }}</span>
              <div class="discount-badge">FLAT 50% OFF</div>
            </div>
          </a>
        {% endfor %}
      </div>

      <!-- THE CENTER TEXT HUB -->
      <div class="epicenter-text-hub">
        
        <!-- PHASE 1: INITIAL -->
        <div class="text-phase active" id="phase-1">
          <div class="eyebrow"><span class="dot"></span> CLEARANCE LIVE</div>
          <h2 class="main-title">SHOP ALL<br><span class="outline">YOU CAN.</span></h2>
          <p class="sub-msg">The biggest haul of the season is here.</p>
        </div>

        <!-- PHASE 2: CONVERSION (Enhanced Spacing) -->
        <div class="text-phase" id="phase-2">
          <div class="eyebrow"><span class="dot"></span> STOCKS MOVING</div>
          <h2 class="main-title">FILL THE<br><span class="outline">CART.</span></h2>
          <p class="sub-msg">Don't wait—the best edits vanish first.</p>
          <div class="supernova-actions">
            <a href="{{ section.settings.link | default: '/collections/all' }}" class="btn-luxe-lime">SHOP THE SALE</a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  :root {
    --lime: #CBFB5E;
    --charcoal: #1A1A1A;
    --outfit: 'Outfit', sans-serif;
  }

  .tjs-epicenter-v2-3 {
    position: relative;
    width: 100%;
    background: #ffffff;
    font-family: var(--outfit);
    overflow-x: clip; 
  }

  .scroll-duration-wrap {
    height: 300vh; /* Increased scroll length for smoother transition */
    position: relative;
  }

  .sticky-viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* --- PRODUCT CARDS --- */
  .supernova-gravity-zone {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .epicenter-card {
    position: absolute;
    width: 140px;
    text-decoration: none;
    pointer-events: auto;
    opacity: 0;
    will-change: transform, opacity;
    transform: translate3d(0, 0, 0) scale(0);
    transition: opacity 0.5s ease;
  }

  .card-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: #fff;
    padding: 8px;
    border-radius: 24px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
  }

  .card-visual img {
    width: 100%; height: 100%;
    object-fit: cover;
    border-radius: 18px;
  }

  .card-price {
    position: absolute;
    top: -8px; right: -8px;
    background: var(--lime);
    color: #000;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 5px 12px;
    border-radius: 30px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .discount-badge {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--charcoal);
    color: var(--lime);
    font-size: 9px;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 50px;
    white-space: nowrap;
    letter-spacing: 0.1em;
  }

  /* --- TEXT HUB: REFINED SPACING --- */
  .epicenter-text-hub {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 800px;
    width: 90%;
    pointer-events: none;
  }

  .text-phase {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .text-phase.active {
    opacity: 1;
    visibility: visible;
  }

  .main-title {
    font-size: clamp(38px, 9vw, 90px); /* Slightly smaller max to give breathing room */
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--charcoal);
    margin: 0;
    text-transform: uppercase;
  }

  .outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--charcoal);
  }

  .active .outline {
    background: var(--lime);
    color: var(--charcoal);
    -webkit-text-stroke: 0;
    padding: 0 10px;
    border-radius: 4px;
  }

  .eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.25em;
    color: #999;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .dot {
    width: 7px; height: 7px;
    background: var(--lime);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--lime);
  }

  .sub-msg {
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.5;
    color: #555;
    max-width: 45ch;
    margin-left: auto;
    margin-right: auto;
  }

  .supernova-actions {
    margin-top: 40px; /* Strong spacing before CTA */
    pointer-events: auto;
  }

  .btn-luxe-lime {
    background: var(--charcoal);
    color: var(--lime);
    padding: 18px 48px;
    border-radius: 100px;
    font-weight: 900;
    text-decoration: none;
    letter-spacing: 0.1em;
    display: inline-block;
    font-size: 13px;
    transition: transform 0.3s ease;
  }

  .btn-luxe-lime:hover {
    transform: translateY(-5px);
  }

  /* --- MOBILE FIXES --- */
  @media (max-width: 768px) {
    .epicenter-card { width: 100px; }
    .epicenter-card:nth-child(n+9) { display: none; } 
    .main-title { font-size: 42px; line-height: 0.95; }
    .sub-msg { font-size: 14px; margin-top: 15px; }
    .supernova-actions { margin-top: 25px; }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.querySelector('#Epicenter-{{ section.id }}');
  const stickyWrap = container.querySelector('.scroll-duration-wrap');
  const cards = container.querySelectorAll('.epicenter-card');
  const phases = container.querySelectorAll('.text-phase');

  let ticking = false;

  function updateEpicenter() {
    const rect = stickyWrap.getBoundingClientRect();
    const scrollPos = -rect.top;
    const totalScroll = stickyWrap.offsetHeight - window.innerHeight;
    let progress = scrollPos / totalScroll;
    progress = Math.max(0, Math.min(1, progress));

    // Phase Switching
    if (progress < 0.45) {
      phases[0].classList.add('active');
      phases[1].classList.remove('active');
    } else {
      phases[0].classList.remove('active');
      phases[1].classList.add('active');
    }

    // Dynamic Spacing Physics
    const isMobile = window.innerWidth <= 768;
    
    // As progress increases, we push the products further out
    // During Phase 2 (progress > 0.5), we add an extra "push" to clear the CTA
    const expansionBoost = progress > 0.5 ? (progress - 0.5) * 20 : 0;
    const baseRadius = (isMobile ? 38 : 35) + expansionBoost; 
    const safetyBuffer = (isMobile ? 14 : 12); 

    cards.forEach((card, i) => {
      const angle = card.dataset.angle;
      const currentRadius = (progress * baseRadius) + safetyBuffer; 
      
      const x = Math.cos(angle * Math.PI / 180) * currentRadius;
      const y = Math.sin(angle * Math.PI / 180) * currentRadius;

      card.style.opacity = progress > 0.03 ? 1 : 0;
      // translate3d for hardware acceleration
      card.style.transform = `translate3d(${x}vw, ${y}vh, 0) scale(${0.4 + progress * 0.6})`;
    });

    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateEpicenter);
      ticking = true;
    }
  });

  updateEpicenter();
});
</script>

{% schema %}
{
  "name": "Epicenter Supernova 2.3",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection for Explosion"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Max Products",
      "min": 8,
      "max": 20,
      "default": 12
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button Link"
    }
  ],
  "presets": [
    { "name": "Epicenter Supernova 2.3" }
  ]
}
{% endschema %}