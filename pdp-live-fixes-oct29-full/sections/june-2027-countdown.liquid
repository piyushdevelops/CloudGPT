  <div class="june-count__unit{% if section.settings.enable_peeks %} has-peek{% endif %}">{% if section.settings.enable_peeks %}<div class="june-count__peek" aria-hidden="true"><div class="june-count__planner">{% if section.settings.peek_cover_2 != blank %}{{ section.settings.peek_cover_2 | image_url: width: 800 | image_tag: loading: 'lazy', alt: '' }}{% else %}<img src="{{ 'june-preorder-peek-2.jpg' | asset_url }}" width="793" height="1000" alt="" loading="lazy">{% endif %}</div></div><span class="june-count__face" aria-hidden="true"></span><button type="button" class="june-count__reveal" data-peek aria-expanded="false" aria-label="Reveal a secret planner cover"><span class="june-count__hint" aria-hidden="true">Psst… tap me</span></button>{% endif %}<span class="june-count__number" data-unit="seconds">—</span><span class="june-count__label">Seconds</span></div>
 </div>
 <div><time class="june-count__date" data-date datetime="{{ section.settings.launch_at | escape }}">{{ section.settings.launch_at | escape }}</time>{% if section.settings.show_confetti %}<div><button type="button" class="june-count__play" data-celebrate hidden><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="18" height="18" fill="none" stroke="currentColor" stroke-width="4" aria-hidden="true" focusable="false"><path d="M16 2v28M2 16h28M6 6l20 20M6 26L26 6"/></svg>{{ section.settings.confetti_label | escape }}</button></div>{% endif %}</div>
 <div data-complete hidden><p class="june-count__complete">{{ section.settings.complete | escape }}</p>{% if section.settings.launch_link != blank %}<a class="june-count__cta" href="{{ section.settings.launch_link }}">{{ section.settings.cta | escape }}<span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8"/></svg></span></a>{% endif %}</div>
 <div data-button-covers hidden aria-hidden="true">{% if section.settings.button_cover_1 != blank %}{{ section.settings.button_cover_1 | image_url: width: 800 | image_tag: loading: 'eager', alt: '' }}{% else %}<img src="{{ 'june-button-cover-1.jpg' | asset_url }}" width="793" height="1000" alt="" loading="eager">{% endif %}{% if section.settings.button_cover_2 != blank %}{{ section.settings.button_cover_2 | image_url: width: 800 | image_tag: loading: 'eager', alt: '' }}{% else %}<img src="{{ 'june-button-cover-2.jpg' | asset_url }}" width="793" height="1000" alt="" loading="eager">{% endif %}</div>
 <span class="june-count__status" role="status" data-status></span>
</june-launch-countdown>
<script src="{{ 'june-2027-countdown.js' | asset_url }}" defer></script>

