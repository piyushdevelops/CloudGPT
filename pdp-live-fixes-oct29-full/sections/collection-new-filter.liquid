    #shopify-section-{{ section.id }} .tjs-cp-subcat__body { min-height:84px;padding:14px; }
    #shopify-section-{{ section.id }} .tjs-cp-subcat__label { font-size:23px; }
    #shopify-section-{{ section.id }} .tjs-cp-types__rail { grid-auto-columns:64vw; }
    #shopify-section-{{ section.id }} .tjs-cp-type { min-width:0; }
    #shopify-section-{{ section.id }} .tjs-cp-intents { margin-top:15px;padding:11px;border-radius:16px; }
    #shopify-section-{{ section.id }} .tjs-cp-intents__label strong { font-size:20px; }
    #shopify-section-{{ section.id }} .tjs-cp-intent { min-height:44px;padding-inline:11px; }
    #shopify-section-{{ section.id }} .tjs-cp-trust { grid-template-columns:1fr 1fr;border-radius:15px; }
    #shopify-section-{{ section.id }} .tjs-cp-trust__item { min-height:68px;padding:11px; }
    #shopify-section-{{ section.id }} .tjs-cp-trust__icon { width:32px;height:32px;flex-basis:32px;border-radius:10px; }
    #shopify-section-{{ section.id }} .tjs-cp-trust__copy strong { font-size:8px; }
    #shopify-section-{{ section.id }} .tjs-cp-trust__copy span { font-size:7.5px; }
    #shopify-section-{{ section.id }} .tjs-cp-toolbar { top:var(--tjs-cp-toolbar-offset);min-height:54px;margin-top:16px;border-radius:15px; }
    #shopify-section-{{ section.id }} .tjs-cp-filterbar { display:none; }
    #shopify-section-{{ section.id }} .tjs-product-card__image,#shopify-section-{{ section.id }} .tjs-product-card__image-secondary { padding:calc(var(--tjs-cp-image-padding-mobile) * .72); }
    #shopify-section-{{ section.id }} .tjs-product-card__actions { right:8px;bottom:8px;display:flex;gap:5px; }
    #shopify-section-{{ section.id }} .tjs-product-card__quick,#shopify-section-{{ section.id }} .tjs-product-card__add,#shopify-section-{{ section.id }} .tjs-product-card__options { width:34px;min-width:34px;height:34px;padding:0;border-radius:10px; }
    #shopify-section-{{ section.id }} .tjs-product-card__quick span,#shopify-section-{{ section.id }} .tjs-product-card__add span,#shopify-section-{{ section.id }} .tjs-product-card__options span { display:none; }
    #shopify-section-{{ section.id }} .tjs-product-card__content { gap:6px;padding:10px 2px 5px; }
    #shopify-section-{{ section.id }} .tjs-product-card__title { font-size:17px;line-height:1.02; }
    #shopify-section-{{ section.id }} .tjs-product-card__benefit { font-size:8.5px;-webkit-line-clamp:1; }
    #shopify-section-{{ section.id }} .tjs-product-card__spec-line { display:none; }
    #shopify-section-{{ section.id }} .tjs-product-card__price { font-size:15px; }
    #shopify-section-{{ section.id }} .tjs-product-card__price-note { font-size:7px; }
    #shopify-section-{{ section.id }} .tjs-cp-quickview__specs { grid-template-columns:1fr; }
  }

{% endstyle %}


<tjs-collection-page
  class="tjs-cp tjs-cp--hero-{{ section.settings.hero_style }} tjs-cp--nav-{{ section.settings.navigation_style }} tjs-cp--card-{{ section.settings.card_style }}{% if section.settings.sticky_toolbar %} tjs-cp--sticky-toolbar{% endif %}"
  data-tjs-collection-page
  data-section-id="{{ section.id }}"
  data-root-url="{{ routes.root_url }}"
  data-price-mode="{{ section.settings.price_mode }}"
  data-event-percent="{{ section.settings.event_price_percent }}"
  data-event-note="{{ section.settings.event_price_note | escape }}"
>
  <div class="tjs-cp__loading" aria-hidden="true"><span class="tjs-cp__spinner"></span></div>

  <div class="tjs-cp__inner">
    {% if section.settings.show_hero %}
      <header class="tjs-cp-hero">
        <span class="tjs-cp-hero__orb tjs-cp-hero__orb--one" aria-hidden="true"></span>
        <span class="tjs-cp-hero__orb tjs-cp-hero__orb--two" aria-hidden="true"></span>
        <span class="tjs-cp-hero__line" aria-hidden="true"></span>
        <div class="tjs-cp-hero__content">
          {% if section.settings.show_breadcrumbs %}
            <nav class="tjs-cp-breadcrumbs" aria-label="Breadcrumb">
              <a href="{{ routes.root_url }}">Home</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{{ current_collection.title | escape }}</span>
            </nav>
          {% endif %}
          {% if hero_kicker != blank %}<p class="tjs-cp-hero__eyebrow">{{ hero_kicker | escape }}</p>{% endif %}
          <h1 class="tjs-cp-hero__heading">{{ collection_title | escape }}</h1>
          {% if hero_description != blank %}
            <div class="tjs-cp-hero__description rte">{{ hero_description }}</div>
          {% endif %}

          <div class="tjs-cp-hero__meta">
            <span class="tjs-cp-hero__meta-item">
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2.5 12.2 7l4.95.72-3.58 3.49.84 4.93L10 13.82l-4.41 2.32.84-4.93-3.58-3.49L7.8 7 10 2.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
              {{ current_collection.products_count }} products
            </span>
            {% if section.settings.hero_meta_2 != blank %}
              <span class="tjs-cp-hero__meta-item">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5 8 14l8-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ section.settings.hero_meta_2 | escape }}
              </span>
            {% endif %}
            {% if section.settings.hero_meta_3 != blank %}
              <span class="tjs-cp-hero__meta-item">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6.5h10v7H3v-7Zm10 2h2.5l1.5 2v3h-4v-5Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/><circle cx="6" cy="15" r="1.3" fill="currentColor"/><circle cx="14.5" cy="15" r="1.3" fill="currentColor"/></svg>
                {{ section.settings.hero_meta_3 | escape }}
              </span>
            {% endif %}
          </div>
        </div>

        <div class="tjs-cp-hero__media">
          {% if hero_image != blank %}
            <picture>
              {% if hero_image_mobile != blank %}
                <source media="(max-width: 749px)" srcset="{{ hero_image_mobile | image_url: width: 1000 }}">
              {% endif %}
              {{ hero_image
                | image_url: width: 2200
                | image_tag:
                  class: 'tjs-cp-hero__image',
                  widths: '600, 900, 1200, 1600, 1900, 2200',
                  sizes: '(max-width: 989px) 100vw, 55vw',
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: collection_title
              }}
            </picture>
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'tjs-cp-hero__placeholder' }}
          {% endif %}
        </div>
      </header>
    {% endif %}

    {% if show_subcategory_navigation %}
      <nav class="tjs-cp-subcats" aria-label="{{ section.settings.subcategory_heading | escape }}">
        <div class="tjs-cp-section-label">
          <div>
            <p>{{ section.settings.navigation_eyebrow | escape }}</p>
            <h2>{{ section.settings.subcategory_heading | escape }}</h2>
          </div>
          {% if section.settings.subcategory_hint != blank %}<span>{{ section.settings.subcategory_hint | escape }}</span>{% endif %}
        </div>
        <div class="tjs-cp-subcats__rail" data-horizontal-rail>
          {% for block in section.blocks %}
            {% if block.type == 'subcategory' and block.settings.parent_collection != blank and block.settings.collection != blank and block.settings.parent_collection.handle == current_collection.handle %}
              {% liquid
                assign sub_collection = block.settings.collection
                assign sub_title = block.settings.title | default: sub_collection.title
                assign sub_image = block.settings.icon | default: sub_collection.image
              %}
              <a
                class="tjs-cp-subcat"
                href="{{ sub_collection.url }}"
                data-ajax-collection
                style="--tjs-subcat-accent: {{ block.settings.accent_color }}; --tjs-subcat-surface: {{ block.settings.surface_color }};"
                {{ block.shopify_attributes }}
              >
                <span class="tjs-cp-subcat__tile">
                  {% if sub_image != blank %}
                    {{ sub_image
                      | image_url: width: 560
                      | image_tag:
                        class: 'tjs-cp-subcat__icon',
                        widths: '180, 260, 360, 460, 560',
                        sizes: '(max-width: 749px) 36vw, 170px',
                        loading: 'lazy',
                        alt: sub_title
                    }}
                  {% else %}
                    <span class="tjs-cp-subcat__fallback" aria-hidden="true">
                      <svg viewBox="0 0 32 32" fill="none"><path d="M5 14.5 16 5l11 9.5V27H5V14.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 27v-8h8v8" stroke="currentColor" stroke-width="1.5"/></svg>
                    </span>
                  {% endif %}
                  {% if block.settings.badge != blank %}<span class="tjs-cp-subcat__badge">{{ block.settings.badge | escape }}</span>{% endif %}
                </span>
                <span class="tjs-cp-subcat__body">
                  <span class="tjs-cp-subcat__label">{{ sub_title | escape }}</span>
                  <span class="tjs-cp-subcat__meta">{{ sub_collection.all_products_count }} products</span>
                  <span class="tjs-cp-subcat__arrow" aria-hidden="true"><svg viewBox="0 0 18 18" fill="none"><path d="M4 9h10M10.5 5.5 14 9l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </nav>
    {% elsif show_type_navigation %}
      {% assign sorted_type_values = product_type_filter.values | sort: 'count' | reverse %}
      <nav class="tjs-cp-types" aria-label="{{ section.settings.product_type_heading | escape }}">
        <div class="tjs-cp-section-label">
          <div>
            <p>{{ section.settings.type_navigation_eyebrow | escape }}</p>
            <h2>{{ section.settings.product_type_heading | escape }}</h2>
          </div>
          {% if section.settings.product_type_hint != blank %}<span>{{ section.settings.product_type_hint | escape }}</span>{% endif %}
        </div>
        <div class="tjs-cp-types__rail" data-horizontal-rail>
          {% for value in sorted_type_values limit: section.settings.product_type_limit %}
            {% liquid
              assign matched_type_icon = blank
              for block in section.blocks
                if block.type == 'type_icon' and block.settings.filter_value == value.label and block.settings.icon != blank
                  assign matched_type_icon = block.settings.icon
                  break
                endif
              endfor
              assign type_link = value.url_to_add
              if value.active
                assign type_link = value.url_to_remove
              endif
              assign type_label_downcase = value.label | downcase
            %}
            <a class="tjs-cp-type{% if value.active %} is-active{% endif %}" href="{{ type_link }}" data-ajax-filter>
              <span class="tjs-cp-type__icon-holder">
                {% if matched_type_icon != blank %}
                  {{ matched_type_icon | image_url: width: 160 | image_tag: class: 'tjs-cp-type__icon', widths: '70, 100, 130, 160', sizes: '44px', loading: 'lazy', alt: value.label }}
                {% else %}
                  <span class="tjs-cp-type__icon" aria-hidden="true">
                    {% if type_label_downcase contains 'plate' %}
                      <svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="11" stroke="currentColor" stroke-width="1.45"/><circle cx="16" cy="16" r="6.2" stroke="currentColor" stroke-width="1.15" opacity=".55"/></svg>
                    {% elsif type_label_downcase contains 'bowl' %}
                      <svg viewBox="0 0 32 32" fill="none"><path d="M5 13h22c-.8 8-4.5 12-11 12S5.8 21 5 13Z" stroke="currentColor" stroke-width="1.45"/><path d="M8 13c1.8-3.4 4.4-5 8-5s6.2 1.6 8 5" stroke="currentColor" stroke-width="1.15" opacity=".55"/></svg>
                    {% elsif type_label_downcase contains 'glass' or type_label_downcase contains 'mug' or type_label_downcase contains 'cup' %}
                      <svg viewBox="0 0 32 32" fill="none"><path d="M9 5h12l-1.3 19H10.3L9 5Z" stroke="currentColor" stroke-width="1.45"/><path d="M10 10h10" stroke="currentColor" stroke-width="1.1" opacity=".55"/></svg>
                    {% elsif type_label_downcase contains 'cutlery' or type_label_downcase contains 'spoon' or type_label_downcase contains 'fork' %}
                      <svg viewBox="0 0 32 32" fill="none"><path d="M10 5v8M7 5v8M13 5v8M10 13v14M22 5c-3 3.5-3 8 0 10v12" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/></svg>
                    {% elsif type_label_downcase contains 'lamp' or type_label_downcase contains 'light' %}
                      <svg viewBox="0 0 32 32" fill="none"><path d="M10 15h12L19 6h-6l-3 9Z" stroke="currentColor" stroke-width="1.45"/><path d="M16 15v10M11 26h10" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/></svg>
                    {% elsif type_label_downcase contains 'organ' or type_label_downcase contains 'storage' or type_label_downcase contains 'box' %}
                      <svg viewBox="0 0 32 32" fill="none"><rect x="6" y="8" width="20" height="18" rx="2" stroke="currentColor" stroke-width="1.45"/><path d="M6 14h20M13 11h6" stroke="currentColor" stroke-width="1.2"/></svg>
                    {% else %}
                      <svg viewBox="0 0 32 32" fill="none"><path d="m16 5 2.3 6.7L25 14l-6.7 2.3L16 23l-2.3-6.7L7 14l6.7-2.3L16 5Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round"/></svg>
                    {% endif %}
                  </span>
                {% endif %}
              </span>
              <span class="tjs-cp-type__copy"><span class="tjs-cp-type__name">{{ value.label | escape }}</span><span class="tjs-cp-type__count">{{ value.count }} products</span></span>
              <span class="tjs-cp-type__check" aria-hidden="true">✓</span>
            </a>
          {% endfor %}
        </div>
      </nav>
    {% endif %}

    {% if intent_link_count > 0 %}
      <section class="tjs-cp-intents" aria-label="Shop by intention">
        <div class="tjs-cp-intents__label">
          <span>{{ section.settings.intent_eyebrow | escape }}</span>
          <strong>{{ section.settings.intent_heading | escape }}</strong>
        </div>
        <div class="tjs-cp-intents__rail" data-horizontal-rail>
          {% for block in section.blocks %}
            {% if block.type == 'intent_link' %}
              {% if block.settings.show_on_collection == blank or block.settings.show_on_collection.handle == current_collection.handle %}
              {% assign intent_url = block.settings.link %}
              {% if intent_url == blank and block.settings.collection != blank %}{% assign intent_url = block.settings.collection.url %}{% endif %}
              {% if block.settings.label != blank and intent_url != blank %}
                <a class="tjs-cp-intent" href="{{ intent_url }}"{% if block.settings.link == blank and block.settings.collection != blank %} data-ajax-collection{% endif %} style="--intent-bg:{{ block.settings.background_color }};--intent-text:{{ block.settings.text_color }};" {{ block.shopify_attributes }}>
                  <span class="tjs-cp-intent__icon" aria-hidden="true">
                    {% case block.settings.icon %}
                      {% when 'table' %}<svg viewBox="0 0 24 24" fill="none"><path d="M4 9h16v4H4V9Zm2 4v7m12-7v7M8 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {% when 'gift' %}<svg viewBox="0 0 24 24" fill="none"><path d="M4 10h16v10H4V10Zm-1-4h18v4H3V6Zm9 0v14M12 6H8.7A2.7 2.7 0 1 1 12 2.8V6Zm0 0h3.3A2.7 2.7 0 1 0 12 2.8V6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                      {% when 'organise' %}<svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M4 10h16M9 10v10m6-10v10" stroke="currentColor" stroke-width="1.4"/></svg>
                      {% when 'lunch' %}<svg viewBox="0 0 24 24" fill="none"><rect x="4" y="7" width="16" height="13" rx="3" stroke="currentColor" stroke-width="1.4"/><path d="M8 7V5.5A2.5 2.5 0 0 1 10.5 3h3A2.5 2.5 0 0 1 16 5.5V7M4 12h16" stroke="currentColor" stroke-width="1.4"/></svg>
                      {% else %}<svg viewBox="0 0 24 24" fill="none"><path d="M12 3 14.7 8.5l6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                    {% endcase %}
                  </span>
                  <span>{{ block.settings.label | escape }}</span>
                  <svg class="tjs-cp-intent__arrow" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4 9h10M10.5 5.5 14 9l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if trust_point_count > 0 %}
      <section class="tjs-cp-trust" aria-label="Why shop The June Shop">
        {% for block in section.blocks %}
          {% if block.type == 'trust_point' %}
            {% if block.settings.show_on_collection == blank or block.settings.show_on_collection.handle == current_collection.handle %}
            <div class="tjs-cp-trust__item" {{ block.shopify_attributes }}>
              <span class="tjs-cp-trust__icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'package' %}<svg viewBox="0 0 24 24" fill="none"><path d="m4 7 8-4 8 4-8 4-8-4Zm0 0v10l8 4 8-4V7M12 11v10" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  {% when 'support' %}<svg viewBox="0 0 24 24" fill="none"><path d="M5 13v-1a7 7 0 0 1 14 0v1M5 12.5H4.5A2.5 2.5 0 0 0 2 15v1a2.5 2.5 0 0 0 2.5 2.5H6v-6Zm14 0h.5A2.5 2.5 0 0 1 22 15v1a2.5 2.5 0 0 1-2.5 2.5H18v-6Z" stroke="currentColor" stroke-width="1.4"/></svg>
                  {% when 'payment' %}<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M3 10h18M7 15h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                  {% when 'delivery' %}<svg viewBox="0 0 24 24" fill="none"><path d="M3 6h11v11H3V6Zm11 4h4l3 3v4h-7v-7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="7" cy="19" r="1.5" fill="currentColor"/><circle cx="18" cy="19" r="1.5" fill="currentColor"/></svg>
                  {% else %}<svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% endcase %}
              </span>
              <span class="tjs-cp-trust__copy"><strong>{{ block.settings.heading | escape }}</strong><span>{{ block.settings.text | escape }}</span></span>
            </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </section>
    {% endif %}

    {% capture tjs_filter_groups_markup %}
      {% for filter in current_collection.filters %}
        {% unless filter.param_name == 'filter.p.product_type' and section.settings.hide_product_type_in_filters %}
          <details class="tjs-cp-filter-group">
            <summary>
              <span>{{ filter.label | escape }}</span>
              <span class="tjs-cp-filter-group__summary-meta">
                {% if filter.active_values.size > 0 %}<b>{{ filter.active_values.size }}</b>{% endif %}
                <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m3 5 4 4 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </summary>

            <div class="tjs-cp-filter-group__panel">
              {% case filter.type %}
                {% when 'boolean', 'list' %}
                  <div class="tjs-cp-filter-group__values{% if filter.presentation == 'swatch' or filter.presentation == 'image' %} tjs-cp-filter-group__values--visual{% endif %}">
                    {% for value in filter.values %}
                      {% liquid
                        assign value_url = value.url_to_add
                        if value.active
                          assign value_url = value.url_to_remove
                        endif
                        assign value_label_downcase = value.label | downcase
                        assign fallback_swatch = '#D8D3CC'
                        case value_label_downcase
                          when 'black'
                            assign fallback_swatch = '#171717'
                          when 'white'
                            assign fallback_swatch = '#FFFFFF'
                          when 'ivory', 'cream', 'off white', 'off-white'
                            assign fallback_swatch = '#F3EBDD'
                          when 'beige', 'sand'
                            assign fallback_swatch = '#D9C5A8'
                          when 'brown', 'tan'
                            assign fallback_swatch = '#8A6046'
                          when 'red'
                            assign fallback_swatch = '#B84242'
                          when 'pink', 'blush'
                            assign fallback_swatch = '#E6A9B8'
                          when 'orange', 'terracotta'
                            assign fallback_swatch = '#D77B4C'
                          when 'yellow', 'mustard'
                            assign fallback_swatch = '#D8AB3D'
                          when 'green', 'olive'
                            assign fallback_swatch = '#73845D'
                          when 'blue', 'navy'
                            assign fallback_swatch = '#426788'
                          when 'light blue', 'sky blue'
                            assign fallback_swatch = '#9EC8DE'
                          when 'purple', 'lavender'
                            assign fallback_swatch = '#9A7FB2'
                          when 'grey', 'gray', 'silver'
                            assign fallback_swatch = '#A8A8A8'
                          when 'gold'
                            assign fallback_swatch = '#C6A15B'
                          when 'multicolour', 'multicolor', 'multi'
                            assign fallback_swatch = 'linear-gradient(135deg,#EA7A70,#E7C65B,#6EBB9B,#6A8FD5)'
                        endcase
                        assign filter_label_downcase = filter.label | downcase
                        assign should_show_swatch = false
                        if filter.presentation == 'swatch' or filter_label_downcase contains 'colour' or filter_label_downcase contains 'color'
                          assign should_show_swatch = true
                        endif
                      %}
                      <a class="tjs-cp-filter-value{% if value.active %} is-active{% endif %}{% if value.count == 0 and value.active == false %} is-disabled{% endif %}{% if should_show_swatch or filter.presentation == 'image' %} tjs-cp-filter-value--visual{% endif %}" href="{{ value_url }}" data-ajax-filter {% if value.count == 0 and value.active == false %}aria-disabled="true"{% endif %}>
                        {% if filter.presentation == 'image' and value.image != blank %}
                          <span class="tjs-cp-filter-value__visual tjs-cp-filter-value__visual--image">
                            {{ value.image | image_url: width: 96 | image_tag: widths: '48, 72, 96', sizes: '38px', loading: 'lazy', alt: value.label }}
                          </span>
                        {% elsif should_show_swatch %}
                          <span class="tjs-cp-filter-value__visual tjs-cp-filter-value__visual--swatch"
                            {% if value.swatch.image != blank %}style="background-image:url('{{ value.swatch.image | image_url: width: 96 }}');"
                            {% elsif value.swatch.color != blank %}style="--tjs-filter-swatch:{{ value.swatch.color }};"
                            {% else %}style="--tjs-filter-swatch:{{ fallback_swatch }};"{% endif %}>
                          </span>
                        {% else %}
                          <span class="tjs-cp-filter-value__box" aria-hidden="true">{% if value.active %}<svg viewBox="0 0 14 14" fill="none"><path d="m3 7 2.4 2.4L11 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</span>
                        {% endif %}
                        <span class="tjs-cp-filter-value__label">{{ value.label | escape }}</span>
                        <span class="tjs-cp-filter-value__count">{{ value.count }}</span>
                      </a>
                    {% endfor %}
                  </div>
                {% when 'price_range' %}
                  <form class="tjs-cp-price-filter" data-price-filter data-min-param="{{ filter.min_value.param_name }}" data-max-param="{{ filter.max_value.param_name }}">
                    <label><span>Minimum</span><span class="tjs-cp-price-filter__input"><b>{{ cart.currency.symbol | default: '₹' }}</b><input type="number" min="0" name="min" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}" placeholder="0"></span></label>
                    <label><span>Maximum</span><span class="tjs-cp-price-filter__input"><b>{{ cart.currency.symbol | default: '₹' }}</b><input type="number" min="0" name="max" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"></span></label>
                    <button type="submit" class="tjs-cp-price-filter__apply">Apply</button>
                  </form>
              {% endcase %}
            </div>
          </details>
        {% endunless %}
      {% endfor %}
    {% endcapture %}

    <div class="tjs-cp-toolbar">
      <button type="button" class="tjs-cp-toolbar__button" data-open-filters>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M5.5 10h9M8 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Filters
        {% if active_filter_count > 0 %}<span class="tjs-cp-toolbar__count">{{ active_filter_count }}</span>{% endif %}
      </button>

      <div class="tjs-cp-toolbar__result">
        <strong>{{ current_collection.products_count }}</strong> products in this edit
      </div>

      <div class="tjs-cp-toolbar__sort-wrap">
        <select class="tjs-cp-toolbar__sort" data-sort-by aria-label="Sort products">
          {% for option in current_collection.sort_options %}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {% endfor %}
        </select>
        <svg class="tjs-cp-toolbar__sort-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m6 8 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>

    {% if active_filter_count > 0 %}
      <div class="tjs-cp-active-filters">
        {% for filter in current_collection.filters %}
          {% for value in filter.active_values %}
            <a class="tjs-cp-active-filter" href="{{ value.url_to_remove }}" data-ajax-filter>
              {{ value.label | escape }}
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 3 6 6M9 3 3 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
            </a>
          {% endfor %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value != nil or filter.max_value.value != nil %}
              <a class="tjs-cp-active-filter" href="{{ filter.url_to_remove }}" data-ajax-filter>
                Price
                <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 3 6 6M9 3 3 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
        <a class="tjs-cp-active-filter" href="{{ current_collection.url }}?sort_by={{ sort_by }}" data-ajax-filter>Clear all</a>
      </div>
    {% endif %}

    {% if visible_filter_count > 0 %}
      <div class="tjs-cp-filterbar" data-filterbar>
        <div class="tjs-cp-filterbar__label">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M5.5 10h9M8 15h4" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/></svg>
          Refine
        </div>
        <div class="tjs-cp-filterbar__groups">{{ tjs_filter_groups_markup }}</div>
        {% if visible_filter_count > section.settings.desktop_filter_limit %}
          <button type="button" class="tjs-cp-filterbar__more" data-open-filters>
            More filters
            <span>{{ visible_filter_count | minus: section.settings.desktop_filter_limit }}</span>
          </button>
        {% endif %}
      </div>
    {% endif %}

    {% paginate current_collection.products by section.settings.products_per_page %}
      <div class="tjs-cp-grid" data-product-grid>
        {% if current_collection.products.size > 0 %}
          {% for product in current_collection.products %}
            {% liquid
              assign standard_price = product.price
              assign card_price = standard_price
              assign card_compare_price = product.compare_at_price_max
              assign event_price_enabled = false
              if section.settings.price_mode == 'event'
                assign card_price = standard_price | times: event_multiplier | round
                assign card_compare_price = standard_price
                assign event_price_enabled = true
              endif

              assign product_rating = product.metafields.reviews.rating.value
              assign product_rating_count = product.metafields.reviews.rating_count.value
              assign has_real_rating = false
              if product_rating != blank and product_rating_count != blank and product_rating_count > 0
                assign has_real_rating = true
              endif

              assign is_editorial_favourite = false
              if product.tags contains 'merch-bestseller' or product.tags contains 'bestseller' or product.tags contains 'customer-favourite'
                assign is_editorial_favourite = true
              endif

              assign card_benefit = product.metafields.custom.short_description | metafield_text
              if card_benefit == blank
                assign card_benefit = product.metafields.custom.primary_use | metafield_text
              endif
              assign card_material = product.metafields.custom.material | metafield_text
              assign card_dimensions = product.metafields.custom.dimensions_display | metafield_text
              assign card_dispatch = product.metafields.custom.dispatch_class | metafield_text
              assign card_return = product.metafields.custom.return_class | metafield_text
              assign card_whats_in_box = product.metafields.custom.whats_in_box | metafield_text
              assign colour_option = blank
              for product_option in product.options_with_values
                assign option_name_downcase = product_option.name | downcase
                if option_name_downcase contains 'color' or option_name_downcase contains 'colour'
                  assign colour_option = product_option
                  break
                endif
              endfor
            %}

            <div class="tjs-cp-grid__item" data-grid-item>
              <article class="tjs-product-card">
                <div class="tjs-product-card__media-wrap">
                  <div class="tjs-product-card__badge-stack">
                    {% if event_price_enabled and section.settings.show_event_badge %}
                      <span class="tjs-product-card__badge tjs-product-card__badge--event">{{ section.settings.event_badge_text | escape }}</span>
                    {% elsif product.compare_at_price_max > product.price %}
                      {% assign saving_amount = product.compare_at_price_max | minus: product.price %}
                      {% assign saving_percent = saving_amount | times: 100.0 | divided_by: product.compare_at_price_max | round %}
                      <span class="tjs-product-card__badge">Save {{ saving_percent }}%</span>
                    {% endif %}
                    {% if is_editorial_favourite and section.settings.show_favourite_badge %}<span class="tjs-product-card__badge">Customer favourite</span>{% endif %}
                  </div>

                  <div class="tjs-product-card__media">
                    <a class="tjs-product-card__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}"></a>
                    {% if product.featured_image != blank %}
                      {{ product.featured_image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'tjs-product-card__image',
                          widths: '240, 360, 480, 640, 760, 900, 1100, 1200',
                          sizes: '(max-width: 749px) 46vw, (max-width: 1199px) 31vw, 23vw',
                          loading: 'lazy',
                          alt: product.featured_image.alt | default: product.title
                      }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'tjs-product-card__image' }}
                    {% endif %}

                    {% if section.settings.show_secondary_image and product.images[1] != blank %}
                      {{ product.images[1]
                        | image_url: width: 1200
                        | image_tag:
                          class: 'tjs-product-card__image-secondary',
                          widths: '240, 360, 480, 640, 760, 900, 1100, 1200',
                          sizes: '(max-width: 749px) 46vw, (max-width: 1199px) 31vw, 23vw',
                          loading: 'lazy',
                          alt: product.images[1].alt | default: product.title
                      }}
                    {% endif %}

                    <div class="tjs-product-card__actions">
                      <button
                        type="button"
                        class="tjs-product-card__quick"
                        data-quick-view
                        data-product-handle="{{ product.handle }}"
                        data-short-description="{{ card_benefit | strip_html | escape }}"
                        data-material="{{ card_material | strip_html | escape }}"
                        data-dimensions="{{ card_dimensions | strip_html | escape }}"
                        data-dispatch="{{ card_dispatch | strip_html | escape }}"
                        data-return-class="{{ card_return | strip_html | escape }}"
                        data-whats-in-box="{{ card_whats_in_box | strip_html | escape }}"
                        aria-label="Quick view {{ product.title | escape }}"
                        title="Quick view"
                      >
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M1.75 10s3.25-5.5 8.25-5.5 8.25 5.5 8.25 5.5-3.25 5.5-8.25 5.5S1.75 10 1.75 10Z" stroke="currentColor" stroke-width="1.4"/><circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.4"/></svg>
                        <span>Quick view</span>
                      </button>

                      {% if product.available and product.has_only_default_variant %}
                        <form method="post" action="{{ routes.cart_add_url }}" class="tjs-product-card__add-form" data-card-add-form>
                          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="tjs-product-card__add" aria-label="Add {{ product.title | escape }} to cart" title="Add to cart" data-product-title="{{ product.title | escape }}">
                            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 4.5h1.2c.5 0 .94.34 1.06.83L5.9 8h9.17c.73 0 1.26.72 1.03 1.41l-1.07 3.29c-.15.47-.59.8-1.09.8H8.2c-.48 0-.91-.3-1.08-.74L4.65 5.5H3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="8.25" cy="15.75" r="1.1" fill="currentColor"/><circle cx="13.75" cy="15.75" r="1.1" fill="currentColor"/></svg>
                            <span>Add</span>
                          </button>
                        </form>
                      {% elsif product.available %}
                        <button type="button" class="tjs-product-card__options" data-quick-view data-product-handle="{{ product.handle }}" data-short-description="{{ card_benefit | strip_html | escape }}" data-material="{{ card_material | strip_html | escape }}" data-dimensions="{{ card_dimensions | strip_html | escape }}" data-dispatch="{{ card_dispatch | strip_html | escape }}" data-return-class="{{ card_return | strip_html | escape }}" data-whats-in-box="{{ card_whats_in_box | strip_html | escape }}" aria-label="Choose options for {{ product.title | escape }}" title="Choose options">
                          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4.25v11.5M4.25 10h11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                          <span>Options</span>
                        </button>
                      {% else %}
                        <button type="button" class="tjs-product-card__add" disabled aria-label="Sold out">
                          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        </button>
                      {% endif %}
                    </div>
                  </div>
                </div>

                <div class="tjs-product-card__content">
                  {% if has_real_rating and section.settings.show_ratings %}
                    <div class="tjs-product-card__rating" aria-label="{{ product_rating.rating }} out of {{ product_rating.scale_max }} stars from {{ product_rating_count }} reviews">
                      <span class="tjs-product-card__rating-stars" aria-hidden="true">
                        {% for i in (1..5) %}
                          <svg viewBox="0 0 18 18"><path d="m9 1.8 2.15 4.36 4.81.7-3.48 3.39.82 4.79L9 12.78l-4.3 2.26.82-4.79L2.04 6.86l4.81-.7L9 1.8Z" fill="currentColor" opacity="{% if product_rating.rating >= i %}1{% else %}.25{% endif %}"/></svg>
                        {% endfor %}
                      </span>
                      <span class="tjs-product-card__rating-count">{{ product_rating.rating | round: 1 }} · {{ product_rating_count }}</span>
                    </div>
                  {% elsif is_editorial_favourite and section.settings.show_editorial_proof %}
                    <span class="tjs-product-card__editorial-proof">
                      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m8 1.8 1.65 3.34 3.69.54-2.67 2.6.63 3.68L8 10.23l-3.3 1.73.63-3.68-2.67-2.6 3.69-.54L8 1.8Z" fill="currentColor"/></svg>
                      A customer favourite
                    </span>
                  {% endif %}

                  <h3 class="tjs-product-card__title"><a href="{{ product.url }}" data-product-link>{{ product.title }}</a></h3>

                  {% if section.settings.show_card_benefit and card_benefit != blank %}
                    <p class="tjs-product-card__benefit">{{ card_benefit | strip_html | truncate: 78 }}</p>
                  {% endif %}

                  {% if colour_option != blank and section.settings.show_colour_swatches %}
                    <div class="tjs-product-card__swatches" aria-label="Available colours">
                      {% for option_value in colour_option.values limit: 4 %}
                        {% assign option_name = option_value.name | default: option_value %}
                        {% assign option_downcase = option_name | downcase %}
                        {% assign fallback_colour = '#D9D3CB' %}
                        {% case option_downcase %}
                          {% when 'black' %}{% assign fallback_colour = '#1B1B1B' %}
                          {% when 'white' %}{% assign fallback_colour = '#FFFFFF' %}
                          {% when 'red' %}{% assign fallback_colour = '#B64242' %}
                          {% when 'blue' %}{% assign fallback_colour = '#446FA8' %}
                          {% when 'green' %}{% assign fallback_colour = '#5D8166' %}
                          {% when 'yellow' %}{% assign fallback_colour = '#E2B945' %}
                          {% when 'pink' %}{% assign fallback_colour = '#D995A6' %}
                          {% when 'purple' %}{% assign fallback_colour = '#7A628E' %}
                          {% when 'orange' %}{% assign fallback_colour = '#D68142' %}
                          {% when 'brown' %}{% assign fallback_colour = '#76523E' %}
                          {% when 'beige' %}{% assign fallback_colour = '#D8C6A8' %}
                          {% when 'gold' %}{% assign fallback_colour = '#C5A04E' %}
                          {% when 'silver' %}{% assign fallback_colour = '#B7BCC2' %}
                          {% when 'grey', 'gray' %}{% assign fallback_colour = '#858585' %}
                        {% endcase %}
                        <span class="tjs-product-card__swatch" title="{{ option_name | escape }}" style="--swatch:{% if option_value.swatch.color != blank %}{{ option_value.swatch.color.rgb }}{% else %}{{ fallback_colour }}{% endif %};{% if option_value.swatch.image != blank %}--swatch-image:url('{{ option_value.swatch.image | image_url: width: 60 }}');{% endif %}"></span>
                      {% endfor %}
                      {% if colour_option.values.size > 4 %}<span class="tjs-product-card__swatch-more">+{{ colour_option.values.size | minus: 4 }}</span>{% endif %}
                    </div>
                  {% endif %}

                  {% if section.settings.show_card_specs and card_material != blank %}
                    <div class="tjs-product-card__spec-line"><span>{{ card_material | truncate: 28 }}</span>{% if card_dimensions != blank %}<span>{{ card_dimensions | truncate: 30 }}</span>{% endif %}</div>
                  {% endif %}

                  {% if product.available %}
                    <div class="tjs-product-card__price-row">
                      <span class="tjs-product-card__price">{% if product.price_varies %}From {% endif %}{{ card_price | money }}</span>
                      {% if card_compare_price > card_price %}<span class="tjs-product-card__compare">{{ card_compare_price | money }}</span>{% endif %}
                      {% if event_price_enabled and section.settings.event_price_note != blank %}<span class="tjs-product-card__price-note">{{ section.settings.event_price_note | escape }}</span>{% endif %}
                    </div>
                  {% else %}
                    <span class="tjs-product-card__soldout">Sold out</span>
                  {% endif %}
                </div>
              </article>
            </div>

            {% if paginate.current_page == 1 %}
              {% for block in section.blocks %}
                {% if block.type == 'promo_banner' and block.settings.after_product == forloop.index %}
                  {% assign show_promo = true %}
                  {% if block.settings.show_on_collection != blank and block.settings.show_on_collection.handle != current_collection.handle %}
                    {% assign show_promo = false %}
                  {% endif %}
                  {% if show_promo %}
                    {% assign promo_image = block.settings.image %}
                    {% assign promo_image_mobile = block.settings.image_mobile | default: promo_image %}
                    <article
                      class="tjs-cp-promo{% if block.settings.width == 'wide' %} tjs-cp-promo--wide{% endif %}"
                      style="--tjs-promo-bg: {{ block.settings.background_color }}; --tjs-promo-text: {{ block.settings.text_color }};"
                      data-grid-item
                      {{ block.shopify_attributes }}
                    >
                      {% if block.settings.link != blank %}<a class="tjs-cp-promo__link" href="{{ block.settings.link }}">{% else %}<div class="tjs-cp-promo__link">{% endif %}
                        <div class="tjs-cp-promo__content">
                          {% if block.settings.eyebrow != blank %}<p class="tjs-cp-promo__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
                          {% if block.settings.heading != blank %}<h3 class="tjs-cp-promo__title">{{ block.settings.heading | escape }}</h3>{% endif %}
                          {% if block.settings.text != blank %}<div class="tjs-cp-promo__text">{{ block.settings.text }}</div>{% endif %}
                          {% if block.settings.button_label != blank %}<span class="tjs-cp-promo__cta">{{ block.settings.button_label | escape }} →</span>{% endif %}
                        </div>
                        <div class="tjs-cp-promo__media">
                          {% if promo_image != blank %}
                            <picture>
                              {% if promo_image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ promo_image_mobile | image_url: width: 900 }}">{% endif %}
                              {{ promo_image | image_url: width: 1600 | image_tag: class: 'tjs-cp-promo__image', widths: '500, 700, 900, 1200, 1600', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'lazy', alt: block.settings.heading }}
                            </picture>
                          {% else %}
                            {{ 'collection-2' | placeholder_svg_tag: 'tjs-cp-promo__image' }}
                          {% endif %}
                        </div>
                      {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}
                    </article>
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="tjs-cp-empty">
            <h3>No products found</h3>
            <p>Try removing one or more filters to continue exploring.</p>
          </div>
        {% endif %}
      </div>

      {% if paginate.next %}
        <div class="tjs-cp-load-more">
          <button type="button" class="tjs-cp-load-more__button" data-load-more data-next-url="{{ paginate.next.url }}">
            Load more products
          </button>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>

  <aside class="tjs-cp-drawer" data-filter-drawer aria-hidden="true">
    <button type="button" class="tjs-cp-drawer__overlay" data-close-filters aria-label="Close filters"></button>
    <div class="tjs-cp-drawer__panel" role="dialog" aria-modal="true" aria-label="Filter products">
      <div class="tjs-cp-drawer__header">
        <h2>Refine this edit</h2>
        <button type="button" class="tjs-cp-drawer__close" data-close-filters aria-label="Close filters">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="tjs-cp-drawer__body">
        {{ tjs_filter_groups_markup }}
      </div>
    </div>
  </aside>

  <aside class="tjs-cp-quickview" data-quickview aria-hidden="true">
    <button type="button" class="tjs-cp-quickview__overlay" data-close-quickview aria-label="Close quick view"></button>
    <div class="tjs-cp-quickview__panel" role="dialog" aria-modal="true" aria-label="Product quick view">
      <div class="tjs-cp-quickview__header">
        <h2>Quick view</h2>
        <button type="button" class="tjs-cp-quickview__close" data-close-quickview aria-label="Close quick view">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="tjs-cp-quickview__body" data-quickview-body>
        <div class="tjs-cp-quickview__media"><span class="tjs-cp__spinner"></span></div>
        <div class="tjs-cp-quickview__content"></div>
      </div>
    </div>
  </aside>

  <div class="tjs-cp-toast" data-toast role="status" aria-live="polite">
    <span class="tjs-cp-toast__icon" aria-hidden="true">✓</span>
    <span class="tjs-cp-toast__copy"><strong>Added to cart</strong><span data-toast-title></span></span>
    <a class="tjs-cp-toast__link" href="{{ routes.cart_url }}">View cart</a>
  </div>
</tjs-collection-page>

<script>
  (() => {
    if (customElements.get('tjs-collection-page')) return;

    class TjsCollectionPage extends HTMLElement {
      connectedCallback() {
        if (this.dataset.initialized === 'true') return;
        this.dataset.initialized = 'true';
        this.sectionId = this.dataset.sectionId;
        this.rootUrl = this.dataset.rootUrl || '/';
        this.priceMode = this.dataset.priceMode || 'standard';
        this.eventPercent = Number(this.dataset.eventPercent || 50);
        this.eventNote = this.dataset.eventNote || '';
        this.filterDrawer = this.querySelector('[data-filter-drawer]');
        this.quickview = this.querySelector('[data-quickview]');
        this.quickviewBody = this.querySelector('[data-quickview-body]');
        this.toast = this.querySelector('[data-toast]');
        this.abortController = new AbortController();
        this.signal = this.abortController.signal;
        this.sectionCache = TjsCollectionPage.sectionCache || (TjsCollectionPage.sectionCache = new Map());
        this.productCache = TjsCollectionPage.productCache || (TjsCollectionPage.productCache = new Map());
        this.bindEvents();
        this.restoreProductScroll();
      }

      disconnectedCallback() {
        this.abortController?.abort();
        clearTimeout(this.toastTimer);
      }

      bindEvents() {
        this.addEventListener('click', (event) => {
          const collectionLink = event.target.closest('[data-ajax-collection]');
          if (collectionLink && !event.metaKey && !event.ctrlKey && !event.shiftKey && event.button === 0) {
            event.preventDefault();
            this.navigate(collectionLink.href, true, 'hierarchy');
            return;
          }

          const filterLink = event.target.closest('[data-ajax-filter]');
          if (filterLink && filterLink.getAttribute('aria-disabled') !== 'true') {
            event.preventDefault();
            this.closeFilters();
            this.navigate(filterLink.href, true, 'products');
            return;
          }

          const productLink = event.target.closest('[data-product-link], .tjs-product-card__image-link');
          if (productLink) this.rememberProductScroll();

          const quickButton = event.target.closest('[data-quick-view]');
          if (quickButton) {
            event.preventDefault();
            this.openQuickview(quickButton.dataset.productHandle, quickButton.dataset);
            return;
          }

          if (event.target.closest('[data-open-filters]')) this.openFilters();
          if (event.target.closest('[data-close-filters]')) this.closeFilters();
          if (event.target.closest('[data-close-quickview]')) this.closeQuickview();

          const loadMore = event.target.closest('[data-load-more]');
          if (loadMore) this.loadMore(loadMore);
        }, { signal: this.signal });

        this.addEventListener('change', (event) => {
          const sort = event.target.closest('[data-sort-by]');
          if (!sort) return;
          const url = new URL(window.location.href);
          url.searchParams.set('sort_by', sort.value);
          url.searchParams.delete('page');
          this.navigate(url.toString(), true, 'products');
        }, { signal: this.signal });

        this.addEventListener('submit', (event) => {
          const cardForm = event.target.closest('[data-card-add-form]');
          if (cardForm) {
            event.preventDefault();
            const button = cardForm.querySelector('button[type="submit"]');
            const variantId = cardForm.querySelector('[name="id"]')?.value;
            const quantity = Number(cardForm.querySelector('[name="quantity"]')?.value || 1);
            this.handleCardAdd(cardForm, button, variantId, quantity);
            return;
          }

          const priceForm = event.target.closest('[data-price-filter]');
          if (priceForm) {
            event.preventDefault();
            const url = new URL(window.location.href);
            const minValue = priceForm.querySelector('[name="min"]')?.value;
            const maxValue = priceForm.querySelector('[name="max"]')?.value;
            const minParam = priceForm.dataset.minParam;
            const maxParam = priceForm.dataset.maxParam;
            if (minValue) url.searchParams.set(minParam, minValue); else url.searchParams.delete(minParam);
            if (maxValue) url.searchParams.set(maxParam, maxValue); else url.searchParams.delete(maxParam);
            url.searchParams.delete('page');
            this.closeFilters();
            this.navigate(url.toString(), true, 'products');
          }
        }, { signal: this.signal });

        this.addEventListener('toggle', (event) => {
          const openedGroup = event.target.closest?.('.tjs-cp-filterbar .tjs-cp-filter-group');
          if (!openedGroup?.open) return;
          this.querySelectorAll('.tjs-cp-filterbar .tjs-cp-filter-group[open]').forEach((group) => {
            if (group !== openedGroup) group.removeAttribute('open');
          });
        }, { capture: true, signal: this.signal });

        document.addEventListener('click', (event) => {
          if (this.contains(event.target) && event.target.closest?.('.tjs-cp-filterbar')) return;
          this.querySelectorAll('.tjs-cp-filterbar .tjs-cp-filter-group[open]').forEach((group) => group.removeAttribute('open'));
        }, { signal: this.signal });

        this.onPopState = () => this.navigate(window.location.href, false, 'products');
        window.addEventListener('popstate', this.onPopState, { signal: this.signal });

        this.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          this.closeFilters();
          this.closeQuickview();
        }, { signal: this.signal });
      }

      async navigate(rawUrl, pushState, scrollTarget = 'products') {
        const url = new URL(rawUrl, window.location.origin);
        url.searchParams.delete('section_id');
        const requestUrl = new URL(url.toString());
        requestUrl.searchParams.set('section_id', this.sectionId);
        const cacheKey = requestUrl.toString();

        this.classList.add('is-loading');
        try {
          let html = this.sectionCache.get(cacheKey);
          if (!html) {
            const response = await fetch(cacheKey, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error(`Request failed: ${response.status}`);
            html = await response.text();
            this.sectionCache.set(cacheKey, html);
          }
          const template = document.createElement('template');
          template.innerHTML = html.trim();
          const nextRoot = template.content.querySelector('tjs-collection-page') || template.content.firstElementChild;
          if (!nextRoot) throw new Error('Collection section not found');
          if (pushState) window.history.pushState({}, '', url.toString());
          this.replaceWith(nextRoot);
          requestAnimationFrame(() => {
            const target = scrollTarget === 'hierarchy'
              ? (nextRoot.querySelector('.tjs-cp-subcats, .tjs-cp-types, .tjs-cp-intents') || nextRoot)
              : (nextRoot.querySelector('.tjs-cp-toolbar') || nextRoot.querySelector('[data-product-grid]') || nextRoot);
            const top = target.getBoundingClientRect().top + window.scrollY - 96;
            window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
          });
        } catch (error) {
          console.error(error);
          window.location.href = url.toString();
        } finally {
          this.classList.remove('is-loading');
        }
      }

      async loadMore(button) {
        const nextUrl = button.dataset.nextUrl;
        if (!nextUrl) return;
        button.disabled = true;
        button.textContent = 'Loading…';
        const url = new URL(nextUrl, window.location.origin);
        url.searchParams.set('section_id', this.sectionId);

        try {
          const response = await fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
          if (!response.ok) throw new Error('Unable to load more products');
          const html = await response.text();
          const template = document.createElement('template');
          template.innerHTML = html.trim();
          const nextRoot = template.content.querySelector('tjs-collection-page') || template.content.firstElementChild;
          const currentGrid = this.querySelector('[data-product-grid]');
          const nextGrid = nextRoot?.querySelector('[data-product-grid]');
          if (!currentGrid || !nextGrid) throw new Error('Product grid missing');
          nextGrid.querySelectorAll('[data-grid-item]').forEach((item) => currentGrid.appendChild(item));
          const nextButton = nextRoot.querySelector('[data-load-more]');
          if (nextButton?.dataset.nextUrl) {
            button.dataset.nextUrl = nextButton.dataset.nextUrl;
            button.disabled = false;
            button.textContent = 'Load more products';
          } else {
            button.closest('.tjs-cp-load-more')?.remove();
          }
        } catch (error) {
          console.error(error);
          button.disabled = false;
          button.textContent = 'Try again';
        }
      }

      openFilters() {
        if (!this.filterDrawer) return;
        this.filterDrawer.classList.add('is-open');
        this.filterDrawer.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
        this.filterDrawer.querySelector('.tjs-cp-drawer__close')?.focus();
      }

      closeFilters() {
        if (!this.filterDrawer) return;
        this.filterDrawer.classList.remove('is-open');
        this.filterDrawer.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
      }

      async openQuickview(handle, context = {}) {
        if (!this.quickview || !handle) return;
        this.quickviewContext = context || {};
        this.quickview.classList.add('is-open');
        this.quickview.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
        this.quickviewBody.innerHTML = '<div class="tjs-cp-quickview__media"><span class="tjs-cp__spinner"></span></div><div class="tjs-cp-quickview__content"></div>';
        this.quickview.querySelector('.tjs-cp-quickview__close')?.focus();

        try {
          const productUrl = `${this.rootUrl}products/${handle}.js`;
          let product = this.productCache.get(productUrl);
          if (!product) {
            const response = await fetch(productUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error('Product unavailable');
            product = await response.json();
            this.productCache.set(productUrl, product);
          }
          this.renderQuickview(product);
        } catch (error) {
          console.error(error);
          this.quickviewBody.innerHTML = '<div class="tjs-cp-quickview__content"><p>We could not load this product. Please open the full product page.</p></div>';
        }
      }

      closeQuickview() {
        if (!this.quickview) return;
        this.quickview.classList.remove('is-open');
        this.quickview.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
      }

      renderQuickview(product) {
        const image = product.featured_image || product.images?.[0] || '';
        const visibleOptions = (product.variants?.length === 1 && product.options?.length === 1 && String(product.options[0]).toLowerCase() === 'title') ? [] : (product.options || []);
        const optionsMarkup = visibleOptions.map((optionName, optionIndex) => {
          const values = [...new Set(product.variants.map((variant) => variant.options[optionIndex]))];
          return `<div class="tjs-cp-quickview__option"><label for="TjsQuickOption-${this.sectionId}-${optionIndex}">${this.escapeHtml(optionName)}</label><select id="TjsQuickOption-${this.sectionId}-${optionIndex}" data-quick-option data-option-index="${optionIndex}">${values.map((value) => `<option value="${this.escapeHtml(value)}">${this.escapeHtml(value)}</option>`).join('')}</select></div>`;
        }).join('');

        const context = this.quickviewContext || {};
        const specs = [
          context.material ? ['Material', context.material] : null,
          context.dimensions ? ['Dimensions', context.dimensions] : null,
          context.whatsInBox ? ["What's included", context.whatsInBox] : null,
          context.dispatch ? ['Dispatch', context.dispatch] : null,
          context.returnClass ? ['Returns', context.returnClass] : null
        ].filter(Boolean);
        const specsMarkup = specs.length ? `<div class="tjs-cp-quickview__specs">${specs.map(([label, value]) => `<div><span>${this.escapeHtml(label)}</span><strong>${this.escapeHtml(value)}</strong></div>`).join('')}</div>` : '';

        this.quickviewBody.innerHTML = `
          <div class="tjs-cp-quickview__media">${image ? `<img class="tjs-cp-quickview__image" src="${image}" alt="${this.escapeHtml(product.title)}">` : ''}</div>
          <div class="tjs-cp-quickview__content">
            <span class="tjs-cp-quickview__eyebrow">The June Edit</span>
            <h3 class="tjs-cp-quickview__title">${this.escapeHtml(product.title)}</h3>
            ${context.shortDescription ? `<p class="tjs-cp-quickview__description">${this.escapeHtml(context.shortDescription)}</p>` : ''}
            <div class="tjs-cp-quickview__price"><span class="tjs-cp-quickview__price-main" data-qv-price></span><span class="tjs-cp-quickview__price-compare" data-qv-compare></span>${this.eventNote && this.priceMode === 'event' ? `<span class="tjs-cp-quickview__note">${this.escapeHtml(this.eventNote)}</span>` : ''}</div>
            ${specsMarkup}
            <div class="tjs-cp-quickview__options">${optionsMarkup}</div>
            <div class="tjs-cp-quickview__quantity"><label for="TjsQuickQuantity-${this.sectionId}">Quantity</label><input id="TjsQuickQuantity-${this.sectionId}" type="number" min="1" value="1" data-qv-quantity></div>
            <button type="button" class="tjs-cp-quickview__add" data-qv-add>Add to cart</button>
            <a class="tjs-cp-quickview__product-link" href="${product.url || `${this.rootUrl}products/${product.handle}`}">View full product →</a>
          </div>`;

        this.quickviewProduct = product;
        this.quickviewBody.querySelectorAll('[data-quick-option]').forEach((select) => select.addEventListener('change', () => this.updateQuickviewVariant(), { signal: this.signal }));
        this.quickviewBody.querySelector('[data-qv-add]')?.addEventListener('click', () => this.addQuickviewVariant(), { signal: this.signal });
        this.updateQuickviewVariant();
      }

      updateQuickviewVariant() {
        if (!this.quickviewProduct) return;
        const selectedOptions = [...this.quickviewBody.querySelectorAll('[data-quick-option]')].map((select) => select.value);
        const variant = this.quickviewProduct.variants.find((item) => item.options.every((option, index) => option === selectedOptions[index])) || this.quickviewProduct.variants[0];
        this.quickviewVariant = variant;
        const displayPrice = this.priceMode === 'event' ? Math.round(variant.price * (this.eventPercent / 100)) : variant.price;
        const comparePrice = this.priceMode === 'event' ? variant.price : variant.compare_at_price;
        const priceNode = this.quickviewBody.querySelector('[data-qv-price]');
        const compareNode = this.quickviewBody.querySelector('[data-qv-compare]');
        const addButton = this.quickviewBody.querySelector('[data-qv-add]');
        if (priceNode) priceNode.textContent = this.formatMoney(displayPrice);
        if (compareNode) compareNode.textContent = comparePrice && comparePrice > displayPrice ? this.formatMoney(comparePrice) : '';
        if (addButton) {
          addButton.disabled = !variant.available;
          addButton.textContent = variant.available ? 'Add to cart' : 'Sold out';
        }
        if (variant.featured_image?.src) {
          const image = this.quickviewBody.querySelector('.tjs-cp-quickview__image');
          if (image) image.src = variant.featured_image.src;
        }
      }

      async addQuickviewVariant() {
        if (!this.quickviewVariant?.available) return;
        const quantity = Number(this.quickviewBody.querySelector('[data-qv-quantity]')?.value || 1);
        const addButton = this.quickviewBody.querySelector('[data-qv-add]');
        addButton.disabled = true;
        addButton.textContent = 'Adding…';
        try {
          await this.addVariant(this.quickviewVariant.id, quantity, this.quickviewProduct.title);
          this.closeQuickview();
        } catch (error) {
          addButton.disabled = false;
          addButton.textContent = error.message || 'Try again';
        }
      }

      async handleCardAdd(form, button, variantId, quantity) {
        if (!variantId || !button) return;
        const originalLabel = button.innerHTML;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        try {
          await this.addVariant(variantId, quantity, button.dataset.productTitle || 'Product');
        } catch (error) {
          console.error(error);
          form.submit();
          return;
        } finally {
          button.disabled = false;
          button.removeAttribute('aria-busy');
          button.innerHTML = originalLabel;
        }
      }

      async addVariant(variantId, quantity, productTitle) {
        const sections = ['cart-drawer', 'cart-icon-bubble', 'cart-notification-product', 'cart-notification-button'];
        const response = await fetch(`${this.rootUrl}cart/add.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ items: [{ id: Number(variantId), quantity: Math.max(1, Number(quantity) || 1) }], sections, sections_url: window.location.pathname })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.description || data.message || 'Unable to add this product');

        let cart = null;
        await new Promise((resolve) => setTimeout(resolve, 140));
        const cartResponse = await fetch(`${this.rootUrl}cart.js`, { headers: { 'Accept': 'application/json' }, cache: 'no-store' });
        if (cartResponse.ok) cart = await cartResponse.json();
        this.updateThemeCart(data, cart);
        this.showToast(productTitle);
        return data;
      }

      updateThemeCart(addResponse, cart) {
        const cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
          try { cartDrawer.renderContents(addResponse); } catch (error) { console.debug(error); }
        }

        if (cart?.item_count != null) {
          document.querySelectorAll('[data-cart-count], .js-cart-count, .t4s-count-box, .cart-count-bubble span[aria-hidden="true"]').forEach((node) => {
            node.textContent = cart.item_count;
            node.closest('.cart-count-bubble')?.removeAttribute('hidden');
          });
        }

        const detail = { cart, source: 'tjs-collection-page' };
        document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail }));
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail }));
        window.dispatchEvent(new CustomEvent('cart:refresh', { detail }));
      }

      showToast(title) {
        if (!this.toast) return;
        const titleNode = this.toast.querySelector('[data-toast-title]');
        if (titleNode) titleNode.textContent = title;
        this.toast.classList.add('is-visible');
        clearTimeout(this.toastTimer);
        this.toastTimer = setTimeout(() => this.toast.classList.remove('is-visible'), 3600);
      }

      rememberProductScroll() {
        try {
          sessionStorage.setItem(`tjs-collection-scroll:${window.location.pathname}${window.location.search}`, String(window.scrollY));
        } catch (error) { /* storage can be unavailable */ }
      }

      restoreProductScroll() {
        try {
          const key = `tjs-collection-scroll:${window.location.pathname}${window.location.search}`;
          const stored = sessionStorage.getItem(key);
          if (!stored) return;
          sessionStorage.removeItem(key);
          requestAnimationFrame(() => window.scrollTo({ top: Number(stored) || 0, behavior: 'auto' }));
        } catch (error) { /* storage can be unavailable */ }
      }

      formatMoney(cents) {
        const currency = window.Shopify?.currency?.active || '{{ cart.currency.iso_code | default: shop.currency }}';
        return new Intl.NumberFormat(document.documentElement.lang || 'en-IN', { style: 'currency', currency, maximumFractionDigits: 2 }).format((Number(cents) || 0) / 100);
      }

      escapeHtml(value) {
        return String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' }[character]));
      }
    }

    customElements.define('tjs-collection-page', TjsCollectionPage);
  })();
</script>

