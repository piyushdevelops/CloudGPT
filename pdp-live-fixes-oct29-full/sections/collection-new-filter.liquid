{% comment %}
  TJS Hierarchical Premium Collection Page
  - Parent collection: mapped visual subcategories only
  - Child collection: Product Type icon filters only
  - Relevant Shopify Search & Discovery filters with image/swatch presentations
  - AJAX hierarchy, filtering, sorting and load-more without a full page refresh
  - Collection-specific palette/banner blocks and editorial grid stories
  - Real rating metafields only; no fabricated customer proof
  - Resilient single-variant add-to-cart and multi-variant quick view
{% endcomment %}

{% liquid
  assign current_collection = collection
  assign collection_title = section.settings.heading
  if collection_title == blank
    assign collection_title = current_collection.title
  endif

  assign hero_kicker = section.settings.eyebrow
  if section.settings.use_collection_metafields and current_collection.metafields.custom.collection_kicker.value != blank
    assign hero_kicker = current_collection.metafields.custom.collection_kicker.value
  endif

  assign hero_description = section.settings.description
  if section.settings.use_collection_metafields and current_collection.metafields.custom.collection_intro.value != blank
    assign hero_description = current_collection.metafields.custom.collection_intro.value
  endif

  assign hero_image = section.settings.hero_image
  if section.settings.use_collection_metafields and current_collection.metafields.custom.collection_banner.value != blank
    assign hero_image = current_collection.metafields.custom.collection_banner.value
  elsif hero_image == blank and current_collection.image != blank
    assign hero_image = current_collection.image
  endif

  assign hero_image_mobile = section.settings.hero_image_mobile
  if section.settings.use_collection_metafields and current_collection.metafields.custom.collection_banner_mobile.value != blank
    assign hero_image_mobile = current_collection.metafields.custom.collection_banner_mobile.value
  endif
  if hero_image_mobile == blank
    assign hero_image_mobile = hero_image
  endif

  assign collection_page_bg = section.settings.background_color
  assign collection_surface = section.settings.surface_color
  assign collection_surface_2 = section.settings.surface_color_2
  assign collection_text = section.settings.text_color
  assign collection_muted = section.settings.muted_text_color
  assign collection_accent = section.settings.accent_color
  assign collection_accent_2 = section.settings.accent_color_2

  for block in section.blocks
    if block.type == 'collection_style' and block.settings.collection != blank and block.settings.collection.handle == current_collection.handle
      if block.settings.hero_image != blank
        assign hero_image = block.settings.hero_image
        assign hero_image_mobile = block.settings.hero_image
      endif
      if block.settings.hero_image_mobile != blank
        assign hero_image_mobile = block.settings.hero_image_mobile
      endif
      if block.settings.eyebrow != blank
        assign hero_kicker = block.settings.eyebrow
      endif
      if block.settings.description != blank
        assign hero_description = block.settings.description
      endif
      assign collection_page_bg = block.settings.page_background
      assign collection_surface = block.settings.surface_color
      assign collection_surface_2 = block.settings.surface_color_2
      assign collection_text = block.settings.text_color
      assign collection_muted = block.settings.muted_text_color
      assign collection_accent = block.settings.accent_color
      assign collection_accent_2 = block.settings.accent_color_2
    endif
  endfor

  if section.settings.use_collection_metafields and current_collection.metafields.custom.collection_accent.value != blank
    assign collection_accent = current_collection.metafields.custom.collection_accent.value
  endif
  if section.settings.use_collection_metafields and current_collection.metafields.custom.collection_surface.value != blank
    assign collection_surface = current_collection.metafields.custom.collection_surface.value
  endif

  assign active_filter_count = 0
  assign visible_filter_count = 0
  assign product_type_filter = nil
  for filter in current_collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
    if filter.param_name == 'filter.p.product_type'
      assign product_type_filter = filter
    endif
    unless filter.param_name == 'filter.p.product_type' and section.settings.hide_product_type_in_filters
      assign visible_filter_count = visible_filter_count | plus: 1
    endunless
  endfor

  assign subcategory_blocks_count = 0
  for block in section.blocks
    if block.type == 'subcategory' and block.settings.parent_collection != blank and block.settings.collection != blank
      if block.settings.parent_collection.handle == current_collection.handle
        assign subcategory_blocks_count = subcategory_blocks_count | plus: 1
      endif
    endif
  endfor

  assign show_subcategory_navigation = false
  if subcategory_blocks_count > 0
    assign show_subcategory_navigation = true
  endif

  assign show_type_navigation = false
  if show_subcategory_navigation == false and product_type_filter != nil and product_type_filter.values.size > 0 and section.settings.show_product_types
    assign show_type_navigation = true
  endif

  assign intent_link_count = 0
  assign trust_point_count = 0
  for block in section.blocks
    if block.type == 'intent_link'
      if block.settings.show_on_collection == blank or block.settings.show_on_collection.handle == current_collection.handle
        assign intent_link_count = intent_link_count | plus: 1
      endif
    elsif block.type == 'trust_point'
      if block.settings.show_on_collection == blank or block.settings.show_on_collection.handle == current_collection.handle
        assign trust_point_count = trust_point_count | plus: 1
      endif
    endif
  endfor

  assign sort_by = current_collection.sort_by | default: current_collection.default_sort_by
  assign event_multiplier = section.settings.event_price_percent | times: 0.01
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --tjs-cp-bg: {{ collection_page_bg }};
    --tjs-cp-surface: {{ collection_surface }};
    --tjs-cp-surface-2: {{ collection_surface_2 }};
    --tjs-cp-text: {{ collection_text }};
    --tjs-cp-muted: {{ collection_muted }};
    --tjs-cp-accent: {{ collection_accent }};
    --tjs-cp-accent-2: {{ collection_accent_2 }};
    --tjs-cp-border: {{ section.settings.border_color }};
    --tjs-cp-sale: {{ section.settings.sale_color }};
    --tjs-cp-radius: {{ section.settings.card_radius }}px;
    --tjs-cp-gap: {{ section.settings.card_gap }}px;
    --tjs-cp-max: {{ section.settings.max_width }}px;
    --tjs-cp-top: {{ section.settings.padding_top }}px;
    --tjs-cp-bottom: {{ section.settings.padding_bottom }}px;
    --tjs-cp-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --tjs-cp-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --tjs-cp-columns: {{ section.settings.desktop_columns }};
    --tjs-cp-image-ratio: {{ section.settings.product_image_ratio }};
    --tjs-cp-image-padding: {{ section.settings.product_image_padding }}px;
    --tjs-cp-image-padding-mobile: {{ section.settings.product_image_padding_mobile }}px;
    --tjs-cp-shadow-alpha: {{ section.settings.card_shadow | times: 0.01 }};
    --tjs-cp-heading-font: {% case section.settings.heading_font %}{% when 'brand' %}"Cormorant Garamond", var(--font-heading-family, Georgia, serif){% when 'heading' %}var(--font-heading-family, "Cormorant Garamond", Georgia, serif){% else %}var(--font-body-family, Arial, sans-serif){% endcase %};
    --tjs-cp-display-shadow: {{ section.settings.display_shadow_color }};
    --tjs-cp-toolbar-offset: {{ section.settings.sticky_toolbar_offset }}px;
  }

  #shopify-section-{{ section.id }} .tjs-cp,
  #shopify-section-{{ section.id }} .tjs-cp *,
  #shopify-section-{{ section.id }} .tjs-cp *::before,
  #shopify-section-{{ section.id }} .tjs-cp *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .tjs-cp {
    position: relative;
    display: block;
    padding: var(--tjs-cp-top) 0 var(--tjs-cp-bottom);
    background: var(--tjs-cp-bg);
    color: var(--tjs-cp-text);
    font-family: var(--font-body-family, Arial, sans-serif);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #shopify-section-{{ section.id }} .tjs-cp__inner {
    width: min(calc(100% - 40px), var(--tjs-cp-max));
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .tjs-cp__loading {
    position: fixed;
    inset: 0;
    z-index: 140;
    display: grid;
    place-items: center;
    pointer-events: none;
    opacity: 0;
    background: rgba(249, 247, 244, .5);
    backdrop-filter: blur(2px);
    transition: opacity .18s ease;
  }

  #shopify-section-{{ section.id }} .tjs-cp.is-loading .tjs-cp__loading {
    pointer-events: auto;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .tjs-cp__spinner {
    width: 36px;
    height: 36px;
    border: 2px solid rgba(28, 25, 22, .12);
    border-top-color: var(--tjs-cp-accent);
    border-radius: 50%;
    animation: tjs-cp-spin-{{ section.id }} .72s linear infinite;
  }

  @keyframes tjs-cp-spin-{{ section.id }} { to { transform: rotate(360deg); } }

  /* Collection hero */
  #shopify-section-{{ section.id }} .tjs-cp-hero {
    position: relative;
    isolation: isolate;
    min-height: {{ section.settings.hero_height }}px;
    display: grid;
    grid-template-columns: minmax(0, {{ section.settings.hero_text_width }}%) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--tjs-cp-border);
    border-radius: {{ section.settings.hero_radius }}px;
    background: var(--tjs-cp-surface);
    box-shadow: 0 20px 52px rgba(26, 22, 19, .07);
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 8% 0%, rgba(255,255,255,.8), transparent 34%),
      linear-gradient(115deg, transparent 45%, rgba(255,255,255,.18));
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(42px, 5vw, 80px);
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__content::before {
    content: '';
    position: absolute;
    left: clamp(24px, 2.6vw, 42px);
    top: 18%;
    bottom: 18%;
    width: 2px;
    border-radius: 99px;
    background: var(--tjs-cp-accent);
    opacity: .72;
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__eyebrow {
    margin: 0 0 14px;
    color: var(--tjs-cp-accent);
    font-size: 10px;
    font-weight: 750;
    line-height: 1;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__heading {
    max-width: 9.4ch;
    margin: 0;
    color: var(--tjs-cp-text);
    font-family: var(--tjs-cp-heading-font);
    font-size: clamp(48px, 5.4vw, {{ section.settings.heading_size }}px);
    font-weight: {{ section.settings.heading_weight }};
    line-height: .9;
    letter-spacing: -.052em;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__description {
    max-width: 43ch;
    margin: 20px 0 0;
    color: var(--tjs-cp-muted);
    font-size: 14px;
    line-height: 1.62;
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__description > * { margin: 0; }

  #shopify-section-{{ section.id }} .tjs-cp-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__meta-item {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0 11px;
    border: 1px solid rgba(28,25,22,.09);
    border-radius: 999px;
    background: rgba(255,255,255,.52);
    color: var(--tjs-cp-text);
    font-size: 10px;
    font-weight: 650;
    line-height: 1;
    backdrop-filter: blur(8px);
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__meta-item svg {
    width: 15px;
    height: 15px;
    color: var(--tjs-cp-accent);
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__media {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--tjs-cp-surface-2);
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, var(--tjs-cp-surface) 0%, rgba(255,255,255,0) 18%);
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__media picture,
  #shopify-section-{{ section.id }} .tjs-cp-hero__image,
  #shopify-section-{{ section.id }} .tjs-cp-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .tjs-cp-hero__image { object-fit: cover; object-position: center; }

  /* Hierarchical navigation */
  #shopify-section-{{ section.id }} .tjs-cp-subcats,
  #shopify-section-{{ section.id }} .tjs-cp-types {
    margin-top: 30px;
  }

  #shopify-section-{{ section.id }} .tjs-cp-section-label {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .tjs-cp-section-label > div { min-width: 0; }

  #shopify-section-{{ section.id }} .tjs-cp-section-label p {
    margin: 0 0 6px;
    color: var(--tjs-cp-accent);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tjs-cp-section-label h2 {
    margin: 0;
    font-family: var(--tjs-cp-heading-font);
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.035em;
  }

  #shopify-section-{{ section.id }} .tjs-cp-section-label > span {
    color: var(--tjs-cp-muted);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcats__rail,
  #shopify-section-{{ section.id }} .tjs-cp-types__rail {
    display: grid;
    grid-auto-flow: column;
    gap: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 3px 2px 12px;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcats__rail::-webkit-scrollbar,
  #shopify-section-{{ section.id }} .tjs-cp-types__rail::-webkit-scrollbar { display: none; }

  #shopify-section-{{ section.id }} .tjs-cp-subcats__rail { grid-auto-columns: minmax(155px, 178px); }

  #shopify-section-{{ section.id }} .tjs-cp-subcat {
    min-width: 0;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    overflow: hidden;
    border: 1px solid var(--tjs-cp-border);
    border-radius: 15px;
    background: var(--tjs-subcat-surface, var(--tjs-cp-surface));
    color: var(--tjs-cp-text);
    text-decoration: none;
    box-shadow: 0 10px 26px rgba(26,22,19,.05);
    transition: transform .24s ease, box-shadow .24s ease, border-color .24s ease;
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__tile {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background:
      radial-gradient(circle at 75% 18%, rgba(255,255,255,.82), transparent 38%),
      var(--tjs-subcat-accent, var(--tjs-cp-surface-2));
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__tile::after {
    content: '';
    position: absolute;
    inset: auto 18% 8% 18%;
    height: 12%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(18,15,13,.13), transparent 70%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__icon,
  #shopify-section-{{ section.id }} .tjs-cp-subcat__fallback {
    position: relative;
    z-index: 1;
    width: 82%;
    height: 82%;
    object-fit: contain;
    filter: drop-shadow(0 12px 16px rgba(24,20,18,.11));
    transition: transform .28s ease;
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__fallback {
    width: 54px;
    height: 54px;
    color: var(--tjs-cp-text);
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__fallback svg { width: 100%; height: 100%; }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__badge {
    position: absolute;
    z-index: 2;
    top: 9px;
    left: 9px;
    min-height: 23px;
    display: inline-flex;
    align-items: center;
    padding: 0 8px;
    border-radius: 999px;
    background: rgba(255,255,255,.9);
    color: #1d1916;
    font-size: 8px;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
    box-shadow: 0 5px 14px rgba(20,18,16,.08);
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__body {
    position: relative;
    min-height: 74px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 12px 38px 12px 13px;
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__label {
    display: -webkit-box;
    overflow: hidden;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -.015em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__meta {
    margin-top: 5px;
    color: var(--tjs-cp-muted);
    font-size: 9px;
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__arrow {
    position: absolute;
    right: 11px;
    bottom: 12px;
    width: 27px;
    height: 27px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--tjs-cp-text);
    color: var(--tjs-cp-surface);
    transition: transform .22s ease, background-color .22s ease;
  }

  #shopify-section-{{ section.id }} .tjs-cp-subcat__arrow svg { width: 13px; height: 13px; }

  #shopify-section-{{ section.id }} .tjs-cp-types__rail { grid-auto-columns: minmax(168px, 205px); }

  #shopify-section-{{ section.id }} .tjs-cp-type {
    position: relative;
    min-height: 70px;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    scroll-snap-align: start;
    padding: 9px 11px 9px 9px;
    border: 1px solid var(--tjs-cp-border);
    border-radius: 14px;
    background: var(--tjs-cp-surface);
    color: var(--tjs-cp-text);
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(26,22,19,.045);
    transition: transform .22s ease, border-color .22s ease, background-color .22s ease, box-shadow .22s ease;
  }

  #shopify-section-{{ section.id }} .tjs-cp-type__icon-holder {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(28,25,22,.07);
    border-radius: 12px;
    background: var(--tjs-cp-surface-2);
    color: var(--tjs-cp-accent);
  }

  #shopify-section-{{ section.id }} .tjs-cp-type__icon {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} span.tjs-cp-type__icon { display: grid; place-items: center; }
  #shopify-section-{{ section.id }} .tjs-cp-type__icon svg { width: 100%; height: 100%; }

  #shopify-section-{{ section.id }} .tjs-cp-type__copy { min-width: 0; display: grid; gap: 5px; }

  #shopify-section-{{ section.id }} .tjs-cp-type__name {
    overflow: hidden;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .tjs-cp-type__count {
    color: var(--tjs-cp-muted);
    font-size: 9px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .tjs-cp-type__check {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border: 1px solid var(--tjs-cp-border);
    border-radius: 50%;
    color: transparent;
    font-size: 10px;
  }

  #shopify-section-{{ section.id }} .tjs-cp-type.is-active {
    border-color: var(--tjs-cp-accent);
    background: var(--tjs-cp-surface-2);
    box-shadow: 0 10px 26px rgba(26,22,19,.07);
  }

  #shopify-section-{{ section.id }} .tjs-cp-type.is-active .tjs-cp-type__check {
    border-color: var(--tjs-cp-accent);
    background: var(--tjs-cp-accent);
    color: #fff;
  }

  @media (hover:hover) {
    #shopify-section-{{ section.id }} .tjs-cp-subcat:hover {
      transform: translateY(-3px);
      border-color: var(--tjs-subcat-accent, var(--tjs-cp-accent));
      box-shadow: 0 16px 34px rgba(26,22,19,.09);
    }
    #shopify-section-{{ section.id }} .tjs-cp-subcat:hover .tjs-cp-subcat__icon { transform: scale(1.035); }
    #shopify-section-{{ section.id }} .tjs-cp-subcat:hover .tjs-cp-subcat__arrow { transform: translateX(2px); background: var(--tjs-cp-accent); }
    #shopify-section-{{ section.id }} .tjs-cp-type:hover { transform: translateY(-2px); border-color: var(--tjs-cp-accent-2); box-shadow: 0 12px 28px rgba(26,22,19,.075); }
  }

  /* Toolbar and active filters */
  #shopify-section-{{ section.id }} .tjs-cp-toolbar {
    min-height: 56px;
    display: grid;
    grid-template-columns: auto minmax(0,1fr) auto;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
    padding: 8px 10px;
    border: 1px solid var(--tjs-cp-border);
    border-radius: 14px;
    background: rgba(255,255,255,.52);
    backdrop-filter: blur(12px);
  }

  #shopify-section-{{ section.id }} .tjs-cp-toolbar__button {
    min-height: 38px;
    display: none;
    align-items: center;
    gap: 8px;
    padding: 0 13px;
    border: 1px solid var(--tjs-cp-border);
    border-radius: 10px;
    background: var(--tjs-cp-surface);
    color: var(--tjs-cp-text);
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .tjs-cp-toolbar__button svg { width: 16px; height: 16px; }

