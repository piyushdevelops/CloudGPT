<script>
  (() => {
    if (customElements.get('tjs-category-slider')) return;

    class TjsCategorySlider extends HTMLElement {
      connectedCallback() {
        this.scroller = this.querySelector('[data-scroller]');
        this.previousButton = this.querySelector('[data-previous]');
        this.nextButton = this.querySelector('[data-next]');
        this.progress = this.querySelector('[data-progress]');
        this.currentCounter = this.querySelector('[data-current]');
        this.section = this.closest('.tjs-category-hero');

        if (!this.scroller) return;

        this.dragging = false;
        this.dragMoved = false;
        this.suppressClick = false;
        this.raf = null;
        if ('ResizeObserver' in window) {
          this.resizeObserver = new ResizeObserver(() => this.update());
          this.resizeObserver.observe(this.scroller);
        } else {
          this.onWindowResize = () => this.update();
          window.addEventListener('resize', this.onWindowResize, { passive: true });
        }

        this.onScroll = () => {
          if (this.raf) cancelAnimationFrame(this.raf);
          this.raf = requestAnimationFrame(() => this.update());
        };

        this.onPrevious = () => this.move(-1);
        this.onNext = () => this.move(1);
        this.onKeydown = (event) => {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            this.move(-1);
          }

          if (event.key === 'ArrowRight') {
            event.preventDefault();
            this.move(1);
          }
        };

        this.onPointerDown = (event) => {
          if (event.pointerType !== 'mouse' || event.button !== 0) return;

          this.dragging = true;
          this.dragMoved = false;
          this.suppressClick = false;
          this.startX = event.clientX;
          this.startY = event.clientY;
          this.startScrollLeft = this.scroller.scrollLeft;
          this.stopAutoplay();
        };

        this.onPointerMove = (event) => {
          if (!this.dragging) return;

          const distanceX = event.clientX - this.startX;
          const distanceY = event.clientY - this.startY;
          const isIntentionalHorizontalDrag = Math.abs(distanceX) > 10 && Math.abs(distanceX) > Math.abs(distanceY);

          if (!this.dragMoved && isIntentionalHorizontalDrag) {
            this.dragMoved = true;
            this.scroller.classList.add('is-dragging');
            this.scroller.setPointerCapture?.(event.pointerId);
          }

          if (this.dragMoved) {
            event.preventDefault();
            this.scroller.scrollLeft = this.startScrollLeft - distanceX;
          }
        };

        this.onPointerUp = (event) => {
          if (!this.dragging) return;

          this.dragging = false;
          this.scroller.classList.remove('is-dragging');

          if (this.scroller.hasPointerCapture?.(event.pointerId)) {
            this.scroller.releasePointerCapture(event.pointerId);
          }

          /* Suppress only the synthetic click that follows a real drag.
             Normal clicks remain untouched and navigate to the collection. */
          this.suppressClick = this.dragMoved;
          this.dragMoved = false;

          window.setTimeout(() => {
            this.suppressClick = false;
          }, 0);

          this.startAutoplay();
        };

        this.onClickCapture = (event) => {
          if (!this.suppressClick) return;
          event.preventDefault();
          event.stopPropagation();
          this.suppressClick = false;
        };

        this.scroller.addEventListener('scroll', this.onScroll, { passive: true });
        this.scroller.addEventListener('keydown', this.onKeydown);
        this.scroller.addEventListener('pointerdown', this.onPointerDown);
        this.scroller.addEventListener('pointermove', this.onPointerMove);
        this.scroller.addEventListener('pointerup', this.onPointerUp);
        this.scroller.addEventListener('pointercancel', this.onPointerUp);
        this.scroller.addEventListener('click', this.onClickCapture, true);

        this.previousButton?.addEventListener('click', this.onPrevious);
        this.nextButton?.addEventListener('click', this.onNext);

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => this.startAutoplay());
        this.addEventListener('focusin', () => this.stopAutoplay());
        this.addEventListener('focusout', () => this.startAutoplay());

        this.onBlockSelect = (event) => {
          const selectedCard = this.querySelector(`[data-block-id="${event.detail.blockId}"]`);
          if (!selectedCard) return;

          this.stopAutoplay();
          selectedCard.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center'
          });
        };

        if (window.Shopify?.designMode) {
          document.addEventListener('shopify:block:select', this.onBlockSelect);
        }

        this.update();
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (!this.scroller) return;

        this.resizeObserver?.disconnect();
        if (this.onWindowResize) {
          window.removeEventListener('resize', this.onWindowResize);
        }
        this.stopAutoplay();

        this.scroller.removeEventListener('scroll', this.onScroll);
        this.scroller.removeEventListener('keydown', this.onKeydown);
        this.scroller.removeEventListener('pointerdown', this.onPointerDown);
        this.scroller.removeEventListener('pointermove', this.onPointerMove);
        this.scroller.removeEventListener('pointerup', this.onPointerUp);
        this.scroller.removeEventListener('pointercancel', this.onPointerUp);
        this.scroller.removeEventListener('click', this.onClickCapture, true);

        this.previousButton?.removeEventListener('click', this.onPrevious);
        this.nextButton?.removeEventListener('click', this.onNext);

        if (window.Shopify?.designMode) {
          document.removeEventListener('shopify:block:select', this.onBlockSelect);
        }
      }

      move(direction) {
        const firstCard = this.scroller.querySelector('[data-slide]');
        if (!firstCard) return;

        const computedStyle = window.getComputedStyle(this.scroller);
        const gap = parseFloat(computedStyle.columnGap || computedStyle.gap || 0);
        const distance = firstCard.getBoundingClientRect().width + gap;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        this.scroller.scrollBy({
          left: direction * distance,
          behavior: reducedMotion ? 'auto' : 'smooth'
        });
      }

      update() {
        const maxScroll = Math.max(0, this.scroller.scrollWidth - this.scroller.clientWidth);
        const currentScroll = Math.min(maxScroll, Math.max(0, this.scroller.scrollLeft));
        const hasOverflow = maxScroll > 2;
        const progressRatio = hasOverflow
          ? Math.min(1, (currentScroll + this.scroller.clientWidth) / this.scroller.scrollWidth)
          : 1;

        this.section?.setAttribute('data-overflow', String(hasOverflow));

        if (this.previousButton) {
          this.previousButton.disabled = !hasOverflow || currentScroll <= 2;
        }

        if (this.nextButton) {
          this.nextButton.disabled = !hasOverflow || currentScroll >= maxScroll - 2;
        }

        if (this.progress) {
          this.progress.style.transform = `scaleX(${progressRatio})`;
        }

        if (this.currentCounter) {
          const firstCard = this.scroller.querySelector('[data-slide]');
          if (firstCard) {
            const computedStyle = window.getComputedStyle(this.scroller);
            const gap = parseFloat(computedStyle.columnGap || computedStyle.gap || 0);
            const step = firstCard.getBoundingClientRect().width + gap;
            const totalSlides = this.scroller.querySelectorAll('[data-slide]').length;
            const activeIndex = step > 0
              ? Math.min(totalSlides, Math.max(1, Math.round(currentScroll / step) + 1))
              : 1;

            this.currentCounter.textContent = String(activeIndex).padStart(2, '0');
          }
        }
      }

      startAutoplay() {
        if (this.dataset.autoplay !== 'true') return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        this.stopAutoplay();

        const speed = Math.max(2500, Number(this.dataset.autoplaySpeed) || 5000);
        this.autoplayTimer = window.setInterval(() => {
          const maxScroll = Math.max(0, this.scroller.scrollWidth - this.scroller.clientWidth);

          if (this.scroller.scrollLeft >= maxScroll - 4) {
            this.scroller.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            this.move(1);
          }
        }, speed);
      }

      stopAutoplay() {
        if (!this.autoplayTimer) return;
        window.clearInterval(this.autoplayTimer);
        this.autoplayTimer = null;
      }
    }

    customElements.define('tjs-category-slider', TjsCategorySlider);
  })();
</script>

