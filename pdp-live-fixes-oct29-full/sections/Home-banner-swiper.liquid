{% comment %}
  TJS Editorial Category Hero — clean rebuild
  - Premium editorial left-side content
  - Compact Google review and customer-care proof
  - Native, touch-friendly collection slider
  - Up to four category cards
{% endcomment %}

{% liquid
  assign desktop_card_width = '64%'
  case section.settings.cards_desktop
    when '1.25'
      assign desktop_card_width = '78%'
    when '1.5'
      assign desktop_card_width = '64%'
    when '1.75'
      assign desktop_card_width = '54%'
    when '2'
      assign desktop_card_width = '47%'
  endcase

  assign mobile_card_width = '38%'
  case section.settings.cards_mobile
    when '1.5'
      assign mobile_card_width = '64%'
    when '2'
      assign mobile_card_width = '47%'
    when '2.25'
      assign mobile_card_width = '42%'
    when '2.5'
      assign mobile_card_width = '38%'
  endcase

  assign category_count = 0
  assign has_review_app = false

  for block in section.blocks
    if block.type == 'category'
      assign category_count = category_count | plus: 1
    elsif block.type == '@app'
      assign has_review_app = true
    endif
  endfor

  assign slider_count = category_count
  if slider_count == 0
    assign slider_count = 4
  endif

  assign accent_cycle_duration = section.settings.accent_switch_delay | times: 2
%}

<section
  id="TjsCategoryHero-{{ section.id }}"
  class="tjs-category-hero tjs-category-hero--heading-{{ section.settings.heading_font_style }}{% if section.settings.show_top_pattern %} tjs-category-hero--pattern{% endif %}{% if section.settings.enable_accent_switch %} tjs-category-hero--accent-switch{% endif %}"
  style="
    --tjs-bg: {{ section.settings.background_color }};
    --tjs-text: {{ section.settings.text_color }};
    --tjs-muted: {{ section.settings.muted_text_color }};
    --tjs-accent: {{ section.settings.accent_color }};
    --tjs-accent-alt: {{ section.settings.accent_color_2 }};
    --tjs-accent-cycle: {{ accent_cycle_duration }}s;
    --tjs-button-bg: {{ section.settings.button_background }};
    --tjs-button-text: {{ section.settings.button_text_color }};
    --tjs-card-bg: {{ section.settings.card_background }};
    --tjs-card-text: {{ section.settings.card_text_color }};
    --tjs-card-muted: {{ section.settings.card_muted_color }};
    --tjs-border: {{ section.settings.border_color }};
    --tjs-content-width: {{ section.settings.content_width }}px;
    --tjs-left-width: {{ section.settings.left_column_width }}%;
    --tjs-section-min-height: {{ section.settings.section_min_height }}px;
    --tjs-radius: {{ section.settings.card_radius }}px;
    --tjs-gap: {{ section.settings.card_gap }}px;
    --tjs-desktop-card-width: {{ desktop_card_width }};
    --tjs-mobile-card-width: {{ mobile_card_width }};
    --tjs-heading-size: {{ section.settings.heading_size }}px;
    --tjs-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --tjs-padding-top: {{ section.settings.padding_top }}px;
    --tjs-padding-bottom: {{ section.settings.padding_bottom }}px;
    --tjs-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --tjs-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="tjs-category-hero__inner">
    <div class="tjs-category-hero__copy">
      <div class="tjs-category-hero__copy-main">
        {% if section.settings.eyebrow != blank %}
          <div class="tjs-category-hero__eyebrow">
            {% if section.settings.show_eyebrow_icon %}
              <span class="tjs-category-hero__eyebrow-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <path d="M10 2.25 16.5 6v8L10 17.75 3.5 14V6L10 2.25Z" fill="currentColor" opacity=".16"/>
                  <path d="m6.25 10 2.25 2.25 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {% endif %}
            <span>{{ section.settings.eyebrow | escape }}</span>
          </div>
        {% endif %}

        {% if section.settings.heading_before != blank or section.settings.heading_accent != blank or section.settings.heading_after != blank %}
          <{{ section.settings.heading_tag }} class="tjs-category-hero__heading">
            {% if section.settings.heading_before != blank %}
              <span>{{ section.settings.heading_before | escape }}</span>
            {% endif %}
            {% if section.settings.heading_accent != blank %}
              <span class="tjs-category-hero__heading-accent">{{ section.settings.heading_accent | escape }}</span>
            {% endif %}
            {% if section.settings.heading_after != blank %}
              <span>{{ section.settings.heading_after | escape }}</span>
            {% endif %}
          </{{ section.settings.heading_tag }}>
        {% endif %}

        {% if section.settings.body != blank %}
          <div class="tjs-category-hero__body rte">
            {{ section.settings.body }}
          </div>
        {% endif %}

        {% if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank %}
          <div class="tjs-category-hero__actions">
            {% if section.settings.primary_button_label != blank %}
              <a
                class="tjs-category-hero__button tjs-category-hero__button--primary"
                {% if section.settings.primary_button_link != blank %}
                  href="{{ section.settings.primary_button_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                <span>{{ section.settings.primary_button_label | escape }}</span>
                <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path d="M4 9h9M9.75 5.75 13 9l-3.25 3.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.secondary_button_label != blank %}
              <a
                class="tjs-category-hero__button tjs-category-hero__button--secondary"
                {% if section.settings.secondary_button_link != blank %}
                  href="{{ section.settings.secondary_button_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.secondary_button_label | escape }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if has_review_app or section.settings.show_reviews or section.settings.show_cx_badge %}
        <div class="tjs-category-hero__trust">
          {% if has_review_app %}
            <div class="tjs-category-hero__review-app" aria-label="{{ section.settings.review_region_label | escape }}">
              {% for block in section.blocks %}
                {% if block.type == '@app' %}
                  {% render block %}
                {% endif %}
              {% endfor %}
            </div>
          {% elsif section.settings.show_reviews %}
            {% capture review_summary %}
              <span class="tjs-category-hero__google-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M21.6 12.23c0-.71-.06-1.39-.18-2.04H12v3.86h5.38a4.6 4.6 0 0 1-1.99 3.02v2.5h3.22c1.88-1.73 2.99-4.29 2.99-7.34Z" fill="#4285F4"/>
                  <path d="M12 22c2.7 0 4.96-.9 6.61-2.43l-3.22-2.5c-.9.6-2.04.96-3.39.96-2.6 0-4.81-1.76-5.6-4.13H3.08v2.58A9.99 9.99 0 0 0 12 22Z" fill="#34A853"/>
                  <path d="M6.4 13.9A6.02 6.02 0 0 1 6.08 12c0-.66.11-1.3.32-1.9V7.52H3.08A10 10 0 0 0 2 12c0 1.61.39 3.14 1.08 4.48L6.4 13.9Z" fill="#FBBC05"/>
                  <path d="M12 5.97c1.47 0 2.78.51 3.82 1.49l2.86-2.86C16.95 2.98 14.7 2 12 2a9.99 9.99 0 0 0-8.92 5.52L6.4 10.1C7.19 7.73 9.4 5.97 12 5.97Z" fill="#EA4335"/>
                </svg>
              </span>

              <span class="tjs-category-hero__review-content">
                <span class="tjs-category-hero__review-source-label">{{ section.settings.review_link_text | escape }}</span>
                <span class="tjs-category-hero__rating-line">
                  <strong>{{ section.settings.rating_value | escape }}</strong>
                  <span class="tjs-category-hero__stars" aria-hidden="true">
                    {% for i in (1..5) %}
                      <svg viewBox="0 0 18 18">
                        <path d="m9 1.8 2.15 4.36 4.81.7-3.48 3.39.82 4.79L9 12.78l-4.3 2.26.82-4.79L2.04 6.86l4.81-.7L9 1.8Z" fill="currentColor"/>
                      </svg>
                    {% endfor %}
                  </span>
                  <span class="visually-hidden">{{ section.settings.rating_value | escape }} out of 5</span>
                </span>
                <span class="tjs-category-hero__review-meta">
                  {% if section.settings.review_heading != blank %}<strong>{{ section.settings.review_heading | escape }}</strong>{% endif %}
                  {% if section.settings.review_label != blank or section.settings.review_count != blank %}
                    <span>{% if section.settings.review_label != blank %}{{ section.settings.review_label | escape }}{% endif %}{% if section.settings.review_label != blank and section.settings.review_count != blank %} {% endif %}{% if section.settings.review_count != blank %}{{ section.settings.review_count | escape }}{% endif %}</span>
                  {% endif %}
                </span>
              </span>

              <span class="tjs-category-hero__review-tail" aria-hidden="true">
                <span class="tjs-category-hero__avatars">
                  {% assign uploaded_avatar_count = 0 %}

                  {% if section.settings.avatar_1 != blank %}
                    {% assign uploaded_avatar_count = uploaded_avatar_count | plus: 1 %}
                    {{ section.settings.avatar_1 | image_url: width: 96 | image_tag: widths: '48, 72, 96', sizes: '31px', loading: 'lazy', class: 'tjs-category-hero__avatar', alt: '' }}
                  {% endif %}
                  {% if section.settings.avatar_2 != blank %}
                    {% assign uploaded_avatar_count = uploaded_avatar_count | plus: 1 %}
                    {{ section.settings.avatar_2 | image_url: width: 96 | image_tag: widths: '48, 72, 96', sizes: '31px', loading: 'lazy', class: 'tjs-category-hero__avatar', alt: '' }}
                  {% endif %}
                  {% if section.settings.avatar_3 != blank %}
                    {% assign uploaded_avatar_count = uploaded_avatar_count | plus: 1 %}
                    {{ section.settings.avatar_3 | image_url: width: 96 | image_tag: widths: '48, 72, 96', sizes: '31px', loading: 'lazy', class: 'tjs-category-hero__avatar', alt: '' }}
                  {% endif %}
                  {% if section.settings.avatar_4 != blank %}
                    {% assign uploaded_avatar_count = uploaded_avatar_count | plus: 1 %}
                    {{ section.settings.avatar_4 | image_url: width: 96 | image_tag: widths: '48, 72, 96', sizes: '31px', loading: 'lazy', class: 'tjs-category-hero__avatar', alt: '' }}
                  {% endif %}
                  {% if section.settings.avatar_5 != blank %}
                    {% assign uploaded_avatar_count = uploaded_avatar_count | plus: 1 %}
                    {{ section.settings.avatar_5 | image_url: width: 96 | image_tag: widths: '48, 72, 96', sizes: '31px', loading: 'lazy', class: 'tjs-category-hero__avatar', alt: '' }}
                  {% endif %}

                  {% if uploaded_avatar_count == 0 and section.settings.show_avatar_placeholders %}
                    {% for i in (1..5) %}
                      <span class="tjs-category-hero__avatar tjs-category-hero__avatar--placeholder">
                        <svg viewBox="0 0 32 32" fill="none">
                          <circle cx="16" cy="12" r="5" fill="currentColor" opacity=".35"/>
                          <path d="M6.5 27c.7-6 4-9 9.5-9s8.8 3 9.5 9" fill="currentColor" opacity=".2"/>
                        </svg>
                      </span>
                    {% endfor %}
                  {% endif %}
                </span>

                <span class="tjs-category-hero__review-open">
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="M5 10h10M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
            {% endcapture %}

            <div class="tjs-category-hero__reviews">
              {% if section.settings.google_reviews_url != blank %}
                <a
                  class="tjs-category-hero__review-link"
                  href="{{ section.settings.google_reviews_url }}"
                  {% if section.settings.open_reviews_new_tab %}target="_blank" rel="noopener"{% endif %}
                  aria-label="{{ section.settings.google_reviews_aria_label | escape }}"
                >
                  {{ review_summary }}
                </a>
              {% else %}
                <div class="tjs-category-hero__review-link">
                  {{ review_summary }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.show_cx_badge %}
            {% capture cx_content %}
              <span class="tjs-category-hero__cx-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M5 13v-1a7 7 0 0 1 14 0v1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  <path d="M5 12.5H4.5A2.5 2.5 0 0 0 2 15v1a2.5 2.5 0 0 0 2.5 2.5H6V12.5H5Zm14 0h.5A2.5 2.5 0 0 1 22 15v1a2.5 2.5 0 0 1-2.5 2.5H18V12.5h1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                  <path d="M18 18.5c-.65 1.2-1.76 1.8-3.35 1.8H13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="tjs-category-hero__cx-copy">
                <strong>{{ section.settings.cx_title | escape }}</strong>
                <span>{{ section.settings.cx_text | escape }}</span>
              </span>
              <span class="tjs-category-hero__cx-arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <path d="M5 10h10M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {% endcapture %}

            {% if section.settings.cx_link != blank %}
              <a class="tjs-category-hero__cx-badge" href="{{ section.settings.cx_link }}">
                {{ cx_content }}
              </a>
            {% else %}
              <div class="tjs-category-hero__cx-badge">
                {{ cx_content }}
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endif %}
    </div>

    <tjs-category-slider
      class="tjs-category-hero__slider"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
      data-section-id="{{ section.id }}"
    >
      <div
        class="tjs-category-hero__track"
        data-scroller
        tabindex="0"
        role="region"
        aria-label="{{ section.settings.slider_aria_label | escape }}"
      >
        {% if category_count > 0 %}
          {% assign category_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'category' %}
              {% assign category_index = category_index | plus: 1 %}
              {% assign selected_collection = block.settings.collection %}
              {% assign card_image = block.settings.image %}

              {% if card_image == blank and selected_collection != blank %}
                {% assign card_image = selected_collection.featured_image %}
              {% endif %}

              {% if card_image == blank and selected_collection != blank and selected_collection.products.first != blank %}
                {% assign card_image = selected_collection.products.first.featured_image %}
              {% endif %}

              {% assign card_title = block.settings.title %}
              {% if card_title == blank and selected_collection != blank %}
                {% assign card_title = selected_collection.title %}
              {% endif %}
              {% if card_title == blank %}
                {% assign card_title = 'Collection title' %}
              {% endif %}

              {% assign card_link = block.settings.custom_link %}
              {% if card_link == blank and selected_collection != blank %}
                {% assign card_link = selected_collection.url %}
              {% endif %}

              {% assign image_loading = 'lazy' %}
              {% assign image_fetchpriority = 'low' %}
              {% if category_index == 1 %}
                {% assign image_loading = 'eager' %}
                {% assign image_fetchpriority = 'high' %}
              {% endif %}

              {% assign card_alt = block.settings.image_alt %}
              {% if card_alt == blank %}
                {% assign card_alt = card_title %}
              {% endif %}

              <article
                class="tjs-category-card"
                data-slide
                data-block-id="{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <a
                  class="tjs-category-card__link"
                  {% if card_link != blank %}
                    href="{{ card_link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  aria-label="{{ card_title | escape }}"
                >
                  <div class="tjs-category-card__media">
                    {% if block.settings.badge != blank %}
                      <span class="tjs-category-card__badge">{{ block.settings.badge | escape }}</span>
                    {% endif %}

                    {% if card_image != blank %}
                      {{ card_image
                        | image_url: width: 1400
                        | image_tag:
                          widths: '240, 360, 480, 640, 800, 1000, 1200, 1400',
                          sizes: '(min-width: 990px) 38vw, 42vw',
                          loading: image_loading,
                          fetchpriority: image_fetchpriority,
                          class: 'tjs-category-card__image',
                          alt: card_alt
                      }}
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'tjs-category-card__image tjs-category-card__placeholder' }}
                    {% endif %}
                  </div>

                  <div class="tjs-category-card__footer">
                    <div class="tjs-category-card__copy">
                      <div class="tjs-category-card__kicker-row">
                        <span class="tjs-category-card__kicker">
                          {% if block.settings.kicker != blank %}
                            {{ block.settings.kicker | escape }}
                          {% else %}
                            {{ section.settings.card_kicker_label | escape }}
                          {% endif %}
                        </span>
                        <span class="tjs-category-card__index">0{{ category_index }}</span>
                      </div>

                      <h3 class="tjs-category-card__title">{{ card_title | escape }}</h3>

                      {% if block.settings.subtitle != blank %}
                        <p class="tjs-category-card__subtitle">{{ block.settings.subtitle | escape }}</p>
                      {% elsif selected_collection != blank and section.settings.show_product_count %}
                        <p class="tjs-category-card__subtitle">
                          {{ selected_collection.all_products_count }}
                          {{ section.settings.product_count_label | escape }}
                        </p>
                      {% endif %}
                    </div>

                    <span class="tjs-category-card__arrow" aria-hidden="true">
                      <span>{{ section.settings.card_cta_label | escape }}</span>
                      <svg viewBox="0 0 20 20" fill="none">
                        <path d="M5 10h10M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </a>
              </article>
            {% endif %}
          {% endfor %}
        {% else %}
          {% for i in (1..4) %}
            <article class="tjs-category-card" data-slide>
              <div class="tjs-category-card__link">
                <div class="tjs-category-card__media">
                  {{ 'collection-' | append: i | placeholder_svg_tag: 'tjs-category-card__image tjs-category-card__placeholder' }}
                </div>
                <div class="tjs-category-card__footer">
                  <div class="tjs-category-card__copy">
                    <div class="tjs-category-card__kicker-row">
                      <span class="tjs-category-card__kicker">{{ section.settings.card_kicker_label | escape }}</span>
                      <span class="tjs-category-card__index">0{{ i }}</span>
                    </div>
                    <h3 class="tjs-category-card__title">Collection {{ i }}</h3>
                    <p class="tjs-category-card__subtitle">Select a collection</p>
                  </div>
                  <span class="tjs-category-card__arrow" aria-hidden="true">
                    <span>{{ section.settings.card_cta_label | escape }}</span>
                    <svg viewBox="0 0 20 20" fill="none">
                      <path d="M5 10h10M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>

      {% if section.settings.show_slider_controls %}
        <div class="tjs-category-hero__slider-controls" data-controls>
          <div class="tjs-category-hero__arrow-buttons">
            <button
              type="button"
              class="tjs-category-hero__slider-button tjs-category-hero__slider-button--previous"
              data-previous
              aria-label="{{ section.settings.previous_label | escape }}"
            >
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M15 10H5M9 6l-4 4 4 4" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <button
              type="button"
              class="tjs-category-hero__slider-button tjs-category-hero__slider-button--next"
              data-next
              aria-label="{{ section.settings.next_label | escape }}"
            >
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 10h10M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

          <div class="tjs-category-hero__counter" aria-hidden="true">
            <strong data-current>01</strong>
            <span>/</span>
            <span>{% if slider_count < 10 %}0{% endif %}{{ slider_count }}</span>
          </div>

          <div class="tjs-category-hero__progress" aria-hidden="true">
            <span data-progress></span>
          </div>

          {% if section.settings.swipe_hint != blank %}
            <span class="tjs-category-hero__swipe-hint">{{ section.settings.swipe_hint | escape }}</span>
          {% endif %}
        </div>
      {% endif %}
    </tjs-category-slider>
  </div>
</section>

{% style %}
  #TjsCategoryHero-{{ section.id }} {
    --tjs-body-font: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    --tjs-heading-font: var(--font-heading-family, Georgia, "Times New Roman", serif);
    position: relative;
    overflow: hidden;
    background: var(--tjs-bg);
    color: var(--tjs-text);
    font-family: var(--tjs-body-font);
  }

  #TjsCategoryHero-{{ section.id }}.tjs-category-hero--heading-editorial {
    --tjs-heading-font: "Iowan Old Style", Baskerville, "Times New Roman", serif;
  }

  #TjsCategoryHero-{{ section.id }}.tjs-category-hero--heading-modern {
    --tjs-heading-font: var(--tjs-body-font);
  }

  #TjsCategoryHero-{{ section.id }} *,
  #TjsCategoryHero-{{ section.id }} *::before,
  #TjsCategoryHero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #TjsCategoryHero-{{ section.id }}.tjs-category-hero--pattern::before {
    content: "";
    position: absolute;
    top: 14px;
    left: 50%;
    width: 96px;
    height: 28px;
    transform: translateX(-50%);
    opacity: .08;
    pointer-events: none;
    background-image: radial-gradient(circle, var(--tjs-accent) 1px, transparent 1.2px);
    background-size: 9px 9px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
  }

  #TjsCategoryHero-{{ section.id }} .tjs-category-hero__inner {
    position: relative;
    width: min(calc(100% - 40px), var(--tjs-content-width));
    min-height: var(--tjs-section-min-height);
    margin-inline: auto;
    padding-top: var(--tjs-padding-top);
    padding-bottom: var(--tjs-padding-bottom);
    display: grid;
    grid-template-columns: minmax(0, var(--tjs-left-width)) minmax(0, 1fr);
    gap: clamp(38px, 5vw, 78px);
    align-items: center;
  }

  #TjsCategoryHero-{{ section.id }} .tjs-category-hero__copy {
    min-width: 0;
  }

  #TjsCategoryHero-{{ section.id }} .tjs-category-hero__copy-main {
    width: min(100%, 560px);
  }

  #TjsCategoryHero-{{ section.id }} .tjs-category-hero__eyebrow {
    display: inline-flex;
