{% liquid
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign secondary_image = section.settings.secondary_image
  assign mobile_secondary_image = section.settings.mobile_secondary_image

  if mobile_image == blank
    assign mobile_image = hero_image
  endif

  if mobile_secondary_image == blank
    assign mobile_secondary_image = secondary_image
  endif

  if hero_image == blank and secondary_image != blank
    assign hero_image = secondary_image
    assign mobile_image = mobile_secondary_image
    assign secondary_image = blank
    assign mobile_secondary_image = blank
  endif

  assign has_secondary = false
  if section.settings.enable_image_swap and secondary_image != blank
    assign has_secondary = true
  endif

  assign heading = section.settings.heading | default: 'Your home upgrade era starts here.'
  assign image_alt = section.settings.image_alt | default: heading
%}

<section
  id="tjs-mobile-hero-{{ section.id }}"
  class="tjs-mobile-hero{% if has_secondary %} has-secondary-image{% endif %}"
  data-tjs-mobile-hero
>
  <div class="tjs-mobile-hero__media" aria-hidden="true">
    {% if hero_image != blank %}
      <picture class="tjs-mobile-hero__image-layer tjs-mobile-hero__image-layer--one">
        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 900 }}"
          >
        {% endif %}

        <img
          src="{{ hero_image | image_url: width: 2000 }}"
          alt="{{ image_alt | escape }}"
          width="{{ hero_image.width }}"
          height="{{ hero_image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      </picture>

      {% if has_secondary %}
        <picture class="tjs-mobile-hero__image-layer tjs-mobile-hero__image-layer--two">
          {% if mobile_secondary_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ mobile_secondary_image | image_url: width: 900 }}"
            >
          {% endif %}

          <img
            src="{{ secondary_image | image_url: width: 2000 }}"
            alt=""
            width="{{ secondary_image.width }}"
            height="{{ secondary_image.height }}"
            loading="eager"
          >
        </picture>
      {% endif %}
    {% else %}
      <div class="tjs-mobile-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="tjs-mobile-hero__overlay"></div>
  <div class="tjs-mobile-hero__texture" aria-hidden="true"></div>
  <div class="tjs-mobile-hero__shine" aria-hidden="true"></div>

  <div class="tjs-mobile-hero__inner">
    <div class="tjs-mobile-hero__content">
      <h1>
        {{ heading }}
        {% if section.settings.highlight != blank %}
          <em>{{ section.settings.highlight }}</em>
        {% endif %}
      </h1>

      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="tjs-mobile-hero__actions">
        {% if section.settings.primary_text != blank %}
          <a
            href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
            class="tjs-mobile-hero__btn tjs-mobile-hero__btn--primary"
          >
            {{ section.settings.primary_text }}
            <span>→</span>
          </a>
        {% endif %}

        {% if section.settings.secondary_text != blank %}
          <a
            href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}"
            class="tjs-mobile-hero__btn tjs-mobile-hero__btn--secondary"
          >
            {{ section.settings.secondary_text }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_deal_card %}
      <div class="tjs-mobile-hero__deal-card">
        <div class="tjs-mobile-hero__deal-top">
          <span>{{ section.settings.deal_kicker }}</span>
          <i></i>
        </div>

        <strong>{{ section.settings.deal_main }}</strong>
        <small>{{ section.settings.deal_sub }}</small>
      </div>
    {% endif %}
  </div>

  {% if section.settings.show_lanes and section.blocks.size > 0 %}
    <div class="tjs-mobile-hero__lanes">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span>{{ block.settings.title }}</span>
          <em>{{ block.settings.meta }}</em>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</section>

<style>
  #tjs-mobile-hero-{{ section.id }},
  #tjs-mobile-hero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #tjs-mobile-hero-{{ section.id }} {
    --tjs-ink: {{ section.settings.text_color }};
    --tjs-paper: {{ section.settings.background_color }};
    --tjs-accent: {{ section.settings.accent_color }};
    --tjs-gold: {{ section.settings.gold_color }};
    --tjs-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --tjs-radius: {{ section.settings.radius }}px;
    --tjs-swap-speed: {{ section.settings.image_swap_speed }}s;

    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: {{ section.settings.desktop_height }}px;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 10%, rgba(213,141,130,.14), transparent 28%),
      radial-gradient(circle at 90% 88%, rgba(213,162,91,.16), transparent 30%),
      var(--tjs-paper);
    color: var(--tjs-ink);
    font-family: inherit;
    isolation: isolate;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__media {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #f6efe8;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer,
  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer img,
  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__placeholder,
  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer {
    position: absolute;
    inset: 0;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer img,
  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__placeholder svg {
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    transform: scale(1.025);
    filter: saturate(0.98) contrast(0.98);
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer--one {
    z-index: 1;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer--two {
    z-index: 2;
    opacity: 0;
  }

  #tjs-mobile-hero-{{ section.id }}.has-secondary-image .tjs-mobile-hero__image-layer--one img {
    animation: tjsHeroImageBreath{{ section.id }} var(--tjs-swap-speed) ease-in-out infinite;
  }

  #tjs-mobile-hero-{{ section.id }}.has-secondary-image .tjs-mobile-hero__image-layer--two {
    animation: tjsHeroImageSwap{{ section.id }} var(--tjs-swap-speed) ease-in-out infinite;
  }

  #tjs-mobile-hero-{{ section.id }}.has-secondary-image .tjs-mobile-hero__image-layer--two img {
    animation: tjsHeroImageBreathTwo{{ section.id }} var(--tjs-swap-speed) ease-in-out infinite;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(
        90deg,
        rgba(255, 248, 242, 0.97) 0%,
        rgba(255, 248, 242, 0.90) 34%,
        rgba(255, 248, 242, 0.58) 62%,
        rgba(255, 248, 242, 0.14) 100%
      ),
      rgba(0,0,0,var(--tjs-overlay));
    pointer-events: none;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__texture {
    position: absolute;
    inset: 0;
    z-index: 4;
    background:
      linear-gradient(90deg, rgba(31,25,22,0.026) 1px, transparent 1px),
      linear-gradient(0deg, rgba(31,25,22,0.022) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.48;
    pointer-events: none;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__shine {
    position: absolute;
    inset: -30%;
    z-index: 5;
    background:
      linear-gradient(
        115deg,
        transparent 0%,
        rgba(255,255,255,0.08) 38%,
        rgba(255,255,255,0.42) 48%,
        rgba(255,255,255,0.08) 58%,
        transparent 100%
      );
    transform: translateX(-60%) rotate(7deg);
    opacity: 0;
    pointer-events: none;
    animation: tjsHeroShine{{ section.id }} 9s ease-in-out infinite;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__inner {
    position: relative;
    z-index: 6;
    width: min(1220px, calc(100% - 32px));
    min-height: {{ section.settings.desktop_height }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    align-items: center;
    gap: 28px;
    padding: 54px 0 72px;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__content {
    max-width: 740px;
  }

  #tjs-mobile-hero-{{ section.id }} h1 {
    margin: 0;
    max-width: 780px;
    color: var(--tjs-ink);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    font-size: {{ section.settings.heading_size }}px;
    line-height: .84;
    letter-spacing: -3.9px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-mobile-hero-{{ section.id }} h1 em {
    display: inline-block;
    margin-top: 8px;
    padding: 6px 12px 8px;
    border-radius: 18px;
    background: var(--tjs-ink);
    color: #fff;
    font-style: normal;
    box-shadow: 7px 7px 0 rgba(213,141,130,.34);
    transform: rotate(-1.4deg);
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__content p {
    max-width: 560px;
    margin: 20px 0 0;
    color: rgba(31,25,22,.72);
    font-size: 15px;
    line-height: 1.62;
    font-weight: 780;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 28px;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 19px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 1.15px;
    text-transform: uppercase;
    font-weight: 950;
    transition:
      transform .22s ease,
      box-shadow .22s ease,
      background .22s ease,
      color .22s ease;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn--primary {
    background: var(--tjs-ink);
    color: #fff;
    box-shadow:
      6px 6px 0 rgba(213,141,130,.36),
      0 14px 30px rgba(31,25,22,.16);
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn--secondary {
    background:
      linear-gradient(180deg, rgba(255,255,255,.78), rgba(255,255,255,.44)),
      rgba(255,255,255,.58);
    color: var(--tjs-ink);
    border: 1px solid rgba(255,255,255,.74);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.82),
      0 10px 26px rgba(31,25,22,.08);
    backdrop-filter: blur(18px) saturate(145%);
    -webkit-backdrop-filter: blur(18px) saturate(145%);
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn:hover {
    transform: translateY(-2px);
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn:active {
    transform: scale(0.98);
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn span {
    transition: transform .2s ease;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn:hover span,
  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn:active span {
    transform: translateX(3px);
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card {
    position: relative;
    justify-self: end;
    width: min(310px, 100%);
    padding: 20px;
    border-radius: var(--tjs-radius);
    background:
      linear-gradient(180deg, rgba(255,255,255,.78), rgba(255,255,255,.42)),
      rgba(255,255,255,.58);
    border: 1px solid rgba(255,255,255,.76);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.86),
      0 22px 54px rgba(31,25,22,.12);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    overflow: hidden;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card::before {
    content: "";
    position: absolute;
    left: -40%;
    top: -80%;
    width: 44px;
    height: 280%;
    background: linear-gradient(110deg, transparent, rgba(255,255,255,.68), transparent);
    transform: rotate(18deg);
    opacity: 0;
    animation: tjsHeroCardShine{{ section.id }} 6.5s ease-in-out infinite;
    pointer-events: none;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-top span {
    color: rgba(31,25,22,.60);
    font-size: 8px;
    line-height: 1;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-top i {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--tjs-accent);
    box-shadow: 0 0 0 5px rgba(213,141,130,.14);
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card strong {
    display: block;
    color: var(--tjs-ink);
    font-size: 40px;
    line-height: .82;
    letter-spacing: -2px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card small {
    display: block;
    margin-top: 12px;
    color: rgba(31,25,22,.66);
    font-size: 12px;
    line-height: 1.45;
    font-weight: 780;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes {
    position: absolute;
    left: 50%;
    bottom: 18px;
    z-index: 8;
    width: min(1220px, calc(100% - 32px));
    transform: translateX(-50%);
    display: flex;
    gap: 9px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes::-webkit-scrollbar {
    display: none;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes a {
    flex: 0 0 auto;
    min-height: 48px;
    min-width: 134px;
    display: grid;
    align-content: center;
    gap: 4px;
    padding: 8px 13px;
    border-radius: 999px;
    background:
      linear-gradient(180deg, rgba(255,255,255,.80), rgba(255,255,255,.44)),
      rgba(255,255,255,.58);
    border: 1px solid rgba(255,255,255,.74);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.82),
      0 10px 26px rgba(31,25,22,.08);
    backdrop-filter: blur(18px) saturate(145%);
    -webkit-backdrop-filter: blur(18px) saturate(145%);
    text-decoration: none;
    color: var(--tjs-ink);
    transition: transform .22s ease;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes a:active {
    transform: scale(0.98);
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes span {
    font-size: 11px;
    line-height: 1;
    text-transform: uppercase;
    font-weight: 950;
    letter-spacing: .3px;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes em {
    color: rgba(31,25,22,.58);
    font-style: normal;
    font-size: 8px;
    line-height: 1;
    letter-spacing: .9px;
    text-transform: uppercase;
    font-weight: 850;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__content,
  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card,
  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes {
    opacity: 0;
    transform: translateY(18px);
    animation: tjsHeroReveal{{ section.id }} .75s cubic-bezier(.2,.8,.2,1) forwards;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card {
    animation-delay: .12s;
  }

  #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes {
    animation-delay: .22s;
  }

  @keyframes tjsHeroReveal{{ section.id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tjsHeroImageSwap{{ section.id }} {
    0%, 40% {
      opacity: 0;
    }
    50%, 88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes tjsHeroImageBreath{{ section.id }} {
    0%, 45%, 100% {
      transform: scale(1.025);
    }
    55%, 90% {
      transform: scale(1.045);
    }
  }

  @keyframes tjsHeroImageBreathTwo{{ section.id }} {
    0%, 40%, 100% {
      transform: scale(1.035);
    }
    50%, 88% {
      transform: scale(1.055);
    }
  }

  @keyframes tjsHeroShine{{ section.id }} {
    0%, 32% {
      transform: translateX(-60%) rotate(7deg);
      opacity: 0;
    }
    46% {
      opacity: .50;
    }
    70%, 100% {
      transform: translateX(58%) rotate(7deg);
      opacity: 0;
    }
  }

  @keyframes tjsHeroCardShine{{ section.id }} {
    0%, 40% {
      left: -45%;
      opacity: 0;
    }
    55% {
      opacity: .7;
    }
    82%, 100% {
      left: 125%;
      opacity: 0;
    }
  }

  @media screen and (max-width: 899px) {
    #tjs-mobile-hero-{{ section.id }} {
      min-height: {{ section.settings.mobile_height }}px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer img,
    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__placeholder svg {
      object-position: {{ section.settings.mobile_image_position }};
      filter: saturate(0.96) contrast(0.96);
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__overlay {
      background:
        linear-gradient(
          180deg,
          rgba(255, 248, 242, 0.95) 0%,
          rgba(255, 248, 242, 0.90) 35%,
          rgba(255, 248, 242, 0.64) 68%,
          rgba(255, 248, 242, 0.90) 100%
        ),
        rgba(0,0,0,var(--tjs-overlay));
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__texture {
      opacity: 0.36;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__inner {
      width: min(100% - 24px, 640px);
      min-height: {{ section.settings.mobile_height }}px;
      grid-template-columns: 1fr;
      align-content: center;
      gap: 18px;
      padding: 42px 0 108px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__content {
      max-width: 100%;
    }

    #tjs-mobile-hero-{{ section.id }} h1 {
      font-size: {{ section.settings.mobile_heading_size }}px;
      letter-spacing: -2.25px;
      line-height: .86;
    }

    #tjs-mobile-hero-{{ section.id }} h1 em {
      padding: 5px 9px 7px;
      border-radius: 14px;
      box-shadow: 5px 5px 0 rgba(213,141,130,.34);
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__content p {
      margin-top: 16px;
      max-width: 94%;
      font-size: 13px;
      line-height: 1.55;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__actions {
      margin-top: 22px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn {
      min-height: 46px;
      padding: 0 12px;
      font-size: 8.5px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card {
      justify-self: start;
      width: min(260px, 100%);
      padding: 15px;
      border-radius: 20px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card strong {
      font-size: 29px;
      letter-spacing: -1.2px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card small {
      font-size: 10.5px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes {
      left: 12px;
      right: 0;
      bottom: 14px;
      width: auto;
      transform: none;
      padding-right: 12px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes a {
      min-height: 44px;
      min-width: 124px;
      padding: 8px 12px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes span {
      font-size: 10px;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes em {
      font-size: 7px;
    }
  }

  @media screen and (max-width: 420px) {
    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__actions {
      grid-template-columns: 1fr;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__btn {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tjs-mobile-hero-{{ section.id }} *,
    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__shine,
    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card::before,
    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer--one img,
    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer--two,
    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__image-layer--two img {
      transition: none !important;
      animation: none !important;
    }

    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__content,
    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__deal-card,
    #tjs-mobile-hero-{{ section.id }} .tjs-mobile-hero__lanes {
