{% liquid
  assign selected_collection = section.settings.collection
  assign selected_collection_count = 0

  if selected_collection != blank
    assign selected_collection_count = selected_collection.products_count | default: 0 | plus: 0
  endif

  assign product_limit = section.settings.products_to_show | default: 8
  assign discount_percent = section.settings.discount_percent | default: 50
  assign deal_multiplier = 100 | minus: discount_percent
  assign discount_code = section.settings.discount_code | strip
  assign preselect_count = section.settings.preselected_count | default: 4
%}

<section id="tjs-bulk-deal-{{ section.id }}" class="tjs-bulk-deal" data-tjs-bulk-deal>
  <div class="tjs-bulk-deal__bg-text" aria-hidden="true">
    CART DROP / BIG SAVINGS / THE JUNE SHOP /
  </div>

  <div class="tjs-bulk-deal__head">
    <div>
      <div class="tjs-bulk-deal__kicker">
        {{ section.settings.kicker | default: 'Clearance Cart Drop' }}
      </div>

      <h2>
        {{ section.settings.heading | default: 'Build your deal cart.' }}
      </h2>

      <p>
        {{ section.settings.subheading | default: 'Pick multiple favourites and unlock an extra deal on the current website price. More pieces, better savings, zero overthinking.' }}
      </p>
    </div>

    <div class="tjs-bulk-deal__saving-badge">
      <span>Extra</span>
      <b>{{ discount_percent }}% off</b>
      <em>on website price</em>
    </div>
  </div>

  {% if selected_collection != blank and selected_collection_count > 0 %}
    <div class="tjs-bulk-deal__actions">
      <button type="button" class="tjs-bulk-deal__mini-btn" data-tjs-select-all>
        Select All
      </button>

      <button type="button" class="tjs-bulk-deal__mini-btn" data-tjs-clear>
        Clear
      </button>

      {% if discount_code != blank %}
        <span class="tjs-bulk-deal__code">Code: {{ discount_code }}</span>
      {% endif %}

      <a class="tjs-bulk-deal__view" href="{{ selected_collection.url }}">
        View Collection →
      </a>
    </div>

    <div class="tjs-bulk-deal__layout">
      <div class="tjs-bulk-deal__grid">
        {% for product in selected_collection.products limit: product_limit %}
          {% assign v = product.selected_or_first_available_variant %}

          {% assign shopify_selling_price = v.price | default: 0 | plus: 0 %}
          {% assign compare_price = v.compare_at_price | default: 0 | plus: 0 %}

          {% if compare_price <= shopify_selling_price %}
            {% assign compare_price = shopify_selling_price %}
          {% endif %}

          {% assign deal_price = shopify_selling_price | times: deal_multiplier | divided_by: 100 %}
          {% assign savings = shopify_selling_price | minus: deal_price %}

          {% assign should_check = false %}
          {% if forloop.index <= preselect_count and product.available %}
            {% assign should_check = true %}
          {% endif %}

          {% capture tjs_native_form_id %}tjs-native-a2c-{{ section.id }}-{{ product.id }}-{{ forloop.index }}{% endcapture %}

          <article
            class="tjs-deal-card{% if should_check %} is-picked{% endif %}{% unless product.available %} is-sold{% endunless %}"
            data-tjs-card
            data-price="{{ shopify_selling_price }}"
            data-deal="{{ deal_price }}"
            data-savings="{{ savings }}"
            data-mrp="{{ compare_price }}"
            data-variant-id="{{ v.id }}"
            data-available="{% if product.available %}true{% else %}false{% endif %}"
          >
            <label class="tjs-deal-card__pick" aria-label="Select {{ product.title | escape }}">
              <input
                type="checkbox"
                data-tjs-pick
                {% if should_check %}checked{% endif %}
                {% unless product.available %}disabled{% endunless %}
              >
              <span class="tjs-deal-card__pick-badge">
                <i></i>
                <small>Select</small>
              </span>
            </label>

            <wrapp-hdt-pr-frm class="tjs-native-a2c-form-wrap" data-tjs-native-a2c-form-wrap>
              {%- form 'product',
                product,
                id: tjs_native_form_id,
                class: 'tjs-native-a2c-form',
                novalidate: 'novalidate'
              -%}
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <button
                  type="submit"
                  name="add"
                  class="tjs-native-a2c-submit hdt-inline-flex hdt-align-center hdt-justify-center hdt-relative hdt-btn hdt-oh hdt-btn-solid hdt-font-semibold"
                  data-tjs-native-a2c-submit
                  {% unless product.available %}disabled{% endunless %}
                >
                  <span>Add</span>
                </button>
              {%- endform -%}
            </wrapp-hdt-pr-frm>

            <button
              type="button"
              class="tjs-deal-card__quick"
              data-tjs-native-a2c
              {% unless product.available %}disabled{% endunless %}
              aria-label="Add {{ product.title | escape }} to cart"
            >
              <span>+</span>
              <small>Add</small>
            </button>

            <a href="{{ product.url }}" class="tjs-deal-card__image-card">
              {% if product.featured_image != blank %}
                <img
                  src="{{ product.featured_image | image_url: width: 1200 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                >
              {% endif %}

              {% unless product.available %}
                <div class="tjs-deal-card__sold">Sold Out</div>
              {% endunless %}

              <div class="tjs-deal-card__overlay">
                <div class="tjs-deal-card__deal" data-tjs-deal-pill>
                  <span data-tjs-stage-label>Deal Price</span>
                  <strong
                    data-tjs-price-roll
                    data-compare="{{ compare_price }}"
                    data-selling="{{ shopify_selling_price }}"
                    data-deal="{{ deal_price }}"
                  >
                    {{ deal_price | money_without_trailing_zeros }}
                  </strong>
                </div>

                <div class="tjs-deal-card__title">
                  {{ product.title }}
                </div>
              </div>
            </a>
          </article>
        {% endfor %}
      </div>

      <aside class="tjs-bulk-deal__summary">
        <div class="tjs-bulk-deal__summary-inner">
          <div class="tjs-bulk-deal__summary-top">
            <div class="tjs-bulk-deal__summary-kicker">Your Deal Cart</div>
            {% if discount_code != blank %}
              <div class="tjs-bulk-deal__summary-code">Use code: {{ discount_code }}</div>
            {% endif %}
          </div>

          <h3>
            Stack more.<br>Save more.
          </h3>

          <div class="tjs-bulk-deal__summary-steps">
            <span>1. Select favourites</span>
            <span>2. Add selected to cart</span>
            <span>3. Checkout with code</span>
          </div>

          <div class="tjs-bulk-deal__stats">
            <div>
              <span>Selected</span>
              <b data-tjs-count>0</b>
            </div>

            <div>
              <span>Website Total</span>
              <b data-tjs-total>₹0</b>
            </div>

            <div class="is-highlight">
              <span>Deal Total</span>
              <b data-tjs-deal>₹0</b>
            </div>

            <div>
              <span>You Save</span>
              <b data-tjs-save>₹0</b>
            </div>
          </div>

          <div class="tjs-bulk-deal__summary-help" data-tjs-help>
            Select products to preview your final deal total.
          </div>

          <button type="button" class="tjs-bulk-deal__cart-btn" data-tjs-add-selected>
            Add Selected To Cart
          </button>

          <button type="button" class="tjs-bulk-deal__buy-btn" data-tjs-buy-selected>
            Buy Selected
          </button>

          <p>
            The deal total shown here reflects the extra section discount. Apply the code at checkout to unlock it.
          </p>
        </div>
      </aside>
    </div>
  {% else %}
    <div class="tjs-bulk-deal__empty">
      <span>Nothing on the deal rack yet.</span>
      <p>Select a collection with products to activate this cart-drop section.</p>
    </div>
  {% endif %}
</section>

<style>
  #tjs-bulk-deal-{{ section.id }},
  #tjs-bulk-deal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #tjs-bulk-deal-{{ section.id }} {
    --ink: #241915;
    --paper: #fff8f2;
    --cream: #fffdf8;
    --rose: #d58d82;
    --gold: #d5a25b;
    --line: rgba(36, 25, 21, 0.14);

    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 54px 14px;
    background:
      radial-gradient(circle at 12% 16%, rgba(213, 141, 130, 0.28), transparent 30%),
      radial-gradient(circle at 88% 80%, rgba(213, 162, 91, 0.22), transparent 28%),
      linear-gradient(90deg, rgba(36,25,21,0.035) 1px, transparent 1px),
      linear-gradient(0deg, rgba(36,25,21,0.03) 1px, transparent 1px),
      var(--paper);
    background-size: auto, auto, 22px 22px, 22px 22px, auto;
    color: var(--ink);
    font-family: inherit;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__bg-text {
    position: absolute;
    left: -20px;
    right: -20px;
    top: 44%;
    transform: rotate(-4deg);
    color: rgba(36,25,21,0.04);
    font-size: clamp(58px, 10vw, 140px);
    line-height: .8;
    letter-spacing: -5px;
    text-transform: uppercase;
    font-weight: 950;
    white-space: nowrap;
    pointer-events: none;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__head,
  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__layout,
  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__actions,
  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__empty {
    position: relative;
    z-index: 1;
    width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__head {
    display: grid;
    gap: 18px;
    margin-bottom: 22px;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__kicker {
    width: fit-content;
    margin-bottom: 12px;
    padding: 8px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: #ffffff;
    font-size: 8.5px;
    line-height: 1;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-bulk-deal-{{ section.id }} h2 {
    margin: 0;
    max-width: 760px;
    color: var(--ink);
    font-size: clamp(40px, 7vw, 82px);
    line-height: .84;
    letter-spacing: -3.4px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__head p {
    max-width: 560px;
    margin: 14px 0 0;
    color: rgba(36,25,21,0.68);
    font-size: 14px;
    line-height: 1.55;
    font-weight: 700;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__saving-badge {
    width: fit-content;
    align-self: end;
    justify-self: start;
    padding: 14px 16px;
    border-radius: 20px;
    background: var(--cream);
    border: 1.5px solid var(--ink);
    box-shadow: 7px 7px 0 var(--rose);
    transform: rotate(3deg);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__saving-badge span,
  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__stats span {
    display: block;
    color: rgba(36,25,21,0.52);
    font-size: 8px;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__saving-badge b {
    display: block;
    margin-top: 6px;
    color: var(--ink);
    font-size: 30px;
    line-height: .9;
    letter-spacing: -1.5px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__saving-badge em {
    display: block;
    margin-top: 6px;
    color: rgba(36,25,21,.56);
    font-style: normal;
    font-size: 9px;
    line-height: 1;
    letter-spacing: .8px;
    text-transform: uppercase;
    font-weight: 900;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__actions {
    display: flex;
    gap: 8px;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
    margin-bottom: 18px;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__actions::-webkit-scrollbar {
    display: none;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__mini-btn,
  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__code,
  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__view {
    flex: 0 0 auto;
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--cream);
    color: var(--ink);
    font-family: inherit;
    font-size: 9px;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 950;
    text-decoration: none;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__mini-btn {
    cursor: pointer;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__view {
    margin-left: auto;
    background: var(--ink);
    color: #ffffff;
    border-color: var(--ink);
    box-shadow: 3px 3px 0 rgba(213,141,130,.38);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__mini-btn:hover,
  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__view:hover {
    background: var(--ink);
    color: #ffffff;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__layout {
    display: grid;
    gap: 18px;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-bulk-deal__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card {
    position: relative;
    aspect-ratio: 1 / 1.34;
    overflow: hidden;
    border-radius: 26px;
    background: var(--cream);
    border: 1px solid var(--line);
    box-shadow: 0 14px 24px rgba(36,25,21,0.08);
    transition:
      transform .22s ease,
      box-shadow .22s ease,
      border-color .22s ease;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card.is-picked {
    border-color: var(--ink);
    box-shadow:
      0 0 0 2px var(--ink),
      6px 6px 0 rgba(213,141,130,0.45),
      0 16px 26px rgba(36,25,21,0.12);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card:hover {
    transform: translateY(-2px);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__pick {
    position: absolute;
    top: 11px;
    left: 11px;
    z-index: 8;
    cursor: pointer;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__pick input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__pick-badge {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0 10px 0 8px;
    border-radius: 999px;
    background: rgba(255,255,255,.98);
    border: 1.5px solid var(--ink);
    box-shadow: 3px 3px 0 var(--rose);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__pick-badge i {
    width: 14px;
    height: 14px;
    display: block;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: #fff;
    position: relative;
    flex: 0 0 auto;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__pick-badge small {
    color: var(--ink);
    font-size: 8px;
    line-height: 1;
    letter-spacing: .8px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__pick input:checked + .tjs-deal-card__pick-badge {
    background: var(--ink);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__pick input:checked + .tjs-deal-card__pick-badge i {
    background: #fff;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__pick input:checked + .tjs-deal-card__pick-badge i::after {
    content: "";
    position: absolute;
    left: 3px;
    top: 1px;
    width: 5px;
    height: 8px;
    border: solid var(--ink);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__pick input:checked + .tjs-deal-card__pick-badge small {
    color: #fff;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-native-a2c-form-wrap,
  #tjs-bulk-deal-{{ section.id }} .tjs-native-a2c-form {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    clip-path: inset(50%) !important;
    left: -9999px !important;
    top: auto !important;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__quick {
    position: absolute;
    top: 11px;
    right: 11px;
    z-index: 8;
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 11px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    background: var(--ink);
    color: #ffffff;
    cursor: pointer;
    box-shadow: 4px 4px 0 var(--rose);
    transition:
      transform .2s ease,
      background .2s ease,
      color .2s ease;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__quick span {
    font-size: 20px;
    line-height: 1;
    font-weight: 950;
    transform: translateY(-1px);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__quick small {
    font-size: 8px;
    line-height: 1;
    letter-spacing: .8px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__quick:hover {
    transform: rotate(6deg) scale(1.04);
    background: #ffffff;
    color: var(--ink);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__quick:disabled {
    opacity: .35;
    cursor: not-allowed;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__image-card {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 38%, rgba(213,162,91,0.16), transparent 44%),
      linear-gradient(135deg, #fcf7f1 0%, #f7ede3 100%);
    text-decoration: none;
    color: inherit;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__image-card::before {
    content: "";
    position: absolute;
    inset: 12px;
    z-index: 1;
    border: 1px dashed rgba(36,25,21,.09);
    border-radius: 20px;
    pointer-events: none;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__image-card::after {
    content: "";
    position: absolute;
    left: 11%;
    right: 11%;
    bottom: 21%;
    z-index: 1;
    height: 18px;
    border-radius: 50%;
    background: rgba(36,25,21,.10);
    filter: blur(10px);
    pointer-events: none;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__image-card img {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center 41%;
    padding: 8px 8px 76px;
    transform: scale(1.12);
    transition: transform .35s ease;
    will-change: transform;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card:hover .tjs-deal-card__image-card img {
    transform: scale(1.16);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__sold {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    background: rgba(36,25,21,.58);
    color: #ffffff;
    font-size: 18px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    padding: 52px 12px 12px;
    background:
      linear-gradient(
        180deg,
        rgba(255,248,242,0) 0%,
        rgba(255,248,242,.48) 28%,
        rgba(255,253,248,.94) 72%,
        rgba(255,253,248,.99) 100%
      );
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__deal {
    width: fit-content;
    max-width: 100%;
    margin-bottom: 8px;
    padding: 8px 10px;
    border-radius: 15px;
    background: rgba(255,255,255,.98);
    border: 1px solid rgba(36,25,21,.12);
    box-shadow:
      0 8px 18px rgba(36,25,21,.08),
      3px 3px 0 rgba(213,141,130,.24);
    transform-origin: center center;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__deal span {
    display: block;
    margin-bottom: 4px;
    color: rgba(36,25,21,.54);
    font-size: 7px;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 950;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__deal strong {
    display: block;
    color: var(--ink);
    font-size: 23px;
    line-height: .9;
    letter-spacing: -1px;
    font-weight: 950;
    transform-origin: center center;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__deal.is-rolling strong {
    animation: tjsDealTicker .16s linear infinite;
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__deal.is-landed {
    animation: tjsDealStamp .52s cubic-bezier(.2,.8,.2,1);
  }

  #tjs-bulk-deal-{{ section.id }} .tjs-deal-card__deal.is-landed strong {
    animation: tjsDealStampText .52s cubic-bezier(.2,.8,.2,1);
  }

  @keyframes tjsDealTicker {
    0% { transform: translateY(-1px); filter: blur(.2px); }
