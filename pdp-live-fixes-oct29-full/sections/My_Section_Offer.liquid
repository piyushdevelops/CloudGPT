</style>

<script>
  (function () {
    function initBulkDeal() {
      const root = document.getElementById("tjs-bulk-deal-{{ section.id }}");
      if (!root || root.dataset.ready === "true") return;
      root.dataset.ready = "true";

      const cards = Array.from(root.querySelectorAll("[data-tjs-card]"));
      const picks = Array.from(root.querySelectorAll("[data-tjs-pick]"));
      const countEl = root.querySelector("[data-tjs-count]");
      const totalEl = root.querySelector("[data-tjs-total]");
      const dealEl = root.querySelector("[data-tjs-deal]");
      const saveEl = root.querySelector("[data-tjs-save]");
      const addSelectedBtn = root.querySelector("[data-tjs-add-selected]");
      const buySelectedBtn = root.querySelector("[data-tjs-buy-selected]");
      const selectAllBtn = root.querySelector("[data-tjs-select-all]");
      const clearBtn = root.querySelector("[data-tjs-clear]");
      const helpEl = root.querySelector("[data-tjs-help]");
      const discountCode = {{ discount_code | json }};
      const reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function money(cents) {
        const value = Number(cents || 0) / 100;
        return "₹" + new Intl.NumberFormat("en-IN", {
          maximumFractionDigits: 0
        }).format(value);
      }

      function selectedCards() {
        return cards.filter(function (card) {
          const pick = card.querySelector("[data-tjs-pick]");
          return pick && pick.checked && card.dataset.available === "true";
        });
      }

      function updateSummary() {
        let total = 0;
        let deal = 0;
        let save = 0;

        cards.forEach(function (card) {
          const pick = card.querySelector("[data-tjs-pick]");
          const isPicked = pick && pick.checked;

          card.classList.toggle("is-picked", isPicked);

          if (isPicked && card.dataset.available === "true") {
            total += Number(card.dataset.price || 0);
            deal += Number(card.dataset.deal || 0);
            save += Number(card.dataset.savings || 0);
          }
        });

        const selected = selectedCards().length;

        if (countEl) countEl.textContent = selected;
        if (totalEl) totalEl.textContent = money(total);
        if (dealEl) dealEl.textContent = money(deal);
        if (saveEl) saveEl.textContent = money(save);

        if (addSelectedBtn) addSelectedBtn.disabled = selected === 0;
        if (buySelectedBtn) buySelectedBtn.disabled = selected === 0;

        if (helpEl) {
          if (selected === 0) {
            helpEl.textContent = "Select products to preview your final deal total.";
          } else if (selected === 1) {
            helpEl.textContent = "Good start. Add more favourites to build a stronger value cart.";
          } else if (selected < 4) {
            helpEl.textContent = "Nice haul. You are stacking a cleaner multi-product deal.";
          } else {
            helpEl.textContent = "Strong haul. You are maximizing the deal nicely.";
          }
        }
      }

      function animateValue(el, from, to, duration, stageText) {
        return new Promise(function (resolve) {
          const pill = el.closest("[data-tjs-deal-pill]");
          const label = pill ? pill.querySelector("[data-tjs-stage-label]") : null;

          if (label && stageText) label.textContent = stageText;

          if (from === to || reduceMotion) {
            el.textContent = money(to);
            resolve();
            return;
          }

          if (pill) pill.classList.add("is-rolling");

          const start = performance.now();

          function frame(now) {
            const progress = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - progress, 4);
            const current = Math.round(from + (to - from) * eased);

            el.textContent = money(current);

            if (progress < 1) {
              requestAnimationFrame(frame);
            } else {
              el.textContent = money(to);
              if (pill) pill.classList.remove("is-rolling");
              resolve();
            }
          }

          requestAnimationFrame(frame);
        });
      }

      function wait(ms) {
        return new Promise(function (resolve) {
          setTimeout(resolve, ms);
        });
      }

      function animatePrice(el) {
        if (!el || el.dataset.done === "true") return;
        el.dataset.done = "true";

        const compare = Number(el.dataset.compare || 0);
        const selling = Number(el.dataset.selling || 0);
        const deal = Number(el.dataset.deal || 0);
        const pill = el.closest("[data-tjs-deal-pill]");
        const label = pill ? pill.querySelector("[data-tjs-stage-label]") : null;

        function land() {
          if (!pill) return;
          pill.classList.remove("is-landed");
          void pill.offsetWidth;
          pill.classList.add("is-landed");
          setTimeout(function () {
            pill.classList.remove("is-landed");
          }, 650);
        }

        if (reduceMotion) {
          if (label) label.textContent = "Deal Price";
          el.textContent = money(deal);
          return;
        }

        const hasCompareStage = compare > selling;

        if (hasCompareStage) {
          el.textContent = money(compare);

          animateValue(el, compare, selling, 900, "MRP")
            .then(function () {
              if (label) label.textContent = "Website Price";
              return wait(900);
            })
            .then(function () {
              return animateValue(el, selling, deal, 1150, "Deal Price");
            })
            .then(function () {
              land();
            });
        } else {
          el.textContent = money(selling);

          wait(450)
            .then(function () {
              return animateValue(el, selling, deal, 1150, "Deal Price");
            })
            .then(function () {
              land();
            });
        }
      }

      function initPriceRolls() {
        const rollers = Array.from(root.querySelectorAll("[data-tjs-price-roll]"));

        if (!("IntersectionObserver" in window)) {
          rollers.forEach(animatePrice);
          return;
        }

        const observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              animatePrice(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.35
        });

        rollers.forEach(function (el) {
          observer.observe(el);
        });
      }

      function getNativeSubmit(card) {
        if (!card) return null;
        return card.querySelector("[data-tjs-native-a2c-submit]");
      }

      function setNativeButtonState(button, state) {
        if (!button) return;

        const label = button.querySelector("small");
        const icon = button.querySelector("span");

        if (state === "adding") {
          button.disabled = true;
          button.dataset.loading = "true";
          if (label) label.textContent = "Adding";
          if (icon) icon.textContent = "✓";
        }

        if (state === "added") {
          if (label) label.textContent = "Added";
          if (icon) icon.textContent = "✓";
        }

        if (state === "reset") {
          button.disabled = false;
          button.dataset.loading = "";
          if (label) label.textContent = "Add";
          if (icon) icon.textContent = "+";
        }

        if (state === "error") {
          if (label) label.textContent = "Retry";
          if (icon) icon.textContent = "!";
        }
      }

      function waitForCartEvent(timeout) {
        return new Promise(function (resolve) {
          let done = false;

          const events = [
            "cart:refresh",
            "cart:update",
            "cart:updated",
            "cart:change",
            "product:added",
            "theme:cart:change",
            "theme:cart:update",
            "cart-drawer:refresh"
          ];

          function finish() {
            if (done) return;
            done = true;

            events.forEach(function (eventName) {
              document.removeEventListener(eventName, finish);
            });

            resolve();
          }

          events.forEach(function (eventName) {
            document.addEventListener(eventName, finish);
          });

          setTimeout(finish, timeout || 1100);
        });
      }

      function nativeAddCard(card, visibleButton) {
        const nativeSubmit = getNativeSubmit(card);

        if (!nativeSubmit || nativeSubmit.disabled) {
          if (visibleButton) {
            setNativeButtonState(visibleButton, "error");

            setTimeout(function () {
              setNativeButtonState(visibleButton, "reset");
            }, 1000);
          }

          return Promise.resolve(false);
        }

        if (visibleButton) {
          if (visibleButton.disabled || visibleButton.dataset.loading === "true") {
            return Promise.resolve(false);
          }

          setNativeButtonState(visibleButton, "adding");
        }

        nativeSubmit.click();

        return waitForCartEvent(1300).then(function () {
          if (visibleButton) {
            setNativeButtonState(visibleButton, "added");

            setTimeout(function () {
              setNativeButtonState(visibleButton, "reset");
            }, 900);
          }

          return true;
        });
      }

      async function addSelectedNative(redirectAfter) {
        const selected = selectedCards();
        if (!selected.length) return;

        const originalAddText = addSelectedBtn ? addSelectedBtn.textContent : "";
        const originalBuyText = buySelectedBtn ? buySelectedBtn.textContent : "";

        if (addSelectedBtn) {
          addSelectedBtn.disabled = true;
          addSelectedBtn.textContent = "Adding...";
        }

        if (buySelectedBtn) {
          buySelectedBtn.disabled = true;
          buySelectedBtn.textContent = "Adding...";
        }

        for (const card of selected) {
          await nativeAddCard(card, null);
          await wait(260);
        }

        if (redirectAfter) {
          if (discountCode) {
            window.location.href = "/discount/" + encodeURIComponent(discountCode) + "?redirect=/cart";
          } else {
            window.location.href = "/cart";
          }

          return;
        }

        if (addSelectedBtn) addSelectedBtn.textContent = "Added ✓";

        setTimeout(function () {
          if (addSelectedBtn) {
            addSelectedBtn.textContent = originalAddText || "Add Selected To Cart";
          }

          if (buySelectedBtn) {
            buySelectedBtn.textContent = originalBuyText || "Buy Selected";
          }

          updateSummary();
        }, 1300);
      }

      picks.forEach(function (pick) {
        pick.addEventListener("change", updateSummary);
      });

      cards.forEach(function (card) {
        const quick = card.querySelector("[data-tjs-native-a2c]");

        if (!quick) return;

        quick.addEventListener(
          "click",
          function (event) {
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();

            nativeAddCard(card, quick);
          },
          true
        );
      });

      if (selectAllBtn) {
        selectAllBtn.addEventListener("click", function () {
          picks.forEach(function (pick) {
            if (!pick.disabled) pick.checked = true;
          });

          updateSummary();
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener("click", function () {
          picks.forEach(function (pick) {
            pick.checked = false;
          });

          updateSummary();
        });
      }

      if (addSelectedBtn) {
        addSelectedBtn.addEventListener("click", function () {
          addSelectedNative(false);
        });
      }

      if (buySelectedBtn) {
        buySelectedBtn.addEventListener("click", function () {
          addSelectedNative(true);
        });
      }

      updateSummary();
      initPriceRolls();
    }

    document.addEventListener("DOMContentLoaded", initBulkDeal);
    document.addEventListener("shopify:section:load", initBulkDeal);
  })();
</script>

