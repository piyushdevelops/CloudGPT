    {"type":"range","id":"padding_top_mobile","label":"Mobile top spacing","min":0,"max":40,"step":2,"unit":"px","default":12},
    {"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom spacing","min":0,"max":40,"step":2,"unit":"px","default":14}
  ],
  "blocks":[
    {
      "type":"category",
      "name":"Category",
      "settings":[
        {"type":"collection","id":"collection","label":"Collection"},
        {"type":"text","id":"label","label":"Custom label","info":"Leave blank to use the collection title."},
        {"type":"url","id":"link","label":"Custom link","info":"Leave blank to use the collection link."},
        {"type":"text","id":"badge","label":"Optional badge","info":"Examples: New, Popular, Sale"},
        {"type":"text","id":"count_override","label":"Product-count override"},
