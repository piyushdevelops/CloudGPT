    {"type":"range","id":"heading_size","label":"Desktop heading size","min":22,"max":44,"step":1,"unit":"px","default":31},
    {"type":"range","id":"heading_size_mobile","label":"Mobile heading size","min":20,"max":34,"step":1,"unit":"px","default":25},
    {"type":"select","id":"heading_weight","label":"Heading weight","default":"600","options":[{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semi-bold"},{"value":"700","label":"Bold"}]},
    {"type":"range","id":"label_size","label":"Desktop label size","min":9,"max":14,"step":1,"unit":"px","default":11},
    {"type":"range","id":"label_size_mobile","label":"Mobile label size","min":9,"max":13,"step":1,"unit":"px","default":10},
    {"type":"select","id":"label_weight","label":"Label weight","default":"700","options":[{"value":"500","label":"Medium"},{"value":"600","label":"Semi-bold"},{"value":"700","label":"Bold"}]},

    {"type":"header","content":"Beach palette"},
    {"type":"color","id":"background","label":"Section background","default":"#FFF8E9"},
    {"type":"color","id":"text_color","label":"Heading colour","default":"#242335"},
    {"type":"color","id":"muted_color","label":"Subheading colour","default":"#756C73"},
    {"type":"color","id":"accent_color","label":"Eyebrow colour","default":"#FF6F66"},

    {"type":"header","content":"Spacing"},
    {"type":"range","id":"header_gap","label":"Desktop header gap","min":4,"max":24,"step":1,"unit":"px","default":10},
    {"type":"range","id":"header_gap_mobile","label":"Mobile header gap","min":4,"max":18,"step":1,"unit":"px","default":8},
    {"type":"range","id":"padding_top","label":"Desktop top spacing","min":0,"max":60,"step":2,"unit":"px","default":14},
