        {"type":"select","id":"icon_type","label":"Built-in icon","default":"home","options":[{"value":"home","label":"Home décor"},{"value":"kitchen","label":"Kitchen and dining"},{"value":"organise","label":"Organisation"},{"value":"planner","label":"Planners"},{"value":"eyewear","label":"Eyewear"},{"value":"gift","label":"Gifting"},{"value":"star","label":"Bestsellers"},{"value":"tag","label":"Sale"},{"value":"lamp","label":"Lighting"},{"value":"glass","label":"Glassware"},{"value":"plus","label":"General category"}]},
        {"type":"range","id":"art_scale","label":"Artwork scale","min":70,"max":135,"step":1,"unit":"%","default":100},
        {"type":"range","id":"art_x","label":"Artwork horizontal position","min":-24,"max":24,"step":1,"unit":"%","default":0},
        {"type":"range","id":"art_y","label":"Artwork vertical position","min":-24,"max":24,"step":1,"unit":"%","default":0},

        {"type":"header","content":"Vibrant pastel colours"},
        {"type":"select","id":"color_preset","label":"Colour preset","default":"custom","options":[{"value":"custom","label":"Custom colours"},{"value":"coral","label":"Vibrant coral"},{"value":"aqua","label":"Aqua splash"},{"value":"lemon","label":"Lemon sunshine"},{"value":"sky","label":"Clear sky"},{"value":"lilac","label":"Dreamy lilac"},{"value":"shell","label":"Shell pink"},{"value":"lime","label":"Lime sorbet"},{"value":"mango","label":"Mango peach"},{"value":"seafoam","label":"Seafoam mint"},{"value":"periwinkle","label":"Periwinkle blue"},{"value":"watermelon","label":"Watermelon pink"},{"value":"apricot","label":"Sunset apricot"},{"value":"sand","label":"Coconut sand"},{"value":"lagoon","label":"Blue lagoon"}]},
        {"type":"paragraph","content":"Choose a ready-made palette above. Select Custom colours to use the settings below."},
        {"type":"color","id":"color_1","label":"Custom pastel colour 1","default":"#FFD0C6"},
        {"type":"color","id":"color_2","label":"Custom pastel colour 2","default":"#FF9684"},
        {"type":"color","id":"border_color","label":"Border colour","default":"#FFFFFF"},
        {"type":"color","id":"ink_color","label":"Custom icon and text colour","default":"#8F3B2F"}
      ]
    }
  ],
  "presets":[
    {
      "name":"TJS beach category strip – Mixed Pastels",
      "blocks":[
        {"type":"category","settings":{"label":"Bestsellers","icon_type":"star","color_preset":"lemon","badge":"Popular"}},
        {"type":"category","settings":{"label":"Home Décor","icon_type":"home","color_preset":"coral"}},
        {"type":"category","settings":{"label":"Kitchen & Dining","icon_type":"kitchen","color_preset":"aqua"}},
        {"type":"category","settings":{"label":"Organise","icon_type":"organise","color_preset":"sky"}},
        {"type":"category","settings":{"label":"Planners","icon_type":"planner","color_preset":"lilac"}},
