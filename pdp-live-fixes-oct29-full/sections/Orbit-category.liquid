        {"type":"select","id":"image_source","label":"Artwork source","default":"builtin","options":[{"value":"builtin","label":"Built-in icon"},{"value":"custom","label":"Uploaded artwork"},{"value":"collection","label":"Collection image"}]},
        {"type":"image_picker","id":"icon_image","label":"Uploaded transparent PNG or WebP"},
