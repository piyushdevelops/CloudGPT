    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 54px;
    gap: 10px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__wrap.is-single {
    grid-template-columns: minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button,
  #shopify-section-{{ section.id }} .tjs-atc-row__wishlist {
    border: 0;
    cursor: pointer;
    font-family: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button {
    position: relative;
    width: 100%;
    min-height: 56px;
    display: block;
    overflow: hidden;
    border-radius: 17px;
    background: var(--pdp-button);
    color: var(--pdp-button-text);
    box-shadow: 0 14px 30px rgba(47,36,32,.21);
    transition:
      transform .22s ease,
      box-shadow .22s ease,
      opacity .22s ease;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button::before {
    content: "";
    position: absolute;
    inset: 1px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 16px;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button::after {
    content: "";
    position: absolute;
    top: -90%;
    left: -55%;
    width: 46px;
    height: 290%;
    background:
      linear-gradient(
        110deg,
        transparent,
        rgba(255,255,255,.42),
        transparent
      );
    transform: rotate(18deg);
    animation: tjsAppAtcShine 4.4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes tjsAppAtcShine {
    0%, 48% {
      left: -55%;
      opacity: 0;
    }

    60% {
      opacity: 1;
    }

    84%, 100% {
      left: 130%;
      opacity: 0;
    }
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 18px 36px rgba(47,36,32,.25);
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button:disabled {
    cursor: not-allowed;
    opacity: .48;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button.is-loading {
    opacity: .72;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button-inner {
    position: relative;
    z-index: 2;
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 17px;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button-text {
    font-size: 14px;
    font-weight: 850;
    line-height: 1;
    letter-spacing: .3px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__button-icon {
    width: 23px;
    height: 23px;
    display: inline-grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(255,255,255,.13);
    color: #ffe2a4;
    font-size: 15px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__wishlist {
    position: relative;
    min-height: 56px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(47,36,32,.14);
    border-radius: 17px;
    background: #fff;
    color: #241c19;
    box-shadow: 0 10px 22px rgba(47,36,32,.07);
    transition:
      transform .22s ease,
      border-color .22s ease,
      background .22s ease,
      color .22s ease;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__wishlist:hover {
    transform: translateY(-1px);
    border-color: rgba(47,36,32,.32);
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__wishlist svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    transition: fill .22s ease, transform .22s ease;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__wishlist.is-active {
    border-color: rgba(182,78,71,.22);
    background: #fff4f1;
    color: #b64e47;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__wishlist.is-active svg {
    fill: currentColor;
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__hint {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 9px;
    color: #75645d;
    font-size: 10.8px;
    font-weight: 650;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__hint::before {
    content: "";
    width: 5px;
    height: 5px;
    flex: 0 0 5px;
    border-radius: 999px;
    background: #9a7a67;
    box-shadow: 0 0 0 4px rgba(154,122,103,.1);
  }

  #shopify-section-{{ section.id }} .tjs-atc-row__hint strong {
    color: #2f2420;
    font-weight: 800;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .tjs-app-pdp__benefit-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__benefit-item {
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 8px;
      padding-inline: 11px;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__benefit-icon {
      width: 28px;
      height: 28px;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__benefit-copy strong {
      font-size: 11px;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__benefit-copy small {
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__details-shell {
      margin-top: var(--pdp-details-gap);
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__panel[data-panel="specifications"] {
      margin-top: 24px;
      padding: 23px 15px;
      border: 0;
      border-radius: 22px;
      background: var(--pdp-specs-bg);
      box-shadow: none;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__panel[data-panel="specifications"] .tjs-app-pdp__panel-heading {
      margin-bottom: 18px;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__buy-row {
      display: block;
    }

    #shopify-section-{{ section.id }} .tjs-atc-row {
      width: 100%;
      margin-top: 18px;
    }

    #shopify-section-{{ section.id }} .tjs-atc-row__wrap {
      grid-template-columns: minmax(0, 1fr) 50px;
      gap: 9px;
    }

    #shopify-section-{{ section.id }} .tjs-atc-row__wrap.is-single {
      grid-template-columns: minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .tjs-atc-row__button,
    #shopify-section-{{ section.id }} .tjs-atc-row__wishlist {
      min-height: 52px;
      border-radius: 16px;
    }

    #shopify-section-{{ section.id }} .tjs-atc-row__button::before {
      border-radius: 15px;
    }

    #shopify-section-{{ section.id }} .tjs-atc-row__button-inner {
      min-height: 52px;
      padding: 0 14px;
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .tjs-atc-row__button-text {
      font-size: 13px;
      letter-spacing: .24px;
    }

    #shopify-section-{{ section.id }} .tjs-atc-row__button-icon {
      width: 21px;
      height: 21px;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .tjs-atc-row__wishlist svg {
      width: 20px;
      height: 20px;
    }

    #shopify-section-{{ section.id }} .tjs-atc-row__hint {
      margin-top: 8px;
      font-size: 10.3px;
    }
  }


  /* =====================================================
     V4.1 — PRODUCT INFORMATION HEADING / FLOW FIX
  ===================================================== */

  #shopify-section-{{ section.id }} .tjs-app-pdp__panel-heading {
    font-family: var(--pdp-heading-font);
    color: var(--pdp-text);
  }

  @media screen and (max-width: 749px) {
    /*
      The purchase card uses a negative top margin to overlap the image.
      Give it a genuine bottom margin so the next white screen starts
      after the full visible card rather than underneath it.
    */
    #shopify-section-{{ section.id }} .tjs-app-pdp__purchase {
      margin-bottom: var(--pdp-details-gap) !important;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__details-shell {
      position: relative !important;
      z-index: 20 !important;
      isolation: isolate;
      margin-top: 0 !important;
      padding-top: 32px !important;
      overflow: visible !important;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__panel[data-panel="description"] {
      position: relative !important;
      z-index: 2 !important;
      display: block !important;
      padding-top: 0 !important;
      overflow: visible !important;
    }

    /*
      Do not let global theme H1/H2 reveal effects, masks, clipping,
      line wrappers, or transforms affect these section headings.
    */
    #shopify-section-{{ section.id }} .tjs-app-pdp__panel-heading {
      position: static !important;
      inset: auto !important;
      display: block !important;
      width: 100% !important;
      max-width: none !important;
      height: auto !important;
      min-height: 30px !important;
      margin: 0 0 18px !important;
      padding: 0 !important;
      overflow: visible !important;
      clip: auto !important;
      clip-path: none !important;
      mask: none !important;
      -webkit-mask: none !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      translate: none !important;
      filter: none !important;
      color: var(--pdp-text) !important;
      background: none !important;
      -webkit-text-fill-color: currentColor !important;
      font-family: var(--pdp-heading-font) !important;
      font-size: 26px !important;
      font-weight: 650 !important;
      line-height: 1.08 !important;
      letter-spacing: -.035em !important;
      text-indent: 0 !important;
      white-space: normal !important;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__description {
      position: relative;
      z-index: 1;
      margin-top: 0 !important;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__panel[data-panel="specifications"] {
      margin-top: 30px !important;
    }

    #shopify-section-{{ section.id }} .tjs-app-pdp__panel[data-panel="reviews"] {
      margin-top: 30px;
    }
  }

{% endstyle %}

<tjs-app-pdp-v4
  id="TjsAppPdp-{{ section.id }}"
  class="tjs-app-pdp"
  data-heading-font="{{ section.settings.heading_font_style }}"
  data-body-font="{{ section.settings.body_font_style }}"
  data-title-effect="{{ section.settings.title_effect }}"
  data-product-id="{{ product.id }}"
  data-mode="{{ pdp_mode }}"
  data-recommendations-url="{{ routes.product_recommendations_url }}"
  data-related-limit="{{ section.settings.related_limit }}"
  data-money-format="{{ shop.money_format | replace: '&amp;', '&' | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | replace: '&amp;', '&' | escape }}"
  data-open-cart="{{ section.settings.open_cart_drawer }}"
  data-low-stock-threshold="{{ section.settings.low_stock_threshold }}"
  data-savings-mode="{{ section.settings.savings_mode }}"
  data-add-label="{{ section.settings.add_button_label | replace: '&amp;', '&' | escape }}"
>
  <script type="application/json" data-variant-data>
    [
      {% assign has_variant_json = false %}
      {% for variant in product.variants %}
        {% if has_variant_json %},{% endif %}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price | json }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_policy": {{ variant.inventory_policy | json }},
          "inventory_quantity": {{ variant.inventory_quantity | json }},
          "featured_media_id": {% if variant.featured_media != blank %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}
        }
        {% assign has_variant_json = true %}
      {% endfor %}
    ]
  </script>
  <script type="application/json" data-selected-options>{{ selected_variant.options | json }}</script>
  <script type="application/json" data-legacy-spec-text>{{ legacy_spec_text | json }}</script>

  <div class="tjs-app-pdp__inner">
    <div class="tjs-app-pdp__hero">
      <div class="tjs-app-pdp__media-column">
        <div class="tjs-app-pdp__gallery">
          {% if section.settings.show_thumbnails and product.media.size > 1 %}
            <div class="tjs-app-pdp__thumbs" data-thumbs>
              {% for media in product.media %}
                {% assign thumb_active = false %}
                {% if selected_variant.featured_media != blank %}
                  {% if media.id == selected_variant.featured_media.id %}
                    {% assign thumb_active = true %}
                  {% endif %}
                {% elsif forloop.first %}
                  {% assign thumb_active = true %}
                {% endif %}

                <button
                  type="button"
                  class="tjs-app-pdp__thumb{% if thumb_active %} is-active{% endif %}"
                  data-thumb
                  data-index="{{ forloop.index0 }}"
                  data-media-id="{{ media.id }}"
                  aria-label="View product media {{ forloop.index }}"
                >
                  {% if media.preview_image != blank %}
                    {% assign thumb_alt = media.preview_image.alt | default: product.title %}
                    {{ media.preview_image
                      | image_url: width: 180
                      | image_tag:
                        widths: '72,100,140,180',
                        sizes: '72px',
                        loading: 'lazy',
                        alt: thumb_alt
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                </button>
              {% endfor %}
            </div>
          {% endif %}

          <div class="tjs-app-pdp__stage" data-stage>
            <div class="tjs-app-pdp__mobile-controls">
                <button type="button" class="tjs-app-pdp__mobile-control" data-mobile-back aria-label="Go back">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14.5 6-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button" class="tjs-app-pdp__mobile-control" data-mobile-share aria-label="Share product">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="18" cy="5" r="2.4" stroke="currentColor" stroke-width="1.5"/><circle cx="6" cy="12" r="2.4" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="19" r="2.4" stroke="currentColor" stroke-width="1.5"/><path d="m8.1 10.8 7.7-4.5M8.1 13.2l7.7 4.5" stroke="currentColor" stroke-width="1.5"/></svg>
                </button>
              </div>

            <div class="tjs-app-pdp__slides" data-slides>
              {% if product.media.size > 0 %}
                {% for media in product.media %}
                  {% assign media_active = false %}
                  {% if selected_variant.featured_media != blank %}
                    {% if media.id == selected_variant.featured_media.id %}{% assign media_active = true %}{% endif %}
                  {% elsif forloop.first %}
                    {% assign media_active = true %}
                  {% endif %}

                  {% assign media_orientation = 'portrait' %}
                  {% if media.media_type == 'image' %}
                    {% if media.aspect_ratio > 1.08 %}
                      {% assign media_orientation = 'landscape' %}
                    {% elsif media.aspect_ratio > 0.92 %}
                      {% assign media_orientation = 'square' %}
                    {% endif %}
                  {% endif %}

                  <div
                    class="tjs-app-pdp__slide{% if media_active %} is-active{% endif %}"
                    data-slide
                    data-index="{{ forloop.index0 }}"
                    data-media-id="{{ media.id }}"
                    data-orientation="{{ media_orientation }}"
                  >
                    {% case media.media_type %}
                      {% when 'image' %}
                        {% assign image_alt = media.alt | default: product.title %}
                        {% assign zoom_url = media | image_url: width: 2200 %}
                        {% if section.settings.enable_zoom %}
                          <button type="button" class="tjs-app-pdp__media-button" data-zoom data-zoom-src="{{ zoom_url }}" aria-label="Zoom {{ image_alt | replace: '&amp;', '&' | escape }}">
                        {% else %}
                          <div class="tjs-app-pdp__media-frame">
                        {% endif %}

                        {{ media
                          | image_url: width: 1600
                          | image_tag:
                            class: 'tjs-app-pdp__image',
                            widths: '360,480,620,760,900,1100,1300,1600',
                            sizes: '(max-width: 749px) 100vw, (max-width: 989px) 92vw, 58vw',
                            loading: 'lazy',
                            decoding: 'async',
                            alt: image_alt
                        }}

                        {% if section.settings.enable_zoom %}</button>{% else %}</div>{% endif %}
                      {% when 'video' %}
                        <div class="tjs-app-pdp__media-frame">{{ media | video_tag: controls: true, preload: 'metadata', image_size: '1200x' }}</div>
                      {% when 'external_video' %}
                        <div class="tjs-app-pdp__media-frame">{{ media | external_video_tag }}</div>
                      {% when 'model' %}
                        <div class="tjs-app-pdp__media-frame">{{ media | model_viewer_tag }}</div>
                    {% endcase %}
                  </div>
                {% endfor %}
              {% else %}
                <div class="tjs-app-pdp__slide is-active" data-slide data-index="0">{{ 'product-1' | placeholder_svg_tag: 'tjs-app-pdp__image' }}</div>
              {% endif %}
            </div>

            {% if product.media.size > 1 %}
              <div class="tjs-app-pdp__counter"><b data-current-index>1</b><span>/</span><span>{{ product.media.size }}</span></div>
            {% endif %}

            <button type="button" class="tjs-app-pdp__swipe-cue" data-scroll-to-card><span>{{ section.settings.swipe_cue_text | replace: '&amp;', '&' | escape }}</span></button>
          </div>
        </div>
      </div>

      <section class="tjs-app-pdp__purchase" data-purchase-card aria-labelledby="TjsAppPdpTitle-{{ section.id }}">
        <div class="tjs-app-pdp__headline">
          <div class="tjs-app-pdp__headline-copy">
            <p class="tjs-app-pdp__type">{{ mode_label | replace: '&amp;', '&' | escape }}</p>
            <h1 id="TjsAppPdpTitle-{{ section.id }}" class="tjs-app-pdp__title">{{ product.title | replace: '&amp;', '&' | escape }}</h1>

            {% if section.settings.show_real_reviews and review_rating != blank %}
              <div class="tjs-app-pdp__reviews-summary tjs-app-pdp__reviews-summary--headline">
                <span class="tjs-app-pdp__stars" aria-hidden="true">★★★★★</span>
                <strong>{{ review_rating }}</strong>
                {% if review_count != blank %}
                  <span>{{ review_count }} reviews</span>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <div class="tjs-app-pdp__headline-price">
            <div class="tjs-app-pdp__price-row">
              <strong class="tjs-app-pdp__price" data-price>{{ selling_price | money }}</strong>
              <s class="tjs-app-pdp__compare" data-compare{% unless on_sale %} hidden{% endunless %}>{% if on_sale %}{{ compare_price | money }}{% endif %}</s>
            </div>

            {% if section.settings.show_savings %}
              <span class="tjs-app-pdp__saving" data-saving{% unless on_sale %} hidden{% endunless %}>
                {% case section.settings.savings_mode %}
                  {% when 'percentage' %}
                    {{ saving_percent }}% off
                  {% when 'both' %}
                    Save {{ saving_amount | money_without_trailing_zeros }} · {{ saving_percent }}%
                  {% else %}
                    Save {{ saving_amount | money_without_trailing_zeros }}
                {% endcase %}
              </span>
            {% endif %}
          </div>
        </div>

        <div class="tjs-app-pdp__benefit-strip" aria-label="Product highlights">
          <div class="tjs-app-pdp__benefit-item">
            <span class="tjs-app-pdp__benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 20s6-4 6-9.1A3.9 3.9 0 0 0 12 7.7a3.9 3.9 0 0 0-6 3.2C6 16 12 20 12 20Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </span>

            <span class="tjs-app-pdp__benefit-copy">
              <strong>{{ designed_for_value | replace: '&amp;', '&' | escape }}</strong>
              <small>Designed for</small>
            </span>
          </div>

          <div class="tjs-app-pdp__benefit-item">
            <span class="tjs-app-pdp__benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M3.5 7.5h11v9h-11zM14.5 10h3.2l2.8 3v3.5h-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <circle cx="7" cy="18" r="1.7" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="17.5" cy="18" r="1.7" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </span>

            <span class="tjs-app-pdp__benefit-copy">
              <strong>{{ section.settings.dispatch_promise | default: 'Dispatches in 24 Hours' | escape }}</strong>
              <small>{{ section.settings.delivery_promise | default: 'Delivery 2–4 days' | escape }}</small>
            </span>
          </div>
        </div>

        {% if short_description != blank %}
          <div class="tjs-app-pdp__description-preview" data-description-preview>
            <p>{{ short_description | replace: '&amp;', '&' | escape }}</p>
            <button type="button" data-description-toggle aria-expanded="false">Read more</button>
          </div>
        {% endif %}

        <p class="tjs-app-pdp__tax">Inclusive of applicable taxes.</p>

        {% if section.settings.show_stock %}
          <span class="tjs-app-pdp__stock{% if low_stock %} is-low{% endif %}{% unless selected_variant.available %} is-sold-out{% endunless %}" data-stock>
            {% if selected_variant.available %}
              {% if low_stock %}
                Only {{ selected_variant.inventory_quantity }} left
              {% else %}
                In stock
              {% endif %}
            {% else %}
              Sold out
            {% endif %}
          </span>
        {% endif %}

        <form id="{{ form_id }}" class="tjs-app-pdp__form" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-product-form>
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>

          {% unless product.has_only_default_variant %}
            <div class="tjs-app-pdp__options">
              {% for option in product.options_with_values %}
                {% assign option_index = forloop.index0 %}
                {% assign selected_value = selected_variant.options[option_index] %}
                {% assign option_downcase = option.name | downcase %}
                {% assign colour_option = false %}
                {% if option_downcase contains 'color' or option_downcase contains 'colour' or option_downcase contains 'shade' or option_downcase contains 'finish' %}{% assign colour_option = true %}{% endif %}

                <div class="tjs-app-pdp__option" data-option-group data-option-index="{{ option_index }}">
                  <div class="tjs-app-pdp__option-head"><strong>{{ option.name | replace: '&amp;', '&' | escape }}</strong><span data-option-selected>{{ selected_value | replace: '&amp;', '&' | escape }}</span></div>

                  {% if section.settings.variant_style == 'dropdown' %}
                    <select class="tjs-app-pdp__select" data-option-select data-option-index="{{ option_index }}">
                      {% for value in option.values %}
                        {% assign option_value_text = value.name | default: value %}
                        <option value="{{ option_value_text | replace: '&amp;', '&' | escape }}" {% if option_value_text == selected_value %}selected{% endif %}>{{ option_value_text | replace: '&amp;', '&' | escape }}</option>
                      {% endfor %}
                    </select>
                  {% else %}
                    <div class="tjs-app-pdp__values">
                      {% for value in option.values %}
                        {% assign option_value_text = value.name | default: value %}
                        <button
                          type="button"
                          class="tjs-app-pdp__value{% if option_value_text == selected_value %} is-active{% endif %}"
                          data-option-index="{{ option_index }}"
                          data-option-value="{{ option_value_text | replace: '&amp;', '&' | escape }}"
                          aria-pressed="{% if option_value_text == selected_value %}true{% else %}false{% endif %}"
                        >
                          {% if section.settings.variant_style == 'smart' and colour_option %}
                            <span
                              class="tjs-app-pdp__swatch"
                              data-swatch
                              data-swatch-name="{{ option_value_text | replace: '&amp;', '&' | escape }}"
                              {% if value.swatch.image != blank %}style="--swatch-image:url('{{ value.swatch.image | image_url: width: 48 }}');"{% elsif value.swatch.color != blank %}style="--swatch:{{ value.swatch.color }};"{% endif %}
                              aria-hidden="true"
                            ></span>
                          {% endif %}
                          <span>{{ option_value_text | replace: '&amp;', '&' | escape }}</span>
                        </button>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="tjs-app-pdp__buy-row">
            {% if section.settings.show_quantity %}
              <div class="tjs-app-pdp__quantity">
                <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
                <input type="number" name="quantity" min="1" value="1" inputmode="numeric" data-quantity aria-label="Quantity">
                <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
              </div>
            {% else %}
              <input type="hidden" name="quantity" value="1">
            {% endif %}

            <div class="tjs-atc-row" data-tjs-atc-row>
              <div class="tjs-atc-row__wrap{% unless section.settings.show_wishlist %} is-single{% endunless %}">
                <button
                  type="submit"
                  name="add"
                  class="tjs-atc-row__button"
                  data-add
                  {% unless selected_variant.available %}disabled{% endunless %}
                >
                  <span class="tjs-atc-row__button-inner">
                    <span class="tjs-atc-row__button-text" data-add-label>
                      {% if selected_variant.available %}
                        {{ section.settings.add_button_label | replace: '&amp;', '&' | escape }}
                      {% else %}
                        Sold out
                      {% endif %}
                    </span>

                    <span class="tjs-atc-row__button-icon" aria-hidden="true">→</span>
                  </span>
                </button>

                {% if section.settings.show_wishlist %}
                  <button
                    type="button"
                    class="tjs-atc-row__wishlist"
                    data-custom-wishlist
                    aria-label="Add to wishlist"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M20.8 4.6c-1.8-1.7-4.6-1.6-6.3.2L12 7.4 9.5 4.8C7.8 3 5 2.9 3.2 4.6 1.4 6.4 1.3 9.2 3 11l9 9 9-9c1.7-1.8 1.6-4.6-.2-6.4z"></path>
                    </svg>
                  </button>
                {% endif %}
              </div>

              <div class="tjs-atc-row__hint">
                Add now to unlock <strong>free shipping</strong>
              </div>
            </div>
          </div>
        </form>
      </section>
    </div>

    <section class="tjs-app-pdp__details-shell" data-details-shell>
      <nav class="tjs-app-pdp__tabs" role="tablist" aria-label="Product information">
        {% if section.settings.show_description and clean_description != blank %}
          <button type="button" class="tjs-app-pdp__tab is-active" role="tab" aria-selected="true" data-tab="description">Description</button>
        {% endif %}

        {% if section.settings.show_specs %}
          <button type="button" class="tjs-app-pdp__tab{% unless section.settings.show_description and clean_description != blank %} is-active{% endunless %}" role="tab" aria-selected="{% unless section.settings.show_description and clean_description != blank %}true{% else %}false{% endunless %}" data-tab="specifications" data-spec-tab>Specifications</button>
        {% endif %}

        {% if section.settings.show_reviews and review_rating != blank or section.settings.show_reviews and app_block_count > 0 %}
          <button type="button" class="tjs-app-pdp__tab" role="tab" aria-selected="false" data-tab="reviews">Reviews</button>
        {% endif %}
      </nav>

      {% if section.settings.show_description and clean_description != blank %}
        <div class="tjs-app-pdp__panel is-active" data-panel="description">
                    <div class="tjs-app-pdp__panel-heading" role="heading" aria-level="2">About this product</div>
<div class="tjs-app-pdp__description"><p>{{ clean_description | replace: '&amp;', '&' | escape }}</p></div>

          {% if whats_in_box_meta != blank %}
            <ul class="tjs-app-pdp__features"><li><strong>What's included:</strong> {{ whats_in_box_meta.value | newline_to_br }}</li></ul>
          {% endif %}

          {% if care_meta != blank %}
            <ul class="tjs-app-pdp__features"><li><strong>Care:</strong> {{ care_meta.value | newline_to_br }}</li></ul>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_specs %}
        <div class="tjs-app-pdp__panel{% unless section.settings.show_description and clean_description != blank %} is-active{% endunless %}" data-panel="specifications" data-spec-panel>
                    <div class="tjs-app-pdp__panel-heading" role="heading" aria-level="2">Specifications</div>
<div class="tjs-app-pdp__spec-grid" data-spec-grid>
            {% case pdp_mode %}
              {% when 'tableware' %}
                {% if material_meta != blank %}<div class="tjs-app-pdp__spec"><small>Material</small><strong>{{ material_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if capacity_meta != blank %}<div class="tjs-app-pdp__spec"><small>Capacity</small><strong>{{ capacity_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if set_size_meta != blank %}<div class="tjs-app-pdp__spec"><small>Set size</small><strong>{{ set_size_meta.value }} piece{% if set_size_meta.value != 1 %}s{% endif %}</strong></div>{% endif %}
                {% if dimensions_meta != blank %}<div class="tjs-app-pdp__spec"><small>Dimensions</small><strong>{{ dimensions_meta.value | newline_to_br }}</strong></div>{% endif %}
                {% if primary_use_meta != blank %}<div class="tjs-app-pdp__spec"><small>Designed for</small><strong>{{ primary_use_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if occasion_meta != blank %}<div class="tjs-app-pdp__spec"><small>Occasion</small><strong>{{ occasion_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}

              {% when 'utility' %}
                {% if material_meta != blank %}<div class="tjs-app-pdp__spec"><small>Material</small><strong>{{ material_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if capacity_meta != blank %}<div class="tjs-app-pdp__spec"><small>Capacity</small><strong>{{ capacity_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% elsif capacity_range_meta != blank %}<div class="tjs-app-pdp__spec"><small>Capacity</small><strong>{{ capacity_range_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if compartment_meta != blank %}<div class="tjs-app-pdp__spec"><small>Compartments</small><strong>{{ compartment_meta.value }}</strong></div>{% endif %}
                {% if insulated_meta != blank %}<div class="tjs-app-pdp__spec"><small>Insulated</small><strong>{% if insulated_meta.value %}Yes{% else %}No{% endif %}</strong></div>{% endif %}
                {% if dimensions_meta != blank %}<div class="tjs-app-pdp__spec"><small>Dimensions</small><strong>{{ dimensions_meta.value | newline_to_br }}</strong></div>{% endif %}
                {% if intended_contents_meta != blank %}<div class="tjs-app-pdp__spec"><small>Best for</small><strong>{{ intended_contents_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}

              {% when 'planner' %}
                {% if planner_type_meta != blank %}<div class="tjs-app-pdp__spec"><small>Planner type</small><strong>{{ planner_type_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if dated_status_meta != blank %}<div class="tjs-app-pdp__spec"><small>Dated status</small><strong>{{ dated_status_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if planner_year_meta != blank %}<div class="tjs-app-pdp__spec"><small>Year</small><strong>{{ planner_year_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if planner_size_meta != blank %}<div class="tjs-app-pdp__spec"><small>Size</small><strong>{{ planner_size_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if page_count_meta != blank %}<div class="tjs-app-pdp__spec"><small>Pages</small><strong>{{ page_count_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if binding_meta != blank %}<div class="tjs-app-pdp__spec"><small>Binding</small><strong>{{ binding_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if personalisation_meta != blank %}<div class="tjs-app-pdp__spec"><small>Personalisation</small><strong>{% if personalisation_meta.value %}Available{% else %}Not available{% endif %}</strong></div>{% endif %}

              {% when 'eyewear' %}
                {% if frame_shape_meta != blank %}<div class="tjs-app-pdp__spec"><small>Frame shape</small><strong>{{ frame_shape_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if frame_colour_meta != blank %}<div class="tjs-app-pdp__spec"><small>Frame colour</small><strong>{{ frame_colour_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if lens_colour_meta != blank %}<div class="tjs-app-pdp__spec"><small>Lens colour</small><strong>{{ lens_colour_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if fit_meta != blank %}<div class="tjs-app-pdp__spec"><small>Fit</small><strong>{{ fit_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if intended_wearer_meta != blank %}<div class="tjs-app-pdp__spec"><small>Intended for</small><strong>{{ intended_wearer_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if material_meta != blank %}<div class="tjs-app-pdp__spec"><small>Material</small><strong>{{ material_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}

              {% when 'decor' %}
                {% if material_meta != blank %}<div class="tjs-app-pdp__spec"><small>Material</small><strong>{{ material_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if dimensions_meta != blank %}<div class="tjs-app-pdp__spec"><small>Dimensions</small><strong>{{ dimensions_meta.value | newline_to_br }}</strong></div>{% endif %}
                {% if room_meta != blank %}<div class="tjs-app-pdp__spec"><small>Room / space</small><strong>{{ room_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if power_source_meta != blank %}<div class="tjs-app-pdp__spec"><small>Power source</small><strong>{{ power_source_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if light_source_meta != blank %}<div class="tjs-app-pdp__spec"><small>Light source</small><strong>{{ light_source_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if control_type_meta != blank %}<div class="tjs-app-pdp__spec"><small>Controls</small><strong>{{ control_type_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if assembly_meta != blank %}<div class="tjs-app-pdp__spec"><small>Assembly</small><strong>{% if assembly_meta.value %}Required{% else %}Not required{% endif %}</strong></div>{% endif %}

              {% when 'baby' %}
                {% if material_meta != blank %}<div class="tjs-app-pdp__spec"><small>Material</small><strong>{{ material_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if dimensions_meta != blank %}<div class="tjs-app-pdp__spec"><small>Dimensions</small><strong>{{ dimensions_meta.value | newline_to_br }}</strong></div>{% endif %}
                {% if intended_wearer_meta != blank %}<div class="tjs-app-pdp__spec"><small>Intended for</small><strong>{{ intended_wearer_meta.value | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if intended_contents_meta != blank %}<div class="tjs-app-pdp__spec"><small>Best for</small><strong>{{ intended_contents_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% elsif primary_use_meta != blank %}<div class="tjs-app-pdp__spec"><small>Designed for</small><strong>{{ primary_use_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}

              {% else %}
                {% if material_meta != blank %}<div class="tjs-app-pdp__spec"><small>Material</small><strong>{{ material_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if dimensions_meta != blank %}<div class="tjs-app-pdp__spec"><small>Dimensions</small><strong>{{ dimensions_meta.value | newline_to_br }}</strong></div>{% endif %}
                {% if primary_use_meta != blank %}<div class="tjs-app-pdp__spec"><small>Designed for</small><strong>{{ primary_use_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
                {% if room_meta != blank %}<div class="tjs-app-pdp__spec"><small>Room / space</small><strong>{{ room_meta.value | join: ', ' | replace: '&amp;', '&' | escape }}</strong></div>{% endif %}
            {% endcase %}

            {% for block in section.blocks %}
              {% if block.type == 'spec' %}
                {% if block.settings.mode == 'all' or block.settings.mode == pdp_mode %}
                  <div class="tjs-app-pdp__spec" {{ block.shopify_attributes }}><small>{{ block.settings.label | replace: '&amp;', '&' | escape }}</small><strong>{{ block.settings.value | replace: '&amp;', '&' | escape }}</strong></div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>

          {% if key_features_meta != blank %}
            <ul class="tjs-app-pdp__features">
              {% if key_features_meta.type contains 'list.' %}
                {% for feature in key_features_meta.value %}<li>{{ feature | replace: '&amp;', '&' | escape }}</li>{% endfor %}
              {% else %}
                <li>{{ key_features_meta.value | replace: '&amp;', '&' | escape }}</li>
              {% endif %}
            </ul>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_reviews and review_rating != blank or section.settings.show_reviews and app_block_count > 0 %}
        <div class="tjs-app-pdp__panel" data-panel="reviews">
                    <div class="tjs-app-pdp__panel-heading" role="heading" aria-level="2">Customer reviews</div>
{% if review_rating != blank %}
            <div class="tjs-app-pdp__review-summary">
              <strong class="tjs-app-pdp__review-score">{{ review_rating }}</strong>
              <div class="tjs-app-pdp__review-copy"><span class="tjs-app-pdp__stars" aria-hidden="true">★★★★★</span>{% if review_count != blank %}<span>Based on {{ review_count }} product reviews</span>{% else %}<span>Verified product rating</span>{% endif %}</div>
            </div>
          {% endif %}

          {% for block in section.blocks %}
            {% if block.type == '@app' %}{% render block %}{% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.show_related %}
        <div class="tjs-app-pdp__related" data-related hidden>
          <div class="tjs-app-pdp__related-head"><h2>{{ section.settings.related_heading | replace: '&amp;', '&' | escape }}</h2><span>Picked to complement this product</span></div>
          <div class="tjs-app-pdp__related-grid" data-related-grid></div>
        </div>
      {% endif %}
    </section>
  </div>

  {% if section.settings.enable_zoom %}
    <div class="tjs-app-pdp__zoom" data-zoom-modal hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Product image zoom">
      <div class="tjs-app-pdp__zoom-head"><button type="button" class="tjs-app-pdp__zoom-close" data-zoom-close aria-label="Close zoom">×</button></div>
      <img class="tjs-app-pdp__zoom-image" data-zoom-image alt="">
    </div>
  {% endif %}

  <div class="tjs-app-pdp__toast" data-toast role="status" aria-live="polite"></div>
</tjs-app-pdp-v4>

<script>
  (() => {
    if (customElements.get('tjs-app-pdp-v4')) return;

    class TjsAppPdp extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready === 'true') return;
        this.dataset.ready = 'true';

        this.form = this.querySelector('[data-product-form]');
        this.variantInput = this.querySelector('[data-variant-id]');
        this.priceNode = this.querySelector('[data-price]');
        this.compareNode = this.querySelector('[data-compare]');
        this.savingNode = this.querySelector('[data-saving]');
        this.stockNode = this.querySelector('[data-stock]');
        this.addButton = this.querySelector('[data-add]');
        this.addLabel = this.querySelector('[data-add-label]');
        this.quantityInput = this.querySelector('[data-quantity]');
        this.wishlistButton = this.querySelector('[data-custom-wishlist]');
        this.purchaseCard = this.querySelector('[data-purchase-card]');
        this.slidesRoot = this.querySelector('[data-slides]');
        this.slides = [...this.querySelectorAll('[data-slide]')];
        this.thumbs = [...this.querySelectorAll('[data-thumb]')];
        this.counter = this.querySelector('[data-current-index]');
        this.toast = this.querySelector('[data-toast]');
        this.zoomModal = this.querySelector('[data-zoom-modal]');
        this.zoomImage = this.querySelector('[data-zoom-image]');
        this.specPanel = this.querySelector('[data-spec-panel]');
        this.specGrid = this.querySelector('[data-spec-grid]');
        this.specTab = this.querySelector('[data-spec-tab]');
        this.related = this.querySelector('[data-related]');
        this.relatedGrid = this.querySelector('[data-related-grid]');
        this.openCart = this.dataset.openCart === 'true';
        this.lowStockThreshold = Number(this.dataset.lowStockThreshold || 5);
        this.currency = this.dataset.currency || 'INR';
        this.moneyFormat = this.dataset.moneyFormat || '${{amount}}';
        this.savingsMode = this.dataset.savingsMode || 'amount';
        this.defaultAddLabel = this.dataset.addLabel || 'Add to cart';

        try {
          this.variants = JSON.parse(this.querySelector('[data-variant-data]')?.textContent || '[]');
        } catch (error) {
          this.variants = [];
        }

        try {
          this.selectedOptions = JSON.parse(this.querySelector('[data-selected-options]')?.textContent || '[]');
        } catch (error) {
          this.selectedOptions = [];
        }

        try {
          this.legacySpecText = JSON.parse(this.querySelector('[data-legacy-spec-text]')?.textContent || '""') || '';
        } catch (error) {
          this.legacySpecText = '';
        }

        this.setupSwatches();
        this.setupVariants();
        this.setupQuantity();
        this.setupGallery();
        this.setupScrollCue();
        this.setupMobileControls();
        this.setupTabs();
        this.setupSpecs();
        this.setupDescriptionPreview();
        this.setupZoom();
        this.setupWishlist();
        this.setupForm();
        this.loadRelatedProducts();

        const initial = this.variants.find(variant => Number(variant.id) === Number(this.variantInput?.value));
        if (initial) this.updateVariant(initial, false);
      }


      setupSwatches() {
        this.querySelectorAll('[data-swatch]').forEach(swatch => {
          if (swatch.style.getPropertyValue('--swatch') || swatch.style.getPropertyValue('--swatch-image')) return;
          const colour = this.resolveColour(swatch.dataset.swatchName || '');
          if (colour.includes('gradient(')) swatch.style.setProperty('--swatch-image', colour);
          else swatch.style.setProperty('--swatch', colour);
        });
      }

      resolveColour(value) {
        const key = String(value || '').toLowerCase().replace(/[_-]+/g, ' ').trim();
        const gradients = [
          [/multi|rainbow|assorted/, 'conic-gradient(#e15b64,#f3c969,#58a66c,#4aa7c8,#7b61a8,#e15b64)'],
          [/black.*gold|gold.*black/, 'linear-gradient(135deg,#151515 0 50%,#d4af37 50% 100%)'],
          [/white.*gold|gold.*white/, 'linear-gradient(135deg,#fff 0 50%,#d4af37 50% 100%)'],
          [/clear|transparent/, 'linear-gradient(135deg,#fff 0 44%,#d8d8d8 45% 55%,#fff 56% 100%)']
        ];
        const gradient = gradients.find(([pattern]) => pattern.test(key));
        if (gradient) return gradient[1];
        const colours = [
          [/rose gold/, '#b76e79'], [/navy/, '#1f3155'], [/sky blue/, '#87ceeb'], [/royal blue/, '#3157a4'],
          [/turquoise|cyan/, '#35b6b4'], [/teal/, '#267a78'], [/blue/, '#3f6fb5'], [/lavender/, '#b7a1d6'],
          [/lilac/, '#c8a2c8'], [/violet|purple/, '#7e57a2'], [/magenta/, '#c13a8d'], [/burgundy|wine/, '#722f37'],
          [/maroon/, '#800000'], [/coral/, '#f07f73'], [/peach/, '#f6b58d'], [/rose|pink/, '#f2a7c2'],
          [/red/, '#c53b38'], [/mustard/, '#d4a017'], [/orange/, '#e87822'], [/yellow/, '#f2cf3a'],
          [/sage/, '#a8b89a'], [/mint/, '#a8e6cf'], [/olive/, '#7c833a'], [/green/, '#3f7d4a'],
          [/camel|tan/, '#c19a6b'], [/khaki/, '#bdb76b'], [/brown/, '#7a4e2d'], [/beige/, '#d8c3a5'],
          [/cream/, '#fff3d6'], [/ivory/, '#fff8e7'], [/silver/, '#c0c0c0'], [/gold/, '#d4af37'],
          [/charcoal/, '#4a4a4a'], [/grey|gray/, '#9a9a9a'], [/white/, '#fff'], [/black/, '#161616']
        ];
        return colours.find(([pattern]) => pattern.test(key))?.[1] || '#d9d5cf';
      }

      setupVariants() {
        this.addEventListener('click', event => {
          const button = event.target.closest('[data-option-value]');
          if (!button || button.disabled) return;
          const index = Number(button.dataset.optionIndex);
          const value = button.dataset.optionValue;
          this.selectedOptions[index] = value;
          this.selectBestVariant(index, value);
        });

        this.addEventListener('change', event => {
          const select = event.target.closest('[data-option-select]');
          if (!select) return;
          const index = Number(select.dataset.optionIndex);
          this.selectedOptions[index] = select.value;
          this.selectBestVariant(index, select.value);
        });
      }

      selectBestVariant(changedIndex, changedValue) {
        let variant = this.variants.find(candidate => candidate.available && candidate.options.every((value, index) => value === this.selectedOptions[index]));

        if (!variant) {
          const ranked = this.variants
            .filter(candidate => candidate.available && candidate.options[changedIndex] === changedValue)
            .map(candidate => ({
              variant: candidate,
              score: candidate.options.reduce((score, value, index) => {
                if (index === changedIndex) return score;
                return score + (value === this.selectedOptions[index] ? 1 : 0);
              }, 0)
            }))
            .sort((a, b) => b.score - a.score);
          variant = ranked[0]?.variant;
        }

        if (!variant) variant = this.variants.find(candidate => candidate.options[changedIndex] === changedValue);
        if (variant) this.updateVariant(variant, true);
      }

      updateVariant(variant, updateUrl = true) {
        this.selectedOptions = [...variant.options];
        if (this.variantInput) this.variantInput.value = variant.id;

        this.querySelectorAll('[data-option-group]').forEach(group => {
          const groupIndex = Number(group.dataset.optionIndex);
          const selected = variant.options[groupIndex];
          const selectedNode = group.querySelector('[data-option-selected]');
          if (selectedNode) selectedNode.textContent = selected || '';

          group.querySelectorAll('[data-option-value]').forEach(button => {
            const buttonIndex = Number(button.dataset.optionIndex);
            const active = button.dataset.optionValue === variant.options[buttonIndex];
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', active ? 'true' : 'false');

            const available = this.variants.some(candidate => {
              if (!candidate.available || candidate.options[buttonIndex] !== button.dataset.optionValue) return false;
              return candidate.options.every((candidateValue, index) => index === buttonIndex || candidateValue === variant.options[index]);
            });
            button.disabled = !available;
          });

          const select = group.querySelector('[data-option-select]');
          if (select) select.value = selected;
        });

        if (this.priceNode) this.priceNode.textContent = this.formatMoney(variant.price);

        const price = Number(variant.price || 0);
        const compare = Number(variant.compare_at_price || 0);
        const onSale = compare > price;

        if (this.compareNode) {
          this.compareNode.hidden = !onSale;
          this.compareNode.textContent = onSale ? this.formatMoney(compare) : '';
        }

        if (this.savingNode) {
          this.savingNode.hidden = !onSale;
          if (onSale) {
            const amount = compare - price;
            const percent = Math.round((amount * 100) / compare);
            if (this.savingsMode === 'both') this.savingNode.textContent = `Save ${this.formatMoney(amount)} · ${percent}%`;
            else if (this.savingsMode === 'percentage') this.savingNode.textContent = `${percent}% off`;
            else this.savingNode.textContent = `Save ${this.formatMoney(amount)}`;
          }
        }

        this.updateStock(variant);
        this.updateVariantMedia(variant);

        if (updateUrl && window.history?.replaceState) {
          const url = new URL(window.location.href);
          url.searchParams.set('variant', variant.id);
          window.history.replaceState({}, '', url.toString());
        }
      }

      updateStock(variant) {
        const available = Boolean(variant.available);
        if (this.addButton) {
          this.addButton.disabled = !available;
          if (this.addLabel) this.addLabel.textContent = available ? this.defaultAddLabel : 'Sold out';
        }
        if (!this.stockNode) return;
        this.stockNode.classList.remove('is-low', 'is-sold-out');
        if (!available) {
          this.stockNode.classList.add('is-sold-out');
          this.stockNode.textContent = 'Sold out';
          return;
        }
        const inventory = Number(variant.inventory_quantity || 0);
        const tracked = Boolean(variant.inventory_management);
        const deny = variant.inventory_policy === 'deny';
        if (tracked && deny && inventory > 0 && inventory <= this.lowStockThreshold) {
          this.stockNode.classList.add('is-low');
          this.stockNode.textContent = `Only ${inventory} left`;
        } else {
          this.stockNode.textContent = 'In stock';
        }
      }

      updateVariantMedia(variant) {
        const mediaId = Number(variant.featured_media_id || 0);
        if (!mediaId) return;
        const slide = this.slides.find(item => Number(item.dataset.mediaId) === mediaId);
        if (slide) this.activateMedia(Number(slide.dataset.index), true);
      }

      setupQuantity() {
        this.querySelector('[data-qty-minus]')?.addEventListener('click', () => {
          if (!this.quantityInput) return;
          this.quantityInput.value = Math.max(1, Number(this.quantityInput.value || 1) - 1);
        });
        this.querySelector('[data-qty-plus]')?.addEventListener('click', () => {
          if (!this.quantityInput) return;
          this.quantityInput.value = Math.max(1, Number(this.quantityInput.value || 1) + 1);
        });
      }

      setupGallery() {
        this.thumbs.forEach(thumb => thumb.addEventListener('click', () => this.activateMedia(Number(thumb.dataset.index), true)));
        const initial = Math.max(this.slides.findIndex(slide => slide.classList.contains('is-active')), 0);
        this.syncMedia(initial);
        if (!this.slidesRoot) return;
        let frame = null;
        this.slidesRoot.addEventListener('scroll', () => {
          if (!window.matchMedia('(max-width: 749px)').matches) return;
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const width = Math.max(this.slidesRoot.getBoundingClientRect().width, 1);
            this.syncMedia(Math.round(this.slidesRoot.scrollLeft / width));
          });
        }, { passive: true });
      }

      activateMedia(index, scroll = false) {
        index = Math.max(0, Math.min(this.slides.length - 1, index));
        this.slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === index));
        this.syncMedia(index);
        if (scroll && window.matchMedia('(max-width: 749px)').matches && this.slidesRoot) {
          const width = this.slidesRoot.getBoundingClientRect().width;
          this.slidesRoot.scrollTo({ left: width * index, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        }
      }

      syncMedia(index) {
        this.thumbs.forEach((thumb, thumbIndex) => thumb.classList.toggle('is-active', thumbIndex === index));
        if (this.counter) this.counter.textContent = String(index + 1);
      }

      setupScrollCue() {
        this.querySelector('[data-scroll-to-card]')?.addEventListener('click', () => {
          if (!this.purchaseCard) return;
          const top = this.purchaseCard.getBoundingClientRect().top + window.scrollY - 10;
          window.scrollTo({ top, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        });
      }

      setupMobileControls() {
        this.querySelector('[data-mobile-back]')?.addEventListener('click', () => {
          if (window.history.length > 1) window.history.back();
          else window.location.assign('/');
        });

        this.querySelector('[data-mobile-share]')?.addEventListener('click', async () => {
          try {
            if (navigator.share) await navigator.share({ title: document.title, url: window.location.href });
            else if (navigator.clipboard) {
              await navigator.clipboard.writeText(window.location.href);
              this.showToast('Product link copied.');
            }
          } catch (error) {}
        });
      }

      setupTabs() {
        const tabs = [...this.querySelectorAll('[data-tab]')];
        const panels = [...this.querySelectorAll('[data-panel]')];
        const activate = name => {
          tabs.forEach(tab => {
            const active = tab.dataset.tab === name;
            tab.classList.toggle('is-active', active);
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          panels.forEach(panel => panel.classList.toggle('is-active', panel.dataset.panel === name));
        };
        tabs.forEach(tab => tab.addEventListener('click', () => activate(tab.dataset.tab)));
        const activeTab = tabs.find(tab => tab.classList.contains('is-active'));
        if (activeTab) activate(activeTab.dataset.tab);
        else if (tabs[0]) activate(tabs[0].dataset.tab);
      }

      setupSpecs() {
        if (!this.specPanel || !this.specGrid) return;
        let count = this.specGrid.querySelectorAll('.tjs-app-pdp__spec').length;
        if (!count) {
          const specs = this.parseLegacySpecs(this.legacySpecText);
          specs.forEach(spec => {
            const card = document.createElement('div');
            card.className = 'tjs-app-pdp__spec tjs-app-pdp__spec--legacy';
            const label = document.createElement('small');
            label.textContent = spec.label;
            const value = document.createElement('strong');
            value.textContent = spec.value;
            card.append(label, value);
            this.specGrid.appendChild(card);
          });
          count = specs.length;
        }
        if (!count) {
          this.specPanel.remove();
          this.specTab?.remove();
          const tabs = [...this.querySelectorAll('[data-tab]')];
          if (!tabs.some(tab => tab.classList.contains('is-active')) && tabs[0]) tabs[0].click();
        }
      }

      parseLegacySpecs(text) {
        const source = String(text || '').replace(/\u00a0/g, ' ').replace(/\s+/g, ' ').trim();
        if (!source) return [];
        const specs = [];
        const seen = new Set();
        const pick = (label, aliases) => {
          for (const alias of aliases) {
            const pattern = new RegExp(`(?:^|\\||\\s)${alias}\\s*:\\s*([^|]+?)(?=\\s+(?:Material|Qty|Quantity|Length|Width|Height|Capacity|Volume|Size|Weight|Note)\\s*:|\\||$)`, 'i');
            const match = source.match(pattern);
            if (match?.[1]) {
              const value = match[1].replace(/\s+/g, ' ').replace(/[;,.\s]+$/, '').trim();
              if (value && value.length <= 90 && !seen.has(label.toLowerCase())) {
                seen.add(label.toLowerCase());
                specs.push({ label, value });
              }
              return value;
            }
          }
          return '';
        };
        pick('Material', ['Material']);
        pick('Set / quantity', ['Qty', 'Quantity']);
        pick('Capacity', ['Capacity', 'Volume']);
        pick('Weight', ['Weight']);
        const length = pick('_length', ['Length']);
        const width = pick('_width', ['Width']);
        const height = pick('_height', ['Height']);
        const size = pick('_size', ['Size']);
        const cleaned = specs.filter(spec => !spec.label.startsWith('_'));
        const dimensions = [length, width, height].filter(Boolean);
        if (dimensions.length >= 2) cleaned.push({ label: 'Dimensions', value: dimensions.join(' × ') });
        else if (size) cleaned.push({ label: 'Size', value: size });
        else if (dimensions.length === 1) cleaned.push({ label: 'Dimensions', value: dimensions[0] });
        return cleaned.slice(0, 6);
      }

      setupDescriptionPreview() {
        const wrapper = this.querySelector('[data-description-preview]');
        const button = wrapper?.querySelector('[data-description-toggle]');
        const paragraph = wrapper?.querySelector('p');

        if (!wrapper || !button || !paragraph) return;

        const syncButton = () => {
          if (wrapper.classList.contains('is-expanded')) {
            button.hidden = false;
            return;
          }

          button.hidden =
            paragraph.scrollHeight <= paragraph.clientHeight + 2;
        };

        button.addEventListener('click', () => {
          const expanded = wrapper.classList.toggle('is-expanded');

          button.textContent = expanded ? 'Read less' : 'Read more';
          button.setAttribute(
            'aria-expanded',
            expanded ? 'true' : 'false'
          );
        });

        requestAnimationFrame(syncButton);
        window.addEventListener('resize', syncButton, { passive: true });
      }

      setupZoom() {
        this.querySelectorAll('[data-zoom]').forEach(button => {
          button.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 749px)').matches || !this.zoomModal || !this.zoomImage) return;
            this.zoomImage.src = button.dataset.zoomSrc || '';
            this.zoomImage.alt = button.getAttribute('aria-label') || 'Product image';
            this.zoomModal.hidden = false;
            this.zoomModal.setAttribute('aria-hidden', 'false');
            document.documentElement.style.overflow = 'hidden';
          });
        });
        this.querySelector('[data-zoom-close]')?.addEventListener('click', () => this.closeZoom());
        this.zoomModal?.addEventListener('click', event => { if (event.target === this.zoomModal) this.closeZoom(); });
        document.addEventListener('keydown', event => { if (event.key === 'Escape' && this.zoomModal && !this.zoomModal.hidden) this.closeZoom(); });
      }

      closeZoom() {
        if (!this.zoomModal) return;
        this.zoomModal.hidden = true;
        this.zoomModal.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
      }

      setupWishlist() {
        if (!this.wishlistButton) return;

        this.wishlistButton.addEventListener('click', () => {
          const realWishlist =
            document.querySelector('[data-wishlist-add]') ||
            document.querySelector('[data-wishlist-button]') ||
            document.querySelector('.wishlist-button') ||
            document.querySelector('.tinvwl_add_to_wishlist_button') ||
            document.querySelector('[aria-label*="Wishlist"]') ||
            document.querySelector('[aria-label*="wishlist"]');

          if (
            realWishlist &&
            realWishlist !== this.wishlistButton &&
            typeof realWishlist.click === 'function'
          ) {
            realWishlist.click();
          }

          const active =
            this.wishlistButton.classList.toggle('is-active');

          this.wishlistButton.setAttribute(
            'aria-label',
            active
              ? 'Remove from wishlist'
              : 'Add to wishlist'
          );
        });
      }

      setupForm() {
        if (!this.form) return;
        this.form.addEventListener('submit', async event => {
          if (!window.fetch || !this.addButton || this.addButton.disabled) return;
          event.preventDefault();
          this.addButton.disabled = true;
          this.addButton.classList.add('is-loading');
          if (this.addLabel) this.addLabel.textContent = 'Adding…';
          try {
            const rootPath = window.Shopify?.routes?.root || '/';
            const response = await fetch(`${rootPath}cart/add.js`, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(this.form) });
            const payload = await response.json();
            if (!response.ok) throw new Error(payload.description || payload.message || 'Unable to add this product.');
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { item: payload } }));
            document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { item: payload } }));
            document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { item: payload } }));
            this.showToast('Added to your cart.');
            if (this.openCart) window.setTimeout(() => document.querySelector('[aria-controls="CartDrawer"]')?.click?.(), 160);
          } catch (error) {
            this.showToast(error.message || 'Unable to add this product.');
          } finally {
            const current = this.variants.find(variant => Number(variant.id) === Number(this.variantInput?.value));
            const available = current?.available !== false;
            this.addButton.disabled = !available;
            this.addButton.classList.remove('is-loading');
            if (this.addLabel) this.addLabel.textContent = available ? this.defaultAddLabel : 'Sold out';
          }
        });
      }

      async loadRelatedProducts() {
        if (!this.related || !this.relatedGrid) return;
        const base = this.dataset.recommendationsUrl || '/recommendations/products';
        const endpoint = base.endsWith('.json') ? base : `${base}.json`;
        const url = new URL(endpoint, window.location.origin);
        url.searchParams.set('product_id', this.dataset.productId || '');
        url.searchParams.set('limit', this.dataset.relatedLimit || '6');
        url.searchParams.set('intent', 'related');
        try {
          const response = await fetch(url.toString(), { headers: { Accept: 'application/json' } });
          if (!response.ok) return;
          const payload = await response.json();
          const products = Array.isArray(payload.products) ? payload.products : [];
          if (!products.length) return;
          this.relatedGrid.innerHTML = products.map(product => this.relatedProductMarkup(product)).join('');
          this.related.hidden = false;
        } catch (error) {}
      }

      relatedProductMarkup(product) {
        const featured = product.featured_image;
        const image = typeof featured === 'string' ? featured : featured?.url || '';
        return `<a class="tjs-app-pdp__related-card" href="${this.escapeAttribute(product.url || '#')}"><span class="tjs-app-pdp__related-image">${image ? `<img src="${this.escapeAttribute(image)}" alt="" loading="lazy">` : ''}</span><span class="tjs-app-pdp__related-copy"><strong>${this.escapeHtml(this.decodeHtmlEntities(product.title || 'Product'))}</strong><span>${this.escapeHtml(this.formatMoney(product.price || 0))}</span></span></a>`;
      }

      formatMoney(cents) {
        if (window.Shopify?.formatMoney) {
          try { return window.Shopify.formatMoney(Number(cents || 0), this.moneyFormat); } catch (error) {}
        }
        return new Intl.NumberFormat('en-IN', { style: 'currency', currency: this.currency, maximumFractionDigits: 0 }).format(Number(cents || 0) / 100);
      }

      decodeHtmlEntities(value) {
        const textarea = document.createElement('textarea');
        textarea.innerHTML = String(value || '');
        return textarea.value;
      }

      escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, character => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#039;' })[character]);
      }

      escapeAttribute(value) { return this.escapeHtml(String(value || '')); }

      showToast(message) {
        if (!this.toast) return;
        this.toast.textContent = message;
        this.toast.classList.add('is-visible');
        clearTimeout(this.toast._timer);
        this.toast._timer = setTimeout(() => this.toast.classList.remove('is-visible'), 2500);
      }
    }

    customElements.define('tjs-app-pdp-v4', TjsAppPdp);
  })();
</script>

