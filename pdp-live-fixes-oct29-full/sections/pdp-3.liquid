{% comment %}
  TJS App PDP — Fresh build
  Mobile: product-image viewport -> swipe cue -> floating white purchase card -> white details surface.
  Desktop: large gallery left -> sticky commercial info right -> full-width details surface below.
{% endcomment %}

{% liquid
  assign selected_variant = product.selected_or_first_available_variant

  assign department_meta = product.metafields.custom.department
  assign category_meta = product.metafields.custom.category
  assign short_description_meta = product.metafields.custom.short_description
  assign primary_use_meta = product.metafields.custom.primary_use
  assign material_meta = product.metafields.custom.material
  assign room_meta = product.metafields.custom.room
  assign occasion_meta = product.metafields.custom.occasion
  assign key_features_meta = product.metafields.custom.key_features
  assign dimensions_meta = product.metafields.custom.dimensions_display
  assign whats_in_box_meta = product.metafields.custom.whats_in_box
  assign care_meta = product.metafields.custom.care_instructions
  assign return_class_meta = product.metafields.custom.return_class
  assign dispatch_class_meta = product.metafields.custom.dispatch_class
  assign capacity_meta = product.metafields.custom.capacity
  assign capacity_range_meta = product.metafields.custom.capacity_range
  assign set_size_meta = product.metafields.custom.set_size
  assign compartment_meta = product.metafields.custom.compartment_count
  assign insulated_meta = product.metafields.custom.insulated
  assign intended_contents_meta = product.metafields.custom.intended_contents
  assign assembly_meta = product.metafields.custom.assembly_required
  assign power_source_meta = product.metafields.custom.power_source
  assign light_source_meta = product.metafields.custom.light_source
  assign control_type_meta = product.metafields.custom.control_type
  assign planner_type_meta = product.metafields.custom.planner_type
  assign dated_status_meta = product.metafields.custom.dated_status
  assign planner_year_meta = product.metafields.custom.planner_year
  assign planner_size_meta = product.metafields.custom.planner_size
  assign page_count_meta = product.metafields.custom.page_count
  assign binding_meta = product.metafields.custom.binding
  assign personalisation_meta = product.metafields.custom.personalisation_available
  assign frame_shape_meta = product.metafields.custom.frame_shape
  assign frame_colour_meta = product.metafields.custom.frame_colour
  assign lens_colour_meta = product.metafields.custom.lens_colour
  assign fit_meta = product.metafields.custom.fit
  assign intended_wearer_meta = product.metafields.custom.intended_wearer

  assign department_text = department_meta.value | default: department_meta
  assign category_text = category_meta.value | default: category_meta
  assign product_context = category_text | default: product.type | default: department_text
  assign fingerprint = product.type | append: ' ' | append: department_text | append: ' ' | append: category_text | downcase

  assign pdp_mode = 'default'
  if section.settings.mode_override != 'smart'
    assign pdp_mode = section.settings.mode_override
  else
    if fingerprint contains 'sunglass' or fingerprint contains 'eyewear' or fingerprint contains 'eyeglass'
      assign pdp_mode = 'eyewear'
    elsif fingerprint contains 'planner' or fingerprint contains 'journal' or fingerprint contains 'notebook' or fingerprint contains 'record book' or fingerprint contains 'vision board'
      assign pdp_mode = 'planner'
    elsif fingerprint contains 'baby' or fingerprint contains 'kids tableware' or fingerprint contains 'kid'
      assign pdp_mode = 'baby'
    elsif fingerprint contains 'lamp' or fingerprint contains 'light' or fingerprint contains 'clock' or fingerprint contains 'decor' or fingerprint contains 'artifact' or fingerprint contains 'figurine' or fingerprint contains 'planter' or fingerprint contains 'mirror' or fingerprint contains 'ottoman' or fingerprint contains 'pouf' or fingerprint contains 'rug'
      assign pdp_mode = 'decor'
    elsif fingerprint contains 'lunch' or fingerprint contains 'organiser' or fingerprint contains 'organizer' or fingerprint contains 'storage' or fingerprint contains 'sipper' or fingerprint contains 'bottle' or fingerprint contains 'travel mug' or fingerprint contains 'backpack' or fingerprint contains 'bag'
      assign pdp_mode = 'utility'
    elsif fingerprint contains 'mug' or fingerprint contains 'glass' or fingerprint contains 'drinkware' or fingerprint contains 'serve' or fingerprint contains 'dinner' or fingerprint contains 'bowl' or fingerprint contains 'plate' or fingerprint contains 'jug' or fingerprint contains 'decanter' or fingerprint contains 'cutlery' or fingerprint contains 'tea cup' or fingerprint contains 'casserole'
      assign pdp_mode = 'tableware'
    endif
  endif

  case pdp_mode
    when 'tableware'
      assign mode_label = 'Kitchen & Dining'
    when 'utility'
      assign mode_label = 'Everyday Utility'
    when 'planner'
      assign mode_label = 'Planners & Journals'
    when 'eyewear'
      assign mode_label = 'Eyewear'
    when 'decor'
      assign mode_label = 'Home & Decor'
    when 'baby'
      assign mode_label = 'Baby & Kids'
    else
      assign mode_label = product_context | default: 'The June Shop'
  endcase

  assign clean_description = product.description
  assign clean_description = clean_description | replace: '</p>', ' ' | replace: '</div>', ' ' | replace: '</li>', ' ' | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | strip_html
  assign clean_description = clean_description | split: 'Specs:' | first | split: 'Specs :' | first | split: 'Specifications:' | first | split: 'SPECIFICATIONS:' | first | strip

  assign legacy_spec_text = product.description
  assign legacy_spec_text = legacy_spec_text | replace: '</p>', ' | ' | replace: '</div>', ' | ' | replace: '</li>', ' | ' | replace: '<br>', ' | ' | replace: '<br/>', ' | ' | replace: '<br />', ' | ' | strip_html | strip

  assign short_description = short_description_meta.value
  if short_description == blank
    assign short_description = clean_description | truncatewords: 26
  endif

  assign review_rating = blank
  assign review_count = blank
  assign rating_meta = product.metafields.reviews.rating.value
  if rating_meta != blank
    if rating_meta.rating != blank
      assign review_rating = rating_meta.rating | round: 1
    else
      assign review_rating = rating_meta | round: 1
    endif
  endif
  if product.metafields.reviews.rating_count.value != blank
    assign review_count = product.metafields.reviews.rating_count.value
  endif

  assign app_block_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_block_count = app_block_count | plus: 1
    endif
  endfor

  assign compare_price = selected_variant.compare_at_price
  assign selling_price = selected_variant.price
  assign on_sale = false
  assign saving_amount = 0
  assign saving_percent = 0
  if compare_price != blank and compare_price > selling_price
    assign on_sale = true
    assign saving_amount = compare_price | minus: selling_price
    assign saving_percent = saving_amount | times: 100.0 | divided_by: compare_price | round
  endif

  assign low_stock = false
  if selected_variant.available and selected_variant.inventory_management != blank and selected_variant.inventory_policy == 'deny' and selected_variant.inventory_quantity > 0 and selected_variant.inventory_quantity <= section.settings.low_stock_threshold
    assign low_stock = true
  endif

  assign material_text = blank
  if material_meta != blank
    if material_meta.type contains 'list.'
      assign material_text = material_meta.value | join: ', '
    else
      assign material_text = material_meta.value
    endif
  endif

  assign capacity_text = blank
  if capacity_meta != blank
    if capacity_meta.type contains 'list.'
      assign capacity_text = capacity_meta.value | join: ', '
    else
      assign capacity_text = capacity_meta.value
    endif
  elsif capacity_range_meta != blank
    if capacity_range_meta.type contains 'list.'
      assign capacity_text = capacity_range_meta.value | join: ', '
    else
      assign capacity_text = capacity_range_meta.value
    endif
  endif

  assign room_text = blank
  if room_meta != blank
    if room_meta.type contains 'list.'
      assign room_text = room_meta.value | join: ', '
    else
      assign room_text = room_meta.value
    endif
  endif

  assign primary_use_text = blank
  if primary_use_meta != blank
    if primary_use_meta.type contains 'list.'
      assign primary_use_text = primary_use_meta.value | join: ', '
    else
      assign primary_use_text = primary_use_meta.value
    endif
  endif

  assign intended_contents_text = blank
  if intended_contents_meta != blank
    if intended_contents_meta.type contains 'list.'
      assign intended_contents_text = intended_contents_meta.value | join: ', '
    else
      assign intended_contents_text = intended_contents_meta.value
    endif
  endif

  assign designed_for_value = primary_use_text

  if designed_for_value == blank
    assign designed_for_value = intended_contents_text
  endif

  if designed_for_value == blank
    assign designed_for_value = room_text
  endif

  if designed_for_value == blank
    assign designed_for_value = product.type
  endif

  if designed_for_value == blank
    assign designed_for_value = mode_label
  endif


  assign form_id = 'TjsAppPdpForm-' | append: section.id
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --pdp-bg: {{ section.settings.background }};
    --pdp-media: {{ section.settings.media_background }};
    --pdp-card: {{ section.settings.card_background }};
    --pdp-details: {{ section.settings.details_background }};
    --pdp-text: {{ section.settings.text_color }};
    --pdp-muted: {{ section.settings.muted_color }};
    --pdp-accent: {{ section.settings.accent_color }};
    --pdp-accent-soft: color-mix(in srgb, {{ section.settings.accent_color }} 10%, #fff);
    --pdp-border: {{ section.settings.border_color }};
    --pdp-button: {{ section.settings.button_background }};
    --pdp-button-text: {{ section.settings.button_text }};
    --pdp-max: {{ section.settings.max_width }}px;
    --pdp-title-d: {{ section.settings.desktop_title_size }}px;
    --pdp-title-m: {{ section.settings.mobile_title_size }}px;
    --pdp-price-d: {{ section.settings.desktop_price_size }}px;
    --pdp-price-m: {{ section.settings.mobile_price_size }}px;
    --pdp-body-size: {{ section.settings.body_size }}px;
    background: var(--pdp-bg);
  }

  #shopify-section-{{ section.id }} [data-heading-font="modern"] { --pdp-heading-font: "Avenir Next", "Helvetica Neue", Arial, sans-serif; }
  #shopify-section-{{ section.id }} [data-heading-font="clean"] { --pdp-heading-font: "Helvetica Neue", Helvetica, Arial, sans-serif; }
  #shopify-section-{{ section.id }} [data-heading-font="theme"] { --pdp-heading-font: var(--font-heading-family, "Avenir Next", "Helvetica Neue", Arial, sans-serif); }
  #shopify-section-{{ section.id }} [data-heading-font="serif"] { --pdp-heading-font: Georgia, "Times New Roman", serif; }
  #shopify-section-{{ section.id }} [data-body-font="modern"] { --pdp-body-font: "Avenir Next", "Helvetica Neue", Arial, sans-serif; }
  #shopify-section-{{ section.id }} [data-body-font="clean"] { --pdp-body-font: "Helvetica Neue", Helvetica, Arial, sans-serif; }
  #shopify-section-{{ section.id }} [data-body-font="theme"] { --pdp-body-font: var(--font-body-family, "Avenir Next", "Helvetica Neue", Arial, sans-serif); }

  #shopify-section-{{ section.id }} .tjs-app-pdp,
  #shopify-section-{{ section.id }} .tjs-app-pdp * { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .tjs-app-pdp {
    position: relative;
    overflow: clip;
    padding: {{ section.settings.desktop_padding }}px 0;
    color: var(--pdp-text);
    background: linear-gradient(180deg, color-mix(in srgb, var(--pdp-bg) 96%, #fff), var(--pdp-bg));
    font-family: var(--pdp-body-font);
    font-size: var(--pdp-body-size);
    -webkit-font-smoothing: antialiased;
  }

  #shopify-section-{{ section.id }} .tjs-app-pdp__inner { width: min(calc(100% - 44px), var(--pdp-max)); margin-inline: auto; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__breadcrumbs { display:flex; align-items:center; gap:7px; margin-bottom:18px; color:var(--pdp-muted); font-size:11px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__breadcrumbs a { color:inherit; text-decoration:none; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__hero { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(420px,.92fr); align-items:start; gap:clamp(40px,5vw,78px); }
  #shopify-section-{{ section.id }} .tjs-app-pdp__gallery { display:grid; grid-template-columns:{% if section.settings.show_thumbnails %}76px{% else %}0{% endif %} minmax(0,1fr); gap:{% if section.settings.show_thumbnails %}12px{% else %}0{% endif %}; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__thumbs { display:grid; align-content:start; gap:8px; max-height:660px; overflow-y:auto; scrollbar-width:none; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__thumbs::-webkit-scrollbar { display:none; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__thumb { width:72px; height:86px; display:grid; place-items:center; overflow:hidden; padding:3px; border:1px solid transparent; border-radius:14px; background:#fff; cursor:pointer; opacity:.66; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__thumb.is-active, #shopify-section-{{ section.id }} .tjs-app-pdp__thumb:hover { border-color:var(--pdp-accent); opacity:1; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__thumb img, #shopify-section-{{ section.id }} .tjs-app-pdp__thumb svg { width:100%; height:100%; display:block; object-fit:cover; }

  #shopify-section-{{ section.id }} .tjs-app-pdp__stage { position:relative; height:660px; overflow:hidden; border-radius:30px; background:var(--pdp-media); box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--pdp-border) 72%,transparent),0 24px 60px rgba(21,17,14,.065); }
  #shopify-section-{{ section.id }} .tjs-app-pdp__slides { position:absolute; inset:0; display:grid; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__slide { grid-area:1/1; width:100%; height:100%; display:grid; place-items:center; opacity:0; visibility:hidden; pointer-events:none; transform:translateY(8px); transition:opacity .28s ease,visibility .28s ease,transform .34s cubic-bezier(.22,.61,.36,1); }
  #shopify-section-{{ section.id }} .tjs-app-pdp__slide.is-active { opacity:1; visibility:visible; pointer-events:auto; transform:none; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__media-button, #shopify-section-{{ section.id }} .tjs-app-pdp__media-frame { width:100%; height:100%; display:grid; place-items:center; padding:0; border:0; background:transparent; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__media-button { cursor:zoom-in; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__image { width:100%; height:100%; display:block; object-position:center; transform:scale({{ section.settings.image_scale | times: 0.01 }}); }
  {% if section.settings.image_fit == 'smart' %}
    #shopify-section-{{ section.id }} .tjs-app-pdp__slide[data-orientation="landscape"] .tjs-app-pdp__image { object-fit:cover; }
    #shopify-section-{{ section.id }} .tjs-app-pdp__slide[data-orientation="portrait"] .tjs-app-pdp__image, #shopify-section-{{ section.id }} .tjs-app-pdp__slide[data-orientation="square"] .tjs-app-pdp__image { object-fit:contain; }
  {% else %}
    #shopify-section-{{ section.id }} .tjs-app-pdp__image { object-fit:{{ section.settings.image_fit }}; }
  {% endif %}
  #shopify-section-{{ section.id }} .tjs-app-pdp__media-frame video, #shopify-section-{{ section.id }} .tjs-app-pdp__media-frame iframe, #shopify-section-{{ section.id }} .tjs-app-pdp__media-frame model-viewer { width:100%; height:100%; display:block; object-fit:contain; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__counter { position:absolute; z-index:5; right:16px; bottom:16px; min-height:34px; display:inline-flex; align-items:center; gap:3px; padding:0 11px; border-radius:999px; background:rgba(255,255,255,.91); box-shadow:0 8px 24px rgba(20,17,14,.08); font-size:11px; font-weight:650; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__mobile-controls, #shopify-section-{{ section.id }} .tjs-app-pdp__swipe-cue { display:none; }

  #shopify-section-{{ section.id }} .tjs-app-pdp__purchase { position:sticky; top:94px; max-width:620px; padding-top:6px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__type { margin:0 0 10px; color:var(--pdp-accent); font-size:11px; font-weight:700; letter-spacing:.075em; text-transform:uppercase; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__title { max-width:15ch; margin:0; font-family:var(--pdp-heading-font); font-size:clamp(40px,4.3vw,var(--pdp-title-d)); font-weight:600; line-height:1.03; letter-spacing:-.05em; text-wrap:balance; }
  #shopify-section-{{ section.id }} [data-title-effect="gradient"] .tjs-app-pdp__title { color:transparent; background:linear-gradient(105deg,var(--pdp-text),{{ section.settings.accent_color }}); background-clip:text; -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  #shopify-section-{{ section.id }} [data-title-effect="sheen"] .tjs-app-pdp__title { color:transparent; background:linear-gradient(110deg,var(--pdp-text) 0%,var(--pdp-text) 38%,{{ section.settings.accent_color }} 48%,#fff 52%,{{ section.settings.accent_color }} 56%,var(--pdp-text) 68%,var(--pdp-text) 100%); background-size:250% 100%; background-clip:text; -webkit-background-clip:text; -webkit-text-fill-color:transparent; animation:tjsAppPdpSheen 7s linear infinite; }
  @keyframes tjsAppPdpSheen { from{background-position:170% 50%} to{background-position:-70% 50%} }
  #shopify-section-{{ section.id }} .tjs-app-pdp__reviews-summary { display:flex; align-items:center; gap:8px; margin-top:13px; font-size:12px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__stars { color:#d99916; letter-spacing:.035em; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__benefit { max-width:54ch; margin-top:14px; color:var(--pdp-muted); font-size:15px; line-height:1.65; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__price-row { display:flex; align-items:baseline; flex-wrap:wrap; gap:9px; margin-top:22px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__price { font-size:var(--pdp-price-d); font-weight:760; line-height:1; letter-spacing:-.04em; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__compare { color:var(--pdp-muted); font-size:15px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__saving { min-height:28px; display:inline-flex; align-items:center; padding:0 9px; border-radius:999px; background:var(--pdp-accent-soft); color:var(--pdp-accent); font-size:10px; font-weight:700; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__tax { margin:7px 0 0; color:var(--pdp-muted); font-size:10px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__stock { min-height:34px; display:inline-flex; align-items:center; gap:7px; margin-top:13px; padding:0 11px; border:1px solid var(--pdp-border); border-radius:999px; background:#fff; color:var(--pdp-muted); font-size:10px; font-weight:650; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__stock::before { content:""; width:7px; height:7px; border-radius:50%; background:#4ea35e; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__stock.is-low::before { background:#d58a2d; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__stock.is-sold-out::before { background:#aaa49d; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__form { margin-top:22px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__options { display:grid; gap:17px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__option { display:grid; gap:9px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__option-head { display:flex; align-items:center; justify-content:space-between; gap:10px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__option-head strong { font-size:13px; font-weight:650; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__option-head span { color:var(--pdp-muted); font-size:12px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__values { display:flex; flex-wrap:wrap; gap:8px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__value { min-height:43px; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:0 14px; border:1px solid var(--pdp-border); border-radius:999px; background:#fff; color:var(--pdp-text); cursor:pointer; font:inherit; font-size:12px; font-weight:600; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__value.is-active { border-color:var(--pdp-text); background:var(--pdp-text); color:#fff; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__value:disabled { opacity:.28; cursor:not-allowed; text-decoration:line-through; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__swatch { width:20px; height:20px; flex:0 0 20px; border:1px solid rgba(0,0,0,.12); border-radius:50%; background-color:var(--swatch,#d9d5cf); background-image:var(--swatch-image,none); background-position:center; background-size:cover; box-shadow:inset 0 0 0 2px rgba(255,255,255,.72); }
  #shopify-section-{{ section.id }} .tjs-app-pdp__select { min-height:46px; padding:0 38px 0 13px; border:1px solid var(--pdp-border); border-radius:12px; background:#fff; color:var(--pdp-text); font:inherit; font-size:13px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__buy-row { display:grid; grid-template-columns:{% if section.settings.show_quantity %}124px{% else %}1fr{% endif %} minmax(0,1fr); gap:10px; margin-top:19px; }
  {% unless section.settings.show_quantity %}#shopify-section-{{ section.id }} .tjs-app-pdp__buy-row{grid-template-columns:1fr}{% endunless %}
  #shopify-section-{{ section.id }} .tjs-app-pdp__quantity { min-height:54px; display:grid; grid-template-columns:38px 46px 38px; align-items:center; overflow:hidden; border:1px solid var(--pdp-border); border-radius:15px; background:#fff; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__quantity button { width:38px; height:52px; padding:0; border:0; background:transparent; font-size:18px; cursor:pointer; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__quantity input { width:46px; height:52px; padding:0; border:0; outline:0; background:transparent; font:inherit; font-size:14px; font-weight:650; text-align:center; appearance:textfield; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__quantity input::-webkit-inner-spin-button, #shopify-section-{{ section.id }} .tjs-app-pdp__quantity input::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__add { min-height:54px; display:inline-flex; align-items:center; justify-content:center; gap:9px; padding:0 18px; border:0; border-radius:15px; background:var(--pdp-button); color:var(--pdp-button-text); cursor:pointer; font:inherit; font-size:13px; font-weight:700; box-shadow:0 13px 30px rgba(17,15,13,.14); }
  #shopify-section-{{ section.id }} .tjs-app-pdp__add:disabled { opacity:.45; cursor:not-allowed; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__add svg { width:17px; height:17px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__assurance { display:flex; flex-wrap:wrap; gap:6px 18px; margin-top:16px; padding-top:14px; border-top:1px solid var(--pdp-border); color:var(--pdp-muted); font-size:10.5px; }
  #shopify-section-{{ section.id }} .tjs-app-pdp__assurance strong { color:var(--pdp-text); }

