const optionGroups=[...root.querySelectorAll('[data-jmp-option]')];function values(){return optionGroups.map(g=>g.querySelector('[data-jmp-option-select]')?.value||g.querySelector('[data-jmp-option-value].is-active')?.dataset.jmpOptionValue)}
const nameWrap=root.querySelector('[data-jmp-name]'),nameInput=nameWrap?.querySelector('input'),nameSave=root.querySelector('[data-jmp-name-save]'),optionButtons=[...root.querySelectorAll('[data-jmp-option-value]')],nameChoice=optionButtons.find(b=>/^(add|with)(?:\s+your)?\s+name$/i.test(b.dataset.jmpOptionValue.trim())||/personal/i.test(b.dataset.jmpOptionValue)),withoutNameChoice=optionButtons.find(b=>/without\s+name|no\s+name/i.test(b.dataset.jmpOptionValue));if(nameWrap&&nameChoice){nameChoice.setAttribute('aria-controls',nameWrap.id);nameChoice.setAttribute('aria-expanded','false');nameChoice.dataset.defaultLabel=nameChoice.textContent.trim();nameChoice.closest('[data-jmp-option]')?.append(nameWrap)}
