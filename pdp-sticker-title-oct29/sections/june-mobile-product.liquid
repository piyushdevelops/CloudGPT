function chooseOption(button){const group=button?.closest('[data-jmp-option]');if(!group)return;group.querySelectorAll('[data-jmp-option-value]').forEach(choice=>{const on=choice===button;choice.classList.toggle('is-active',on);choice.setAttribute('aria-pressed',String(on))});sync()}
