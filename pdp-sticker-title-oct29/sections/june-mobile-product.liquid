function closeNameEditor(){if(!nameWrap)return;nameWrap.hidden=true;nameChoice?.setAttribute('aria-expanded','false')}
function saveName(){if(!nameInput||!nameChoice)return;nameInput.value=nameInput.value.trim();if(!nameInput.reportValidity())return;nameChoice.textContent=nameInput.value;closeNameEditor();nameChoice.focus()}
optionButtons.forEach(button=>button.addEventListener('click',()=>{chooseOption(button);if(button===nameChoice)openNameEditor();else if(button===withoutNameChoice)closeNameEditor()}));root.querySelectorAll('[data-jmp-option-select]').forEach(s=>s.addEventListener('change',sync));
const qty=root.querySelector('[name=quantity]');root.querySelectorAll('[data-jmp-quantity]').forEach(b=>b.addEventListener('click',()=>{qty.value=Math.max(1,Number(qty.value||1)+(b.dataset.jmpQuantity==='plus'?1:-1));qty.dispatchEvent(new Event('change',{bubbles:true}))}));
const nameCount=root.querySelector('[data-jmp-name-count]');nameInput?.addEventListener('input',()=>nameCount.textContent=nameInput.value.length);nameInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();saveName()}else if(e.key==='Escape'){closeNameEditor();nameChoice?.focus()}});nameSave?.addEventListener('click',saveName);root.querySelector('.jmp__form')?.addEventListener('submit',e=>{if(nameInput?.required&&!nameInput.value.trim()){e.preventDefault();openNameEditor();nameInput.reportValidity()}});if(withoutNameChoice)chooseOption(withoutNameChoice);
function organizeDescriptionTabs(){const description=root.querySelector('[data-jmp-description]'),specsPanel=root.querySelector('[data-jmp-description-specs]'),specsFallback=root.querySelector('[data-jmp-specs-fallback]'),detailsTab=root.querySelector('[data-jmp-details-tab]'),detailsPanel=root.querySelector('[data-jmp-details-panel]');if(!description||!specsPanel||!detailsTab||!detailsPanel)return;const findText=pattern=>{const walker=document.createTreeWalker(description,NodeFilter.SHOW_TEXT);let node,match;while((node=walker.nextNode())){match=node.data.match(pattern);if(match)return{node,match}}};const compliance=findText(/Country\s+of\s+Origin\s*:/i);if(compliance){const range=document.createRange(),block=compliance.node.parentElement?.closest('p,h1,h2,h3,h4,h5,h6,div,li');if(block&&block!==description&&/^\s*Country\s+of\s+Origin\s*:/i.test(block.textContent))range.setStartBefore(block);else range.setStart(compliance.node,compliance.match.index);range.setEndAfter(description.lastChild);const fragment=range.extractContents();if(fragment.textContent.trim()){detailsPanel.append(fragment);detailsTab.hidden=false}}const specs=findText(/^\s*Specs\s*:?\s*$/i);if(!specs)return;const marker=specs.node.parentElement?.closest('h1,h2,h3,h4,h5,h6,p,div,li'),markerIsExact=marker&&marker!==description&&/^\s*Specs\s*:?\s*$/i.test(marker.textContent),range=document.createRange();if(markerIsExact)range.setStartAfter(marker);else range.setStart(specs.node,specs.match.index+specs.match[0].length);range.setEndAfter(description.lastChild);const fragment=range.extractContents();while(fragment.firstElementChild&&!fragment.firstElementChild.textContent.trim()&&!fragment.firstElementChild.querySelector('img,video,svg,iframe'))fragment.firstElementChild.remove();if(!fragment.textContent.trim())return;specsPanel.append(fragment);if(specsFallback)specsFallback.hidden=true;if(markerIsExact)marker.remove();else specs.node.deleteData(specs.match.index,specs.match[0].length)}organizeDescriptionTabs();
const tabs=[...root.querySelectorAll('[role=tab]')];tabs.forEach((tab,i)=>tab.addEventListener('click',()=>{tabs.forEach((t,n)=>{const on=n===i;t.setAttribute('aria-selected',String(on));t.tabIndex=on?0:-1;document.getElementById(t.getAttribute('aria-controls')).hidden=!on});tab.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'nearest',inline:'center'})}));root.querySelector('[role=tablist]')?.addEventListener('keydown',e=>{const i=tabs.indexOf(document.activeElement);if(i<0||!['ArrowLeft','ArrowRight'].includes(e.key))return;e.preventDefault();tabs[(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length].click();tabs[(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length].focus()});
