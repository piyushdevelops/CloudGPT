{%- liquid
  assign variant = product.selected_or_first_available_variant | default: product.variants.first
  assign form_id = 'JuneProductForm-' | append: section.id
  assign name_enabled = product.metafields.custom.personalise_name.value
  if product.tags contains 'name_customisation'
    assign name_enabled = true
  endif
  unless name_enabled
    for product_variant in product.variants
      assign product_variant_title_down = product_variant.title | downcase
      if product_variant_title_down contains 'name' or product_variant_title_down contains 'personal'
        assign name_enabled = true
        break
      endif
    endfor
  endunless
  assign preorder = false
  if product.tags contains 'June-Preorder-2027' or product.tags contains 'Preorder' or product.tags contains 'preorder'
    assign preorder = true
  elsif variant.inventory_policy == 'continue' and variant.inventory_quantity <= 0
    assign preorder = true
  endif
  assign dispatch_value = product.metafields.custom.preorder_dispatch_date.value
  if preorder
    assign dispatch_value = section.settings.preorder_dispatch_date | default: '2026-10-31'
  endif
  assign short_description = product.metafields.custom.short_description.value
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign category_collection = product.collections.first
  assign type_block = section.blocks | where: 'type', 'typography' | first
  assign heading_font = type_block.settings.heading_font | default: 'poppins_n4'
  assign copy_font = type_block.settings.copy_font | default: 'poppins_n4'
  assign action_font = type_block.settings.action_font | default: 'poppins_n4'
  assign action_is_link = false
  if section.settings.action_mode == 'link' and section.settings.action_link != blank
    assign action_is_link = true
  endif
  assign display_title = product.title
  assign sticker_book_label = ''
  assign title_parts = product.title | split: ' + '
  if title_parts.size > 1
    assign final_title_part = title_parts | last | strip
    assign final_title_part_down = final_title_part | downcase
    if final_title_part_down contains 'sticker book'
      assign sticker_book_label = final_title_part
      assign title_prefix_count = title_parts.size | minus: 1
      assign display_title = title_parts | slice: 0, title_prefix_count | join: ' + '
    endif
  endif
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ copy_font | font_face: font_display: 'swap' }}
  {{ action_font | font_face: font_display: 'swap' }}
</style>

<section id="JuneProduct-{{ section.id }}" class="jmp{% if preorder %} jmp--preorder{% endif %}" data-jmp-root data-product-url="{{ product.url }}">
  <div class="jmp__purchase">
    <div class="jmp__gallery" data-jmp-gallery>
      <div class="jmp__stage" data-jmp-stage aria-live="polite">
        {%- for media in product.media -%}
          <figure class="jmp__slide{% if forloop.first %} is-active{% endif %}" data-jmp-slide="{{ forloop.index0 }}" data-media-id="{{ media.id }}"{% unless forloop.first %} hidden{% endunless %}>
            {%- if media.preview_image -%}
              {%- if forloop.first -%}
                {{ media.preview_image | image_url: width: 1600 | image_tag: widths: '360, 540, 720, 960, 1200, 1600', sizes: '(max-width: 749px) calc(100vw - 28px), 50vw', loading: 'eager', fetchpriority: 'high', alt: media.alt | default: product.title }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1600 | image_tag: widths: '360, 540, 720, 960, 1200, 1600', sizes: '(max-width: 749px) calc(100vw - 28px), 50vw', loading: 'lazy', alt: media.alt | default: product.title }}
              {%- endif -%}
            {%- endif -%}
          </figure>
        {%- else -%}
          <div class="jmp__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endfor -%}
        {%- if product.media.size > 1 -%}
          <span class="jmp__count" data-jmp-count>1 / {{ product.media.size }}</span>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="jmp__thumbs" role="list" aria-label="Product images">
          {%- for media in product.media -%}
            <button class="jmp__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-jmp-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="jmp__summary">
      {%- if preorder -%}<p class="jmp__eyebrow">{{ section.settings.preorder_badge }}</p>{%- endif -%}
      <h1 aria-label="{{ product.title | escape }}">
        <span class="jmp__title-main">{{ display_title | escape }}</span>
        {%- if sticker_book_label != blank -%}
          <span class="jmp__title-bonus" aria-hidden="true"><span class="jmp__title-plus">+</span><span class="jmp__title-script">{{ sticker_book_label | escape }}</span></span>
        {%- endif -%}
      </h1>
      {%- if short_description != blank -%}<p class="jmp__subtitle">{{ short_description }}</p>{%- endif -%}
      {%- if rating != blank and rating_count > 0 -%}
        <a class="jmp__rating" href="#JuneProductInfo-{{ section.id }}" aria-label="Rated {{ rating.rating }} out of {{ rating.scale_max }}">
          <span aria-hidden="true">★★★★★</span> {{ rating.rating | default: rating }}
        </a>
      {%- endif -%}
      <div class="jmp__price" aria-live="polite">
        <strong data-jmp-price>{{ variant.price | money }}</strong>
        <del data-jmp-compare{% unless variant.compare_at_price > variant.price %} hidden{% endunless %}>{{ variant.compare_at_price | money }}</del>
      </div>

      {%- form 'product', product, id: form_id, class: 'hdt-main-product-form jmp__form' -%}
        <input type="hidden" name="id" value="{{ variant.id }}" data-jmp-variant-id>
        <input type="hidden" name="properties[Purchase type]" value="{% if preorder %}Pre-order{% else %}Standard order{% endif %}" data-jmp-purchase-type>
        {%- if dispatch_value != blank -%}<input type="hidden" name="properties[Expected dispatch]" value="{{ dispatch_value | date: '%-d %b %Y' }}">{%- endif -%}

        {%- unless action_is_link -%}
        {%- unless product.has_only_default_variant -%}
          <div class="jmp__options">
            {%- for option in product.options_with_values -%}
              <fieldset class="jmp__option" data-jmp-option data-option-index="{{ forloop.index0 }}">
                <legend>{{ option.name }}</legend>
                {%- if option.values.size > 8 -%}
                  <select aria-label="{{ option.name }}" data-jmp-option-select>
                    {%- for value in option.values -%}<option value="{{ value | escape }}"{% if value.selected %} selected{% endif %}>{{ value }}</option>{%- endfor -%}
                  </select>
                {%- else -%}
                  <div class="jmp__choices">
                    {%- for value in option.values -%}
                      <button type="button" class="jmp__choice{% if value.selected %} is-active{% endif %}" data-jmp-option-value="{{ value | escape }}" aria-pressed="{% if value.selected %}true{% else %}false{% endif %}">{{ value }}</button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- if name_enabled -%}
          <div class="jmp__name" id="JuneNameEditor-{{ section.id }}" data-jmp-name hidden>
            <label for="JuneName-{{ section.id }}">{{ section.settings.name_label }}</label>
            <div class="jmp__name-row">
              <div class="jmp__name-field">
                <span aria-hidden="true">✦</span>
                <input id="JuneName-{{ section.id }}" name="properties[Name]" type="text" maxlength="{{ section.settings.name_limit }}" placeholder="{{ section.settings.name_placeholder }}" autocomplete="off" disabled>
              </div>
              <button class="jmp__name-save" type="button" data-jmp-name-save>{{ section.settings.name_save_label }}</button>
            </div>
            <small>{{ section.settings.name_hint }} <span data-jmp-name-count>0</span>/{{ section.settings.name_limit }}</small>
          </div>
        {%- endif -%}

        <div class="jmp__finish">
          <label class="jmp__quantity" for="JuneQuantity-{{ section.id }}">Quantity
            <span><button type="button" data-jmp-quantity="minus" aria-label="Decrease quantity">−</button><input id="JuneQuantity-{{ section.id }}" name="quantity" type="number" min="1" value="1" inputmode="numeric"><button type="button" data-jmp-quantity="plus" aria-label="Increase quantity">+</button></span>
          </label>
          <hdt-buy-buttons class="jmp__desktop-buy hdt-product-form__buttons" form="{{ form_id }}">
            <button class="jmp__atc hdt-product-form__submit" type="submit" name="add"{% unless variant.available %} disabled{% endunless %}>
              <span data-jmp-cta>{% if variant.available %}{% if preorder %}Pre-order{% else %}Add to bag{% endif %}{% else %}Sold out{% endif %}</span>
              <small data-jmp-dispatch>{% if preorder %}{% if dispatch_value != blank %}Dispatches from {{ dispatch_value | date: '%-d %b %Y' }}{% else %}{{ section.settings.dispatch_fallback }}{% endif %}{% endif %}</small>
            </button>
          </hdt-buy-buttons>
        </div>
        {%- endunless -%}
        <div class="jmp__message hdt-form__message-wrapper hdt-form-message--error" role="alert" hidden><span class="hdt-error-message"></span></div>
      {%- endform -%}
      {%- if action_is_link -%}
        <a class="jmp__atc jmp__link-action" href="{{ section.settings.action_link }}">{{ section.settings.action_label }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>
  </div>

  <div id="JuneProductInfo-{{ section.id }}" class="jmp__info" data-jmp-tabs>
    <div class="jmp__tablist" role="tablist" aria-label="Product information">
      <button role="tab" aria-selected="true" aria-controls="JuneDescription-{{ section.id }}" id="JuneTabDescription-{{ section.id }}">Description</button>
      <button role="tab" aria-selected="false" aria-controls="JuneSpecs-{{ section.id }}" id="JuneTabSpecs-{{ section.id }}" tabindex="-1">Specifications</button>
      <button role="tab" aria-selected="false" aria-controls="JunePolicy-{{ section.id }}" id="JuneTabPolicy-{{ section.id }}" tabindex="-1">Delivery &amp; returns</button>
      <button role="tab" aria-selected="false" aria-controls="JuneDetails-{{ section.id }}" id="JuneTabDetails-{{ section.id }}" tabindex="-1" data-jmp-details-tab hidden>Product details</button>
    </div>
    <div class="jmp__panels">
      <div role="tabpanel" id="JuneDescription-{{ section.id }}" aria-labelledby="JuneTabDescription-{{ section.id }}" class="jmp__panel rte" data-jmp-description>{{ product.description }}</div>
      <div role="tabpanel" id="JuneSpecs-{{ section.id }}" aria-labelledby="JuneTabSpecs-{{ section.id }}" class="jmp__panel" hidden>
        <div class="rte" data-jmp-description-specs></div>
        <p data-jmp-specs-fallback>{{ section.settings.specs_fallback }}</p>
      </div>
      <div role="tabpanel" id="JunePolicy-{{ section.id }}" aria-labelledby="JuneTabPolicy-{{ section.id }}" class="jmp__panel rte" hidden>
        {%- if shop.shipping_policy.body != blank -%}{{ shop.shipping_policy.body }}{%- else -%}<p>{{ section.settings.shipping_fallback }}</p>{%- endif -%}
        {%- if shop.refund_policy.body != blank -%}<h3>Returns</h3>{{ shop.refund_policy.body }}{%- endif -%}
      </div>
      <div role="tabpanel" id="JuneDetails-{{ section.id }}" aria-labelledby="JuneTabDetails-{{ section.id }}" class="jmp__panel rte" data-jmp-details-panel hidden></div>
    </div>
  </div>

  {%- if section.settings.show_discovery -%}
    <div id="JuneProductDiscovery-{{ section.id }}" class="jmp__discovery" data-jmp-discovery>
      {%- assign discovery_products = product.metafields['shopify--discovery--product_recommendation'].related_products.value -%}
      {%- if discovery_products != blank -%}
        <div class="jmp__rail"><h2>More like this</h2><div class="jmp__cards">
          {%- for item in discovery_products limit: 8 -%}{%- unless item.id == product.id -%}{% render 'june-pdp-card', product: item %}{%- endunless -%}{%- endfor -%}
        </div></div>
      {%- endif -%}
      {%- if category_collection != blank and category_collection.products_count > 1 -%}
        <div class="jmp__rail"><h2>More from {{ category_collection.title }}</h2><div class="jmp__cards">
          {%- for item in category_collection.products limit: 9 -%}{%- unless item.id == product.id -%}{% render 'june-pdp-card', product: item %}{%- endunless -%}{%- endfor -%}
        </div></div>
      {%- endif -%}
      {%- if section.settings.bestseller_collection != blank -%}
        <div class="jmp__rail"><h2>{{ section.settings.bestseller_heading }}</h2><div class="jmp__cards">
          {%- for item in section.settings.bestseller_collection.products limit: 8 -%}{%- unless item.id == product.id -%}{% render 'june-pdp-card', product: item %}{%- endunless -%}{%- endfor -%}
        </div></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="jmp__sticky" data-jmp-sticky>
    <div><strong data-jmp-sticky-price>{{ variant.price | money }}</strong></div>
    {%- if action_is_link -%}
      <a class="jmp__sticky-link" href="{{ section.settings.action_link }}"><span>{{ section.settings.action_label }}</span><span aria-hidden="true">→</span></a>
    {%- else -%}
      <button type="submit" name="add" form="{{ form_id }}"{% unless variant.available %} disabled{% endunless %}><span class="jmp__sticky-label"><b data-jmp-sticky-cta>{% if variant.available %}{% if preorder %}Pre-order{% else %}Add to bag{% endif %}{% else %}Sold out{% endif %}</b><small data-jmp-sticky-dispatch{% unless preorder %} hidden{% endunless %}>{% if dispatch_value != blank %}Dispatches from {{ dispatch_value | date: '%-d %b %Y' }}{% else %}{{ section.settings.dispatch_fallback }}{% endif %}</small></span><span aria-hidden="true">→</span></button>
    {%- endif -%}
  </div>
  <div class="jmp__sticky-spacer" aria-hidden="true"></div>
</section>

<style>
html.june-product-page,html.june-product-page body,html.june-product-page #MainContent{max-width:100%;overflow-x:hidden;overflow-x:clip}
#JuneProduct-{{ section.id }}{--jmp-ink:#171717;--jmp-bg:#fff;--jmp-surface:#f5f5f3;--jmp-muted:#656565;--jmp-border:#dadada;--jmp-accent:#b9a2f4;--jmp-sticky:#b9a2f4;--jmp-sticky-preorder:#a4d978;max-width:100%;overflow-x:hidden;overflow-x:clip;color:var(--jmp-ink);background:var(--jmp-bg);font-family:{{ copy_font.family }},sans-serif}
#JuneProduct-{{ section.id }} *{box-sizing:border-box}
#JuneProduct-{{ section.id }} button,#JuneProduct-{{ section.id }} input,#JuneProduct-{{ section.id }} select{font:inherit}
#JuneProduct-{{ section.id }} .jmp__purchase{width:min(1680px,calc(100% - 48px));margin:auto;padding:28px 0 54px;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(380px,.72fr);gap:clamp(32px,5vw,88px);align-items:start}
#JuneProduct-{{ section.id }} .jmp__stage{position:relative;aspect-ratio:1;background:var(--jmp-surface);overflow:hidden;border:1px solid var(--jmp-border)}
#JuneProduct-{{ section.id }} .jmp__slide{position:absolute;inset:0;margin:0}
#JuneProduct-{{ section.id }} .jmp__slide img{width:100%;height:100%;object-fit:contain;display:block}
#JuneProduct-{{ section.id }} .jmp__count{position:absolute;right:12px;bottom:12px;padding:7px 11px;border:1px solid var(--jmp-border);border-radius:999px;background:#fffffff0;font-size:11px;font-weight:700}
#JuneProduct-{{ section.id }} .jmp__thumbs{display:flex;gap:10px;overflow-x:auto;padding:12px 2px 4px;scrollbar-width:none}
#JuneProduct-{{ section.id }} .jmp__thumb{flex:0 0 68px;width:68px;height:68px;padding:0;border:1px solid var(--jmp-border);border-radius:10px;background:var(--jmp-bg);overflow:hidden}
#JuneProduct-{{ section.id }} .jmp__thumb img{width:100%;height:100%;object-fit:cover}
#JuneProduct-{{ section.id }} .jmp__thumb:first-child img{object-fit:contain}
#JuneProduct-{{ section.id }} .jmp__thumb.is-active{outline:2px solid var(--jmp-ink);outline-offset:2px}
#JuneProduct-{{ section.id }} .jmp__summary{position:sticky;top:92px;padding-top:8px}
#JuneProduct-{{ section.id }} .jmp__eyebrow{display:inline-flex;margin:0 0 10px;padding:6px 10px;border-radius:999px;background:var(--jmp-ink);color:#fff;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
#JuneProduct-{{ section.id }} h1{margin:0;font-family:{{ heading_font.family }},sans-serif;font-size:{{ type_block.settings.heading_size_desktop | default: 44 }}px;font-weight:{{ type_block.settings.heading_weight | default: 800 }};line-height:{{ type_block.settings.heading_line | default: 1.02 }};letter-spacing:{{ type_block.settings.heading_spacing | default: -0.04 }}em}
#JuneProduct-{{ section.id }} .jmp__title-main{display:block}
#JuneProduct-{{ section.id }} .jmp__title-bonus{display:flex;align-items:baseline;gap:.28em;width:max-content;max-width:100%;margin:.18em 0 .08em;line-height:1;white-space:normal}
#JuneProduct-{{ section.id }} .jmp__title-plus{font-family:{{ heading_font.family }},sans-serif;font-size:.48em;font-weight:800;vertical-align:middle;color:var(--jmp-accent)}
#JuneProduct-{{ section.id }} .jmp__title-script{position:relative;display:inline-block;max-width:100%;padding:0 .1em .13em;font-family:'Snell Roundhand','Brush Script MT','Segoe Script','Apple Chancery',cursive;font-size:.8em;font-style:italic;font-weight:700;letter-spacing:-.045em;line-height:1.05;transform:rotate(-2deg);overflow-wrap:anywhere}
#JuneProduct-{{ section.id }} .jmp__title-script::after{content:'';position:absolute;left:3%;right:2%;bottom:.02em;height:.095em;border-radius:100%;background:var(--jmp-accent);transform:rotate(-1deg);z-index:-1;opacity:.85}
#JuneProduct-{{ section.id }} .jmp__subtitle{margin:10px 0 0;color:var(--jmp-muted);font-size:15px;line-height:1.45}
#JuneProduct-{{ section.id }} .jmp__rating{display:inline-flex;gap:7px;margin-top:10px;color:var(--jmp-ink);font-size:12px;text-decoration:none}
#JuneProduct-{{ section.id }} .jmp__rating span{color:var(--jmp-accent);letter-spacing:.08em}
#JuneProduct-{{ section.id }} .jmp__price{display:flex;align-items:baseline;gap:10px;margin:16px 0 18px}
#JuneProduct-{{ section.id }} .jmp__price strong{font-size:30px;font-weight:900;letter-spacing:-.04em}
#JuneProduct-{{ section.id }} .jmp__price del{color:var(--jmp-muted);font-size:14px}
#JuneProduct-{{ section.id }} .jmp__option{margin:0 0 16px;padding:0;border:0}
#JuneProduct-{{ section.id }} .jmp__option legend,#JuneProduct-{{ section.id }} .jmp__name label,#JuneProduct-{{ section.id }} .jmp__quantity{margin-bottom:8px;font-size:12px;font-weight:800}
#JuneProduct-{{ section.id }} .jmp__choices{display:flex;flex-wrap:wrap;gap:8px}
#JuneProduct-{{ section.id }} .jmp__choice,#JuneProduct-{{ section.id }} .jmp__option select{min-height:44px;padding:10px 14px;border:1.5px solid var(--jmp-border);border-radius:12px;background:var(--jmp-bg);color:var(--jmp-ink);font-size:12px;font-weight:700}
#JuneProduct-{{ section.id }} .jmp__choice.is-active{border-color:var(--jmp-ink);background:var(--jmp-ink);color:#fff}
#JuneProduct-{{ section.id }} .jmp__option select{width:100%}
#JuneProduct-{{ section.id }} .jmp__name{margin:18px 0;padding:14px;border:1px solid color-mix(in srgb,var(--jmp-accent) 38%,var(--jmp-border));border-radius:16px;background:color-mix(in srgb,var(--jmp-accent) 7%,#fff);animation:jmp-reveal .38s ease both}
#JuneProduct-{{ section.id }} .jmp__name-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center}
#JuneProduct-{{ section.id }} .jmp__name-field{display:flex;align-items:center;gap:9px;margin-top:8px;padding:0 12px;border:1.5px solid var(--jmp-border);border-radius:12px;background:#fff}
#JuneProduct-{{ section.id }} .jmp__name-field span{color:var(--jmp-accent);animation:jmp-spark 1.8s ease-in-out infinite}
#JuneProduct-{{ section.id }} .jmp__name input{width:100%;height:46px;border:0;outline:0;background:transparent}
#JuneProduct-{{ section.id }} .jmp__name-save{min-height:46px;margin-top:8px;padding:0 16px;border:1.5px solid var(--jmp-ink);border-radius:12px;background:var(--jmp-ink);color:#fff;font:800 12px/1 {{ action_font.family }},sans-serif}
#JuneProduct-{{ section.id }} .jmp__name small{display:block;margin-top:6px;color:var(--jmp-muted);font-size:10px;text-align:right}
#JuneProduct-{{ section.id }} .jmp__finish{display:grid;grid-template-columns:112px 1fr;gap:10px;align-items:end;margin-top:18px}
#JuneProduct-{{ section.id }} .jmp__quantity{display:block;margin:0}
#JuneProduct-{{ section.id }} .jmp__quantity>span{display:grid;grid-template-columns:34px 1fr 34px;height:52px;margin-top:8px;border:1.5px solid var(--jmp-border);border-radius:14px;overflow:hidden}
#JuneProduct-{{ section.id }} .jmp__quantity button,#JuneProduct-{{ section.id }} .jmp__quantity input{min-width:0;border:0;background:#fff;text-align:center;font-weight:800}
#JuneProduct-{{ section.id }} .jmp__quantity input{width:100%;appearance:textfield}
#JuneProduct-{{ section.id }} .jmp__atc{width:100%;min-height:52px;padding:8px 18px;border:1px solid var(--jmp-ink);border-radius:999px;background:var(--jmp-accent);color:var(--jmp-ink);font-family:{{ action_font.family }},sans-serif;font-weight:900;box-shadow:0 3px 0 var(--jmp-ink)}
#JuneProduct-{{ section.id }}.jmp--preorder .jmp__atc,#JuneProduct-{{ section.id }}.is-preorder .jmp__atc{background:var(--jmp-sticky-preorder)}
#JuneProduct-{{ section.id }} .jmp__link-action{display:flex;align-items:center;justify-content:space-between;margin-top:20px;text-decoration:none}
#JuneProduct-{{ section.id }} .jmp__atc small{display:block;margin-top:2px;font-size:9px;font-weight:700}
#JuneProduct-{{ section.id }} .jmp__atc:disabled,#JuneProduct-{{ section.id }} .jmp__sticky button:disabled{opacity:.45;cursor:not-allowed}
#JuneProduct-{{ section.id }} .jmp__info{padding:58px max(24px,calc((100% - 1180px)/2));background:var(--jmp-surface)}
#JuneProduct-{{ section.id }} .jmp__tablist{display:flex;gap:8px;overflow-x:auto;border-bottom:1px solid var(--jmp-border)}
#JuneProduct-{{ section.id }} .jmp__tablist button{padding:14px 16px;border:0;border-bottom:3px solid transparent;background:transparent;white-space:nowrap;font-weight:800}
#JuneProduct-{{ section.id }} .jmp__tablist button[aria-selected=true]{border-color:var(--jmp-accent)}
#JuneProduct-{{ section.id }} .jmp__panel{max-width:880px;padding:24px 4px 4px;font-size:14px;line-height:1.7}
#JuneProduct-{{ section.id }} .jmp__panel.rte :is(h1,h2,h3){font-family:{{ heading_font.family }},sans-serif;line-height:1.08;letter-spacing:-.035em}
#JuneProduct-{{ section.id }} .jmp__panel.rte :is(img,video,iframe){max-width:100%;height:auto}
#JuneProduct-{{ section.id }} .jmp__panel dl{margin:0}
#JuneProduct-{{ section.id }} .jmp__panel dl div{display:grid;grid-template-columns:150px 1fr;gap:18px;padding:14px 0;border-bottom:1px solid var(--jmp-border)}
