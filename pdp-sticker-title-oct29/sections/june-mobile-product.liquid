{% schema %}
{
  "name": "June mobile-first product",
  "tag": "section",
  "class": "section-june-mobile-product",
  "settings": [
    {"type":"text","id":"preorder_badge","label":"Pre-order badge","default":"Pre-order"},
    {"type":"text","id":"preorder_dispatch_date","label":"Pre-order dispatch date (YYYY-MM-DD)","default":"2026-10-31"},
    {"type":"text","id":"dispatch_fallback","label":"Dispatch fallback","default":"Dispatch date shown after confirmation"},
    {"type":"text","id":"name_label","label":"Personalisation label","default":"Add your name"},
    {"type":"text","id":"name_placeholder","label":"Personalisation placeholder","default":"Type the name exactly as it should appear"},
    {"type":"text","id":"name_hint","label":"Personalisation hint","default":"We’ll use this spelling for your order."},
    {"type":"text","id":"name_save_label","label":"Personalisation save label","default":"Save"},
    {"type":"range","id":"name_limit","label":"Name character limit","min":8,"max":40,"step":1,"default":30},
    {"type":"textarea","id":"specs_fallback","label":"Specifications fallback","default":"Additional product details are listed in the description. Contact us before ordering if you need a specific measurement confirmed."},
    {"type":"textarea","id":"shipping_fallback","label":"Delivery fallback","default":"Delivery timing is shown at checkout. Personalised and made-to-order items may require additional preparation time."},
    {"type":"checkbox","id":"show_discovery","label":"Show product discovery","default":true},
    {"type":"collection","id":"bestseller_collection","label":"Bestseller collection"},
    {"type":"text","id":"bestseller_heading","label":"Bestseller heading","default":"June favourites"}
    ,{"type":"select","id":"action_mode","label":"Primary action","default":"product","options":[{"value":"product","label":"Add to cart"},{"value":"link","label":"Open configurator"}]}
    ,{"type":"url","id":"action_link","label":"Configurator link"}
    ,{"type":"text","id":"action_label","label":"Configurator button label","default":"Start designing"}
  ],
