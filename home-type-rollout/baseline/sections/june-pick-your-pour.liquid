{% javascript %}

if(!customElements.get('june-pour')){
 customElements.define('june-pour',class extends HTMLElement{
  connectedCallback(){
   this.controller?.abort();this.controller=new AbortController();const options={signal:this.controller.signal};
   this.buttons=[...this.querySelectorAll('[data-select]')];
   this.resizeObserver?.disconnect();this.resizeObserver=new ResizeObserver(()=>this.fitTitle());this.resizeObserver.observe(this);document.fonts.ready.then(()=>{if(this.isConnected)this.fitTitle();});
   this.addEventListener('click',e=>{const b=e.target.closest('[data-select]');if(b&&this.contains(b))this.select(Number(b.dataset.select));},options);
   this.addEventListener('keydown',e=>{const b=e.target.closest('[data-select]');if(!b)return;let i=this.buttons.indexOf(b),n;
    if(e.key==='ArrowRight')n=(i+1)%this.buttons.length;if(e.key==='ArrowLeft')n=(i-1+this.buttons.length)%this.buttons.length;if(e.key==='Home')n=0;if(e.key==='End')n=this.buttons.length-1;
    if(n===undefined)return;e.preventDefault();this.select(n);this.buttons[n].focus();
   },options);
   this.addEventListener('shopify:block:select',e=>{const b=this.buttons.find(b=>b.dataset.block===e.detail.blockId);if(b)this.select(Number(b.dataset.select));},options);
  }
  fitTitle(){const h=this.querySelector('.jg__heading');if(!h)return;h.style.fontSize='';if(matchMedia('(min-width:901px)').matches&&h.scrollWidth>h.clientWidth){h.style.fontSize=(parseFloat(getComputedStyle(h).fontSize)*h.clientWidth/h.scrollWidth*.99)+'px';}}
  select(index){if(!this.buttons[index])return;this.buttons.forEach((b,i)=>b.setAttribute('aria-pressed',String(i===index)));['scene','foreground','product'].forEach(key=>this.querySelectorAll('[data-'+key+']').forEach(el=>el.hidden=Number(el.dataset[key])!==index));}
  disconnectedCallback(){this.controller?.abort();this.resizeObserver?.disconnect();}
 });
}

{% endjavascript %}
{% schema %}
{
  "name": "June · Pick your pour",
  "tag": "section",
  "class": "june-pour-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "use_master_palette",
      "label": "Use master palette",
      "default": true,
      "info": "Uses Theme settings > June master palette. Turn off to use this section’s individual colours."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Glassware"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PICK YOUR POUR."
    },
    {
      "type": "inline_richtext",
      "id": "body",
      "label": "Supporting copy",
      "default": "Make the everyday <strong>a little more special.</strong>"
    },
    {
      "type": "text",
      "id": "choose",
      "label": "Selector label",
      "default": "What are you pouring?"
    },
    {
      "type": "text",
      "id": "shop",
      "label": "Shop button",
      "default": "Shop this glass"
    },
    {
      "type": "text",
      "id": "view",
      "label": "Unavailable product button",
      "default": "View this glass"
    },
    {
      "type": "text",
      "id": "all",
      "label": "Collection link label",
      "default": "All glassware"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Glassware collection"
    },
    {
      "type": "text",
      "id": "from",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Text",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#F56A28"
    },
    {
      "type": "font_picker",
      "id": "fallback_font",
      "label": "Fallback font",
      "default": "poppins_n4"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Minimum desktop height",
      "min": 400,
      "max": 700,
      "step": 10,
