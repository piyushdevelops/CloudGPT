            action="{{ routes.search_url }}"
            method="get"
            role="search"
            data-frm-search
          >
            <button
              type="button"
              class="tjs-ph__search-back"
              data-tjs-search-back
              aria-label="Back"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m14.5 5.5-6.5 6.5 6.5 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <input type="hidden" name="options[unavailable_products]" value="last">
            <input
              id="TjsHeaderSearchMobile-{{ section.id }}"
              type="search"
              name="q"
              data-input-search
              autocomplete="off"
              enterkeyhint="search"
              placeholder="{% unless section.settings.enable_typing_effect %}{{ section.settings.search_placeholder | escape }}{% endunless %}"
              aria-label="{{ section.settings.search_placeholder | escape }}"
            >
              <span class="tjs-ph__typing" data-tjs-typing aria-hidden="true">
                <span data-tjs-typing-text></span><i></i>
              </span>
            <button
              type="button"
              class="tjs-ph__search-close"
              data-tjs-search-close
              aria-label="Close search"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
