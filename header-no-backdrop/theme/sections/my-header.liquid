      .tjs-ph__mobile > .tjs-ph__search-wrap
      .tjs-ph__search button[type="submit"] {
      width: 36px !important;
      height: 36px !important;
      right: 4px !important;
    }
  }


  /* =====================================================
     Final complete-subcategory desktop mega menu
  ===================================================== */

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown {
    padding: 10px 15px 18px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-panel,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-panel.has-promo {
    width: min(calc(100% - 24px), var(--tjs-ph-max));
    max-height: min(74vh, 680px);
    display: block;
    overflow: hidden;
    padding: 0;
    border: 1px solid rgba(255,255,255,.66);
    border-radius: 18px;
    background:
      linear-gradient(145deg, rgba(255,255,255,.34), transparent 44%),
      color-mix(in srgb, var(--tjs-ph-bg) 88%, transparent);
    box-shadow:
      0 26px 72px rgba(23,18,14,.16),
      inset 0 1px 0 rgba(255,255,255,.72);
    backdrop-filter:
      blur(calc(var(--tjs-ph-glass-blur) + 4px))
      saturate(var(--tjs-ph-glass-saturate));
    -webkit-backdrop-filter:
      blur(calc(var(--tjs-ph-glass-blur) + 4px))
      saturate(var(--tjs-ph-glass-saturate));
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-main {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(180px, .58fr) minmax(0, 2.42fr);
    gap: 0;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro {
    position: sticky;
    top: 0;
    min-height: 100%;
    align-content: start;
    gap: 10px;
    padding: 28px 24px;
    border-right: 1px solid color-mix(in srgb, var(--tjs-ph-border) 82%, transparent);
    background:
      radial-gradient(circle at 22% 4%, color-mix(in srgb, var(--tjs-ph-accent) 11%, transparent), transparent 38%),
      rgba(255,255,255,.16);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro small {
    color: var(--tjs-ph-text);
    font-size: 7px;
    font-weight: 820;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro strong {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(25px, 2vw, 34px);
    font-weight: 520;
    line-height: .98;
    letter-spacing: -.045em;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro a {
    min-height: 36px;
    width: max-content;
    display: inline-flex;
    align-items: center;
    margin-top: 8px;
    padding: 0 13px;
    border: 1px solid color-mix(in srgb, var(--tjs-ph-text) 22%, transparent);
    border-radius: 999px;
    background: var(--tjs-ph-text);
    color: var(--tjs-ph-bg);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .045em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-columns {
    min-width: 0;
    max-height: min(74vh, 680px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    align-content: start;
    gap: 0;
    overflow-y: auto;
    padding: 12px;
    scrollbar-width: thin;
    scrollbar-color:
      color-mix(in srgb, var(--tjs-ph-accent) 34%, transparent)
      transparent;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-column {
    min-width: 0;
    display: block;
    padding: 16px 15px 17px;
    border-right: 1px solid color-mix(in srgb, var(--tjs-ph-border) 64%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--tjs-ph-border) 64%, transparent);
    transition: background-color .18s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-column:hover {
    background: rgba(255,255,255,.3);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-heading {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding-right: 18px;
    color: var(--tjs-ph-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 15px;
    font-weight: 590;
    line-height: 1.12;
    letter-spacing: -.025em;
    text-decoration: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-heading::after {
    content: "↗";
    position: absolute;
    top: 0;
    right: 0;
    color: var(--tjs-ph-text);
    font-family: var(--font-body-family, sans-serif);
    font-size: 10px;
    font-weight: 700;
    transition: transform .18s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-heading:hover::after {
    transform: translate(2px, -2px);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child {
    position: relative;
    display: block;
    width: max-content;
    max-width: 100%;
    margin-top: 9px;
    padding-bottom: 2px;
    color: var(--tjs-ph-muted);
    font-size: 9px;
    font-weight: 590;
    line-height: 1.3;
    text-decoration: none;
    transition: color .16s ease, transform .16s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .18s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child:hover {
    color: var(--tjs-ph-text);
    transform: translateX(2px);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* The complete directory is more useful than a repeated generic promo tile. */
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-promo {
    display: none !important;
  }

  @media (max-width: 1320px) and (min-width: 1150px) {
    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-main {
      grid-template-columns: 170px minmax(0, 1fr);
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-columns {
      grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro {
      padding: 23px 18px;
    }
  }


  /* =====================================================
     Mobile search escape/back control
     Always gives customers a way to leave full-screen search
  ===================================================== */
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search-back {
    display: none;
  }

  @media (max-width: 1149px) {
    #TjsPremiumHeader-{{ section.id }}
      .tjs-ph__search-wrap.is-search-active
      .tjs-ph__search-back {
      position: absolute;
      z-index: 12;
      top: 50%;
      left: 5px;
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      padding: 0;
      border: 1px solid rgba(255,255,255,.68);
      border-radius: 50%;
      background:
        radial-gradient(circle at 30% 18%, rgba(255,255,255,.5), transparent 34%),
        color-mix(in srgb, var(--tjs-ph-bg) 78%, transparent);
      color: var(--tjs-ph-text);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.75),
        0 7px 20px rgba(24,18,14,.1);
      backdrop-filter: blur(14px) saturate(145%);
      -webkit-backdrop-filter: blur(14px) saturate(145%);
      cursor: pointer;
      transform: translateY(-50%);
    }

    #TjsPremiumHeader-{{ section.id }}
      .tjs-ph__search-wrap.is-search-active
      .tjs-ph__search-back svg {
      width: 18px;
      height: 18px;
    }

    #TjsPremiumHeader-{{ section.id }}
      .tjs-ph__search-wrap.is-search-active
      .tjs-ph__search input {
      padding-left: 54px !important;
      padding-right: 54px !important;
    }

    /* Back arrow is the primary exit; hide the secondary X to keep the field clean. */
    #TjsPremiumHeader-{{ section.id }}
      .tjs-ph__search-wrap.is-search-active
      .tjs-ph__search-close {
      display: none !important;
    }

    #TjsPremiumHeader-{{ section.id }}
      .tjs-ph__search-wrap.is-search-active
      .tjs-ph__search button[type="submit"] {
      right: 5px !important;
    }

    #TjsPremiumHeader-{{ section.id }}
      .tjs-ph__search-wrap.is-search-active
      .tjs-ph__typing {
      left: 54px;
      max-width: calc(100% - 112px);
    }
  }


  /* =====================================================
     SMART COLLECTION / PRODUCT-TYPE MEGA MENU V4
  ===================================================== */

  @media (min-width: 1150px) {
    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-main {
      grid-template-columns: minmax(220px, .62fr) minmax(0, 2.38fr);
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-content: start;
      gap: 0;
      padding: 0;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-column {
      min-height: 174px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 20px 18px 17px;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-heading {
      font-size: 16px;
      font-weight: 590;
      line-height: 1.08;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-types {
      width: 100%;
      display: grid;
      align-content: start;
      gap: 1px;
      margin-top: 10px;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child {
      width: fit-content;
      margin-top: 0;
      padding: 5px 0;
      font-size: 11px;
      font-weight: 570;
      line-height: 1.28;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-view-all {
      min-height: 28px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: auto;
      padding-top: 10px;
      color: var(--tjs-ph-text);
      font-size: 9px;
      font-weight: 780;
      letter-spacing: .035em;
      text-decoration: none;
      text-transform: uppercase;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-view-all span:last-child {
      transition: transform .18s ease;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-view-all:hover span:last-child {
      transform: translateX(3px);
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-editorial {
      max-width: 26ch;
      margin: 12px 0 0;
      color: var(--tjs-ph-muted);
      font-size: 11px;
      font-weight: 520;
      line-height: 1.5;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-column.is-editorial {
      background:
        linear-gradient(
          145deg,
          color-mix(in srgb, var(--tjs-ph-accent) 5%, transparent),
          transparent 64%
        );
    }
  }

  @media (max-width: 1370px) and (min-width: 1150px) {
    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-main {
      grid-template-columns: 190px minmax(0, 1fr);
    }
  }

  @media (max-width: 1149px) {
    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu details[data-tjs-mobile-child] {
      border-top: 1px solid color-mix(in srgb, var(--tjs-ph-border) 66%, transparent);
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu details[data-tjs-mobile-child] > summary {
      min-height: 44px;
      color: var(--tjs-ph-text);
      font-size: 13px;
      font-weight: 650;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu details[data-tjs-mobile-child] > summary svg {
      width: 12px;
      height: 8px;
      flex: 0 0 12px;
      transition: transform .2s ease;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu details[data-tjs-mobile-child][open] > summary svg {
      transform: rotate(180deg);
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu--grand {
      display: grid;
      gap: 0;
      padding: 2px 0 10px 14px;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu--grand li {
      border: 0;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-submenu--grand .tjs-ph__mobile-type-link {
      min-height: 36px !important;
      display: flex;
      align-items: center;
      color: var(--tjs-ph-muted) !important;
      font-size: 12px !important;
      font-weight: 560 !important;
      line-height: 1.3;
      text-decoration: none;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-view-all-row {
      margin-top: 3px;
      padding-top: 6px;
      border-top: 1px solid color-mix(in srgb, var(--tjs-ph-border) 66%, transparent) !important;
    }

    #TjsPremiumHeader-{{ section.id }} .tjs-ph__mobile-view-all {
      min-height: 38px !important;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: var(--tjs-ph-accent) !important;
      font-size: 10px !important;
      font-weight: 760 !important;
      letter-spacing: .025em;
      text-decoration: none;
    }
  }

{% endstyle %}

<tjs-premium-header
  id="TjsPremiumHeader-{{ section.id }}"
  data-sticky-mode="{{ section.settings.sticky_mode }}"
  data-predictive-url="{{ routes.predictive_search_url }}"
  data-search-url="{{ routes.search_url }}"
  data-min-search-characters="2"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-typing-enabled="{{ section.settings.enable_typing_effect }}"
  data-typing-speed="55"
  data-typing-hold="2000"
  class="{% if section.settings.transparent_home and request.page_type == 'index' %}is-home-transparent{% endif %}"
>
  <script type="application/json" data-tjs-header-popular>
    {{ tjs_popular_searches | json }}
  </script>

  <script type="application/json" data-tjs-exact-search-routes>
    {{ section.settings.exact_search_routes | json }}
  </script>

  <script type="application/json" data-tjs-search-synonyms>
    {{ section.settings.search_synonyms | json }}
  </script>

  <script type="application/json" data-tjs-typing-terms>
    {{ section.settings.typing_terms | newline_to_br | split: '<br />' | json }}
  </script>

  {% if section.settings.top_note != blank %}
    <div class="tjs-ph__note">
      {% if section.settings.top_note_link != blank %}
        <a href="{{ section.settings.top_note_link }}">{{ section.settings.top_note | escape }}</a>
      {% else %}
        <span>{{ section.settings.top_note | escape }}</span>
      {% endif %}
    </div>
  {% endif %}

  <div class="tjs-ph__shell">
    <div class="tjs-ph__inner">
      <div class="tjs-ph__desktop"{% if request.page_type == 'index' %} style="position:relative"{% endif %}>
        {% if tjs_desktop_show_menu %}
        <button type="button" class="tjs-ph__desktop-menu" data-tjs-menu-open aria-expanded="false" aria-controls="TjsHeaderMenu-{{ section.id }}" aria-label="Open menu">
          {% if tjs_desktop_menu_icon_url != blank %}
            <img class="tjs-ph__desktop-custom-icon" src="{{ tjs_desktop_menu_icon_url | escape }}" width="32" height="32" alt="" aria-hidden="true">
          {% else %}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h12M4 17h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          {% endif %}
          <span>{{ tjs_desktop_menu_label | escape }}</span>
        </button>
        {% endif %}
        {% if tjs_desktop_show_logo %}
        {% if request.page_type == 'index' %}
        <svg class="tjs-ph__desktop-scoop" viewBox="0 0 {{ tjs_desktop_scoop_top_width }} 40" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;z-index:3;top:{{ tjs_desktop_placement_block.settings.logo_y | default: 0 }}px;left:calc(50% + {{ tjs_desktop_placement_block.settings.logo_x | default: 0 }}px);width:{{ tjs_desktop_scoop_top_width }}px;height:{{ tjs_desktop_scoop_height }}px;transform:translateX(-50%);pointer-events:none;color:{{ tjs_desktop_appearance_block.settings.scoop_fill | default: tjs_mobile_placement_block.settings.scoop_color | default: '#000000' }}">
          <path fill="currentColor" d="M0 0H{{ tjs_desktop_scoop_top_width }}C{{ tjs_scoop_right_a }} 4 {{ tjs_scoop_right_b }} 19 {{ tjs_scoop_right_c }} 29C{{ tjs_scoop_right_d }} 35 {{ tjs_scoop_right_e }} 38 {{ tjs_scoop_right_shoulder }} 39H{{ tjs_desktop_scoop_shoulder }}C{{ tjs_scoop_x_e }} 38 {{ tjs_scoop_x_d }} 35 {{ tjs_scoop_x_c }} 29C{{ tjs_scoop_x_b }} 19 {{ tjs_scoop_x_a }} 4 0 0Z"/>
        </svg>
        {% endif %}
        <a class="tjs-ph__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}"{% if request.page_type == 'index' %} style="position:absolute;z-index:4;top:{{ tjs_desktop_placement_block.settings.logo_y | default: 0 }}px;left:calc(50% + {{ tjs_desktop_placement_block.settings.logo_x | default: 0 }}px);width:{{ tjs_desktop_placement_block.settings.scoop_width | default: 240 }}px;height:{{ tjs_desktop_placement_block.settings.scoop_height | default: 46 }}px;transform:translateX(-50%);display:flex;align-items:center;justify-content:center;background:transparent;-webkit-mask:none;mask:none"{% endif %}>
          {% if tjs_desktop_logo_url != blank %}
            <img class="tjs-ph__desktop-custom-logo" src="{{ tjs_desktop_logo_url | escape }}" width="240" height="48" alt="" aria-hidden="true">
          {% else %}
            <span class="tjs-ph__reference-wordmark" aria-hidden="true"{% if request.page_type == 'index' %} style="font-size:{{ tjs_desktop_placement_block.settings.wordmark_size | default: 12 }}px;font-weight:800;letter-spacing:-.035em;line-height:1;white-space:nowrap;color:{{ tjs_desktop_appearance_block.settings.wordmark_color | default: 'var(--june-on-dark,#fff)' }};{% if request.design_mode %}opacity:1;animation:none;{% endif %}"{% endif %}>{{ tjs_desktop_wordmark_text | escape }}</span>
          {% endif %}
        </a>
        {% endif %}

        <nav class="tjs-ph__nav" aria-label="Main navigation">
          <ul class="tjs-ph__nav-list">
            {% for link in tjs_header_menu.links %}
              {% liquid
                assign tjs_nav_title = link.title
                assign tjs_nav_badge = blank
                if link.title contains '['
                  assign tjs_nav_parts = link.title | split: '['
                  assign tjs_nav_title = tjs_nav_parts.first | strip
                  assign tjs_nav_badge = tjs_nav_parts[1] | remove: ']' | strip
                endif
              %}

              <li class="tjs-ph__nav-item">
                {% if link.links != blank %}
                  <details class="tjs-ph__nav-details" data-tjs-nav-details>
                    <summary class="tjs-ph__nav-summary">
                      <span>{{ tjs_nav_title | escape }}</span>
                      {% if tjs_nav_badge != blank %}
                        <span class="tjs-ph__nav-badge">{{ tjs_nav_badge | escape }}</span>
                      {% endif %}
                      <svg class="tjs-ph__nav-caret" viewBox="0 0 10 7" fill="none" aria-hidden="true">
                        <path d="m1 1.25 4 4 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>

                    <div class="tjs-ph__dropdown">
                      <div class="tjs-ph__dropdown-panel{% if section.settings.show_desktop_promo and tjs_menu_promo_block != blank %} has-promo{% endif %}">
                        <div class="tjs-ph__dropdown-main">
                          <div class="tjs-ph__dropdown-intro">
                            <small>Explore</small>
                            <strong>{{ tjs_nav_title | escape }}</strong>
                            <a href="{{ link.url }}">View all</a>
                          </div>

                          <div class="tjs-ph__dropdown-columns">
                            {% for childlink in link.links %}
                              {% liquid
                                assign tjs_child_title = childlink.title
                                if childlink.title contains '['
                                  assign tjs_child_parts = childlink.title | split: '['
                                  assign tjs_child_title = tjs_child_parts.first | strip
                                endif

                                assign tjs_child_title_downcase = tjs_child_title | downcase
                                assign tjs_skip_child = false
                                if tjs_mega_hide_shop_all and tjs_child_title_downcase contains 'shop all'
                                  assign tjs_skip_child = true
                                endif

                                assign tjs_child_collection = blank
                                if childlink.type == 'collection_link'
                                  assign tjs_child_collection = childlink.object
                                endif

                                assign tjs_curated_types = blank
                                assign tjs_automatic_types = blank
                                if tjs_child_collection != blank
                                  assign tjs_curated_types = tjs_child_collection.metafields.custom.mega_menu_product_types.value
                                  assign tjs_automatic_types = tjs_child_collection.all_types
                                endif

                                assign tjs_type_source = 'none'
                                if tjs_mega_types_enabled
                                  case tjs_mega_source
                                    when 'menu_only'
                                      if childlink.links != blank
                                        assign tjs_type_source = 'manual'
                                      endif
                                    when 'automatic'
                                      if tjs_automatic_types != blank
                                        assign tjs_type_source = 'automatic'
                                      elsif childlink.links != blank
                                        assign tjs_type_source = 'manual'
                                      endif
                                    else
                                      if tjs_curated_types != blank
                                        assign tjs_type_source = 'curated'
                                      elsif childlink.links != blank
                                        assign tjs_type_source = 'manual'
                                      elsif tjs_automatic_types != blank
                                        assign tjs_type_source = 'automatic'
                                      endif
                                  endcase
                                elsif childlink.links != blank
                                  assign tjs_type_source = 'manual'
                                endif

                                assign tjs_editorial_copy = blank
                                if tjs_type_source == 'none' and tjs_child_collection.description != blank
                                  assign tjs_editorial_copy = tjs_child_collection.description | strip_html | strip | truncatewords: 16
                                endif
                              %}

                              {% unless tjs_skip_child %}
                                <div
                                  class="tjs-ph__dropdown-column{% if tjs_type_source == 'none' %} is-editorial{% endif %}"
                                  data-tjs-mega-group
                                >
                                  <a class="tjs-ph__dropdown-heading" href="{{ childlink.url }}">
                                    {{ tjs_child_title | escape }}
                                  </a>

                                  {% if tjs_type_source != 'none' %}
                                    <div class="tjs-ph__dropdown-types">
                                      {% case tjs_type_source %}
                                        {% when 'curated' %}
                                          {% for tjs_product_type in tjs_curated_types limit: tjs_mega_types_limit %}
                                            {% assign tjs_product_type_encoded = tjs_product_type | url_encode %}
