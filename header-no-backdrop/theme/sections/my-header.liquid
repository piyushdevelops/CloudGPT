{% comment %}June happy cart: isolated assets, existing counter and drawer preserved.{% endcomment %}
{{ 'june-happy-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'june-happy-cart.js' | asset_url }}" defer="defer"></script>
{% comment %}
  TJS Fun + Premium Floating Header
  Standalone header section for The June Shop.

  Integrations retained:
  - Existing CartDrawer through aria-controls="CartDrawer"
  - Native Shopify account and wishlist routes
  - TJS Smart Search through data-frm-search / data-input-search
  - Native Shopify Predictive Search JSON endpoint
{% endcomment %}

{% liquid
  assign tjs_header_menu = section.settings.main_menu
  if tjs_header_menu == blank
    assign tjs_header_menu = linklists['main-menu']
  endif

  assign tjs_mobile_menu = section.settings.mobile_menu | default: tjs_header_menu
  assign tjs_logo_mobile = section.settings.logo_mobile | default: section.settings.logo
  assign tjs_mobile_logo_src = tjs_logo_mobile.src | downcase
  if tjs_mobile_logo_src contains '.gif'
    assign tjs_logo_mobile = nil
  endif
  assign tjs_logo_width_2x = section.settings.logo_width | times: 2
  assign tjs_logo_mobile_width_2x = section.settings.logo_width_mobile | times: 2
  assign tjs_logo_sizes = section.settings.logo_width | append: 'px'
  assign tjs_logo_mobile_sizes = section.settings.logo_width_mobile | append: 'px'
  assign tjs_logo_alt = section.settings.logo.alt | default: shop.name
  assign tjs_logo_mobile_alt = tjs_logo_mobile.alt | default: tjs_logo_alt
  assign tjs_logo_scrolled_width = section.settings.logo_width | times: 88 | divided_by: 100
  assign tjs_popular_searches = section.settings.popular_searches | split: ','
  assign tjs_glass_strength = section.settings.glass_strength
  assign tjs_menu_promo_block = blank
  assign tjs_menu_promo_alt = blank

  comment
    Smart mega-menu defaults remain active even when the optional
    "Mega menu controls" block has not been added to an existing header.
  endcomment
  assign tjs_mega_controls_block = blank
  assign tjs_mega_types_enabled = true
  assign tjs_mega_types_mobile = true
  assign tjs_mega_types_limit = 5
  assign tjs_mega_view_all = true
  assign tjs_mega_hide_shop_all = true
  assign tjs_mega_source = 'curated_fallback'
  assign tjs_mobile_placement_block = blank
  assign tjs_cart_badge_block = blank
  assign tjs_desktop_placement_block = blank
  assign tjs_desktop_appearance_block = blank
  assign tjs_desktop_icons_block = blank
  assign tjs_desktop_show_menu = true
  assign tjs_desktop_show_logo = true
  assign tjs_desktop_show_search = section.settings.show_desktop_search
  assign tjs_desktop_show_account = section.settings.show_account
  assign tjs_desktop_show_cart = true
  assign tjs_desktop_menu_label = 'Explore'
  assign tjs_desktop_wordmark_text = 'the june shop'
  assign tjs_desktop_search_placeholder = section.settings.search_placeholder

  for block in section.blocks
    if block.type == 'menu_card' and tjs_menu_promo_block == blank
      assign tjs_menu_promo_block = block
      assign tjs_menu_promo_alt = block.settings.image.alt | default: block.settings.title
    elsif block.type == 'mega_menu_controls' and tjs_mega_controls_block == blank
      assign tjs_mega_controls_block = block
      assign tjs_mega_types_enabled = block.settings.enable_product_types
      assign tjs_mega_types_mobile = block.settings.show_product_types_mobile
      assign tjs_mega_types_limit = block.settings.max_product_types
      assign tjs_mega_view_all = block.settings.show_child_view_all
      assign tjs_mega_hide_shop_all = block.settings.hide_duplicate_shop_all
      assign tjs_mega_source = block.settings.product_type_source
    elsif block.type == 'mobile_header_placement' and tjs_mobile_placement_block == blank
      assign tjs_mobile_placement_block = block
    elsif block.type == 'cart_badge_controls' and tjs_cart_badge_block == blank
      assign tjs_cart_badge_block = block
    elsif block.type == 'desktop_header_placement' and tjs_desktop_placement_block == blank
      assign tjs_desktop_placement_block = block
      assign tjs_desktop_show_menu = block.settings.show_menu
      assign tjs_desktop_show_logo = block.settings.show_logo
      assign tjs_desktop_show_search = block.settings.show_search
      assign tjs_desktop_show_account = block.settings.show_account
      assign tjs_desktop_show_cart = block.settings.show_cart
    elsif block.type == 'desktop_header_appearance' and tjs_desktop_appearance_block == blank
      assign tjs_desktop_appearance_block = block
    elsif block.type == 'desktop_icon_uploads' and tjs_desktop_icons_block == blank
      assign tjs_desktop_icons_block = block
    endif
  endfor

  assign tjs_menu_icon_url = tjs_mobile_placement_block.settings.menu_icon_file_url
  if tjs_menu_icon_url == blank and tjs_mobile_placement_block.settings.menu_icon_image != blank
    assign tjs_menu_icon_url = tjs_mobile_placement_block.settings.menu_icon_image | image_url: width: 96
  endif
  assign tjs_search_icon_url = tjs_mobile_placement_block.settings.search_icon_file_url
  if tjs_search_icon_url == blank and tjs_mobile_placement_block.settings.search_icon_image != blank
    assign tjs_search_icon_url = tjs_mobile_placement_block.settings.search_icon_image | image_url: width: 96
  endif
  assign tjs_cart_icon_url = tjs_mobile_placement_block.settings.cart_icon_file_url
  if tjs_cart_icon_url == blank and tjs_mobile_placement_block.settings.cart_icon_image != blank
    assign tjs_cart_icon_url = tjs_mobile_placement_block.settings.cart_icon_image | image_url: width: 96
  endif
  assign tjs_center_logo_url = tjs_mobile_placement_block.settings.logo_file_url
  if tjs_center_logo_url == blank and tjs_mobile_placement_block.settings.wordmark_image != blank
    assign tjs_center_logo_url = tjs_mobile_placement_block.settings.wordmark_image | image_url: width: 320
  endif
  assign tjs_desktop_menu_icon_url = tjs_desktop_appearance_block.settings.menu_icon_file_url
  if tjs_desktop_menu_icon_url == blank and tjs_desktop_appearance_block.settings.menu_icon_image != blank
    assign tjs_desktop_menu_icon_url = tjs_desktop_appearance_block.settings.menu_icon_image | image_url: width: 96
  endif
  assign tjs_desktop_logo_url = tjs_desktop_appearance_block.settings.logo_file_url
  if tjs_desktop_logo_url == blank and tjs_desktop_appearance_block.settings.logo_image != blank
    assign tjs_desktop_logo_url = tjs_desktop_appearance_block.settings.logo_image | image_url: width: 480
  endif
  assign tjs_desktop_search_icon_url = tjs_desktop_appearance_block.settings.search_icon_file_url
  if tjs_desktop_search_icon_url == blank and tjs_desktop_appearance_block.settings.search_icon_image != blank
    assign tjs_desktop_search_icon_url = tjs_desktop_appearance_block.settings.search_icon_image | image_url: width: 96
  endif
  assign tjs_desktop_account_icon_url = tjs_desktop_appearance_block.settings.account_icon_file_url
  if tjs_desktop_account_icon_url == blank and tjs_desktop_appearance_block.settings.account_icon_image != blank
    assign tjs_desktop_account_icon_url = tjs_desktop_appearance_block.settings.account_icon_image | image_url: width: 96
  endif
  assign tjs_desktop_cart_icon_url = tjs_desktop_appearance_block.settings.cart_icon_file_url
  if tjs_desktop_cart_icon_url == blank and tjs_desktop_appearance_block.settings.cart_icon_image != blank
    assign tjs_desktop_cart_icon_url = tjs_desktop_appearance_block.settings.cart_icon_image | image_url: width: 96
  endif
  if tjs_desktop_icons_block != blank
    if tjs_desktop_icons_block.settings.menu_icon_file_url != blank
      assign tjs_desktop_menu_icon_url = tjs_desktop_icons_block.settings.menu_icon_file_url
    elsif tjs_desktop_icons_block.settings.menu_icon_image != blank
      assign tjs_desktop_menu_icon_url = tjs_desktop_icons_block.settings.menu_icon_image | image_url: width: 96
    endif
    if tjs_desktop_icons_block.settings.search_icon_file_url != blank
      assign tjs_desktop_search_icon_url = tjs_desktop_icons_block.settings.search_icon_file_url
    elsif tjs_desktop_icons_block.settings.search_icon_image != blank
      assign tjs_desktop_search_icon_url = tjs_desktop_icons_block.settings.search_icon_image | image_url: width: 96
    endif
    if tjs_desktop_icons_block.settings.account_icon_file_url != blank
      assign tjs_desktop_account_icon_url = tjs_desktop_icons_block.settings.account_icon_file_url
    elsif tjs_desktop_icons_block.settings.account_icon_image != blank
      assign tjs_desktop_account_icon_url = tjs_desktop_icons_block.settings.account_icon_image | image_url: width: 96
    endif
    if tjs_desktop_icons_block.settings.cart_icon_file_url != blank
      assign tjs_desktop_cart_icon_url = tjs_desktop_icons_block.settings.cart_icon_file_url
    elsif tjs_desktop_icons_block.settings.cart_icon_image != blank
      assign tjs_desktop_cart_icon_url = tjs_desktop_icons_block.settings.cart_icon_image | image_url: width: 96
    endif
  endif
  assign tjs_desktop_menu_label = tjs_desktop_placement_block.settings.menu_label | default: tjs_desktop_menu_label
  assign tjs_desktop_wordmark_text = tjs_desktop_placement_block.settings.wordmark_text | default: tjs_desktop_wordmark_text
  assign tjs_desktop_search_placeholder = tjs_desktop_placement_block.settings.search_placeholder | default: tjs_desktop_search_placeholder
  assign tjs_desktop_scoop_width = tjs_desktop_placement_block.settings.scoop_width | default: 240
  assign tjs_desktop_scoop_height = tjs_desktop_placement_block.settings.scoop_height | default: 46
  assign tjs_desktop_scoop_shoulder = tjs_desktop_scoop_height | times: 9 | divided_by: 10
  assign tjs_desktop_scoop_shoulder_max = tjs_desktop_scoop_width | times: 23 | divided_by: 100
  if tjs_desktop_scoop_shoulder > tjs_desktop_scoop_shoulder_max
    assign tjs_desktop_scoop_shoulder = tjs_desktop_scoop_shoulder_max
  endif
  assign tjs_desktop_top_extension = tjs_desktop_placement_block.settings.top_edge_extension | default: 10
  assign tjs_desktop_scoop_top_width = tjs_desktop_scoop_width | plus: tjs_desktop_top_extension | plus: tjs_desktop_top_extension
  assign tjs_desktop_scoop_shoulder = tjs_desktop_scoop_shoulder | plus: tjs_desktop_top_extension
  assign tjs_scoop_x_a = tjs_desktop_scoop_shoulder | times: 33 | divided_by: 100
  assign tjs_scoop_x_b = tjs_desktop_scoop_shoulder | times: 31 | divided_by: 100
  assign tjs_scoop_x_c = tjs_desktop_scoop_shoulder | times: 53 | divided_by: 100
  assign tjs_scoop_x_d = tjs_desktop_scoop_shoulder | times: 64 | divided_by: 100
  assign tjs_scoop_x_e = tjs_desktop_scoop_shoulder | times: 81 | divided_by: 100
  assign tjs_scoop_right_a = tjs_desktop_scoop_top_width | minus: tjs_scoop_x_a
  assign tjs_scoop_right_b = tjs_desktop_scoop_top_width | minus: tjs_scoop_x_b
  assign tjs_scoop_right_c = tjs_desktop_scoop_top_width | minus: tjs_scoop_x_c
  assign tjs_scoop_right_d = tjs_desktop_scoop_top_width | minus: tjs_scoop_x_d
  assign tjs_scoop_right_e = tjs_desktop_scoop_top_width | minus: tjs_scoop_x_e
  assign tjs_scoop_right_shoulder = tjs_desktop_scoop_top_width | minus: tjs_desktop_scoop_shoulder
%}

{% style %}
  {% unless section.settings.sticky_mode == 'none' %}
    #shopify-section-{{ section.id }} {
      position: sticky;
      z-index: 80;
      top: 0;
    }
  {% endunless %}

  #shopify-section-{{ section.id }} {
    isolation: isolate;
  }

  #TjsPremiumHeader-{{ section.id }} {
    --tjs-ph-bg: var(--june-bg,{{ section.settings.background }});
    --tjs-ph-text: var(--june-ink,{{ section.settings.text_color }});
    --tjs-ph-muted: var(--june-muted,{{ section.settings.muted_color }});
    --tjs-ph-accent: var(--june-accent,{{ section.settings.accent }});
    --tjs-ph-border: var(--june-border,{{ section.settings.border_color }});
    --tjs-ph-glass: {{ tjs_glass_strength }}%;
    --tjs-ph-glass-blur: {{ section.settings.glass_blur }}px;
    --tjs-ph-glass-saturate: {{ section.settings.glass_saturation }}%;
    --tjs-ph-glass-highlight: {{ section.settings.glass_highlight | times: 0.01 }};
    --tjs-ph-radius: {{ section.settings.shell_radius }}px;
    --tjs-ph-max: {{ section.settings.max_width }}px;
    --tjs-ph-desktop-height: {{ section.settings.desktop_height }}px;
    --tjs-ph-mobile-top-height: {{ section.settings.mobile_top_height }}px;
    --tjs-ph-search-height: {{ section.settings.search_height }}px;

    position: relative;
    z-index: 80;
    display: block;
    width: 100%;
    color: var(--tjs-ph-text);
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    transform: translateY(0);
    transition: transform .28s cubic-bezier(.22, .61, .36, 1);
    -webkit-font-smoothing: antialiased;
  }

  #TjsPremiumHeader-{{ section.id }} *,
  #TjsPremiumHeader-{{ section.id }} *::before,
  #TjsPremiumHeader-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #TjsPremiumHeader-{{ section.id }} a {
    color: inherit;
  }

  #TjsPremiumHeader-{{ section.id }} button,
  #TjsPremiumHeader-{{ section.id }} input {
    font: inherit;
  }

  #TjsPremiumHeader-{{ section.id }}.is-hidden {
    transform: translateY(calc(-100% - 14px));
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__note {
    min-height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 5px 14px;
    background: var(--tjs-ph-text);
    color: var(--tjs-ph-bg);
    font-size: 9px;
    font-weight: 720;
    letter-spacing: .045em;
    text-align: center;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__note::before {
    content: "";
    width: 5px;
    height: 5px;
    flex: 0 0 5px;
    border-radius: 50%;
    background: var(--tjs-ph-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--tjs-ph-accent) 18%, transparent);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__note a {
    text-decoration: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__shell {
    position: relative;
    z-index: 2;
    width: 100%;
    overflow: visible;
    border-bottom: 1px solid var(--tjs-ph-border);
    background: var(--tjs-ph-bg);
    transition:
      margin .28s cubic-bezier(.22, .61, .36, 1),
      border-radius .28s cubic-bezier(.22, .61, .36, 1),
      border-color .2s ease,
      background-color .2s ease,
      box-shadow .28s ease;
  }

  #TjsPremiumHeader-{{ section.id }}.is-home-transparent:not(.is-scrolled) .tjs-ph__shell {
    border-color: transparent;
    background: transparent;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__inner {
    width: min(calc(100% - 30px), var(--tjs-ph-max));
    margin-inline: auto;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__desktop {
    min-height: var(--tjs-ph-desktop-height);
    display: none;
    grid-template-columns: auto minmax(260px, 1fr) minmax(230px, 330px) auto;
    align-items: center;
    gap: clamp(18px, 2vw, 34px);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    color: var(--tjs-ph-text);
    text-decoration: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__brand img {
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
    display: block;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__brand-text {
    font-family: var(--font-heading-family, var(--font-body-family, serif));
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -.035em;
    white-space: nowrap;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav {
    min-width: 0;
    height: 100%;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-list {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.menu_alignment }};
    gap: clamp(14px, 1.55vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-item {
    height: 100%;
    display: flex;
    align-items: center;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-link,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-summary {
    position: relative;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--tjs-ph-text);
    cursor: pointer;
    font-size: 11px;
    font-weight: 690;
    line-height: 1;
    letter-spacing: .006em;
    text-decoration: none;
    white-space: nowrap;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-link::after,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-summary::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 4px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .22s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-link:hover::after,
  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-link:focus-visible::after,
  #TjsPremiumHeader-{{ section.id }} details[open] > .tjs-ph__nav-summary::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-badge {
    position: absolute;
    top: -7px;
    right: -10px;
    min-height: 14px;
    display: inline-flex;
    align-items: center;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--tjs-ph-accent);
    color: var(--june-on-accent,var(--tjs-ph-text));
    font-size: 6px;
    font-weight: 820;
    letter-spacing: .045em;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-details {
    height: 100%;
    display: flex;
    align-items: center;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-details > summary {
    list-style: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-details > summary::-webkit-details-marker {
    display: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__nav-caret {
    width: 8px;
    height: 8px;
    transition: transform .2s ease;
  }

  #TjsPremiumHeader-{{ section.id }} details[open] .tjs-ph__nav-caret {
    transform: rotate(180deg);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown {
    position: absolute;
    z-index: 20;
    top: calc(100% - 1px);
    right: 0;
    left: 0;
    padding: 14px 15px 18px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-7px);
    transition:
      opacity .18s ease,
      visibility .18s ease,
      transform .22s cubic-bezier(.22, .61, .36, 1);
  }

  #TjsPremiumHeader-{{ section.id }} details[open] > .tjs-ph__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-panel {
    width: min(100%, var(--tjs-ph-max));
    display: grid;
    grid-template-columns: minmax(170px, .65fr) minmax(0, 2.35fr);
    gap: 28px;
    margin-inline: auto;
    padding: 24px;
    border: 1px solid color-mix(in srgb, var(--tjs-ph-border) 88%, transparent);
    border-radius: calc(var(--tjs-ph-radius) + 2px);
    background: color-mix(in srgb, var(--tjs-ph-bg) 94%, transparent);
    box-shadow: 0 26px 70px rgba(23, 18, 14, .14);
    backdrop-filter: blur(22px) saturate(145%);
    -webkit-backdrop-filter: blur(22px) saturate(145%);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 4px 22px 4px 2px;
    border-right: 1px solid var(--tjs-ph-border);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro small {
    color: var(--tjs-ph-text);
    font-size: 7px;
    font-weight: 820;
    letter-spacing: .095em;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro strong {
    font-family: var(--font-heading-family, var(--font-body-family, serif));
    font-size: 24px;
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -.035em;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-intro a {
    width: max-content;
    margin-top: 7px;
    color: var(--tjs-ph-text);
    font-size: 9px;
    font-weight: 780;
    letter-spacing: .04em;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-transform: uppercase;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-columns {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-column {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 9px;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-heading {
    color: var(--tjs-ph-text);
    font-size: 10px;
    font-weight: 780;
    line-height: 1.25;
    text-decoration: none;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child {
    color: var(--tjs-ph-muted);
    font-size: 9px;
    font-weight: 560;
    line-height: 1.35;
    text-decoration: none;
    transition: color .16s ease, transform .16s ease;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__dropdown-child:hover {
    color: var(--tjs-ph-text);
    transform: translateX(2px);
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search-wrap {
    position: relative;
    z-index: 15;
    min-width: 0;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search {
    position: relative;
    min-width: 0;
  }

  #TjsPremiumHeader-{{ section.id }} .tjs-ph__search input {
    width: 100%;
    height: var(--tjs-ph-search-height);
    padding: 0 44px 0 16px;
    border: 1px solid var(--tjs-ph-border);
    border-radius: 999px;
    outline: 0;
    background: color-mix(in srgb, var(--tjs-ph-bg) 76%, transparent);
    color: var(--tjs-ph-text);
    font-size: 10px;
