                                            >
                                              {{ tjs_product_type | escape }}
                                            </a>
                                          {% endfor %}

                                        {% when 'automatic' %}
                                          {% for tjs_product_type in tjs_automatic_types limit: tjs_mega_types_limit %}
                                            {% assign tjs_product_type_encoded = tjs_product_type | url_encode %}
                                            <a
                                              class="tjs-ph__dropdown-child"
                                              href="{{ tjs_child_collection.url }}?filter.p.product_type={{ tjs_product_type_encoded }}"
                                            >
                                              {{ tjs_product_type | escape }}
