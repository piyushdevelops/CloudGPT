            {% else %}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5.5 8.5h13l-1 11h-11l-1-11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <path d="M9 9V6.5a3 3 0 0 1 6 0V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            {% endif %}
            <hdt-cart-count class="tjs-ph__count" data-tjs-cart-count data-cart-count="{{ cart.item_count }}">{{ cart.item_count }}</hdt-cart-count>
          </a>
