                                <span>{{ tjs_menu_promo_block.settings.subtitle | escape }}</span>
                              {% endif %}
                            </span>
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  </details>
                {% else %}
                  <a class="tjs-ph__nav-link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                    <span>{{ tjs_nav_title | escape }}</span>
                    {% if tjs_nav_badge != blank %}
                      <span class="tjs-ph__nav-badge">{{ tjs_nav_badge | escape }}</span>
                    {% endif %}
                  </a>
                {% endif %}
              </li>
            {% endfor %}
