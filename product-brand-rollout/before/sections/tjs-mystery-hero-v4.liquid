      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "TJS / MYSTERY DROP / 001"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Headline line 1",
      "default": "YOU KNOW"
    },
    {
      "type": "text",
      "id": "heading_line_2_prefix",
      "label": "Headline line 2 prefix",
      "default": "THE"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlighted word on line 2",
