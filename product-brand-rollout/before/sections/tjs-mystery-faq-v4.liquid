<section id="TjsMysteryFaq-{{ section.id }}" class="tjs-mv4 tjs-mv4-faq" style="--tjs-faq-pt:{{ section.settings.faq_pt }}px;--tjs-faq-pb:{{ section.settings.faq_pb }}px;--tjs-faq-mpt:{{ section.settings.mobile_pt }}px;--tjs-faq-mpb:{{ section.settings.mobile_pb }}px;--tjs-faq-row-pad:{{ section.settings.mobile_row_padding }}px;">
  <div class="tjs-mv4__shell"><div class="tjs-mv4__content">
    <div data-reveal>{% if section.settings.eyebrow != blank %}<div class="tjs-mv4__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}<h2 class="tjs-mv4__display tjs-mv4-faq__heading">{{ section.settings.heading }}</h2></div>
    <div>
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }} {% if section.settings.open_first and forloop.first %}open{% endif %}>
          <summary><span>{{ block.settings.question }}</span><span class="tjs-mv4-faq__plus" aria-hidden="true">+</span></summary>
          <div class="tjs-mv4-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div></div>
</section>
{% schema %}
{
  "name": "TJS Mystery FAQ",
  "tag": "section",
  "class": "tjs-mystery-v4-faq-section",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "faq_pt",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "faq_pb",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "mobile_pt",
      "label": "Mobile top spacing",
      "min": 12,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "mobile_pb",
      "label": "Mobile bottom spacing",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "mobile_row_padding",
      "label": "Mobile question row padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "QUESTIONS / NO SPOILERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ASK AWAY. WE WON’T SPOIL IT."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question by default",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What exactly is inside my Mystery Box?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "That part is intentionally kept secret. Each box contains a curated assortment of The June Shop products."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TJS Mystery FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What exactly is inside my Mystery Box?",
            "answer": "That part is intentionally kept secret. Each box contains a curated assortment of The June Shop products."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I choose what goes inside?",
            "answer": "No. The surprise is part of the Mystery Box experience, so individual products cannot be selected."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is the value guaranteed?",
            "answer": "Yes. The combined listed value of the products will meet or exceed the value stated for your selected box."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Will every Mystery Box contain the same products?",
            "answer": "Not necessarily. Assortments can vary, which means different customers may receive different combinations."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I buy more than one?",
            "answer": "Yes. Product overlaps may occur when multiple boxes are ordered."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I send it as a gift?",
            "answer": "Yes. A Mystery Box can be delivered directly to the recipient using their shipping address at checkout."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What happens if something arrives damaged?",
            "answer": "Contact The June Shop support with your order details and the required unpacking evidence, and the team will review it under the applicable damage policy."
          }
        }
      ]
    }
  ]
}
{% endschema %}

