{% if section.settings.enable and section.blocks.size > 0 %}
<section id="TjsMysteryUgc-{{ section.id }}" class="tjs-mv4 tjs-mv4-ugc">
  <div class="tjs-mv4__shell"><div class="tjs-mv4__content">
    <div class="tjs-mv4-ugc__head" data-reveal><div>{% if section.settings.eyebrow != blank %}<div class="tjs-mv4__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}<h2 class="tjs-mv4__display tjs-mv4-ugc__heading">{{ section.settings.heading }}</h2></div>{% if section.settings.note != blank %}<p class="tjs-mv4__body">{{ section.settings.note }}</p>{% endif %}</div>
    <div class="tjs-mv4-ugc__grid">
      {% for block in section.blocks %}
        <article class="tjs-mv4-ugc__card" data-reveal {{ block.shopify_attributes }}>
          <div class="tjs-mv4-ugc__media">
            {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.alt }}{% endif %}
            {% if block.settings.spoiler %}<button type="button" class="tjs-mv4-ugc__spoiler" data-spoiler>{{ section.settings.spoiler_text }}</button>{% endif %}
          </div>
          <div class="tjs-mv4-ugc__copy"><div class="tjs-mv4-ugc__stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</div><div class="tjs-mv4-ugc__quote">“{{ block.settings.quote }}”</div><div class="tjs-mv4-ugc__name">{{ block.settings.name }}</div></div>
        </article>
      {% endfor %}
    </div>
  </div></div>
</section>
<script>(function(){var s=document.getElementById('TjsMysteryUgc-{{ section.id }}');if(!s)return;s.querySelectorAll('[data-spoiler]').forEach(function(b){b.addEventListener('click',function(){b.classList.add('is-revealed')})})})();</script>
{% endif %}
{% schema %}
{
  "name": "TJS Mystery UGC",
  "tag": "section",
  "class": "tjs-mystery-v4-ugc-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable this section",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "UNBOXED BY YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The reactions are real."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Side note",
      "default": "Spoiler thumbnails stay covered until the customer chooses to reveal them."
    },
    {
      "type": "text",
      "id": "spoiler_text",
      "label": "Spoiler overlay text",
      "default": "REVEAL SPOILER"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "UGC / review",
      "limit": 9,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer / unboxing image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text",
          "default": "Mystery Box customer unboxing"
        },
        {
          "type": "checkbox",
          "id": "spoiler",
          "label": "Cover image as a spoiler",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Short quote",
          "default": "Worth the suspense."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Verified customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TJS Mystery UGC"
    }
  ]
}
{% endschema %}

