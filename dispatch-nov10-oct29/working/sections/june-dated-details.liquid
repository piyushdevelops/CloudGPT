<script>
(() => {
  const root = document.getElementById('JuneDatedDetails-{{ section.id }}');
  if (!root) return;
  const track = root.querySelector('[data-jdd-track]');
  const current = root.querySelector('[data-jdd-current]');
  if (!track || !current) return;
  const cards = [...track.querySelectorAll('.jdd__inside-card')];
  const move = direction => track.scrollBy({ left: direction * track.clientWidth * .72, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  root.querySelector('[data-jdd-prev]')?.addEventListener('click', () => move(-1));
  root.querySelector('[data-jdd-next]')?.addEventListener('click', () => move(1));
  track.addEventListener('scroll', () => {
    const center = track.scrollLeft + track.clientWidth / 2;
    let nearest = 0;
    let distance = Infinity;
    cards.forEach((card, index) => {
      const delta = Math.abs(card.offsetLeft + card.offsetWidth / 2 - center);
      if (delta < distance) {
        distance = delta;
        nearest = index;
      }
    });
    current.textContent = String(nearest + 1).padStart(2, '0');
  }, { passive: true });
})();
</script>

