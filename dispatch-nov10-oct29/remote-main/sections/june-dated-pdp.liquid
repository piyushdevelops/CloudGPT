<script>
(() => {
  const root = document.getElementById('JuneDated-{{ section.id }}');
  if (!root || root.dataset.bound === 'true') return;
  root.dataset.bound = 'true';
  const slides = [...root.querySelectorAll('[data-jdp-slide]')];
  const thumbs = [...root.querySelectorAll('[data-jdp-thumb]')];
  thumbs.forEach(button => button.addEventListener('click', () => {
    const chosen = button.dataset.jdpThumb;
    slides.forEach(slide => { slide.hidden = slide.dataset.jdpSlide !== chosen; });
    thumbs.forEach(thumb => { const active = thumb === button; thumb.classList.toggle('is-active', active); thumb.setAttribute('aria-pressed', String(active)); });
  }));
  const id = root.querySelector('[data-jdp-variant-id]');
  const price = root.querySelector('[data-jdp-price]');
  const compare = root.querySelector('[data-jdp-compare]');
  const mobilePrice = root.querySelector('[data-jdp-mobile-price]');
  const nameWrap = root.querySelector('[data-jdp-name-wrap]');
  const nameInput = nameWrap?.querySelector('input');
  const atc = root.querySelector('[data-jdp-atc]');
  const atcText = root.querySelector('[data-jdp-atc-text]');
  root.querySelectorAll('[data-jdp-variant]').forEach(button => button.addEventListener('click', () => {
    root.querySelectorAll('[data-jdp-variant]').forEach(option => { const active = option === button; option.classList.toggle('is-active', active); option.setAttribute('aria-pressed', String(active)); });
    id.value = button.dataset.jdpVariant;
    const selectedPrice = button.querySelector('small')?.textContent.trim() || button.dataset.jdpPrice;
    const compareMarkup = new DOMParser().parseFromString(button.dataset.jdpCompare || '', 'text/html');
    const selectedCompare = compareMarkup.body.textContent.trim();
    price.textContent = selectedPrice;
    mobilePrice.textContent = selectedPrice;
    compare.textContent = selectedCompare;
    compare.hidden = !selectedCompare;
    const personalized = button.dataset.jdpName === 'true';
    nameWrap.hidden = !personalized;
    nameInput.disabled = !personalized;
    nameInput.required = personalized;
    if (!personalized) nameInput.value = '';
    const available = button.dataset.jdpAvailable === 'true';
    atc.disabled = !available;
    atcText.textContent = available ? {% if is_preorder %}{{ section.settings.preorder_button_label | json }}{% else %}{{ section.settings.button_label | json }}{% endif %} : 'Currently unavailable';
  }));
})();
</script>

