{% liquid
  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign type_block = section.blocks | where: 'type', 'typography' | first
  assign type = type_block.settings
  assign product_form_id = 'JuneDatedForm-' | append: section.id
  assign preorder_tag = section.settings.preorder_tag | strip
  assign planner_collection = section.settings.collection | default: collections['2027-dated-planners']
  assign is_preorder = false
  if preorder_tag != blank and product.tags contains preorder_tag
    assign is_preorder = true
  endif
  assign highlight_count = 0
  for block in section.blocks
    if block.type == 'highlight' and block.settings.heading != blank
      assign highlight_count = highlight_count | plus: 1
    endif
  endfor
%}

{% style %}
{% if type_block %}
  {% assign heading_weight_text = type.heading_weight | append: '' %}
  {% assign copy_weight_text = type.copy_weight | append: '' %}
  {% assign action_weight_text = type.action_weight | append: '' %}
  {% assign heading_face = type.heading_font | font_modify: 'weight', heading_weight_text | default: type.heading_font %}
  {% assign copy_face = type.copy_font | font_modify: 'weight', copy_weight_text | default: type.copy_font %}
  {% assign action_face = type.action_font | font_modify: 'weight', action_weight_text | default: type.action_font %}
  {{ heading_face | font_face: font_display: 'swap' }}
  {{ copy_face | font_face: font_display: 'swap' }}
  {{ action_face | font_face: font_display: 'swap' }}
{% endif %}
{% endstyle %}

<section id="JuneDated-{{ section.id }}" class="jdp{% if is_preorder %} is-preorder{% endif %}" data-preorder="{{ is_preorder }}" style="
  --jdp-heading-font:{% if type_block %}{{ type.heading_font.family }},{{ type.heading_font.fallback_families }}{% else %}'Poppins',sans-serif{% endif %};
  --jdp-heading-weight:{{ type.heading_weight | default: 800 }};
  --jdp-heading-size:{{ type.heading_size | default: 54 }}px;
  --jdp-heading-mobile:{{ type.heading_mobile | default: 34 }}px;
  --jdp-heading-tracking:{{ type.heading_tracking | default: -2 | divided_by: 100.0 }}em;
  --jdp-heading-leading:{{ type.heading_leading | default: 105 | divided_by: 100.0 }};
  --jdp-copy-font:{% if type_block %}{{ type.copy_font.family }},{{ type.copy_font.fallback_families }}{% else %}'Poppins',sans-serif{% endif %};
  --jdp-copy-weight:{{ type.copy_weight | default: 400 }};
  --jdp-copy-size:{{ type.copy_size | default: 15 }}px;
  --jdp-copy-mobile:{{ type.copy_mobile | default: 14 }}px;
  --jdp-copy-tracking:{{ type.copy_tracking | default: 0 | divided_by: 100.0 }}em;
  --jdp-copy-leading:{{ type.copy_leading | default: 150 | divided_by: 100.0 }};
  --jdp-action-font:{% if type_block %}{{ type.action_font.family }},{{ type.action_font.fallback_families }}{% else %}'Poppins',sans-serif{% endif %};
  --jdp-action-weight:{{ type.action_weight | default: 700 }};
  --jdp-action-size:{{ type.action_size | default: 14 }}px;
  --jdp-action-mobile:{{ type.action_mobile | default: 13 }}px;
  --jdp-action-tracking:{{ type.action_tracking | default: 0 | divided_by: 100.0 }}em;
  --jdp-action-leading:{{ type.action_leading | default: 120 | divided_by: 100.0 }};
">
  <div class="jdp__wrap">
    <nav class="jdp__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>
      {% if planner_collection != blank %}<a href="{{ planner_collection.url }}">{{ planner_collection.title }}</a><span aria-hidden="true">/</span>{% endif %}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="jdp__layout">
      <div class="jdp__gallery" data-jdp-gallery>
        <div class="jdp__stage">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div class="jdp__slide{% if forloop.first %} is-active{% endif %}" data-jdp-slide="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}>
                {% if media.media_type == 'image' %}
                  {% if forloop.first %}
                    {{ media.preview_image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1100, 1400', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'eager', fetchpriority: 'high', alt: media.alt | default: product.title, class: 'jdp__image' }}
                  {% else %}
                    {{ media.preview_image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1100, 1400', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'lazy', alt: media.alt | default: product.title, class: 'jdp__image' }}
                  {% endif %}
                {% else %}
                  {{ media | media_tag: image_size: '1200x', controls: true, class: 'jdp__media' }}
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            <div class="jdp__empty-media" role="img" aria-label="Product image coming soon"><span>THE JUNE SHOP</span><strong>2027</strong><small>Product images coming soon</small></div>
          {% endif %}
          <span class="jdp__year" aria-hidden="true">2027 / THE DATED EDIT</span>
          <span class="jdp__paper-note" aria-hidden="true">A brighter<br>year of you.</span>
          <span class="jdp__paper-mark" aria-hidden="true">Plan · grow · celebrate</span>
          <span class="jdp__torn-note" aria-hidden="true">More than a planner.<br>A year of you.</span>
          <span class="jdp__leaf jdp__leaf--one" aria-hidden="true"></span>
          <span class="jdp__leaf jdp__leaf--two" aria-hidden="true"></span>
          <span class="jdp__flower" aria-hidden="true"></span>
        </div>
        {% if product.media.size > 1 %}
          <div class="jdp__thumbs" aria-label="Product media">
            {% for media in product.media %}
              <button type="button" class="jdp__thumb{% if forloop.first %} is-active{% endif %}" data-jdp-thumb="{{ forloop.index0 }}" aria-label="View media {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="jdp__buy" id="JuneDatedBuy-{{ section.id }}">
        <span class="jdp__eyebrow">{% if is_preorder %}{{ section.settings.preorder_badge | escape }}{% else %}{{ section.settings.eyebrow | escape }}{% endif %}</span>
        <h1 class="jdp__title">{{ product.title }}</h1>
        {% if section.settings.intro != blank %}<p class="jdp__intro">{{ section.settings.intro | escape }}</p>{% endif %}
        {% if is_preorder %}<span class="jdp__preorder-price-label">Pre-order price</span>{% endif %}
        <div class="jdp__price-line">
          <strong class="jdp__price" data-jdp-price>{{ selected_variant.price | money }}</strong>
          <del class="jdp__compare" data-jdp-compare{% unless selected_variant.compare_at_price > selected_variant.price %} hidden{% endunless %}>{{ selected_variant.compare_at_price | money }}</del>
        </div>
        {% if is_preorder %}
          <div class="jdp__preorder" aria-label="Pre-order information">
            <span class="jdp__preorder-pulse" aria-hidden="true"></span>
            <div>
              {% if section.settings.preorder_heading != blank %}<strong>{{ section.settings.preorder_heading | escape }}</strong>{% endif %}
              {% if section.settings.preorder_message != blank %}<p>{{ section.settings.preorder_message | escape }}</p>{% endif %}
              {% if section.settings.preorder_dispatch != blank %}<small><b>Dispatch:</b> {{ section.settings.preorder_dispatch | escape }}</small>{% endif %}
              {% if section.settings.preorder_delivery != blank %}<small><b>Delivery:</b> {{ section.settings.preorder_delivery | escape }}</small>{% endif %}
            </div>
          </div>
        {% endif %}

        {% form 'product', product, id: product_form_id, class: 'jdp__form' %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-jdp-variant-id>
          {% if is_preorder %}
            <input type="hidden" name="properties[Purchase type]" value="Pre-order">
            <input type="hidden" name="properties[_Pre-order campaign]" value="{{ preorder_tag | escape }}">
            {% if section.settings.preorder_dispatch != blank %}<input type="hidden" name="properties[Expected dispatch]" value="{{ section.settings.preorder_dispatch | escape }}">{% endif %}
          {% endif %}
          {% unless product.has_only_default_variant %}
            <fieldset class="jdp__options">
              <legend>{{ section.settings.option_label | escape }}</legend>
              <div class="jdp__option-list">
                {% for variant in product.variants %}
                  {% assign variant_title_down = variant.title | downcase %}
                  <button type="button" class="jdp__option{% if variant.id == selected_variant.id %} is-active{% endif %}" data-jdp-variant="{{ variant.id }}" data-jdp-price="{{ variant.price | money | escape }}" data-jdp-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}" data-jdp-available="{{ variant.available }}" data-jdp-name="{% if variant_title_down contains 'add name' %}true{% else %}false{% endif %}" aria-pressed="{% if variant.id == selected_variant.id %}true{% else %}false{% endif %}">
                    <span>{{ variant.title }}</span><small>{{ variant.price | money }}</small>
                  </button>
                {% endfor %}
              </div>
            </fieldset>
          {% endunless %}
          {% assign selected_title_down = selected_variant.title | downcase %}
          <div class="jdp__name" data-jdp-name-wrap{% unless selected_title_down contains 'add name' %} hidden{% endunless %}>
            <label for="JuneDatedName-{{ section.id }}">{{ section.settings.name_label | escape }}</label>
            <input id="JuneDatedName-{{ section.id }}" name="properties[Name]" type="text" maxlength="30" autocomplete="off" placeholder="{{ section.settings.name_placeholder | escape }}"{% if selected_title_down contains 'add name' %} required{% else %} disabled{% endif %}>
            <small>{{ section.settings.name_hint | escape }}</small>
          </div>
          <div class="jdp__purchase">
            <label class="jdp__quantity">Quantity <input name="quantity" type="number" min="1" value="1" inputmode="numeric"></label>
            <button type="submit" name="add" class="jdp__atc" data-jdp-atc{% unless selected_variant.available %} disabled{% endunless %}>
              <span data-jdp-atc-text>{% if selected_variant.available %}{% if is_preorder %}{{ section.settings.preorder_button_label | escape }}{% else %}{{ section.settings.button_label | escape }}{% endif %}{% else %}Currently unavailable{% endif %}</span>
              <span class="jdp__atc-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </button>
          </div>
        {% endform %}
        {% if section.settings.supporting_line != blank %}<p class="jdp__support">{{ section.settings.supporting_line | escape }}</p>{% endif %}
        {% if highlight_count > 0 %}
          <ul class="jdp__highlights" aria-label="{{ section.settings.highlights_label | escape }}">
            {% assign highlight_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'highlight' and block.settings.heading != blank %}
                {% assign highlight_index = highlight_index | plus: 1 %}
                <li {{ block.shopify_attributes }}>
                  <span aria-hidden="true">{{ highlight_index | prepend: '0' }}</span>
                  <div><strong>{{ block.settings.heading | escape }}</strong>{% if block.settings.copy != blank %}<small>{{ block.settings.copy | escape }}</small>{% endif %}</div>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
        <div class="jdp__links">
          {% if planner_collection != blank %}<a href="{{ planner_collection.url }}">Explore all 2027 planners</a>{% endif %}
          {% if shop.shipping_policy.url != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping policy</a>{% endif %}
          {% if shop.refund_policy.url != blank %}<a href="{{ shop.refund_policy.url }}">Returns policy</a>{% endif %}
        </div>
      </div>
    </div>
  </div>
  <div class="jdp__mobile-bar" data-jdp-mobile-bar>
    <span data-jdp-mobile-price>{{ selected_variant.price | money }}</span>
    <a href="#JuneDatedBuy-{{ section.id }}">{% if is_preorder %}{{ section.settings.preorder_button_label | escape }}{% else %}Choose your option{% endif %} <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  #JuneDated-{{ section.id }}{--ink:var(--june-ink,#171717);--bg:var(--june-bg,#fff);--surface:var(--june-surface,#f5f5f3);--accent:var(--june-accent,#f56a28);--on-accent:var(--june-on-accent,#171717);--muted:var(--june-muted,#656565);--border:var(--june-border,#dadada);--soft:color-mix(in srgb,var(--accent) 10%,var(--bg));color:var(--ink);background:linear-gradient(180deg,var(--soft) 0,transparent 720px),var(--bg);font-family:var(--jdp-copy-font);font-size:var(--jdp-copy-size);line-height:var(--jdp-copy-leading);letter-spacing:var(--jdp-copy-tracking);}
  #JuneDated-{{ section.id }} *{box-sizing:border-box}
  #JuneDated-{{ section.id }} .jdp__wrap{max-width:1560px;margin:auto;padding:30px clamp(18px,3vw,48px) 82px}
  #JuneDated-{{ section.id }} .jdp__crumb{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin:0 0 24px;color:var(--muted);font-size:11px}
  #JuneDated-{{ section.id }} .jdp__crumb a{text-decoration:underline;text-underline-offset:3px;color:inherit}
  #JuneDated-{{ section.id }} .jdp__crumb [aria-current]{color:var(--ink);max-width:42ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #JuneDated-{{ section.id }} .jdp__layout{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(390px,.88fr);gap:clamp(28px,4vw,68px);align-items:start}
  #JuneDated-{{ section.id }} .jdp__gallery,#JuneDated-{{ section.id }} .jdp__buy{min-width:0}
  #JuneDated-{{ section.id }} .jdp__stage{position:relative;isolation:isolate;aspect-ratio:1.08/1;background:var(--surface);border:1px solid color-mix(in srgb,var(--accent) 16%,var(--border));border-radius:24px;overflow:hidden;box-shadow:0 24px 70px #00000012}
  #JuneDated-{{ section.id }} .jdp__stage::before,#JuneDated-{{ section.id }} .jdp__stage::after{content:'';position:absolute;z-index:-1;background:var(--accent);opacity:.9;transform:rotate(-8deg)}
  #JuneDated-{{ section.id }} .jdp__stage::before{width:44%;height:38%;left:-9%;top:-10%;clip-path:polygon(5% 9%,100% 0,91% 100%,0 88%)}
  #JuneDated-{{ section.id }} .jdp__stage::after{width:35%;height:29%;right:-8%;bottom:-9%;transform:rotate(9deg);clip-path:polygon(8% 0,100% 14%,91% 100%,0 82%)}
  #JuneDated-{{ section.id }} .jdp__slide{width:100%;height:100%}
  #JuneDated-{{ section.id }} .jdp__slide[hidden],#JuneDated-{{ section.id }} .jdp__name[hidden],#JuneDated-{{ section.id }} .jdp__compare[hidden]{display:none!important}
  #JuneDated-{{ section.id }} .jdp__image,#JuneDated-{{ section.id }} .jdp__media{width:100%;height:100%;object-fit:contain;display:block;filter:drop-shadow(0 22px 28px #00000018)}
  #JuneDated-{{ section.id }} .jdp__year{position:absolute;left:16px;top:16px;padding:8px 11px;border-radius:4px;background:var(--bg);color:var(--ink);font:700 10px/1.2 'Poppins',sans-serif;letter-spacing:.09em}
  #JuneDated-{{ section.id }} .jdp__paper-note{position:absolute;right:4%;top:6%;z-index:2;padding:15px 18px;background:var(--bg);color:var(--ink);box-shadow:0 10px 24px #00000012;transform:rotate(5deg);font:800 clamp(15px,1.6vw,23px)/1.05 var(--jdp-heading-font);letter-spacing:-.04em;text-align:center}
  #JuneDated-{{ section.id }} .jdp__paper-mark{position:absolute;left:5%;bottom:5%;z-index:2;padding:9px 12px;background:var(--ink);color:var(--bg);transform:rotate(-2deg);font:700 10px/1.1 var(--jdp-action-font);letter-spacing:.06em;text-transform:uppercase}
  #JuneDated-{{ section.id }} .jdp__empty-media{height:100%;display:grid;place-content:center;text-align:center;gap:8px}
  #JuneDated-{{ section.id }} .jdp__empty-media span,#JuneDated-{{ section.id }} .jdp__empty-media small{font-size:12px;letter-spacing:.1em}
  #JuneDated-{{ section.id }} .jdp__empty-media strong{font:800 clamp(90px,13vw,190px)/.9 'Poppins',sans-serif;letter-spacing:-.08em;color:var(--accent)}
  #JuneDated-{{ section.id }} .jdp__thumbs{display:flex;gap:10px;overflow-x:auto;margin-top:12px;padding:3px 2px 8px}
  #JuneDated-{{ section.id }} .jdp__thumb{flex:0 0 68px;width:68px;height:68px;padding:0;border:1px solid var(--border);border-radius:9px;background:var(--surface);overflow:hidden;cursor:pointer}
  #JuneDated-{{ section.id }} .jdp__thumb.is-active{outline:2px solid var(--ink);outline-offset:2px}
  #JuneDated-{{ section.id }} .jdp__thumb img{width:100%;height:100%;object-fit:cover}
  #JuneDated-{{ section.id }} .jdp__buy{position:sticky;top:92px;padding:clamp(24px,3vw,38px);border:1px solid var(--border);border-radius:22px;background:color-mix(in srgb,var(--bg) 94%,transparent);box-shadow:0 22px 60px #00000010;backdrop-filter:blur(10px)}
  #JuneDated-{{ section.id }} .jdp__eyebrow{display:inline-flex;padding:7px 10px;margin-bottom:15px;background:var(--accent);color:var(--on-accent);font:800 10px/1.1 'Poppins',sans-serif;text-transform:uppercase;letter-spacing:.08em}
  #MainContent[data-june-product-brand] #JuneDated-{{ section.id }} .jdp__title,#JuneDated-{{ section.id }} .jdp__title{margin:0 0 14px;font-family:var(--jdp-heading-font)!important;font-weight:var(--jdp-heading-weight)!important;font-size:var(--jdp-heading-size)!important;line-height:var(--jdp-heading-leading)!important;letter-spacing:var(--jdp-heading-tracking)!important;color:var(--ink);text-wrap:balance}
  #MainContent[data-june-product-brand] #JuneDated-{{ section.id }} :is(.jdp__intro,.jdp__support),#JuneDated-{{ section.id }} :is(.jdp__intro,.jdp__support){font-family:var(--jdp-copy-font)!important;font-size:var(--jdp-copy-size)!important;font-weight:var(--jdp-copy-weight)!important;line-height:var(--jdp-copy-leading)!important;letter-spacing:var(--jdp-copy-tracking)!important}
  #JuneDated-{{ section.id }} .jdp__intro{max-width:53ch;margin:0 0 20px;color:var(--muted)}
  #JuneDated-{{ section.id }} .jdp__price-line{display:flex;align-items:baseline;gap:13px;padding-bottom:22px;border-bottom:1px solid var(--border)}
  #JuneDated-{{ section.id }} .jdp__price{font-family:var(--jpb-price-font,'Archivo Black','Poppins',sans-serif);font-size:clamp(27px,2.5vw,38px);font-weight:900;letter-spacing:-.045em;line-height:1.15}
  #JuneDated-{{ section.id }} .jdp__preorder-price-label{display:block;margin:20px 0 4px;color:var(--accent);font:800 10px/1 var(--jdp-action-font);letter-spacing:.12em;text-transform:uppercase}
  #JuneDated-{{ section.id }} .jdp__preorder{display:grid;grid-template-columns:auto 1fr;gap:12px;margin:18px 0 2px;padding:16px;border:1px dashed color-mix(in srgb,var(--accent) 72%,var(--ink));border-radius:14px;background:color-mix(in srgb,var(--accent) 11%,var(--bg));box-shadow:inset 0 1px 0 #ffffffa8}
  #JuneDated-{{ section.id }} .jdp__preorder-pulse{width:11px;height:11px;margin-top:4px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 5px color-mix(in srgb,var(--accent) 18%,transparent)}
  #JuneDated-{{ section.id }} .jdp__preorder strong{display:block;font:800 15px/1.25 var(--jdp-heading-font);letter-spacing:-.02em}
  #JuneDated-{{ section.id }} .jdp__preorder p{margin:5px 0 9px;color:var(--muted);font-size:12px;line-height:1.45}
  #JuneDated-{{ section.id }} .jdp__preorder small{display:block;margin-top:4px;color:var(--ink);font-size:11px;line-height:1.4}
  #JuneDated-{{ section.id }}.is-preorder .jdp__buy{box-shadow:0 38px 90px #0000001f,0 12px 28px #00000014,6px 7px 0 color-mix(in srgb,var(--ink) 17%,var(--bg)),0 0 0 1px color-mix(in srgb,var(--ink) 16%,transparent)}
  #JuneDated-{{ section.id }}.is-preorder .jdp__buy::before{background:var(--ink)}
  #JuneDated-{{ section.id }}.is-preorder .jdp__atc{background:var(--ink);color:var(--bg);box-shadow:-2px 3px 0 var(--accent),0 13px 24px #00000022!important}
  #JuneDated-{{ section.id }}.is-preorder .jdp__atc:hover{box-shadow:-2px 5px 0 var(--accent),0 17px 30px #0000002a!important}
  #JuneDated-{{ section.id }}.is-preorder .jdp__mobile-bar a{background:var(--ink);color:var(--bg)}
  #JuneDated-{{ section.id }} .jdp__compare{font-size:14px;color:var(--muted)}
  #JuneDated-{{ section.id }} .jdp__options{padding:22px 0 0;margin:0;border:0;min-width:0}
  #JuneDated-{{ section.id }} .jdp__options legend,#JuneDated-{{ section.id }} .jdp__name label{display:block;width:100%;padding:0;margin:0 0 11px;font-size:12px;font-weight:800;color:var(--ink)}
  #JuneDated-{{ section.id }} .jdp__option-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  #MainContent[data-june-product-brand] #JuneDated-{{ section.id }} .jdp__option,#JuneDated-{{ section.id }} .jdp__option{display:flex;align-items:center;justify-content:space-between;gap:7px;min-height:58px;padding:12px 14px;border:1.5px solid var(--border);border-radius:9px;background:transparent;color:var(--ink);font-family:var(--jdp-action-font)!important;font-weight:var(--jdp-action-weight)!important;font-size:var(--jdp-action-size)!important;line-height:var(--jdp-action-leading)!important;letter-spacing:var(--jdp-action-tracking)!important;text-align:left;cursor:pointer}
  #JuneDated-{{ section.id }} .jdp__option small{font-size:11px;white-space:nowrap}
  #JuneDated-{{ section.id }} .jdp__option.is-active{border-color:var(--ink);background:var(--surface);box-shadow:inset 0 -3px 0 var(--accent)}
  #JuneDated-{{ section.id }} .jdp__name{padding:20px 0 0}
  #JuneDated-{{ section.id }} .jdp__name input{width:100%;min-height:48px;padding:12px 14px;border:1.5px solid var(--border);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit}
  #JuneDated-{{ section.id }} .jdp__name small{display:block;margin-top:7px;color:var(--muted);font-size:11px}
  #JuneDated-{{ section.id }} .jdp__purchase{display:grid;grid-template-columns:86px minmax(0,1fr);gap:10px;margin-top:22px}
  #JuneDated-{{ section.id }} .jdp__quantity{display:flex;flex-direction:column;justify-content:center;gap:3px;font-size:10px;font-weight:700}
  #JuneDated-{{ section.id }} .jdp__quantity input{width:100%;height:39px;padding:5px 8px;border:1.5px solid var(--border);border-radius:7px;background:var(--bg);color:var(--ink);font:700 15px 'Poppins',sans-serif}
