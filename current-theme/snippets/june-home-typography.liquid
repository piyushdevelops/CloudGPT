{% comment %}Approved homepage text roles. Natural-width fonts; headings excluded.{% endcomment %}
{% if settings.june_type_enabled != false %}
{% style %}
{% assign chosen = settings.june_type_price_font %}{% assign requested = settings.june_type_price_weight | append: '' %}{% assign face = chosen | font_modify: 'weight', requested | default: chosen %}{{ face | font_face: font_display: 'swap' }}
