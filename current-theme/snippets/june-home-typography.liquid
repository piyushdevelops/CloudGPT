{% assign chosen = settings.june_type_action_font %}{% assign requested = settings.june_type_action_weight | append: '' %}{% assign face = chosen | font_modify: 'weight', requested | default: chosen %}{{ face | font_face: font_display: 'swap' }}
:root{--jtype-action-font:{{ chosen.family }},{{ chosen.fallback_families }};--jtype-action-weight:{{ settings.june_type_action_weight }};--jtype-action-size:{{ settings.june_type_action_size }}px;--jtype-action-mobile:{{ settings.june_type_action_mobile }}px;--jtype-action-tracking:{{ settings.june_type_action_tracking | divided_by: 100.0 }}em;--jtype-action-leading:{{ settings.june_type_action_leading | divided_by: 100.0 }};}
{% assign chosen = settings.june_type_support_font %}{% assign requested = settings.june_type_support_weight | append: '' %}{% assign face = chosen | font_modify: 'weight', requested | default: chosen %}{{ face | font_face: font_display: 'swap' }}
