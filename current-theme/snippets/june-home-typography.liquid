:root{--jtype-utility-font:{{ chosen.family }},{{ chosen.fallback_families }};--jtype-utility-weight:{{ settings.june_type_utility_weight }};--jtype-utility-size:{{ settings.june_type_utility_size }}px;--jtype-utility-mobile:{{ settings.june_type_utility_mobile }}px;--jtype-utility-tracking:{{ settings.june_type_utility_tracking | divided_by: 100.0 }}em;--jtype-utility-leading:{{ settings.june_type_utility_leading | divided_by: 100.0 }};}
