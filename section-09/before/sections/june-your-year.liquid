{% liquid
 assign type_block = section.blocks | where: 'type', 'typography' | first
 assign type = type_block.settings
 assign font = type.font | default: settings.type_body_font
 assign planners = section.blocks | where: 'type', 'planner'
 assign count = 0
 for block in planners
  if block.settings.product != blank
   assign count = count | plus: 1
  endif
 endfor
 assign selected = 1
 if count > 1
  assign selected = 2
 endif
%}
{% style %}
{% assign weight = type.heading_weight | default: 900 | append: '' %}{% assign variant = font | font_modify: 'weight', weight %}{{ variant | font_face: font_display: 'swap' }}
{% assign weight = type.subheading_weight | default: 600 | append: '' %}{% assign variant = font | font_modify: 'weight', weight %}{{ variant | font_face: font_display: 'swap' }}
{% assign weight = type.body_weight | default: 400 | append: '' %}{% assign variant = font | font_modify: 'weight', weight %}{{ variant | font_face: font_display: 'swap' }}
{% assign weight = type.label_weight | default: 500 | append: '' %}{% assign variant = font | font_modify: 'weight', weight %}{{ variant | font_face: font_display: 'swap' }}
{% assign weight = type.button_weight | default: 600 | append: '' %}{% assign variant = font | font_modify: 'weight', weight %}{{ variant | font_face: font_display: 'swap' }}

#JuneUndated-{{ section.id }} {
 --ju-bg: {{ section.settings.background }}; --ju-ink: {{ section.settings.ink }}; --ju-accent: {{ section.settings.accent }};
 --ju-font: {{ font.family | default: 'Poppins' }}, {{ font.fallback_families | default: 'sans-serif' }};
 --ju-stage: {{ section.settings.cover_height }}px; --ju-mobile-stage: {{ section.settings.mobile_height }}px;
 --ju-duration: {{ 36000 | divided_by: section.settings.speed }}ms;
--ju-heading-size: {{ type.heading_size | default: 62 }}px; --ju-heading-mobile: {{ type.heading_mobile | default: 40 }}px; --ju-heading-weight: {{ type.heading_weight | default: 900 }}; --ju-heading-tracking: {{ type.heading_tracking | default: -4 | divided_by: 100.0 }}em; --ju-heading-leading: {{ type.heading_leading | default: 105 | divided_by: 100.0 }};
--ju-subheading-size: {{ type.subheading_size | default: 26 }}px; --ju-subheading-mobile: {{ type.subheading_mobile | default: 21 }}px; --ju-subheading-weight: {{ type.subheading_weight | default: 600 }}; --ju-subheading-tracking: {{ type.subheading_tracking | default: -2 | divided_by: 100.0 }}em; --ju-subheading-leading: {{ type.subheading_leading | default: 120 | divided_by: 100.0 }};
--ju-body-size: {{ type.body_size | default: 16 }}px; --ju-body-mobile: {{ type.body_mobile | default: 14 }}px; --ju-body-weight: {{ type.body_weight | default: 400 }}; --ju-body-tracking: {{ type.body_tracking | default: -1 | divided_by: 100.0 }}em; --ju-body-leading: {{ type.body_leading | default: 150 | divided_by: 100.0 }};
--ju-label-size: {{ type.label_size | default: 11 }}px; --ju-label-mobile: {{ type.label_mobile | default: 10 }}px; --ju-label-weight: {{ type.label_weight | default: 500 }}; --ju-label-tracking: {{ type.label_tracking | default: 12 | divided_by: 100.0 }}em; --ju-label-leading: {{ type.label_leading | default: 150 | divided_by: 100.0 }};
--ju-button-size: {{ type.button_size | default: 14 }}px; --ju-button-mobile: {{ type.button_mobile | default: 13 }}px; --ju-button-weight: {{ type.button_weight | default: 600 }}; --ju-button-tracking: {{ type.button_tracking | default: -1 | divided_by: 100.0 }}em; --ju-button-leading: {{ type.button_leading | default: 130 | divided_by: 100.0 }};
}
{% endstyle %}
{% capture arrow %}<span class="ju__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endcapture %}
{% if count > 0 %}
<june-undated id="JuneUndated-{{ section.id }}" class="ju" data-motion="{{ section.settings.motion }}" data-initial="{{ selected | minus: 1 }}" aria-labelledby="JuneUndatedHeading-{{ section.id }}">
 <header class="ju__header">
  <div><p class="ju__label">{{ section.settings.eyebrow | escape }}</p><h2 id="JuneUndatedHeading-{{ section.id }}" class="ju__heading">{{ section.settings.heading | escape }}</h2></div>
  <div class="ju__intro"><p class="ju__body">{{ section.settings.intro | escape }}</p><a class="ju__textlink" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}"><span class="ju__desktop-label">{{ 'june_undated.view_all' | t }}</span><span class="ju__mobile-label">{{ 'june_undated.view_all_short' | t }}</span>{{ arrow }}</a></div>
 </header>
 <div class="ju__showcase">
  <div class="ju__track" role="group" aria-label="{{ 'june_undated.choose' | t | escape }}">
  {% assign number = 0 %}
  {% for block in planners %}
   {% assign product = block.settings.product %}
   {% if product != blank %}
    {% liquid
     assign number = number | plus: 1
     assign name = block.settings.short_name | default: product.title
     assign cover = block.settings.cover | default: product.featured_image
    %}
    <button type="button" class="ju__cover{% if number == selected %} is-selected{% endif %}" data-select="{{ number | minus: 1 }}" aria-pressed="{% if number == selected %}true{% else %}false{% endif %}" aria-label="{{ name | escape }}" {{ block.shopify_attributes }}>
     <span class="ju__cover-art">{{ cover | image_url: width: 1000 | image_tag: widths: '300,500,750,1000', sizes: '(min-width: 750px) 30vw, 75vw', loading: 'lazy', alt: name }}</span>
     <span class="ju__caption"><span class="ju__number">0{{ number }}</span><span class="ju__name">{{ name | escape }}</span><span class="ju__selected">{{ 'june_undated.selected' | t }}</span></span>
    </button>
   {% endif %}
  {% endfor %}
  </div>
  {% if count > 1 %}<button class="ju__step ju__prev" type="button" data-step="-1" aria-label="{{ 'june_undated.previous' | t | escape }}">{{ arrow }}</button><button class="ju__step ju__next" type="button" data-step="1" aria-label="{{ 'june_undated.next' | t | escape }}">{{ arrow }}</button>{% endif %}
 </div>
 <div class="ju__thumbs" aria-label="{{ 'june_undated.choose' | t | escape }}">
 {% assign number = 0 %}{% for block in planners %}{% if block.settings.product != blank %}
 {% assign name = block.settings.short_name | default: block.settings.product.title %}{% assign cover = block.settings.cover | default: block.settings.product.featured_image %}
 <button type="button" data-select="{{ number }}" aria-label="{{ name | escape }}" aria-pressed="{% assign selected_index = selected | minus: 1 %}{% if number == selected_index %}true{% else %}false{% endif %}">{{ cover | image_url: width: 140 | image_tag: loading: 'lazy', alt: name }}</button>{% assign number = number | plus: 1 %}
 {% endif %}{% endfor %}</div>
 <p class="ju__status ju__body" aria-live="polite" aria-atomic="true"></p>
 <div class="ju__details">
 {% assign number = 0 %}{% for block in planners %}{% assign product = block.settings.product %}{% if product != blank %}
 {% liquid
  assign number = number | plus: 1
  assign name = block.settings.short_name | default: product.title
  assign cover = block.settings.cover | default: product.featured_image
  assign inside_index = block.settings.inside_number | minus: 1
  assign inside = block.settings.inside | default: product.images[inside_index] | default: cover
 %}
 <div class="ju__panel" data-panel="{{ number | minus: 1 }}" data-name="{{ name | escape }}" {% unless number == selected %}hidden{% endunless %}>
  <div class="ju__preview">
   <div data-picture="cover" hidden>{{ cover | image_url: width: 800 | image_tag: widths: '300,500,800', sizes: '(min-width: 901px) 32vw, 90vw', loading: 'lazy', alt: name }}</div>
   <div data-picture="inside">{{ inside | image_url: width: 900 | image_tag: widths: '300,600,900', sizes: '(min-width: 901px) 32vw, 90vw', loading: 'lazy', alt: inside.alt }}</div>
  </div>
  <div class="ju__inside-copy"><p class="ju__label">{{ 'june_undated.look_inside' | t }}</p><h3 class="ju__subheading">{{ section.settings.inside_heading | escape }}</h3><p class="ju__body">{{ section.settings.inside_body | escape }}</p>
   <div class="ju__toggles"><button type="button" data-view="cover" aria-pressed="false">{{ 'june_undated.cover' | t }}</button><button type="button" data-view="inside" aria-pressed="true">{{ 'june_undated.inside' | t }}</button></div>
  </div>
  <div class="ju__buy"><h3 class="ju__subheading">{{ name | escape }}</h3><p class="ju__body">{{ product.price | money }}</p><a class="ju__primary" href="{{ product.url }}">{{ 'june_undated.explore' | t }}{{ arrow }}</a><button type="button" class="ju__textlink" data-compare>{{ 'june_undated.compare' | t }}{{ arrow }}</button></div>
 </div>
 {% endif %}{% endfor %}
 </div>
 <dialog class="ju__dialog" aria-labelledby="JuneCompare-{{ section.id }}"><div class="ju__dialog-head"><h3 id="JuneCompare-{{ section.id }}" class="ju__subheading">{{ 'june_undated.compare' | t }}</h3><button class="ju__close" type="button" data-close aria-label="{{ 'june_undated.close' | t | escape }}">×</button></div><div class="ju__comparison">
 {% for block in planners %}{% assign product = block.settings.product %}{% if product != blank %}{% assign cover = block.settings.cover | default: product.featured_image %}<article>{{ cover | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.title }}<h4 class="ju__body">{{ block.settings.short_name | default: product.title | escape }}</h4><p class="ju__body">{{ product.price | money }}</p><p class="ju__body">{% if product.available %}{{ 'june_undated.available' | t }}{% else %}{{ 'june_undated.sold_out' | t }}{% endif %}</p><a class="ju__textlink" href="{{ product.url }}">{{ 'june_undated.explore_short' | t }}{{ arrow }}</a></article>{% endif %}{% endfor %}
 </div></dialog>
</june-undated>
{% endif %}

{% stylesheet %}
june-undated.ju{display:block;max-width:1680px;margin:0 auto;background:var(--ju-bg);color:var(--ju-ink);font-family:var(--ju-font);padding-top:48px;overflow:hidden;border-bottom:1px solid #1113}
.ju *{box-sizing:border-box}.ju [hidden]{display:none!important}.ju h2,.ju h3,.ju h4,.ju p{margin:0;color:inherit}.ju a{color:inherit;text-decoration:none}.ju button{font:inherit;color:inherit;border:0;background:none;padding:0;cursor:pointer;border-radius:0;appearance:none}.ju button:focus-visible,.ju a:focus-visible{outline:2px solid currentColor;outline-offset:5px}.ju img{display:block;width:100%;height:100%;object-fit:contain}.ju__header{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;padding:0 48px 18px}.ju__heading{font-family:var(--ju-font);font-size:var(--ju-heading-size);font-weight:var(--ju-heading-weight);letter-spacing:var(--ju-heading-tracking);line-height:var(--ju-heading-leading)}.ju__label{font-size:var(--ju-label-size);font-weight:var(--ju-label-weight);letter-spacing:var(--ju-label-tracking);line-height:var(--ju-label-leading);text-transform:uppercase}.ju__header .ju__label{margin-bottom:14px}.ju__subheading{font-family:var(--ju-font);font-size:var(--ju-subheading-size);font-weight:var(--ju-subheading-weight);letter-spacing:var(--ju-subheading-tracking);line-height:var(--ju-subheading-leading)}.ju__body{font-size:var(--ju-body-size);font-weight:var(--ju-body-weight);letter-spacing:var(--ju-body-tracking);line-height:var(--ju-body-leading)}.ju__intro{flex-shrink:0;text-align:right;padding-bottom:3px}.ju__textlink,.ju__primary,.ju__toggles,.ju__caption{font-size:var(--ju-button-size)!important;font-weight:var(--ju-button-weight)!important;letter-spacing:var(--ju-button-tracking);line-height:var(--ju-button-leading)}.ju .ju__textlink{display:inline-flex;align-items:center;gap:10px;min-height:44px;text-decoration:underline;text-underline-offset:5px}.ju__arrow{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:24px;height:24px;border-radius:50%;background:#111;color:var(--ju-bg)}.ju__arrow svg{width:16px;height:16px}.ju__showcase{position:relative;padding:0 70px}.ju__track{background:var(--ju-bg);display:flex;align-items:flex-start;justify-content:center;gap:14px;max-width:1320px;margin:0 auto}.ju .ju__cover{mix-blend-mode:multiply;flex:1;min-width:0;text-align:center}.ju__cover-art{mix-blend-mode:multiply;display:block;height:calc(var(--ju-stage)*1.12);transform:scale(.94);transform-origin:50% 80%;transition:transform var(--ju-duration) ease}.ju__cover-art img{mix-blend-mode:multiply;transform:scale(1.1)}.ju__cover.is-selected .ju__cover-art{transform:scale(1)}.ju__caption{display:flex;flex-direction:column;align-items:center;gap:7px;padding:10px 8px 22px}.ju__number{font-size:var(--ju-label-size);font-weight:var(--ju-label-weight)}.ju__selected{font-size:var(--ju-button-size);font-weight:var(--ju-button-weight);visibility:hidden;min-height:30px;padding:6px 16px;border-radius:999px;background:var(--ju-accent);color:#111}.ju__name{padding-bottom:4px;border-bottom:2px solid transparent}.ju__cover.is-selected .ju__name{border-color:currentColor}.ju__cover.is-selected .ju__selected{visibility:visible}.ju .ju__step{position:absolute;top:42%;width:52px;height:52px;border:1px solid #1119;border-radius:50%;display:grid;place-items:center}.ju__step .ju__arrow{background:transparent;color:inherit}.ju__prev{left:24px}.ju__prev svg{transform:rotate(180deg)}.ju__next{right:24px}.ju__details{border-top:1px solid #1113;background:color-mix(in srgb,var(--ju-accent) 7%,var(--ju-bg))}.ju__panel{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr) minmax(0,1fr);align-items:center;gap:24px;padding:32px 48px;max-width:1420px;margin:0 auto}.ju__preview{height:300px;min-width:0}.ju__preview>div{height:100%}.ju__preview img{mix-blend-mode:multiply}.ju__inside-copy .ju__label{margin-bottom:12px}.ju__inside-copy .ju__body{margin-top:10px}.ju__toggles{display:flex;gap:22px;margin-top:20px}.ju__toggles button{min-height:44px;border-bottom:2px solid transparent;opacity:.55}.ju__toggles button[aria-pressed=true]{border-color:currentColor;opacity:1}.ju__buy{align-self:stretch;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;border-left:1px solid #1114;padding-left:24px;gap:12px}.ju .ju__primary{display:inline-flex;align-items:center;justify-content:space-between;gap:14px;min-height:50px;padding:7px 8px 7px 20px;background:var(--ju-accent);border:1px solid #111;border-radius:999px;box-shadow:-2px 1px 0 #111;margin-top:8px;transition:transform var(--ju-duration) ease}.ju__primary .ju__arrow{width:32px;height:32px;color:var(--ju-accent);transition:transform var(--ju-duration) ease}.ju__primary .ju__arrow svg{width:18px;height:18px}.ju__thumbs,.ju__status,.ju__mobile-label{display:none}.ju__dialog{color:var(--ju-ink);background:var(--ju-bg);border:1px solid #1114;width:min(920px,94vw);max-height:85vh;padding:28px;font-family:var(--ju-font)}.ju__dialog::backdrop{background:#1119}.ju__dialog-head{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:20px}.ju .ju__close{width:44px;height:44px;border:1px solid #1115;border-radius:50%;font-size:28px}.ju__comparison{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.ju__comparison img{height:220px;mix-blend-mode:multiply}.ju__comparison h4{font-weight:600;margin:12px 0}.ju__comparison p{margin:8px 0}
@media(hover:hover){.ju[data-motion=true] .ju__primary:hover{transform:translateY(-2px)}.ju[data-motion=true] .ju__primary:hover .ju__arrow{transform:translateX(2px)}.ju__step:hover{background:#111;color:var(--ju-bg)}}.ju .ju__primary:active{transform:translateY(1px)}
@media(min-width:901px) and (max-width:1100px){.ju__header{padding-inline:28px}.ju__heading{font-size:calc(var(--ju-heading-size)*.78)}.ju__intro{max-width:230px;flex-shrink:1}.ju__panel{padding:24px 28px;gap:20px;grid-template-columns:1fr 1fr}.ju__buy{grid-column:1/-1;border-left:0;border-top:1px solid #1113;padding:16px 0 0;flex-direction:row;align-items:center;gap:20px;justify-content:flex-start}.ju__buy .ju__subheading{max-width:220px}.ju__buy .ju__primary{margin:0}.ju__track{gap:10px}.ju__showcase{padding-inline:50px}.ju__cover-art{height:320px}}
@media(max-width:900px){june-undated.ju{padding-top:28px}.ju__header{padding:0 20px 10px;gap:12px;position:relative}.ju__heading{font-size:var(--ju-heading-mobile);max-width:270px}.ju__label{font-size:var(--ju-label-mobile)}.ju__subheading{font-size:var(--ju-subheading-mobile)}.ju__body{font-size:var(--ju-body-mobile)}.ju__textlink,.ju__primary,.ju__toggles,.ju__caption{font-size:var(--ju-button-mobile)!important}.ju__header .ju__label{margin-bottom:10px;white-space:nowrap}.ju__intro{position:absolute;right:20px;bottom:8px}.ju__intro .ju__body,.ju__desktop-label{display:none}.ju__mobile-label{display:inline}.ju__intro .ju__textlink{gap:5px}.ju__intro .ju__arrow{width:20px;height:20px}.ju__showcase{padding:0;overflow:hidden}.ju__track{display:block;position:relative;height:var(--ju-mobile-stage);touch-action:pan-y}.ju .ju__cover{position:absolute;width:76%;top:0;left:12%;transform:translateX(calc(var(--ju-position,0)*84%));transition:transform var(--ju-duration) ease}.ju__cover-art{height:var(--ju-mobile-stage);transform:scale(.86)}.ju__caption,.ju .ju__step{display:none}.ju__thumbs{display:flex;justify-content:center;gap:18px;margin:10px 0 8px}.ju__thumbs button{width:58px;height:62px;padding:3px;border:1px solid transparent;border-radius:4px}.ju__thumbs button[aria-pressed=true]{border:2px solid #111}.ju__thumbs img{mix-blend-mode:multiply}.ju__status{display:block;text-align:center;padding:0 20px 18px;min-height:60px}.ju__status span{display:block;font-size:10px;margin-bottom:3px}.ju__panel{grid-template-columns:1fr 1fr;padding:20px;gap:16px}.ju__preview{height:155px}.ju__inside-copy .ju__label{font-size:8px;letter-spacing:.1em;margin-bottom:8px}.ju__inside-copy .ju__body{font-size:12px;line-height:1.45;margin-top:8px}.ju__toggles{gap:12px;margin-top:7px;font-size:11px!important}.ju__toggles button{min-height:36px}.ju__buy{grid-column:1/-1;border:0;padding:0;align-items:center;gap:5px}.ju__buy>.ju__subheading,.ju__buy>.ju__body{display:none}.ju .ju__primary{width:100%;margin:0}.ju__dialog{padding:20px}.ju__comparison{grid-template-columns:1fr;gap:20px}.ju__comparison article{display:grid;grid-template-columns:100px 1fr;column-gap:14px;border-bottom:1px solid #1113;padding-bottom:15px}.ju__comparison img{height:150px;grid-row:span 4}.ju__comparison h4{margin:0}.ju__comparison p{margin:3px 0}}
@media(max-width:359px){.ju__header,.ju__panel{padding-left:16px;padding-right:16px}.ju__heading{font-size:calc(var(--ju-heading-mobile)*.85);max-width:230px}.ju__intro{right:16px;bottom:6px}.ju__intro .ju__arrow{display:none}.ju__panel{gap:12px}.ju__subheading{font-size:calc(var(--ju-subheading-mobile)*.9)}}
/* Review refinement: readable mobile preview and controls. */
@media(max-width:900px){
 .ju__track{max-width:none}.ju__cover-art{transform:scale(.9)}
 .ju__thumbs button{width:64px;height:70px;border-color:#1113;background:var(--ju-bg)}
 .ju__thumbs button[aria-pressed=true]{background:color-mix(in srgb,var(--ju-accent) 40%,var(--ju-bg));box-shadow:0 2px 0 #111}
 .ju__panel{grid-template-columns:1fr;gap:22px;padding:24px 20px}
 .ju__preview{height:280px}.ju__inside-copy{text-align:center}
 .ju__inside-copy .ju__label{font-size:var(--ju-label-mobile);letter-spacing:var(--ju-label-tracking)}
 .ju__inside-copy .ju__body{font-size:var(--ju-body-mobile);line-height:var(--ju-body-leading)}
 .ju__toggles{justify-content:center;font-size:var(--ju-button-mobile)!important;gap:24px;margin-top:12px}
 .ju__toggles button{min-height:44px}
 .ju__buy{border-top:1px solid #1113;padding-top:20px;gap:12px}
 .ju__buy>.ju__body{display:block}.ju .ju__primary{width:auto;gap:28px}
}
